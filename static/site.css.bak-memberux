:root{
  --od:#3d4434;--od-dark:#262b22;--canvas:#666e5e;--canvas-dark:#4f5749;
  --manila:#cbb27a;--manila-light:#dbc792;--kraft:#9e7e52;--paper:#e4dcc8;--paper-dark:#d3c8ae;
  --ink:#29261e;--ink-soft:#4b4639;--cav:#d6ad2b;--stamp:#8f3027;--metal:#5b5c54;--black:#171914;
  --type:'Courier Prime','Courier New',monospace;--stencil:'Stardos Stencil','Courier Prime',monospace;
  --shadow-paper:0 10px 22px rgba(18,17,12,.24);--shadow-heavy:0 22px 45px rgba(15,14,10,.35);
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#30352b;color:#e8e2d3;font-family:var(--type);line-height:1.55;overflow-x:hidden}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}img{max-width:100%;display:block}h1,h2,h3,p{margin-top:0}.skip-link{position:fixed;left:12px;top:-60px;z-index:9999;background:var(--paper);color:var(--ink);padding:10px 14px;border:2px solid var(--ink)}.skip-link:focus{top:12px}

/* global battalion header */
.battalion-header{position:sticky;top:0;z-index:1000;background:#22271f;border-bottom:1px solid #626a57;box-shadow:0 5px 16px rgba(0,0,0,.25)}
.unit-wire{height:25px;display:flex;align-items:center;justify-content:space-between;padding:0 2.2vw;background:#151812;color:#bdb5a1;font-size:9px;letter-spacing:.06em}.header-desk{min-height:92px;display:flex;align-items:center;padding:8px 2.2vw;gap:24px}.unit-mark{display:flex;align-items:center;gap:15px;min-width:390px}.unit-mark img{width:82px;height:78px;object-fit:contain;filter:drop-shadow(0 4px 4px rgba(0,0,0,.35))}.unit-mark-copy{display:flex;flex-direction:column}.unit-mark-copy strong{font-size:18px;letter-spacing:.025em}.unit-mark-copy small{font-size:9px;color:#bfb7a3}.record-index{margin-left:auto;display:flex;align-items:flex-end;gap:1px}.record-index a{position:relative;padding:12px 10px 10px;font-size:10px;letter-spacing:.035em;color:#d9d2bf;border-bottom:2px solid transparent}.record-index a:hover,.record-index a[aria-current="page"]{background:#30362a;border-bottom-color:var(--cav);color:#fff7dd}.record-index .duty-tab{margin-left:7px;background:var(--manila);color:var(--ink);border:1px solid #9b8150;font-weight:700}.index-button{display:none;border:1px solid #9d8a5b;background:var(--manila);color:var(--ink);padding:10px 12px;font-weight:700}.dispatch-stack{position:fixed;top:132px;right:18px;z-index:1500;width:min(390px,90vw)}.dispatch{background:var(--paper);color:var(--ink);border-left:6px solid var(--cav);padding:13px 16px;box-shadow:var(--shadow-paper);margin-bottom:8px;font-size:12px}.dispatch span{display:block;font-size:8px;color:var(--ink-soft);margin-bottom:4px}.dispatch.danger{border-color:var(--stamp)}
.battalion-footer{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:30px;align-items:center;padding:30px 3vw;background:#191c16;border-top:6px solid #4b503f;color:#bfb8a5;font-size:10px}.footer-filemark{display:flex;align-items:center;gap:16px}.footer-filemark img{width:88px;max-height:84px;object-fit:contain}.footer-filemark div{display:flex;flex-direction:column}.footer-filemark strong{color:#e5ddc9}.footer-motto{text-align:right;color:#d5ad31;font-weight:700}.footer-motto span{color:#a8a18f;font-weight:400}

/* common physical materials */
.document-sheet{position:relative;background:#e2d9c4;color:var(--ink);border:1px solid #9a8e72;box-shadow:var(--shadow-paper);background-image:linear-gradient(rgba(255,255,255,.1),rgba(91,76,47,.03))}.document-sheet:after{content:"";position:absolute;inset:0;pointer-events:none;opacity:.18;background:repeating-linear-gradient(0deg,transparent 0 8px,rgba(71,61,42,.035) 9px)}
.army-letterhead{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;gap:2px;padding-bottom:16px;border-bottom:1px solid #5a5446}.army-letterhead small{font-size:9px}.army-letterhead strong{font-size:14px;line-height:1.25}.army-letterhead span{font-size:9px}.army-letterhead.compact{padding-bottom:10px}.document-punches{position:absolute;left:12px;top:46%;display:grid;gap:44px;z-index:3}.document-punches i{width:7px;height:7px;border-radius:50%;background:#6f6858;box-shadow:inset 0 1px 2px #332f27}.ink-stamp{border:3px solid var(--stamp);color:var(--stamp);font-weight:700;letter-spacing:.06em;line-height:1.05;padding:7px 10px;text-align:center;transform:rotate(-5deg);opacity:.78}.ink-stamp.small{display:inline-block;border-width:2px;font-size:10px;padding:4px 6px}.manila-tab{position:absolute;left:18px;top:-29px;background:var(--manila);border:1px solid #896e3e;border-bottom:0;color:var(--ink);padding:8px 18px 5px;font-size:10px;font-weight:700}.paper-action{display:inline-flex;flex-direction:column;gap:1px;padding:10px 15px;background:#d7c695;color:var(--ink);border:1px solid #9c8554;box-shadow:0 3px 0 #6f603e;letter-spacing:.03em;transition:transform .16s ease,box-shadow .16s ease}.paper-action span{font-weight:700;font-size:11px}.paper-action small{font-size:8px}.paper-action:hover,.paper-action:focus-visible{transform:translateY(-2px);box-shadow:0 5px 0 #6f603e}.paper-action.primary{background:#d7ae2d;border-color:#8e6d13;box-shadow:0 3px 0 #6d520e}.button-reset{appearance:none;cursor:pointer;width:auto;text-align:left}.typed-empty{font-size:11px;letter-spacing:.02em;color:var(--ink-soft);padding:16px 0}.entry-row,.typed-row{border-bottom:1px dotted #81775f;padding:9px 0;display:grid;grid-template-columns:1fr auto;gap:10px;font-size:11px}.entry-row small,.typed-row small{grid-column:1/3;color:#706956}.form-grid{display:grid;grid-template-columns:minmax(150px,.8fr) 1.2fr;margin:18px 0 0}.form-grid dt,.form-grid dd{padding:8px 10px;border-bottom:1px dotted #8a7d64;margin:0;font-size:11px}.form-grid dt{font-weight:700}.file-code{font-size:8px;letter-spacing:.08em;color:#615844;font-weight:700}.section-file-heading{max-width:850px;margin:0 auto 48px}.section-file-heading span{font-size:9px;color:#d6ad2c}.section-file-heading h2{font-size:clamp(34px,5vw,66px);line-height:.95;margin:8px 0 12px;letter-spacing:-.045em}.section-file-heading p{max-width:680px;color:#cbc3b0}

/* HOME — arrival */
.arrival-country{position:relative;min-height:calc(100vh - 117px);overflow:hidden;background:#1c211b}.arrival-image{position:absolute;inset:0;background:url('/static/art/homepage-background.webp') 50% 0%/cover no-repeat}.arrival-shade{position:absolute;inset:0;background:rgba(12,15,11,.34)}.arrival-identity{position:absolute;left:5vw;bottom:8vh;width:min(700px,88vw);text-shadow:0 2px 5px rgba(0,0,0,.8)}.typed-overline{font-size:10px;letter-spacing:.11em;color:#e2bc43;font-weight:700}.arrival-identity h1{font-size:clamp(62px,8vw,132px);line-height:.82;letter-spacing:-.065em;margin:12px 0 15px;color:#f1ead8}.division-line{font-size:17px;font-weight:700;color:#ece4d1}.typed-rule{width:125px;height:4px;background:var(--cav);margin:20px 0}.arrival-identity h2{font-size:20px;margin:0 0 9px}.arrival-identity>p:not(.typed-overline):not(.division-line){font-size:14px;max-width:650px;color:#e8e0cc}.arrival-identity .paper-action{margin-top:18px;text-shadow:none}.arrival-caption-note{position:absolute;right:3vw;bottom:4vh;background:#d8c894;color:#2c281e;border:1px solid #8c7950;padding:9px 13px;transform:rotate(1deg);box-shadow:var(--shadow-paper);font-size:8px}.arrival-caption-note b{display:block;font-size:14px}.arrival-caption-note small{display:block}
.inprocessing-strip{display:grid;grid-template-columns:repeat(6,1fr);background:#cbc093;color:var(--ink);border-top:1px solid #8e805c;border-bottom:1px solid #8e805c}.inprocessing-strip div{min-height:64px;padding:12px 14px;border-right:1px solid #9f916b;display:flex;align-items:center;gap:9px}.inprocessing-strip div:last-child{border-right:0}.inprocessing-strip span{font-size:9px;color:#776844}.inprocessing-strip b{font-size:9px}
.reporting-room{position:relative;min-height:780px;background:#3a3e33;overflow:hidden}.reporting-photo{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover no-repeat;filter:brightness(.72)}.orders-sheet{position:absolute;left:7vw;top:70px;width:min(610px,52vw);padding:42px 48px 40px;transform:rotate(-.8deg)}.memo-row{display:grid;grid-template-columns:80px 1fr;gap:8px;margin:18px 0 15px;font-size:11px;border-bottom:1px solid #716a58;padding-bottom:8px}.orders-sheet p{font-size:12px;position:relative;z-index:2}.typed-paragraph{font-weight:700}.signature-block{margin-top:28px;display:flex;flex-direction:column;font-size:9px;position:relative;z-index:2}.signature-block b{margin-top:10px}.stamp-report{position:absolute;right:35px;bottom:35px;font-size:15px}.photo-slip{position:absolute;right:7vw;bottom:68px;width:310px;background:#ece5d2;color:var(--ink);padding:10px 10px 15px;box-shadow:var(--shadow-heavy);transform:rotate(2deg)}.photo-slip img{width:100%;height:330px;object-fit:cover;object-position:center 15%}.photo-slip p{font-size:10px;margin:10px 6px 0}.reveal-object{opacity:0;transform:translateY(12px);transition:opacity .55s ease,transform .55s ease}.reveal-object.is-visible{opacity:1;transform:translateY(0)}

/* Soldier's tour worktable */
.soldier-tour{padding:86px 5vw 110px;background:#2b3027}.tour-worktable{position:relative;max-width:1240px;height:780px;margin:0 auto;background:#65513a url('/static/art/map-table.webp') center/cover no-repeat;border:10px solid #463727;box-shadow:inset 0 0 60px rgba(20,15,8,.36),var(--shadow-heavy)}.tour-worktable:before{content:"";position:absolute;inset:0;background:rgba(69,49,29,.35)}.tour-object{position:absolute;color:var(--ink);box-shadow:var(--shadow-paper);transition:transform .18s ease,box-shadow .18s ease;z-index:2}.tour-object:hover{z-index:8;transform:translateY(-5px) rotate(0deg);box-shadow:0 16px 26px rgba(0,0,0,.35)}.tour-object h3{font-size:18px;margin:4px 0 8px}.tour-object p,.tour-object dl{font-size:10px}.tour-object dl{display:grid;grid-template-columns:90px 1fr;margin:0}.tour-object dt,.tour-object dd{margin:0;padding:4px 0;border-bottom:1px dotted #81745b}.assignment-order{left:5%;top:7%;width:34%;background:#e3dac4;padding:27px;transform:rotate(-1.5deg)}.equipment-issue{right:5%;top:8%;width:29%;background:#b79863;padding:24px;transform:rotate(1.6deg)}.issue-mark{display:inline-block;margin-top:8px;border:2px solid #465440;color:#40503a;padding:3px 7px;font-size:10px;font-weight:700}.training-card{left:9%;top:45%;width:29%;background:#d5c38f;padding:22px;transform:rotate(1deg)}.operation-overlay{right:8%;top:43%;width:34%;background:rgba(220,218,192,.9);padding:23px;border:1px solid #76715e;transform:rotate(-1deg)}.service-record{left:23%;bottom:7%;width:31%;background:#e0d7c1;padding:24px;transform:rotate(-.8deg)}.deros-card{right:8%;bottom:5%;width:23%;background:#c9b17a;padding:20px;transform:rotate(1.5deg)}.deros-card b{font-size:14px}

/* Battalion field desk signature scene */
.field-desk-section{position:relative;min-height:920px;overflow:hidden;background:#252a22}.field-desk-photo{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover no-repeat;filter:brightness(.72)}.field-desk-section:after{content:"";position:absolute;inset:0;background:rgba(17,20,15,.2);pointer-events:none}.field-desk-heading{position:absolute;left:4vw;top:45px;z-index:4;max-width:520px;text-shadow:0 2px 4px #000}.field-desk-heading span{font-size:9px;color:#e0bb43}.field-desk-heading h2{font-size:clamp(38px,5.5vw,72px);line-height:.92;margin:6px 0}.field-desk-heading p{font-size:12px}.desk-files{position:absolute;inset:0;z-index:4}.desk-file{position:absolute;display:flex;flex-direction:column;color:var(--ink);box-shadow:var(--shadow-paper);transition:transform .18s ease,box-shadow .18s ease}.desk-file small{font-size:8px}.desk-file strong{font-size:17px}.desk-file span{font-size:8px;color:#635a46}.desk-file:hover,.desk-file:focus-visible{transform:translateY(-7px) rotate(0)!important;box-shadow:0 20px 30px rgba(0,0,0,.36);z-index:20}.file-201{left:7%;bottom:12%;width:240px;padding:43px 22px 24px;background:#c6a86b;transform:rotate(-2deg)}.file-201:before{content:"GARRETSON / 201";position:absolute;top:-25px;left:0;background:#d2b775;border:1px solid #876d3f;border-bottom:0;padding:6px 12px;font-size:8px}.file-ops{left:33%;bottom:20%;width:255px;padding:24px;background:#dbd3bb;transform:rotate(1.5deg)}.file-supply{right:8%;bottom:12%;width:245px;padding:20px;background:#b89762;transform:rotate(-1deg)}.file-morning{right:23%;top:24%;width:230px;padding:24px;background:#e1d8c1;transform:rotate(1deg)}.file-training{left:47%;top:29%;width:220px;padding:25px;background:#ccb57e;transform:rotate(-1.8deg)}.file-roster{left:12%;top:32%;width:230px;padding:25px;background:#ddd3bb;transform:rotate(1.3deg)}.file-orders{right:4%;top:48%;width:225px;padding:28px;background:#c7a86d;transform:rotate(2deg)}
.unit-history-callout{display:grid;grid-template-columns:180px 1fr auto;align-items:center;gap:32px;padding:55px 5vw;background:#1d211a;border-top:1px solid #515846}.unit-history-callout img{width:170px;max-height:170px;object-fit:contain}.unit-history-callout span{font-size:9px;color:#d5ad2e}.unit-history-callout h2{font-size:34px;margin:5px 0 7px}.unit-history-callout p{font-size:11px;color:#c4bdab;max-width:720px}

/* shared immersive page hero treatment */
.office-environment,.operations-tent,.training-office-hero,.supply-office-hero,.battalion-hero,.company-area,.orders-office-hero,.morning-office,.command-post,.staff-section-hero{position:relative;min-height:520px;overflow:hidden;background:#20251d}.office-photo,.operations-photo,.training-photo,.supply-photo,.battalion-photo,.company-photo,.orders-photo,.morning-photo,.command-photo,.staff-photo{position:absolute;inset:0;background:url('/static/art/hq-canvas.webp') center/cover no-repeat}.battalion-photo,.company-photo{background-image:url('/static/art/arrival-company.webp')}.training-photo,.supply-photo{background-image:url('/static/art/arrival-country.webp');background-position:center 55%}.operations-photo,.orders-photo,.morning-photo,.command-photo,.staff-photo{background-image:url('/static/art/hq-field-desk.webp')}.office-shade,.operations-shade,.training-shade,.supply-shade,.battalion-shade,.company-shade,.orders-shade,.morning-shade,.command-shade,.staff-shade{position:absolute;inset:0;background:rgba(14,17,12,.48)}.office-sign,.operations-sign,.training-sign,.supply-sign,.battalion-sign,.company-sign,.orders-sign,.morning-sign,.command-sign,.staff-sign{position:absolute;left:6vw;bottom:55px;z-index:2;max-width:720px;text-shadow:0 2px 5px rgba(0,0,0,.8)}.office-sign span,.operations-sign span,.training-sign span,.supply-sign span,.battalion-sign span,.company-sign span,.orders-sign span,.morning-sign span,.command-sign span,.staff-sign span{font-size:9px;color:#dcb743}.office-sign h1,.operations-sign h1,.training-sign h1,.supply-sign h1,.company-sign h1,.orders-sign h1,.morning-sign h1,.command-sign h1,.staff-sign h1{font-size:clamp(44px,6.5vw,86px);line-height:.9;margin:8px 0 10px;letter-spacing:-.055em}.office-sign p,.operations-sign p,.training-sign p,.supply-sign p,.company-sign p,.orders-sign p,.morning-sign p,.command-sign p,.staff-sign p{font-size:12px;max-width:620px}.battalion-sign{display:flex;align-items:center;gap:28px;max-width:900px}.battalion-sign img{width:200px;max-height:230px;object-fit:contain;filter:drop-shadow(0 10px 10px rgba(0,0,0,.5))}.battalion-sign h1{font-size:clamp(46px,6vw,82px);line-height:.9;margin:6px 0}

/* personnel */
.records-office{padding:80px 5vw 100px;background:#5d6153;display:grid;grid-template-columns:.42fr 1.58fr;gap:42px}.file-drawer{position:relative;background:#4c4a40;border:9px solid #39382f;padding:65px 20px 25px;min-height:360px;box-shadow:var(--shadow-heavy)}.drawer-label{position:absolute;top:15px;left:18px;right:18px;background:#d4c391;color:var(--ink);padding:8px 10px;text-align:center;border:1px solid #8d7a51;font-size:9px;font-weight:700}.drawer-folder{display:flex;flex-direction:column;background:#c4a468;color:var(--ink);padding:35px 20px 20px;margin-top:25px;box-shadow:0 9px 14px rgba(0,0,0,.28);transform:rotate(-1deg)}.drawer-folder span{font-weight:700;font-size:14px}.drawer-folder small{font-size:9px}.drawer-folder b{margin-top:18px;font-size:10px}.drawer-folder.empty{opacity:.7}.personnel-roster{padding:36px 42px}.roster-table{display:grid;grid-template-columns:1.35fr .45fr .8fr 1fr .8fr;gap:8px;border-bottom:1px dotted #867a61;padding:8px 0;font-size:10px;align-items:center}.roster-table.header{font-weight:700;border-bottom:2px solid #665e4c}

/* 201 file */
.file-cabinet-room{padding:75px 4vw 110px;background:#565c4d;min-height:900px}.room-label{max-width:1280px;margin:0 auto 45px}.room-label span{font-size:9px;color:#ddba45}.room-label h1{font-size:52px;margin:4px 0}.manila-file{position:relative;max-width:1280px;margin:0 auto;background:#b9985d;padding:60px 50px 55px;border:1px solid #7b6137;box-shadow:var(--shadow-heavy)}.manila-file>.manila-tab{top:-35px;left:28px;font-size:13px;padding:10px 25px 7px}.file-section-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:-25px 0 25px}.file-section-tabs a{background:#cbae72;color:var(--ink);border:1px solid #8b6e40;padding:8px 12px;font-size:9px}.file-section-tabs a:hover{background:#d6bc82}.record-form{padding:42px 50px}.record-title-line{display:flex;justify-content:space-between;gap:25px;border-bottom:1px solid #655d4b;padding:20px 0 12px}.record-title-line h2{font-size:28px;margin:0}.record-title-line div{text-align:right;font-size:9px}.stamp-assigned{position:absolute;right:35px;bottom:35px}.tour-file-spread{display:grid;grid-template-columns:1fr .42fr;gap:30px;margin:30px 0}.tour-control-card{background:#d8c693;color:var(--ink);padding:28px;border:1px solid #8d7950;box-shadow:var(--shadow-paper);transform:rotate(-.5deg)}.tour-control-card h3{font-size:25px;margin:5px 0 16px}.tour-control-card dl{display:grid;grid-template-columns:160px 1fr;margin:0}.tour-control-card dt,.tour-control-card dd{margin:0;padding:6px 0;border-bottom:1px dotted #8b7c5e;font-size:10px}.duty-status-card{background:#e0d7c0;color:var(--ink);padding:28px;box-shadow:var(--shadow-paper);transform:rotate(1deg)}.duty-status-card strong{display:block;font-size:55px}.file-documents{display:grid;grid-template-columns:1fr 1fr;gap:30px}.file-document{padding:32px 36px;min-height:270px}.file-document header{display:flex;flex-direction:column;border-bottom:1px solid #6d6450;padding-bottom:8px;margin-bottom:8px}.file-document header small{font-size:8px}.service-journal{grid-column:1/3}.journal-entry{display:grid;grid-template-columns:110px 1fr;gap:18px;padding:9px 0;border-bottom:1px dotted #847861;font-size:10px}.journal-entry div{display:flex;flex-direction:column}

/* operations */
.operations-room{padding:75px 5vw 95px;background:#555b4b;display:grid;grid-template-columns:1.05fr .95fr;gap:35px;position:relative}.operations-map-board{position:sticky;top:145px;height:650px;border:12px solid #39372f;background:#bcb797;box-shadow:var(--shadow-heavy);overflow:hidden}.map-surface{position:absolute;inset:0;background:url('/static/art/map-table.webp') center/cover no-repeat;filter:saturate(.65) contrast(.92);opacity:.88}.grease-mark{position:absolute;color:#a32d25;border:3px solid #a32d25;border-radius:50%;width:55px;height:55px;display:grid;place-items:center;font-weight:700;font-size:10px;transform:rotate(-8deg)}.mark-a{left:24%;top:28%}.mark-b{right:18%;top:54%}.mark-lz{left:52%;top:44%}.map-note{position:absolute;right:16px;bottom:15px;background:#d8c99c;color:var(--ink);padding:10px 13px;font-size:9px;transform:rotate(-2deg);box-shadow:var(--shadow-paper)}.oporder{padding:38px 42px}.oporder h2{font-size:26px;margin:18px 0}.op-meta{display:grid;grid-template-columns:130px 1fr;margin:0 0 18px}.op-meta dt,.op-meta dd{margin:0;padding:6px 0;border-bottom:1px dotted #867a62;font-size:10px}.op-sections{padding-left:24px}.op-sections li{margin-bottom:14px;font-size:11px}.op-sections p{margin:3px 0}.radio-log{position:absolute;right:2vw;bottom:28px;width:270px;background:#cbb77e;color:var(--ink);padding:20px;box-shadow:var(--shadow-paper);transform:rotate(1.5deg);font-size:9px}.radio-log header{font-weight:700;border-bottom:1px solid #776a4c;padding-bottom:5px;margin-bottom:8px}.operations-journal-section{padding:80px 6vw 100px;background:#262b22}.operations-ledger{max-width:1050px;margin:auto}.journal-folio{display:grid;grid-template-columns:110px 1fr 80px;gap:24px;align-items:center;padding:18px 0;border-bottom:1px solid #575d4d}.folio-date{color:#d4ad35;font-size:10px}.journal-folio small{font-size:8px;color:#a9a18f}.journal-folio h3{font-size:17px;margin:2px 0}.journal-folio p{font-size:10px;color:#c3bcaa;margin:0}.journal-folio a{font-size:9px;color:#d5ad32}

/* training */
.training-office{padding:80px 5vw 100px;background:#626759;display:grid;grid-template-columns:1.15fr .48fr .37fr;gap:32px}.range-scorecard{padding:38px 42px}.range-scorecard h2{font-size:22px;margin:18px 0}.qualification-table{display:grid;grid-template-columns:1.5fr .65fr .75fr .85fr;gap:8px;border-bottom:1px dotted #877c65;padding:8px 0;font-size:10px}.qualification-table.header{font-weight:700;border-bottom:2px solid #625a49}.training-folder{position:relative;background:#c0a065;color:var(--ink);padding:45px 25px 25px;box-shadow:var(--shadow-paper);transform:rotate(-1deg)}.training-folder .ink-stamp{margin-top:25px}.instructor-board{background:#34372f;border:8px solid #262820;padding:22px;color:#d8d0bd;box-shadow:var(--shadow-heavy)}.instructor-board header{color:#d6ad30;font-weight:700;font-size:10px;margin-bottom:14px}.instructor-board p{border-bottom:1px dotted #747665;padding:7px 0;margin:0;font-size:9px}.instructor-board small{display:block;margin-top:15px;color:#aaa391}

/* supply */
.supply-workbench{padding:80px 5vw 100px;background:#6a5d48;display:grid;grid-template-columns:1.3fr .38fr .42fr;gap:30px}.property-record{padding:38px 42px}.property-owner{font-size:10px;margin:18px 0;padding-bottom:10px;border-bottom:1px solid #6c634f}.property-item{padding:18px 0;border-bottom:2px solid #a29579}.property-tag{background:#b99a62;padding:10px 12px;border:1px solid #846b41;display:grid;grid-template-columns:.7fr 1.6fr 1fr;gap:8px;font-size:9px;align-items:center}.property-tag b{font-size:12px}.property-item dl{display:grid;grid-template-columns:160px 1fr;margin:10px 0 0}.property-item dt,.property-item dd{margin:0;padding:5px 0;border-bottom:1px dotted #887d64;font-size:9px}.inspection-clipboard{background:#d6c797;color:var(--ink);padding:26px 22px;border:1px solid #8b7a54;box-shadow:var(--shadow-paper);transform:rotate(.7deg)}.inspection-clipboard header{font-weight:700;border-bottom:2px solid #716649;margin-bottom:9px}.inspection-clipboard p{font-size:9px;border-bottom:1px dotted #8a7a57;padding:7px 0;margin:0}.supply-requisition{position:relative;background:#b6935d;color:var(--ink);padding:48px 24px 25px;box-shadow:var(--shadow-paper);transform:rotate(-1deg)}.supply-requisition p{font-size:10px;line-height:2}.supply-requisition small{font-size:8px}

/* battalion / company */
.orderly-room{padding:80px 5vw 100px;background:#595f50;display:grid;grid-template-columns:1fr 1fr;gap:35px}.battalion-roster,.formation-roll,.company-roster{padding:38px 42px}.unit-list{margin-top:16px}.unit-line{display:grid;grid-template-columns:110px 1fr 100px 130px;gap:12px;align-items:center;padding:10px 0;border-bottom:1px dotted #887c63;font-size:10px}.unit-line.battalion b{font-size:13px}.unit-line a{font-size:8px;color:#6d5722;font-weight:700}.company-office{padding:80px 5vw 100px;background:#5e6253;display:grid;grid-template-columns:1.35fr .65fr;gap:38px}.company-notice{position:relative;background:#c0a066;color:var(--ink);padding:48px 28px 30px;box-shadow:var(--shadow-paper);align-self:start}.company-notice p{font-size:11px}

/* orders */
.orders-archive{padding:80px 5vw 100px;background:#555a4c;display:grid;grid-template-columns:250px 1fr;gap:38px}.orders-index{background:#45483e;border:7px solid #34362f;padding:55px 18px 20px;position:relative;box-shadow:var(--shadow-heavy)}.orders-index .drawer-label{top:12px}.orders-index a{display:block;padding:9px 5px;border-bottom:1px dotted #767967;font-size:9px}.orders-stack{display:grid;gap:28px}.orders-ledger,.empty-order{padding:38px 42px}.order-entry{display:flex;justify-content:space-between;gap:22px;padding:13px 0;border-bottom:1px dotted #82765f}.order-entry small{font-size:8px}.order-entry h3{font-size:15px;margin:2px 0}.order-entry p{font-size:9px;margin:0}.order-entry>span{color:#7a6024;font-size:9px;font-weight:700}

/* morning report */
.morning-desk{padding:80px 5vw 105px;background:#666b5c}.morning-form{max-width:1300px;margin:auto;padding:42px 48px}.strength-blocks{display:grid;grid-template-columns:repeat(7,1fr);border:1px solid #887d66;margin:22px 0}.strength-blocks div{padding:10px;border-right:1px solid #9d9278}.strength-blocks div:last-child{border-right:0}.strength-blocks small{display:block;font-size:7px}.strength-blocks b{font-size:20px}.morning-roster{display:grid;grid-template-columns:1.2fr .45fr .9fr .8fr 1fr .85fr;gap:8px;padding:7px 0;border-bottom:1px dotted #877b62;font-size:9px}.morning-roster.header{font-weight:700;border-bottom:2px solid #625a49}.morning-form footer{display:flex;justify-content:space-between;margin-top:22px;font-size:8px}

/* recruiting */
.replacement-depot{position:relative;min-height:760px;background:#20241d;overflow:hidden}.replacement-photo{position:absolute;inset:0;background:url('/static/art/homepage-background.webp') center top/cover no-repeat}.replacement-shade{position:absolute;inset:0;background:rgba(10,13,9,.42)}.replacement-copy{position:absolute;left:6vw;bottom:70px;max-width:620px;text-shadow:0 2px 5px rgba(0,0,0,.75)}.replacement-copy span{font-size:9px;color:#e0bb43}.replacement-copy h1{font-size:clamp(58px,8vw,118px);line-height:.84;margin:8px 0 14px;letter-spacing:-.065em}.replacement-copy p{font-size:13px}.replacement-copy .paper-action{text-shadow:none;margin-top:14px}.recruit-processing{padding:90px 6vw 110px;background:#615c4f;display:grid;grid-template-columns:1.25fr .55fr;gap:45px}.enlistment-packet{padding:42px 48px}.processing-line{display:grid;grid-template-columns:44px 170px 1fr;gap:12px;padding:11px 0;border-bottom:1px dotted #867a62;font-size:10px}.processing-line span{color:#836b2a}.processing-line p{margin:0}.replacement-file{position:relative;background:#c1a268;color:var(--ink);padding:55px 30px 30px;box-shadow:var(--shadow-heavy);transform:rotate(1deg);align-self:start}.replacement-file img{width:190px;margin:0 auto 20px}.replacement-file p{font-size:10px}.replacement-file a{font-size:9px;font-weight:700;color:#564315}

/* login */
.identity-station{position:relative;min-height:760px;background:#1c211a;display:flex;align-items:center;justify-content:flex-end;padding:70px 7vw}.identity-photo{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover no-repeat}.identity-shade{position:absolute;inset:0;background:rgba(11,14,10,.52)}.identity-form{position:relative;z-index:2;width:min(520px,92vw);background:#ded5c0;color:var(--ink);padding:40px 44px;box-shadow:var(--shadow-heavy);transform:rotate(.4deg);border:1px solid #91856d}.identity-form h1{font-size:34px;margin:20px 0 8px}.identity-form p{font-size:11px}.identity-form label{display:block;margin:22px 0;font-size:9px;font-weight:700}.identity-form input{width:100%;padding:10px 4px;border:0;border-bottom:2px solid #615a4a;background:transparent;color:var(--ink);outline:0;border-radius:0}.identity-form input:focus{border-bottom-color:#8c6d1d}.identity-form footer{margin-top:20px;font-size:8px;color:#6d6656}

/* dashboard */
.soldier-desk-hero{position:relative;min-height:500px;background:#20251d;overflow:hidden}.soldier-desk-photo{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover no-repeat}.soldier-desk-shade{position:absolute;inset:0;background:rgba(12,15,11,.46)}.soldier-status-card{position:absolute;left:6vw;bottom:48px;background:#d8c793;color:var(--ink);padding:28px 34px;width:min(600px,88vw);box-shadow:var(--shadow-heavy);transform:rotate(-.6deg)}.soldier-status-card>span{font-size:8px}.soldier-status-card h1{font-size:33px;margin:6px 0}.soldier-status-card p{font-size:10px}.soldier-status-card dl{display:grid;grid-template-columns:140px 1fr;margin:14px 0 0}.soldier-status-card dt,.soldier-status-card dd{margin:0;padding:5px 0;border-bottom:1px dotted #817556;font-size:9px}.personal-worktable{padding:85px 5vw 105px;background:#66523b;display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px}.personal-worktable>article,.personal-folder{color:var(--ink);box-shadow:var(--shadow-paper);padding:28px}.personal-folder{background:#c0a065;display:flex;flex-direction:column;min-height:210px;position:relative}.personal-folder:before{content:"201 FILE";position:absolute;left:15px;top:-27px;background:#ccb175;border:1px solid #876e42;border-bottom:0;padding:6px 12px;font-size:8px}.personal-folder small{font-size:8px}.personal-folder b{font-size:22px;margin-top:7px}.personal-folder span{font-size:9px;margin-top:auto}.today-order{background:#e0d7c0}.readiness-slip{background:#b99a62}.training-slip{background:#d6c48f}.service-slip{background:#ddd3bb}.clerk-link-slip{background:#c8b377}.personal-worktable header{display:flex;flex-direction:column;border-bottom:1px solid #81765d;padding-bottom:8px;margin-bottom:5px}.personal-worktable header small{font-size:8px}.personal-worktable a{font-size:9px;font-weight:700;color:#5f4816}

/* commander / staff */
.commander-table{padding:80px 5vw 100px;background:#585d4e;display:grid;grid-template-columns:1.3fr .45fr;gap:38px}.command-brief{padding:38px 42px}.brief-strength{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #8f8369;margin:20px 0}.brief-strength div{padding:12px;border-right:1px solid #9c9178}.brief-strength div:last-child{border-right:0}.brief-strength small{font-size:7px;display:block}.brief-strength b{font-size:22px}.commander-notes,.staff-inbox{background:#c5ad74;color:var(--ink);padding:25px;border:1px solid #856c40;box-shadow:var(--shadow-paper);align-self:start}.commander-notes header{font-weight:700;border-bottom:2px solid #77623c}.commander-notes p{font-size:9px;border-bottom:1px dotted #887450;padding:7px 0;margin:0}.staff-workspace{padding:80px 5vw 100px;background:#5d6254;display:grid;grid-template-columns:1.2fr .5fr;gap:38px}.staff-status{padding:38px 42px}.staff-inbox{position:relative;padding-top:50px}.recent-ledger{max-width:1000px;margin:60px auto;padding:38px 42px}.signal-room{min-height:650px;padding:100px 5vw;background:#575d4f}.signal-notice{max-width:720px;margin:auto;padding:42px 48px}

/* accessibility / restrained motion */
:focus-visible{outline:2px solid #e0b73c;outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ink-stamp.stamp-hit{animation:stampHit .26s ease-out}@keyframes stampHit{from{transform:scale(1.18) rotate(-5deg);opacity:.2}to{transform:scale(1) rotate(-5deg);opacity:.78}}}

/* tablet */
@media(max-width:1120px){.unit-wire span:nth-child(2){display:none}.unit-mark{min-width:0}.unit-mark-copy{display:none}.unit-mark img{width:76px}.index-button{display:block;margin-left:auto}.record-index{display:none;position:absolute;top:100%;left:0;right:0;background:#22271f;border-top:1px solid #5e6553;padding:12px;flex-direction:column;align-items:stretch}.record-index.open{display:flex}.record-index a{padding:12px}.record-index .duty-tab{margin-left:0}.orders-sheet{width:62vw}.photo-slip{width:270px}.tour-worktable{height:850px}.operations-room,.training-office,.supply-workbench,.orderly-room,.company-office,.recruit-processing,.commander-table,.staff-workspace{grid-template-columns:1fr}.operations-map-board{position:relative;top:auto}.radio-log{position:relative;right:auto;bottom:auto;width:100%;grid-column:1/2}.training-folder,.instructor-board,.inspection-clipboard,.supply-requisition{max-width:650px}.service-journal{grid-column:auto}.file-documents{grid-template-columns:1fr}.personal-worktable{grid-template-columns:1fr 1fr}.strength-blocks{grid-template-columns:repeat(4,1fr)}.roster-table{grid-template-columns:1.25fr .4fr .8fr 1fr}.roster-table span:last-child{display:none}.unit-history-callout{grid-template-columns:140px 1fr}.unit-history-callout .paper-action{grid-column:2}}

/* phone — recomposed, not shrunk */
@media(max-width:720px){body{font-size:14px}.unit-wire{justify-content:center}.unit-wire span:not(:first-child){display:none}.header-desk{min-height:78px}.unit-mark img{width:67px;height:63px}.battalion-footer{grid-template-columns:1fr;text-align:center}.footer-filemark{justify-content:center}.footer-motto{text-align:center}
.arrival-country{min-height:820px}.arrival-image{background-position:57% top}.arrival-shade{background:rgba(11,14,10,.4)}.arrival-identity{left:20px;right:20px;bottom:35px;width:auto}.arrival-identity h1{font-size:58px}.arrival-identity h2{font-size:16px}.division-line{font-size:12px}.arrival-identity>p:not(.typed-overline):not(.division-line){font-size:12px}.arrival-caption-note{display:none}.inprocessing-strip{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.inprocessing-strip div{min-width:180px;scroll-snap-align:start}
.reporting-room{min-height:auto;padding:56px 17px;background:#4a4f42}.reporting-photo{position:absolute}.orders-sheet{position:relative;left:auto;top:auto;width:100%;padding:34px 25px;transform:none}.photo-slip{position:relative;right:auto;bottom:auto;width:78%;margin:-8px auto 55px;transform:rotate(1deg)}.photo-slip img{height:270px}
.soldier-tour{padding:62px 17px 72px}.section-file-heading{margin-bottom:30px}.section-file-heading h2{font-size:40px}.tour-worktable{height:auto;padding:25px 18px;background:#66513a url('/static/art/map-table.webp') center/cover no-repeat;border-width:7px;display:flex;flex-direction:column;gap:16px}.tour-object{position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;width:100%!important;transform:none!important}.field-desk-section{min-height:auto;padding:240px 17px 55px}.field-desk-photo{background-position:48% center}.field-desk-heading{left:20px;right:20px;top:35px}.field-desk-heading h2{font-size:39px}.desk-files{position:relative;display:flex;flex-direction:column;gap:13px}.desk-file{position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;width:100%!important;transform:none!important;padding:21px 20px!important}.file-201:before{display:none}.unit-history-callout{grid-template-columns:1fr;text-align:center;padding:45px 20px}.unit-history-callout img{margin:auto}.unit-history-callout .paper-action{grid-column:auto;justify-self:center}
.office-environment,.operations-tent,.training-office-hero,.supply-office-hero,.battalion-hero,.company-area,.orders-office-hero,.morning-office,.command-post,.staff-section-hero{min-height:450px}.office-sign,.operations-sign,.training-sign,.supply-sign,.company-sign,.orders-sign,.morning-sign,.command-sign,.staff-sign{left:20px;right:20px;bottom:35px}.office-sign h1,.operations-sign h1,.training-sign h1,.supply-sign h1,.company-sign h1,.orders-sign h1,.morning-sign h1,.command-sign h1,.staff-sign h1{font-size:48px}.battalion-sign{left:20px;right:20px;bottom:30px;display:block;text-align:center}.battalion-sign img{width:150px;margin:0 auto 16px}.battalion-sign h1{font-size:44px}.records-office,.operations-room,.training-office,.supply-workbench,.orderly-room,.company-office,.orders-archive,.morning-desk,.recruit-processing,.commander-table,.staff-workspace{padding:55px 17px;gap:26px}.personnel-roster,.battalion-roster,.formation-roll,.company-roster,.oporder,.range-scorecard,.property-record,.orders-ledger,.empty-order,.morning-form,.enlistment-packet,.command-brief,.staff-status{padding:28px 20px}.file-drawer{min-height:280px}.roster-table{grid-template-columns:1.45fr .5fr 1fr}.roster-table span:nth-child(4),.roster-table span:nth-child(5){display:none}
.file-cabinet-room{padding:50px 14px 70px}.room-label h1{font-size:38px}.manila-file{padding:52px 12px 25px}.file-section-tabs{overflow-x:auto;flex-wrap:nowrap}.file-section-tabs a{white-space:nowrap}.record-form{padding:28px 18px}.record-title-line{display:block}.record-title-line div{text-align:left;margin-top:9px}.form-grid{grid-template-columns:1fr}.form-grid dt{padding-bottom:1px;border-bottom:0}.form-grid dd{padding-top:1px}.stamp-assigned{position:relative;right:auto;bottom:auto;display:inline-block;margin-top:18px}.tour-file-spread{grid-template-columns:1fr}.tour-control-card dl{grid-template-columns:1fr}.file-documents{grid-template-columns:1fr}.service-journal{grid-column:auto}.journal-entry{grid-template-columns:80px 1fr}
.operations-map-board{height:460px;border-width:7px}.radio-log{margin-top:0}.journal-folio{grid-template-columns:75px 1fr}.journal-folio>a{display:none}.qualification-table{grid-template-columns:1.4fr .7fr}.qualification-table span:nth-child(3),.qualification-table span:nth-child(4){display:none}.property-tag{grid-template-columns:1fr}.property-item dl{grid-template-columns:1fr}.unit-line{grid-template-columns:80px 1fr}.unit-line small,.unit-line a{grid-column:2}.orders-archive{grid-template-columns:1fr}.orders-index{padding-top:55px}.strength-blocks{grid-template-columns:repeat(2,1fr)}.morning-roster{grid-template-columns:1.2fr .45fr .8fr}.morning-roster span:nth-child(4),.morning-roster span:nth-child(5),.morning-roster span:nth-child(6){display:none}.replacement-depot{min-height:700px}.replacement-photo{background-position:58% center}.replacement-copy{left:20px;right:20px;bottom:40px}.replacement-copy h1{font-size:60px}.processing-line{grid-template-columns:35px 1fr}.processing-line p{grid-column:2}.replacement-file{transform:none}.identity-station{padding:55px 17px;justify-content:center}.identity-form{padding:32px 24px;transform:none}.soldier-status-card{left:18px;right:18px;bottom:30px;width:auto;padding:24px}.soldier-status-card h1{font-size:28px}.soldier-status-card dl{grid-template-columns:1fr}.personal-worktable{padding:60px 17px;grid-template-columns:1fr}.brief-strength{grid-template-columns:1fr 1fr}.morning-form footer{display:block}.morning-form footer span{display:block;margin-top:6px}}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal-object{opacity:1;transform:none;transition:none}.desk-file,.tour-object,.paper-action{transition:none}}

/* --------------------------------------------------------------------------
   PHASE 3 — BATTLE ROSTER / 201 FILE / INDIVIDUAL WEAPON SYSTEM
   -------------------------------------------------------------------------- */
.staff-access-link{display:inline-block;margin-top:18px;padding-top:10px;border-top:1px dotted #7c725d;font-size:9px;color:#625943;font-weight:700}.card-number-mark{position:absolute;top:14px;right:18px;font-size:7px;color:#746a55}.battle-roster-auth{max-width:520px}.battle-roster-auth input{text-transform:uppercase;letter-spacing:.08em}
.battle-roster-room{min-height:760px;padding:95px 5vw;background:#535849 url('/static/art/hq-field-desk.webp') center/cover fixed;display:flex;align-items:center;justify-content:center}.battle-card-wrap{width:min(820px,95vw);padding:38px;background:rgba(26,29,23,.72);box-shadow:var(--shadow-heavy)}.battle-card-full{position:relative;background:#d7c58f;color:var(--ink);border:1px solid #88713d;box-shadow:0 18px 30px rgba(0,0,0,.38);padding:36px 44px;transform:rotate(-.35deg);background-image:linear-gradient(rgba(255,255,255,.1),rgba(93,72,31,.035))}.battle-card-full:after{content:"";position:absolute;inset:9px;border:1px solid rgba(91,73,37,.38);pointer-events:none}.battle-card-full header{text-align:center;display:flex;flex-direction:column;border-bottom:2px solid #473f2e;padding-bottom:12px}.battle-card-full header small,.battle-card-full header span{font-size:9px}.battle-card-full header strong{font-size:15px}.battle-card-full h1{text-align:center;font-size:27px;letter-spacing:.08em;margin:20px 0}.battle-card-full dl{display:grid;grid-template-columns:180px 1fr;margin:0}.battle-card-full dt,.battle-card-full dd{margin:0;padding:8px 10px;border-bottom:1px dotted #7f6c47}.battle-card-full dt{font-weight:700}.roster-number-large{font-size:22px;font-weight:700;letter-spacing:.08em}.battle-card-note{margin:20px 0 10px;border:1px solid #7a6743;padding:12px;font-size:9px}.battle-card-full footer{margin-top:20px;padding-top:10px;border-top:1px solid #746344;text-align:center;font-size:8px}.battle-card-punch{position:absolute;width:11px;height:11px;border-radius:50%;background:#6b5c3e;left:18px;top:50%;box-shadow:inset 0 1px 2px #31291a}
.phase3-field-desk{grid-template-columns:repeat(3,minmax(0,1fr))}.battle-roster-mini{background:#c9b073;position:relative}.battle-roster-mini:before{content:"BATTLE ROSTER";position:absolute;top:-24px;left:18px;background:#d0b978;border:1px solid #806a40;border-bottom:0;padding:5px 10px;font-size:8px}.battle-roster-mini dl{display:grid;grid-template-columns:90px 1fr;font-size:9px}.battle-roster-mini dt,.battle-roster-mini dd{margin:0;padding:5px 0;border-bottom:1px dotted #7b6742}.roster-mini-name{font-size:15px;font-weight:700;margin:12px 0}.weapon-desk-record{background:#d8cfb8;position:relative}.weapon-desk-record header{position:relative}.weapon-status{position:absolute;right:0;top:0;font-size:8px;border:2px solid currentColor;padding:3px 5px;transform:rotate(-2deg)}.weapon-desk-record dl{display:grid;grid-template-columns:1fr 1fr;gap:0;font-size:8px}.weapon-desk-record dt,.weapon-desk-record dd{margin:0;padding:5px 0;border-bottom:1px dotted #81765e}.weapon-desk-record dd{text-align:right}
.weapon-visual{position:relative;isolation:isolate;background:transparent}.weapon-visual img{width:100%;height:auto;object-fit:contain;position:relative;z-index:1}.weapon-visual.compact{height:125px;margin:8px 0}.weapon-visual.compact img{height:100%}.weapon-visual.record{min-height:210px;margin:12px 0}.weapon-visual.large{min-height:260px;margin:24px 0 12px}.weapon-dirt-layer{position:absolute;inset:0;z-index:2;pointer-events:none;-webkit-mask:url('/static/art/m16-rifle-master.webp') center/contain no-repeat;mask:url('/static/art/m16-rifle-master.webp') center/contain no-repeat;opacity:0;mix-blend-mode:multiply;background-image:radial-gradient(circle at 24% 60%,rgba(95,67,35,.9) 0 2%,transparent 7%),radial-gradient(circle at 56% 58%,rgba(67,54,33,.72) 0 3%,transparent 9%),radial-gradient(circle at 78% 48%,rgba(105,78,42,.72) 0 2%,transparent 8%),repeating-radial-gradient(circle at 50% 50%,rgba(62,49,29,.2) 0 1px,transparent 2px 7px)}.weapon-state-1 .weapon-dirt-layer{opacity:.13}.weapon-state-2 .weapon-dirt-layer{opacity:.25}.weapon-state-3 .weapon-dirt-layer{opacity:.39}.weapon-state-4 .weapon-dirt-layer{opacity:.56}.weapon-state-5 .weapon-dirt-layer{opacity:.72}.weapon-state-2 img{filter:brightness(.96) saturate(.92)}.weapon-state-3 img{filter:brightness(.91) saturate(.82)}.weapon-state-4 img{filter:brightness(.83) saturate(.72)}.weapon-state-5 img{filter:brightness(.72) saturate(.6) contrast(.92)}.status-stage-0{color:#375031}.status-stage-1{color:#5a5836}.status-stage-2{color:#6c4d27}.status-stage-3{color:#844429}.status-stage-4,.status-stage-5{color:var(--stamp)}.weapon-state-banner{display:inline-block;border:2px solid currentColor;padding:5px 9px;font-size:10px;font-weight:700;letter-spacing:.06em;transform:rotate(-1deg);margin:0 0 12px}.weapon-record-grid{display:grid;grid-template-columns:160px 1fr;margin:14px 0}.weapon-record-grid dt,.weapon-record-grid dd{margin:0;padding:7px 9px;border-bottom:1px dotted #84785f;font-size:10px}.weapon-stamp{display:inline-block;float:right;margin-top:-50px}.weapon-stamp.good{color:#375031;border-color:#375031}.weapon-stamp.danger{color:#7f1f1b;border-color:#7f1f1b}
.phase3-supply{grid-template-columns:1.4fr .8fr}.individual-weapon-ledger{padding:34px 40px;grid-column:1/2}.individual-weapon-ledger+.property-record{grid-column:1/2}.phase3-supply .inspection-clipboard{grid-column:2;grid-row:1/3}.property-owner{margin:16px 0 6px;font-size:10px;border-bottom:1px solid #84785f;padding-bottom:7px}
.phase3-201 .file-documents{grid-template-columns:1fr 1fr}.weapon-file-sheet{grid-column:1/3}.service-journal{grid-column:1/3}.journal-entry p{font-size:10px;margin:4px 0;color:#4e4738}
.s1-workroom{padding:70px 5vw 100px;background:#5b604f;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.65fr);gap:32px}.s1-intake{padding:34px 40px}.s1-intake h2{font-size:23px}.army-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px}.army-form-grid label{font-size:8px;font-weight:700;color:#514a39}.army-form-grid input{display:block;width:100%;margin-top:5px;padding:9px 5px;background:transparent;border:0;border-bottom:1px solid #645a47;border-radius:0;color:var(--ink)}.army-form-grid button{grid-column:1/3;margin-top:8px}.issued-packet{position:relative;background:#cbb27a;color:var(--ink);padding:34px;border:1px solid #856b3e;box-shadow:var(--shadow-paper);align-self:start;transform:rotate(.25deg)}.issued-packet .ink-stamp{position:absolute;right:22px;top:22px}.issued-packet dl{display:grid;grid-template-columns:120px 1fr;font-size:9px}.issued-packet dt,.issued-packet dd{margin:0;padding:6px;border-bottom:1px dotted #806a46}.field-code-reveal{font-size:16px;font-weight:700;letter-spacing:.12em}.one-time-warning{font-size:8px;font-weight:700;margin-top:15px}.s1-roster-sheet{grid-column:1/3;padding:32px 38px}.s1-roster-sheet>header{display:flex;align-items:end;justify-content:space-between;border-bottom:2px solid #554e3f;padding-bottom:10px;margin-bottom:8px}.s1-roster-sheet header b{font-size:18px}.s1-roster-head,.s1-roster-row{display:grid;grid-template-columns:1.25fr 1fr .8fr 1fr .55fr;gap:12px;padding:8px 4px;border-bottom:1px dotted #837860;font-size:9px;align-items:center}.s1-roster-head{font-weight:700;background:rgba(69,62,46,.06)}.s1-roster-row span{display:flex;flex-direction:column}.s1-roster-row small{color:#655e4e}.s1-roster-row button{border:1px solid #716040;background:#ceb77d;color:#2f2a20;padding:6px 7px;cursor:pointer;font-size:7px;font-weight:700}.s1-hero .staff-sign{max-width:720px}

@media(max-width:1120px){.phase3-field-desk{grid-template-columns:1fr 1fr}.s1-workroom{grid-template-columns:1fr}.s1-roster-sheet{grid-column:auto}.phase3-supply{grid-template-columns:1fr}.individual-weapon-ledger,.individual-weapon-ledger+.property-record,.phase3-supply .inspection-clipboard{grid-column:auto;grid-row:auto}.weapon-file-sheet,.service-journal{grid-column:auto}.phase3-201 .file-documents{grid-template-columns:1fr}}
@media(max-width:720px){.phase3-field-desk{grid-template-columns:1fr}.battle-card-wrap{padding:14px}.battle-card-full{padding:28px 20px;transform:none}.battle-card-full dl{grid-template-columns:1fr}.battle-card-full dt{padding-bottom:0;border-bottom:0}.battle-card-full dd{padding-top:1px}.s1-workroom{padding:50px 14px}.s1-intake,.issued-packet,.s1-roster-sheet{padding:26px 18px}.army-form-grid{grid-template-columns:1fr}.army-form-grid button{grid-column:auto}.s1-roster-head{display:none}.s1-roster-row{grid-template-columns:1fr 1fr;gap:5px 10px;padding:14px 4px}.s1-roster-row span:nth-child(3),.s1-roster-row span:nth-child(4),.s1-roster-row span:nth-child(5){grid-column:1/3}.weapon-record-grid{grid-template-columns:1fr}.weapon-record-grid dt{border-bottom:0;padding-bottom:0}.weapon-record-grid dd{padding-top:1px}.weapon-visual.large{min-height:180px}.weapon-visual.record{min-height:150px}.weapon-stamp{float:none;margin:12px 0}.battle-roster-room{padding:60px 14px;background-attachment:scroll}}

/* PHASE 4 — personnel actions */
.personnel-actions-desk{display:grid;grid-template-columns:1fr 1fr;gap:1.35rem;margin:1.5rem 0}
.personnel-action-form{padding:1.25rem;position:relative}
.personnel-action-form .army-form-grid{margin-top:1rem}
#rank,#appointments{position:relative}
@media(max-width:900px){.personnel-actions-desk{grid-template-columns:1fr}}

/* ========================================================================
   PHASE 5 — BATTALION ORGANIZATION / ORDERLY ROOMS / LEADERSHIP FILES
   ======================================================================== */
.organization-room{max-width:1500px;margin:-2rem auto 4rem;padding:0 2rem;position:relative;z-index:4}
.assignment-board{background:#4c4a35 url("art/map-table.webp") center/cover no-repeat;background-blend-mode:multiply;border:1px solid rgba(218,207,164,.22);box-shadow:0 22px 60px rgba(0,0,0,.35);padding:1.5rem}
.board-header{background:#d7c8a1;color:#211f18;padding:1rem 1.25rem;margin-bottom:1.2rem;box-shadow:0 4px 12px rgba(0,0,0,.3);transform:rotate(-.15deg)}
.board-header h2{margin:.2rem 0;font-size:clamp(1.4rem,3vw,2.5rem)}
.company-board-grid{display:grid;grid-template-columns:repeat(3,minmax(260px,1fr));gap:1.1rem;align-items:start}
.company-column{background:#b9aa7f;padding:.7rem .7rem 1rem;box-shadow:0 8px 18px rgba(0,0,0,.28);border-top:8px solid #574f32}
.company-board-title{display:block;background:#25281c;color:#e1d7b5;padding:.65rem;text-align:center;letter-spacing:.08em;text-decoration:none}
.platoon-board{margin:.8rem 0;background:#d3c399;padding:.55rem;box-shadow:0 3px 8px rgba(0,0,0,.22)}
.platoon-board>a{display:block;color:#211f18;font-weight:700;text-decoration:none;border-bottom:1px solid rgba(34,30,19,.35);padding:.25rem}
.squad-board{margin:.55rem 0;padding:.45rem;background:rgba(240,232,203,.66)}
.squad-board>b,.squad-board h3{display:block;color:#272419;font-size:.83rem;letter-spacing:.06em;margin:0 0 .4rem}
.name-strip,.vacant-strip{display:block;background:#eee3bf;color:#211e16;margin:.27rem 0;padding:.38rem .48rem;border-left:3px solid #4e5231;box-shadow:0 2px 4px rgba(0,0,0,.18);text-decoration:none;transition:transform .14s ease,box-shadow .14s ease}
.name-strip:hover{transform:translateX(4px);box-shadow:0 4px 9px rgba(0,0,0,.25)}
.name-strip strong,.name-strip small{display:block}
.name-strip small{opacity:.7;font-size:.7rem;margin-top:.12rem}
.vacant-strip{opacity:.55;font-size:.72rem}
.name-strip.headquarters{margin:.5rem .2rem}
.company-command-board{background:#5d5b40;padding:1rem;color:#e7ddbd;box-shadow:0 10px 30px rgba(0,0,0,.32)}
.company-command-board header{border-bottom:1px solid rgba(231,221,189,.28);margin-bottom:.7rem}
.company-command-board h2{margin:.2rem 0 .7rem}
.command-lines>div{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:.55rem 0;border-bottom:1px dashed rgba(231,221,189,.22)}
.command-lines span{font-size:.72rem;letter-spacing:.08em}
.command-lines b{text-align:right}
.platoon-directory{display:flex;gap:.6rem;flex-wrap:wrap;margin:1rem 0}
.platoon-directory a{background:#d8c89e;color:#211f18;padding:.6rem .75rem;text-decoration:none;border-left:4px solid #4b4e2d;box-shadow:0 3px 7px rgba(0,0,0,.18)}
.platoon-directory a small{display:block;font-size:.62rem;opacity:.65;margin-top:.12rem}
.platoon-room,.my-soldiers-room{max-width:1300px;margin:-1rem auto 4rem;padding:0 2rem;display:grid;grid-template-columns:minmax(280px,.7fr) minmax(0,2fr);gap:1.3rem;align-items:start}
.platoon-command{padding:1rem}
.platoon-command dl{display:grid;grid-template-columns:1fr 1fr;gap:.5rem .7rem}
.platoon-command dt{font-size:.7rem;letter-spacing:.07em}
.platoon-command dd{margin:0;text-align:right;font-weight:700}
.platoon-assignment-board{display:grid;grid-template-columns:repeat(2,minmax(240px,1fr));gap:.8rem}
.my-soldiers-room{display:block}
.leader-roster{padding:1rem}
.leader-roster-head,.leader-roster-row{display:grid;grid-template-columns:1.4fr 1.15fr 1.1fr 1.1fr .8fr;gap:.6rem;padding:.6rem;border-bottom:1px solid rgba(40,34,20,.25);align-items:center}
.leader-roster-head{font-size:.68rem;font-weight:800;letter-spacing:.06em;border-bottom:2px solid #2d2b1f}
.leader-roster-row span,.leader-roster-row small{display:block}
.leader-roster-row small{font-size:.67rem;opacity:.65;margin-top:.12rem}
.assignment-orders-form{max-width:1050px;margin:1.4rem auto;padding:1.25rem}
.army-form-grid .wide{grid-column:1/-1}
@media(max-width:1100px){
 .company-board-grid{grid-template-columns:1fr}
 .platoon-room{grid-template-columns:1fr}
 .platoon-assignment-board{grid-template-columns:1fr}
 .leader-roster-head{display:none}
 .leader-roster-row{grid-template-columns:1fr 1fr}
}
@media(max-width:700px){
 .organization-room,.platoon-room,.my-soldiers-room{padding:0 .75rem}
 .assignment-board{padding:.65rem}
 .company-column{padding:.45rem}
 .leader-roster-row{grid-template-columns:1fr;padding:.8rem .45rem}
 .command-lines>div{grid-template-columns:1fr}
 .command-lines b{text-align:left}
}

/* ========================================================================
   PHASE 6 — MORNING REPORT / BATTALION READINESS
   ======================================================================== */
.morning-report-room{max-width:1500px;margin:0 auto;padding:2rem}
.mr-desk{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,.8fr);gap:1.3rem;align-items:start;background:rgba(46,48,31,.48);padding:1.2rem;box-shadow:inset 0 0 70px rgba(0,0,0,.2)}
.morning-report-sheet{padding:1.4rem;transform:rotate(-.12deg)}
.mr-letterhead{text-align:center;border-bottom:2px solid #29261c;padding-bottom:1rem;margin-bottom:.8rem}
.mr-letterhead>*{display:block}.mr-letterhead strong{font-size:1.25rem}.mr-letterhead b{font-size:1.8rem;margin-top:.8rem}.mr-letterhead em{font-style:normal;font-size:.75rem;margin-top:.3rem}
.mr-grid{display:grid;grid-template-columns:1.6fr repeat(7,.7fr);gap:.3rem;padding:.5rem .35rem;border-bottom:1px solid rgba(38,33,23,.25);align-items:center;text-align:center;font-size:.78rem}
.mr-grid span:first-child{text-align:left}.mr-head{font-size:.62rem;font-weight:800;border-bottom:2px solid #2c291f}.mr-total{font-weight:800;border-top:2px solid #2c291f;margin-top:.25rem}
.mr-side-stack{display:grid;gap:1rem}.deficiency-sheet,.deros-sheet{padding:1rem}.deficiency-sheet header,.deros-sheet header{border-bottom:2px solid #2d291e;padding-bottom:.5rem;margin-bottom:.5rem}
.deficiency-line{display:grid;grid-template-columns:1fr auto;gap:.2rem .7rem;padding:.55rem 0;border-bottom:1px dashed rgba(38,33,23,.3)}.deficiency-line small{grid-column:1/-1;font-size:.65rem}
.vacancy-notice{margin:.55rem 0;padding:.5rem;border:2px solid rgba(124,39,31,.58);transform:rotate(-.2deg)}.vacancy-notice>*{display:block}.vacancy-notice b{color:#74271f}
.deros-line{padding:.55rem 0;border-bottom:1px dashed rgba(38,33,23,.3)}.deros-line>*{display:block}.deros-line b{font-size:.78rem}.deros-line small{font-size:.65rem}
.mr-archive{margin:1.4rem 0;padding:1rem}.archive-head,.archive-row{display:grid;grid-template-columns:1.3fr repeat(5,1fr);gap:.4rem;padding:.5rem;border-bottom:1px solid rgba(38,33,23,.25);text-align:center}.archive-head{font-size:.65rem;font-weight:800;border-bottom:2px solid #2c291f}
.readiness-room{max-width:1300px;margin:-1rem auto 4rem;padding:0 2rem;display:grid;grid-template-columns:minmax(300px,.75fr) minmax(0,1.7fr);gap:1.2rem;align-items:start}
.individual-readiness,.unit-readiness{padding:1rem}.individual-readiness dl{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.individual-readiness dt{font-size:.7rem;letter-spacing:.06em}.individual-readiness dd{margin:0;text-align:right;font-weight:700}
.readiness-stamp{border:3px double #394326;padding:.65rem;margin-top:1rem;text-align:center;font-weight:900;letter-spacing:.06em;transform:rotate(-1deg)}.readiness-stamp.deficient{border-color:#78362d;color:#6e2e27}
.readiness-soldier{display:grid;grid-template-columns:1.3fr .9fr .8fr 1.4fr;gap:.5rem;padding:.65rem 0;border-bottom:1px dashed rgba(38,33,23,.28);align-items:center}.readiness-soldier span>*{display:block}.readiness-soldier small{font-size:.65rem;opacity:.7}.readiness-soldier strong{text-align:right;font-size:.72rem}
.readiness-file-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem}.readiness-file-summary span{border-bottom:1px solid rgba(38,33,23,.3);padding:.45rem}.readiness-file-summary b,.readiness-file-summary small{display:block;margin-top:.15rem}
@media(max-width:1000px){.mr-desk,.readiness-room{grid-template-columns:1fr}.mr-grid{grid-template-columns:1.5fr repeat(3,.7fr)}.mr-grid span:nth-child(n+5){display:none}.readiness-soldier{grid-template-columns:1fr 1fr}.readiness-soldier strong{text-align:left}}
@media(max-width:650px){.morning-report-room,.readiness-room{padding:.7rem}.mr-desk{padding:.5rem}.mr-grid{font-size:.68rem;grid-template-columns:1.4fr repeat(3,.65fr)}.archive-head,.archive-row{grid-template-columns:1.3fr repeat(3,1fr)}.archive-head span:nth-child(n+5),.archive-row span:nth-child(n+5){display:none}.readiness-soldier{grid-template-columns:1fr}.readiness-file-summary{grid-template-columns:1fr}}

/* ========================================================================
   PHASE 7 — S-4 SUPPLY / ARMS ROOM / PERSISTENT PROPERTY
   ======================================================================== */
.supply-yard-hero{height:48vh;min-height:350px;position:relative;overflow:hidden;background:#333728}
.supply-yard-photo{position:absolute;inset:0;background:url("art/hq-canvas.webp") center 58%/cover no-repeat;filter:saturate(.75) contrast(1.04)}
.supply-yard-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,22,15,.86),rgba(20,22,15,.28) 55%,rgba(20,22,15,.48))}
.supply-yard-sign{position:absolute;left:6vw;bottom:12%;color:#e6d8ac;text-shadow:0 2px 3px rgba(0,0,0,.65)}
.supply-yard-sign h1{font-size:clamp(2.3rem,6vw,5.3rem);margin:.2rem 0;letter-spacing:.06em}
.supply-yard-sign p,.supply-yard-sign small{letter-spacing:.08em}
.supply-room{max-width:1500px;margin:-2.5rem auto 3rem;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.8fr) minmax(320px,.85fr);gap:1.25rem;position:relative;z-index:4}
.supply-primary,.supply-admin-stack{display:grid;gap:1.1rem;align-content:start}
.weapon-record-sheet,.equipment-record-sheet,.arms-room-ledger,.s4-action-form{padding:1.15rem}
.weapon-record-grid{display:grid;grid-template-columns:minmax(300px,1.5fr) minmax(260px,.8fr);gap:1rem;align-items:center}
.weapon-image-stage{position:relative;background:#cbbd91;padding:1rem;min-height:240px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid rgba(45,39,25,.35)}
.weapon-image-stage img{width:100%;max-height:220px;object-fit:contain;position:relative;z-index:1;filter:saturate(.8) contrast(1.03)}
.weapon-wear-overlay{position:absolute;inset:0;pointer-events:none;z-index:2;mix-blend-mode:multiply}
.condition-field-worn .weapon-wear-overlay{background:linear-gradient(20deg,rgba(88,70,36,.08),rgba(70,55,28,.16))}
.condition-fouled .weapon-wear-overlay{background:radial-gradient(circle at 65% 55%,rgba(59,45,24,.34),transparent 30%),linear-gradient(20deg,rgba(72,59,30,.15),rgba(48,40,23,.24))}
.condition-cleaning-required .weapon-wear-overlay{background:radial-gradient(circle at 68% 55%,rgba(50,40,23,.52),transparent 32%),linear-gradient(20deg,rgba(70,55,29,.24),rgba(45,38,22,.35))}
.condition-maintenance-required .weapon-wear-overlay,.condition-unserviceable .weapon-wear-overlay{background:radial-gradient(circle at 68% 55%,rgba(43,34,20,.65),transparent 36%),linear-gradient(30deg,rgba(84,63,31,.4),rgba(35,31,19,.52))}
.weapon-record-grid dl{display:grid;grid-template-columns:1fr 1fr;gap:.35rem .7rem}.weapon-record-grid dt{font-size:.68rem;letter-spacing:.07em}.weapon-record-grid dd{margin:0;text-align:right;font-weight:700;border-bottom:1px solid rgba(40,34,20,.28)}
.serviceability-stamp{display:inline-block;margin-top:1rem;border:3px double #3f472d;padding:.5rem .8rem;font-weight:900;letter-spacing:.08em;transform:rotate(-1deg)}
.state-cleaning-required,.state-maintenance-required,.state-unserviceable{border-color:#77352d;color:#6d2d26}
.property-table,.stock-table{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:.5rem;padding:.55rem;border-bottom:1px solid rgba(42,36,23,.24);align-items:center;font-size:.78rem}.property-table.head,.stock-table.head{font-size:.64rem;font-weight:900;border-bottom:2px solid #2c291e}
.arms-room-ledger{background:#d4c59a}.rack-entry{display:grid;grid-template-columns:.45fr 1.2fr 1.25fr .9fr;gap:.4rem;padding:.5rem;border-bottom:1px solid rgba(42,36,23,.25);font-size:.72rem}.rack-entry em{text-align:right;font-style:normal}
.company-supply-area,.s4-ledger-area{max-width:1450px;margin:1rem auto 4rem;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(320px,.9fr);gap:1.2rem;align-items:start}
.company-stock-sheet,.requisition-sheet,.maintenance-journal{padding:1.15rem}
.company-stock-block{margin:1rem 0 1.4rem}.company-stock-block h3{margin:.25rem 0 .5rem;border-bottom:2px solid #302d20;padding-bottom:.35rem}
.supply-state{font-weight:900}.supply-state.low{color:#7a4d16}.supply-state.critical{color:#782c24}
.requisition-list>div,.maintenance-entry{padding:.55rem 0;border-bottom:1px dashed rgba(42,36,23,.28)}.requisition-list span,.requisition-list b,.requisition-list small,.maintenance-entry span,.maintenance-entry b,.maintenance-entry small{display:block}.requisition-list span,.maintenance-entry span{font-size:.65rem;opacity:.7}.requisition-list small,.maintenance-entry small{font-size:.68rem;margin-top:.12rem}
@media(max-width:1100px){.supply-room,.company-supply-area,.s4-ledger-area{grid-template-columns:1fr}.weapon-record-grid{grid-template-columns:1fr}.arms-room-ledger{max-height:520px;overflow:auto}}
@media(max-width:700px){.supply-room,.company-supply-area,.s4-ledger-area{padding:0 .7rem}.weapon-record-grid dl{grid-template-columns:1fr}.weapon-record-grid dd{text-align:left}.property-table,.stock-table{grid-template-columns:1.6fr 1fr 1fr}.property-table span:nth-child(3),.stock-table span:nth-child(4){display:none}.rack-entry{grid-template-columns:.5fr 1fr}.rack-entry small,.rack-entry em{grid-column:1/-1;text-align:left}}

/* ========================================================================
   PHASE 8 — S-3 OPERATIONS CENTER / COMBAT HISTORY
   ======================================================================== */
.ops-tent-hero{height:50vh;min-height:360px;position:relative;overflow:hidden;background:#2d3124}
.ops-tent-photo{position:absolute;inset:0;background:url("art/hq-canvas.webp") center 45%/cover no-repeat;filter:saturate(.72) contrast(1.03)}
.ops-tent-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,22,15,.86),rgba(20,22,15,.24) 58%,rgba(20,22,15,.48))}
.ops-tent-sign{position:absolute;left:6vw;bottom:13%;color:#eadcaf;text-shadow:0 2px 3px rgba(0,0,0,.7)}
.ops-tent-sign h1{font-size:clamp(2.5rem,6vw,5.4rem);margin:.2rem 0;letter-spacing:.06em}
.ops-center{max-width:1500px;margin:-2.5rem auto 3rem;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(330px,.85fr);gap:1.2rem;position:relative;z-index:4}
.ops-map-board{min-height:680px;position:relative;background:#b8aa79 url("art/map-table.webp") center/cover no-repeat;background-blend-mode:multiply;padding:1rem;box-shadow:0 20px 55px rgba(0,0,0,.34);overflow:hidden}
.map-overlay-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(30,35,23,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(30,35,23,.16) 1px,transparent 1px);background-size:48px 48px;mix-blend-mode:multiply;pointer-events:none}
.ops-map-board>header{position:relative;background:#d7c9a1;color:#211f17;padding:.75rem 1rem;display:flex;justify-content:space-between;align-items:center;transform:rotate(-.15deg);box-shadow:0 3px 8px rgba(0,0,0,.25)}
.current-ops-stack{position:relative;display:grid;grid-template-columns:repeat(2,minmax(240px,1fr));gap:1rem;padding:1.3rem}
.op-folder{display:block;background:#c6b47f;color:#211f17;padding:1rem 1rem 1.25rem;text-decoration:none;box-shadow:0 8px 18px rgba(0,0,0,.3);border-top:14px solid #9c8b5d;transform:rotate(-.35deg);transition:transform .16s ease,box-shadow .16s ease}
.op-folder:nth-child(even){transform:rotate(.28deg)}.op-folder:hover{transform:translateY(-5px) rotate(0);box-shadow:0 13px 24px rgba(0,0,0,.34)}
.op-folder>*{display:block}.op-folder span,.op-folder small,.op-folder em{font-size:.68rem}.op-folder b{font-size:1.05rem;margin:.25rem 0}.op-folder em{font-style:normal;margin-top:.6rem;border:1px solid rgba(45,38,22,.4);display:inline-block;padding:.2rem .4rem}
.map-note{position:relative;background:#d8c99e;padding:.8rem}
.ops-admin-stack{display:grid;gap:1rem;align-content:start}.opord-form,.op-participation-form,.aar-form,.personnel-recommendation{padding:1.15rem}.opord-form textarea,.aar-form textarea,.personnel-recommendation textarea{min-height:80px}
.operations-journal-area,.recommendations-area{max-width:1450px;margin:1rem auto 4rem;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(330px,.9fr);gap:1.2rem;align-items:start}
.operations-journal,.aar-form{padding:1.15rem}.journal-entry{display:grid;grid-template-columns:.65fr 1.4fr 1.6fr;gap:.6rem;padding:.65rem 0;border-bottom:1px dashed rgba(42,36,23,.28);color:#252116;text-decoration:none}.journal-entry span{font-size:.7rem}.journal-entry small{font-size:.68rem}
.operation-file-room{max-width:1450px;margin:2rem auto;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(300px,.75fr);gap:1.2rem;align-items:start}.opord-sheet{padding:1.4rem}.opord-sheet h1{font-size:2rem;margin:1rem 0}.op-meta{display:grid;grid-template-columns:repeat(5,1fr);gap:.5rem;border-top:2px solid #2d291e;border-bottom:2px solid #2d291e;padding:.6rem 0}.op-meta span,.op-meta b{display:block}.op-meta span{font-size:.65rem}.op-meta b{font-size:.75rem;margin-top:.15rem}.opord-sheet section{margin:1rem 0}.opord-sheet h2{font-size:1rem;margin:0 0 .35rem}
.operation-side-files{display:grid;gap:1rem}.unit-tasking,.participant-roster{padding:1rem}.unit-tasking>div,.participant-roster>div{padding:.55rem 0;border-bottom:1px dashed rgba(42,36,23,.28)}.unit-tasking>* *, .participant-roster>* *{display:block}.unit-tasking small,.participant-roster small{font-size:.67rem}
.operation-aar{max-width:1000px;margin:1rem auto 4rem;padding:0 2rem}.operation-aar article{padding:1.2rem}.operation-aar dl{display:grid;grid-template-columns:.5fr 1.5fr;gap:.5rem}.operation-aar dd{margin:0;border-bottom:1px solid rgba(42,36,23,.25)}
@media(max-width:1050px){.ops-center,.operations-journal-area,.recommendations-area,.operation-file-room{grid-template-columns:1fr}.current-ops-stack{grid-template-columns:1fr}.op-meta{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.ops-center,.operations-journal-area,.recommendations-area,.operation-file-room,.operation-aar{padding:0 .7rem}.ops-map-board{min-height:520px;padding:.5rem}.current-ops-stack{padding:.7rem}.journal-entry{grid-template-columns:1fr}.op-meta{grid-template-columns:1fr 1fr}}

/* PHASE 9 — TRAINING OFFICE */
.training-office-hero{min-height:310px;display:flex;align-items:end;padding:3rem 6vw;background:linear-gradient(90deg,rgba(25,29,20,.9),rgba(25,29,20,.35)),url("art/hq-canvas.webp") center/cover;color:#e8dbb2}
.training-office-hero h1{font-size:clamp(2.6rem,6vw,5rem);margin:.25rem 0;letter-spacing:.05em}
.training-desk,.training-records-area{max-width:1450px;margin:2rem auto;padding:0 2rem;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(320px,.8fr);gap:1.2rem;align-items:start}
.qualification-register,.training-admin article,.training-records-area>article,.training-request-area article{padding:1.2rem}
.qualification-group{margin:1rem 0}.qualification-group h2{font-size:.85rem;border-bottom:2px solid #332f23;padding-bottom:.3rem}
.qual-role-list{display:grid;grid-template-columns:repeat(2,minmax(180px,1fr));gap:.4rem}.qual-role{border-bottom:1px dashed rgba(40,35,24,.3);padding:.45rem}.qual-role b,.qual-role small{display:block}.qual-role small{font-size:.65rem}
.training-request-area{max-width:900px;margin:2rem auto 4rem;padding:0 2rem}
.typed-table{margin-top:1rem}.typed-row{display:grid;grid-template-columns:1.4fr .65fr 1.3fr .7fr .8fr;gap:.5rem;padding:.48rem 0;border-bottom:1px dashed rgba(40,35,24,.25);font-size:.76rem}.typed-row.head{font-weight:700;border-bottom:2px solid #332f23}
.deficiency-entry{padding:.55rem 0;border-bottom:1px dashed rgba(40,35,24,.25)}.deficiency-entry>*{display:block}.deficiency-entry small{font-size:.67rem}
@media(max-width:950px){.training-desk,.training-records-area{grid-template-columns:1fr}.typed-row{grid-template-columns:1.2fr .8fr 1.2fr}.typed-row span:nth-child(2),.typed-row span:nth-child(5){display:none}}
@media(max-width:650px){.training-desk,.training-records-area,.training-request-area{padding:0 .7rem}.qual-role-list{grid-template-columns:1fr}}

/* Rank insignia asset integration — Vietnam-era worn insignia supplied by unit HQ. */
.personnel-rank-title{align-items:center}.rank-title-identity{display:flex;align-items:center;gap:18px;min-width:0}.rank-insignia{display:block;object-fit:contain;filter:drop-shadow(0 2px 2px rgba(0,0,0,.25))}.rank-insignia.current-rank{width:76px;height:76px;flex:0 0 76px}.rank-history-identity{display:flex;align-items:center;gap:10px}.rank-insignia.history-rank{width:42px;height:42px;flex:0 0 42px}.rank-history-row>small{padding-left:52px}@media(max-width:720px){.rank-insignia.current-rank{width:58px;height:58px;flex-basis:58px}.rank-title-identity{gap:10px}.rank-insignia.history-rank{width:34px;height:34px;flex-basis:34px}.rank-history-row>small{padding-left:44px}}


/* =========================================================
   CUMULATIVE PATCH 02 — CENTERED / LARGER MAIN NAVIGATION
   Desktop only. Mobile menu behavior remains unchanged.
   ========================================================= */
@media (min-width:1121px){
  .header-desk{
    min-height:104px;
    padding:10px 2.2vw;
    display:grid;
    grid-template-columns:minmax(270px,1fr) auto minmax(270px,1fr);
    align-items:center;
    column-gap:24px;
  }

  .unit-mark{
    min-width:0;
    justify-self:start;
  }

  .record-index{
    margin-left:0;
    justify-self:center;
    align-items:stretch;
    gap:3px;
  }

  .record-index a{
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:50px;
    padding:14px 15px 12px;
    font-size:12px;
    line-height:1;
    letter-spacing:.045em;
    white-space:nowrap;
  }

  .record-index .duty-tab{
    margin-left:8px;
    padding-left:18px;
    padding-right:18px;
  }
}


/* =========================================================
   CUMULATIVE PATCH 03 — BATTALION COMMAND / BILLET RANKS
   ========================================================= */
.battalion-command-ranks{
  margin:1rem 0 1.25rem;
  padding:.9rem;
  background:#2b3023;
  color:#eee4c4;
  border:1px solid rgba(218,207,164,.2);
  box-shadow:0 8px 18px rgba(0,0,0,.24);
}
.battalion-command-ranks>header{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:1rem;
  border-bottom:1px solid rgba(238,228,196,.24);
  padding-bottom:.55rem;
  margin-bottom:.7rem;
}
.battalion-command-ranks>header small{font-size:.62rem;letter-spacing:.09em;color:#cbb77d}
.battalion-command-ranks>header h3{margin:0;font-size:1.05rem;letter-spacing:.08em}
.command-rank-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}
.command-rank-card{
  min-height:84px;
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:.25rem .75rem;
  padding:.72rem .8rem;
  background:#d3c399;
  color:#211f18;
  border-left:5px solid #b6973f;
  box-shadow:0 3px 8px rgba(0,0,0,.22);
}
.command-rank-card span{font-size:.68rem;font-weight:700;letter-spacing:.055em}
.command-rank-card strong{font-size:1.2rem;letter-spacing:.07em;color:#433b23}
.command-rank-card small{grid-column:1/-1;font-size:.58rem;opacity:.62;letter-spacing:.05em}

.company-command-ranks{
  display:grid;
  grid-template-columns:1fr;
  gap:.32rem;
  margin:.55rem 0 .7rem;
}
.company-command-ranks div,
.platoon-command-rank,
.squad-command-rank{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:.8rem;
  background:rgba(37,40,28,.9);
  color:#e6dbb9;
  padding:.42rem .5rem;
  border-left:3px solid #b6973f;
  font-size:.63rem;
  letter-spacing:.055em;
}
.company-command-ranks strong,
.platoon-command-rank strong,
.squad-command-rank strong{
  color:#e0bb46;
  font-size:.76rem;
  letter-spacing:.08em;
  flex:0 0 auto;
}
.platoon-command-rank{margin:.42rem .15rem .55rem;background:#4b4e35}
.squad-command-rank{margin:0 0 .42rem;background:#5b5a40;color:#f0e6c6}

@media(max-width:900px){
  .command-rank-grid{grid-template-columns:1fr}
}


/* =========================================================
   EDIT 02 — COMPLETE BATTALION ORGANIZATION PAGE REDESIGN
   ========================================================= */
.battalion-redesign .organization-room{display:none}

.battalion-hero-redesign{
  height:34vh;
  min-height:300px;
}
.battalion-hero-redesign .battalion-sign{
  max-width:880px;
  bottom:36px;
}
.battalion-hero-redesign .battalion-sign img{
  width:105px;
  height:105px;
}

.battalion-command-page{
  width:min(1480px,94vw);
  margin:0 auto;
  padding:38px 0 90px;
  color:#e9e0c3;
}
.battalion-page-heading{
  position:relative;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:28px;
  padding:24px 30px;
  margin-bottom:22px;
  background:#d2c39a;
  color:#211f18;
  border:1px solid #8f805d;
  box-shadow:0 10px 30px rgba(0,0,0,.28);
}
.battalion-page-heading small{
  display:block;
  font-size:9px;
  letter-spacing:.08em;
  margin-bottom:7px;
}
.battalion-page-heading h2{
  margin:0;
  font-size:clamp(27px,3vw,42px);
  line-height:1;
  letter-spacing:.055em;
}
.battalion-page-heading p{
  max-width:760px;
  margin:10px 0 0;
  font-size:11px;
}
.toe-stamp{
  flex:0 0 auto;
  border:3px double #6b3529;
  color:#6b3529;
  padding:10px 14px;
  font-size:10px;
  font-weight:700;
  text-align:center;
  letter-spacing:.08em;
  transform:rotate(1.2deg);
}

.command-echelon{
  margin-bottom:24px;
  padding:14px;
  background:#55533b;
  border:1px solid rgba(220,205,158,.24);
  box-shadow:0 13px 32px rgba(0,0,0,.30);
}
.battalion-echelon{
  background:#252a20;
  border-top:5px solid #b7983d;
}
.echelon-heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  padding:10px 12px 13px;
  margin-bottom:12px;
  border-bottom:1px solid rgba(229,216,176,.22);
}
.echelon-heading small{
  color:#bfa95c;
  font-size:8px;
  letter-spacing:.1em;
}
.echelon-heading h3{
  margin:2px 0 0;
  color:#f4ecd4;
  font-size:22px;
  letter-spacing:.08em;
}
.echelon-heading>span{
  color:#c9b56f;
  font-size:12px;
  font-weight:700;
}
.company-heading{
  background:#24291e;
  margin:-2px -2px 14px;
  padding:15px 16px;
  border-bottom:3px solid #b7983d;
}
.company-heading a{
  border:1px solid #a99558;
  color:#e9debd;
  padding:8px 11px;
  font-size:8px;
  font-weight:700;
  letter-spacing:.05em;
}
.company-heading a:hover{background:#c8b47a;color:#211f18}

.leader-card-grid{
  display:grid;
  gap:12px;
}
.battalion-leaders,
.company-leaders{
  grid-template-columns:repeat(3,minmax(0,1fr));
}
.leader-card{
  display:grid;
  grid-template-columns:100px 1fr;
  min-height:128px;
  overflow:hidden;
  background:#d3c49b;
  color:#211f18;
  border-left:5px solid #b7983d;
  box-shadow:0 5px 13px rgba(0,0,0,.25);
}
.command-leader{min-height:150px}
.leader-rank-insignia{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:11px;
  background:#20251c;
  border-right:1px solid #85774e;
}
.leader-rank-insignia img{
  max-width:78px;
  max-height:104px;
  object-fit:contain;
  filter:drop-shadow(0 5px 4px rgba(0,0,0,.38));
}
.leader-rank-insignia.officer img{
  max-width:68px;
  max-height:92px;
}
.leader-card-copy{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:15px 17px;
}
.leader-card-copy small{
  font-size:8px;
  font-weight:700;
  letter-spacing:.07em;
}
.leader-card-copy h4{
  margin:6px 0 2px;
  font-size:25px;
  letter-spacing:.08em;
}
.leader-card-copy span{
  font-size:7px;
  color:#675e49;
  letter-spacing:.06em;
}
.company-leaders .leader-card{
  grid-template-columns:82px 1fr;
  min-height:108px;
}
.company-leaders .leader-rank-insignia img{
  max-width:62px;
  max-height:77px;
}
.company-leaders .leader-card-copy h4{font-size:21px}

.company-echelons{display:grid;gap:26px}
.company-echelon{
  padding:16px;
  background:#6d6849;
}

.platoon-echelon-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
  margin-top:14px;
}
.platoon-echelon{
  background:#cbbb8d;
  color:#211f18;
  padding:10px;
  border:1px solid #8b7c55;
  box-shadow:0 6px 14px rgba(0,0,0,.24);
}
.platoon-heading{
  display:flex;
  justify-content:space-between;
  gap:14px;
  align-items:center;
  padding:9px 10px;
  margin-bottom:8px;
  background:#292d21;
  color:#eee3c2;
  border-left:4px solid #b7983d;
}
.platoon-heading a{
  font-size:13px;
  font-weight:700;
  letter-spacing:.07em;
}
.platoon-heading span{
  color:#bca85e;
  font-size:8px;
}
.platoon-sergeant-card,
.squad-leader-card{
  display:flex;
  align-items:center;
  gap:10px;
  padding:7px 9px;
  background:#4e5136;
  color:#eee5c9;
  margin-bottom:9px;
  border-left:3px solid #b7983d;
}
.small-rank-icon{
  width:50px;
  height:50px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#24281e;
  border:1px solid rgba(211,195,145,.32);
  flex:0 0 auto;
}
.small-rank-icon img{
  max-width:42px;
  max-height:46px;
  object-fit:contain;
  filter:drop-shadow(0 3px 3px rgba(0,0,0,.4));
}
.platoon-sergeant-card>div:last-child,
.squad-leader-card>div:last-child{
  display:grid;
  grid-template-columns:1fr auto;
  width:100%;
  align-items:center;
  column-gap:10px;
}
.platoon-sergeant-card small,
.squad-leader-card small{
  font-size:7px;
  font-weight:700;
  letter-spacing:.07em;
}
.platoon-sergeant-card strong,
.squad-leader-card strong{
  color:#e3bd40;
  font-size:12px;
}
.platoon-sergeant-card span,
.squad-leader-card span{
  grid-column:1/3;
  font-size:6px;
  color:#cfc4a3;
}

.squad-grid-redesign{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
.squad-card-redesign{
  background:#e0d1a6;
  border:1px solid #b19d6b;
  padding:7px;
}
.squad-card-redesign>header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:7px 7px 8px;
  border-bottom:1px dotted #817552;
  font-size:9px;
  letter-spacing:.05em;
}
.squad-card-redesign>header span{
  font-size:6px;
  color:#72684f;
}
.squad-leader-card{
  margin:7px 0;
  background:#5d5b3e;
}
.squad-leader-card .small-rank-icon{
  width:42px;
  height:42px;
}
.squad-leader-card .small-rank-icon img{
  max-width:35px;
  max-height:39px;
}

.squad-personnel-list{display:grid;gap:5px}
.personnel-strip-redesign{
  min-height:48px;
  display:flex;
  align-items:center;
  gap:9px;
  padding:5px 8px;
  background:#f0e5c2;
  color:#211f18;
  border-left:3px solid #646947;
  box-shadow:0 2px 5px rgba(0,0,0,.14);
}
.personnel-strip-redesign:hover{
  transform:translateX(2px);
  background:#f7edcf;
}
.personnel-rank-icon{
  width:38px;
  height:38px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
}
.personnel-rank-icon img{
  max-width:34px;
  max-height:36px;
  object-fit:contain;
}
.personnel-strip-name{
  display:flex;
  flex-direction:column;
  min-width:0;
}
.personnel-strip-name strong{
  font-size:8px;
  letter-spacing:.04em;
}
.personnel-strip-name small{
  font-size:6px;
  color:#70664e;
}
.vacant-slot{
  padding:9px 10px;
  background:rgba(238,226,188,.52);
  color:#6f674f;
  border:1px dashed #a69669;
  display:flex;
  justify-content:space-between;
  gap:8px;
  font-size:7px;
}

.company-hq-personnel{
  margin-top:12px;
  background:#b7a979;
  color:#211f18;
  padding:10px;
}
.company-hq-personnel>header{
  font-size:8px;
  font-weight:700;
  letter-spacing:.08em;
  margin-bottom:8px;
}
.hq-personnel-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px;
}

.battalion-roster-redesign{
  margin-top:30px;
  padding:30px 34px;
}
.roster-table-redesign{
  display:grid;
  grid-template-columns:100px 1.15fr 1fr 1.1fr .8fr;
  gap:10px;
  align-items:center;
  min-height:52px;
  padding:6px 8px;
  border-bottom:1px dotted #887c60;
  font-size:9px;
  color:#2a261c;
}
.roster-table-redesign.roster-head{
  min-height:34px;
  background:rgba(67,61,45,.08);
  font-weight:700;
  font-size:7px;
  letter-spacing:.07em;
}
.roster-table-redesign span small{
  display:block;
  font-size:6px;
  color:#6d6550;
}
.roster-rank-cell{
  display:flex;
  align-items:center;
  gap:8px;
}
.roster-rank-cell img{
  width:40px;
  height:40px;
  object-fit:contain;
}
.roster-rank-cell b{font-size:9px}

@media(max-width:1100px){
  .battalion-leaders,.company-leaders{grid-template-columns:1fr}
  .platoon-echelon-grid{grid-template-columns:1fr}
  .hq-personnel-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:720px){
  .battalion-command-page{width:min(100% - 24px,1480px);padding-top:24px}
  .battalion-page-heading{padding:20px 18px;align-items:flex-start}
  .toe-stamp{display:none}
  .leader-card{grid-template-columns:76px 1fr}
  .leader-rank-insignia{padding:8px}
  .leader-rank-insignia img{max-width:60px;max-height:76px}
  .squad-grid-redesign{grid-template-columns:1fr}
  .hq-personnel-grid{grid-template-columns:1fr}
  .battalion-roster-redesign{padding:22px 14px;overflow-x:auto}
  .roster-table-redesign{min-width:720px}
}


/* EDIT 03 — S-1 PERSONNEL / 201 FILE REDESIGN */
.personnel-records-room{width:min(1480px,94vw);margin:0 auto;padding:42px 0 95px}.personnel-room-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:26px 32px;margin-bottom:18px}.personnel-room-heading small{font-size:8px;letter-spacing:.08em}.personnel-room-heading h2{font-size:34px;margin:4px 0 5px;letter-spacing:.055em}.personnel-room-heading p{margin:0;font-size:10px}.s1-file-stamp{border:3px double #71362b;color:#71362b;padding:9px 13px;text-align:center;font-weight:700;font-size:11px;letter-spacing:.08em;transform:rotate(1deg)}
.my-file-callout{display:grid;grid-template-columns:auto 70px 1fr;align-items:center;gap:14px;margin:0 0 18px;padding:11px 16px;background:#272c21;color:#ece2c4;border-left:5px solid #c2a044;box-shadow:0 6px 16px rgba(0,0,0,.25)}.my-file-label{font-size:8px;color:#d2b654;font-weight:700;letter-spacing:.08em}.my-file-rank{height:54px;display:flex;align-items:center;justify-content:center}.my-file-rank img{max-height:52px;max-width:58px;object-fit:contain}.my-file-callout strong{display:block;font-size:14px}.my-file-callout small{font-size:7px;color:#bfb69e}
.personnel-file-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.personnel-file-card{position:relative;min-height:286px;padding:30px 18px 15px;background:#d2c194;color:#211f18;border:1px solid #8f7f55;box-shadow:0 9px 20px rgba(0,0,0,.28);transition:transform .15s ease,box-shadow .15s ease}.personnel-file-card:hover{transform:translateY(-3px);box-shadow:0 13px 26px rgba(0,0,0,.34)}.personnel-file-tab{position:absolute;top:-1px;left:18px;min-width:84px;padding:6px 10px 5px;background:#a78d54;border:1px solid #79643d;font-size:7px;font-weight:700;letter-spacing:.08em;text-align:center}.personnel-file-top{display:grid;grid-template-columns:78px 1fr;align-items:center;gap:13px;min-height:94px;padding-bottom:11px;border-bottom:2px solid #5e5540}.personnel-card-rank{width:74px;height:82px;display:flex;align-items:center;justify-content:center;background:#24291f;border:1px solid #766741}.personnel-card-rank img{max-width:62px;max-height:72px;object-fit:contain}.personnel-file-top small{font-size:6px;letter-spacing:.07em;color:#6d624b}.personnel-file-top h3{font-size:15px;margin:4px 0;letter-spacing:.025em}.personnel-file-top p{font-size:7px;margin:0;color:#665c46}.personnel-card-data{display:grid;grid-template-columns:115px 1fr;margin:12px 0 8px}.personnel-card-data dt,.personnel-card-data dd{margin:0;padding:5px 3px;border-bottom:1px dotted #8d7d59;font-size:7px}.personnel-card-data dd{text-align:right;font-weight:700}.open-record-line{display:flex;justify-content:space-between;align-items:center;margin-top:11px;padding-top:9px;border-top:1px solid #8d7d59;color:#574828;font-size:7px;font-weight:700;letter-spacing:.07em}.open-record-line b{font-size:10px}.empty-personnel-office{grid-column:1/-1;padding:35px}
.personnel-index{margin-top:28px;padding:28px 30px}.personnel-index-row{display:grid;grid-template-columns:100px 1.2fr .8fr 1.1fr .8fr;gap:10px;align-items:center;min-height:48px;padding:5px 7px;border-bottom:1px dotted #887c60;color:#282419;font-size:8px}.personnel-index-row:not(.head):hover{background:rgba(105,92,56,.08)}.personnel-index-row.head{min-height:31px;font-size:6px;font-weight:700;background:rgba(69,62,46,.06)}.index-rank{display:flex;align-items:center;gap:7px}.index-rank img{width:35px;height:35px;object-fit:contain}
.page-201 .weapon-file-sheet{grid-column:1/-1;border-top:5px solid #756238}.page-201 .weapon-visual.record{min-height:280px;padding:18px 20px;background:rgba(190,173,126,.24)}.page-201 .weapon-visual.record img{width:min(100%,980px);max-height:310px;margin:0 auto;object-fit:contain}.page-201 .weapon-state-banner{font-size:11px;padding:7px 11px}.page-201 .weapon-record-grid{grid-template-columns:180px 1fr;max-width:900px}
.ops-tent-photo{background-image:url("art/hq-canvas.webp")}.supply-yard-photo{background-image:url("art/hq-canvas.webp")}.training-office-hero{background-image:linear-gradient(90deg,rgba(25,29,20,.9),rgba(25,29,20,.35)),url("art/hq-canvas.webp")}
@media(max-width:1080px){.personnel-file-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.personnel-records-room{width:min(100% - 24px,1480px);padding-top:24px}.personnel-room-heading{padding:20px 17px}.s1-file-stamp{display:none}.personnel-file-grid{grid-template-columns:1fr}.my-file-callout{grid-template-columns:auto 52px 1fr}.personnel-index{padding:20px 12px;overflow-x:auto}.personnel-index-row{min-width:720px}.page-201 .weapon-record-grid{grid-template-columns:1fr}}


/* ========================================================================
   FULL IMMERSION PASS — HEADER / HERO / DOCUMENT SYSTEM / READABILITY
   ======================================================================== */
body{
  background:
    radial-gradient(circle at top, rgba(214,173,43,.06), transparent 36%),
    linear-gradient(180deg, #2f342a 0%, #42493d 20%, #4d4f40 100%);
}
main{position:relative}
main:before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.06;mix-blend-mode:multiply;
  background-image:repeating-linear-gradient(0deg, rgba(43,37,26,.18) 0 1px, transparent 1px 7px),
                   radial-gradient(circle at 20% 20%, rgba(62,52,32,.35), transparent 24%),
                   radial-gradient(circle at 75% 15%, rgba(255,255,255,.12), transparent 18%);
}

.battalion-header{
  background:linear-gradient(180deg,#20241d,#31372d);
  border-bottom:1px solid #74755f;
  box-shadow:0 10px 28px rgba(0,0,0,.35);
}
.unit-wire{
  background:linear-gradient(90deg,#11140f,#1a1d17 50%,#11140f);
  color:#bfb7a0;
  border-bottom:1px solid rgba(214,173,43,.18);
}
.header-desk{
  min-height:106px;
  gap:18px;
  background:
    linear-gradient(180deg,rgba(255,255,255,.04),transparent 45%),
    linear-gradient(90deg,rgba(20,23,18,.28),transparent 20%,transparent 80%,rgba(20,23,18,.28));
}
.unit-mark{
  gap:18px;
  padding-right:10px;
}
.unit-mark img{width:90px;height:84px}
.unit-mark-copy strong{font-size:20px;letter-spacing:.06em;color:#efe6d0}
.unit-mark-copy small{font-size:10px;color:#d1c7ac;letter-spacing:.08em}
.record-index{
  align-items:stretch;
  gap:10px;
  margin-left:auto;
  flex-wrap:wrap;
  justify-content:flex-end;
}
.record-index a{
  min-width:108px;
  text-align:center;
  padding:14px 16px 11px;
  border:1px solid #7f744f;
  border-bottom:4px solid #5c533a;
  border-radius:0;
  color:#f2ead7;
  background:
    linear-gradient(180deg,rgba(237,228,203,.15),rgba(64,70,57,.34)),
    #32392f;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.06);
  font-size:10px;
  letter-spacing:.11em;
  font-weight:700;
  text-transform:uppercase;
}
.record-index a:hover,
.record-index a[aria-current="page"]{
  background:linear-gradient(180deg,rgba(214,173,43,.2),rgba(58,63,50,.9));
  border-color:#a48d55;
  border-bottom-color:var(--cav);
  color:#fff8e2;
}
.record-index .duty-tab{
  background:linear-gradient(180deg,#dbc47d,#b89a5a);
  border-color:#8c6f33;
  color:#1e1a12;
  font-weight:700;
}
.index-button{
  border-color:#a18853;
  background:linear-gradient(180deg,#d9c283,#b59757);
  color:#221f18;
}
.battalion-footer{
  background:linear-gradient(180deg,#171a14,#23271f);
  border-top:6px solid #575a4d;
}

.document-sheet{
  background:
    linear-gradient(180deg,rgba(255,255,255,.22),rgba(118,98,64,.05)),
    #e0d6c0;
  border:1px solid #9a8b6b;
  box-shadow:0 14px 30px rgba(0,0,0,.22);
}
.document-sheet:before{
  content:"";position:absolute;inset:10px;border:1px solid rgba(89,77,50,.12);pointer-events:none;
}
.paper-action,
button.paper-action{
  letter-spacing:.09em;
  text-transform:uppercase;
}
.section-file-heading span,
.field-desk-heading span,
.office-sign span,.operations-sign span,.training-sign span,.supply-sign span,.battalion-sign span,.company-sign span,.orders-sign span,.morning-sign span,.command-sign span,.staff-sign span{
  letter-spacing:.14em;
}

/* Hero and home page */
.arrival-country{min-height:calc(100vh - 117px)}
.arrival-shade{
  background:linear-gradient(90deg,rgba(11,13,10,.78),rgba(11,13,10,.35) 52%,rgba(11,13,10,.48));
}
.arrival-identity{
  width:min(760px,92vw);
  padding:28px 28px 24px;
  background:linear-gradient(180deg,rgba(16,19,14,.42),rgba(16,19,14,.22));
  border-left:4px solid var(--cav);
  box-shadow:0 16px 30px rgba(0,0,0,.22);
  backdrop-filter: blur(2px);
}
.arrival-identity:before{
  content:"HEADQUARTERS • 1ST CAVALRY DIVISION (AIRMOBILE)";
  display:block;
  font-size:10px;
  letter-spacing:.12em;
  color:#d7c8a2;
  margin-bottom:12px;
}
.typed-overline{color:#e5bf49;font-size:11px}
.arrival-identity h1{
  font-size:clamp(56px,7vw,108px);
  line-height:.88;
  letter-spacing:-.035em;
  margin-bottom:12px;
}
.division-line{
  font-size:15px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#e8dcc2;
}
.typed-rule{height:3px;width:150px}
.arrival-identity h2{
  display:inline-block;
  margin:0 0 11px;
  padding:6px 10px 5px;
  border:1px solid rgba(227,214,183,.38);
  background:rgba(22,25,18,.28);
  font-size:18px;
  letter-spacing:.08em;
}
.arrival-identity>p:not(.typed-overline):not(.division-line){
  font-size:13px;
  line-height:1.7;
  max-width:620px;
  color:#f0e7d3;
}
.arrival-caption-note{
  right:3.5vw;
  bottom:5.5vh;
  padding:10px 14px;
  transform:rotate(-1.5deg);
  background:#d7c38f;
}
.arrival-caption-note b{font-size:13px;letter-spacing:.08em}

.inprocessing-strip{
  grid-template-columns:repeat(6,minmax(160px,1fr));
  background:
    linear-gradient(180deg,#cdbf91,#b6a474);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16);
}
.inprocessing-strip div{
  min-height:72px;
  padding:14px 16px;
}
.inprocessing-strip b{font-size:10px;letter-spacing:.06em}

.reporting-room{background:#454536}
.reporting-photo{filter:brightness(.64) saturate(.82)}
.orders-sheet{transform:rotate(-1.1deg);width:min(640px,54vw)}
.photo-slip{transform:rotate(1.5deg)}

.soldier-tour{background:linear-gradient(180deg,#24281f,#31372d 45%,#2d3128)}
.section-file-heading{text-align:left;max-width:980px}
.section-file-heading p{color:#dcd3be;line-height:1.7}
.tour-worktable{
  background:#5d4932 url('/static/art/map-table.webp') center/cover no-repeat;
  border:12px solid #403124;
  box-shadow:inset 0 0 70px rgba(12,9,5,.42),0 24px 45px rgba(0,0,0,.28);
}
.tour-worktable:before{background:rgba(59,44,25,.22)}
.tour-object{
  border:1px solid rgba(81,68,45,.45);
}
.assignment-order,.equipment-issue,.training-card,.operation-overlay,.service-record,.deros-card{
  background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(90,74,45,.05)),#dfd3b8;
}
.equipment-issue,.deros-card{background:#caae71}
.training-card,.service-record{background:#e6dcc3}
.operation-overlay{background:#d3c49b}

.field-desk-section{background:#23271f}
.field-desk-photo{filter:brightness(.7) saturate(.92)}
.field-desk-heading{
  background:linear-gradient(180deg,rgba(18,21,16,.72),rgba(18,21,16,.3));
  padding:18px 20px 16px;
  border-left:4px solid var(--cav);
  max-width:560px;
}
.field-desk-heading p{color:#e4dcc8;line-height:1.6}
.desk-file{
  border:1px solid rgba(69,56,34,.35);
}
.file-201,.file-supply,.file-orders{background:#c3a36b}
.file-ops,.file-morning,.file-roster{background:#e0d7c1}
.file-training{background:#ceb27a}

/* General page heroes readability */
.office-shade,.operations-shade,.training-shade,.supply-shade,.battalion-shade,.company-shade,.orders-shade,.morning-shade,.command-shade,.staff-shade{
  background:linear-gradient(90deg,rgba(12,15,10,.78),rgba(12,15,10,.36) 56%,rgba(12,15,10,.5));
}
.office-sign,.operations-sign,.training-sign,.supply-sign,.battalion-sign,.company-sign,.orders-sign,.morning-sign,.command-sign,.staff-sign{
  padding:18px 22px 18px;
  background:linear-gradient(180deg,rgba(16,18,14,.46),rgba(16,18,14,.16));
  border-left:4px solid var(--cav);
  max-width:760px;
}
.office-sign h1,.operations-sign h1,.training-sign h1,.supply-sign h1,.company-sign h1,.orders-sign h1,.morning-sign h1,.command-sign h1,.staff-sign h1,
.battalion-sign h1{
  color:#f0e6cf;
}
.office-sign p,.operations-sign p,.training-sign p,.supply-sign p,.company-sign p,.orders-sign p,.morning-sign p,.command-sign p,.staff-sign p,
.battalion-sign p{
  color:#e4dbc7;
  line-height:1.65;
}
.battalion-sign{max-width:980px}

/* Personnel page: make records feel more like files, less like generic cards */
.personnel-records-room{
  background:linear-gradient(180deg,#5b5f50,#6a6b58);
  padding-bottom:4rem;
}
.personnel-room-heading{
  max-width:1300px;
  margin: -2.2rem auto 1.25rem;
  padding:1rem 1.25rem;
  display:flex;
  justify-content:space-between;
  align-items:end;
}
.personnel-file-card{
  background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(90,74,45,.03)), #ddcfad !important;
  border:1px solid #977f53;
  box-shadow:0 14px 28px rgba(0,0,0,.2);
}
.personnel-file-card:nth-child(odd){transform:rotate(-.4deg)}
.personnel-file-card:nth-child(even){transform:rotate(.35deg)}
.personnel-file-card:hover{transform:translateY(-5px) rotate(0deg)}
.personnel-file-top h3{letter-spacing:.03em}
.personnel-index{
  margin-top:1.5rem;
}

/* 201 file and battalion organization */
.file-cabinet-room{background:linear-gradient(180deg,#515648,#676754)}
.manila-file{
  background:#c9b27d;
  border:1px solid #8e733e;
  box-shadow:0 20px 40px rgba(0,0,0,.24);
}
.file-section-tabs a{
  background:#b89b62;
  border:1px solid #866b3a;
  border-bottom:0;
  padding:8px 12px 7px;
  letter-spacing:.08em;
}
.file-section-tabs a:hover{background:#cfb372}
.battalion-command-page{background:linear-gradient(180deg,#616654,#777760)}
.battalion-page-heading{
  max-width:1320px;
  margin:-2rem auto 1.5rem;
  padding:1.2rem 1.4rem;
  background:linear-gradient(180deg,rgba(243,236,221,.95),rgba(219,207,176,.94));
  box-shadow:0 14px 28px rgba(0,0,0,.22);
}
.leader-card,.platoon-echelon,.squad-card-redesign,.battalion-roster-redesign{
  box-shadow:0 14px 28px rgba(0,0,0,.18);
}

/* Better readability on forms/tables throughout */
.form-grid dt,.form-grid dd,.entry-row,.typed-row,.qualification-table,.unit-line,.morning-roster,.roster-table-redesign,.personnel-index-row,.journal-entry,.order-entry,.typed-table .typed-row{
  line-height:1.45;
}

/* Mobile intentionality */
@media(max-width:1120px){
  .header-desk{min-height:auto;align-items:flex-start;flex-wrap:wrap}
  .record-index{width:100%;justify-content:stretch}
  .record-index a{min-width:0}
}
@media(max-width:820px){
  .arrival-identity{padding:20px 18px 18px}
  .arrival-identity:before{font-size:9px}
  .arrival-identity h1{font-size:44px}
  .office-sign,.operations-sign,.training-sign,.supply-sign,.battalion-sign,.company-sign,.orders-sign,.morning-sign,.command-sign,.staff-sign,
  .field-desk-heading{left:20px;right:20px;max-width:none}
  .personnel-file-card:nth-child(odd),.personnel-file-card:nth-child(even){transform:none}
}
@media(max-width:700px){
  .arrival-country{min-height:760px}
  .arrival-identity h2{font-size:15px}
  .record-index a{font-size:11px;letter-spacing:.09em}
  .personnel-room-heading,.battalion-page-heading{margin-top:0}
}

/* ========================================================================
   SECOND PASS — PAGE BY PAGE REALISM
   ======================================================================== */
.page-home .reporting-room,
.page-battalion .battalion-command-page,
.page-personnel .personnel-records-room,
.page-201 .file-cabinet-room,
.page-operations .ops-center,
.page-supply .supply-room{
  position:relative;
}

.page-home .reporting-room:before,
.page-battalion .battalion-command-page:before,
.page-personnel .personnel-records-room:before,
.page-201 .file-cabinet-room:before,
.page-operations .ops-center:before,
.page-supply .supply-room:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:radial-gradient(circle at 10% 15%, rgba(255,255,255,.05), transparent 18%),
             radial-gradient(circle at 80% 20%, rgba(255,255,255,.03), transparent 14%);
  mix-blend-mode:soft-light;
}

/* Home */
.page-home .reporting-room{background:linear-gradient(180deg,#62624c,#4a4f3d)}
.page-home .orders-sheet{box-shadow:0 22px 44px rgba(0,0,0,.25)}
.page-home .desk-file{
  border-width:1px;
  box-shadow:0 10px 18px rgba(0,0,0,.14);
}
.page-home .desk-file strong{font-size:18px;letter-spacing:.04em}
.page-home .unit-history-callout{box-shadow:0 18px 34px rgba(0,0,0,.18)}

/* Battalion */
.battalion-intro-memo{
  margin:0 auto 1.35rem;
  padding:1rem 1.1rem 1.1rem;
}
.battalion-intro-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:1rem 1.25rem;
}
.battalion-intro-grid p{margin:0;line-height:1.75;color:#3d372d}
.command-echelon,.battalion-roster-redesign{
  background:linear-gradient(180deg,rgba(244,238,223,.96),rgba(219,207,176,.94));
}
.leader-card{
  background:linear-gradient(180deg,#efe8d6,#dbcfb1);
  border:1px solid #8f7c55;
}
.personnel-strip-redesign{
  background:linear-gradient(180deg,#eee6d1,#ddd0ae);
  border:1px solid #947d4f;
  transition:transform .18s ease, box-shadow .18s ease;
}
.personnel-strip-redesign:hover{transform:translateY(-2px);box-shadow:0 12px 22px rgba(0,0,0,.16)}
.vacant-slot{background:#e7dcc1;border:1px dashed #927a47}

/* Personnel index */
.personnel-intro-note{
  margin:0 0 1.1rem;
  padding:.95rem 1rem 1rem;
}
.personnel-intro-note p{margin:.65rem 0 0;line-height:1.7;color:#3f392e}
.personnel-file-grid{align-items:start}
.personnel-file-card{
  position:relative;
  overflow:hidden;
}
.personnel-file-card:after{
  content:"201";
  position:absolute;
  right:14px;
  bottom:10px;
  font-size:46px;
  line-height:1;
  color:rgba(113,86,34,.08);
  font-weight:700;
}
.personnel-card-data dd{line-height:1.45}
.personnel-index{box-shadow:0 18px 34px rgba(0,0,0,.16)}

/* 201 File */
.file-jacket-summary{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:.8rem;
  margin:1rem 0 1.1rem;
}
.jacket-card{
  background:linear-gradient(180deg,#dcc693,#c0a269);
  border:1px solid #8d6f38;
  padding:.9rem .95rem;
  min-height:92px;
  box-shadow:0 10px 18px rgba(0,0,0,.12);
}
.jacket-card small{display:block;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#453823}
.jacket-card strong{display:block;margin:.35rem 0 .3rem;font-size:18px;letter-spacing:.03em;color:#251f16}
.jacket-card span{display:block;font-size:10px;letter-spacing:.06em;color:#413827}
.jacket-card.emphasis{background:linear-gradient(180deg,#d8bc78,#b38e4a)}
.manila-file{background:linear-gradient(180deg,#cdb77f,#c2ab74)}
.record-form,.file-document{box-shadow:0 12px 22px rgba(0,0,0,.12)}
.file-note{margin:.55rem 0 .8rem;color:#4a4235;line-height:1.6;font-size:11px}
.weapon-file-sheet header span{display:block;font-size:10px;letter-spacing:.08em;color:#5d523d}
.page-201 .weapon-visual.record{background:linear-gradient(180deg,#f0ead9,#ddd2b5)}
.page-201 .property-table,.page-201 .readiness-file-summary span{background:rgba(255,255,255,.18)}

/* Operations */
.ops-map-board,.operations-journal,.opord-form,.op-participation-form,.aar-form,.personnel-recommendation,.opord-sheet,.unit-tasking,.participant-roster{
  background:linear-gradient(180deg,rgba(243,236,221,.96),rgba(220,209,180,.94));
  box-shadow:0 18px 34px rgba(0,0,0,.18);
}
.ops-brief-line{
  display:flex;
  align-items:center;
  gap:14px;
  padding:.45rem .7rem .6rem;
  font-size:10px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#f3e8cf;
}
.ops-brief-line b{font-size:11px;color:#f7c44d}
.ops-brief-line small{color:#ddd0b0}
.current-ops-stack{gap:.9rem}
.op-folder{
  background:linear-gradient(180deg,#dbc58e,#ccb27b);
  border:1px solid #907644;
  box-shadow:0 10px 18px rgba(0,0,0,.14);
}
.op-folder b{font-size:17px;letter-spacing:.03em;color:#201c15}
.journal-note{margin:0 0 .9rem;line-height:1.65;color:#484234;font-size:11px}
.opord-sheet h1{line-height:1.02;letter-spacing:.02em}
.operation-side-files .document-sheet{padding:1rem}

/* Supply */
.supply-intro-note{
  grid-column:1 / -1;
  padding:1rem 1.05rem 1.05rem;
}
.supply-intro-note p{margin:.7rem 0 0;line-height:1.72;color:#433c31}
.weapon-issue-strip{
  display:grid;
  grid-template-columns:120px 1fr auto;
  align-items:center;
  gap:.75rem;
  margin:.7rem 0 1rem;
  padding:.6rem .75rem;
  background:linear-gradient(180deg,#d9c58f,#c8ad6f);
  border:1px solid #8d723d;
}
.weapon-issue-strip span,.weapon-issue-strip small{font-size:10px;letter-spacing:.08em;text-transform:uppercase}
.weapon-issue-strip b{font-size:16px;color:#1f1a13}
.weapon-record-sheet,.equipment-record-sheet,.company-stock-sheet,.requisition-sheet,.maintenance-journal,.arms-room-ledger,.s4-action-form{
  background:linear-gradient(180deg,rgba(243,236,221,.96),rgba(220,209,180,.94));
  box-shadow:0 18px 34px rgba(0,0,0,.18);
}
.weapon-image-stage{background:linear-gradient(180deg,#efe7d3,#ddd1b2)}
.rack-entry,.property-table,.stock-table,.requisition-list > div,.maintenance-entry{
  background:rgba(255,255,255,.16);
}

/* Better small screens */
@media(max-width:1080px){
  .battalion-intro-grid,
  .file-jacket-summary{grid-template-columns:1fr 1fr}
  .weapon-issue-strip{grid-template-columns:1fr;align-items:start}
}
@media(max-width:720px){
  .battalion-intro-grid,
  .file-jacket-summary{grid-template-columns:1fr}
  .personnel-intro-note,.supply-intro-note,.battalion-intro-memo{padding:.85rem .9rem}
}

/* ========================================================================
   THIRD PASS — COHESIVE IMMERSION / READABILITY / LESS TEMPLATE FEEL
   ======================================================================== */

/* Global readability */
:root{
  --paper-strong:#efe7d1;
  --paper-mid:#ddd0ae;
  --olive-deep:#2d3328;
  --ink-soft:#201b14;
  --accent-yellow:#d5ae45;
}
body{
  background:linear-gradient(180deg,#555744,#474a3c 28%, #3d4035 100%);
}
.battalion-header{
  position:sticky;
  top:0;
  z-index:50;
  box-shadow:0 16px 30px rgba(0,0,0,.2);
}
.unit-wire{
  background:linear-gradient(180deg,#252a21,#1b1f18);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.header-desk{
  justify-content:center;
  gap:1.2rem;
  padding:1rem 1.4rem;
}
.record-index{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:.5rem;
  max-width:1080px;
}
.record-index a{
  min-height:50px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:.8rem 1.05rem;
  font-size:13px;
  letter-spacing:.08em;
  text-align:center;
  background:linear-gradient(180deg,#d3ba82,#bea06a);
  color:#221c14;
  border:1px solid #7d6336;
  box-shadow:0 6px 12px rgba(0,0,0,.14);
}
.record-index a[aria-current="page"], .record-index a:hover{
  background:linear-gradient(180deg,#ead296,#d1ae59);
}
.index-button{min-height:50px;font-size:13px;letter-spacing:.08em}
.unit-mark-copy strong{font-size:1.2rem}

/* stronger hero readability */
.replacement-copy,.training-sign,.orders-sign,.ops-tent-sign,.supply-yard-sign,.soldier-status-card,.battalion-sign,.hero-brief,.identity-form,.mr-letterhead,.room-label{
  text-shadow:0 2px 10px rgba(0,0,0,.55);
}
.replacement-copy,.training-sign,.orders-sign,.ops-tent-sign,.supply-yard-sign,.battalion-sign,.hero-brief{
  background:linear-gradient(180deg,rgba(21,23,18,.46),rgba(21,23,18,.22));
  border:1px solid rgba(255,255,255,.06);
  backdrop-filter:blur(2px);
  padding:1rem 1.1rem;
}
.replacement-shade,.training-shade,.orders-shade,.ops-tent-shade,.supply-yard-shade,.soldier-desk-shade,.identity-shade,.battalion-shade{
  background:linear-gradient(180deg,rgba(10,12,10,.28),rgba(10,12,10,.68));
}

/* Documents / sheets */
.document-sheet,.record-form,.file-document,.orders-index,.training-folder,.instructor-board,.replacement-file,.battle-roster-mini,.today-order,.training-slip,.service-slip,.personal-folder{
  box-shadow:0 18px 36px rgba(0,0,0,.18);
}
.document-sheet p,.document-sheet li,.document-sheet small,.document-sheet span,.document-sheet dd,.document-sheet dt{
  color:#30291f;
}
.document-sheet strong,.document-sheet b,.document-sheet h2,.document-sheet h3{color:#17120c}

/* Recruiting */
.recruit-processing{
  grid-template-columns:1.25fr .82fr;
  align-items:start;
  gap:1rem;
}
.recruit-note{
  margin:.85rem 0 1rem;
  line-height:1.75;
  color:#453c2f;
}
.replacement-mini-seq{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:.4rem;
  margin:1rem 0 .85rem;
}
.replacement-mini-seq span{
  display:flex;align-items:center;justify-content:center;
  min-height:46px;background:linear-gradient(180deg,#dbc48c,#caaa6d);
  border:1px solid #8d733f;font-size:10px;letter-spacing:.08em;color:#281f14;
}
.replacement-memo{grid-column:1 / -1;padding:1rem 1.1rem}

/* Training */
.training-office{
  grid-template-columns:1.2fr .78fr .62fr;
  gap:1rem;
  align-items:start;
}
.training-office-memo{grid-column:1 / -1;padding:1rem 1.1rem}
.training-note{margin:.7rem 0 1rem;line-height:1.7;color:#443c31}
.school-lines{display:grid;grid-template-columns:repeat(2,1fr);gap:.35rem;margin-top:.85rem}
.school-lines span{background:#e4d7b6;border:1px solid #9b8354;padding:.45rem .55rem;font-size:10px;letter-spacing:.08em;text-align:center}
.range-scorecard,.training-folder,.instructor-board,.training-office-memo{background:linear-gradient(180deg,rgba(243,236,221,.96),rgba(220,209,180,.94))}

/* Orders */
.orders-archive{grid-template-columns:260px 1fr;align-items:start}
.orders-index{background:linear-gradient(180deg,#ddd0ae,#cbb98f);position:sticky;top:118px}
.orders-index a{min-height:46px;font-size:12px;letter-spacing:.08em;border:1px solid #8b7446;background:linear-gradient(180deg,#e8ddc2,#d8c8a1);color:#241e15}
.orders-index a:hover{background:linear-gradient(180deg,#f1e6cb,#e0cea6)}
.orders-memo,.orders-ledger,.empty-order{background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(220,209,180,.94))}
.orders-memo{padding:1rem 1.1rem}
.order-entry{background:rgba(255,255,255,.16)}

/* Morning report */
.morning-report-note{max-width:1180px;margin:0 auto 1rem;padding:1rem 1.1rem;background:linear-gradient(180deg,rgba(243,236,221,.96),rgba(220,209,180,.94))}
.morning-report-room .mr-desk,.mr-archive,.deficiency-sheet,.deros-sheet,.morning-report-sheet{box-shadow:0 18px 34px rgba(0,0,0,.18)}
.morning-report-sheet,.deficiency-sheet,.deros-sheet,.mr-archive{background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(220,209,180,.94))}
.mr-grid,.archive-row{background:rgba(255,255,255,.14)}

/* Dashboard */
.dashboard-intro{max-width:1180px;margin:0 auto 1rem;padding:1rem 1.1rem;background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(220,209,180,.94))}
.personal-worktable{align-items:start}
.personal-folder,.battle-roster-mini,.weapon-desk-record,.today-order,.training-slip,.service-slip{
  background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(219,208,178,.94));
}
.personal-folder{min-height:180px}
.soldier-status-card{border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(2px)}

/* Login */
.battle-roster-auth{background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(220,209,180,.94))}
.battle-roster-auth h1,.battle-roster-auth p,.battle-roster-auth footer,.battle-roster-auth label{color:#241d15;text-shadow:none}
.battle-roster-auth .army-letterhead,.battle-roster-auth .card-number-mark{color:#2b241a;text-shadow:none}

/* Home stronger / less fake shapes */
.hero-actions .paper-action,.reporting-card,.desk-file,.tour-doc,.unit-history-callout,.company-ready-card{
  background-clip:padding-box;
}
.desk-file,.tour-doc{position:relative;overflow:hidden}
.desk-file:after,.tour-doc:after,.personnel-file-card:before,.op-folder:after{
  content:"";
  position:absolute;
  inset:auto auto 0 0;
  width:100%;height:100%;pointer-events:none;
  background:linear-gradient(180deg,transparent 72%, rgba(0,0,0,.04));
}

/* Personnel / battalion / records */
.personnel-file-card,.battalion-roster-redesign,.command-echelon,.personnel-intro-note,.battalion-intro-memo,.file-jacket-summary .jacket-card{
  border-radius:2px;
}
.file-section-tabs a{background:linear-gradient(180deg,#d3ba82,#bea06a);border:1px solid #7d6336;color:#201b13}
.file-section-tabs a:hover{background:linear-gradient(180deg,#ead296,#d1ae59)}

/* Mobile */
@media(max-width:980px){
  .training-office,.recruit-processing,.orders-archive{grid-template-columns:1fr}
  .orders-index{position:static;top:auto}
}
@media(max-width:760px){
  .header-desk{padding:.85rem .9rem}
  .record-index{gap:.35rem}
  .record-index a,.index-button{width:100%}
  .replacement-copy,.training-sign,.orders-sign,.ops-tent-sign,.supply-yard-sign,.battalion-sign,.hero-brief{padding:.85rem .9rem}
}

/* ========================================================================
   FOURTH PASS — PERIOD ACCURACY / ARRIVAL IN VIETNAM / STRONGER IMMERSION
   ======================================================================== */

/* More grounded overall page rhythm */
.page-home main,
.page-personnel main,
.page-201 main,
.page-operations main{
  background:
    radial-gradient(circle at 15% 0%, rgba(255,255,255,.06), transparent 22%),
    linear-gradient(180deg,#5d614f 0%,#4d5242 16%,#3d4035 100%);
}

/* Home page: arrival in country */
.arrival-country{
  min-height:880px;
}
.arrival-image{
  filter:saturate(.88) contrast(.98) brightness(.92);
}
.arrival-identity{
  max-width:660px;
  background:linear-gradient(180deg,rgba(20,21,18,.55),rgba(20,21,18,.32));
  border:1px solid rgba(235,224,195,.11);
  box-shadow:0 24px 50px rgba(0,0,0,.25);
  backdrop-filter:blur(3px);
}
.arrival-identity h1{line-height:.94}
.arrival-identity h2{font-size:1.35rem;letter-spacing:.13em}
.arrival-identity p:not(.typed-overline):not(.division-line){
  max-width:56ch;
  color:#e2d8c0;
  font-size:1rem;
  line-height:1.85;
}
.inprocessing-strip{
  background:linear-gradient(180deg,#251f17,#1f1a14);
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.inprocessing-strip div{min-height:92px}
.reporting-room{
  position:relative;
  overflow:hidden;
  background:linear-gradient(180deg,#5f5d49,#4b4b39);
}
.reporting-room:before{
  content:"";
  position:absolute;inset:0;
  background:radial-gradient(circle at 80% 22%, rgba(255,255,255,.08), transparent 20%);
  pointer-events:none;
}
.orders-sheet,.photo-slip,.country-brief{
  box-shadow:0 22px 48px rgba(0,0,0,.22);
}
.country-brief{
  width:min(1180px,92vw);
  margin:0 auto 1.4rem;
  padding:1rem 1.2rem;
  background:linear-gradient(180deg,rgba(243,236,221,.97),rgba(220,209,180,.94));
}
.brief-columns{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:1rem;
  margin-top:.7rem;
}
.brief-columns p{
  margin:0;
  background:rgba(255,255,255,.14);
  border:1px solid rgba(70,54,27,.16);
  padding:.85rem .95rem;
  line-height:1.7;
}
.soldier-tour .section-file-heading p,
.field-desk-heading p,
.unit-history-callout p{line-height:1.8}
.tour-worktable{
  background:
    linear-gradient(180deg,rgba(78,56,32,.16),rgba(37,27,17,.16)),
    url('/static/art/map-table.webp') center/cover no-repeat;
  border-color:#4c3924;
  box-shadow:0 18px 48px rgba(0,0,0,.25);
}
.tour-object{
  box-shadow:0 18px 34px rgba(0,0,0,.2);
}
.field-desk-section{
  position:relative;
  overflow:hidden;
}
.field-desk-section:before{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,.18),rgba(0,0,0,.32));
  pointer-events:none;
}
.field-desk-heading,.desk-files{position:relative;z-index:2}
.desk-file{
  box-shadow:0 16px 32px rgba(0,0,0,.22);
}
.desk-file span{line-height:1.45}
.unit-history-callout{box-shadow:0 20px 40px rgba(0,0,0,.17)}

/* Personnel index and 201 file */
.personnel-records-room{
  padding-top:46px;
}
.personnel-intro-note,
.personnel-room-heading,
.personnel-index,
.empty-personnel-office,
.personnel-file-card,
.file-cover-sheet,
.record-form,
.file-document,
.tour-control-card,
.duty-status-card{
  background:linear-gradient(180deg,rgba(243,236,221,.98),rgba(220,209,180,.95));
}
.personnel-file-card{
  min-height:305px;
  border:1px solid rgba(80,59,26,.18);
}
.personnel-file-tab{
  letter-spacing:.12em;
}
.personnel-file-top h3{font-size:1.35rem;letter-spacing:.04em}
.personnel-card-data dd{color:#1e1811}
.manila-file{
  box-shadow:0 28px 54px rgba(0,0,0,.22);
  border:1px solid rgba(80,59,26,.18);
}
.file-cover-sheet{
  display:grid;
  grid-template-columns:220px 1fr auto;
  gap:1rem;
  align-items:start;
  margin-bottom:1rem;
  padding:1rem 1.1rem;
}
.cover-photo-clip{
  background:#f1e6c9;
  border:1px solid rgba(80,59,26,.22);
  padding:.65rem;
  transform:rotate(-2deg);
  box-shadow:0 10px 18px rgba(0,0,0,.14);
}
.cover-photo-clip img{
  display:block;width:100%;height:240px;object-fit:cover;border:1px solid rgba(0,0,0,.08)
}
.cover-copy p{margin:.7rem 0 1rem;line-height:1.78;color:#3a3126}
.cover-status-line{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}
.cover-status-line span{background:rgba(255,255,255,.18);border:1px solid rgba(80,59,26,.18);padding:.5rem .6rem;font-size:.75rem;letter-spacing:.08em;color:#2a2218}
.stamp-covered{align-self:center;transform:rotate(4deg);position:static}
.file-jacket-summary{margin-bottom:1rem}
.personnel-rank-title h2{font-size:1.95rem}
.weapon-file-sheet .weapon-visual{background:linear-gradient(180deg,#6d715d,#4d523f)}

/* Operations tent */
.ops-intro-note,
.ops-map-board,
.operations-journal,
.aar-form,
.personnel-recommendation,
.opord-form,
.op-participation-form,
.ops-watch-board{
  background:linear-gradient(180deg,rgba(243,236,221,.98),rgba(219,208,178,.95));
}
.ops-intro-note{
  width:min(1180px,92vw);
  margin:0 auto 1rem;
  padding:1rem 1.15rem;
}
.ops-center{
  grid-template-columns:minmax(0,1.6fr) minmax(330px,.9fr);
  align-items:start;
}
.ops-map-board{
  background:
    linear-gradient(180deg,rgba(91,79,42,.16),rgba(75,64,31,.18)),
    #b8aa79 url("art/map-table.webp") center/cover no-repeat;
}
.map-overlay-grid{
  opacity:.38;
}
.ops-map-board>header{margin-top:.4rem}
.ops-side-stack{display:grid;gap:1rem;align-content:start}
.ops-watch-board{padding:1rem 1.05rem}
.watch-line{display:flex;justify-content:space-between;align-items:center;padding:.62rem 0;border-bottom:1px solid rgba(74,58,28,.15);font-size:.83rem;letter-spacing:.08em;color:#2a2218}
.watch-line b{font-size:1.1rem;color:#17120c}
.watch-note{margin:.8rem 0 0;line-height:1.75;color:#3c3328}
.ops-admin-stack{display:grid;gap:1rem}
.op-folder{
  background:linear-gradient(180deg,#d6c28f,#c1ac77);
  border:1px solid rgba(63,48,22,.18);
}
.operations-journal .journal-entry{background:rgba(255,255,255,.13)}

/* Better mobile behavior for the new blocks */
@media(max-width:960px){
  .brief-columns,
  .cover-status-line,
  .file-cover-sheet,
  .ops-center{
    grid-template-columns:1fr;
  }
  .stamp-covered{justify-self:start}
}
@media(max-width:720px){
  .arrival-country{min-height:760px}
  .arrival-identity{left:18px;right:18px;max-width:none;padding:1rem .95rem}
  .country-brief{width:min(100% - 24px,1180px)}
  .file-cover-sheet{padding:.85rem}
  .cover-photo-clip img{height:210px}
  .brief-columns p{padding:.75rem .8rem}
}


/* ========================================================================
   CUMULATIVE EDIT — HERO / TOUR / FIELD DESK / ISSUE SHOWCASE / SPACING
   ======================================================================== */

/* Fix homepage hero copy clipping at desktop sizes. */
@media(min-width:821px){
  .page-home .arrival-identity{
    top:72px;
    bottom:auto;
    left:5vw;
    width:min(680px,42vw);
    max-height:calc(100% - 110px);
  }
  .page-home .arrival-identity h1{
    font-size:clamp(48px,5.15vw,88px);
    line-height:.98;
    letter-spacing:-.025em;
    margin:10px 0 14px;
  }
  .page-home .arrival-identity:before{margin-bottom:7px}
}

/* Soldier's Tour: enlarge the work table, files, and typography. */
.page-home .soldier-tour{padding:90px 3.5vw 120px}
.page-home .soldier-tour .section-file-heading{max-width:1040px;margin-bottom:42px}
.page-home .soldier-tour .section-file-heading p{font-size:14px;max-width:860px}
.page-home .tour-worktable{max-width:1480px;height:900px;border-width:12px}
.page-home .tour-object h3{font-size:23px;margin:7px 0 10px}
.page-home .tour-object p,.page-home .tour-object dl{font-size:12px;line-height:1.62}
.page-home .tour-object .file-code{font-size:9px}
.page-home .assignment-order{left:5%;top:6%;width:36%;padding:32px}
.page-home .equipment-issue{right:5%;top:7%;width:31%;padding:30px}
.page-home .training-card{left:8%;top:43%;width:31%;padding:28px}
.page-home .operation-overlay{right:7%;top:41%;width:36%;padding:29px}
.page-home .service-record{left:22%;bottom:6%;width:34%;padding:30px}
.page-home .deros-card{right:7%;bottom:5%;width:25%;padding:27px}

/* Battalion Field Desk: restore a full-height absolute card canvas and keep every file inside it. */
.page-home .field-desk-section{min-height:940px}
.page-home .field-desk-heading{position:absolute;left:4.5vw;top:48px;z-index:5;max-width:560px}
.page-home .desk-files{position:absolute;inset:0 3vw;z-index:4;height:100%}
.page-home .desk-file{min-width:230px;box-sizing:border-box}
.page-home .file-201{left:4%;top:245px;bottom:auto;width:250px;padding:44px 23px 25px}
.page-home .file-ops{left:34%;top:340px;bottom:auto;width:260px;padding:28px}
.page-home .file-supply{right:4%;top:520px;bottom:auto;width:255px;padding:25px}
.page-home .file-morning{right:18%;top:250px;width:245px;padding:27px}
.page-home .file-training{left:49%;top:565px;width:230px;padding:28px}
.page-home .file-roster{left:9%;top:660px;width:240px;padding:27px}
.page-home .file-orders{right:4%;top:355px;width:240px;padding:29px}

/* Main-page issue showcase. */
.issue-showcase{padding:88px 4vw 105px;background:linear-gradient(180deg,#454a3b,#30352b)}
.issue-showcase-heading{max-width:1180px;margin-bottom:38px}
.issue-showcase-heading p{font-size:14px;max-width:900px;line-height:1.8}
.issue-showcase-grid{max-width:1480px;margin:0 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:stretch}
.issue-showcase-card{position:relative;padding:28px 30px 30px;overflow:hidden;min-height:610px}
.showcase-tag{position:absolute;left:22px;top:0;transform:translateY(-1px);padding:8px 15px;background:#b89758;border:1px solid #7d6336;color:#251e14;font-size:9px;font-weight:700;letter-spacing:.12em;z-index:3}
.showcase-m16{height:300px;display:flex;align-items:center;justify-content:center;padding:32px 16px 10px;background:linear-gradient(180deg,#6b705c,#4e5443);border:1px solid rgba(45,36,22,.25)}
.showcase-m16 img{width:100%;max-height:250px;object-fit:contain}
.showcase-uniform{height:380px;display:flex;align-items:center;justify-content:center;padding:20px 14px 0;background:linear-gradient(180deg,#6b705c,#4e5443);border:1px solid rgba(45,36,22,.25)}
.showcase-uniform img{height:100%;max-width:100%;object-fit:contain}
.showcase-copy{padding-top:22px;color:#282117}
.showcase-copy small{font-size:9px;letter-spacing:.1em}
.showcase-copy h3{font-size:24px;letter-spacing:.035em;margin:5px 0 12px}
.showcase-copy p{font-size:12px;line-height:1.72;color:#42392c}
.showcase-record-line{display:flex;justify-content:space-between;gap:18px;padding:8px 0;border-top:1px dotted #897956;font-size:10px}
.showcase-record-line b{text-align:right}

/* Uniform inside each Soldier's 201 File. */
.uniform-file-sheet{grid-column:1/-1}
.uniform-file-sheet>header{display:flex;gap:.7rem;align-items:baseline;flex-wrap:wrap}
.uniform-record-grid{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(380px,1.2fr);gap:28px;align-items:start;margin-top:15px}
.uniform-record-visual{min-height:520px;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#666b58,#4a5040);padding:20px;border:1px solid #8a7a59}
.uniform-record-visual > img.uniform-base-image{max-height:500px;width:100%;object-fit:contain}
.uniform-record-copy{position:relative}
.uniform-issued-stamp{display:inline-block;margin:2px 0 12px;padding:6px 10px;border:3px double #6d3028;color:#6d3028;font-weight:700;letter-spacing:.1em;transform:rotate(-2deg)}
.uniform-awards{margin-top:20px;padding:18px;background:rgba(188,164,109,.25);border:1px solid #a58e5c}
.uniform-awards>small{font-size:8px;letter-spacing:.1em}
.uniform-awards h3{font-size:18px;margin:5px 0 7px}
.uniform-awards p{font-size:11px;line-height:1.65}
.uniform-award-line{display:flex;justify-content:space-between;gap:15px;padding:7px 0;border-top:1px dotted #8a7754;font-size:10px}

/* Prevent labels and bold headings from running together in document headers. */
.document-sheet > header:not(.army-letterhead){display:flex;flex-wrap:wrap;align-items:baseline;column-gap:.8rem;row-gap:.25rem}
.document-sheet > header:not(.army-letterhead) small{margin-right:.15rem}
.empty-order > header{display:flex;gap:.75rem 1rem;align-items:baseline;flex-wrap:wrap}
.empty-order > header small{display:inline-block;margin-right:.25rem}
.empty-order > header b{display:inline-block}

@media(max-width:1100px){
  .issue-showcase-grid,.uniform-record-grid{grid-template-columns:1fr}
  .showcase-uniform{height:440px}
  .page-home .tour-worktable{height:920px}
}
@media(max-width:820px){
  .page-home .tour-worktable{height:auto}
  .page-home .field-desk-section{min-height:auto;padding:245px 17px 55px}
  .page-home .field-desk-heading{position:absolute;left:20px;right:20px;top:35px}
  .page-home .desk-files{position:relative;inset:auto;height:auto;display:flex;flex-direction:column;gap:13px}
  .page-home .desk-file{position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;width:100%!important;min-width:0;transform:none!important;padding:22px 20px!important}
  .issue-showcase{padding:62px 17px 72px}
  .issue-showcase-card{min-height:0;padding:25px 20px}
  .showcase-m16{height:230px}
  .showcase-uniform{height:360px}
  .uniform-record-visual{min-height:380px}
  .uniform-record-visual > img.uniform-base-image{max-height:360px}
}

/* ========================================================================
   ARTIFACT UI PASS — make clickable elements feel like physical objects
   ======================================================================== */

:root{
  --artifact-shadow:0 18px 34px rgba(0,0,0,.22);
  --artifact-shadow-hover:0 24px 40px rgba(0,0,0,.28);
}

/* Buttons / calls to action should feel like issue tags, not web buttons. */
.paper-action,
button.paper-action{
  position:relative;
  overflow:hidden;
  padding:12px 17px 11px;
  border:1px solid #836734;
  box-shadow:0 7px 14px rgba(0,0,0,.18);
  background:
    linear-gradient(180deg,rgba(255,255,255,.18),rgba(101,80,43,.05)),
    linear-gradient(180deg,#dec47f,#c6a45a);
}
.paper-action:before,
button.paper-action:before{
  content:"";
  position:absolute;
  top:-1px;
  right:16px;
  width:56px;
  height:16px;
  border:1px solid rgba(76,58,29,.35);
  border-bottom:0;
  background:rgba(249,238,205,.32);
  transform:skewX(-18deg);
}
.paper-action:hover,
.paper-action:focus-visible,
button.paper-action:hover,
button.paper-action:focus-visible{
  transform:translateY(-2px) rotate(-.35deg);
  box-shadow:0 10px 18px rgba(0,0,0,.22);
}
.paper-action.primary,
button.paper-action.primary{
  background:
    linear-gradient(180deg,rgba(255,255,255,.18),rgba(108,79,13,.04)),
    linear-gradient(180deg,#e0b83c,#be9523);
  border-color:#7b6017;
}

/* Header nav tabs become file tabs / office labels instead of flat buttons. */
.record-index{
  gap:6px;
  align-items:flex-start;
}
.record-index a{
  min-height:46px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:12px 14px 10px;
  background:linear-gradient(180deg,rgba(240,230,198,.08),rgba(190,167,109,.05));
  border:1px solid rgba(173,148,87,.55);
  border-bottom:2px solid #846b38;
  color:#efe4c6;
  box-shadow:0 7px 12px rgba(0,0,0,.12);
}
.record-index a:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,.08),transparent 34%,rgba(0,0,0,.03));
}
.record-index a:hover,
.record-index a[aria-current="page"]{
  transform:translateY(1px);
  box-shadow:0 10px 18px rgba(0,0,0,.16);
}
.record-index .duty-tab{
  background:linear-gradient(180deg,#e3cb8a,#c7a85f);
  color:#1e1911;
}

/* Global clickable cards: a little irregular and more tactile. */
.desk-file,
.personnel-file-card,
.personnel-strip-redesign,
.leader-card,
.op-folder,
.squad-card-redesign{
  position:relative;
  overflow:visible;
  box-shadow:var(--artifact-shadow);
}
.desk-file:hover,
.desk-file:focus-visible,
.personnel-file-card:hover,
.personnel-strip-redesign:hover,
.leader-card:hover,
.op-folder:hover,
.squad-card-redesign:hover{
  box-shadow:var(--artifact-shadow-hover);
}

/* Homepage field desk — each file becomes a different physical object. */
.page-home .desk-file{
  border:1px solid rgba(74,60,34,.42);
  box-shadow:0 18px 32px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.16);
}
.page-home .desk-file small{font-size:8px;letter-spacing:.12em}
.page-home .desk-file strong{font-size:19px;line-height:1;letter-spacing:.045em;margin:.28rem 0 .42rem}
.page-home .desk-file span{font-size:8px;color:#5b503d;letter-spacing:.05em}
.page-home .desk-file:hover,
.page-home .desk-file:focus-visible{transform:translateY(-5px) rotate(0deg)!important}
.page-home .desk-file:before{
  position:absolute;
  left:18px;
  top:-18px;
  padding:6px 12px 5px;
  background:#d2b877;
  border:1px solid rgba(105,82,40,.55);
  border-bottom:0;
  font-size:8px;
  font-weight:700;
  letter-spacing:.12em;
  color:#2a2217;
  box-shadow:0 3px 8px rgba(0,0,0,.1);
}
.page-home .desk-file:after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(180deg,rgba(255,255,255,.12),transparent 28%,rgba(76,59,28,.04)),
    radial-gradient(circle at 14% 18%,rgba(255,255,255,.06),transparent 18%);
  mix-blend-mode:normal;
}

.page-home .file-201{
  background:linear-gradient(180deg,#d8bf84,#c3a167);
  transform:rotate(-2.2deg);
}
.page-home .file-201:before{content:"201 FILE"}
.page-home .file-201:after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(180deg,rgba(255,255,255,.16),transparent 28%,rgba(69,53,23,.05)),
    linear-gradient(135deg,transparent calc(100% - 28px),rgba(92,74,39,.16) calc(100% - 27px),rgba(243,233,200,.7) 100%);
}

.page-home .file-roster{
  background:linear-gradient(180deg,#ece4d0,#ddd0ae);
  transform:rotate(1.6deg);
}
.page-home .file-roster:before{content:"ROSTER STRIP"}

.page-home .file-ops{
  background:linear-gradient(180deg,#ece5d2,#ddd4be);
  border-top:18px solid #80704e;
  transform:rotate(1.2deg);
}
.page-home .file-ops:before{
  content:"OPORD";
  top:-31px;
  left:50%;
  transform:translateX(-50%);
  padding:5px 16px 4px;
  border-bottom:0;
}
.page-home .file-ops:after{
  content:"";
  position:absolute;
  top:-14px;
  left:50%;
  transform:translateX(-50%);
  width:76px;
  height:14px;
  border-radius:0 0 10px 10px;
  background:linear-gradient(180deg,#5e5f60,#8c8f93);
  box-shadow:0 1px 0 rgba(255,255,255,.15) inset;
}

.page-home .file-morning{
  background:linear-gradient(180deg,#ede6d3,#dfd6bf);
  border-top:15px solid #52614f;
  transform:rotate(.85deg);
}
.page-home .file-morning:before{content:"MORNING REPORT";left:22px;top:-28px}

.page-home .file-training{
  background:linear-gradient(180deg,#d4bd86,#c6ab72);
  transform:rotate(-1.9deg);
}
.page-home .file-training:before{content:"RANGE CARD"}
.page-home .file-training:after{
  content:"";
  position:absolute;
  top:10px;
  right:10px;
  width:30px;
  height:30px;
  background:linear-gradient(135deg,rgba(239,228,198,.02) 0 49%,rgba(239,228,198,.82) 50% 100%);
  border-left:1px solid rgba(98,77,39,.2);
  border-bottom:1px solid rgba(98,77,39,.2);
}

.page-home .file-supply{
  background:linear-gradient(180deg,#cfb07a,#bb965a);
  clip-path:polygon(0 0,84% 0,100% 18%,100% 100%,0 100%);
  transform:rotate(-1.15deg);
}
.page-home .file-supply:before{content:"PROPERTY TAG"}
.page-home .file-supply .tag-hole,
.page-home .file-supply::after{
  content:"";
  position:absolute;
  top:14px;
  right:16px;
  width:16px;
  height:16px;
  border-radius:50%;
  background:rgba(46,35,18,.34);
  box-shadow:0 0 0 5px rgba(240,231,205,.34);
}

.page-home .file-orders{
  background:linear-gradient(180deg,#cfaf74,#c39f62);
  border-top:16px solid #927241;
  transform:rotate(2deg);
}
.page-home .file-orders:before{
  content:"HQ FILE";
  top:-29px;
}

/* Soldier tour objects should look like placed paperwork, not cards. */
.page-home .tour-object{
  border:1px solid rgba(82,67,37,.42);
  box-shadow:0 20px 34px rgba(0,0,0,.2);
}
.page-home .tour-object:before{
  position:absolute;
  left:18px;
  top:-15px;
  padding:5px 11px 4px;
  background:#d5bc7d;
  border:1px solid rgba(97,77,39,.44);
  border-bottom:0;
  font-size:8px;
  font-weight:700;
  letter-spacing:.11em;
  color:#2a2217;
}
.page-home .assignment-order:before{content:"PERSONNEL JACKET"}
.page-home .equipment-issue:before{content:"PROPERTY CARD"}
.page-home .training-card:before{content:"TRAINING SLIP"}
.page-home .operation-overlay:before{content:"FIELD NOTE"}
.page-home .service-record:before{content:"SERVICE SUMMARY"}
.page-home .deros-card:before{content:"TOUR CONTROL"}
.page-home .equipment-issue,
.page-home .deros-card{background:linear-gradient(180deg,#d2b06e,#c39f5f)}
.page-home .operation-overlay{background:linear-gradient(180deg,#e7dcc4,#d5c59e)}
.page-home .training-card{background:linear-gradient(180deg,#e8ddc5,#dbcb9f)}
.page-home .service-record{background:linear-gradient(180deg,#efe5cf,#e1d3b5)}
.page-home .assignment-order{background:linear-gradient(180deg,#eee6d4,#ddd1b7)}

/* Battalion leader / structure cards should feel like filed TO&E cards. */
.page-battalion .leader-card,
.page-battalion .platoon-echelon,
.page-battalion .squad-card-redesign,
.page-battalion .battalion-roster-redesign,
.page-battalion .command-echelon{
  background:linear-gradient(180deg,rgba(244,238,223,.98),rgba(220,209,180,.94));
}
.page-battalion .leader-card{
  border:1px solid rgba(84,65,30,.26);
  border-left:0;
  transform:rotate(-.35deg);
}
.page-battalion .leader-card:nth-child(even){transform:rotate(.28deg)}
.page-battalion .leader-card:before{
  content:"TO&E CARD";
  position:absolute;
  top:-16px;
  left:18px;
  padding:5px 12px 4px;
  background:#d2b877;
  border:1px solid rgba(105,82,40,.45);
  border-bottom:0;
  font-size:8px;
  font-weight:700;
  letter-spacing:.12em;
  color:#2a2217;
}
.page-battalion .command-leader:before{content:"HQ APPOINTMENT"}
.page-battalion .company-leaders .leader-card:before{content:"COMPANY BILLET"}
.page-battalion .personnel-strip-redesign{
  background:linear-gradient(180deg,#efe6cf,#e0d2ae);
  border:1px solid rgba(94,74,38,.24);
  border-left:4px solid #6a6a4e;
  transform:rotate(-.15deg);
}
.page-battalion .personnel-strip-redesign:nth-child(even){transform:rotate(.18deg)}
.page-battalion .squad-card-redesign{
  box-shadow:0 16px 26px rgba(0,0,0,.16);
  transform:rotate(.2deg);
}
.page-battalion .squad-card-redesign:nth-child(even){transform:rotate(-.25deg)}

/* Personnel page: make each service record entry look like a file jacket. */
.page-personnel .personnel-file-card{
  background:linear-gradient(180deg,#decda6,#cfbb87);
  border:1px solid #93784a;
  box-shadow:0 18px 34px rgba(0,0,0,.18);
  padding-top:34px;
}
.page-personnel .personnel-file-card:before{
  content:"ACTIVE PERSONNEL FILE";
  position:absolute;
  left:18px;
  top:-18px;
  padding:5px 12px 4px;
  background:#d0b475;
  border:1px solid rgba(105,82,40,.5);
  border-bottom:0;
  font-size:8px;
  font-weight:700;
  letter-spacing:.12em;
  color:#2a2217;
}
.page-personnel .personnel-file-card:after{
  content:"201";
  position:absolute;
  right:12px;
  bottom:8px;
  font-size:52px;
  color:rgba(102,76,25,.09);
  font-weight:700;
}
.page-personnel .personnel-file-top{
  border-bottom:1px solid rgba(92,75,43,.44);
  padding-bottom:12px;
}
.page-personnel .open-record-line{
  border-top:1px dashed rgba(92,75,43,.55);
}
.page-personnel .personnel-file-grid .personnel-file-card:nth-child(3n+1){transform:rotate(-.5deg)}
.page-personnel .personnel-file-grid .personnel-file-card:nth-child(3n+2){transform:rotate(.35deg)}
.page-personnel .personnel-file-grid .personnel-file-card:nth-child(3n){transform:rotate(-.15deg)}
.page-personnel .personnel-file-grid .personnel-file-card:hover{transform:translateY(-5px) rotate(0deg)}
.page-personnel .personnel-index-row{
  background:rgba(255,255,255,.12);
}
.page-personnel .personnel-index-row.head{
  background:rgba(187,164,108,.24);
}

/* Operations cards and similar clickable documents */
.page-operations .op-folder{
  position:relative;
  overflow:visible;
  background:linear-gradient(180deg,#d8c28f,#c5ad76);
  border:1px solid rgba(80,60,27,.22);
  border-top:0;
}
.page-operations .op-folder:before{
  content:"OPORD FILE";
  position:absolute;
  top:-14px;
  left:14px;
  padding:4px 10px 3px;
  background:#d4ba79;
  border:1px solid rgba(95,73,33,.44);
  border-bottom:0;
  font-size:8px;
  font-weight:700;
  letter-spacing:.12em;
  color:#2a2217;
}

/* Make mobile calmer: keep the physical treatment but remove rotations. */
@media(max-width:820px){
  .page-home .desk-file,
  .page-home .tour-object,
  .page-personnel .personnel-file-card,
  .page-battalion .leader-card,
  .page-battalion .personnel-strip-redesign,
  .page-battalion .squad-card-redesign,
  .page-operations .op-folder{
    transform:none!important;
  }
  .record-index a{
    min-height:44px;
  }
}

/* ========================================================================
   PHYSICAL ARTIFACT PASS — REMOVE REMAINING "WEB CARD" FEEL
   Clickable surfaces behave like paper, folders, tags, boards, and slips.
   ======================================================================== */

:root{
  --artifact-shadow:0 14px 24px rgba(0,0,0,.18),0 2px 3px rgba(0,0,0,.12);
  --artifact-shadow-hover:0 19px 30px rgba(0,0,0,.24),0 3px 4px rgba(0,0,0,.14);
}

/* Avoid glossy / rounded app-card treatment anywhere important. */
.page-home .desk-file,
.page-home .tour-object,
.page-personnel .personnel-file-card,
.page-battalion .leader-card,
.page-battalion .personnel-strip-redesign,
.page-battalion .squad-card-redesign,
.page-operations .op-folder,
.page-dashboard .personal-folder,
.page-dashboard .battle-roster-mini,
.page-dashboard .today-order,
.page-dashboard .training-slip,
.page-dashboard .service-slip,
.page-orders .orders-index a,
.page-recruiting .replacement-file,
.page-training .training-folder{
  border-radius:0!important;
}

/* Hover = physical shift, not app animation. */
.page-home .desk-file:hover,
.page-home .desk-file:focus-visible,
.page-home .tour-object:hover,
.page-home .tour-object:focus-visible,
.page-personnel .personnel-file-card:hover,
.page-personnel .personnel-file-card:focus-visible,
.page-battalion .personnel-strip-redesign:hover,
.page-battalion .personnel-strip-redesign:focus-visible,
.page-operations .op-folder:hover,
.page-operations .op-folder:focus-visible,
.page-dashboard .personal-folder:hover,
.page-dashboard .personal-folder:focus-visible,
.page-orders .orders-index a:hover,
.page-orders .orders-index a:focus-visible{
  box-shadow:var(--artifact-shadow-hover);
  filter:none;
}

/* Tiny paper fibers / discoloration without fake noise graphics. */
.page-home .desk-file,
.page-home .tour-object,
.page-personnel .personnel-file-card,
.page-battalion .leader-card,
.page-battalion .personnel-strip-redesign,
.page-operations .op-folder,
.page-dashboard .personal-folder,
.page-orders .orders-index a{
  background-image:
    linear-gradient(180deg,rgba(255,255,255,.10),transparent 30%,rgba(77,57,25,.035)),
    radial-gradient(circle at 13% 14%,rgba(255,255,255,.07),transparent 20%),
    radial-gradient(circle at 81% 77%,rgba(89,66,31,.04),transparent 24%);
}

/* FIELD DESK: deliberately different physical formats. */
.page-home .file-201{
  box-shadow:0 18px 30px rgba(0,0,0,.23);
}
.page-home .file-201:after{
  background:
    linear-gradient(180deg,rgba(255,255,255,.12),transparent 38%),
    linear-gradient(135deg,transparent calc(100% - 28px),rgba(82,62,30,.18) calc(100% - 27px),#e4cf98 100%);
}
.page-home .file-roster{
  border-left:5px solid #7d765e;
  box-shadow:0 12px 22px rgba(0,0,0,.20);
}
.page-home .file-ops{
  box-shadow:0 17px 28px rgba(0,0,0,.23);
}
.page-home .file-morning{
  box-shadow:0 16px 25px rgba(0,0,0,.22);
}
.page-home .file-training{
  border-bottom:3px solid rgba(100,74,34,.22);
}
.page-home .file-supply{
  box-shadow:0 15px 26px rgba(0,0,0,.22);
}
.page-home .file-orders{
  box-shadow:0 18px 30px rgba(0,0,0,.23);
}

/* TOUR TABLE: make slips look independently placed, with tack / clip details. */
.page-home .assignment-order:after,
.page-home .training-card:after,
.page-home .operation-overlay:after,
.page-home .service-record:after,
.page-home .deros-card:after,
.page-home .equipment-issue:after{
  content:"";
  position:absolute;
  width:8px;
  height:8px;
  border-radius:50%;
  top:9px;
  right:11px;
  background:#403a30;
  box-shadow:inset 0 1px 1px rgba(255,255,255,.25),0 1px 2px rgba(0,0,0,.45);
  opacity:.65;
}
.page-home .operation-overlay:after,
.page-home .service-record:after{
  width:42px;
  height:8px;
  border-radius:2px;
  right:18px;
  background:linear-gradient(180deg,#777b7d,#a8abad);
  transform:rotate(3deg);
}

/* S-1 personnel jackets: tabbed folders rather than profile tiles. */
.page-personnel .personnel-file-card{
  border-top:0;
  box-shadow:0 16px 28px rgba(0,0,0,.20);
}
.page-personnel .personnel-file-tab{
  top:-15px;
  left:20px;
  padding:6px 14px 5px;
  background:#c9aa69;
  border:1px solid #886d3d;
  border-bottom:0;
  box-shadow:0 -2px 5px rgba(0,0,0,.05);
}
.page-personnel .personnel-card-rank{
  background:#31352b;
  border-color:#78715d;
  box-shadow:inset 0 0 18px rgba(0,0,0,.22);
}
.page-personnel .open-record-line b{
  border:1px solid rgba(92,75,43,.42);
  padding:4px 7px 3px;
  transform:rotate(-1deg);
}

/* Battalion TO&E: name strips and appointment cards, not software cards. */
.page-battalion .leader-card{
  box-shadow:0 13px 22px rgba(0,0,0,.17);
}
.page-battalion .leader-card-copy{
  border-left:1px dotted rgba(83,66,35,.34);
  padding-left:14px;
}
.page-battalion .personnel-strip-redesign{
  min-height:58px;
  box-shadow:0 8px 13px rgba(0,0,0,.12);
}
.page-battalion .personnel-strip-redesign:after{
  content:"";
  position:absolute;
  right:9px;
  top:9px;
  width:6px;
  height:6px;
  border-radius:50%;
  background:#5a5140;
  opacity:.45;
}
.page-battalion .squad-card-redesign{
  border:1px solid rgba(72,60,39,.28);
  background:linear-gradient(180deg,#d5c59e,#c5b380);
}

/* Operations: clipped manila OPORD packets. */
.page-operations .op-folder{
  padding-top:1.25rem;
  box-shadow:0 16px 27px rgba(0,0,0,.22);
}
.page-operations .op-folder:after{
  content:"";
  position:absolute;
  width:62px;
  height:13px;
  top:-8px;
  right:20px;
  border-radius:1px 1px 8px 8px;
  background:linear-gradient(180deg,#626669,#9da0a1);
  box-shadow:0 1px 1px rgba(255,255,255,.18) inset,0 2px 3px rgba(0,0,0,.16);
}

/* Orders file index: old metal label holder / drawer labels. */
.page-orders .orders-index{
  background:linear-gradient(180deg,#47493f,#3c3f36);
  border:8px solid #2e302a;
}
.page-orders .orders-index a{
  position:relative;
  margin:8px 0;
  padding:10px 12px;
  min-height:auto;
  background:linear-gradient(180deg,#e2d4ad,#ccb98b);
  border:1px solid #6f6650;
  color:#2a2419;
  box-shadow:inset 0 0 0 3px rgba(86,78,61,.10),0 3px 5px rgba(0,0,0,.16);
}
.page-orders .orders-index a:before,
.page-orders .orders-index a:after{
  content:"";
  position:absolute;
  top:50%;
  width:4px;
  height:4px;
  border-radius:50%;
  background:#615c50;
  transform:translateY(-50%);
}
.page-orders .orders-index a:before{left:5px}
.page-orders .orders-index a:after{right:5px}
.page-orders .orders-index a:hover{transform:translateX(2px);background:#e8dbb9}

/* Soldier's Field Desk: mixed file objects instead of equal boxes. */
.page-dashboard .personal-worktable{
  gap:32px;
  align-items:start;
}
.page-dashboard .personal-folder{
  background:linear-gradient(180deg,#c8a967,#b99658);
  transform:rotate(-.7deg);
  box-shadow:0 16px 28px rgba(0,0,0,.20);
}
.page-dashboard .battle-roster-mini{
  transform:rotate(.45deg);
  border-top:14px solid #6e705e;
}
.page-dashboard .today-order{transform:rotate(-.25deg)}
.page-dashboard .training-slip{transform:rotate(.5deg)}
.page-dashboard .service-slip{transform:rotate(-.4deg)}

/* Training / recruiting physical pieces. */
.page-training .training-folder{
  background:linear-gradient(180deg,#c8a76a,#b99254);
  border:1px solid rgba(92,70,34,.42);
  box-shadow:0 17px 30px rgba(0,0,0,.20);
}
.page-recruiting .replacement-file{
  border:1px solid rgba(91,69,34,.45);
  box-shadow:0 20px 34px rgba(0,0,0,.23);
}

/* Keep physical imperfections subtle on smaller screens. */
@media(max-width:820px){
  .page-dashboard .personal-folder,
  .page-dashboard .battle-roster-mini,
  .page-dashboard .today-order,
  .page-dashboard .training-slip,
  .page-dashboard .service-slip{
    transform:none;
  }
  .page-home .assignment-order:after,
  .page-home .training-card:after,
  .page-home .operation-overlay:after,
  .page-home .service-record:after,
  .page-home .deros-card:after,
  .page-home .equipment-issue:after{
    display:none;
  }
}

/* ======================================================================
   SERVICE RECORD IMMERSION PASS — S-1 PERSONNEL TENT / 201 FILE REDESIGN
   ====================================================================== */

.page-201 .file-cabinet-room{
  position:relative;
  isolation:isolate;
  padding:72px 3.5vw 110px;
  background:
    linear-gradient(180deg, rgba(38,40,33,.9), rgba(51,54,44,.88) 18%, rgba(64,66,53,.86) 50%, rgba(42,40,32,.92) 100%),
    url('/static/art/hq-canvas.webp') center top/cover no-repeat;
}
.page-201 .file-cabinet-room:before{
  content:"";
  position:absolute; inset:0;
  background:
    radial-gradient(circle at 16% 18%, rgba(248,233,187,.16), transparent 24%),
    radial-gradient(circle at 84% 8%, rgba(248,233,187,.10), transparent 18%),
    linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.24));
  pointer-events:none;
  z-index:-1;
}
.page-201 .file-cabinet-room:after{
  content:"";
  position:absolute; left:0; right:0; bottom:0; height:220px;
  background:linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.35));
  pointer-events:none;
  z-index:-1;
}
.page-201 .room-label{
  max-width:1360px;
  background:linear-gradient(180deg, rgba(27,28,24,.74), rgba(21,22,18,.56));
  border:1px solid rgba(234,219,179,.16);
  box-shadow:0 22px 42px rgba(0,0,0,.18);
  padding:18px 22px 16px;
}
.page-201 .room-label span{font-size:10px; letter-spacing:.22em; color:#d4b14d}
.page-201 .room-label h1{font-size:46px; line-height:1.05; margin:6px 0 8px; color:#f2ead7}
.page-201 .room-subcopy{max-width:78ch; margin:0; color:#dfd3b8; line-height:1.82; font-size:12px}

.page-201 .manila-file{
  max-width:1360px;
  padding:74px 38px 40px;
  background:
    linear-gradient(180deg, rgba(208,188,129,.96), rgba(195,172,114,.97));
  border:1px solid #7c6233;
  box-shadow:0 34px 70px rgba(0,0,0,.28), 0 8px 18px rgba(73,56,25,.18);
  overflow:visible;
}
.page-201 .manila-file:before{
  content:"ACTIVE PERSONNEL JACKET • S-1 FIELD FILE";
  position:absolute; right:28px; top:16px;
  font-size:9px; letter-spacing:.18em; color:#5f4b24;
  opacity:.8;
}
.page-201 .manila-file:after{
  content:"";
  position:absolute; inset:auto 50px 20px 50px; height:18px;
  background:rgba(0,0,0,.05); filter:blur(18px); z-index:0;
}
.page-201 .manila-tab{
  background:linear-gradient(180deg,#c29f5f,#ad8948) !important;
  border:1px solid #735727;
  box-shadow:0 10px 16px rgba(0,0,0,.14);
  transform:rotate(-.4deg);
}
.page-201 .file-section-tabs{
  position:relative;
  z-index:2;
  gap:0;
  row-gap:8px;
  margin:-30px 0 18px;
  align-items:flex-end;
}
.page-201 .file-section-tabs a{
  position:relative;
  top:0;
  padding:10px 14px 8px;
  margin-right:7px;
  background:linear-gradient(180deg,#dbc48b,#c8aa69);
  border:1px solid #7b6231;
  border-bottom-color:#b28f50;
  border-radius:5px 5px 0 0;
  box-shadow:0 8px 16px rgba(0,0,0,.10);
  font-size:9px;
  letter-spacing:.16em;
  transform-origin:bottom center;
  transition:transform .18s ease, box-shadow .18s ease, top .18s ease, background .18s ease;
}
.page-201 .file-section-tabs a:nth-child(odd){transform:rotate(-.6deg)}
.page-201 .file-section-tabs a:nth-child(even){transform:rotate(.55deg)}
.page-201 .file-section-tabs a:nth-child(3n){padding-left:16px; padding-right:18px}
.page-201 .file-section-tabs a:hover{
  top:-4px;
  transform:translateY(-1px) rotate(0deg);
  background:linear-gradient(180deg,#ead7a6,#d9bb7a);
  box-shadow:0 14px 22px rgba(0,0,0,.16);
}

.page-201 .tent-prop-strip{
  display:grid;
  grid-template-columns:1.05fr .95fr .8fr;
  gap:18px;
  margin:0 0 20px;
  position:relative;
  z-index:1;
}
.page-201 .tent-prop{
  min-height:185px;
  box-shadow:0 14px 28px rgba(0,0,0,.12);
  border:1px solid rgba(81,60,26,.18);
}
.page-201 .radio-prop{
  display:grid;
  grid-template-columns:180px 1fr;
  overflow:hidden;
}
.page-201 .tent-prop-image{background:#e0d1a5; border-right:1px solid rgba(81,60,26,.16)}
.page-201 .tent-prop-image img{display:block; width:100%; height:100%; object-fit:cover}
.page-201 .tent-prop-copy{padding:14px 16px; display:flex; flex-direction:column; justify-content:center}
.page-201 .tent-prop-copy small,
.page-201 .prop-lines span,
.page-201 .tour-card-subtitle,
.page-201 .duty-card-note,
.page-201 .cover-brief{font-size:10px; letter-spacing:.08em}
.page-201 .tent-prop-copy strong{font-size:18px; margin:3px 0 6px; letter-spacing:.06em}
.page-201 .tent-prop-copy span{line-height:1.6; color:#4b4031; font-size:10px}
.page-201 .clerk-memo,
.page-201 .field-note{padding:16px 18px}
.page-201 .clerk-memo p{margin:.8rem 0 0; line-height:1.75; color:#43382a}
.page-201 .prop-lines{display:grid; gap:10px; margin-top:.85rem}
.page-201 .prop-lines span{display:flex; justify-content:space-between; gap:12px; padding-bottom:8px; border-bottom:1px dotted rgba(87,68,33,.28); color:#382d21}
.page-201 .prop-lines b{font-size:12px}

.page-201 .file-jacket-summary{
  position:relative;
  z-index:1;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:18px;
}
.page-201 .file-jacket-summary .jacket-card{
  min-height:122px;
  background:linear-gradient(180deg, rgba(244,238,226,.82), rgba(222,210,182,.9));
  border:1px solid rgba(84,64,31,.18);
  box-shadow:0 12px 20px rgba(0,0,0,.10);
}
.page-201 .file-jacket-summary .jacket-card:nth-child(1){transform:rotate(-1.1deg)}
.page-201 .file-jacket-summary .jacket-card:nth-child(2){transform:rotate(.8deg)}
.page-201 .file-jacket-summary .jacket-card:nth-child(3){transform:rotate(-.55deg)}
.page-201 .file-jacket-summary .jacket-card:nth-child(4){transform:rotate(1.1deg)}

.page-201 .file-cover-sheet{
  position:relative;
  z-index:1;
  background:linear-gradient(180deg, rgba(244,237,221,.98), rgba(227,214,186,.96));
  border:1px solid rgba(84,64,31,.18);
  box-shadow:0 18px 34px rgba(0,0,0,.13);
}
.page-201 .cover-brief{display:block; margin-top:.7rem; line-height:1.7; color:#645338}
.page-201 .cover-status-line span{font-size:10px}
.page-201 .stamp-covered{box-shadow:0 6px 14px rgba(0,0,0,.08)}

.page-201 .record-form,
.page-201 .file-document,
.page-201 .tour-control-card,
.page-201 .duty-status-card{
  position:relative;
  z-index:1;
  background:linear-gradient(180deg, rgba(246,241,229,.99), rgba(229,218,191,.97));
  border:1px solid rgba(84,64,31,.18);
  box-shadow:0 16px 30px rgba(0,0,0,.11);
}
.page-201 .record-form{transform:rotate(-.35deg)}
.page-201 .record-form:before,
.page-201 .file-document:before{
  content:"";
  position:absolute; top:0; left:0; right:0; height:16px;
  background:linear-gradient(180deg, rgba(255,255,255,.32), rgba(255,255,255,0));
  pointer-events:none;
}
.page-201 .record-title-line{padding-top:14px}
.page-201 .form-grid dt,
.page-201 .form-grid dd{font-size:11px}

.page-201 .tour-file-spread{align-items:start; gap:22px; margin:24px 0 18px}
.page-201 .tour-control-card{transform:rotate(-.8deg)}
.page-201 .tour-control-card h3{margin:4px 0 8px; font-size:28px}
.page-201 .tour-card-subtitle{margin:0 0 14px; color:#5a4a2f}
.page-201 .duty-status-card{transform:rotate(1deg)}
.page-201 .duty-status-card p{margin-bottom:12px}
.page-201 .duty-card-note{padding-top:10px; border-top:1px dotted rgba(87,68,33,.28); color:#5a4a2f}

.page-201 .file-documents{
  gap:22px;
  align-items:start;
}
.page-201 .file-document:nth-child(odd){transform:rotate(-.45deg)}
.page-201 .file-document:nth-child(even){transform:rotate(.42deg)}
.page-201 .file-document header small{letter-spacing:.15em; color:#6a5734}
.page-201 .file-document header b{font-size:18px; letter-spacing:.05em}
.page-201 .entry-row{padding:10px 0}
.page-201 .entry-row span{font-size:11px}
.page-201 .entry-row b{font-size:11px}
.page-201 .entry-row small{font-size:10px; line-height:1.65}
.page-201 .typed-empty{font-size:11px; color:#5b4d39; line-height:1.75}
.page-201 .form-note,.page-201 .file-note{font-size:11px; line-height:1.75; color:#4f4537}
.page-201 .service-journal .journal-entry{background:rgba(255,255,255,.12); padding:12px 10px; margin-bottom:8px}
.page-201 .service-journal .journal-entry time{font-size:10px; letter-spacing:.12em}

.page-201 .weapon-file-sheet,
.page-201 .uniform-file-sheet,
.page-201 .service-journal{grid-column:1/-1; transform:none !important}
.page-201 .weapon-file-sheet{padding-top:28px}
.page-201 .weapon-file-sheet:after,
.page-201 .uniform-file-sheet:after{
  content:"INSERT SHEET";
  position:absolute; top:-14px; right:22px;
  background:linear-gradient(180deg,#ceb378,#bb9958);
  border:1px solid #7a6230;
  padding:7px 14px 5px;
  font-size:9px; letter-spacing:.18em; color:#2a2114;
  border-radius:4px 4px 0 0;
  box-shadow:0 6px 12px rgba(0,0,0,.10);
}
.page-201 .weapon-file-sheet:after{content:"ARMS ROOM INSERT"}
.page-201 .uniform-file-sheet:after{content:"CLOTHING RECORD INSERT"}
.page-201 .weapon-visual.record{
  background:
    linear-gradient(180deg, rgba(108,114,94,.92), rgba(73,80,63,.94)),
    url('/static/art/hq-field-desk.webp') center/cover no-repeat;
  border:1px solid rgba(49,41,24,.28);
}
.page-201 .weapon-record-grid dt,
.page-201 .weapon-record-grid dd{font-size:11px; line-height:1.6}
.page-201 .weapon-state-banner{display:inline-block; margin:12px 0 8px}
.page-201 .uniform-record-visual{
  background:
    linear-gradient(180deg, rgba(104,110,90,.94), rgba(74,80,64,.96)),
    url('/static/art/hq-canvas.webp') center/cover no-repeat;
}
.page-201 .uniform-record-copy{padding-top:6px}
.page-201 .uniform-awards{background:rgba(194,175,121,.22)}

@media(max-width:1180px){
  .page-201 .tent-prop-strip,
  .page-201 .file-jacket-summary,
  .page-201 .uniform-record-grid{grid-template-columns:1fr 1fr}
  .page-201 .radio-prop{grid-template-columns:1fr}
  .page-201 .tent-prop-image{max-height:220px; border-right:0; border-bottom:1px solid rgba(81,60,26,.16)}
}
@media(max-width:980px){
  .page-201 .room-label h1{font-size:34px}
  .page-201 .manila-file{padding:68px 18px 26px}
  .page-201 .tent-prop-strip,
  .page-201 .file-jacket-summary,
  .page-201 .file-documents,
  .page-201 .tour-file-spread,
  .page-201 .uniform-record-grid{grid-template-columns:1fr}
  .page-201 .file-section-tabs{margin-top:-20px}
  .page-201 .file-document,
  .page-201 .record-form,
  .page-201 .tour-control-card,
  .page-201 .duty-status-card,
  .page-201 .file-jacket-summary .jacket-card{transform:none !important}
}
@media(max-width:720px){
  .page-201 .room-label{padding:14px 16px}
  .page-201 .room-subcopy{font-size:11px}
  .page-201 .file-cabinet-room{padding:50px 12px 72px}
  .page-201 .file-section-tabs a{padding:10px 12px 8px; font-size:8px}
  .page-201 .cover-photo-clip img{height:190px}
}


.page-201 .loa-card{background:linear-gradient(180deg,#d9c18e,#c7ae75)}
.page-201 .loa-card h3{letter-spacing:.06em}

/* ========================================================================
   MEMBER ACCESS — MY SOLDIER RECORD
   ======================================================================== */
.member-record-login{position:relative;min-height:820px;display:flex;align-items:center;justify-content:center;padding:80px 20px;overflow:hidden;background:#272b22}
.member-record-login-photo{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover no-repeat;filter:brightness(.58) saturate(.82)}
.member-record-login-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,19,14,.78),rgba(17,19,14,.34),rgba(17,19,14,.7))}
.member-record-login-sheet{position:relative;z-index:2;width:min(620px,94vw);padding:44px 48px 38px;transform:rotate(-.35deg);box-shadow:0 28px 60px rgba(0,0,0,.35)}
.member-record-login-sheet h1{font-size:38px;margin:22px 0 8px;letter-spacing:.04em}
.member-record-login-sheet>p{line-height:1.75;color:#443a2d}
.member-record-login-sheet form{display:grid;gap:14px;margin:22px 0}
.member-record-login-sheet label{display:grid;gap:6px;font-size:10px;font-weight:700;letter-spacing:.09em;color:#30271c}
.member-record-login-sheet input{background:rgba(255,255,255,.24);border:0;border-bottom:2px solid #6f6043;padding:12px 10px;font:inherit;color:#211a12}
.member-login-stamp{position:absolute;right:28px;top:138px;border:3px double #6f3027;color:#6f3027;padding:8px 10px;font-size:11px;font-weight:700;letter-spacing:.1em;transform:rotate(5deg);text-align:center}
.member-login-note{margin-top:24px;border-top:1px dotted #88795e;padding-top:16px;display:grid;gap:5px}
.member-login-note b{font-size:10px;letter-spacing:.08em}.member-login-note span{font-size:10px;line-height:1.65;color:#554a3a}

.member-record-hero{position:relative;min-height:440px;overflow:hidden;background:#252a22}
.member-record-hero-photo{position:absolute;inset:0;background:url('/static/art/hq-canvas.webp') center/cover no-repeat;filter:brightness(.62) saturate(.82)}
.member-record-hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(14,16,12,.86),rgba(14,16,12,.36) 65%,rgba(14,16,12,.56))}
.member-record-identity{position:absolute;left:6vw;bottom:54px;z-index:2;max-width:860px;color:#efe5cf;text-shadow:0 2px 5px rgba(0,0,0,.7)}
.member-record-identity>span{font-size:10px;letter-spacing:.18em;color:#e0b948;font-weight:700}
.member-record-identity h1{font-size:clamp(48px,6vw,84px);line-height:.92;margin:8px 0 10px;letter-spacing:-.035em}
.member-record-identity h2{font-size:24px;margin:0 0 8px;letter-spacing:.04em}.member-record-identity p{font-size:13px;letter-spacing:.05em}
.member-status-stamp{display:inline-block;margin-top:12px;border:2px solid #d8c98e;padding:7px 10px;font-size:10px;letter-spacing:.11em;background:rgba(22,24,18,.34);transform:rotate(-1deg)}

.member-record-desk{max-width:1500px;margin:-28px auto 70px;padding:0 28px;position:relative;z-index:4;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:22px;align-items:start}
.member-summary-jacket,.member-paper{position:relative;color:#271f15;border:1px solid rgba(73,55,25,.22);box-shadow:0 18px 35px rgba(0,0,0,.18)}
.member-summary-jacket{grid-column:span 5;background:linear-gradient(180deg,#c8a867,#b89450);padding:50px 28px 28px;transform:rotate(-.55deg)}
.member-summary-tab{position:absolute;left:18px;top:-25px;background:#d3b575;border:1px solid #806633;border-bottom:0;padding:7px 15px 5px;font-size:9px;letter-spacing:.12em;font-weight:700}
.member-summary-jacket header{border-bottom:1px solid rgba(74,57,27,.35);padding-bottom:12px;margin-bottom:12px}.member-summary-jacket header small,.member-paper header small{display:block;font-size:9px;letter-spacing:.13em}.member-summary-jacket header strong,.member-paper header strong{display:block;font-size:21px;letter-spacing:.04em;margin-top:3px}
.member-summary-jacket dl,.member-mini-grid{display:grid;grid-template-columns:145px 1fr;margin:0}.member-summary-jacket dt,.member-summary-jacket dd,.member-mini-grid dt,.member-mini-grid dd{margin:0;padding:7px 0;border-bottom:1px dotted rgba(75,58,28,.34);font-size:10px}.member-summary-jacket dd,.member-mini-grid dd{font-weight:700}
.member-paper{background:linear-gradient(180deg,rgba(245,239,224,.98),rgba(224,213,185,.97));padding:26px 28px;min-height:240px}
.member-paper:before{content:"";position:absolute;inset:9px;border:1px solid rgba(81,65,39,.08);pointer-events:none}
.member-paper header{position:relative;border-bottom:1px solid #6c624f;padding-bottom:9px;margin-bottom:11px}
.current-assignment-paper{grid-column:span 7;transform:rotate(.35deg)}
.orders-paper{grid-column:span 7;transform:rotate(-.25deg)}
.awards-paper{grid-column:span 5;transform:rotate(.5deg)}
.chain-paper{grid-column:span 5;transform:rotate(-.45deg)}
.weapon-member-paper{grid-column:span 7;transform:rotate(.25deg)}
.uniform-member-paper{grid-column:span 5;transform:rotate(-.4deg)}
.training-member-paper{grid-column:span 7;transform:rotate(.4deg)}
.service-member-paper{grid-column:span 5;transform:rotate(-.25deg)}
.assignment-block{display:grid;grid-template-columns:160px 1fr;gap:12px;padding:8px 0;border-bottom:1px dotted #88795e}.assignment-block span{font-size:9px;letter-spacing:.09em}.assignment-block b{font-size:12px}
.member-history-line,.member-award-line,.member-chain-line,.member-qual-line,.member-service-line{display:grid;grid-template-columns:1fr auto;gap:8px;padding:9px 0;border-bottom:1px dotted #897b61;font-size:10px}.member-history-line span,.member-award-line span,.member-qual-line span{font-size:10px}.member-award-line small,.member-qual-line small,.member-service-line small{grid-column:1/-1;color:#625643;font-size:9px}
.member-chain-line span{font-size:9px;letter-spacing:.08em}.member-chain-line b{text-align:right}
.member-order-line{display:grid;grid-template-columns:105px 1fr;gap:8px;padding:10px 0;border-bottom:1px dotted #897b61}.member-order-line span{font-size:9px}.member-order-line b{font-size:12px}.member-order-line small{grid-column:2;font-size:9px;color:#625643}
.record-paper-link{display:inline-block;margin-top:15px;font-size:9px;font-weight:700;letter-spacing:.08em;color:#4c391c;border-bottom:1px solid #7b6438;padding-bottom:2px}
.member-uniform-visual{height:330px;display:flex;justify-content:center;align-items:end;background:linear-gradient(180deg,#6d725e,#4f5544);border:1px solid rgba(55,45,26,.2);padding:16px 10px 0}.member-uniform-visual > img.uniform-base-image{height:100%;max-width:100%;object-fit:contain}.uniform-member-paper p{font-size:11px;line-height:1.65}.member-uniform-status{display:flex;justify-content:space-between;border-top:1px dotted #897b61;padding-top:9px;font-size:10px}
.weapon-member-paper .weapon-visual.record{min-height:260px;background:linear-gradient(180deg,#6c715e,#4d5342)}

@media(max-width:1050px){.member-record-desk{grid-template-columns:1fr 1fr}.member-summary-jacket,.member-paper{grid-column:auto!important;transform:none!important}.member-summary-jacket{grid-column:1/-1!important}}
@media(max-width:720px){.member-record-login-sheet{padding:34px 22px}.member-login-stamp{position:relative;right:auto;top:auto;display:inline-block;margin:12px 0}.member-record-hero{min-height:390px}.member-record-identity{left:20px;right:20px;bottom:35px}.member-record-identity h1{font-size:46px}.member-record-desk{grid-template-columns:1fr;padding:0 14px;margin-top:-16px}.member-summary-jacket,.member-paper{grid-column:1!important}.member-summary-jacket dl,.member-mini-grid,.assignment-block{grid-template-columns:1fr}.member-summary-jacket dt,.member-mini-grid dt{padding-bottom:2px;border-bottom:0}.member-summary-jacket dd,.member-mini-grid dd{padding-top:2px}.member-uniform-visual{height:280px}}
.appointments-member-paper{grid-column:span 6;transform:rotate(.2deg)}
.operations-member-paper{grid-column:span 6;transform:rotate(-.35deg)}
.leave-member-paper{grid-column:span 5;transform:rotate(.45deg);background:linear-gradient(180deg,#d8c492,#cdb47d)}
@media(max-width:1050px){.appointments-member-paper,.operations-member-paper,.leave-member-paper{grid-column:auto!important;transform:none!important}}

/* ======================================================================
   REPLACEMENT TRAINING / PROMOTION PROGRESSION
   ====================================================================== */
.replacement-training-paper{grid-column:span 7;transform:rotate(-.25deg);background:linear-gradient(180deg,#e6dcc2,#d9c9a5)}
.promotion-eligibility-paper{grid-column:span 5;transform:rotate(.35deg);background:linear-gradient(180deg,#e2d7bc,#d4c39c)}
.training-record-status{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;align-items:baseline;padding:12px 14px;margin:10px 0 14px;border:2px solid #76633e;background:rgba(255,255,255,.15)}
.training-record-status span{font-size:9px;letter-spacing:.13em}.training-record-status b{font-size:18px}.training-record-status small{grid-column:1/-1;font-size:9px;letter-spacing:.06em}.training-record-status.complete{border-color:#46583b}.training-record-status.pending{border-color:#8a6335}
.replacement-checklist{display:grid;gap:7px}.replacement-check{display:grid;grid-template-columns:24px 1fr;gap:9px;align-items:start;padding:8px 4px;border-bottom:1px dotted rgba(75,60,34,.32)}.replacement-check .check-mark{font-size:18px;line-height:1}.replacement-check b,.replacement-check small{display:block}.replacement-check b{font-size:11px}.replacement-check small{font-size:9px;margin-top:2px;color:#645640}.replacement-check.done .check-mark{color:#3e5438}.replacement-check.open .check-mark{color:#8a6335}
.rules-acknowledge-form{margin-top:15px;padding:14px;background:rgba(185,157,95,.2);border:1px solid rgba(80,61,30,.2)}.rules-acknowledge-form p{font-size:10px;line-height:1.7;margin:0 0 10px}.rules-filed-stamp{display:inline-block;margin-top:14px;border:3px double #44593b;color:#44593b;padding:7px 11px;font-weight:700;letter-spacing:.08em;transform:rotate(-1deg)}
.promotion-path-sheet{padding:12px 0;border-bottom:1px solid rgba(76,59,31,.2)}.promotion-path-sheet:last-child{border-bottom:0}.promotion-path-heading{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;align-items:baseline}.promotion-path-heading>span{font-size:10px;font-weight:700;letter-spacing:.12em}.promotion-path-heading>b{font-size:15px}.promotion-status{grid-column:1/-1;justify-self:start;font-style:normal;font-size:9px;letter-spacing:.09em;padding:4px 7px;border:1px solid currentColor;margin-top:4px}.promotion-status.eligible{color:#3f5838}.promotion-status.not-eligible{color:#7d5631}.appointment-promotion-note{font-size:9px;letter-spacing:.08em;margin:8px 0;color:#624a2b}.promotion-requirement-list{display:grid;gap:4px;margin-top:8px}.promotion-requirement{display:grid;grid-template-columns:20px 1fr auto;gap:7px;align-items:center;padding:5px 0;border-bottom:1px dotted rgba(76,59,31,.2)}.promotion-requirement b{font-size:9px}.promotion-requirement small{font-size:8px;text-align:right;color:#685942}.promotion-requirement.complete>span{color:#3f5838}.promotion-requirement.incomplete>span{color:#8a6335}

.replacement-training-file,.promotion-eligibility-file{position:relative;padding:26px 30px;margin:22px 0;background:linear-gradient(180deg,rgba(246,240,226,.99),rgba(229,216,186,.97));border:1px solid rgba(84,64,31,.18);box-shadow:0 16px 30px rgba(0,0,0,.11)}
.replacement-training-file{transform:rotate(-.25deg)}.promotion-eligibility-file{transform:rotate(.2deg)}.replacement-file-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px 18px;margin-top:12px}.replacement-file-line{display:grid;grid-template-columns:22px 1fr;gap:7px;padding:8px 0;border-bottom:1px dotted rgba(76,59,31,.26)}.replacement-file-line b,.replacement-file-line small{display:block}.replacement-file-line b{font-size:10px}.replacement-file-line small{grid-column:2;font-size:9px;color:#65563d}.replacement-complete-stamp{position:absolute;right:32px;bottom:28px;transform:rotate(-5deg)}

.replacement-processing-desk{display:grid;grid-template-columns:1.25fr 1fr;gap:1rem;align-items:start}.replacement-certification-form{grid-row:span 2}.promotion-hold-form,.promotion-recommendation-form,.training-certification-form,.replacement-certification-form{padding:1.15rem}.replacement-status-board{margin-top:1rem;border-top:2px solid #50442f}.replacement-status-row{display:grid;grid-template-columns:1fr auto;gap:1rem;padding:.55rem 0;border-bottom:1px dotted rgba(65,51,29,.28)}.replacement-status-row span>*{display:block}.replacement-status-row small{font-size:.65rem}.replacement-status-row strong{font-size:.72rem;letter-spacing:.06em}
.promotion-eligibility-board{margin:1.15rem 0;padding:1.15rem}.promotion-board-head,.promotion-board-row{display:grid;grid-template-columns:1.2fr 1fr .9fr;gap:.7rem;align-items:center;padding:.55rem .25rem;border-bottom:1px dotted rgba(65,51,29,.28)}.promotion-board-head{font-size:.65rem;font-weight:900;border-bottom:2px solid #50442f}.promotion-board-row span>*{display:block}.promotion-board-row small{font-size:.63rem}.promotion-board-row strong{font-size:.67rem;letter-spacing:.04em}.promotion-board-row strong.eligible{color:#405638}.promotion-board-row strong.not-eligible{color:#7b5531}

.rank-progression-office{padding:72px 4vw 95px;background:linear-gradient(180deg,#555946,#444839)}.progression-office-heading{max-width:1320px;margin:0 auto 18px;padding:1.2rem 1.35rem}.progression-office-heading h2{font-size:clamp(32px,4vw,54px);margin:.3rem 0}.progression-office-heading p{max-width:90ch;line-height:1.75}.progression-tracks{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px}.progression-track{padding:1.1rem 1.2rem}.progression-track>header{border-bottom:2px solid #4e4432;padding-bottom:.55rem;margin-bottom:.4rem}.progression-track>header small,.progression-track>header strong{display:block}.progression-track>header small{font-size:.65rem;letter-spacing:.14em}.progression-track>header strong{font-size:1.15rem}.progression-line{padding:.65rem 0;border-bottom:1px dotted rgba(68,52,28,.3)}.progression-line b,.progression-line span,.progression-line small{display:block}.progression-line b{font-size:.78rem}.progression-line span{font-size:.72rem;line-height:1.55;margin-top:.12rem}.progression-line small{font-size:.62rem;line-height:1.55;margin-top:.12rem}.progression-line.appointment{background:rgba(188,161,101,.16);padding:.65rem .55rem}.training-program-register{max-width:1320px;margin:18px auto 0;padding:1.15rem 1.25rem}.training-program-line{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem;padding:.55rem 0;border-bottom:1px dotted rgba(68,52,28,.3);font-size:.72rem}

@media(max-width:1050px){.replacement-training-paper,.promotion-eligibility-paper{grid-column:auto!important;transform:none!important}.replacement-processing-desk,.progression-tracks{grid-template-columns:1fr}.replacement-file-grid{grid-template-columns:1fr}.promotion-board-head,.promotion-board-row{grid-template-columns:1fr 1fr}.promotion-board-head span:last-child,.promotion-board-row>strong{grid-column:1/-1}}
@media(max-width:720px){.promotion-requirement{grid-template-columns:20px 1fr}.promotion-requirement small{grid-column:2;text-align:left}.training-program-line{grid-template-columns:1fr}.rank-progression-office{padding:52px 14px 70px}}

/* ACCESS CONTROL + AWARD ROUTING PASS */
.s1-award-control,.command-award-board .document-sheet{max-width:1400px;margin:0 auto 28px;padding:28px;background:linear-gradient(180deg,rgba(239,231,209,.98),rgba(220,208,177,.97));box-shadow:0 18px 34px rgba(0,0,0,.2)}
.award-control-summary,.command-notification-strip{display:flex;align-items:center;gap:14px;border:2px solid rgba(50,43,28,.5);padding:12px 16px;margin:14px 0 20px;letter-spacing:.05em}
.award-control-summary b,.command-notification-strip b{font-family:'Stardos Stencil',serif;font-size:28px}.command-notification-strip.attention{border-width:3px;transform:rotate(-.3deg)}
.s1-award-issue-desk{margin:18px 0 26px;padding:18px;border:2px solid rgba(50,43,28,.55);background:rgba(255,250,232,.42)}.s1-award-issue-desk>header{display:flex;justify-content:space-between;gap:18px;align-items:flex-end;border-bottom:1px solid rgba(50,43,28,.45);padding-bottom:10px;margin-bottom:14px}.s1-award-issue-desk>header span{font:700 10px/1.2 'Oswald',sans-serif;letter-spacing:.14em}.s1-award-issue-desk>header strong{font-family:'Stardos Stencil',serif;font-size:24px}.s1-award-issue-desk .award-issue-note{font:11px/1.45 'Courier Prime',monospace;margin:0 0 14px}.s1-award-issue-desk textarea{min-height:110px}.s1-award-issue-desk .award-auto-order{display:flex;align-items:center;padding:10px 12px;border:1px dashed rgba(50,43,28,.45);font:700 10px/1.35 'Courier Prime',monospace;letter-spacing:.05em}
.award-routing-sheet,.command-award-sheet{position:relative;margin:18px 0;padding:22px;background:rgba(250,245,228,.72);border:1px solid rgba(60,50,32,.35);box-shadow:0 8px 16px rgba(0,0,0,.13)}
.award-routing-sheet:nth-of-type(even),.command-award-sheet:nth-of-type(even){transform:rotate(.18deg)}
.award-routing-heading{border-bottom:2px solid rgba(55,46,29,.5);padding-bottom:9px;margin-bottom:7px}.award-routing-heading b,.award-routing-heading small{display:block}.award-routing-heading small{margin-top:4px;font-size:.72rem}
.command-award-board{padding:0 5vw 60px}.routing-note{padding:9px 12px;border-left:4px solid rgba(60,50,32,.5);background:rgba(255,255,255,.25)}
.danger-action{border-color:#6e2922!important}.nco-award-recommendation-paper{grid-column:1/-1}.nco-recommendation-history{margin-top:20px;border-top:2px solid rgba(50,43,28,.35);padding-top:14px}.muted-link{opacity:.7;cursor:default}
@media(max-width:760px){.s1-award-control,.command-award-board .document-sheet{padding:18px}.command-award-board{padding:0 14px 40px}.award-routing-sheet,.command-award-sheet{padding:15px;transform:none!important}}


/* --------------------------------------------------------------------------
   PUBLIC WHY JOIN — BATTALION COMMANDER'S FIELD JOURNAL
   Vietnam jungle field-notebook treatment; deliberately avoids modern cards.
   -------------------------------------------------------------------------- */
.page-why-join main{background:#20261d}
.commander-jungle{position:relative;min-height:100vh;padding:78px 5vw 110px;overflow:hidden;background:#1c2119}
.commander-jungle-photo{position:absolute;inset:0;background-image:url('/static/art/hq-canvas.webp');background-size:cover;background-position:center;filter:saturate(.72) brightness(.65) contrast(1.08);transform:scale(1.025)}
.commander-jungle-photo:after{content:"";position:absolute;inset:0;background-image:url('/static/art/hq-field-desk.webp');background-size:cover;background-position:center;mix-blend-mode:soft-light;opacity:.22}
.commander-jungle-shade{position:absolute;inset:0;background:radial-gradient(circle at 50% 20%,rgba(38,45,29,.08),rgba(12,15,10,.72) 74%),linear-gradient(180deg,rgba(17,22,14,.36),rgba(8,10,7,.74))}
.commander-journal-wrap{position:relative;z-index:2;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:minmax(0,920px) minmax(250px,1fr);gap:34px;align-items:start}
.journal-field-mark{grid-column:1/-1;color:#d7cfad;font:700 12px/1.3 'Courier Prime',monospace;letter-spacing:.14em;text-shadow:0 2px 8px #000;padding-left:22px}
.soldier-journal{position:relative;padding:66px 72px 72px 88px;color:#28271f;background:linear-gradient(90deg,rgba(113,94,57,.14),transparent 8%),repeating-linear-gradient(180deg,transparent 0 30px,rgba(77,91,76,.12) 30px 31px),linear-gradient(180deg,#d8cfad,#c8bd98);box-shadow:0 30px 70px rgba(0,0,0,.55),inset 0 0 48px rgba(85,67,35,.18);transform:rotate(-.25deg);border-radius:2px}
.soldier-journal:before{content:"";position:absolute;inset:9px;border:1px solid rgba(70,58,34,.25);pointer-events:none}
.soldier-journal:after{content:"FIELD JOURNAL • PERSONAL";position:absolute;right:34px;top:26px;font:700 9px 'Courier Prime',monospace;letter-spacing:.14em;color:rgba(66,57,38,.58);transform:rotate(1deg)}
.journal-binding{position:absolute;left:28px;top:48px;bottom:45px;width:26px;border-right:2px solid rgba(77,61,38,.34)}
.journal-binding i{display:block;width:13px;height:13px;border:2px solid rgba(56,49,36,.52);border-radius:50%;margin:48px 0;background:#b8aa85;box-shadow:inset 0 1px 3px rgba(0,0,0,.3)}
.journal-heading small,.journal-heading span{display:block;font:700 11px/1.45 'Courier Prime',monospace;letter-spacing:.1em;color:#514a38}
.journal-heading h1{max-width:760px;margin:12px 0 12px;font:700 clamp(34px,4.4vw,62px)/.98 'Courier Prime',monospace;letter-spacing:-.04em;color:#242319;text-transform:none}
.journal-heading span{font-style:italic;text-transform:none;letter-spacing:.03em}
.journal-rule{width:100%;height:1px;margin:26px 0 28px;background:rgba(61,53,38,.38)}
.journal-message{font:400 16px/1.78 'Courier Prime',monospace;color:#29271f}
.journal-message p{margin:0 0 21px}
.journal-message strong{font-weight:700;color:#1f2118}
.journal-signature{margin-top:42px;padding-top:18px;border-top:1px solid rgba(61,53,38,.33);max-width:390px;transform:rotate(-.5deg)}
.journal-signature>*{display:block}.journal-signature span{font:italic 15px 'Courier Prime',monospace}.journal-signature strong{margin:12px 0 2px;font:700 22px 'Courier Prime',monospace}.journal-signature small{font:700 10px 'Courier Prime',monospace;letter-spacing:.08em}
.journal-stamp{position:absolute;right:46px;bottom:44px;border:3px double rgba(69,81,54,.7);color:rgba(58,75,46,.75);padding:10px 15px;font:700 12px/1.05 'Stardos Stencil',serif;text-align:center;transform:rotate(-7deg);mix-blend-mode:multiply}
.journal-side-note{position:sticky;top:120px;margin-top:86px;padding:28px 25px;background:linear-gradient(180deg,#b79e65,#a98d53);color:#252217;box-shadow:0 18px 38px rgba(0,0,0,.45);transform:rotate(1.2deg);font-family:'Courier Prime',monospace}
.journal-side-note:before{content:"";position:absolute;left:50%;top:-10px;width:78px;height:22px;background:rgba(199,183,142,.82);transform:translateX(-50%) rotate(-2deg);box-shadow:0 2px 4px rgba(0,0,0,.2)}
.journal-side-note span{font-size:10px;font-weight:700;letter-spacing:.12em}.journal-side-note strong{display:block;font-size:23px;line-height:1.05;margin:10px 0 14px}.journal-side-note p{font-size:13px;line-height:1.55;margin:0 0 20px}.journal-side-note .paper-action{width:100%;justify-content:center}
@media(max-width:980px){.commander-journal-wrap{grid-template-columns:1fr}.journal-side-note{position:relative;top:auto;margin:0 auto;width:min(560px,100%);transform:rotate(.5deg)}.soldier-journal{padding:58px 54px 62px 74px}}
@media(max-width:640px){.commander-jungle{padding:48px 14px 76px}.journal-field-mark{padding-left:6px}.soldier-journal{padding:50px 24px 58px 48px;transform:none}.journal-binding{left:16px}.journal-binding i{width:10px;height:10px}.journal-heading h1{font-size:35px}.journal-message{font-size:14px;line-height:1.68}.journal-stamp{position:relative;right:auto;bottom:auto;display:inline-block;margin-top:24px}.journal-side-note{padding:24px 20px}}

/* PUBLIC RECRUITING HUB — front gate / replacement arrival experience */
.public-recruiting-hub{background:#292d24}
.public-recruiting-hub .public-arrival{min-height:760px}
.public-recruiting-hub .public-hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px}
.public-intro-strip{display:grid;grid-template-columns:repeat(6,1fr);background:#252a22;border-top:1px solid rgba(220,201,151,.24);border-bottom:1px solid rgba(220,201,151,.24);padding:18px 5vw;gap:8px;color:#e3d6b4}
.public-intro-strip div{padding:9px 13px;border-left:1px solid rgba(227,214,180,.22)}.public-intro-strip span{font-family:'Stardos Stencil',serif;font-size:22px;display:block;color:#b79b5e}.public-intro-strip b{font-size:11px;letter-spacing:.09em;display:block}.public-intro-strip small{font-size:9px;opacity:.72}
.public-story-section{position:relative;min-height:520px;padding:86px 7vw;display:flex;align-items:center;overflow:hidden}.public-field-backdrop{position:absolute;inset:0;background:linear-gradient(90deg,rgba(25,30,22,.86),rgba(25,30,22,.38)),url('/static/art/hq-field-desk.webp') center/cover no-repeat;filter:saturate(.72) contrast(1.02)}.public-journal-card{position:relative;z-index:2;width:min(680px,92vw);padding:44px;transform:rotate(-.7deg);background:linear-gradient(180deg,#ddd1ae,#cbbd96);box-shadow:0 24px 50px rgba(0,0,0,.45)}.public-journal-card>p:first-of-type{font-size:21px;font-style:italic;line-height:1.5;border-left:4px solid #55452f;padding-left:18px}
.public-station-section,.replacement-preview,.public-life-section{padding:88px 5vw;background:#34392d}.public-station-section .section-file-heading,.replacement-preview .section-file-heading,.public-life-section .section-file-heading{max-width:980px;margin:0 auto 44px;color:#eee4cb}.public-artifact-grid{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);gap:28px}.public-artifact{padding:34px 36px;min-height:225px;position:relative}.public-artifact:nth-child(odd){transform:rotate(-.45deg)}.public-artifact:nth-child(even){transform:rotate(.55deg)}.public-artifact h3{font-size:24px;margin:9px 0 12px}.public-artifact p{font-size:14px;line-height:1.65}.public-artifact>b{display:inline-block;margin-top:16px;border:2px solid rgba(65,59,43,.55);padding:6px 9px;font-size:10px;transform:rotate(-1deg)}
.empty-file-section{padding:100px 7vw;background:linear-gradient(rgba(42,47,36,.9),rgba(42,47,36,.94)),url('/static/art/hq-canvas.webp') center/cover no-repeat;display:grid;grid-template-columns:minmax(340px,600px) minmax(320px,620px);gap:70px;align-items:center}.empty-file-folder{background:#b99559;padding:42px 25px 26px;position:relative;box-shadow:0 28px 48px rgba(0,0,0,.38);transform:rotate(-1deg)}.empty-file-folder>.manila-tab{top:-32px;left:18px}.empty-file-paper{padding:36px;position:relative;min-height:410px}.empty-file-lines{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:22px}.empty-file-lines span{display:flex;justify-content:space-between;padding:10px 8px;border-bottom:1px dotted #756c57;font-size:11px}.empty-file-copy{color:#eadfbe}.empty-file-copy>span{font-size:11px;letter-spacing:.15em}.empty-file-copy h2{font-family:'Stardos Stencil',serif;font-size:clamp(34px,4vw,60px);line-height:1.02;margin:12px 0 30px}.tour-timeline{border-left:2px solid #9e8751;padding-left:26px}.tour-timeline article{position:relative;padding:0 0 23px}.tour-timeline article:before{content:"";position:absolute;left:-32px;top:3px;width:10px;height:10px;border-radius:50%;background:#c5ac72;border:2px solid #34392d}.tour-timeline b{font-size:12px;letter-spacing:.1em}.tour-timeline p{font-size:13px;line-height:1.55;margin:5px 0}
.replacement-preview{background:#2d3329}.replacement-training-preview{max-width:1100px;margin:0 auto;padding:42px;transform:rotate(.25deg)}.replacement-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:24px 0}.replacement-check-grid span{display:grid;grid-template-columns:42px 1fr;grid-template-rows:auto auto;padding:14px;border-bottom:1px dotted #82765d}.replacement-check-grid i{grid-row:1/3;font-style:normal;font-weight:700;font-size:21px;color:#6e5c3c}.replacement-check-grid b{font-size:12px}.replacement-check-grid small{font-size:10px}
.public-issue-showcase{padding-top:90px;padding-bottom:100px}.not-discord-section{padding:90px 7vw;background:#20251e;display:grid;grid-template-columns:1.15fr .85fr;gap:60px;align-items:center}.not-discord-copy{color:#e7ddc2}.not-discord-copy>span{font-size:11px;letter-spacing:.14em;color:#bba266}.not-discord-copy h2{font-family:'Stardos Stencil',serif;font-size:clamp(38px,5vw,68px);line-height:1;margin:12px 0 18px}.not-discord-copy p{max-width:760px;line-height:1.7}.not-discord-paper{padding:40px;transform:rotate(1.2deg);position:relative}.not-discord-paper>strong{display:block;font-size:25px;margin:9px 0 14px}.not-discord-paper>small{letter-spacing:.12em}.public-life-grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.public-life-grid article{background:#c8b17c;padding:30px;box-shadow:0 16px 28px rgba(0,0,0,.25);transform:rotate(-.4deg)}.public-life-grid article:nth-child(2){transform:rotate(.6deg);background:#d4c49d}.public-life-grid article:nth-child(3){transform:rotate(-.15deg)}.public-life-grid small{font-size:10px;letter-spacing:.12em}.public-life-grid h3{font-size:20px;margin:9px 0}.public-life-grid p{font-size:12px;line-height:1.6}
.public-final-call{padding:64px 6vw;background:#1d211b;color:#e7ddc2;display:grid;grid-template-columns:110px 1fr auto;gap:32px;align-items:center;border-top:1px solid rgba(221,204,159,.2)}.public-final-call img{width:100px;max-height:110px;object-fit:contain}.public-final-call span{font-size:10px;letter-spacing:.14em}.public-final-call h2{font-family:'Stardos Stencil',serif;font-size:34px;margin:6px 0}.public-final-call p{font-size:12px;max-width:700px}.final-call-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end}.footer-staff-access{position:absolute;right:3vw;bottom:8px;font-size:8px;letter-spacing:.09em;color:rgba(235,223,190,.42);text-decoration:none}.battalion-footer{position:relative}
.about-field-hero{min-height:520px;padding:95px 7vw;display:flex;align-items:center;position:relative;background:url('/static/art/homepage-background.webp') center/cover no-repeat}.about-field-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(25,29,22,.86),rgba(25,29,22,.36))}.about-field-board{position:relative;z-index:2;width:min(700px,92vw);padding:44px;transform:rotate(-.6deg)}.about-field-board h1{font-family:'Stardos Stencil',serif;font-size:46px;margin:18px 0}.about-field-board p{line-height:1.7}.about-public-body{padding:80px 6vw;background:#34392d;display:grid;grid-template-columns:repeat(2,1fr);gap:26px}.about-public-body article{padding:34px;transform:rotate(-.3deg)}.about-public-body article:nth-child(even){transform:rotate(.4deg)}.about-public-body article header{border-bottom:2px solid #49412f;padding-bottom:10px;margin-bottom:15px}.about-public-body article header>*{display:block}.about-public-body p{line-height:1.7}.compact-public-call{grid-template-columns:90px 1fr auto}
@media(max-width:980px){.public-intro-strip{grid-template-columns:repeat(3,1fr)}.public-artifact-grid,.about-public-body{grid-template-columns:1fr}.empty-file-section,.not-discord-section{grid-template-columns:1fr}.public-life-grid{grid-template-columns:1fr}.public-final-call{grid-template-columns:80px 1fr}.public-final-call .final-call-actions,.public-final-call>.paper-action{grid-column:1/-1;justify-content:flex-start}.replacement-check-grid{grid-template-columns:1fr}}
@media(max-width:720px){.public-recruiting-hub .public-arrival{min-height:700px}.public-intro-strip{grid-template-columns:1fr 1fr;padding:16px}.public-story-section,.public-station-section,.replacement-preview,.public-life-section,.empty-file-section,.not-discord-section{padding:58px 18px}.public-journal-card,.replacement-training-preview{padding:27px 22px}.public-artifact-grid{gap:18px}.public-artifact{padding:27px 22px}.empty-file-paper{padding:26px 20px}.empty-file-lines{grid-template-columns:1fr}.public-final-call{padding:45px 18px;grid-template-columns:64px 1fr;gap:18px}.public-final-call img{width:62px}.public-final-call h2{font-size:27px}.about-field-hero{padding:80px 18px}.about-field-board{padding:28px 22px}.about-field-board h1{font-size:36px}.about-public-body{padding:55px 18px}}

/* OFFICIAL PERSONNEL ORDERS / CLICKABLE 201 DOCUMENT FILE */
.document-thumbnail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:18px;margin-top:16px}.document-thumbnail{display:flex;flex-direction:column;gap:5px;color:#211e16;text-decoration:none;background:#d9c99f;padding:9px 9px 14px;box-shadow:0 8px 18px rgba(0,0,0,.22);transform:rotate(-.5deg);transition:transform .16s ease}.document-thumbnail:nth-child(even){transform:rotate(.7deg)}.document-thumbnail:hover{transform:translateY(-4px) rotate(0)}.document-thumbnail img{width:100%;aspect-ratio:9/11.6;object-fit:cover;border:1px solid rgba(55,48,35,.35)}.document-thumbnail span,.document-thumbnail small{font:700 10px/1.3 monospace;letter-spacing:.05em}.document-thumbnail b{font:700 12px/1.25 monospace}.official-order-room{min-height:100vh;padding:72px 18px;background:linear-gradient(rgba(24,31,22,.72),rgba(22,28,18,.82)),url('/static/art/hq-canvas.webp') center/cover fixed}.official-order-sheet{position:relative;max-width:850px;margin:auto;padding:72px 72px 100px;background:linear-gradient(180deg,#eee5ca,#ded2ad);color:#211e16;box-shadow:0 26px 55px rgba(0,0,0,.5);font-family:monospace}.official-order-letterhead{text-align:center;border-bottom:2px solid #3b3529;padding-bottom:18px}.official-order-letterhead>*{display:block}.official-order-letterhead strong{font-size:20px}.official-order-meta{display:flex;justify-content:space-between;margin:28px 0;font-weight:700}.official-order-sheet h1{text-align:center;font-size:25px;margin:34px 0}.official-order-person{display:grid;grid-template-columns:140px 1fr;margin:24px 0}.official-order-person dt,.official-order-person dd{margin:0;padding:7px;border-bottom:1px dotted #6f654d}.official-order-body{font-size:15px;line-height:1.8;text-align:justify;white-space:pre-line}.official-order-authority{margin-top:64px;font-weight:800}.official-order-filed{position:absolute;right:70px;bottom:54px;border:3px solid #6d2d25;color:#6d2d25;padding:8px 16px;transform:rotate(-8deg);font-weight:900;text-align:center}@media(max-width:720px){.official-order-sheet{padding:42px 24px 80px}.official-order-person{grid-template-columns:1fr}.official-order-person dt{border-bottom:0;padding-bottom:0}.document-thumbnail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* VIETNAM ORDERS TEMPLATE — LIVE PERSONNEL DATA OVERLAY */
.vietnam-order-document{position:relative;width:min(1500px,96vw);margin:0 auto;aspect-ratio:3/2;filter:drop-shadow(0 24px 30px rgba(0,0,0,.45));font-family:"Courier New",monospace;color:#231f18}
.vietnam-order-template{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block}
.order-overlay{position:absolute;z-index:3;font-family:"Courier New",monospace;font-weight:700;font-size:clamp(8px,1.02vw,16px);line-height:1;white-space:nowrap;text-shadow:0 .4px rgba(255,255,255,.2)}
.order-number{left:13.6%;top:28.3%;min-width:9%;background:#d7bf93;padding:2px 5px;transform:rotate(-.2deg)}
.order-date{left:36.7%;top:28.15%;background:#d7bf93;padding:2px 7px}
.order-grade{left:12.0%;top:42.0%;background:#d7bf93;padding:2px 6px}
.order-mos{left:19.5%;top:42.0%;background:#d7bf93;padding:2px 6px}
.order-name{left:29.2%;top:42.0%;width:15.5%;text-align:center;background:#d7bf93;padding:2px 4px}
.order-roster{left:42.2%;top:42.0%;background:#d7bf93;padding:2px 6px}
.right-order-number{left:61.0%;top:20.0%;background:#d8c39a;padding:2px 5px}
.right-order-date{left:77.0%;top:23.2%;background:#d8c39a;padding:2px 6px}
.right-grade{left:58.2%;top:39.1%;background:#d8c39a;padding:2px 5px}
.right-mos{left:63.0%;top:39.1%;background:#d8c39a;padding:2px 5px}
.right-name{left:70.2%;top:39.1%;width:11.4%;text-align:center;background:#d8c39a;padding:2px 4px}
.right-roster{left:82.0%;top:39.1%;background:#d8c39a;padding:2px 5px}
.routing-date{left:75.1%;top:75.9%;background:#cdb78b;padding:2px 5px;transform:rotate(4deg)}
.order-record-caption{max-width:1040px;margin:30px auto;padding:28px 34px;transform:rotate(-.25deg)}
.order-record-caption dl{display:grid;grid-template-columns:210px 1fr;margin:18px 0 0}.order-record-caption dt,.order-record-caption dd{margin:0;padding:7px;border-bottom:1px dotted #7e725b;font-size:11px}
@media(max-width:720px){.vietnam-order-document{width:100vw;margin-left:calc(50% - 50vw)}.order-overlay{font-size:5.5px}.order-record-caption{margin:18px 12px;padding:22px 18px}.order-record-caption dl{grid-template-columns:1fr}.order-record-caption dt{border-bottom:0;padding-bottom:0}.order-record-caption dd{padding-top:1px}}

/* Integrated battalion workflow / Soldier action system */
.member-action-board{max-width:1360px;margin:34px auto 0;padding:28px;background:linear-gradient(180deg,#e7dec8,#d5c7a5);box-shadow:0 18px 34px rgba(0,0,0,.25)}
.member-action-line{display:grid;grid-template-columns:120px 1fr 180px;gap:14px;padding:10px 4px;border-bottom:1px dashed rgba(45,38,24,.35);font-family:var(--type-font)}
.member-action-line small{text-align:right}.actions-workspace{grid-template-columns:1fr;max-width:1500px}.action-ledger-row{display:grid;grid-template-columns:minmax(260px,1fr) 140px 150px 150px minmax(180px,.7fr) 90px;gap:8px;align-items:center;padding:12px 0;border-bottom:1px dashed rgba(45,38,24,.35)}.action-ledger-row>div:first-child{display:grid}.action-ledger-row small,.action-ledger-row span{font-size:.72rem}.action-status{font-weight:700}.command-action-overview{max-width:1420px;margin:28px auto;display:grid;grid-template-columns:1.1fr .9fr;gap:24px}.mos-member-paper{transform:rotate(.2deg)}
@media(max-width:900px){.action-ledger-row{grid-template-columns:1fr}.member-action-line{grid-template-columns:1fr}.member-action-line small{text-align:left}.command-action-overview{grid-template-columns:1fr}}

/* FULL FLOW — lifecycle, notification, control, and staff workflow additions */
.notification-line{display:grid;grid-template-columns:120px minmax(0,1fr) minmax(180px,.75fr) auto;align-items:center;gap:10px}.notice-ack{font:700 10px 'Courier Prime',monospace;letter-spacing:.05em;background:#d8cfb4;border:1px solid #645d4d;padding:7px 9px;cursor:pointer}.notice-ack:hover{transform:translateY(-1px)}
.battalion-control-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.battalion-control-grid .document-sheet{min-width:0}.page-battalion-control .brief-strength{grid-template-columns:repeat(3,1fr)}
.s3-board,.s4-board{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:24px}.s4-board{grid-template-columns:1fr}.s3-board .action-ledger-row,.s4-board .action-ledger-row{grid-template-columns:minmax(240px,2fr) repeat(4,auto);align-items:center}.s4-board .action-ledger-row{grid-template-columns:minmax(240px,2fr) 180px 150px minmax(160px,1fr) auto}.inspection-line{border:2px solid rgba(82,74,52,.35);padding:8px 10px;margin:6px 0 12px}.lifecycle-control-sheet{background:linear-gradient(180deg,#ded6bf,#cbbf9f)}
@media(max-width:980px){.battalion-control-grid,.s3-board{grid-template-columns:1fr}.notification-line,.s3-board .action-ledger-row,.s4-board .action-ledger-row{grid-template-columns:1fr}.page-battalion-control .brief-strength{grid-template-columns:repeat(2,1fr)}}

/* DEEP BATTALION IMMERSION / FLOW PACK */
.field-desk-launcher,.member-current-story{max-width:1360px;margin:24px auto;padding:18px}.field-desk-shortcuts{display:flex;flex-wrap:wrap;gap:10px}.field-desk-shortcuts a{display:inline-block;padding:10px 14px;background:#d7c59b;border:1px solid #6e6047;box-shadow:2px 3px 6px rgba(0,0,0,.22);transform:rotate(-.4deg);font-family:var(--font-typewriter);font-size:.74rem;letter-spacing:.05em;color:#2d281f;text-decoration:none}.field-desk-shortcuts a:nth-child(even){transform:rotate(.5deg)}.field-desk-shortcuts a:hover{transform:translateY(-2px) rotate(0)}
.staff-workload-strip{max-width:1360px;margin:18px auto;padding:13px 18px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;font-family:var(--font-typewriter)}.staff-workload-strip span{font-weight:700;margin-right:auto}.staff-workload-strip .attention,.overdue-action b{color:#7b1f18}.document-status-stamp{position:absolute;right:22px;top:20px;border:3px double #7b1f18;color:#7b1f18;padding:6px 12px;font-weight:800;letter-spacing:.12em;transform:rotate(-4deg);z-index:6;background:rgba(238,224,190,.55)}.official-order-sheet{position:relative}
.tour-book-room{min-height:100vh;padding:80px 5vw;background:linear-gradient(rgba(16,23,15,.72),rgba(16,23,15,.8)),url('/static/art/hq-canvas.webp') center/cover fixed}.tour-book-journal{max-width:1180px;margin:auto;background:#bda875;padding:38px;border:10px solid #5c4930;box-shadow:0 28px 60px rgba(0,0,0,.5)}.tour-book-journal>header{border-bottom:2px solid rgba(51,42,29,.5);margin-bottom:24px}.tour-book-journal>header h1{font-family:var(--font-typewriter);font-size:clamp(2rem,5vw,4rem);margin:.2em 0}.tour-book-entries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.tour-book-entry{padding:22px;transform:rotate(-.4deg)}.tour-book-entry:nth-child(even){transform:rotate(.5deg)}.tour-book-entry time,.tour-book-entry small{display:block;font-family:var(--font-typewriter);font-size:.7rem}.current-story-card{padding:22px;margin-bottom:24px}.current-story-card dl{display:grid;grid-template-columns:180px 1fr;gap:6px}
.billet-row{display:grid;grid-template-columns:160px 1fr 320px;gap:12px;padding:10px 0;border-bottom:1px dashed rgba(50,42,30,.35);font-family:var(--font-typewriter)}.public-mos-needs{padding:80px 5vw;background:#2a3026}.public-mos-needs .section-file-heading{color:#eee4cd}.member-current-story{background:linear-gradient(180deg,#ded3b9,#cfc09a)}.member-current-story dl{display:grid;grid-template-columns:180px 1fr;gap:4px}.member-current-story dt,.member-current-story dd{padding:7px;border-bottom:1px dotted #84775c;margin:0}.mos-proficiency-paper,.leadership-paper,.recognition-paper,.tour-book-preview-paper{position:relative}.page-operation-duty .staff-workspace{max-width:1380px;margin:auto}.page-operation-duty .brief-strength{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.page-weapon-history .staff-workspace{max-width:1200px;margin:70px auto}.page-my-unit .staff-workspace{max-width:1050px;margin:70px auto}
@media(max-width:760px){.tour-book-entries{grid-template-columns:1fr}.billet-row{grid-template-columns:1fr}.member-current-story dl,.current-story-card dl{grid-template-columns:1fr}.page-operation-duty .brief-strength{grid-template-columns:1fr 1fr}.field-desk-shortcuts a{flex:1 1 42%;text-align:center}}

/* Public staff login tab — separate gateway from My Soldier Record */
.record-index .staff-login-tab{
  border-left:1px solid rgba(231,218,176,.28);
  margin-left:2px;
  padding-left:14px;
}
.record-index .staff-login-tab:before{content:"HQ";display:inline-block;margin-right:6px;font-size:.62em;letter-spacing:.12em;opacity:.72}
@media(max-width:900px){
  .record-index .staff-login-tab{border-left:0;margin-left:0;padding-left:inherit}
}

/* COMMAND HQ CLEAN WORKSPACE — readability and functional command flow */
.command-hq-redesign{background:#20251f;color:#1d1a12}
.command-hq-redesign main{background:#252b24}
.command-hq-hero{position:relative;min-height:390px;background:url('/static/art/hq-field-desk.webp') center 54%/cover no-repeat;overflow:hidden}
.command-hq-hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,16,12,.86),rgba(18,23,17,.54) 58%,rgba(12,15,11,.76)),linear-gradient(0deg,rgba(10,13,10,.7),transparent 58%)}
.command-hq-title{position:absolute;left:max(32px,6vw);bottom:58px;z-index:2;width:min(850px,86vw);color:#eee5cf;text-shadow:0 3px 8px rgba(0,0,0,.72)}
.command-hq-title small{font-size:12px;letter-spacing:.14em;color:#c8af65;font-weight:700}
.command-hq-title h1{font-family:'Stardos Stencil',serif;font-size:clamp(48px,6vw,82px);line-height:.94;margin:10px 0 14px;letter-spacing:-.035em}
.command-hq-title p{font-family:'Courier Prime',monospace;font-size:16px;line-height:1.55;max-width:760px;margin:0;color:#e4dbc5}
.command-desk-shell{width:min(1500px,94vw);margin:0 auto;padding:38px 0 90px}
.command-desk-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;color:#eee6cf;margin:0 0 20px;padding:0 5px 16px;border-bottom:1px solid rgba(217,198,143,.34)}
.command-desk-heading small{font-size:11px;letter-spacing:.16em;color:#c6ad68}.command-desk-heading h2{font-size:30px;margin:4px 0 0;letter-spacing:.03em}.command-desk-heading>span{font-size:12px;border:1px solid #9e874f;padding:8px 12px;color:#d9c78f;background:rgba(0,0,0,.16)}
.command-desk-shortcuts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-bottom:22px}
.command-desk-shortcuts a{display:flex;flex-direction:column;min-height:94px;justify-content:center;padding:17px 19px;text-decoration:none;color:#eee6cf;background:linear-gradient(180deg,#394035,#2b3029);border:1px solid rgba(211,190,128,.38);box-shadow:0 7px 16px rgba(0,0,0,.2);transition:transform .14s ease,border-color .14s ease,background .14s ease}
.command-desk-shortcuts a:hover{transform:translateY(-2px);border-color:#cdb16a;background:linear-gradient(180deg,#424a3b,#30362d)}
.command-desk-shortcuts b{font-family:'Stardos Stencil',serif;font-size:16px;letter-spacing:.055em}.command-desk-shortcuts span{font-size:12px;line-height:1.4;color:#cfc8b5;margin-top:5px}
.command-status-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin:0 0 24px}
.command-status-card{background:#ded4bb;padding:17px 16px;border-top:4px solid #59634f;box-shadow:0 8px 15px rgba(0,0,0,.16);min-height:120px}.command-status-card.warning{border-color:#8a6e33}.command-status-card.attention{border-color:#7d3028}
.command-status-card small{display:block;font-size:10px;font-weight:700;letter-spacing:.075em;line-height:1.25}.command-status-card strong{display:block;font-family:'Stardos Stencil',serif;font-size:34px;line-height:1;margin:10px 0 7px}.command-status-card span{font-size:11px;color:#544d3b}
.command-main-grid{display:grid;grid-template-columns:1.55fr .85fr;gap:20px;margin-bottom:20px}.command-secondary-grid{grid-template-columns:1fr 1fr}
.command-panel{padding:30px 32px!important;background:linear-gradient(180deg,#e4dbc4,#d8cdb0)!important;color:#211d13;box-shadow:0 12px 25px rgba(0,0,0,.22)!important;transform:none!important;max-width:none!important;margin:0!important}
.command-panel-header{border-bottom:2px solid rgba(45,38,23,.65);padding-bottom:12px;margin-bottom:18px}.command-panel-header small{font-size:10px;letter-spacing:.12em;font-weight:700}.command-panel-header h2{font-size:22px;margin:4px 0 0;letter-spacing:.035em}.command-panel-header p{font-size:12px;margin:6px 0 0;color:#544b37}
.command-ledger-row{display:grid;grid-template-columns:minmax(0,1fr) 130px 120px;gap:14px;align-items:center;padding:13px 4px;border-bottom:1px dashed rgba(54,46,29,.35);font-size:13px}.command-ledger-row>div{display:grid;gap:3px}.command-ledger-row b{font-size:13px}.command-ledger-row span{font-size:12px;color:#4f4735}.command-ledger-row strong{font-size:11px;letter-spacing:.05em}.command-ledger-row time{font-size:11px;text-align:right}
.command-section-row{display:grid;grid-template-columns:90px 1fr 150px;align-items:center;gap:12px;text-decoration:none;color:#211d13;padding:14px 5px;border-bottom:1px dashed rgba(54,46,29,.35);font-size:13px}.command-section-row:hover{background:rgba(255,255,255,.18)}.command-section-row span{font-family:'Stardos Stencil',serif;font-size:16px}.command-section-row b{font-size:12px}.command-section-row small{text-align:right;font-size:10px}
.command-text-link{display:inline-block;margin-top:18px;font-size:11px;font-weight:700;color:#3f4b36;text-decoration:none;border-bottom:1px solid currentColor}.command-empty{font-size:13px;line-height:1.5;color:#5e5541;padding:12px 0}
.command-form{display:grid;gap:14px}.command-form label,.command-award-sheet-clean label{display:grid;gap:6px;font-size:10px;font-weight:700;letter-spacing:.07em}.command-form input,.command-form select,.command-form textarea,.command-award-sheet-clean input,.command-award-sheet-clean select,.command-award-sheet-clean textarea{width:100%;box-sizing:border-box;background:#f4eddb;border:1px solid #85785b;padding:11px 12px;font:14px/1.35 'Courier Prime',monospace;color:#211d13;min-height:42px}.command-form textarea,.command-award-sheet-clean textarea{resize:vertical}.command-form-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.command-form button,.command-decision-row button{border:1px solid #4f573f;background:#424b39;color:#f0e7d0;padding:12px 16px;font:700 12px 'Courier Prime',monospace;letter-spacing:.055em;cursor:pointer}.command-form button:hover,.command-decision-row button:hover{filter:brightness(1.1)}
.command-change-panel{margin-bottom:20px!important}.command-change-form{grid-template-columns:repeat(4,minmax(0,1fr));align-items:end}.command-change-form .command-form-wide{grid-column:span 2}.command-change-form button{grid-column:span 2;min-height:42px}
.command-award-board-clean{margin-top:20px}.command-award-sheet-clean{display:grid;gap:13px;padding:20px 0;border-top:1px solid rgba(55,47,30,.36)}.command-award-ident{display:flex;justify-content:space-between;gap:20px;align-items:end}.command-award-ident b{font-size:16px}.command-award-ident span{font-size:11px;color:#574e39;text-align:right}.command-routing-note{padding:10px 12px;background:rgba(255,255,255,.25);border-left:4px solid #796b48;font-size:12px}.command-decision-row{display:flex;gap:10px;flex-wrap:wrap}.command-decision-row .approve{background:#3f533b}.command-decision-row .deny{background:#693a32}
.page-hq .battalion-header{position:relative;z-index:20}.page-hq .record-index a{font-size:10px;padding:10px 12px}.page-hq .battalion-footer{margin-top:0}
@media(max-width:1100px){.command-status-grid{grid-template-columns:repeat(3,1fr)}.command-main-grid,.command-secondary-grid{grid-template-columns:1fr}.command-desk-shortcuts{grid-template-columns:repeat(2,1fr)}.command-change-form{grid-template-columns:1fr 1fr}.command-change-form .command-form-wide,.command-change-form button{grid-column:span 2}}
@media(max-width:700px){.command-hq-hero{min-height:330px}.command-hq-title{left:22px;bottom:38px;width:calc(100% - 44px)}.command-hq-title p{font-size:13px}.command-desk-shell{width:calc(100% - 28px);padding-top:25px}.command-desk-heading{align-items:start;flex-direction:column}.command-desk-shortcuts,.command-status-grid,.command-form-two,.command-change-form{grid-template-columns:1fr}.command-status-grid{grid-template-columns:1fr 1fr}.command-panel{padding:22px 18px!important}.command-ledger-row,.command-section-row{grid-template-columns:1fr}.command-ledger-row time,.command-section-row small{text-align:left}.command-change-form .command-form-wide,.command-change-form button{grid-column:auto}.command-award-ident{display:grid}.command-award-ident span{text-align:left}}

/* ==========================================================================
   COMMAND GLOBAL WORKSPACE — unified HQ presentation on every command page
   ========================================================================== */
.command-global-view{background:#252b24;color:#eee5cf}
.command-global-view main{min-height:72vh;background:
  linear-gradient(rgba(24,30,24,.94),rgba(26,32,25,.97)),
  url('/static/art/hq-canvas.webp') center/cover fixed;padding-bottom:72px}
.command-global-view .battalion-header{box-shadow:0 5px 18px rgba(0,0,0,.28)}
.command-global-bar{position:relative;z-index:18;background:#171c17;border-top:1px solid rgba(205,177,106,.22);border-bottom:1px solid rgba(205,177,106,.45);box-shadow:0 7px 18px rgba(0,0,0,.28)}
.command-global-bar-inner{width:min(1500px,94vw);min-height:62px;margin:auto;display:flex;align-items:center;gap:7px;overflow-x:auto;padding:7px 0}
.command-global-label{display:grid;min-width:180px;margin-right:10px;padding-right:16px;border-right:1px solid rgba(205,177,106,.28);line-height:1.12}
.command-global-label small{font:700 9px 'Courier Prime',monospace;letter-spacing:.16em;color:#bda65f}.command-global-label b{font:700 14px 'Stardos Stencil',serif;color:#eee5cf;letter-spacing:.04em}
.command-global-bar a{flex:0 0 auto;padding:10px 13px;border:1px solid rgba(202,177,108,.3);background:#30372e;color:#e5dcc4;text-decoration:none;font:700 11px 'Courier Prime',monospace;letter-spacing:.06em;transition:.13s ease}
.command-global-bar a:hover{background:#424a3b;border-color:#cdb16a;color:#fff7df;transform:translateY(-1px)}

/* Universal command page frame. Existing page-specific visuals remain inside it. */
.command-global-view main>section:not(.command-hq-hero),
.command-global-view main>article,
.command-global-view main>.page-shell,
.command-global-view main>.workspace,
.command-global-view main>.office-shell,
.command-global-view main>.records-room{width:min(1500px,94vw);margin-left:auto;margin-right:auto}
.command-global-view main h1,.command-global-view main h2,.command-global-view main h3{line-height:1.08}
.command-global-view main h1{font-size:clamp(36px,4.5vw,64px)}
.command-global-view main h2{font-size:clamp(22px,2.4vw,32px)}
.command-global-view main p,.command-global-view main li,.command-global-view main dd,.command-global-view main td{font-size:max(13px,1em);line-height:1.55}

/* Turn old bright/flat staff panels into the HQ document treatment. */
.command-global-view .document-sheet,
.command-global-view .paper-panel,
.command-global-view .staff-panel,
.command-global-view .office-panel,
.command-global-view .ledger,
.command-global-view .admin-card,
.command-global-view .briefing-card,
.command-global-view .training-card-panel,
.command-global-view .supply-card,
.command-global-view .record-card,
.command-global-view .control-panel{background:linear-gradient(180deg,#e4dbc4,#d6caac)!important;color:#211d13!important;border:1px solid rgba(86,75,49,.42)!important;box-shadow:0 12px 25px rgba(0,0,0,.22)!important;transform:none!important}
.command-global-view .document-sheet header,
.command-global-view .paper-panel header,
.command-global-view .staff-panel header,
.command-global-view .office-panel header{border-color:rgba(45,38,23,.58)!important}

/* Readable command inputs/buttons everywhere. */
.command-global-view main label{font-size:11px;letter-spacing:.045em}
.command-global-view main input:not([type=checkbox]):not([type=radio]),
.command-global-view main select,
.command-global-view main textarea{font:14px/1.4 'Courier Prime',monospace!important;min-height:42px;padding:10px 12px!important;background:#f3ecd9!important;color:#211d13!important;border:1px solid #85785b!important;box-sizing:border-box}
.command-global-view main textarea{min-height:90px}
.command-global-view main button,
.command-global-view main .paper-action,
.command-global-view main .action-button,
.command-global-view main .staff-action{font:700 12px 'Courier Prime',monospace!important;letter-spacing:.05em;min-height:42px;padding:11px 15px!important;background:#424b39!important;color:#f0e7d0!important;border:1px solid #667054!important;box-shadow:none!important}
.command-global-view main button:hover,.command-global-view main .paper-action:hover,.command-global-view main .action-button:hover{filter:brightness(1.1)}

/* Tables and ledger rows become legible instead of tiny type. */
.command-global-view main table{width:100%;border-collapse:collapse;background:#ddd2b7;color:#211d13;box-shadow:0 9px 18px rgba(0,0,0,.17)}
.command-global-view main th{font-size:11px;letter-spacing:.07em;background:#c8ba96;color:#211d13;padding:11px 10px;text-align:left}
.command-global-view main td{padding:11px 10px;border-bottom:1px dashed rgba(55,46,28,.32)}
.command-global-view .entry-row,.command-global-view .action-ledger-row,.command-global-view .roster-row,.command-global-view .property-table{font-size:13px;line-height:1.4}
.command-global-view .entry-row small,.command-global-view .action-ledger-row small{font-size:11px}

/* Most staff pages historically start with a pale banner; normalize it for command. */
.command-global-view main>section>header:first-child:not(.army-letterhead),
.command-global-view main>header:first-child{background:linear-gradient(180deg,#343b32,#282e27)!important;color:#eee5cf!important;border:1px solid rgba(205,177,106,.38)!important;box-shadow:0 10px 22px rgba(0,0,0,.2)!important;padding:24px 28px!important;margin-bottom:20px!important}
.command-global-view main>section>header:first-child small,
.command-global-view main>header:first-child small{color:#cbb36c!important;letter-spacing:.14em}

/* Preserve the actual 201/official-paper identity while improving its surrounding command view. */
.command-global-view.page-201 .file-cabinet-room,
.command-global-view .tour-book-room{width:100%!important;max-width:none!important;margin:0!important}
.command-global-view.page-201 main,.command-global-view .tour-book-room{background-color:#252b24}
.command-global-view .manila-file{font-size:1.03rem}

.command-global-view .battalion-footer{background:#171c17;border-top-color:rgba(205,177,106,.35)}
@media(max-width:850px){.command-global-bar-inner{width:calc(100% - 24px)}.command-global-label{min-width:150px}.command-global-view main>section:not(.command-hq-hero),.command-global-view main>article,.command-global-view main>.page-shell,.command-global-view main>.workspace,.command-global-view main>.office-shell,.command-global-view main>.records-room{width:calc(100% - 24px)}.command-global-view main h1{font-size:36px}}

/* COMMAND DUPLICATE PERSONNEL DELETE CONTROL */
.command-danger-zone{border:2px solid rgba(132,42,34,.78)!important;box-shadow:0 18px 40px rgba(0,0,0,.22),inset 0 0 0 1px rgba(120,34,28,.18)!important}
.command-danger-zone>header{border-bottom:2px solid rgba(132,42,34,.58)!important}
.command-danger-zone>p{font-size:14px;line-height:1.65;max-width:900px;margin:16px 0 20px;color:#30291f}
.danger-delete-form{background:rgba(112,34,28,.055);border:1px dashed rgba(112,34,28,.42);padding:18px}
.danger-delete-form input,.danger-delete-form select{font-size:15px!important;min-height:46px!important}
.danger-delete-button{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:58px;padding:12px 20px;border:2px solid #6f1f1a;background:linear-gradient(180deg,#9e362c,#741f1a);color:#fff7e7;font-family:inherit;font-weight:900;letter-spacing:.07em;cursor:pointer;box-shadow:0 5px 0 #48110e,0 10px 18px rgba(0,0,0,.24);text-transform:uppercase}
.danger-delete-button:hover{filter:brightness(1.08);transform:translateY(-1px)}
.danger-delete-button small{font-size:10px;letter-spacing:.12em;color:#ffd8c8}

/* ========================================================================
   MEMBER SOLDIER RECORD — CLEAN HQ WORKSPACE REDESIGN
   Aligns the member experience with the Command HQ usability pass while
   preserving the physical-record / Vietnam field-office character.
   ======================================================================== */
.member-record-redesign main{background:#252b24}
.member-record-redesign .member-record-hero-clean{min-height:330px;border-bottom:1px solid rgba(211,190,128,.28)}
.member-record-redesign .member-record-hero-photo{background-image:url('/static/art/hq-field-desk.webp');background-position:center 55%;filter:brightness(.58) saturate(.72)}
.member-record-redesign .member-record-hero-shade{background:linear-gradient(90deg,rgba(12,16,12,.88),rgba(18,23,17,.55) 60%,rgba(12,15,11,.78)),linear-gradient(0deg,rgba(10,13,10,.7),transparent 60%)}
.member-record-redesign .member-record-identity{left:max(28px,6vw);bottom:45px;width:min(920px,88vw)}
.member-record-redesign .member-record-identity h1{font-family:'Stardos Stencil',serif;font-size:clamp(45px,5.5vw,76px)}
.member-record-redesign .member-record-identity h2{font-size:22px;margin-top:12px}
.member-record-redesign .member-record-identity p{font-size:13px;line-height:1.5;color:#ddd4bd}
.member-record-redesign .member-status-stamp{background:#30372e;border-color:#c7ad69;color:#efe5cc;transform:none;font-size:11px}

.member-dashboard-shell{width:min(1500px,94vw);margin:0 auto;padding:34px 0 90px;display:grid;gap:24px}
.member-dashboard-card{position:relative;min-width:0;background:linear-gradient(180deg,#e5dcc5,#d8cdb0);color:#211d13;border:1px solid rgba(208,188,130,.18);box-shadow:0 12px 25px rgba(0,0,0,.2);padding:28px 30px;transform:none!important;min-height:0!important;max-width:none!important;margin:0!important}
.member-dashboard-card:before{display:none!important}
.member-dashboard-card>header{border-bottom:2px solid rgba(50,43,27,.62);padding-bottom:11px;margin-bottom:15px}
.member-dashboard-card>header small{display:block;font-size:10px;letter-spacing:.13em;font-weight:700;color:#5b5038}
.member-dashboard-card>header strong{display:block;font-family:'Stardos Stencil',serif;font-size:21px;line-height:1.12;letter-spacing:.04em;margin-top:4px}
.member-dashboard-header{display:flex;justify-content:space-between;align-items:end;gap:20px;border-bottom:2px solid rgba(50,43,27,.62);padding-bottom:12px;margin-bottom:18px}
.member-dashboard-header small{display:block;font-size:10px;letter-spacing:.14em;font-weight:700;color:#675a3d}.member-dashboard-header h2{font-size:25px;line-height:1;margin:5px 0 0}.member-dashboard-header>span{font-size:11px;letter-spacing:.07em;border:1px solid #7d6b42;padding:7px 10px;background:rgba(255,255,255,.16)}
.member-section-block{display:grid;gap:18px;scroll-margin-top:115px}
.member-section-title{color:#eee6d0;border-bottom:1px solid rgba(218,198,139,.35);padding:8px 5px 14px}.member-section-title small{font-size:10px;letter-spacing:.16em;color:#c4aa64;font-weight:700}.member-section-title h2{font-family:'Stardos Stencil',serif;font-size:28px;margin:5px 0 5px;letter-spacing:.035em}.member-section-title p{font-size:12px;color:#cbc5b3;margin:0;line-height:1.5}
.member-two-column{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:stretch}.overview-grid{grid-template-columns:.92fr 1.08fr}.equipment-grid{grid-template-columns:1.15fr .85fr}

.member-record-redesign .member-current-story{background:linear-gradient(180deg,#e2d7bd,#d4c6a3)}
.current-story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 18px}.current-story-grid>div{border:1px solid rgba(67,57,36,.28);background:rgba(255,255,255,.16);padding:13px 14px;min-height:78px}.current-story-grid small{display:block;font-size:9px;letter-spacing:.1em;font-weight:700;color:#61553b;margin-bottom:6px}.current-story-grid strong{font-size:12px;line-height:1.45}
.member-record-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.member-record-nav a{display:flex;flex-direction:column;justify-content:center;min-height:74px;text-decoration:none;color:#eee5cf;background:linear-gradient(180deg,#3b4237,#2c322b);border:1px solid rgba(203,181,115,.4);padding:12px 14px;transition:transform .14s ease,border-color .14s ease,background .14s ease}.member-record-nav a:hover{transform:translateY(-2px);border-color:#cdb16a;background:linear-gradient(180deg,#454d3e,#32382f)}.member-record-nav b{font-family:'Stardos Stencil',serif;font-size:13px;letter-spacing:.055em}.member-record-nav span{font-size:10px;color:#c9c2ae;margin-top:4px;line-height:1.3}

.clean-jacket{background:linear-gradient(180deg,#d2b16f,#bf9951);border-top:5px solid #8e6d32}.clean-record-grid{display:grid;grid-template-columns:165px minmax(0,1fr);margin:0}.clean-record-grid dt,.clean-record-grid dd{margin:0;padding:8px 7px;border-bottom:1px dotted rgba(63,50,27,.36);font-size:11px;line-height:1.35}.clean-record-grid dt{font-size:9px;letter-spacing:.075em;font-weight:700;color:#55472f}.clean-record-grid dd{font-weight:700;overflow-wrap:anywhere}.clean-record-grid.compact-grid{grid-template-columns:120px minmax(0,1fr)}
.member-primary-link,.member-secondary-link{display:inline-flex;align-items:center;justify-content:center;min-height:38px;margin-top:16px;padding:9px 13px;text-decoration:none;font:700 10px/1.2 'Courier Prime',monospace;letter-spacing:.07em;border:1px solid #625536;cursor:pointer}.member-primary-link{background:#384135;color:#eee5ce;border-color:#7d744f}.member-primary-link:hover{background:#46503f}.member-secondary-link{background:#d9caa5;color:#292318}.member-link-row{display:flex;flex-wrap:wrap;gap:8px}.button-reset.member-primary-link{appearance:none}

.member-record-redesign .training-record-status{margin-top:0}.member-record-redesign .replacement-check{padding:9px 3px}.member-record-redesign .replacement-check b{font-size:11px}.member-record-redesign .replacement-check small{font-size:9px;line-height:1.45}.member-record-redesign .rules-filed-stamp{font-size:11px}
.member-record-redesign .promotion-eligibility-paper{background:linear-gradient(180deg,#dfd4b9,#d1c099)}.promotion-path-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(390px,1fr));gap:16px}.member-record-redesign .promotion-path-sheet{border:1px solid rgba(75,60,34,.25);background:rgba(255,255,255,.14);padding:15px 16px}.member-record-redesign .promotion-requirement b{font-size:10px}.member-record-redesign .promotion-requirement small{font-size:9px}

.member-record-redesign .assignment-block{grid-template-columns:170px minmax(0,1fr);padding:10px 0}.member-record-redesign .assignment-block span{font-size:9px}.member-record-redesign .assignment-block b{font-size:12px;overflow-wrap:anywhere}.member-record-redesign .member-history-line,.member-record-redesign .member-award-line,.member-record-redesign .member-chain-line,.member-record-redesign .member-qual-line,.member-record-redesign .member-service-line{font-size:11px;padding:10px 0;align-items:start}.member-record-redesign .member-history-line span,.member-record-redesign .member-award-line span,.member-record-redesign .member-qual-line span{font-size:10px}.member-record-redesign .member-award-line small,.member-record-redesign .member-qual-line small,.member-record-redesign .member-service-line small{font-size:9px;line-height:1.45}.member-record-redesign .member-order-line{grid-template-columns:120px minmax(0,1fr);padding:11px 0}.member-record-redesign .member-order-line span{font-size:9px}.member-record-redesign .member-order-line b{font-size:12px}.member-record-redesign .member-order-line small{font-size:9px;line-height:1.45}

.clean-document-grid{grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:15px}.clean-document-grid .document-thumbnail{transform:none!important;background:#d6c699;padding:10px 10px 13px;box-shadow:0 7px 15px rgba(0,0,0,.18);border:1px solid rgba(74,60,34,.25)}.clean-document-grid .document-thumbnail:hover{transform:translateY(-2px)!important}.clean-document-grid .document-thumbnail img{aspect-ratio:4/3;object-fit:contain;background:transparent;border:0}.clean-document-grid .document-thumbnail b{font-size:11px}.clean-document-grid .document-thumbnail span,.clean-document-grid .document-thumbnail small{font-size:9px}

.member-record-redesign .weapon-member-paper .weapon-visual.record{min-height:290px;background:linear-gradient(180deg,#66705e,#4b5547);padding:12px}.member-record-redesign .weapon-member-paper .weapon-visual img{max-height:280px}.member-record-redesign .member-uniform-visual{height:365px}.member-record-redesign .uniform-member-paper p{font-size:11px}.member-record-redesign .member-uniform-status{font-size:11px}
.service-timeline-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px}.service-timeline-grid .member-service-line{grid-template-columns:105px minmax(0,1fr)}.service-timeline-grid .member-service-line small{grid-column:2}
.member-record-redesign .member-action-board{background:linear-gradient(180deg,#e4d9bf,#d2c39e)}.member-record-redesign .member-action-line{grid-template-columns:120px minmax(0,1fr) minmax(190px,.7fr);font-size:11px}.member-record-redesign .notification-line{grid-template-columns:120px minmax(0,1fr) minmax(190px,.7fr) auto}.member-record-redesign .notice-ack{font-size:9px}

@media(max-width:1100px){.member-two-column,.overview-grid,.equipment-grid{grid-template-columns:1fr}.member-record-nav{grid-template-columns:repeat(2,minmax(0,1fr))}.current-story-grid{grid-template-columns:1fr 1fr}.service-timeline-grid{grid-template-columns:1fr}}
@media(max-width:720px){.member-dashboard-shell{width:min(96vw,700px);padding-top:18px}.member-dashboard-card{padding:22px 18px}.member-dashboard-header{align-items:start;flex-direction:column}.member-record-nav{grid-template-columns:1fr 1fr}.current-story-grid{grid-template-columns:1fr}.clean-record-grid,.clean-record-grid.compact-grid,.member-record-redesign .assignment-block{grid-template-columns:1fr}.clean-record-grid dt{padding-bottom:2px;border-bottom:0}.clean-record-grid dd{padding-top:2px}.promotion-path-grid{grid-template-columns:1fr}.member-record-redesign .member-action-line,.member-record-redesign .notification-line{grid-template-columns:1fr}.member-record-redesign .member-action-line small{text-align:left}.member-record-redesign .member-order-line{grid-template-columns:1fr}.member-record-redesign .member-order-line small{grid-column:1}.service-timeline-grid .member-service-line{grid-template-columns:85px 1fr}.member-section-title h2{font-size:24px}}

/* ========================================================================
   ORDERS TO VIETNAM — TRANSPARENT FIELD DOCUMENT + PRECISE LIVE OVERLAYS
   ======================================================================== */
.page-official-order .official-order-room{background:linear-gradient(rgba(20,27,19,.77),rgba(17,23,16,.87)),url('/static/art/hq-field-desk.webp') center/cover fixed;padding-top:55px}
.vietnam-order-document{width:min(1448px,94vw);aspect-ratio:1448/1086;filter:drop-shadow(0 24px 30px rgba(0,0,0,.48));overflow:visible}
.vietnam-order-template{object-fit:fill;background:transparent}
.order-overlay{font-size:clamp(8px,1vw,14px);line-height:1;background:rgba(211,184,133,.82);box-shadow:0 0 4px rgba(211,184,133,.8);padding:2px 5px;transform:none;text-shadow:none}
/* left GENERAL ORDERS page */
.order-number{left:14.9%;top:27.45%;min-width:8.3%;text-align:center}
.order-date{left:36.4%;top:27.35%;min-width:15%;text-align:center}
.order-grade{left:12.9%;top:40.35%;width:7.2%;text-align:center}
.order-mos{left:20.5%;top:40.35%;width:7.0%;text-align:center}
.order-name{left:28.7%;top:40.35%;width:13.8%;text-align:center}
.order-roster{left:42.4%;top:40.35%;width:10.7%;text-align:center}
/* right SPECIAL ORDERS page */
.right-order-number{left:61.2%;top:19.65%;width:6.4%;text-align:center}
.right-order-date{left:78.0%;top:22.25%;width:12.5%;text-align:center}
.right-grade{left:58.8%;top:35.8%;width:5.3%;text-align:center}
.right-mos{left:64.3%;top:35.8%;width:6.1%;text-align:center}
.right-name{left:70.8%;top:35.8%;width:10.8%;text-align:center}
.right-roster{left:82.3%;top:35.8%;width:8.8%;text-align:center}
.routing-date{left:74.2%;top:74.55%;width:10.8%;text-align:center;transform:rotate(3deg)}
.order-record-caption{max-width:1040px;margin:24px auto 40px;padding:28px 34px;transform:none}
.page-official-order .document-status-stamp{right:max(24px,calc(50% - 500px));top:auto;margin-top:12px}
@media(max-width:720px){.vietnam-order-document{width:98vw;margin:0 auto}.order-overlay{font-size:5.5px;padding:1px 2px}.order-record-caption{margin:15px 10px 30px}}
.member-record-redesign .member-dashboard-shell article{grid-column:auto!important}
.member-record-redesign .personnel-documents-paper,.member-record-redesign .orders-paper,.member-record-redesign .awards-paper,.member-record-redesign .chain-paper,.member-record-redesign .weapon-member-paper,.member-record-redesign .uniform-member-paper,.member-record-redesign .training-member-paper,.member-record-redesign .service-member-paper,.member-record-redesign .appointments-member-paper,.member-record-redesign .operations-member-paper,.member-record-redesign .leave-member-paper,.member-record-redesign .replacement-training-paper,.member-record-redesign .promotion-eligibility-paper,.member-record-redesign .nco-award-recommendation-paper,.member-record-redesign .mos-member-paper,.member-record-redesign .mos-proficiency-paper,.member-record-redesign .leadership-paper,.member-record-redesign .recognition-paper,.member-record-redesign .tour-book-preview-paper{grid-column:auto!important;transform:none!important}


/* ========================================================================
   MEMBER RECORD FINAL POLISH — READABILITY / ORDER PREVIEWS / NEW TEMPLATE
   ======================================================================== */
.page-member-record{background:#22291f}
.member-dashboard-shell{width:min(1540px,95vw);gap:34px;padding-bottom:110px}
.member-section-block{display:grid;gap:22px}
.member-section-title{padding:0 4px 12px;border-bottom:1px solid rgba(214,194,133,.38)}
.member-section-title small{font-size:12px;letter-spacing:.14em;color:#cbb06c;font-weight:800}
.member-section-title h2{font-size:32px;line-height:1.05;margin:8px 0 8px;color:#eee6d3}
.member-section-title p{font-size:15px;line-height:1.65;color:#d8d0bd;max-width:920px;margin:0}
.member-dashboard-card{padding:34px 36px}
.member-dashboard-card>header small{font-size:12px}
.member-dashboard-card>header strong{font-size:26px}
.member-dashboard-header small{font-size:12px}.member-dashboard-header h2{font-size:31px}.member-dashboard-header>span{font-size:13px}
.current-story-grid{gap:14px}.current-story-grid>div{padding:17px 18px;min-height:92px}.current-story-grid small{font-size:11px}.current-story-grid strong{font-size:15px;line-height:1.5}
.member-record-nav{gap:12px}.member-record-nav a{min-height:88px;padding:15px 16px}.member-record-nav b{font-size:15px}.member-record-nav span{font-size:12px;line-height:1.45}
.clean-record-grid{grid-template-columns:190px minmax(0,1fr)}.clean-record-grid dt,.clean-record-grid dd{padding:11px 9px}.clean-record-grid dt{font-size:11px}.clean-record-grid dd{font-size:14px}
.member-primary-link,.member-secondary-link{font-size:12px;min-height:44px;padding:11px 15px}
.member-record-redesign .replacement-check{padding:13px 5px}.member-record-redesign .replacement-check .check-mark{font-size:22px}.member-record-redesign .replacement-check b{font-size:14px}.member-record-redesign .replacement-check small{font-size:12px;line-height:1.55}
.member-record-redesign .training-record-status{padding:18px}.member-record-redesign .training-record-status span{font-size:11px}.member-record-redesign .training-record-status b{font-size:19px}.member-record-redesign .training-record-status small{font-size:11px}
.member-record-redesign .promotion-path-sheet{padding:22px 22px}.promotion-path-heading span{font-size:12px}.promotion-path-heading b{font-size:17px}.promotion-status{font-size:11px;padding:6px 9px}.member-record-redesign .promotion-requirement{grid-template-columns:30px minmax(0,1fr) 190px;padding:13px 4px}.member-record-redesign .promotion-requirement>span{font-size:20px}.member-record-redesign .promotion-requirement b{font-size:13px;line-height:1.45}.member-record-redesign .promotion-requirement small{font-size:11px;line-height:1.45;text-align:right}
.member-record-redesign .assignment-block{grid-template-columns:190px minmax(0,1fr);padding:13px 0}.member-record-redesign .assignment-block span{font-size:11px}.member-record-redesign .assignment-block b{font-size:14px}
.member-record-redesign .member-history-line,.member-record-redesign .member-award-line,.member-record-redesign .member-chain-line,.member-record-redesign .member-qual-line,.member-record-redesign .member-service-line{font-size:14px;padding:13px 0;line-height:1.5}.member-record-redesign .member-history-line span,.member-record-redesign .member-award-line span,.member-record-redesign .member-qual-line span{font-size:12px}.member-record-redesign .member-award-line small,.member-record-redesign .member-qual-line small,.member-record-redesign .member-service-line small{font-size:11px;line-height:1.55}.member-record-redesign .member-order-line{grid-template-columns:145px minmax(0,1fr);padding:14px 0}.member-record-redesign .member-order-line span{font-size:11px}.member-record-redesign .member-order-line b{font-size:14px}.member-record-redesign .member-order-line small{font-size:11px;line-height:1.55}
.member-record-redesign .member-action-line{font-size:13px;grid-template-columns:140px minmax(0,1fr) minmax(210px,.7fr)}.member-record-redesign .member-action-line small{font-size:11px}.member-record-redesign .notification-line{grid-template-columns:140px minmax(0,1fr) minmax(210px,.7fr) auto}
.member-record-redesign .member-uniform-visual{height:455px;padding:8px 4px 0}.member-record-redesign .member-uniform-visual > img.uniform-base-image{height:112%;max-height:none;transform:translateY(4%);object-fit:contain}.member-record-redesign .uniform-member-paper p{font-size:13px;line-height:1.6}.member-record-redesign .member-uniform-status{font-size:13px}
.clean-document-grid{grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}.clean-document-grid .document-thumbnail{padding:13px 13px 16px}.clean-document-grid .document-thumbnail img{width:100%;aspect-ratio:1576/998;object-fit:contain;background:transparent}.clean-document-grid .document-thumbnail b{font-size:13px;line-height:1.4}.clean-document-grid .document-thumbnail span,.clean-document-grid .document-thumbnail small{font-size:11px}

/* uploaded 1576x998 transparent Vietnam orders sheet */
.vietnam-order-document{width:min(1576px,96vw);aspect-ratio:1576/998}
.vietnam-order-template{object-fit:contain;background:transparent}
.order-overlay{background:rgba(226,198,151,.72);box-shadow:0 0 3px rgba(226,198,151,.72);font-size:clamp(8px,.92vw,15px)}
.order-left-headings{left:10.8%;top:38.7%;width:38%;font-size:clamp(7px,.78vw,12px);background:transparent;box-shadow:none;letter-spacing:.015em}
.order-number{left:13.0%;top:26.1%;min-width:10%;text-align:left}
.order-date{left:36.8%;top:26.0%;min-width:16%;text-align:center}
.order-grade{left:11.7%;top:41.1%;width:6.5%;text-align:center}.order-mos{left:18.5%;top:41.1%;width:6.2%;text-align:center}.order-name{left:26.8%;top:41.1%;width:15.2%;text-align:center}.order-roster{left:42.1%;top:41.1%;width:10.4%;text-align:center}
.order-right-headings{left:54.2%;top:34.6%;width:36%;font-size:clamp(7px,.72vw,11px);background:transparent;box-shadow:none;letter-spacing:.01em}
.right-order-number{left:54.2%;top:21.2%;width:8.7%;text-align:left}.right-order-date{left:73.2%;top:23.1%;width:14%;text-align:center}.right-grade{left:55.0%;top:37.3%;width:5.4%;text-align:center}.right-mos{left:60.4%;top:37.3%;width:5.8%;text-align:center}.right-name{left:67.0%;top:37.3%;width:12%;text-align:center}.right-roster{left:80.1%;top:37.3%;width:10.4%;text-align:center}.routing-date{left:65.5%;top:70.5%;width:12.2%;text-align:center;transform:rotate(4deg)}

@media(max-width:900px){.member-dashboard-card{padding:26px 22px}.member-section-title h2{font-size:28px}.member-section-title p{font-size:14px}.member-record-redesign .promotion-requirement{grid-template-columns:30px 1fr}.member-record-redesign .promotion-requirement small{grid-column:2;text-align:left}.member-record-redesign .member-uniform-visual{height:380px}}
@media(max-width:720px){.member-section-title h2{font-size:25px}.member-dashboard-card>header strong{font-size:22px}.member-dashboard-header h2{font-size:26px}.member-record-nav a{min-height:76px}.member-record-nav b{font-size:13px}.member-record-nav span{font-size:10px}.clean-record-grid{grid-template-columns:1fr}.member-record-redesign .member-uniform-visual{height:320px}.clean-document-grid{grid-template-columns:1fr 1fr}.order-left-headings,.order-right-headings{font-size:4.5px}}


/* CONTRACT OVERLAY ALIGNMENT PASS — calibrated to 1576x998 uploaded form */
.page-official-order .vietnam-order-document{position:relative;width:min(1576px,96vw);aspect-ratio:1576/998;margin:0 auto;overflow:visible}
.page-official-order .vietnam-order-template{display:block;width:100%;height:100%;object-fit:contain;background:transparent}
.page-official-order .order-overlay{position:absolute;z-index:3;background:transparent!important;box-shadow:none!important;padding:0!important;color:#2b2419;font-family:"Courier Prime","Courier New",monospace;font-weight:700;line-height:1.05;white-space:nowrap;text-shadow:0 .3px rgba(255,255,255,.18);font-size:clamp(7px,.88vw,14px)}
.page-official-order .order-number{left:15.1%;top:26.45%;width:12.2%;text-align:left}
.page-official-order .order-date{left:37.4%;top:26.15%;width:13.2%;text-align:center}
.page-official-order .right-order-number{left:55.25%;top:21.15%;width:10.1%;text-align:left}
.page-official-order .right-order-date{left:72.15%;top:22.65%;width:12.2%;text-align:center}
.page-official-order .routing-date{left:64.3%;top:69.4%;width:11.2%;text-align:center;transform:rotate(4deg);transform-origin:center}
.page-official-order .order-personnel-row{position:absolute;z-index:3;display:grid;align-items:start;color:#2b2419;font-family:"Courier Prime","Courier New",monospace;text-align:center}
.page-official-order .order-personnel-row>div{min-width:0;display:grid;grid-template-rows:auto auto;gap:11px}
.page-official-order .order-personnel-row span{font-size:clamp(6px,.7vw,11px);font-weight:700;line-height:1;white-space:nowrap}
.page-official-order .order-personnel-row b{font-size:clamp(7px,.84vw,13px);font-weight:700;line-height:1;white-space:nowrap;overflow:hidden;text-overflow:clip}
.page-official-order .left-personnel-row{left:10.85%;top:38.8%;width:41.2%;grid-template-columns:15% 15% 39% 31%}
.page-official-order .right-personnel-row{left:54.55%;top:35.25%;width:35.8%;grid-template-columns:15% 16% 38% 31%}
@media(max-width:720px){.page-official-order .order-personnel-row>div{gap:6px}.page-official-order .order-personnel-row span{font-size:4.5px}.page-official-order .order-personnel-row b{font-size:5px}.page-official-order .order-overlay{font-size:5px}}

/* Uniform record visual enlargement — larger jacket inside existing 201 File panel. */
.page-201 .uniform-record-visual{
  min-height:560px;
  padding:6px 8px;
  overflow:hidden;
}
.page-201 .uniform-record-visual > img.uniform-base-image{
  width:100%;
  height:548px;
  max-height:none;
  object-fit:contain;
  object-position:center center;
}
@media(max-width:980px){
  .page-201 .uniform-record-visual{min-height:460px;padding:6px}
  .page-201 .uniform-record-visual > img.uniform-base-image{height:448px}
}
@media(max-width:720px){
  .page-201 .uniform-record-visual{min-height:380px}
  .page-201 .uniform-record-visual > img.uniform-base-image{height:368px}
}

/* CONTRACT SVG LOCK — exact 1576 x 998 template coordinates; prevents overlay drift */
.page-official-order .vietnam-order-document{
  position:relative;
  width:min(1576px,96vw);
  aspect-ratio:1576/998;
  margin:0 auto;
  overflow:visible;
  filter:drop-shadow(0 24px 30px rgba(0,0,0,.48));
}
.page-official-order .vietnam-order-svg{display:block;width:100%;height:auto;overflow:visible}
.page-official-order .contract-typed-fields{
  font-family:"Courier Prime","Courier New",monospace;
  fill:#241e16;
  font-weight:700;
}
.page-official-order .contract-label{font-size:14px;letter-spacing:.25px}
.page-official-order .contract-value{font-size:17px}
.page-official-order .contract-number,.page-official-order .contract-date{font-size:16px}
.page-official-order .contract-label-small{font-size:12px}
.page-official-order .contract-value-small{font-size:15px}
.page-official-order .contract-right-number,.page-official-order .contract-right-date,.page-official-order .contract-routing-date{font-size:15px}
.page-official-order .contract-name,.page-official-order .contract-roster{font-size:16px}
/* Retire prior loose HTML overlays on the replacement contract. */
.page-official-order .vietnam-order-document>.order-overlay,
.page-official-order .vietnam-order-document>.order-personnel-row,
.page-official-order .vietnam-order-document>.vietnam-order-template{display:none!important}


/* ABOUT PAGE OVERHAUL */
.about-overhaul{background:#252a22}
.about-vietnam-hero{position:relative;min-height:760px;padding:78px 6vw 86px;background:url('/static/art/arrival-country.webp') center/cover no-repeat;overflow:hidden}
.about-vietnam-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,20,15,.88),rgba(17,20,15,.52) 45%,rgba(17,20,15,.32) 100%)}
.about-vietnam-hero__wrap{position:relative;z-index:2;max-width:1420px;margin:0 auto;display:grid;grid-template-columns:minmax(340px,760px) 320px;gap:34px;align-items:start}
.about-vietnam-hero__paper{padding:46px 50px;transform:rotate(-.55deg);background:linear-gradient(180deg,#eee5cf,#d8caab);box-shadow:0 24px 46px rgba(0,0,0,.38)}
.about-kicker{font-size:11px;letter-spacing:.14em;color:#70552a;font-weight:700;margin:16px 0 10px}
.about-vietnam-hero__paper h1{font-family:'Stardos Stencil',serif;font-size:clamp(44px,6vw,78px);line-height:.95;margin:0 0 20px;color:#262217}
.about-lead{font-size:16px;line-height:1.82;max-width:58ch;color:#3b3528}
.about-hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}
.about-vietnam-hero__note{position:relative;margin-top:64px;padding:28px 24px;background:linear-gradient(180deg,#b79e65,#a98d53);box-shadow:0 18px 38px rgba(0,0,0,.42);transform:rotate(1.1deg);font-family:'Courier Prime',monospace;color:#242114}
.about-vietnam-hero__note:before{content:'';position:absolute;left:50%;top:-10px;width:84px;height:20px;background:rgba(214,199,162,.8);transform:translateX(-50%) rotate(-2deg)}
.about-vietnam-hero__note span{font-size:10px;letter-spacing:.14em;font-weight:700}
.about-vietnam-hero__note strong{display:block;font-size:28px;line-height:1.05;margin:10px 0 18px}
.about-vietnam-hero__note ul{list-style:none;padding:0;margin:0;display:grid;gap:14px}
.about-vietnam-hero__note li{padding-bottom:12px;border-bottom:1px solid rgba(53,40,19,.22)}
.about-vietnam-hero__note li:last-child{border-bottom:0;padding-bottom:0}
.about-vietnam-hero__note b,.about-vietnam-hero__note small{display:block}
.about-vietnam-hero__note b{font-size:12px;letter-spacing:.07em}
.about-vietnam-hero__note small{font-size:11px;line-height:1.55;margin-top:3px}
.about-value-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:18px 4vw;background:#1f241d;border-top:1px solid rgba(227,214,180,.18);border-bottom:1px solid rgba(227,214,180,.18)}
.about-value-strip div{padding:14px 20px;border-left:1px solid rgba(227,214,180,.18);color:#ecdfc0}
.about-value-strip div:first-child{border-left:0}
.about-value-strip span{display:block;font-family:'Stardos Stencil',serif;font-size:28px;color:#c3ab70}
.about-value-strip b{display:block;font-size:12px;letter-spacing:.11em;margin-top:3px}
.about-value-strip small{display:block;font-size:11px;line-height:1.6;opacity:.84;margin-top:6px}
.about-offer-section,.about-flow-section{padding:86px 5vw;background:#34392d}
.about-offer-section .section-file-heading,.about-flow-section .section-file-heading{max-width:1080px;margin:0 auto 36px;padding:28px 34px}
.about-offer-grid{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(2,1fr);gap:28px}
.about-offer-card{padding:34px 36px;transform:rotate(-.3deg);box-shadow:0 14px 28px rgba(0,0,0,.12)}
.about-offer-card:nth-child(even){transform:rotate(.32deg)}
.about-offer-card header{border-bottom:2px solid #4d4433;padding-bottom:12px;margin-bottom:14px}
.about-offer-card header>*{display:block}
.about-offer-card header small{font-size:10px;letter-spacing:.13em}
.about-offer-card header b{font-size:26px;line-height:1.05;margin-top:6px}
.about-offer-card p{font-size:14px;line-height:1.72;color:#3c362b}
.about-offer-card ul{margin:16px 0 0;padding-left:18px;color:#3d372c;display:grid;gap:8px}
.about-offer-card li{font-size:12px;line-height:1.55}
.about-issue-section{padding:96px 5vw;background:linear-gradient(180deg,#242921,#2f352c);display:grid;grid-template-columns:minmax(340px,620px) minmax(360px,760px);gap:34px;align-items:start}
.about-issue-copy{padding:36px 34px;transform:rotate(-.4deg)}
.about-issue-copy header{border-bottom:2px solid #4d4433;padding-bottom:10px;margin-bottom:16px}
.about-issue-copy header>*{display:block}
.about-issue-copy header b{font-size:32px;line-height:1.04;margin-top:6px}
.about-issue-copy p{font-size:14px;line-height:1.75}
.about-issue-lines{display:grid;gap:12px;margin-top:18px}
.about-issue-lines div{padding:11px 0;border-bottom:1px dotted #7c725e}
.about-issue-lines span{display:block;font-size:10px;letter-spacing:.15em;color:#695534;font-weight:700}
.about-issue-lines b{display:block;font-size:13px;line-height:1.65;margin-top:5px;color:#342d21}
.about-issue-visuals{display:grid;grid-template-columns:1.25fr .95fr;gap:22px;align-items:start}
.about-polaroid{padding:18px;background:linear-gradient(180deg,#ece2cc,#d9caab);box-shadow:0 16px 34px rgba(0,0,0,.22)}
.about-polaroid img{display:block;width:100%;height:auto;object-fit:contain;background:rgba(94,104,78,.18)}
.about-polaroid figcaption{font-size:11px;line-height:1.55;margin-top:11px;color:#493f30}
.about-polaroid--orders{grid-row:span 2;transform:rotate(-1.1deg)}
.about-polaroid--weapon{transform:rotate(.8deg)}
.about-polaroid--weapon img{padding:18px;background:linear-gradient(180deg,#676f5c,#4f5645)}
.about-polaroid--uniform{transform:rotate(-.25deg)}
.about-polaroid--uniform img{padding:16px;background:linear-gradient(180deg,#676f5c,#4f5645)}
.about-flow-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);gap:18px}
.about-flow-grid article{padding:28px 24px;background:linear-gradient(180deg,#ddd1ae,#cdbd95);box-shadow:0 16px 28px rgba(0,0,0,.18);transform:rotate(-.4deg)}
.about-flow-grid article:nth-child(even){transform:rotate(.45deg)}
.about-flow-grid span{display:block;font-family:'Stardos Stencil',serif;font-size:34px;color:#7b6435}
.about-flow-grid b{display:block;font-size:18px;line-height:1.1;margin:6px 0 10px}
.about-flow-grid p{font-size:12px;line-height:1.65;color:#41382b}
.about-final-call{background:#171b16}
@media(max-width:1180px){.about-vietnam-hero__wrap,.about-issue-section{grid-template-columns:1fr}.about-vietnam-hero__note{margin-top:0;max-width:420px}.about-issue-visuals{grid-template-columns:1fr 1fr}.about-flow-grid{grid-template-columns:repeat(2,1fr)}.about-value-strip{grid-template-columns:repeat(2,1fr)} }
@media(max-width:720px){.about-vietnam-hero{padding:62px 18px 70px;min-height:unset}.about-vietnam-hero__paper{padding:30px 24px;transform:none}.about-vietnam-hero__paper h1{font-size:42px}.about-lead{font-size:14px}.about-vietnam-hero__note{padding:22px 18px;transform:none;max-width:none}.about-value-strip{grid-template-columns:1fr;padding:12px 18px}.about-value-strip div{border-left:0;border-top:1px solid rgba(227,214,180,.18)}.about-value-strip div:first-child{border-top:0}.about-offer-section,.about-flow-section{padding:56px 18px}.about-offer-grid,.about-issue-visuals,.about-flow-grid{grid-template-columns:1fr}.about-offer-card,.about-flow-grid article,.about-issue-copy,.about-polaroid{transform:none!important}.about-issue-section{padding:56px 18px}.about-offer-card header b{font-size:23px}.about-issue-copy header b{font-size:28px}}


/* COMMAND ACTION CONTROL — USER-FRIENDLY WORKFLOW PASS */
.command-global-bar-inner{min-height:82px;gap:10px;padding:10px 0}
.command-global-label{min-width:205px;padding-right:16px}
.command-global-label small{font-size:10px}.command-global-label b{font-size:16px}
.command-global-bar a{min-width:118px;min-height:56px;padding:9px 14px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:3px;border:1px solid rgba(202,177,108,.42);box-shadow:0 5px 11px rgba(0,0,0,.16)}
.command-global-bar a b{font-size:13px;letter-spacing:.08em}.command-global-bar a small{font-size:9px;letter-spacing:.04em;opacity:.72;font-weight:400}
.command-global-bar a:hover{background:#4b523f;border-color:#d2b56c;box-shadow:0 7px 15px rgba(0,0,0,.24)}
.action-control-shell{max-width:1500px;gap:28px;padding-bottom:70px}
.action-view-tabs{display:grid;grid-template-columns:repeat(3,minmax(190px,1fr));gap:12px;margin:0 0 6px}
.action-view-tabs a{display:flex;flex-direction:column;gap:5px;padding:18px 20px;background:#293027;color:#eadfc3;border:1px solid rgba(205,177,106,.36);text-decoration:none;box-shadow:0 8px 16px rgba(0,0,0,.17)}
.action-view-tabs a span{font:700 14px 'Courier Prime',monospace;letter-spacing:.08em}.action-view-tabs a small{font-size:10px;opacity:.75}.action-view-tabs a.active,.action-view-tabs a:hover{background:#454d3c;border-color:#ceb267;color:#fff7df}
.action-register-sheet,.action-queue-sheet,.action-archive-sheet,.quick-roster-correction{padding:30px 34px!important}
.action-register-sheet .army-letterhead strong{font-size:24px}.action-create-grid{gap:16px 18px}.action-create-grid label{font-size:11px}.action-create-grid input,.action-create-grid select,.action-create-grid textarea{font-size:14px;min-height:44px;padding:10px 12px}.action-open-button{min-width:220px;min-height:52px}
.action-queue-header{display:flex;align-items:end;justify-content:space-between;gap:20px;padding-bottom:14px;border-bottom:2px solid #514936;margin-bottom:4px}.action-queue-header small,.action-queue-header b{display:block}.action-queue-header small{font-size:10px;letter-spacing:.12em}.action-queue-header b{font-size:22px;margin-top:3px}.action-queue-header>span{font-size:10px;letter-spacing:.04em;color:#665d4a;text-align:right}
.action-queue-legend{display:grid;grid-template-columns:minmax(300px,1.2fr) 120px 165px 150px minmax(190px,.8fr) 92px;gap:12px;padding:11px 12px;background:rgba(95,82,54,.12);border-bottom:1px solid rgba(75,63,42,.28);font-size:9px;font-weight:700;letter-spacing:.09em}
.action-ledger-card{grid-template-columns:minmax(300px,1.2fr) 120px 165px 150px minmax(190px,.8fr) 92px!important;gap:12px!important;padding:16px 12px!important;align-items:center!important}
.action-ledger-main{display:flex!important;flex-direction:column;gap:4px;min-width:0}.action-ledger-main b{display:block;font-size:14px;line-height:1.35}.action-ledger-main>span{display:block;font-size:11px!important;line-height:1.4;color:#5c513e}.action-ledger-badges{display:flex!important;flex-direction:row!important;gap:6px!important;align-items:center}.action-ledger-badges small{padding:3px 6px;border:1px solid rgba(76,62,39,.35);font-size:9px!important;line-height:1}.priority-high,.priority-urgent,.priority-critical{font-weight:700;color:#793b2e;border-color:#9c5b48!important;background:rgba(155,84,64,.08)}.action-due{font-size:9px!important;color:#756349!important;letter-spacing:.06em}
.action-status{font-size:11px;padding:7px 8px;border:1px solid rgba(75,63,42,.3);text-align:center;background:rgba(255,255,255,.13)}.action-ledger-card select,.action-ledger-card input{min-height:42px;font-size:13px;padding:8px 10px}.action-update-button{min-height:42px;background:#35402f;color:#f2e5c7;border:1px solid #6c724f;font-weight:700;letter-spacing:.06em}
.action-empty-state{padding:42px 22px;text-align:center;border:1px dashed rgba(76,63,42,.28);margin-top:16px}.action-empty-state b{font-size:20px}.action-empty-state p{font-size:13px}.action-empty-state a{font-size:11px;color:#5e4b28;font-weight:700}
.archive-folder-mark{display:inline-block;margin:16px 0 8px;padding:7px 12px;background:#ad8d51;color:#221e15;font-size:10px;font-weight:700;letter-spacing:.1em;border-radius:2px 2px 0 0}.archived-action-row{display:grid;grid-template-columns:1fr 130px 120px;gap:18px;align-items:center;padding:16px 10px;border-bottom:1px dotted #81745a}.archived-action-row div>*{display:block}.archived-action-row small{font-size:9px;letter-spacing:.08em}.archived-action-row b{font-size:14px;line-height:1.4;margin:3px 0}.archived-action-row span{font-size:11px;color:#5e5340}.archived-action-row strong{font-size:11px;text-align:center}.archived-action-row time{font-size:10px;text-align:right}
.quick-roster-correction{border:2px solid rgba(126,57,43,.55)!important;background:linear-gradient(180deg,#e5d7b9,#d6c19a)!important}.quick-roster-correction header{border-bottom:2px solid #7c493d;padding-bottom:10px;margin-bottom:12px}.quick-roster-correction header>*{display:block}.quick-roster-correction header b{font-size:22px}.quick-roster-correction p{font-size:13px;line-height:1.65}.quick-delete-grid{display:grid;grid-template-columns:minmax(320px,1.4fr) minmax(180px,.6fr) auto;gap:14px;align-items:end}.quick-delete-grid label{font-size:10px;font-weight:700;letter-spacing:.06em}.quick-delete-grid select,.quick-delete-grid input{width:100%;min-height:44px;margin-top:6px;padding:9px 10px;font-size:13px}.quick-delete-grid .danger-delete-button{min-height:44px;padding:8px 16px}
@media(max-width:1150px){.action-queue-legend{display:none}.action-ledger-card{grid-template-columns:1fr 120px 165px!important}.action-ledger-card input,.action-ledger-card .action-update-button{grid-column:auto}.quick-delete-grid{grid-template-columns:1fr 1fr}.quick-delete-grid .danger-delete-button{grid-column:1/-1}.command-global-bar a{min-width:108px}}
@media(max-width:760px){.action-view-tabs{grid-template-columns:1fr}.action-register-sheet,.action-queue-sheet,.action-archive-sheet,.quick-roster-correction{padding:22px 18px!important}.action-ledger-card{grid-template-columns:1fr!important;gap:8px!important}.action-status{text-align:left}.archived-action-row{grid-template-columns:1fr}.archived-action-row time{text-align:left}.quick-delete-grid{grid-template-columns:1fr}.command-global-bar-inner{min-height:72px}.command-global-bar a{min-width:120px}.command-global-label{min-width:170px}}


/* ==========================================================================
   BILLET STRENGTH — Command visual overhaul
   ========================================================================== */
.page-billet-strength .staff-workspace{max-width:1500px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:26px}
.billet-command-shell{max-width:1500px;margin:0 auto;padding:70px 5vw 100px;background:#5b6051}
.billet-overview-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:24px;align-items:start}
.billet-command-panel{padding:28px 30px!important;background:linear-gradient(180deg,#e6ddc8,#d8ccb0)!important;color:#1f1b14;border:1px solid rgba(88,76,48,.42)!important;box-shadow:0 14px 28px rgba(0,0,0,.22)!important}
.billet-command-panel .command-panel-header h2{font-size:24px}
.billet-stat-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}
.billet-stat{background:rgba(255,255,255,.28);border:1px solid rgba(74,62,35,.28);padding:15px 16px}
.billet-stat small{display:block;font-size:9px;letter-spacing:.14em;font-weight:700;color:#615744;text-transform:uppercase}
.billet-stat strong{display:block;font-family:'Stardos Stencil',serif;font-size:31px;line-height:1;margin:9px 0 6px}
.billet-stat span{display:block;font-size:11px;color:#554c39;line-height:1.35}
.billet-focus-list{display:grid;gap:12px;margin-top:16px}
.billet-focus-card{display:grid;grid-template-columns:74px 1fr auto;gap:14px;align-items:center;padding:14px 16px;background:rgba(255,255,255,.22);border:1px solid rgba(74,62,35,.24)}
.billet-focus-card em{font-style:normal;font:700 9px 'Courier Prime',monospace;letter-spacing:.14em;color:#655a46;text-transform:uppercase}
.billet-focus-card strong{font-size:15px;display:block}
.billet-focus-card span{font-size:11px;color:#5a513d}
.billet-focus-number{font-family:'Stardos Stencil',serif;font-size:30px;line-height:1;color:#2e281d;text-align:right}
.billet-focus-badge{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:6px 10px;background:#c5b183;border:1px solid rgba(74,62,35,.26);font:700 15px 'Courier Prime',monospace;color:#2d261b}
.billet-notice{margin-top:18px;padding:13px 15px;background:rgba(255,255,255,.19);border-left:4px solid #7f6c3c;font-size:12px;line-height:1.55;color:#463d2d}
.billet-unit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
.billet-unit-card{padding:0!important;overflow:hidden}
.billet-unit-card header{padding:20px 24px 14px}
.billet-unit-summary{display:flex;flex-wrap:wrap;gap:8px;padding:0 24px 18px}
.billet-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;background:#d2c19a;border:1px solid rgba(74,62,35,.24);font:700 10px 'Courier Prime',monospace;letter-spacing:.05em;color:#2d261b}
.billet-role-table{display:grid;grid-template-columns:minmax(0,1.3fr) 86px 86px 86px 86px;border-top:1px solid rgba(62,53,33,.36)}
.billet-role-table .head{background:#cabc98;font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:#2d261b}
.billet-role-table > div{padding:11px 14px;border-bottom:1px dashed rgba(62,53,33,.32);font-size:12px;line-height:1.35;min-width:0}
.billet-role-title{font-size:13px;font-weight:700;color:#1d1912}
.billet-role-sub{display:block;font-size:10px;color:#605641;margin-top:3px}
.billet-strength-band{display:flex;justify-content:space-between;gap:12px;padding:14px 24px 18px;background:rgba(0,0,0,.03);font-size:11px;color:#564d39}
.billet-strength-band strong{font-size:12px;color:#1d1912}
.billet-empty{padding:18px 24px 24px;font-size:12px;color:#564d39}
@media(max-width:1150px){.billet-overview-grid{grid-template-columns:1fr}.billet-stat-strip{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:900px){.billet-unit-grid{grid-template-columns:1fr}.billet-role-table{grid-template-columns:minmax(0,1.2fr) 76px 76px 76px 76px}}
@media(max-width:720px){.billet-command-shell{padding:52px 16px 80px}.billet-command-panel{padding:22px 18px!important}.billet-stat-strip{grid-template-columns:1fr 1fr}.billet-focus-card{grid-template-columns:1fr;align-items:start}.billet-focus-number{text-align:left}.billet-unit-card header,.billet-unit-summary,.billet-strength-band{padding-left:18px;padding-right:18px}.billet-role-table{grid-template-columns:minmax(0,1fr) 62px 62px 62px 66px}.billet-role-table > div{padding:10px 8px;font-size:11px}.billet-role-title{font-size:12px}}

/* RECRUITING APPLICATION / COMMAND CONTROL */
.recruiting-application-page{background:#252a22}.recruit-app-hero{min-height:610px}.recruit-app-shell{max-width:1450px;margin:0 auto;padding:74px 5vw 100px;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.6fr);gap:28px;background:#34392d}.recruit-app-paper{padding:38px 42px}.recruit-app-intro{margin:18px 0 24px;padding:16px 18px;border-left:4px solid #7e6a3c;background:rgba(255,255,255,.18)}.recruit-app-intro p{font-size:13px;line-height:1.7}.recruit-app-form{display:grid;grid-template-columns:1fr 1fr;gap:16px 18px}.recruit-app-form label{display:grid;grid-template-columns:34px 1fr;gap:4px 10px;padding:15px 0;border-bottom:1px dotted #84775d}.recruit-app-form label>span{grid-row:1/4;font-family:'Stardos Stencil',serif;font-size:24px;color:#806b3c}.recruit-app-form label b{font-size:13px}.recruit-app-form label small{font-size:10px;color:#665a43}.recruit-app-form input,.recruit-app-form select,.recruit-app-form textarea{grid-column:2;width:100%;box-sizing:border-box;background:#f4ecd8;border:1px solid #8b7b59;padding:11px 12px;font:14px 'Courier Prime',monospace}.recruit-app-form .wide{grid-column:1/-1}.recruit-certification{padding:16px 18px;background:#d4c39d;border:1px solid #8a7955}.recruit-certification p{font-size:11px;line-height:1.6}.recruit-pipeline-side{display:grid;gap:20px;align-content:start}.recruit-side-file{padding:42px 28px 28px;background:#b99559;box-shadow:0 18px 34px rgba(0,0,0,.28)}.recruit-side-file h3{font-size:24px;line-height:1.05}.recruit-side-file ol{padding-left:22px;display:grid;gap:10px;font-size:12px}.recruit-side-notice{padding:26px}.recruit-status-shell{min-height:80vh;padding:80px 5vw;background:linear-gradient(rgba(30,36,28,.92),rgba(30,36,28,.96)),url('/static/art/hq-canvas.webp') center/cover fixed}.recruit-status-paper{max-width:900px;margin:auto;padding:42px}.recruit-case-status{margin:20px 0;padding:18px;border:2px solid #7b6840;background:#d6c49b}.recruit-case-status small,.recruit-case-status strong{display:block}.recruit-case-status strong{font-size:27px;margin-top:5px}.recruit-case-grid{display:grid;grid-template-columns:190px 1fr;margin:24px 0}.recruit-case-grid dt,.recruit-case-grid dd{margin:0;padding:10px;border-bottom:1px dotted #83775f}.verification-order,.recruit-more-info,.recruit-approved,.recruit-denied{margin-top:26px;padding:24px;border:1px solid #887650;background:rgba(255,255,255,.18)}.verification-order h2{font-size:38px;letter-spacing:.08em;margin:8px 0}.verification-order code{display:block;padding:13px;background:#2d342a;color:#f0e4c5;font-size:16px}.recruit-more-info textarea{width:100%;box-sizing:border-box}.recruit-bookmark{font-size:10px;margin-top:25px;color:#675b43}.recruit-control-shell{max-width:1500px;margin:0 auto;padding:56px 5vw 100px;background:#596052}.recruit-control-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.recruit-control-stats article{padding:18px 20px;background:#d9ccb0;border:1px solid #897c5e}.recruit-control-stats small,.recruit-control-stats strong{display:block}.recruit-control-stats strong{font-size:32px;margin-top:7px}.recruit-control-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}.recruit-control-tabs a{padding:12px 16px;background:#323a30;color:#eee4cb;border:1px solid #756b4e;text-decoration:none;font-weight:700}.recruit-case-board{margin:0 0 26px;padding:26px;background:#62685a}.recruit-case-board>header{color:#f0e5cb;margin-bottom:14px}.recruit-case-board>header h2{font-size:28px;margin:4px 0}.recruit-command-case{padding:26px 28px;margin-bottom:18px}.recruit-case-heading{display:flex;justify-content:space-between;gap:20px;border-bottom:2px solid #504633;padding-bottom:12px}.recruit-case-heading h3{font-size:22px;margin:4px 0}.recruit-case-heading>span{align-self:start;padding:6px 9px;border:1px solid currentColor;font-size:10px}.recruit-case-heading .verified{color:#42553c}.recruit-case-heading .unverified{color:#865d31}.recruit-answer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 16px;margin:18px 0}.recruit-answer-grid div{padding:10px;border-bottom:1px dotted #877a5f}.recruit-answer-grid small,.recruit-answer-grid b{display:block}.recruit-written-answer{margin:12px 0;padding:14px 16px;background:rgba(255,255,255,.18)}.recruit-written-answer p{font-size:13px;line-height:1.65}.recruit-command-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.recruit-command-actions label{display:grid;gap:5px;font-size:10px;font-weight:700}.recruit-command-actions textarea{width:100%;box-sizing:border-box}.recruit-command-actions>div{grid-column:1/-1;display:flex;gap:10px;flex-wrap:wrap}.recruit-command-actions button{padding:12px 15px;background:#40503b;color:#f4ead0;border:1px solid #687258;font-weight:700}.recruit-command-actions button.deny{background:#693d36}.recruit-command-actions button:disabled{opacity:.45}.recruit-compact-case{display:grid;grid-template-columns:160px 1fr auto;gap:18px;padding:15px 18px;margin-bottom:8px;align-items:center}.recruit-compact-case small{text-align:right}@media(max-width:980px){.recruit-app-shell{grid-template-columns:1fr}.recruit-control-stats{grid-template-columns:1fr 1fr}.recruit-answer-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.recruit-app-shell{padding:50px 16px}.recruit-app-paper{padding:26px 20px}.recruit-app-form{grid-template-columns:1fr}.recruit-app-form .wide{grid-column:auto}.recruit-control-stats,.recruit-answer-grid,.recruit-command-actions{grid-template-columns:1fr}.recruit-compact-case{grid-template-columns:1fr}.recruit-compact-case small{text-align:left}}

/* ==========================================================================
   PUBLIC RECRUITING WOW PASS — Homepage
   ========================================================================== */
.public-recruiting-overhaul{background:#20251e}
.recruit-hero-wow{position:relative;min-height:820px;padding:82px 6vw 90px;display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:34px;align-items:end;overflow:hidden}
.recruit-hero-wow__image{position:absolute;inset:0;background:url('/static/art/homepage-background.webp') center/cover no-repeat;transform:scale(1.01)}
.recruit-hero-wow__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,15,12,.86) 0%,rgba(18,22,17,.67) 47%,rgba(16,20,15,.37) 74%,rgba(10,13,10,.56) 100%),linear-gradient(0deg,rgba(17,21,16,.72),transparent 45%)}
.recruit-hero-wow__content{position:relative;z-index:2;max-width:840px;color:#eee5cc;padding:26px 0 12px}
.recruit-hero-wow__eyebrow{font:700 11px 'Courier Prime',monospace;letter-spacing:.18em;color:#d2b36f;margin-bottom:15px}
.recruit-hero-wow h1{font-family:'Stardos Stencil',serif;font-size:clamp(66px,8vw,118px);line-height:.82;margin:0 0 18px;color:#f2e8cf;text-shadow:0 3px 18px rgba(0,0,0,.65)}
.recruit-hero-wow__unit{font-size:12px;font-weight:700;letter-spacing:.11em;color:#d8c69a;border-top:1px solid rgba(216,198,154,.4);border-bottom:1px solid rgba(216,198,154,.28);padding:11px 0;margin:0 0 18px}
.recruit-hero-wow__lead{font-size:16px;line-height:1.72;max-width:760px;color:#efe5ce;text-shadow:0 1px 5px rgba(0,0,0,.55)}
.recruit-hero-wow__actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:24px}
.recruit-hero-wow__stamp{display:inline-block;margin-top:26px;border:3px double rgba(207,176,101,.78);color:#d6ba76;padding:8px 12px;font:700 12px 'Courier Prime',monospace;letter-spacing:.12em;transform:rotate(-2deg)}
.recruit-hero-wow__orders{position:relative;z-index:2;align-self:end;margin-bottom:12px;padding:28px 25px;background:linear-gradient(180deg,#b39a62,#a48951);color:#251f14;box-shadow:0 22px 44px rgba(0,0,0,.46);transform:rotate(1.3deg);font-family:'Courier Prime',monospace}
.recruit-hero-wow__orders:before{content:"";position:absolute;top:-11px;left:50%;width:90px;height:22px;background:rgba(213,198,161,.82);transform:translateX(-50%) rotate(-2deg)}
.recruit-hero-wow__orders>span{font-size:9px;font-weight:700;letter-spacing:.15em}.recruit-hero-wow__orders>strong{display:block;font-size:22px;line-height:1.03;margin:8px 0 16px}.recruit-hero-wow__orders ol{padding-left:19px;margin:0;display:grid;gap:9px}.recruit-hero-wow__orders li{font-size:11px;line-height:1.5}
.recruit-path-wow{display:grid;grid-template-columns:repeat(6,1fr);padding:17px 4vw;background:#171c17;border-top:1px solid rgba(217,194,137,.22);border-bottom:1px solid rgba(217,194,137,.26);color:#e8dcc0}
.recruit-path-wow article{padding:11px 16px;border-left:1px solid rgba(232,220,192,.15)}.recruit-path-wow article:first-child{border-left:0}.recruit-path-wow span{font-family:'Stardos Stencil',serif;font-size:27px;color:#b99b59;display:block}.recruit-path-wow b{display:block;font-size:11px;letter-spacing:.08em}.recruit-path-wow small{display:block;font-size:9px;opacity:.7;margin-top:3px}
.recruit-promise-wow{padding:92px 6vw;background:linear-gradient(90deg,#252b23,#343a2f);display:grid;grid-template-columns:1.1fr .9fr;gap:52px;align-items:center}.recruit-promise-wow__copy{color:#e9dfc5}.recruit-promise-wow__copy>span{font-size:10px;letter-spacing:.16em;color:#bca260}.recruit-promise-wow__copy h2{font-family:'Stardos Stencil',serif;font-size:clamp(42px,5vw,72px);line-height:.98;margin:12px 0 22px}.recruit-promise-wow__copy p{font-size:15px;line-height:1.8;max-width:720px}.recruit-promise-wow__memo{padding:38px 40px;transform:rotate(-.7deg)}.recruit-promise-wow__memo blockquote{margin:22px 0 15px;padding:13px 0 13px 20px;border-left:4px solid #6d5732;font:700 24px/1.35 'Courier Prime',monospace;color:#2e291e}.recruit-promise-wow__memo p{font-size:13px;line-height:1.7}
.recruit-offer-wow{padding:88px 5vw 102px;background:#394034}.recruit-offer-wow>.section-file-heading,.recruit-replacement-wow>.section-file-heading,.recruit-life-wow>.section-file-heading,.recruit-mos-wow>.section-file-heading{max-width:1100px;margin:0 auto 38px;padding:28px 34px;transform:none}.recruit-offer-wow__grid{max-width:1360px;margin:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:26px}.recruit-offer-card{position:relative;padding:36px 38px;min-height:260px;overflow:hidden;transform:none}.recruit-offer-card__number{position:absolute;right:22px;top:14px;font-family:'Stardos Stencil',serif;font-size:56px;color:rgba(93,74,40,.13)}.recruit-offer-card>small{font-size:9px;letter-spacing:.15em}.recruit-offer-card h3{font-size:28px;line-height:1.05;margin:8px 0 14px}.recruit-offer-card p{font-size:13px;line-height:1.72}.recruit-offer-card>b{display:inline-block;margin-top:16px;font-size:10px;letter-spacing:.08em;border-top:1px solid #6f6041;padding-top:8px}
.recruit-artifacts-wow{padding:100px 6vw;background:linear-gradient(rgba(29,35,27,.92),rgba(29,35,27,.95)),url('/static/art/hq-canvas.webp') center/cover fixed;display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center}.recruit-artifacts-wow__copy{color:#eadfc2}.recruit-artifacts-wow__copy>span{font-size:10px;letter-spacing:.16em;color:#c2a55d}.recruit-artifacts-wow__copy h2{font-family:'Stardos Stencil',serif;font-size:clamp(38px,4.5vw,65px);line-height:1;margin:12px 0 30px}.recruit-tour-steps{border-left:2px solid #a5894e;padding-left:24px}.recruit-tour-steps article{position:relative;padding:0 0 23px}.recruit-tour-steps article:before{content:"";position:absolute;left:-30px;top:4px;width:9px;height:9px;background:#c4a766;border:2px solid #293027;border-radius:50%}.recruit-tour-steps b{font-size:11px;letter-spacing:.1em}.recruit-tour-steps p{font-size:13px;line-height:1.6;margin:5px 0}.recruit-artifacts-wow__desk{position:relative;min-height:650px;background:linear-gradient(rgba(75,60,39,.32),rgba(75,60,39,.32)),url('/static/art/hq-field-desk.webp') center/cover no-repeat;border:8px solid #473725;box-shadow:inset 0 0 70px rgba(0,0,0,.35),0 26px 46px rgba(0,0,0,.4)}.recruit-artifact{position:absolute;padding:12px 12px 15px;margin:0}.recruit-artifact img{display:block;width:100%;height:auto;object-fit:contain}.recruit-artifact figcaption{font:700 9px/1.4 'Courier Prime',monospace;letter-spacing:.05em;margin-top:9px}.recruit-artifact--orders{left:4%;top:8%;width:58%;transform:rotate(-2deg)}.recruit-artifact--weapon{right:4%;top:12%;width:39%;transform:rotate(1.5deg)}.recruit-artifact--weapon img{padding:15px;background:#59604f}.recruit-artifact--uniform{right:8%;bottom:6%;width:30%;transform:rotate(-1deg)}.recruit-artifact--uniform img{max-height:300px;background:#59604f}.recruit-replacement-wow{padding:90px 5vw 100px;background:#2b3128}.recruit-replacement-wow .replacement-training-preview{max-width:1140px;margin:auto}.recruit-life-wow{padding:92px 5vw 100px;background:#363c31}.recruit-life-wow__grid{max-width:1280px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.recruit-life-wow__grid article{padding:31px;background:#c7b078;color:#251f14;box-shadow:0 14px 27px rgba(0,0,0,.22)}.recruit-life-wow__grid article:nth-child(2){background:#d5c69f}.recruit-life-wow__grid small{font-size:9px;letter-spacing:.13em}.recruit-life-wow__grid h3{font-size:22px;line-height:1.08;margin:8px 0 12px}.recruit-life-wow__grid p{font-size:12px;line-height:1.65}.recruit-mos-wow{padding-top:88px}.recruit-final-wow{padding:70px 6vw;background:#151a15;color:#eee3c6;display:grid;grid-template-columns:105px minmax(0,1fr) auto;gap:30px;align-items:center;border-top:1px solid rgba(211,184,112,.23)}.recruit-final-wow img{width:100px;max-height:110px;object-fit:contain}.recruit-final-wow>div>span{font-size:9px;letter-spacing:.14em;color:#b99e5d}.recruit-final-wow h2{font-family:'Stardos Stencil',serif;font-size:36px;line-height:1;margin:6px 0 10px}.recruit-final-wow p{font-size:12px;line-height:1.6;max-width:720px}.recruit-final-wow__actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
@media(max-width:1050px){.recruit-hero-wow{grid-template-columns:1fr;align-items:end}.recruit-hero-wow__orders{max-width:420px}.recruit-path-wow{grid-template-columns:repeat(3,1fr)}.recruit-promise-wow,.recruit-artifacts-wow{grid-template-columns:1fr}.recruit-offer-wow__grid{grid-template-columns:1fr}.recruit-artifacts-wow__desk{min-height:590px}.recruit-life-wow__grid{grid-template-columns:1fr}.recruit-final-wow{grid-template-columns:90px 1fr}.recruit-final-wow__actions{grid-column:1/-1;justify-content:flex-start}}
@media(max-width:700px){.recruit-hero-wow{min-height:760px;padding:64px 18px 70px}.recruit-hero-wow h1{font-size:62px}.recruit-hero-wow__lead{font-size:14px}.recruit-hero-wow__orders{transform:none}.recruit-path-wow{grid-template-columns:1fr 1fr;padding:12px 14px}.recruit-promise-wow,.recruit-offer-wow,.recruit-artifacts-wow,.recruit-replacement-wow,.recruit-life-wow{padding:58px 18px}.recruit-promise-wow__memo,.recruit-offer-card{padding:28px 22px;transform:none}.recruit-artifacts-wow__desk{min-height:680px}.recruit-artifact--orders{left:4%;top:5%;width:90%}.recruit-artifact--weapon{right:4%;top:45%;width:55%}.recruit-artifact--uniform{left:5%;right:auto;bottom:4%;width:37%}.recruit-final-wow{padding:50px 18px;grid-template-columns:65px 1fr;gap:18px}.recruit-final-wow img{width:62px}.recruit-final-wow h2{font-size:27px}}

/* ==========================================================================
   BATTALION COMMANDER MESSAGE — field letter overhaul
   ========================================================================== */
.commander-letter-overhaul{background:#1e241d}.commander-letter-field{position:relative;padding:76px 5vw 110px;min-height:100vh;overflow:hidden}.commander-letter-field__image{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover fixed no-repeat;filter:saturate(.7) brightness(.65)}.commander-letter-field__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(19,23,18,.83),rgba(29,35,26,.62)),linear-gradient(0deg,rgba(15,18,14,.75),rgba(15,18,14,.18))}.commander-letter-field__shell{position:relative;z-index:2;max-width:1480px;margin:auto}.commander-letter-field__title{max-width:1000px;color:#eee2c6;margin-bottom:28px}.commander-letter-field__title>span{font-size:10px;letter-spacing:.17em;color:#c3a45d}.commander-letter-field__title h1{font-family:'Stardos Stencil',serif;font-size:clamp(46px,6vw,82px);line-height:.92;margin:8px 0 12px;text-shadow:0 4px 14px rgba(0,0,0,.5)}.commander-letter-field__title p{font-size:14px;color:#d9cfb4}.commander-letter-layout{display:grid;grid-template-columns:minmax(0,980px) 330px;gap:34px;align-items:start}.commander-letter-paper{position:relative;padding:58px 72px 72px;background:linear-gradient(180deg,#eee5cf,#dccdac);box-shadow:0 26px 58px rgba(0,0,0,.48);transform:rotate(-.25deg)}.commander-letter-paper__clip{position:absolute;top:-13px;left:50%;width:118px;height:28px;background:rgba(196,183,151,.83);transform:translateX(-50%) rotate(-1deg);box-shadow:0 2px 5px rgba(0,0,0,.18)}.commander-letter-opening{padding:25px 0 12px}.commander-letter-opening>small{font-size:9px;letter-spacing:.14em;color:#6a5837;font-weight:700}.commander-letter-opening>p{font-size:16px;line-height:1.75}.commander-letter-opening blockquote{margin:25px 0 14px;padding:18px 22px;border-left:5px solid #715b35;background:rgba(184,159,103,.2);font:700 25px/1.38 'Courier Prime',monospace;color:#30291d}.commander-letter-section{padding:24px 0;border-top:1px solid rgba(92,74,43,.26)}.commander-letter-section h2{font-family:'Stardos Stencil',serif;font-size:27px;line-height:1.05;margin:0 0 13px;color:#282219}.commander-letter-section p{font-size:14px;line-height:1.82;margin:10px 0;color:#3c3426}.commander-letter-section--highlight{margin:16px -22px;padding:25px 22px;background:rgba(178,148,83,.16);border-top:2px solid rgba(112,87,45,.45);border-bottom:2px solid rgba(112,87,45,.35)}.commander-letter-section--quote{background:rgba(255,255,255,.15);padding-left:20px;padding-right:20px}.commander-letter-values{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}.commander-letter-values span{padding:10px 12px;border:1px solid rgba(92,74,43,.3);font:700 11px 'Courier Prime',monospace;letter-spacing:.06em;color:#493d2a}.commander-letter-final h2{font-size:34px}.commander-letter-final__call{display:block;margin-top:22px;padding:14px 16px;border-top:2px solid #55452c;border-bottom:2px solid #55452c;font-size:15px;letter-spacing:.05em;text-align:center}.commander-letter-signature{display:grid;gap:3px;margin-top:32px;padding-top:23px;border-top:1px solid rgba(89,72,42,.32);max-width:380px}.commander-letter-signature span{font-size:11px}.commander-letter-signature strong{font-size:20px}.commander-letter-signature small{font-size:10px}.commander-letter-stamp{position:absolute;right:62px;bottom:46px;border:3px double #76352b;color:#76352b;padding:8px 13px;text-align:center;font:700 11px 'Courier Prime',monospace;letter-spacing:.08em;transform:rotate(-7deg);mix-blend-mode:multiply}.commander-recruit-board{position:sticky;top:100px;display:grid;gap:22px}.commander-recruit-card,.commander-recruit-note{position:relative;padding:28px 25px;background:linear-gradient(180deg,#b39960,#a3874d);color:#251f14;box-shadow:0 18px 36px rgba(0,0,0,.4);font-family:'Courier Prime',monospace;transform:rotate(1deg)}.commander-recruit-card:before,.commander-recruit-note:before{content:"";position:absolute;top:-9px;left:50%;width:78px;height:19px;background:rgba(211,196,159,.8);transform:translateX(-50%) rotate(-2deg)}.commander-recruit-card>small,.commander-recruit-note>span{font-size:9px;letter-spacing:.14em;font-weight:700}.commander-recruit-card h2{font-size:24px;line-height:1.05;margin:9px 0 15px}.commander-recruit-card ul{padding-left:18px;margin:0;display:grid;gap:8px}.commander-recruit-card li{font-size:11px;line-height:1.5}.commander-recruit-order{padding:26px 24px;transform:rotate(-.5deg)}.commander-recruit-order header{border-bottom:2px solid #56472f;padding-bottom:9px;margin-bottom:12px}.commander-recruit-order header>*{display:block}.commander-recruit-order p{font-size:12px;line-height:1.65}.commander-recruit-order .paper-action{margin-top:12px;width:100%;justify-content:center}.commander-recruit-note{background:linear-gradient(180deg,#c0a56a,#ad9257);transform:rotate(-1.2deg)}.commander-recruit-note strong{display:block;font-size:20px;line-height:1.08;margin:9px 0 12px}.commander-recruit-note p{font-size:11px;line-height:1.6}
@media(max-width:1100px){.commander-letter-layout{grid-template-columns:1fr}.commander-recruit-board{position:relative;top:auto;grid-template-columns:repeat(3,1fr)}.commander-letter-paper{transform:none}}
@media(max-width:800px){.commander-letter-field{padding:55px 16px 80px}.commander-letter-paper{padding:44px 26px 60px}.commander-letter-field__title h1{font-size:48px}.commander-letter-opening blockquote{font-size:20px}.commander-letter-section h2{font-size:24px}.commander-letter-values{grid-template-columns:1fr}.commander-recruit-board{grid-template-columns:1fr}.commander-letter-stamp{position:relative;right:auto;bottom:auto;display:inline-block;margin-top:25px}}


/* ===== AUG 2026 PUBLIC PAGE OVERHAUL ===== */
.public-home-wow{background:#141915}
.wow-home-hero{position:relative;overflow:hidden;min-height:860px;padding:88px 6vw 88px}
.wow-home-hero__bg{position:absolute;inset:0;background:url('/static/art/homepage-background.webp') center/cover no-repeat;transform:scale(1.02)}
.wow-home-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,14,11,.90) 0%,rgba(16,20,15,.74) 38%,rgba(19,23,18,.38) 72%,rgba(10,12,10,.62) 100%),linear-gradient(180deg,rgba(10,12,10,.12),rgba(10,12,10,.72))}
.wow-home-hero__inner{position:relative;z-index:2;max-width:1460px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:34px;align-items:end}
.wow-home-hero__copy{max-width:860px;color:#efe6d0}
.wow-home-hero__eyebrow{display:block;font:700 11px 'Courier Prime',monospace;letter-spacing:.18em;color:#d0b06e;margin-bottom:16px}
.wow-home-hero h1{font-family:'Stardos Stencil',serif;font-size:clamp(58px,7vw,108px);line-height:.84;margin:0 0 20px;color:#f5ead2;text-shadow:0 5px 18px rgba(0,0,0,.55)}
.wow-home-hero__lead{max-width:760px;font-size:17px;line-height:1.75;color:#ede2c8}
.wow-home-hero__actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}
.wow-home-hero__highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:28px}
.wow-home-hero__highlights article{padding:18px 18px;background:rgba(235,225,201,.10);border:1px solid rgba(217,189,126,.22);backdrop-filter:blur(2px)}
.wow-home-hero__highlights strong{display:block;font-size:13px;letter-spacing:.08em;color:#f3dd9d;margin-bottom:8px}
.wow-home-hero__highlights span{display:block;font-size:13px;line-height:1.55;color:#e9dfc7}
.wow-home-arrival{padding:28px 26px;background:linear-gradient(180deg,#efe4ca,#d7c7a3);box-shadow:0 24px 48px rgba(0,0,0,.42);align-self:end}
.wow-home-arrival small{display:block;font-size:10px;letter-spacing:.16em;color:#6e5a36;font-weight:700}
.wow-home-arrival h2{font-family:'Stardos Stencil',serif;font-size:36px;line-height:.95;margin:10px 0 14px;color:#292116}
.wow-home-arrival p{font-size:13px;line-height:1.65;color:#362e21}
.wow-home-arrival ol{margin:16px 0 16px;padding:0;list-style:none;display:grid;gap:12px}
.wow-home-arrival li{display:grid;gap:3px;padding-bottom:11px;border-bottom:1px solid rgba(86,69,39,.22)}
.wow-home-arrival li:last-child{padding-bottom:0;border-bottom:0}
.wow-home-arrival b{font-size:12px;letter-spacing:.05em;color:#241d12}
.wow-home-arrival span{font-size:12px;line-height:1.5;color:#3d3425}
.wow-home-tourstrip{display:grid;grid-template-columns:repeat(6,1fr);background:rgba(17,23,18,.92);border-top:1px solid rgba(211,181,109,.18);border-bottom:1px solid rgba(211,181,109,.18)}
.wow-home-tourstrip article{padding:20px 18px 18px;border-right:1px solid rgba(211,181,109,.13)}
.wow-home-tourstrip article:last-child{border-right:0}.wow-home-tourstrip span{display:block;font-family:'Stardos Stencil',serif;font-size:34px;color:#cea75a}.wow-home-tourstrip b{display:block;margin-top:6px;font-size:11px;letter-spacing:.12em;color:#f0e4c8}.wow-home-tourstrip small{display:block;margin-top:6px;font-size:11px;line-height:1.5;color:#c8bca0}
.wow-home-difference,.wow-home-offer,.wow-home-needs{padding:74px 6vw}.wow-home-difference__grid,.wow-home-offer__grid,.wow-home-needs__grid{display:grid;gap:22px}
.wow-home-difference__grid{grid-template-columns:repeat(3,1fr);margin-top:24px}.wow-home-difference__grid article,.wow-home-offer__grid article,.wow-home-needs__grid article{padding:28px 24px}.wow-home-difference__grid small,.wow-home-offer__grid b,.wow-home-needs__grid small{font-size:11px;letter-spacing:.14em;color:#6b5938;font-weight:700}.wow-home-difference__grid h3,.wow-home-needs__grid h3{font-family:'Stardos Stencil',serif;font-size:28px;line-height:1.02;margin:12px 0;color:#262116}.wow-home-difference__grid p,.wow-home-offer__grid p,.wow-home-needs__grid p{font-size:14px;line-height:1.72;color:#3a3124}
.wow-home-offer{display:grid;grid-template-columns:360px 1fr;gap:26px;align-items:start;background:linear-gradient(180deg,rgba(236,228,209,.03),rgba(236,228,209,.01))}.wow-home-offer__intro span{display:block;font-size:11px;letter-spacing:.16em;color:#d3ae69}.wow-home-offer__intro h2{font-family:'Stardos Stencil',serif;font-size:50px;line-height:.92;margin:14px 0 18px;color:#efe3c6}.wow-home-offer__intro p{font-size:15px;line-height:1.72;color:#d8ccb2}.wow-home-offer__grid{grid-template-columns:repeat(2,1fr)}.wow-home-offer__grid b{display:block;font-family:'Stardos Stencil',serif;font-size:28px;letter-spacing:0;color:#262116;margin-bottom:10px}
.wow-home-needs__grid{grid-template-columns:repeat(3,1fr);margin-top:24px}.wow-home-needs__empty{grid-column:1/-1}
.wow-home-final{max-width:1320px;margin:0 auto 82px;padding:42px 40px;text-align:center}.wow-home-final small{display:block;font-size:11px;letter-spacing:.18em;color:#6b5938;font-weight:700}.wow-home-final h2{font-family:'Stardos Stencil',serif;font-size:48px;line-height:.95;margin:14px auto 16px;max-width:980px;color:#292116}.wow-home-final p{max-width:860px;margin:0 auto;font-size:15px;line-height:1.75;color:#3e3426}.wow-home-final__actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:24px}

.whyjoin-wow{background:#161b17}
.whyjoin-hero{position:relative;padding:84px 6vw 88px;overflow:hidden}
.whyjoin-hero__image{position:absolute;inset:0;background:url('/static/art/hq-field-desk.webp') center/cover fixed no-repeat;filter:brightness(.62) saturate(.78)}
.whyjoin-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(14,17,13,.88),rgba(18,22,17,.58) 46%,rgba(14,17,13,.7) 100%)}
.whyjoin-hero__inner{position:relative;z-index:2;max-width:1460px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:32px;align-items:end}
.whyjoin-hero__copy{max-width:860px;color:#f0e5cb}.whyjoin-hero__copy>span{display:block;font-size:11px;letter-spacing:.16em;color:#cfaf69}.whyjoin-hero__copy h1{font-family:'Stardos Stencil',serif;font-size:clamp(58px,7vw,96px);line-height:.86;margin:12px 0 16px}.whyjoin-hero__copy p{max-width:760px;font-size:17px;line-height:1.75;color:#e4d7b9}.whyjoin-hero__actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px}
.whyjoin-hero__board{padding:28px 26px;background:linear-gradient(180deg,#eee3c7,#d8c7a2)}.whyjoin-hero__board small{display:block;font-size:10px;letter-spacing:.16em;font-weight:700;color:#6c5938}.whyjoin-hero__board h2{font-family:'Stardos Stencil',serif;font-size:34px;line-height:.96;margin:10px 0 15px;color:#2a2217}.whyjoin-hero__board ul{margin:0;padding-left:18px;display:grid;gap:10px}.whyjoin-hero__board li{font-size:12px;line-height:1.55;color:#372f22}
.whyjoin-reasons{padding:26px 6vw 0;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.whyjoin-reasons article{padding:26px 24px}.whyjoin-reasons small{display:block;font-family:'Stardos Stencil',serif;font-size:34px;color:#b18846}.whyjoin-reasons h3{font-family:'Stardos Stencil',serif;font-size:28px;line-height:1.02;margin:10px 0;color:#292216}.whyjoin-reasons p{font-size:14px;line-height:1.75;color:#3b3225}
.whyjoin-letterwrap{padding:70px 6vw 86px;display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:26px;align-items:start}.whyjoin-letter{padding:52px 58px}.whyjoin-letter section{padding:22px 0;border-top:1px solid rgba(90,74,45,.22)}.whyjoin-letter section:first-of-type{border-top:0;padding-top:18px}.whyjoin-letter h2{font-family:'Stardos Stencil',serif;font-size:34px;line-height:.98;margin:0 0 14px;color:#282116}.whyjoin-letter p{font-size:15px;line-height:1.82;color:#3b3326}.whyjoin-letter blockquote{margin:20px 0 6px;padding:18px 20px;border-left:5px solid #745d34;background:rgba(176,148,87,.15);font:700 24px/1.4 'Courier Prime',monospace;color:#30281b}.whyjoin-values{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.whyjoin-values span{padding:10px 12px;border:1px solid rgba(95,75,42,.28);font:700 11px 'Courier Prime',monospace;letter-spacing:.06em;color:#473b29}.whyjoin-letter__final strong{display:block;margin-top:22px;padding:14px 16px;border-top:2px solid #55452c;border-bottom:2px solid #55452c;font-size:15px;letter-spacing:.05em;text-align:center;color:#2b2318}
.whyjoin-side{display:grid;gap:20px;position:sticky;top:98px}.whyjoin-side article{padding:26px 24px}.whyjoin-side small{display:block;font-size:10px;letter-spacing:.16em;font-weight:700;color:#6a5938}.whyjoin-side h3{font-family:'Stardos Stencil',serif;font-size:30px;line-height:.98;margin:11px 0 14px;color:#292116}.whyjoin-side p,.whyjoin-side li{font-size:13px;line-height:1.68;color:#3b3225}.whyjoin-side ul{padding-left:18px;margin:0;display:grid;gap:8px}.whyjoin-side__cta .paper-action{margin-top:12px;width:100%;justify-content:center}

.about-wow2{background:#161c17}
.about-wow-hero{position:relative;min-height:820px;padding:86px 6vw 90px;background:url('/static/art/about-15-cav-hero.webp') center/cover no-repeat;overflow:hidden}
.about-wow-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,19,15,.90) 0%,rgba(19,23,18,.64) 46%,rgba(17,20,16,.44) 100%),linear-gradient(180deg,rgba(10,12,10,.1),rgba(10,12,10,.72))}
.about-wow-hero__inner{position:relative;z-index:2;max-width:1460px;margin:0 auto;display:grid;grid-template-columns:minmax(0,760px) 330px;gap:32px;align-items:end}
.about-wow-hero__paper{padding:44px 46px;background:linear-gradient(180deg,#efe4ca,#d8c9a8);box-shadow:0 24px 52px rgba(0,0,0,.42)}.about-wow-hero__eyebrow{font-size:11px;letter-spacing:.16em;font-weight:700;color:#6f5a38;margin:16px 0 10px}.about-wow-hero__paper h1{font-family:'Stardos Stencil',serif;font-size:clamp(48px,6vw,80px);line-height:.92;margin:0 0 16px;color:#292216}.about-wow-hero__lead{font-size:15px;line-height:1.78;color:#3a3124}.about-wow-hero__actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px}
.about-wow-hero__board{padding:28px 26px;background:linear-gradient(180deg,#b59b63,#a98d54);align-self:end}.about-wow-hero__board small{display:block;font-size:10px;letter-spacing:.16em;font-weight:700;color:#2c2418}.about-wow-hero__board h2{font-family:'Stardos Stencil',serif;font-size:34px;line-height:.97;margin:10px 0 14px;color:#20190f}.about-wow-hero__board ul{list-style:none;padding:0;margin:0;display:grid;gap:12px}.about-wow-hero__board li{padding-bottom:10px;border-bottom:1px solid rgba(53,40,19,.20)}.about-wow-hero__board li:last-child{border-bottom:0;padding-bottom:0}.about-wow-hero__board b,.about-wow-hero__board span{display:block}.about-wow-hero__board b{font-size:12px;letter-spacing:.06em;color:#241d12}.about-wow-hero__board span{font-size:12px;line-height:1.5;color:#30271b;margin-top:4px}
.about-wow-pillars,.about-wow-offer,.about-wow-flow{padding:72px 6vw}.about-wow-pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.about-wow-pillars article,.about-wow-offer__grid article,.about-wow-flow__copy,.about-wow-flow__steps article{padding:28px 24px}.about-wow-pillars small{display:block;font-size:11px;letter-spacing:.15em;color:#6c5937;font-weight:700}.about-wow-pillars h3,.about-wow-offer__grid h3{font-family:'Stardos Stencil',serif;font-size:28px;line-height:1.02;margin:12px 0;color:#272116}.about-wow-pillars p,.about-wow-offer__grid p,.about-wow-flow__copy p,.about-wow-flow__steps p{font-size:14px;line-height:1.72;color:#3b3225}
.about-wow-offer__grid{margin-top:24px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.about-wow-flow{display:grid;grid-template-columns:340px 1fr;gap:26px;align-items:start}.about-wow-flow__copy small{display:block;font-size:11px;letter-spacing:.16em;color:#6c5938;font-weight:700}.about-wow-flow__copy h2{font-family:'Stardos Stencil',serif;font-size:44px;line-height:.92;margin:12px 0 16px;color:#292216}.about-wow-flow__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.about-wow-flow__steps span{display:block;font-family:'Stardos Stencil',serif;font-size:34px;color:#b38743}.about-wow-flow__steps b{display:block;margin:8px 0 10px;font-size:12px;letter-spacing:.12em;color:#2c2417}
.about-wow-final{max-width:1320px;margin:0 auto 82px;padding:42px 40px;text-align:center}.about-wow-final small{display:block;font-size:11px;letter-spacing:.18em;color:#6b5938;font-weight:700}.about-wow-final h2{font-family:'Stardos Stencil',serif;font-size:48px;line-height:.95;margin:14px auto 16px;max-width:980px;color:#292116}.about-wow-final p{max-width:860px;margin:0 auto;font-size:15px;line-height:1.75;color:#3e3426}.about-wow-final__actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:24px}

@media(max-width:1180px){
  .wow-home-hero__inner,.whyjoin-hero__inner,.whyjoin-letterwrap,.about-wow-hero__inner,.about-wow-flow,.wow-home-offer{grid-template-columns:1fr}
  .wow-home-hero__highlights,.about-wow-pillars,.wow-home-difference__grid,.whyjoin-reasons{grid-template-columns:1fr 1fr}
  .wow-home-offer__grid,.about-wow-offer__grid,.about-wow-flow__steps,.wow-home-needs__grid{grid-template-columns:1fr 1fr}
  .wow-home-tourstrip{grid-template-columns:repeat(3,1fr)}
  .whyjoin-side{position:static}
}
@media(max-width:760px){
  .wow-home-hero,.whyjoin-hero,.about-wow-hero{padding:62px 18px 68px;min-height:unset}
  .wow-home-hero h1,.whyjoin-hero__copy h1{font-size:56px}
  .wow-home-hero__lead,.whyjoin-hero__copy p,.about-wow-hero__lead{font-size:14px}
  .wow-home-hero__highlights,.about-wow-pillars,.wow-home-difference__grid,.whyjoin-reasons,.wow-home-offer__grid,.about-wow-offer__grid,.about-wow-flow__steps,.wow-home-needs__grid,.whyjoin-values{grid-template-columns:1fr}
  .wow-home-tourstrip{grid-template-columns:1fr 1fr}
  .wow-home-difference,.wow-home-offer,.wow-home-needs,.whyjoin-letterwrap,.about-wow-pillars,.about-wow-offer,.about-wow-flow{padding:54px 18px}
  .wow-home-arrival,.whyjoin-hero__board,.about-wow-hero__paper,.about-wow-hero__board,.whyjoin-letter,.whyjoin-side article,.wow-home-difference__grid article,.wow-home-offer__grid article,.wow-home-needs__grid article,.about-wow-pillars article,.about-wow-offer__grid article,.about-wow-flow__copy,.about-wow-flow__steps article,.wow-home-final,.about-wow-final{padding:26px 22px}
  .about-wow-hero__actions,.wow-home-hero__actions,.whyjoin-hero__actions,.wow-home-final__actions,.about-wow-final__actions{flex-direction:column;align-items:stretch}
  .wow-home-offer__intro h2,.about-wow-flow__copy h2,.wow-home-final h2,.about-wow-final h2{font-size:34px}
  .whyjoin-letter h2,.wow-home-difference__grid h3,.about-wow-pillars h3,.about-wow-offer__grid h3{font-size:26px}
}

/* ======================================================================
   MOBILE MASTER PASS — AUG 2026
   Deliberate phone/tablet layouts across public, member and staff views.
   ====================================================================== */
html{overflow-x:hidden}
body{overflow-x:hidden}
img,svg,video,canvas{max-width:100%;height:auto}

/* Let any truly wide operational table scroll rather than crush its text. */
.mobile-scroll,.table-scroll,.roster-scroll,.ledger-scroll{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}

@media(max-width:900px){
  /* HEADER / PRIMARY NAVIGATION */
  .battalion-header{position:relative;z-index:80}
  .unit-wire{min-height:22px;padding:4px 14px;justify-content:center;text-align:center}
  .unit-wire span{font-size:7px;letter-spacing:.07em}
  .unit-wire span:not(:nth-child(2)){display:none}
  .header-desk{min-height:78px;padding:8px 14px;gap:10px}
  .unit-mark{min-width:0;flex:1;gap:9px}
  .unit-mark img{width:54px;height:54px;object-fit:contain}
  .unit-mark-copy{display:grid;min-width:0}
  .unit-mark-copy strong{font-size:15px;line-height:1.05;white-space:normal}
  .unit-mark-copy small{font-size:7px;line-height:1.35;white-space:normal}
  .index-button{display:block;flex:0 0 auto;min-height:44px;padding:10px 12px;font-size:10px;letter-spacing:.05em}
  .record-index{display:none;position:absolute;top:100%;left:0;right:0;z-index:90;margin:0;padding:10px 12px 14px;background:#1d231d;border-top:1px solid #635b40;border-bottom:2px solid #8d7847;box-shadow:0 18px 28px rgba(0,0,0,.55);max-height:calc(100vh - 100px);overflow-y:auto;flex-direction:column;align-items:stretch;gap:6px}
  .record-index.open{display:flex}
  .record-index a,.record-index .duty-tab{display:flex;align-items:center;justify-content:space-between;width:100%;box-sizing:border-box;min-height:46px;margin:0!important;padding:12px 14px!important;font-size:11px!important;text-align:left}
  .record-index a[aria-current="page"]{border-color:#d0ae61;background:#4b4935;color:#fff2ca}

  /* COMMAND WORKSPACE: thumb-friendly horizontal rail */
  .command-global-bar{position:relative;z-index:60}
  .command-global-bar-inner{width:100%;min-height:auto;padding:8px 10px;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
  .command-global-label{min-width:150px;padding-right:12px;margin-right:0;scroll-snap-align:start}
  .command-global-label small{font-size:8px}.command-global-label b{font-size:12px}
  .command-global-bar a{min-width:112px;min-height:48px;box-sizing:border-box;padding:8px 10px;display:grid;align-content:center;gap:3px;scroll-snap-align:start}
  .command-global-bar a b{font-size:11px}.command-global-bar a small{display:block;font-size:8px;opacity:.72}

  /* GLOBAL PAGE FRAME */
  main{max-width:100%;overflow-x:hidden}
  .command-global-view main>section:not(.command-hq-hero),
  .command-global-view main>article,
  .command-global-view main>.page-shell,
  .command-global-view main>.workspace,
  .command-global-view main>.office-shell,
  .command-global-view main>.records-room{width:calc(100% - 24px)!important;max-width:none!important}
  .staff-workspace,.commander-table,.records-office,.operations-room,.training-office,.supply-workbench,.orderly-room,.company-office,.orders-archive,.morning-desk,.recruit-processing{padding-left:12px!important;padding-right:12px!important}

  /* Prevent grids from creating microscopic columns. */
  .command-main-grid,.command-secondary-grid,.battalion-control-grid,.replacement-processing-desk,.progression-tracks,.public-artifact-grid,.about-public-body,
  .operation-side-files,.operation-grid,.training-grid,.supply-grid,.personnel-grid,.staff-grid{grid-template-columns:1fr!important}

  /* FORMS */
  form{max-width:100%}
  input:not([type=checkbox]):not([type=radio]),select,textarea,button{max-width:100%;box-sizing:border-box}
  input:not([type=checkbox]):not([type=radio]),select,textarea{font-size:16px!important} /* avoids iOS zoom */
  .command-form-two,.command-change-form,.form-grid,.field-grid,.recruiting-form-grid,.application-grid{grid-template-columns:1fr!important}
  .command-change-form .command-form-wide,.command-change-form button{grid-column:auto!important}
  button,.paper-action,.action-button,.staff-action{min-height:44px}

  /* TABLES / LEDGERS */
  table{display:block;width:100%;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;white-space:nowrap}
  .roster-table,.command-ledger-row,.command-section-row,.promotion-board-head,.promotion-board-row{min-width:0}
  .command-ledger-row,.command-section-row{grid-template-columns:1fr!important;gap:5px!important;padding:14px 4px!important}
  .command-ledger-row time,.command-section-row small{text-align:left!important}

  /* MEMBER RECORD */
  .member-record-desk{grid-template-columns:1fr!important;width:calc(100% - 20px)!important;padding-left:0!important;padding-right:0!important}
  .member-summary-jacket,.member-paper,.appointments-member-paper,.operations-member-paper,.leave-member-paper,.replacement-training-paper,.promotion-eligibility-paper,.service-member-paper{grid-column:1!important;transform:none!important}
  .member-record-identity h1{font-size:clamp(34px,10vw,48px)!important}
  .member-summary-jacket dl,.member-mini-grid,.assignment-block,.replacement-file-grid{grid-template-columns:1fr!important}
  .member-uniform-visual{height:330px!important}
  .member-order-line{grid-template-columns:1fr!important}.member-order-line small{grid-column:1!important}

  /* BILLET STRENGTH */
  .billet-command-shell{padding-left:12px!important;padding-right:12px!important}
  .billet-overview-grid,.billet-unit-grid{grid-template-columns:1fr!important}
  .billet-stat-strip{grid-template-columns:1fr 1fr!important}
  .billet-role-table{grid-template-columns:minmax(150px,1fr) 58px 58px 58px 62px!important;overflow-x:auto}
}

@media(max-width:620px){
  /* Smaller phones */
  .header-desk{min-height:70px;padding:7px 10px}
  .unit-mark img{width:48px;height:48px}
  .unit-mark-copy strong{font-size:13px}.unit-mark-copy small{font-size:6px}
  .index-button{font-size:9px;padding:9px 10px}

  /* PUBLIC HOME */
  .wow-home-hero{padding:44px 14px 52px!important;background:#151a16}
  .wow-home-hero__bg{background-position:58% center}
  .wow-home-hero__shade{background:linear-gradient(180deg,rgba(10,13,10,.55),rgba(10,13,10,.88) 72%,rgba(10,13,10,.94))}
  .wow-home-hero__inner{display:block!important}
  .wow-home-hero h1{font-size:clamp(42px,13vw,58px)!important;line-height:.9!important;margin-top:8px}
  .wow-home-hero__eyebrow{font-size:9px;line-height:1.5}
  .wow-home-hero__lead{font-size:14px!important;line-height:1.65!important}
  .wow-home-hero__actions{display:grid!important;grid-template-columns:1fr!important}
  .wow-home-hero__actions .paper-action{width:100%;justify-content:center;text-align:center}
  .wow-home-hero__highlights{grid-template-columns:1fr!important;margin-top:18px!important}
  .wow-home-arrival{margin-top:22px!important;padding:22px 18px!important;transform:none!important}
  .wow-home-arrival h2{font-size:30px}
  .wow-home-tourstrip{grid-template-columns:1fr!important}
  .wow-home-tourstrip article{display:grid;grid-template-columns:48px 1fr;gap:2px 10px;border-right:0;border-bottom:1px solid rgba(211,181,109,.13);padding:14px 16px}
  .wow-home-tourstrip article span{grid-row:1/3;font-size:30px}.wow-home-tourstrip article b,.wow-home-tourstrip article small{grid-column:2;margin-top:0}
  .wow-home-difference,.wow-home-offer,.wow-home-needs{padding:42px 14px!important}
  .wow-home-offer__intro h2{font-size:32px!important}
  .wow-home-final{width:calc(100% - 28px);box-sizing:border-box;margin-bottom:52px!important;padding:28px 18px!important}
  .wow-home-final h2{font-size:31px!important}

  /* WHY JOIN */
  .whyjoin-hero{padding:44px 14px 50px!important}
  .whyjoin-hero__image{background-attachment:scroll;background-position:center}
  .whyjoin-hero__copy h1{font-size:clamp(43px,13vw,60px)!important;line-height:.9!important}
  .whyjoin-hero__copy>span{font-size:9px;line-height:1.5}
  .whyjoin-hero__actions{display:grid!important;grid-template-columns:1fr!important}
  .whyjoin-hero__actions .paper-action{width:100%;justify-content:center;text-align:center}
  .whyjoin-hero__board{margin-top:20px;padding:22px 18px!important}
  .whyjoin-reasons{padding:18px 14px 0!important;grid-template-columns:1fr!important}
  .whyjoin-letterwrap{padding:40px 14px 56px!important}
  .whyjoin-letter{padding:30px 20px!important}
  .whyjoin-letter h2{font-size:25px!important;line-height:1.05!important}
  .whyjoin-letter p{font-size:14px!important;line-height:1.7!important}
  .whyjoin-letter blockquote{font-size:18px!important;padding:14px 14px!important}
  .whyjoin-side{gap:14px}

  /* ABOUT */
  .about-wow-hero{padding:44px 14px 52px!important;background-position:54% center}
  .about-wow-hero__inner{display:block!important}
  .about-wow-hero__paper{padding:24px 18px!important}
  .about-wow-hero__paper h1{font-size:clamp(42px,12vw,58px)!important}
  .about-wow-hero__actions{display:grid!important;grid-template-columns:1fr!important}
  .about-wow-hero__actions .paper-action{width:100%;justify-content:center;text-align:center}
  .about-wow-hero__board{margin-top:20px;padding:22px 18px!important}
  .about-wow-pillars,.about-wow-offer,.about-wow-flow{padding:42px 14px!important}
  .about-wow-final{width:calc(100% - 28px);box-sizing:border-box;margin-bottom:52px!important;padding:28px 18px!important}
  .about-wow-final h2{font-size:31px!important}

  /* RECRUITING / APPLICATION */
  .recruit-processing,.public-recruiting-hub,.recruiting-case-shell,.recruiting-control-shell{max-width:100%!important}
  .replacement-check-grid,.recruiting-form-grid,.recruiting-control-grid,.recruiting-case-grid{grid-template-columns:1fr!important}
  .recruiting-form-card,.recruiting-case-card,.recruiting-control-card{padding:20px 16px!important}
  .application-option-grid,.radio-grid,.checkbox-grid{grid-template-columns:1fr!important}

  /* COMMAND / STAFF */
  .command-global-view main{padding-bottom:46px}
  .command-global-view main h1{font-size:clamp(32px,10vw,44px)!important}
  .command-global-view main h2{font-size:24px!important}
  .command-panel{padding:20px 15px!important}
  .command-status-grid{grid-template-columns:1fr 1fr!important;gap:10px!important}
  .command-status-card{padding:14px!important;min-height:100px!important}
  .command-status-card strong{font-size:28px!important}
  .command-desk-shortcuts{grid-template-columns:1fr!important}
  .brief-strength,.strength-blocks{grid-template-columns:1fr 1fr!important}
  .promotion-board-head{display:none!important}
  .promotion-board-row{grid-template-columns:1fr!important;gap:5px!important;padding:12px 0!important}

  /* PERSONNEL ACTIONS */
  .action-control-tabs,.action-tab-bar,.workspace-tabs{display:flex!important;gap:8px!important;overflow-x:auto!important;-webkit-overflow-scrolling:touch;padding-bottom:6px}
  .action-control-tabs a,.action-tab-bar a,.workspace-tabs a{flex:0 0 auto;min-width:120px;min-height:44px}
  .action-row,.action-ledger-row,.routing-row{grid-template-columns:1fr!important}

  /* BILLETS */
  .billet-stat-strip{grid-template-columns:1fr!important}
  .billet-focus-card{grid-template-columns:1fr!important}.billet-focus-number{text-align:left!important}
  .billet-role-table{display:grid!important;grid-template-columns:minmax(130px,1fr) 50px 50px 50px 56px!important;width:620px;max-width:none}
  .billet-unit-card{overflow-x:auto!important;-webkit-overflow-scrolling:touch}

  /* OFFICIAL DOCUMENTS: preserve full document while allowing pan/zoom by browser. */
  .official-order-room{padding:24px 8px!important;overflow-x:auto}
  .vietnam-order-document{width:920px!important;max-width:none!important;margin-left:0!important}
  .official-order-sheet{width:760px!important;max-width:none!important;padding:48px 44px 72px!important}

  /* FOOTER */
  .battalion-footer{display:grid!important;grid-template-columns:1fr!important;gap:14px!important;padding:24px 16px 34px!important;text-align:center}
  .footer-filemark{justify-content:center}.footer-address,.footer-motto{text-align:center!important}
  .footer-staff-access{position:static!important;display:inline-block;margin-top:4px}
}

@media(max-width:390px){
  .unit-mark-copy small{display:none}
  .unit-mark-copy strong{font-size:12px}
  .index-button{font-size:8px}
  .command-status-grid,.brief-strength,.strength-blocks{grid-template-columns:1fr!important}
  .wow-home-hero h1,.whyjoin-hero__copy h1{font-size:42px!important}
}


/* ======================================================================
   PUBLIC FIELD-HQ OVERHAUL — Vietnam tent / field desk presentation
   ====================================================================== */
.field-hq-public{background:#151a15;color:#eee3c8}
.field-hq-public main{background:#151a15}
.fieldhero{position:relative;min-height:780px;overflow:hidden;display:flex;align-items:flex-end;padding:82px 6vw 90px}
.fieldhero__image{position:absolute;inset:0;background:url('/static/art/homepage-background.webp') center/cover no-repeat;transform:scale(1.015)}
.fieldhero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,12,9,.88) 0%,rgba(12,16,11,.70) 43%,rgba(13,17,12,.24) 72%,rgba(10,12,9,.55) 100%),linear-gradient(0deg,rgba(8,11,8,.78),transparent 52%)}
.fieldhero__content{position:relative;z-index:2;width:min(780px,92vw);padding-left:20px;border-left:3px solid #c9a45c}
.fieldhero__kicker{display:block;font:700 10px 'Courier Prime',monospace;letter-spacing:.18em;color:#d5b66b;margin-bottom:14px}
.fieldhero h1{font-family:'Stardos Stencil',serif;font-size:clamp(66px,8vw,112px);line-height:.82;margin:0 0 20px;color:#f4e8cc;text-shadow:0 4px 18px rgba(0,0,0,.55)}
.fieldhero__content>p{max-width:720px;font-size:17px;line-height:1.7;color:#e9ddc1;text-shadow:0 2px 5px rgba(0,0,0,.55)}
.fieldhero__actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:24px}
.arrival-tag{position:absolute;z-index:2;right:6vw;bottom:92px;width:300px;padding:25px 23px;background:linear-gradient(180deg,#baa064,#a88b50);color:#251f14;box-shadow:0 22px 44px rgba(0,0,0,.45);transform:rotate(1deg)}
.arrival-tag:before{content:"";position:absolute;left:50%;top:-10px;width:88px;height:20px;background:rgba(210,195,157,.8);transform:translateX(-50%) rotate(-2deg)}
.arrival-tag small{font-size:9px;letter-spacing:.15em;font-weight:700}.arrival-tag strong{display:block;font:700 26px/1.02 'Stardos Stencil',serif;margin:10px 0}.arrival-tag p{font-size:12px;line-height:1.62;margin:0}

.tent-room{position:relative;padding:90px 6vw 105px;overflow:hidden;background:url('/static/art/hq-field-desk.webp') center/cover fixed no-repeat}
.tent-room__shade{position:absolute;inset:0;background:linear-gradient(rgba(17,22,16,.82),rgba(15,19,14,.92))}
.tent-room__inner{position:relative;z-index:2;max-width:1380px;margin:0 auto}
.tent-intro{max-width:860px;color:#eee1c3;margin-bottom:36px}.tent-intro span{font-size:10px;letter-spacing:.16em;color:#caa65e;font-weight:700}.tent-intro h2{font-family:'Stardos Stencil',serif;font-size:clamp(42px,5vw,68px);line-height:.9;margin:10px 0 16px}.tent-intro p{font-size:16px;line-height:1.72;color:#d8cbae;max-width:780px}
.field-desk-layout{position:relative;min-height:620px}
.desk-dossier{position:absolute;left:3%;top:30px;width:min(720px,58%);padding:38px 40px;z-index:3;box-shadow:0 22px 44px rgba(0,0,0,.4);transform:rotate(-.45deg)}
.dossier-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:22px;border-top:1px solid rgba(74,61,39,.35)}.dossier-columns>div{padding:20px 18px;border-right:1px solid rgba(74,61,39,.25)}.dossier-columns>div:last-child{border-right:0}.dossier-columns small{font-size:9px;letter-spacing:.14em;color:#6a5836;font-weight:700}.dossier-columns h3{font-family:'Stardos Stencil',serif;font-size:27px;margin:7px 0 9px;color:#292116}.dossier-columns p{font-size:12px;line-height:1.65;color:#3a3123}
.desk-photo{position:absolute;margin:0;padding:14px;background:#d6c5a1;color:#30271b;box-shadow:0 20px 38px rgba(0,0,0,.38)}.desk-photo img{display:block;width:100%;height:100%;object-fit:contain}.desk-photo figcaption{font:700 9px/1.4 'Courier Prime',monospace;letter-spacing:.07em;margin-top:8px}.desk-photo-orders{right:2%;top:0;width:430px;transform:rotate(2deg);z-index:2}.desk-photo-rifle{right:9%;bottom:20px;width:430px;transform:rotate(-2deg);z-index:4}.desk-photo-rifle img{background:linear-gradient(#69705c,#4c5242);padding:18px;box-sizing:border-box}

.tour-route{padding:80px 6vw;background:#232a21;color:#eee1c4}.tour-route>header{max-width:900px;margin:0 auto 38px;text-align:center}.tour-route>header span{font-size:10px;letter-spacing:.17em;color:#c9a65e}.tour-route>header h2{font-family:'Stardos Stencil',serif;font-size:clamp(40px,5vw,62px);line-height:.92;margin:11px 0}.tour-route__line{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);gap:0;border-top:2px solid #8b7647}.tour-route__line article{position:relative;padding:28px 22px 20px;border-right:1px solid rgba(222,203,157,.17)}.tour-route__line article:last-child{border-right:0}.tour-route__line article:before{content:"";position:absolute;top:-7px;left:22px;width:12px;height:12px;border-radius:50%;background:#c7a55f;border:2px solid #232a21}.tour-route__line i{font-style:normal;font-family:'Stardos Stencil',serif;font-size:32px;color:#c9a55c}.tour-route__line b{display:block;font-size:12px;letter-spacing:.1em;margin:8px 0}.tour-route__line p{font-size:12px;line-height:1.6;color:#d1c5a8}
.field-callout{position:relative;min-height:540px;padding:80px 6vw;display:flex;align-items:center;overflow:hidden}.field-callout__bg{position:absolute;inset:0;background:url('/static/art/arrival-country.webp') center/cover no-repeat}.field-callout__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,13,10,.88),rgba(10,13,10,.58),rgba(10,13,10,.3))}.field-callout__copy{position:relative;z-index:2;max-width:850px;color:#efe4c9}.field-callout__copy>span{font-size:10px;letter-spacing:.17em;color:#cba75f}.field-callout h2{font-family:'Stardos Stencil',serif;font-size:clamp(42px,5.5vw,76px);line-height:.9;margin:12px 0 18px}.field-callout p{font-size:16px;line-height:1.72;max-width:760px;color:#dcd0b4}

/* Journal page */
.journal-tent{position:relative;min-height:100vh;padding:76px 5vw 100px;background:url('/static/art/hq-canvas.webp') center/cover fixed no-repeat;overflow:hidden}.journal-tent__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,20,15,.90),rgba(25,29,22,.80))}.journal-shell{position:relative;z-index:2;max-width:1400px;margin:0 auto}.journal-page-title{color:#eee2c4;max-width:920px;margin-bottom:30px}.journal-page-title span{font-size:10px;letter-spacing:.17em;color:#c8a55e}.journal-page-title h1{font-family:'Stardos Stencil',serif;font-size:clamp(52px,6vw,84px);line-height:.9;margin:10px 0}.journal-page-title p{font-size:15px;color:#d8ccb0}.journal-layout{display:grid;grid-template-columns:minmax(0,960px) 320px;gap:30px;align-items:start}
.field-journal{position:relative;padding:55px 60px 64px 84px;background:repeating-linear-gradient(0deg,#dfd5b8 0,#dfd5b8 31px,#c9bea0 32px);color:#30291e;box-shadow:0 24px 50px rgba(0,0,0,.48);transform:rotate(-.2deg)}.field-journal:before{content:"";position:absolute;left:48px;top:0;bottom:0;border-left:2px solid rgba(148,72,57,.36)}.field-journal__binding{position:absolute;left:14px;top:45px;bottom:45px;display:flex;flex-direction:column;justify-content:space-around}.field-journal__binding i{display:block;width:15px;height:15px;border-radius:50%;background:#6d6555;box-shadow:inset 0 1px 2px rgba(0,0,0,.45)}.field-journal>header{text-align:center;padding-bottom:24px;border-bottom:2px solid #514634}.field-journal>header>*{display:block}.field-journal>header small{font-size:9px;letter-spacing:.14em}.field-journal>header strong{font-family:'Stardos Stencil',serif;font-size:28px;margin:6px 0}.field-journal>header span{font-size:9px;letter-spacing:.12em}.journal-entry{padding:28px 0 20px;border-bottom:1px solid rgba(82,69,46,.28)}.journal-entry:last-of-type{border-bottom:0}.journal-date{font-size:9px!important;letter-spacing:.13em;font-weight:700;color:#695637}.journal-entry h2{font-family:'Stardos Stencil',serif;font-size:31px;line-height:1.02;margin:8px 0 12px;color:#2b241a}.journal-entry p{font-size:14px;line-height:1.78;color:#3b3225}.journal-entry blockquote{margin:22px 0 5px;padding:16px 20px;border-left:4px solid #725a35;background:rgba(177,151,95,.18);font:700 22px/1.45 'Courier Prime',monospace}.journal-marginal-values{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}.journal-marginal-values span{padding:9px 11px;border:1px solid rgba(84,67,38,.3);font-size:10px;font-weight:700;letter-spacing:.06em}.journal-entry-final>strong{display:block;margin-top:18px;padding:12px 10px;border-top:2px solid #54452e;border-bottom:2px solid #54452e;text-align:center;font-size:13px;letter-spacing:.06em}.field-journal>footer{display:grid;gap:3px;margin-top:28px}.field-journal>footer span{font-size:11px}.field-journal>footer b{font-size:19px}.field-journal>footer small{font-size:9px}
.journal-field-board{position:sticky;top:100px;display:grid;gap:20px}.journal-note{position:relative;padding:25px 23px;background:#b79c60;color:#261f14;box-shadow:0 18px 34px rgba(0,0,0,.4);transform:rotate(1deg)}.journal-note:before{content:"";position:absolute;top:-9px;left:50%;width:78px;height:18px;background:rgba(212,196,158,.8);transform:translateX(-50%) rotate(-2deg)}.journal-note small,.journal-report-slip small{font-size:9px;letter-spacing:.14em;font-weight:700}.journal-note h3,.journal-report-slip h3{font-family:'Stardos Stencil',serif;font-size:28px;line-height:1;margin:9px 0 12px}.journal-note p,.journal-report-slip p{font-size:12px;line-height:1.62}.journal-note-dark{background:#5c624f;color:#efe3c6;transform:rotate(-1deg)}.journal-note-dark:before{background:rgba(184,171,139,.75)}.journal-report-slip{padding:26px 23px;transform:rotate(.4deg)}.journal-report-slip .paper-action{width:100%;justify-content:center;margin-top:12px}

/* Enlistment office */
.enlist-hero{position:relative;min-height:520px;padding:80px 6vw;display:flex;align-items:flex-end;background:url('/static/art/arrival-soldier.webp') center/cover no-repeat;overflow:hidden}.enlist-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,13,10,.88),rgba(10,13,10,.54),rgba(10,13,10,.36))}.enlist-hero__copy{position:relative;z-index:2;max-width:800px;color:#eee2c7;padding-left:18px;border-left:3px solid #c7a45c}.enlist-hero__copy>span{font-size:10px;letter-spacing:.17em;color:#cfaa61}.enlist-hero h1{font-family:'Stardos Stencil',serif;font-size:clamp(58px,7vw,92px);line-height:.85;margin:10px 0 15px}.enlist-hero p{font-size:16px;line-height:1.72;max-width:700px}.enlist-hero .paper-action{margin-top:18px}
.enlist-tent-desk{position:relative;padding:80px 5vw 100px;background:url('/static/art/hq-field-desk.webp') center/cover fixed no-repeat;overflow:hidden}.enlist-tent-desk__shade{position:absolute;inset:0;background:rgba(18,23,17,.86)}.enlist-tent-desk__inner{position:relative;z-index:2;max-width:1350px;margin:0 auto;display:grid;grid-template-columns:minmax(0,900px) 300px;gap:28px;align-items:start}.enlist-application-paper{padding:44px 48px;box-shadow:0 24px 48px rgba(0,0,0,.4)}.enlist-application-intro{margin:22px 0 28px;padding:16px 18px;border-left:4px solid #76603a;background:rgba(180,154,101,.13)}.enlist-application-intro b{font-size:12px;letter-spacing:.08em}.enlist-application-intro p{font-size:13px;line-height:1.65;margin:7px 0 0}.enlist-form-clean{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.enlist-form-clean label{display:grid;grid-template-columns:36px 1fr;gap:9px;padding:18px 0;border-bottom:1px dotted #8a7b5e;align-items:start}.enlist-form-clean label>span{font-family:'Stardos Stencil',serif;font-size:24px;color:#967a42}.enlist-form-clean label>div{display:grid;gap:6px}.enlist-form-clean label b{font-size:12px;line-height:1.4}.enlist-form-clean label small{font-size:10px;line-height:1.45;color:#675b43}.enlist-form-clean input,.enlist-form-clean select,.enlist-form-clean textarea{width:100%;box-sizing:border-box;background:#f2ead7;border:1px solid #897a5b;padding:11px 12px;font:14px/1.35 'Courier Prime',monospace;color:#241e14}.enlist-form-clean textarea{resize:vertical}.enlist-form-clean .wide{grid-column:1/-1}.enlist-certification{margin-top:18px;padding:16px 18px;background:rgba(178,151,95,.13);border:1px solid rgba(91,72,39,.25)}.enlist-certification b{font-size:11px;letter-spacing:.09em}.enlist-certification p{font-size:11px;line-height:1.6;margin:5px 0 0}.enlist-form-clean button.wide{margin-top:18px;justify-content:center}
.enlist-desk-side{display:grid;gap:22px}.enlist-side-card{position:relative;padding:27px 24px;background:#b99b60;color:#271f13;box-shadow:0 18px 34px rgba(0,0,0,.4);transform:rotate(1deg)}.enlist-side-card:before{content:"";position:absolute;left:50%;top:-9px;width:78px;height:18px;background:rgba(210,195,158,.8);transform:translateX(-50%) rotate(-2deg)}.enlist-side-card small{font-size:9px;letter-spacing:.14em;font-weight:700}.enlist-side-card h3{font-family:'Stardos Stencil',serif;font-size:27px;line-height:1.02;margin:9px 0 14px}.enlist-side-card ol{margin:0;padding-left:18px;display:grid;gap:9px}.enlist-side-card li{font-size:11px;line-height:1.5}.enlist-side-photo{margin:0;padding:11px;background:#d6c6a4;color:#332a1c;box-shadow:0 18px 34px rgba(0,0,0,.4);transform:rotate(-1deg)}.enlist-side-photo img{display:block;width:100%;height:220px;object-fit:cover}.enlist-side-photo figcaption{font:700 9px/1.4 'Courier Prime',monospace;letter-spacing:.06em;margin-top:8px}

@media(max-width:1080px){.arrival-tag{position:relative;right:auto;bottom:auto;margin:28px 0 0;width:min(360px,100%);transform:none}.fieldhero{display:block;padding-top:110px}.fieldhero__content{margin-top:160px}.field-desk-layout{display:grid;grid-template-columns:1fr 1fr;gap:18px;min-height:0}.desk-dossier,.desk-photo{position:relative;left:auto;right:auto;top:auto;bottom:auto;width:auto;transform:none}.desk-dossier{grid-column:1/-1}.desk-photo-rifle{width:auto}.journal-layout,.enlist-tent-desk__inner{grid-template-columns:1fr}.journal-field-board{position:static;grid-template-columns:repeat(3,1fr)}.enlist-desk-side{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.fieldhero{min-height:auto;padding:70px 18px}.fieldhero__content{margin-top:80px;padding-left:14px}.fieldhero h1{font-size:58px}.fieldhero__content>p{font-size:14px}.fieldhero__actions{flex-direction:column;align-items:stretch}.tent-room,.tour-route,.field-callout,.journal-tent,.enlist-tent-desk{padding:56px 18px}.tent-intro h2,.field-callout h2{font-size:38px}.field-desk-layout{grid-template-columns:1fr}.dossier-columns{grid-template-columns:1fr}.dossier-columns>div{border-right:0;border-bottom:1px solid rgba(74,61,39,.25)}.tour-route__line{grid-template-columns:1fr;border-top:0;border-left:2px solid #8b7647}.tour-route__line article{border-right:0;border-bottom:1px solid rgba(222,203,157,.14);padding-left:28px}.tour-route__line article:before{left:-8px;top:34px}.journal-page-title h1{font-size:48px}.field-journal{padding:44px 22px 50px 46px;transform:none}.field-journal:before{left:32px}.field-journal__binding{left:7px}.journal-entry h2{font-size:27px}.journal-entry p{font-size:13px}.journal-entry blockquote{font-size:18px}.journal-marginal-values{grid-template-columns:1fr}.journal-field-board,.enlist-desk-side{grid-template-columns:1fr}.enlist-hero{min-height:440px;padding:64px 18px}.enlist-hero h1{font-size:56px}.enlist-application-paper{padding:30px 20px}.enlist-form-clean{grid-template-columns:1fr}.enlist-form-clean .wide{grid-column:auto}.enlist-form-clean label{grid-template-columns:30px 1fr}.enlist-side-photo img{height:190px}}

/* ======================================================================
   PHYSICAL PUBLIC PAGES — FIELD JOURNAL + HQ BULLETIN BOARD
   ====================================================================== */
.physical-journal-page main,.physical-bulletin-page main{padding:0!important;background:#161914;overflow-x:hidden}

/* WHY JOIN US — the journal IS the page */
.journal-page-stage{min-height:100vh;padding:42px 18px 72px;background:radial-gradient(circle at 50% 18%,#4b4d3d 0,#282d24 48%,#171b16 100%);display:flex;justify-content:center;align-items:flex-start}
.journal-page-surface{position:relative;width:min(1040px,96vw);min-height:1385px;background-image:url('/static/art/field-journal-page.webp');background-repeat:no-repeat;background-position:center top;background-size:100% 100%;filter:drop-shadow(0 24px 36px rgba(0,0,0,.48))}
.journal-page-content{position:relative;z-index:2;padding:95px 100px 105px 145px;color:#322a1f;font-family:'Courier Prime',monospace}
.journal-page-header{text-align:center;padding:20px 34px 20px;border-bottom:1px solid rgba(65,52,35,.32);margin-bottom:16px}
.journal-page-header small{display:block;font-size:10px;font-weight:700;letter-spacing:.16em;color:#66523a}
.journal-page-header h1{font-family:'Stardos Stencil',serif;font-size:clamp(32px,4.2vw,52px);line-height:.95;margin:10px 0 8px;color:#2a2319}
.journal-page-header p{font-size:12px;font-style:italic;margin:0;color:#62513b}
.journal-page-opening>p,.journal-entry p{font-size:13px;line-height:1.62;margin:9px 0;color:#3b3023}
.journal-page-opening blockquote{margin:15px 0 14px;padding:12px 14px;border-left:4px solid rgba(94,68,37,.66);background:rgba(142,112,69,.08);font-size:17px;font-weight:700;line-height:1.35;color:#2f271c}
.journal-entry{padding:12px 0;border-top:1px dotted rgba(76,59,38,.25)}
.journal-entry h2{font-family:'Stardos Stencil',serif;font-size:21px;line-height:1.03;margin:0 0 7px;color:#2c2419}
.journal-entry-split{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.journal-entry-highlight{padding:14px 15px;background:rgba(151,120,76,.08);border-top:1px solid rgba(94,68,37,.35);border-bottom:1px solid rgba(94,68,37,.28)}
.journal-values{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}.journal-values span{font-size:10px;font-weight:700;letter-spacing:.06em;padding:6px 8px;border:1px solid rgba(81,62,39,.26);background:rgba(255,255,255,.08)}
.journal-entry-final strong{display:block;text-align:center;margin-top:12px;padding:10px 8px;border-top:2px solid rgba(75,56,34,.65);border-bottom:2px solid rgba(75,56,34,.65);font-size:12px;letter-spacing:.06em}
.journal-page-signature{display:grid;gap:2px;margin-top:14px;max-width:320px}.journal-page-signature span{font-size:11px}.journal-page-signature b{font-size:16px}.journal-page-signature small{font-size:9px;color:#66543e}
.journal-page-cta{display:flex;justify-content:center;margin-top:18px}.journal-page-cta .paper-action{min-width:300px;justify-content:center}

/* ABOUT — the bulletin board IS the page */
.bulletin-stage{position:relative;width:100%;min-height:calc(100vh - 90px);background:#34372d;padding:0;overflow:hidden}
.bulletin-board{position:relative;width:100%;aspect-ratio:4/3;min-height:820px;background-image:url('/static/art/hq-bulletin-board.webp');background-size:100% 100%;background-position:center;background-repeat:no-repeat;filter:drop-shadow(0 14px 22px rgba(0,0,0,.3))}
.bulletin-paper{position:absolute;background:linear-gradient(180deg,#eee3c8,#d8c6a0);color:#2d251a;border:1px solid rgba(90,68,38,.35);box-shadow:0 12px 22px rgba(0,0,0,.25);padding:20px 22px;font-family:'Courier Prime',monospace}
.bulletin-paper:after{content:"";position:absolute;inset:7px;border:1px solid rgba(91,68,39,.08);pointer-events:none}
.bulletin-tack{position:absolute;top:8px;left:50%;width:13px;height:13px;border-radius:50%;background:radial-gradient(circle at 38% 34%,#9b7f49,#4e3d22 58%,#231a0f 100%);box-shadow:0 2px 4px rgba(0,0,0,.35);transform:translateX(-50%)}
.bulletin-paper small{display:block;font-size:9px;font-weight:700;letter-spacing:.14em;color:#765f3e;margin-bottom:8px}.bulletin-paper h1,.bulletin-paper h2{font-family:'Stardos Stencil',serif;color:#271f15;line-height:.96}.bulletin-paper h1{font-size:34px;margin:0 0 10px}.bulletin-paper h2{font-size:23px;margin:0 0 9px}.bulletin-paper p,.bulletin-paper li{font-size:11px;line-height:1.52}.bulletin-paper p{margin:0}.bulletin-paper ul,.bulletin-paper ol{margin:7px 0 0;padding-left:18px;display:grid;gap:4px}
.bulletin-paper-main{left:30.5%;top:18%;width:39%;transform:rotate(-.4deg);padding:26px 30px;text-align:center}
.bulletin-paper-record{left:10%;top:18%;width:17.5%;transform:rotate(-1.2deg)}
.bulletin-paper-formation{right:9.5%;top:18.5%;width:18%;transform:rotate(1.1deg)}
.bulletin-paper-issue{left:12%;bottom:18%;width:23%;transform:rotate(.6deg)}
.bulletin-paper-tour{left:38%;bottom:13.5%;width:24%;transform:rotate(-.7deg)}
.bulletin-paper-recruit{right:10%;bottom:17%;width:23%;transform:rotate(.8deg);background:linear-gradient(180deg,#d9bd7d,#c4a45f)}
.bulletin-paper-recruit .paper-action{margin-top:12px;width:100%;justify-content:center}

@media(max-width:980px){
  .journal-page-surface{width:min(820px,96vw);min-height:1160px}
  .journal-page-content{padding:80px 72px 88px 115px}.journal-page-header h1{font-size:40px}.journal-page-opening>p,.journal-entry p{font-size:12px}.journal-entry h2{font-size:19px}
  .bulletin-board{aspect-ratio:auto;min-height:1500px;background-size:auto 100%;background-position:center top}
  .bulletin-paper{width:auto!important;left:8%!important;right:8%!important;top:auto!important;bottom:auto!important;transform:none!important;padding:24px 24px}
  .bulletin-paper-main{top:8%!important}.bulletin-paper-record{top:25%!important}.bulletin-paper-formation{top:39%!important}.bulletin-paper-issue{top:53%!important}.bulletin-paper-tour{top:68%!important}.bulletin-paper-recruit{top:83%!important}
}
@media(max-width:640px){
  .journal-page-stage{padding:14px 0 38px;background:#181b16}
  .journal-page-surface{width:100%;min-height:auto;background-size:cover;background-position:center top;filter:none}
  .journal-page-content{padding:82px 34px 78px 54px}.journal-page-header{padding:12px 4px 15px}.journal-page-header h1{font-size:29px}.journal-page-header small{font-size:8px}.journal-page-opening>p,.journal-entry p{font-size:11px;line-height:1.5}.journal-page-opening blockquote{font-size:14px}.journal-entry{padding:10px 0}.journal-entry h2{font-size:17px}.journal-entry-split{grid-template-columns:1fr;gap:0}.journal-values{grid-template-columns:1fr}.journal-page-cta .paper-action{min-width:0;width:100%}
  .bulletin-stage{background:#33382e;overflow:visible}.bulletin-board{min-height:1700px;background-size:auto 100%;background-position:center top}.bulletin-paper{left:6%!important;right:6%!important;padding:21px 20px}.bulletin-paper h1{font-size:27px}.bulletin-paper h2{font-size:20px}.bulletin-paper p,.bulletin-paper li{font-size:11px}.bulletin-paper-main{top:6.5%!important}.bulletin-paper-record{top:23.5%!important}.bulletin-paper-formation{top:38.5%!important}.bulletin-paper-issue{top:53.5%!important}.bulletin-paper-tour{top:68.5%!important}.bulletin-paper-recruit{top:84%!important}
}


/* Commander journal: normal letter copy */
.journal-letter-copy{padding-top:102px}
.journal-letter-header{border-bottom:0;margin-bottom:18px;padding-bottom:10px}
.journal-letter-header h1{font-family:'Courier Prime',monospace;font-size:clamp(25px,3.1vw,38px);line-height:1.15;text-transform:none;letter-spacing:.01em}
.journal-letter-header p{font-size:12px}
.journal-letter-body{max-width:760px;margin:0 auto}
.journal-letter-body p{font-size:14px;line-height:1.72;margin:0 0 18px;color:#3a3023;text-align:left}
.journal-letter-emphasis{font-weight:700;font-size:16px!important;padding:10px 14px;border-left:3px solid rgba(90,65,36,.58);background:rgba(135,104,62,.07)}
.journal-letter-closing{margin-top:22px!important;text-align:center!important;border-top:1px solid rgba(76,61,39,.28);border-bottom:1px solid rgba(76,61,39,.28);padding:13px 8px}
.journal-letter-signature{margin-left:auto;margin-right:30px;margin-top:20px}
@media(max-width:800px){.journal-letter-copy{padding-top:82px}.journal-letter-body p{font-size:12px;line-height:1.62;margin-bottom:14px}.journal-letter-header h1{font-size:26px}.journal-letter-emphasis{font-size:13px!important}.journal-letter-signature{margin-right:0}}

/* ======================================================================
   FINAL ABOUT BULLETIN — exact Department of the Army paper asset
   ====================================================================== */
.physical-bulletin-page .bulletin-stage{
  background:#252a22;
  min-height:calc(100vh - 90px);
}
.physical-bulletin-page .bulletin-board{
  min-height:920px;
  background-image:url('/static/art/hq-bulletin-board.webp');
  background-size:100% 100%;
  background-position:center;
  background-repeat:no-repeat;
}
.physical-bulletin-page .bulletin-paper{
  background-color:transparent!important;
  background-image:url('/static/art/department-army-bulletin-paper.webp')!important;
  background-size:100% 100%!important;
  background-position:center!important;
  background-repeat:no-repeat!important;
  border:0!important;
  box-shadow:0 12px 22px rgba(0,0,0,.30)!important;
  color:#2e271d;
  padding:50px 28px 28px!important;
  overflow:hidden;
}
.physical-bulletin-page .bulletin-paper:after{display:none!important}
.physical-bulletin-page .bulletin-tack{
  top:14px;
  width:12px;
  height:12px;
  box-shadow:0 2px 5px rgba(0,0,0,.48),inset 0 1px 2px rgba(255,255,255,.35);
}
.physical-bulletin-page .bulletin-paper small{
  margin-bottom:8px;
  color:#6c5c43;
  font-size:9px;
  letter-spacing:.14em;
}
.physical-bulletin-page .bulletin-paper h1,
.physical-bulletin-page .bulletin-paper h2{
  color:#282118;
  text-shadow:none;
}
.physical-bulletin-page .bulletin-paper p,
.physical-bulletin-page .bulletin-paper li{
  color:#40382c;
  font-size:11px;
  line-height:1.55;
}
.physical-bulletin-page .bulletin-paper-main{
  left:31%;top:10.5%;width:38%;
  min-height:190px;
  padding:58px 34px 30px!important;
  transform:rotate(-.25deg);
}
.physical-bulletin-page .bulletin-paper-main h1{font-size:32px}
.physical-bulletin-page .bulletin-paper-record{
  left:7%;top:31%;width:24%;min-height:205px;transform:rotate(-1.15deg)
}
.physical-bulletin-page .bulletin-paper-formation{
  right:7%;top:31%;width:24%;min-height:205px;transform:rotate(1deg)
}
.physical-bulletin-page .bulletin-paper-issue{
  left:7.5%;bottom:10%;width:25%;min-height:235px;transform:rotate(.65deg)
}
.physical-bulletin-page .bulletin-paper-tour{
  left:37.5%;bottom:8%;width:25%;min-height:250px;transform:rotate(-.55deg)
}
.physical-bulletin-page .bulletin-paper-recruit{
  right:7.5%;bottom:10%;width:25%;min-height:235px;transform:rotate(.7deg);
  background-image:url('/static/art/department-army-bulletin-paper.webp')!important;
}
.physical-bulletin-page .bulletin-paper-recruit .paper-action{
  margin-top:14px;
  width:100%;
  justify-content:center;
}

@media(max-width:980px){
  .physical-bulletin-page .bulletin-board{
    min-height:1840px;
    background-size:auto 100%;
    background-position:center top;
  }
  .physical-bulletin-page .bulletin-paper{
    left:7%!important;
    right:7%!important;
    width:auto!important;
    min-height:0!important;
    padding:58px 26px 28px!important;
    transform:none!important;
  }
  .physical-bulletin-page .bulletin-paper-main{top:4.5%!important}
  .physical-bulletin-page .bulletin-paper-record{top:21%!important}
  .physical-bulletin-page .bulletin-paper-formation{top:36.5%!important}
  .physical-bulletin-page .bulletin-paper-issue{top:52%!important;bottom:auto!important}
  .physical-bulletin-page .bulletin-paper-tour{top:67.5%!important;bottom:auto!important}
  .physical-bulletin-page .bulletin-paper-recruit{top:83%!important;bottom:auto!important}
}

@media(max-width:620px){
  .physical-bulletin-page .bulletin-board{min-height:1940px}
  .physical-bulletin-page .bulletin-paper{
    left:4.5%!important;
    right:4.5%!important;
    padding:54px 20px 24px!important;
  }
  .physical-bulletin-page .bulletin-paper-main h1{font-size:27px}
  .physical-bulletin-page .bulletin-paper h2{font-size:20px}
  .physical-bulletin-page .bulletin-paper p,
  .physical-bulletin-page .bulletin-paper li{font-size:11px;line-height:1.5}
}

/* New official 1st Battalion / 5th Cavalry logo sizing */
.unit-mark img{object-fit:contain}
.footer-filemark img{object-fit:contain}

/* ======================================================================
   BULLETIN BOARD CORRECTION — preserve actual Army paper proportions
   ====================================================================== */
.physical-bulletin-page .bulletin-board{
  min-height:980px;
}
.physical-bulletin-page .bulletin-paper{
  box-sizing:border-box;
  aspect-ratio:1080 / 1400;
  min-height:0!important;
  width:18.5%;
  padding:58px 22px 24px!important;
  background-size:100% 100%!important;
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
}
.physical-bulletin-page .bulletin-paper small{
  font-size:8px;
  margin-bottom:6px;
}
.physical-bulletin-page .bulletin-paper h1{
  font-size:25px;
  line-height:.94;
  margin-bottom:9px;
}
.physical-bulletin-page .bulletin-paper h2{
  font-size:17px;
  line-height:1.02;
  margin-bottom:8px;
}
.physical-bulletin-page .bulletin-paper p,
.physical-bulletin-page .bulletin-paper li{
  font-size:9.5px;
  line-height:1.45;
}
.physical-bulletin-page .bulletin-paper-main{
  left:39.5%;
  top:7.5%;
  width:21%;
  aspect-ratio:1080 / 1400;
  min-height:0;
  padding:62px 24px 24px!important;
  transform:rotate(-.35deg);
  text-align:left;
}
.physical-bulletin-page .bulletin-paper-main h1{font-size:27px;text-align:center}
.physical-bulletin-page .bulletin-paper-main small{text-align:center}
.physical-bulletin-page .bulletin-paper-record{
  left:10%;
  top:9%;
  width:18.5%;
  aspect-ratio:1080 / 1400;
  transform:rotate(-1.35deg);
}
.physical-bulletin-page .bulletin-paper-formation{
  right:10%;
  top:9.5%;
  width:18.5%;
  aspect-ratio:1080 / 1400;
  transform:rotate(1.1deg);
}
.physical-bulletin-page .bulletin-paper-issue{
  left:11%;
  top:52%;
  bottom:auto;
  width:18.5%;
  aspect-ratio:1080 / 1400;
  transform:rotate(.8deg);
}
.physical-bulletin-page .bulletin-paper-tour{
  left:40.5%;
  top:51%;
  bottom:auto;
  width:19%;
  aspect-ratio:1080 / 1400;
  transform:rotate(-.6deg);
}
.physical-bulletin-page .bulletin-paper-recruit{
  right:11%;
  top:52%;
  bottom:auto;
  width:18.5%;
  aspect-ratio:1080 / 1400;
  transform:rotate(.75deg);
}
.physical-bulletin-page .bulletin-paper-recruit .paper-action{
  margin-top:auto;
  min-height:36px;
  padding:7px 8px!important;
}
.physical-bulletin-page .bulletin-paper-recruit .paper-action span{font-size:9px}
.physical-bulletin-page .bulletin-paper-recruit .paper-action small{font-size:7px;margin:0}

@media(max-width:980px){
  .physical-bulletin-page .bulletin-board{
    min-height:2300px;
    background-size:auto 100%;
    background-position:center top;
  }
  .physical-bulletin-page .bulletin-paper{
    left:50%!important;
    right:auto!important;
    width:min(72vw,420px)!important;
    aspect-ratio:1080 / 1400!important;
    transform:translateX(-50%)!important;
    padding:68px 30px 30px!important;
  }
  .physical-bulletin-page .bulletin-paper-main{top:3.5%!important}
  .physical-bulletin-page .bulletin-paper-record{top:19.5%!important}
  .physical-bulletin-page .bulletin-paper-formation{top:35.5%!important}
  .physical-bulletin-page .bulletin-paper-issue{top:51.5%!important}
  .physical-bulletin-page .bulletin-paper-tour{top:67.5%!important}
  .physical-bulletin-page .bulletin-paper-recruit{top:83.5%!important}
  .physical-bulletin-page .bulletin-paper h1{font-size:27px}
  .physical-bulletin-page .bulletin-paper h2{font-size:20px}
  .physical-bulletin-page .bulletin-paper p,
  .physical-bulletin-page .bulletin-paper li{font-size:11px;line-height:1.5}
}

/* ======================================================================
   PUBLIC RECRUITING VISUAL REBUILD — AUG 2026
   Public pages only. Internal/member/staff systems remain on existing UI.
   ====================================================================== */
:root{
  --cav-yellow:#c9a23d;
  --army-olive:#2b3024;
  --army-olive-dark:#161a14;
  --army-panel:#20251d;
  --army-border:#555744;
  --paper:#e3dbc7;
  --paper-dark:#c9bb98;
  --ink:#242116;
}
.public-recruiting-redesign{background:#252a22;color:#e9dfc7}
.public-recruiting-redesign main{background:
  linear-gradient(rgba(35,39,31,.96),rgba(35,39,31,.98)),
  url('/static/art/hq-canvas.webp') center/cover fixed no-repeat;min-height:70vh}

/* Public masthead / navigation */
.public-hq-header{position:relative;z-index:50;background:#151913;border-bottom:1px solid #080a07;box-shadow:0 7px 20px rgba(0,0,0,.35)}
.public-hq-masthead{position:relative;min-height:190px;background:url('/static/art/hq-field-desk.webp') center 58%/cover no-repeat;overflow:hidden}
.public-hq-masthead__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,15,12,.9),rgba(18,20,16,.62) 55%,rgba(11,13,10,.72)),linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.42))}
.public-hq-masthead__inner{position:relative;z-index:2;width:min(1480px,94vw);min-height:190px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:30px}
.public-hq-identity{display:flex;align-items:center;gap:23px;color:#eee4c9;text-decoration:none;min-width:0}
.public-hq-identity img{width:145px;height:145px;object-fit:contain;filter:drop-shadow(0 6px 10px rgba(0,0,0,.5))}
.public-hq-identity div{display:grid;gap:2px}.public-hq-identity strong{font:700 clamp(32px,4.6vw,64px)/.95 'Stardos Stencil',serif;letter-spacing:.035em;text-shadow:0 3px 8px rgba(0,0,0,.6)}
.public-hq-identity span{font:600 17px/1.1 'Oswald',sans-serif;letter-spacing:.15em;color:#d2af5d;text-transform:uppercase}.public-hq-identity small{font:500 12px 'Oswald',sans-serif;letter-spacing:.16em;color:#c9c0a7}
.public-hq-masthead__message{display:grid;text-align:right;max-width:390px;padding:20px 0;color:#e8ddc2;text-shadow:0 2px 5px rgba(0,0,0,.75)}
.public-hq-masthead__message span{font:600 10px 'Oswald',sans-serif;letter-spacing:.18em;color:#d0af5d}.public-hq-masthead__message b{font:600 27px/1.05 'Oswald',sans-serif;letter-spacing:.06em;margin:7px 0}.public-hq-masthead__message small{font:400 12px/1.5 'Courier Prime',monospace}
.public-field-nav{position:relative!important;top:auto!important;left:auto!important;right:auto!important;display:flex!important;justify-content:center!important;align-items:stretch!important;gap:0!important;padding:0!important;margin:0!important;background:linear-gradient(rgba(34,38,29,.98),rgba(19,22,17,.98))!important;border-top:1px solid #4c4e3c!important;border-bottom:1px solid #090a08!important;box-shadow:inset 0 1px rgba(255,255,255,.025)!important}
.public-field-nav a{position:relative;display:flex!important;align-items:center;justify-content:center;padding:16px 27px!important;min-height:54px!important;border:0!important;border-left:1px solid rgba(255,255,255,.035)!important;background:transparent!important;color:#dbd3bc!important;font:500 14px 'Oswald',sans-serif!important;letter-spacing:.08em!important;text-decoration:none;text-transform:uppercase;white-space:nowrap}
.public-field-nav a:hover{background:rgba(255,255,255,.04)!important;color:#fff6dd!important}.public-field-nav a[aria-current="page"]{color:#e4bd57!important}.public-field-nav a[aria-current="page"]:after{content:"";position:absolute;left:20px;right:20px;bottom:0;height:3px;background:var(--cav-yellow)}
.public-index-button{display:none!important}

/* Shared field panels */
.field-panel{background:linear-gradient(180deg,rgba(53,58,44,.98),rgba(41,46,34,.98));border:1px solid #5b5e49;box-shadow:0 8px 18px rgba(0,0,0,.24),inset 0 1px rgba(255,255,255,.03);color:#e8dfca}
.field-panel>header{padding:11px 15px;border-bottom:1px solid #696a52;background:linear-gradient(#252a20,#1b2018);font:600 15px 'Stardos Stencil',serif;letter-spacing:.06em;color:#f0e4c4}.field-panel>header:before{content:"★";color:#b79745;margin-right:10px;font-size:11px}.field-panel p,.field-panel li{font:400 13px/1.55 'Courier Prime',monospace}.compact-panel p{padding:16px 17px;margin:0}.field-action{display:block;margin:16px 0 0;padding:11px 14px;background:#b89238;border:1px solid #e2c46d;color:#1e1b12;text-decoration:none;text-align:center;font:600 13px 'Oswald',sans-serif;letter-spacing:.08em;box-shadow:0 3px 7px rgba(0,0,0,.28)}

/* Home inspired by period veteran/community site hierarchy */
.public-site-shell{width:min(1480px,95vw);margin:0 auto;padding:28px 0 46px}.public-home-grid{display:grid;grid-template-columns:245px minmax(0,1fr) 250px;gap:18px;align-items:start}
.public-side-column{display:grid;gap:16px}.field-link-list{display:grid}.field-link-list a{position:relative;padding:10px 35px 10px 14px;color:#e5dcc7;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.085);font:500 14px 'Oswald',sans-serif;letter-spacing:.02em}.field-link-list a:after{content:"›";position:absolute;right:14px;color:#a99d78}.field-link-list a:hover{background:rgba(255,255,255,.05);color:#e8bd52}
.field-photo-card{background:#d7cfba;color:#251f16;border:1px solid #8c826a;padding:8px;box-shadow:0 8px 16px rgba(0,0,0,.26)}.field-photo-card img{width:100%;aspect-ratio:1.55/1;object-fit:cover;filter:saturate(.6) sepia(.12)}.field-photo-card div{padding:12px 10px}.field-photo-card small,.field-photo-card strong,.field-photo-card a{display:block}.field-photo-card small{font:600 10px 'Oswald',sans-serif;letter-spacing:.12em;color:#6b5b39}.field-photo-card strong{font:700 19px/1.02 'Stardos Stencil',serif;margin:6px 0 11px}.field-photo-card a{font:600 12px 'Oswald',sans-serif;color:#4d432c;text-decoration:none}
.public-main-column{display:grid;gap:16px}.welcome-paper{position:relative;display:grid;grid-template-columns:1fr 180px;gap:24px;align-items:center;padding:34px 38px;background:linear-gradient(rgba(239,232,214,.96),rgba(216,206,181,.97)),url('/static/art/department-army-bulletin-paper.webp') center/cover;color:#282116;overflow:hidden}.welcome-copy small{font:600 10px 'Oswald',sans-serif;letter-spacing:.15em;color:#68593a}.welcome-copy h1{font:700 clamp(35px,4vw,56px)/.92 'Stardos Stencil',serif;margin:9px 0 15px;letter-spacing:.02em}.welcome-copy p{font:400 15px/1.7 'Courier Prime',monospace;max-width:760px}.welcome-line{display:block;font:700 16px/1.45 'Courier Prime',monospace;color:#42452d;margin-top:16px}.welcome-paper>img{width:170px;height:170px;object-fit:contain;justify-self:center}.welcome-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:19px}.welcome-actions a{padding:10px 13px;background:#32372a;color:#eee3c7;border:1px solid #666851;text-decoration:none;font:600 12px 'Oswald',sans-serif;letter-spacing:.08em}.welcome-actions a:first-child{background:#b69138;color:#1f1b12;border-color:#d2b35f}
.official-stamp{display:inline-flex;align-items:center;justify-content:center;border:4px double rgba(116,37,27,.64);color:rgba(116,37,27,.68);padding:7px 11px;font:700 17px 'Oswald',sans-serif;letter-spacing:.12em;transform:rotate(-8deg);mix-blend-mode:multiply;text-transform:uppercase}.welcome-paper .official-stamp{position:absolute;right:25px;bottom:20px}
.public-feature-photo{position:relative;min-height:410px;overflow:hidden;border:7px solid #d9cfb7;box-shadow:0 9px 20px rgba(0,0,0,.28)}.public-feature-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.72) contrast(.96)}.public-feature-photo:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(9,12,9,.77),transparent 58%)}.public-feature-photo__caption{position:absolute;z-index:2;left:27px;right:27px;bottom:24px;color:#f1e7ce}.public-feature-photo__caption small{font:600 10px 'Oswald',sans-serif;letter-spacing:.16em;color:#d1ac53}.public-feature-photo__caption strong{display:block;font:700 33px/1 'Stardos Stencil',serif;margin:6px 0}.public-feature-photo__caption p{font:400 13px 'Courier Prime',monospace;margin:0;max-width:720px}
.dispatch-board{background:#ded5c0;border:1px solid #958a70;color:#2a251a}.dispatch-board>header{display:flex;justify-content:space-between;align-items:center;background:#313628;color:#e9dfc6;padding:11px 14px;border-bottom:1px solid #161914}.dispatch-board>header span{font:600 15px 'Stardos Stencil',serif;letter-spacing:.05em}.dispatch-board>header a{font:500 11px 'Oswald',sans-serif;letter-spacing:.08em;color:#d3b25e;text-decoration:none}.dispatch-board article{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:15px;border-bottom:1px solid #b8ad92}.dispatch-board article:last-child{border-bottom:0}.dispatch-board article img{width:150px;height:85px;object-fit:contain;background:#afa584}.dispatch-board article small{font:600 9px 'Oswald',sans-serif;letter-spacing:.14em;color:#76623b}.dispatch-board h2{font:700 20px 'Stardos Stencil',serif;margin:4px 0}.dispatch-board p{font:400 12px/1.5 'Courier Prime',monospace;margin:0}
.reporting-office__body{padding:17px}.reporting-office__body small{font:600 9px 'Oswald',sans-serif;letter-spacing:.15em;color:#d2af5a}.reporting-office__body h2{font:700 29px/1 'Stardos Stencil',serif;margin:8px 0 11px}.reporting-office__body p{margin:0}.needs-list{display:grid}.needs-list>div{display:grid;grid-template-columns:44px 1fr auto;gap:7px;align-items:center;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.08)}.needs-list span{font:700 10px 'Courier Prime',monospace;color:#d1ad54}.needs-list b{font:500 12px 'Oswald',sans-serif}.needs-list small{font:400 10px 'Courier Prime',monospace;color:#c5baa0}.needs-list p{padding:13px}.panel-text-link{display:block;padding:11px 13px;color:#d1ad54;text-decoration:none;font:500 10px 'Oswald',sans-serif;letter-spacing:.07em}.public-checklist{margin:0;padding:15px 18px 17px 31px;display:grid;gap:8px}

/* Commander journal */
.journal-room{position:relative;padding:52px 20px 72px;background:url('/static/art/hq-canvas.webp') center/cover fixed no-repeat;min-height:100vh}.journal-room__shade{position:absolute;inset:0;background:rgba(17,21,16,.78)}.field-journal-sheet{position:relative;z-index:2;width:min(980px,92vw);min-height:1320px;margin:auto;background:url('/static/art/field-journal-page.webp') top center/100% 100% no-repeat;filter:drop-shadow(0 25px 30px rgba(0,0,0,.48));color:#292116}.journal-sheet-content{padding:98px 92px 105px 122px}.journal-message-head{text-align:center;margin-bottom:34px}.journal-message-head small{font:600 9px 'Oswald',sans-serif;letter-spacing:.16em;color:#6b5a3b}.journal-message-head h1{font:700 clamp(34px,5vw,54px)/.98 'Stardos Stencil',serif;margin:8px 0 9px}.journal-message-head p{font:italic 14px 'Courier Prime',monospace;color:#655a48}.journal-sheet-content>p{font:400 15px/1.75 'Courier Prime',monospace;margin:0 0 21px}.journal-pullquote{padding:16px 18px;border-left:4px solid #745d38;background:rgba(119,92,51,.08);font-weight:700!important}.journal-values{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:24px 0}.journal-values span{padding:9px 10px;border:1px solid rgba(97,77,45,.27);font:700 11px 'Courier Prime',monospace;text-transform:uppercase}.journal-closing{text-align:center;padding:17px 0;border-top:2px solid rgba(66,52,30,.5);border-bottom:2px solid rgba(66,52,30,.5)}.journal-sheet-content footer{display:grid;margin-top:28px;gap:3px;font-family:'Courier Prime',monospace}.journal-sheet-content footer b{font-size:17px}.journal-sheet-content footer small{font-size:11px}.journal-enlist{display:inline-block;margin-top:28px;padding:10px 13px;background:#3d4434;color:#f0e6cc;text-decoration:none;font:600 12px 'Oswald',sans-serif;letter-spacing:.08em}

/* About bulletin board */
.bulletin-room{padding:36px 0 70px;background:linear-gradient(rgba(31,35,27,.78),rgba(31,35,27,.84)),url('/static/art/hq-canvas.webp') center/cover fixed}.bulletin-room__intro{width:min(1250px,92vw);margin:0 auto 24px;color:#eadfc3;text-align:center}.bulletin-room__intro small{font:600 10px 'Oswald',sans-serif;letter-spacing:.18em;color:#d1ac55}.bulletin-room__intro h1{font:700 clamp(42px,6vw,68px)/.94 'Stardos Stencil',serif;margin:8px 0}.bulletin-room__intro p{font:400 13px 'Courier Prime',monospace}
.hq-bulletin-board{position:relative;width:min(1480px,96vw);aspect-ratio:4/3;margin:auto;background:url('/static/art/hq-bulletin-board.webp') center/100% 100% no-repeat;filter:drop-shadow(0 20px 28px rgba(0,0,0,.4));overflow:hidden}
.bulletin-army-sheet{position:absolute;background:url('/static/art/department-army-bulletin-paper.webp') center/100% 100% no-repeat;color:#292116;padding:11.5% 6.5% 6.5%;box-sizing:border-box;box-shadow:0 9px 17px rgba(0,0,0,.3);font-family:'Courier Prime',monospace;overflow:hidden}.bulletin-army-sheet small{display:block;font:600 9px 'Oswald',sans-serif;letter-spacing:.15em;color:#675739}.bulletin-army-sheet h2{font:700 22px/1 'Stardos Stencil',serif;margin:7px 0 10px}.bulletin-army-sheet p,.bulletin-army-sheet li{font:400 10px/1.45 'Courier Prime',monospace}.bulletin-army-sheet ul,.bulletin-army-sheet ol{padding-left:17px;margin:5px 0}.paper-tack{position:absolute;top:4.6%;left:50%;width:11px;height:11px;border-radius:50%;background:radial-gradient(circle at 36% 31%,#c5b16f,#62522e 63%,#2a2214);box-shadow:0 2px 4px rgba(0,0,0,.48)}
.sheet-orientation{width:32%;height:48%;left:34%;top:6%;transform:rotate(.2deg)}.sheet-soldier{width:23%;height:42%;left:8%;top:13%;transform:rotate(-1.4deg)}.sheet-formation{width:23%;height:42%;right:8%;top:14%;transform:rotate(1.2deg)}.sheet-issue{width:23%;height:42%;left:9%;bottom:7%;transform:rotate(.8deg)}.sheet-tour{width:25%;height:43%;left:37.5%;bottom:5%;transform:rotate(-.5deg)}.sheet-recruit{width:23%;height:42%;right:9%;bottom:7%;transform:rotate(1.1deg)}.sheet-recruit a{display:block;margin-top:10px;padding:8px 9px;background:#b79137;color:#1d1911;text-align:center;text-decoration:none;font:600 11px 'Oswald',sans-serif;letter-spacing:.07em}

/* Enlist / recruiting office */
.recruiting-office-hero{position:relative;min-height:390px;background:url('/static/art/hq-field-desk.webp') center 64%/cover no-repeat;display:flex;align-items:end;padding:54px 7vw}.recruiting-office-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,16,12,.86),rgba(13,16,12,.35)),linear-gradient(0deg,rgba(9,11,8,.76),transparent 56%)}.recruiting-office-hero__copy{position:relative;z-index:2;max-width:760px;color:#eee3c7}.recruiting-office-hero__copy small{font:600 10px 'Oswald',sans-serif;letter-spacing:.17em;color:#d0ad56}.recruiting-office-hero h1{font:700 clamp(48px,6vw,78px)/.92 'Stardos Stencil',serif;margin:8px 0 12px}.recruiting-office-hero p{font:400 15px/1.65 'Courier Prime',monospace}.recruiting-office-hero a{display:inline-block;margin-top:15px;color:#f0c858;text-decoration:none;font:600 13px 'Oswald',sans-serif;letter-spacing:.1em}
.recruiting-desk-room{position:relative;padding:58px 3vw 80px;background:url('/static/art/hq-canvas.webp') center/cover fixed no-repeat}.recruiting-desk-room__shade{position:absolute;inset:0;background:rgba(26,31,24,.84)}.recruiting-desk-grid{position:relative;z-index:2;width:min(1420px,96vw);margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px;align-items:start}.government-form-sheet{position:relative;background:linear-gradient(rgba(239,233,216,.95),rgba(222,213,191,.96)),url('/static/art/department-army-bulletin-paper.webp') center/cover;color:#292116;padding:54px 55px 60px;border:1px solid #91846a;box-shadow:0 20px 35px rgba(0,0,0,.4)}.government-form-sheet>header{text-align:center;padding-bottom:19px;border-bottom:2px solid #4b4230;display:grid;gap:3px}.government-form-sheet>header small{font:600 11px 'Stardos Stencil',serif}.government-form-sheet>header strong{font:700 17px 'Courier Prime',monospace}.government-form-sheet>header span{font:500 10px 'Oswald',sans-serif;letter-spacing:.1em}.form-instructions{margin:22px 0 26px;padding:18px;border-left:5px solid #6d6146;background:rgba(255,255,255,.24)}.form-instructions b{font:700 14px 'Courier Prime',monospace}.form-instructions p{font:400 12px/1.6 'Courier Prime',monospace;margin:7px 0 0}
.public-enlist-form{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}.public-enlist-form label{display:grid;grid-template-columns:43px 1fr;gap:9px;padding:18px 0;border-bottom:1px dotted #94886d}.public-enlist-form label>span{font:700 27px 'Stardos Stencil',serif;color:#9b7e3e}.public-enlist-form label>div{display:grid;gap:7px;align-content:start}.public-enlist-form label b{font:700 12px/1.45 'Courier Prime',monospace}.public-enlist-form label small{font:400 10px/1.45 'Courier Prime',monospace;color:#5f5644}.public-enlist-form input,.public-enlist-form select,.public-enlist-form textarea{width:100%;box-sizing:border-box;border:1px solid #8d8166;background:#f2ead6;color:#272116;padding:11px 12px;font:400 14px 'Courier Prime',monospace;border-radius:0;min-height:44px}.public-enlist-form textarea{resize:vertical}.public-enlist-form .wide{grid-column:1/-1}.application-certification{padding:17px 0;margin-top:11px;border-top:2px solid #554b37}.application-certification b{font:700 12px 'Courier Prime',monospace}.application-certification p{font:400 11px/1.55 'Courier Prime',monospace}.field-submit{border:1px solid #5b4d28;background:#b68e35;color:#1f1a11;padding:13px 17px;cursor:pointer;text-align:left;font:600 14px 'Oswald',sans-serif;letter-spacing:.08em}.field-submit span{float:right;font-size:10px;opacity:.75}.application-stamp{position:absolute;right:45px;bottom:70px}.recruiting-desk-sidebar{display:grid;gap:19px}.report-steps{padding:15px 18px 18px 25px;margin:0;display:grid;gap:10px}.report-steps li{font:400 12px/1.5 'Courier Prime',monospace}.recruiting-photo{margin:0;background:#d9cfb7;padding:8px;color:#272116;box-shadow:0 9px 18px rgba(0,0,0,.32)}.recruiting-photo img{width:100%;display:block;aspect-ratio:1.45/1;object-fit:cover;filter:saturate(.65) sepia(.1)}.recruiting-photo figcaption{padding:10px 8px 5px;font:600 10px 'Oswald',sans-serif;letter-spacing:.08em}

/* Public footer */
.public-hq-footer{background:#121510;border-top:1px solid #62624b;color:#d6ccb5}.public-hq-footer__inner{width:min(1480px,94vw);min-height:115px;margin:auto;display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:30px}.public-hq-footer__brand{display:flex;align-items:center;gap:13px}.public-hq-footer__brand img{width:74px;height:74px;object-fit:contain}.public-hq-footer__brand div{display:grid}.public-hq-footer__brand strong{font:600 14px 'Stardos Stencil',serif}.public-hq-footer__brand span,.public-hq-footer__quote span{font:400 10px 'Oswald',sans-serif;letter-spacing:.1em;color:#9e967f}.public-hq-footer__quote{display:grid;text-align:center}.public-hq-footer__quote b{font:600 12px 'Oswald',sans-serif;letter-spacing:.12em;color:#cba84f}.public-hq-footer a{color:#d0ad55;text-decoration:none;font:600 12px 'Oswald',sans-serif;letter-spacing:.1em}

@media(max-width:1150px){
  .public-home-grid{grid-template-columns:220px 1fr}.public-side-right{grid-column:1/-1;grid-template-columns:repeat(3,1fr)}
  .public-hq-masthead__message{display:none}.public-hq-identity strong{font-size:46px}
  .recruiting-desk-grid{grid-template-columns:1fr}.recruiting-desk-sidebar{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:820px){
  .public-hq-masthead{min-height:125px}.public-hq-masthead__inner{min-height:125px}.public-hq-identity img{width:90px;height:90px}.public-hq-identity strong{font-size:32px}.public-hq-identity span{font-size:12px}.public-hq-identity small{font-size:9px}
  .public-index-button{display:block!important;width:100%;border:0;border-top:1px solid #4d4f3c;border-bottom:1px solid #080a07;background:#1d221a;color:#eee2c5;padding:14px;font:600 13px 'Oswald',sans-serif;letter-spacing:.1em}
  .public-field-nav{display:none!important;position:absolute!important;left:0!important;right:0!important;z-index:60!important;flex-direction:column!important}.public-field-nav.open{display:flex!important}.public-field-nav a{justify-content:flex-start!important;padding:14px 20px!important;min-height:46px!important;border-bottom:1px solid rgba(255,255,255,.07)!important}.public-field-nav a[aria-current="page"]:after{left:0;right:auto;top:0;bottom:0;width:4px;height:auto}
  .public-home-grid{grid-template-columns:1fr}.public-side-left{grid-template-columns:1fr 1fr}.public-side-left .field-panel:first-child{grid-column:1/-1}.public-side-right{grid-template-columns:1fr 1fr}.public-side-right .compact-panel{grid-column:1/-1}.welcome-paper{grid-template-columns:1fr}.welcome-paper>img{display:none}.welcome-paper .official-stamp{position:static;justify-self:start;margin-top:10px}.public-feature-photo{min-height:350px}
  .field-journal-sheet{min-height:auto;background-size:100% 100%}.journal-sheet-content{padding:80px 58px 85px 78px}.journal-values{grid-template-columns:1fr}
  .hq-bulletin-board{aspect-ratio:auto;background-size:cover;padding:70px 8vw;display:grid;grid-template-columns:1fr 1fr;gap:18px}.bulletin-army-sheet{position:relative!important;width:auto!important;height:auto!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;transform:none!important;min-height:520px;padding:100px 45px 45px}.sheet-orientation{grid-column:1/-1}.bulletin-army-sheet h2{font-size:25px}.bulletin-army-sheet p,.bulletin-army-sheet li{font-size:12px}
  .public-enlist-form{grid-template-columns:1fr}.public-enlist-form .wide{grid-column:auto}.recruiting-desk-sidebar{grid-template-columns:1fr 1fr}.recruiting-desk-sidebar .compact-panel{grid-column:1/-1}
  .public-hq-footer__inner{grid-template-columns:1fr auto}.public-hq-footer__quote{display:none}
}
@media(max-width:560px){
  .public-hq-masthead__inner{width:94vw}.public-hq-identity{gap:10px}.public-hq-identity img{width:72px;height:72px}.public-hq-identity strong{font-size:25px}.public-hq-identity span{font-size:10px;letter-spacing:.1em}
  .public-site-shell{width:94vw;padding-top:14px}.public-side-left,.public-side-right{grid-template-columns:1fr}.public-side-left .field-panel:first-child,.public-side-right .compact-panel{grid-column:auto}.welcome-paper{padding:26px 22px}.welcome-copy h1{font-size:37px}.welcome-copy p{font-size:13px}.dispatch-board article{grid-template-columns:100px 1fr}.dispatch-board article img{width:100px;height:70px}.public-feature-photo{min-height:290px}.public-feature-photo__caption{left:18px;right:18px;bottom:17px}.public-feature-photo__caption strong{font-size:25px}
  .journal-room{padding:20px 8px 35px}.field-journal-sheet{width:100%;background-size:cover;background-position:top center}.journal-sheet-content{padding:72px 32px 72px 48px}.journal-message-head h1{font-size:34px}.journal-sheet-content>p{font-size:13px;line-height:1.65}.journal-message-head p{font-size:12px}
  .bulletin-room{padding-top:24px}.hq-bulletin-board{width:100%;padding:48px 18px;grid-template-columns:1fr}.sheet-orientation{grid-column:auto}.bulletin-army-sheet{min-height:470px;padding:90px 35px 36px}
  .recruiting-office-hero{min-height:330px;padding:38px 20px}.recruiting-desk-room{padding:30px 8px 45px}.recruiting-desk-grid{width:100%}.government-form-sheet{padding:35px 20px 45px}.public-enlist-form label{grid-template-columns:36px 1fr}.public-enlist-form label>span{font-size:22px}.recruiting-desk-sidebar{grid-template-columns:1fr}.recruiting-desk-sidebar .compact-panel{grid-column:auto}.application-stamp{position:static;margin-top:15px}
  .public-hq-footer__inner{grid-template-columns:1fr;padding:18px 0}.public-hq-footer__brand img{width:60px;height:60px}.public-hq-footer a{justify-self:start}
}

/* ========================================================================
   RECRUITING — MINIMAL DISCORD OAUTH IDENTITY FLOW
   Requests Discord `identify` only; no guild/email/connections scopes.
   ======================================================================== */
.discord-identity-panel{margin:22px 0 28px;padding:22px 24px;border:2px solid #7b6d4d;background:linear-gradient(180deg,rgba(226,215,188,.82),rgba(211,196,160,.78));position:relative}
.discord-identity-panel.verified{border-color:#4c5d42;background:linear-gradient(180deg,rgba(220,218,191,.92),rgba(200,202,168,.86))}
.discord-identity-copy small{font:700 10px 'Oswald',sans-serif;letter-spacing:.15em;color:#6a5938}.discord-identity-copy h2{font-family:'Stardos Stencil',serif;font-size:28px;line-height:1;margin:7px 0 9px}.discord-identity-copy p{font:13px/1.65 'Courier Prime',monospace;margin:0;max-width:780px}
.discord-verify-button{display:inline-flex;flex-direction:column;gap:2px;margin:18px 0 14px;padding:13px 18px;background:#31392f;border:1px solid #68735d;color:#efe5cb;text-decoration:none;box-shadow:0 4px 0 #181d18;font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:.07em}.discord-verify-button span{font-size:15px;font-weight:700}.discord-verify-button small{font-size:9px;color:#cdb776;letter-spacing:.12em}.discord-verify-button:hover{background:#424b3d}.discord-verify-button.disabled{opacity:.45;pointer-events:none}
.oauth-config-warning{font:700 11px 'Courier Prime',monospace;color:#742e28}.oauth-scope-note{margin-top:14px;padding-top:14px;border-top:1px dashed rgba(64,53,34,.38);display:grid;grid-template-columns:180px 1fr;gap:7px 13px}.oauth-scope-note b{font:700 10px 'Oswald',sans-serif;letter-spacing:.1em;color:#55472e}.oauth-scope-note span{font:12px/1.55 'Courier Prime',monospace;color:#3e3527}
.discord-identity-card{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:13px;align-items:center;margin:17px 0 10px;padding:12px;background:rgba(255,255,255,.22);border:1px solid rgba(74,62,38,.27)}.discord-identity-avatar{width:54px;height:54px;border-radius:50%;overflow:hidden;background:#3e4638;display:grid;place-items:center;color:#ece1c7;font:700 22px 'Oswald',sans-serif}.discord-identity-avatar img{width:100%;height:100%;object-fit:cover}.discord-identity-card small,.discord-identity-card strong,.discord-identity-card span{display:block}.discord-identity-card small{font:700 9px 'Oswald',sans-serif;letter-spacing:.12em;color:#6a5938}.discord-identity-card strong{font:700 17px 'Courier Prime',monospace;margin:3px 0}.discord-identity-card span{font:11px 'Courier Prime',monospace;color:#5d523e}.identity-switch{font:700 10px 'Oswald',sans-serif;letter-spacing:.08em;color:#3d4937;text-decoration:none;border-bottom:1px solid currentColor;white-space:nowrap}.identity-filed-stamp{display:inline-block;border:3px double #45603d;color:#45603d;padding:6px 10px;font:700 10px 'Courier Prime',monospace;letter-spacing:.1em;transform:rotate(-1deg)}
.public-enlist-form button[disabled]{opacity:.45;cursor:not-allowed;filter:grayscale(.25)}
.oauth-next-step,.recruit-pending{margin:22px 0;padding:22px 24px;background:rgba(180,155,93,.16);border-left:5px solid #7d673b}.oauth-next-step small,.recruit-pending small{font:700 10px 'Oswald',sans-serif;letter-spacing:.13em;color:#6d5936}.oauth-next-step h2,.recruit-pending h2{font-family:'Stardos Stencil',serif;font-size:29px;margin:8px 0}.oauth-next-step p,.recruit-pending p{font:13px/1.7 'Courier Prime',monospace}.oauth-next-step .paper-action{margin-top:10px}
@media(max-width:700px){.discord-identity-panel{padding:18px 16px}.discord-identity-card{grid-template-columns:46px 1fr}.discord-identity-avatar{width:46px;height:46px}.identity-switch{grid-column:1/-1}.oauth-scope-note{grid-template-columns:1fr;gap:3px}.oauth-scope-note span{margin-bottom:8px}}

/* =========================================================
   FUNCTIONAL POLISH — dismissible HQ messages, M16 operator
   maintenance, uniform presentation, S-1 overflow safeguards
   ========================================================= */
.dispatch{position:relative;padding-right:42px;transition:opacity .22s ease,transform .22s ease,max-height .25s ease,margin .25s ease,padding .25s ease}
.dispatch.is-dismissing{opacity:0;transform:translateX(18px);max-height:0;margin:0;padding-top:0;padding-bottom:0;overflow:hidden}
.dispatch-close{position:absolute;right:8px;top:7px;width:26px;height:26px;border:0;background:transparent;color:#4b4436;font:700 22px/1 Arial,sans-serif;cursor:pointer;opacity:.65}
.dispatch-close:hover,.dispatch-close:focus{opacity:1;outline:1px solid rgba(74,65,47,.35)}

.member-weapon-readiness{margin:12px 0 10px;padding:11px 12px;border:1px solid rgba(91,76,44,.28);background:rgba(168,147,96,.13)}
.member-weapon-readiness span{display:block;font:700 10px 'Oswald',sans-serif;letter-spacing:.1em;margin-bottom:4px}
.member-weapon-readiness small{display:block;font:11px/1.5 'Courier Prime',monospace;color:#5f5645}
.member-clean-weapon-form{display:grid;gap:6px;margin:10px 0 4px}
.member-clean-weapon-form .member-primary-link{width:100%;justify-content:center;text-align:center;cursor:pointer}
.member-clean-weapon-form .member-primary-link:disabled{opacity:.45;cursor:not-allowed}
.member-clean-weapon-form>small{font:10px/1.45 'Courier Prime',monospace;color:#665b46}

/* Crop closer to the chest/award area while retaining the full uniform file. */
.member-record-redesign .member-uniform-visual{height:455px!important;overflow:hidden!important;align-items:flex-start!important;padding:0!important}
.member-record-redesign .member-uniform-visual > img.uniform-base-image{width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;object-fit:cover!important;object-position:50% 18%!important;transform:scale(1.28)!important;transform-origin:50% 20%!important}
.page-201 .uniform-record-visual{overflow:hidden!important;align-items:flex-start!important;padding:0!important}
.page-201 .uniform-record-visual > img.uniform-base-image{width:100%!important;height:560px!important;max-height:none!important;object-fit:cover!important;object-position:50% 18%!important;transform:scale(1.18)!important;transform-origin:50% 20%!important}

/* S-1: never allow desktop panels/forms/roster to render beyond viewport. */
.page-s1 main,.page-s1 .s1-workroom,.page-s1 .document-sheet,.page-s1 .army-form-grid,.page-s1 .s1-roster-sheet{min-width:0;max-width:100%;box-sizing:border-box}
.page-s1 .s1-workroom{width:100%;overflow-x:hidden}
.page-s1 .army-form-grid>*{min-width:0}
.page-s1 input,.page-s1 select,.page-s1 textarea{min-width:0;max-width:100%;width:100%;box-sizing:border-box}
.page-s1 .s1-roster-sheet{overflow-x:auto;-webkit-overflow-scrolling:touch}
.page-s1 .s1-roster-head,.page-s1 .s1-roster-row{min-width:860px}
.page-s1 .s1-actions{min-width:0;overflow-wrap:anywhere}
@media(max-width:1120px){
  .page-s1 .s1-workroom{grid-template-columns:minmax(0,1fr)!important;padding-left:22px!important;padding-right:22px!important}
  .page-s1 .s1-roster-sheet{grid-column:1!important}
}
@media(max-width:720px){
  .page-s1 .s1-workroom{padding-left:12px!important;padding-right:12px!important}
  .page-s1 .s1-roster-head,.page-s1 .s1-roster-row{min-width:0}
  .member-record-redesign .member-uniform-visual{height:360px!important}
  .page-201 .uniform-record-visual > img.uniform-base-image{height:430px!important}
}


/* CUMULATIVE UX / S-1 / PUBLIC OPS PASS */
.logged-back-wrap{max-width:1500px;margin:12px auto -4px;padding:0 24px;position:relative;z-index:20}.logged-back-button{font-family:"Oswald",sans-serif;font-weight:700;letter-spacing:.08em;background:#303528;color:#eee2bd;border:1px solid #6f704f;padding:10px 16px;cursor:pointer}.logged-back-button:hover{background:#c79e36;color:#171910}
.field-photo-card img,.recruiting-side-photo img{object-fit:cover;object-position:center 25%}
.scheduled-ops-list{display:grid}.scheduled-op-row{display:grid;grid-template-columns:1fr auto;gap:8px;padding:10px 12px;border-bottom:1px solid rgba(222,209,157,.16);color:#eee3c4;text-decoration:none}.scheduled-op-row b,.scheduled-op-row small{display:block}.scheduled-op-row b{font-family:"Oswald",sans-serif;text-transform:uppercase}.scheduled-op-row small,.scheduled-op-row time{font-family:"Courier Prime",monospace;font-size:11px;color:#d3b04b}.no-scheduled-ops{padding:14px;font-family:"Courier Prime",monospace}.no-scheduled-ops small{display:block;margin-top:6px;opacity:.75}
.dispatch-board{width:calc(100% + 28px);margin-left:-14px}.dispatch-board article{min-height:126px;padding:16px}.dispatch-board article img{width:158px;height:94px;object-fit:contain}.dispatch-board article h2{font-size:1.35rem}.dispatch-board article p{font-size:.92rem;line-height:1.5}
.s1-workroom,.replacement-processing-desk,.personnel-actions-desk{max-width:min(1600px,calc(100vw - 32px));overflow:visible}.s1-workroom>*{min-width:0}.s1-roster-control{grid-column:1/-1;padding:18px;overflow:hidden}.roster-control-toolbar{display:flex;gap:15px;align-items:center;margin:14px 0}.roster-control-toolbar input{flex:1;min-width:0;padding:12px;font-family:"Courier Prime",monospace}.roster-control-list{display:grid;gap:8px}.roster-control-person{border:1px solid rgba(49,45,31,.3);background:rgba(255,255,255,.16)}.roster-control-person summary{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(150px,.5fr) auto;gap:14px;align-items:center;padding:12px;cursor:pointer}.roster-control-person summary b,.roster-control-person summary small{display:block}.roster-control-person summary strong{font-family:"Oswald",sans-serif;color:#76551b}.roster-control-actions{padding:14px;border-top:1px dashed rgba(49,45,31,.35);display:grid;gap:12px}.roster-control-actions>a,.roster-control-actions button{display:inline-block;background:#343a2b;color:#f0e5c5;border:0;padding:10px 13px;text-decoration:none;font-family:"Oswald",sans-serif;font-weight:700;letter-spacing:.04em;cursor:pointer}.roster-quick-correction{display:grid;grid-template-columns:repeat(3,minmax(130px,1fr));gap:10px}.roster-quick-correction label{font-size:11px;font-weight:700}.roster-quick-correction input,.roster-quick-correction select{width:100%;min-width:0;margin-top:4px;padding:8px}.roster-quick-correction button{grid-column:1/-1}.danger-record-action{display:flex;gap:8px;align-items:center}.danger-record-action input{max-width:160px;padding:9px}.danger-record-action button{background:#6b2e25}.inprocessing-control-board{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;padding:16px;margin:14px 0;border:2px solid #9a6e32;background:rgba(196,158,81,.12)}.inprocessing-control-board small,.inprocessing-control-board strong,.inprocessing-control-board span{display:block}.inprocessing-control-board strong{font-size:1.2rem}.inprocessing-control-board a{background:#30372a;color:#f0e5c5;padding:12px;text-decoration:none;font-weight:700}
.command-global-bar-inner{gap:6px}.command-global-bar-inner a{min-width:116px;padding:12px 14px}.command-desk-shortcuts{grid-template-columns:repeat(4,minmax(180px,1fr));gap:12px}.command-desk-shortcuts a{min-height:100px;padding:16px;border-width:2px}.command-desk-shortcuts b{font-size:1rem}.command-status-grid{grid-template-columns:repeat(4,minmax(150px,1fr))}.command-panel a,.command-form button,.command-decision-row button{cursor:pointer}
@media(max-width:900px){.dispatch-board{width:100%;margin-left:0}.roster-quick-correction{grid-template-columns:1fr 1fr}.roster-control-person summary{grid-template-columns:1fr auto}.roster-control-person summary>span:nth-child(2){display:none}.command-desk-shortcuts,.command-status-grid{grid-template-columns:1fr 1fr}.inprocessing-control-board{grid-template-columns:1fr}}
@media(max-width:600px){.logged-back-wrap{padding:0 10px}.roster-quick-correction,.command-desk-shortcuts,.command-status-grid{grid-template-columns:1fr}.danger-record-action{align-items:stretch;flex-direction:column}.danger-record-action input{max-width:none}}

.member-record-redesign .member-uniform-visual > img.uniform-base-image{transform:scale(1.48)!important;object-position:50% 12%!important;transform-origin:50% 16%!important}.uniform-file-sheet .uniform-record-visual{overflow:hidden;min-height:520px}.uniform-file-sheet .uniform-record-visual > img.uniform-base-image{transform:scale(1.42);transform-origin:50% 15%;object-position:50% 12%;width:100%;height:100%;object-fit:cover}

.processing-status-board{display:grid;gap:10px;margin-top:18px}.processing-soldier{border:1px solid rgba(50,45,30,.35);background:rgba(255,255,255,.2)}.processing-soldier summary{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px;cursor:pointer}.processing-soldier summary b,.processing-soldier summary small{display:block}.processing-soldier summary strong{color:#7b3e25}.processing-requirements{padding:0 14px 14px}.processing-progress{display:flex;justify-content:space-between;padding:10px 0;border-bottom:2px solid #6d6147}.processing-requirement{display:grid;grid-template-columns:30px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px dotted #9a8d70}.processing-requirement i{font-style:normal;font-weight:900;font-size:20px}.processing-requirement.done i{color:#52684b}.processing-requirement.missing{background:rgba(167,91,42,.08)}.processing-requirement.missing i{color:#8c4028}.processing-requirement small{display:block}.processing-requirement button{background:#8b5d2f;color:#fff4d7;border:0;padding:9px 12px;font-family:"Oswald",sans-serif;font-weight:700;cursor:pointer}.processing-complete-banner,.processing-blocked-banner{margin-top:12px;padding:12px;font-weight:900;letter-spacing:.04em}.processing-complete-banner{background:#52684b;color:#fff}.processing-blocked-banner{background:#825238;color:#fff}


/* ======================================================================
   S-1 PERSONNEL DESKTOP LAYOUT REPAIR — AUG 17 2026
   Keeps the upper roster/award/intake composition, but forces all lower
   administrative desks to use the full workroom width instead of falling
   into the narrow secondary grid column.
   ====================================================================== */
.page-s1 .s1-workroom{
  grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);
  align-items:start;
}
.page-s1 .assignment-orders-form,
.page-s1 .replacement-processing-desk,
.page-s1 .promotion-eligibility-board,
.page-s1 .personnel-actions-desk,
.page-s1 .s1-roster-sheet{
  grid-column:1 / -1 !important;
  width:100%;
  max-width:none;
  margin-left:0;
  margin-right:0;
  box-sizing:border-box;
}
.page-s1 .assignment-orders-form{padding:28px 34px}
.page-s1 .replacement-processing-desk{
  display:grid;
  grid-template-columns:minmax(0,1.35fr) minmax(360px,.65fr);
  gap:24px;
  align-items:start;
}
.page-s1 .replacement-certification-form,
.page-s1 .promotion-recommendation-form,
.page-s1 .promotion-hold-form{
  min-width:0;
  width:100%;
  box-sizing:border-box;
}
.page-s1 .replacement-certification-form{grid-row:span 2;padding:26px 30px}
.page-s1 .promotion-recommendation-form,
.page-s1 .promotion-hold-form{padding:24px 26px}
.page-s1 .replacement-certification-form .army-form-grid,
.page-s1 .promotion-recommendation-form .army-form-grid,
.page-s1 .promotion-hold-form .army-form-grid,
.page-s1 .personnel-actions-desk .army-form-grid{
  grid-template-columns:repeat(2,minmax(0,1fr));
}
.page-s1 .replacement-certification-form .paper-action,
.page-s1 .promotion-recommendation-form .paper-action,
.page-s1 .promotion-hold-form .paper-action,
.page-s1 .personnel-actions-desk .paper-action{
  min-width:0;
  width:100%;
}
.page-s1 .processing-status-board{margin-top:22px;gap:10px}
.page-s1 .processing-soldier{overflow:hidden}
.page-s1 .processing-soldier summary{
  grid-template-columns:minmax(0,1fr) auto;
  gap:18px;
  align-items:center;
  padding:14px 16px;
}
.page-s1 .processing-soldier summary strong{white-space:nowrap}
.page-s1 .processing-requirements{padding:0 16px 16px}
.page-s1 .processing-requirement{
  grid-template-columns:28px minmax(0,1fr) auto;
  gap:12px;
}
.page-s1 .processing-requirement form{min-width:0}
.page-s1 .processing-requirement button{white-space:nowrap}
.page-s1 .promotion-eligibility-board{padding:30px 34px}
.page-s1 .personnel-actions-desk{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:24px;
  align-items:start;
}
.page-s1 .personnel-action-form{width:100%;min-width:0;padding:26px 28px;box-sizing:border-box}
.page-s1 .army-form-grid .wide{grid-column:1 / -1}

@media(max-width:1100px){
  .page-s1 .replacement-processing-desk,
  .page-s1 .personnel-actions-desk{grid-template-columns:minmax(0,1fr)}
  .page-s1 .replacement-certification-form{grid-row:auto}
}
@media(max-width:760px){
  .page-s1 .assignment-orders-form,
  .page-s1 .replacement-certification-form,
  .page-s1 .promotion-recommendation-form,
  .page-s1 .promotion-hold-form,
  .page-s1 .promotion-eligibility-board,
  .page-s1 .personnel-action-form{padding:20px 16px}
  .page-s1 .replacement-certification-form .army-form-grid,
  .page-s1 .promotion-recommendation-form .army-form-grid,
  .page-s1 .promotion-hold-form .army-form-grid,
  .page-s1 .personnel-actions-desk .army-form-grid{grid-template-columns:1fr}
  .page-s1 .processing-soldier summary{grid-template-columns:1fr;gap:5px}
  .page-s1 .processing-soldier summary strong{white-space:normal}
  .page-s1 .processing-requirement{grid-template-columns:24px minmax(0,1fr)}
  .page-s1 .processing-requirement form{grid-column:2}
}

/* Automatic Headquarters order numbering */
.auto-order-number-field{border:1px solid rgba(73,58,34,.35);background:rgba(198,185,142,.14);padding:.55rem .65rem;min-height:48px;display:flex;flex-direction:column;justify-content:center;gap:.2rem}.auto-order-number-field small{font-size:.58rem;letter-spacing:.12em;font-weight:700}.auto-order-number-field strong{font-size:.66rem;letter-spacing:.08em;color:#4c563a}


/* Ribbon progress — automatic S-1 / Battalion Clerk tracking */
.ribbon-progress-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin:18px 0}
.ribbon-progress-card{position:relative;overflow:hidden}
.ribbon-progress-card.earned{box-shadow:inset 0 0 0 2px rgba(88,107,61,.45)}
.ribbon-progress-meter{height:11px;background:rgba(22,24,18,.14);border:1px solid rgba(36,40,28,.28);margin:14px 0 10px;overflow:hidden}
.ribbon-progress-meter span{display:block;height:100%;background:repeating-linear-gradient(135deg,#5f6848 0 8px,#737b58 8px 16px);transition:width .25s ease}
.ribbon-progress-card.earned .ribbon-progress-meter span{background:#596343}
.ribbon-progress-meta{display:flex;flex-direction:column;gap:5px}
.ribbon-progress-meta b{font-family:monospace;letter-spacing:.06em}
.ribbon-progress-meta small{line-height:1.45}
.ribbon-progress-card em{display:block;margin-top:8px;font-size:.76rem;opacity:.72}
.earned-ribbon-paper{margin-top:14px}

/* Uniform ribbon rack rendering */
.member-record-redesign .member-uniform-visual,
.page-201 .uniform-record-visual,
.uniform-file-sheet .uniform-record-visual{position:relative}
.uniform-ribbon-rack{position:absolute;display:flex;flex-direction:column;gap:2px;align-items:center;pointer-events:none;z-index:3;transform:translateX(-50%)}
.uniform-ribbon-rack img{display:block;width:34px;height:11px;max-width:none;max-height:none;object-fit:contain;filter:drop-shadow(0 1px 1px rgba(0,0,0,.24))}
.uniform-ribbon-row{display:flex;justify-content:center;gap:1px;line-height:0}
.uniform-ribbon-row.row-size-1 img{width:36px;height:12px}
.uniform-ribbon-rack--file .uniform-ribbon-row{justify-content:flex-start}
.uniform-ribbon-rack--member{left:66.5%;top:49.5%}
.uniform-ribbon-rack--file{left:63.8%;top:32.8%;transform:none;align-items:flex-start}
.member-earned-ribbons{display:flex;flex-direction:column;gap:12px;margin-top:10px}
.member-award-line--ribbon{display:grid;grid-template-columns:116px 1fr auto;gap:14px;align-items:center}
.member-award-ribbon{width:110px;height:31px;object-fit:contain;background:transparent}
.member-award-ribbon--placeholder{display:flex;align-items:center;justify-content:center;border:1px dashed rgba(45,48,36,.32);font-size:10px;letter-spacing:.12em;color:#64583d;width:110px;height:31px}
.member-award-copy{display:flex;flex-direction:column;gap:4px}
.member-award-copy em{font-style:normal;font-size:11px;letter-spacing:.1em;color:#4f5d3c}
.member-award-actions{display:flex;justify-content:flex-end}
.member-secondary-link{display:inline-flex;align-items:center;justify-content:center;padding:10px 14px;border:1px solid #3b4232;background:#e6dbbd;color:#201a10;font:700 11px/1 'Special Elite',serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
.member-secondary-link:hover{background:#dbcfad}
.uniform-awards .uniform-award-line span{font-weight:700;letter-spacing:.08em}
@media(max-width:900px){
  .member-award-line--ribbon{grid-template-columns:1fr;justify-items:start}
  .member-award-actions{justify-content:flex-start}
  .uniform-ribbon-rack img{width:30px;height:10px}
  .uniform-ribbon-row.row-size-1 img{width:32px;height:10px}
  .uniform-ribbon-rack--member{left:66.5%;top:49.5%}
  .uniform-ribbon-rack--file{left:63.8%;top:32.8%;transform:none;align-items:flex-start}
}

/* Public 1/5 Awards and Decorations */
.public-awards-page{background:#252b22}
.public-awards-hero{padding:74px 6vw 58px;background:linear-gradient(rgba(24,29,23,.88),rgba(24,29,23,.95)),url('/static/art/hq-canvas.webp') center/cover;color:#efe4c9;border-bottom:1px solid rgba(211,184,112,.35)}
.public-awards-hero__inner{max-width:1180px;margin:auto}
.public-awards-hero span,.public-awards-section__head>span{font:700 10px/1 'Oswald',sans-serif;letter-spacing:.18em;color:#c2a55d}
.public-awards-hero h1{font-family:'Stardos Stencil',serif;font-size:clamp(42px,6vw,76px);line-height:.98;margin:13px 0 18px}
.public-awards-hero p{max-width:830px;font:16px/1.7 'Courier Prime',monospace;color:#ddd0ae}
.public-awards-index{max-width:1180px;margin:0 auto;padding:22px 6vw;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.public-awards-index a{padding:18px 20px;background:#d8cba8;color:#211d14;border:1px solid #76694b;text-decoration:none;display:flex;flex-direction:column;gap:4px}
.public-awards-index b{font:700 17px/1 'Stardos Stencil',serif}.public-awards-index small{font:10px/1.4 'Courier Prime',monospace;letter-spacing:.05em}
.public-awards-section{padding:48px 6vw 72px;max-width:1320px;margin:auto}
.public-awards-section__head{max-width:900px;margin-bottom:28px;color:#eadfc2}.public-awards-section__head h2{font-family:'Stardos Stencil',serif;font-size:42px;margin:7px 0 10px}.public-awards-section__head p{font:14px/1.65 'Courier Prime',monospace;color:#cfc2a1}
.public-awards-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.public-award-card{display:grid;grid-template-columns:220px 1fr;gap:22px;align-items:start;background:#ddd1ae;color:#261f14;border:1px solid #786b4e;box-shadow:0 12px 24px rgba(0,0,0,.2);padding:20px}
.public-award-card__image{display:flex;align-items:center;justify-content:center;align-self:start;min-height:0;padding:12px;background:rgba(67,65,47,.08);border:1px solid rgba(62,57,42,.18)}
.public-award-card__image img{width:100%;max-width:210px;height:auto;object-fit:contain}.public-award-card__image span{font:700 10px/1 'Courier Prime',monospace;letter-spacing:.1em;color:#74664a}
.public-award-card__meta{display:flex;justify-content:space-between;gap:14px;font:700 9px/1.3 'Oswald',sans-serif;letter-spacing:.12em;color:#705d2d}.public-award-card h3{font-family:'Stardos Stencil',serif;font-size:25px;line-height:1.05;margin:9px 0}.public-award-card p,.public-award-card li{font:12px/1.55 'Courier Prime',monospace}.public-award-card ul{padding-left:18px;margin:9px 0 0}.public-award-card li+li{margin-top:5px}
.public-awards-section--medals{border-top:1px solid rgba(211,184,112,.22)}.public-awards-empty{padding:35px;background:#d8cba8;border:1px solid #76694b;color:#241e13}.public-awards-empty b{font:700 24px/1 'Stardos Stencil',serif}.public-awards-empty p{font:13px/1.6 'Courier Prime',monospace;max-width:720px}
@media(max-width:950px){.public-awards-grid{grid-template-columns:1fr}.public-award-card{grid-template-columns:180px 1fr}}
@media(max-width:640px){.public-awards-index{grid-template-columns:1fr}.public-award-card{grid-template-columns:1fr}.public-award-card__image img{max-width:260px}.public-awards-hero{padding:48px 20px}.public-awards-section{padding:38px 20px 58px}.public-awards-index{padding:16px 20px}.public-award-card__meta{flex-direction:column}}

/* 201 File ribbon wear controls */
.uniform-award-line--controlled{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(65,55,34,.22)}
.uniform-award-line--controlled>div{display:flex;justify-content:space-between;gap:18px;align-items:center;min-width:0}
.uniform-wear-status,.award-wear-badge{display:inline-block;font-family:var(--type-font,monospace);font-size:.72rem;font-style:normal;font-weight:800;letter-spacing:.08em;padding:3px 7px;border:1px solid currentColor;white-space:nowrap}
.uniform-wear-status.is-worn,.award-wear-badge.is-worn{color:#3f5a36}
.uniform-wear-status.not-worn,.award-wear-badge.not-worn{color:#8b4d35}
.uniform-wear-action button,.award-record-action button{border:1px solid rgba(59,53,34,.72);background:#3e4932;color:#efe6c7;padding:7px 11px;font-family:var(--type-font,monospace);font-size:.72rem;font-weight:800;letter-spacing:.08em;cursor:pointer;text-transform:uppercase}
.uniform-wear-action button:hover,.award-record-action button:hover{filter:brightness(1.08)}
.award-record-row{position:relative;padding-right:112px}
.award-record-row>span{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.award-record-action{position:absolute;right:0;top:50%;transform:translateY(-50%)}
@media(max-width:760px){.uniform-award-line--controlled{grid-template-columns:1fr}.uniform-award-line--controlled>div{align-items:flex-start;flex-direction:column;gap:5px}.uniform-wear-action button{width:100%}.uniform-wear-action{width:100%}.award-record-row{padding-right:0}.award-record-action{position:static;transform:none;margin-top:8px}.award-record-action button{width:100%}}


/* S-1 inactivity / M16 accountability */
.inactivity-control-board{margin-top:24px}.inactivity-count-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:14px 0}.inactivity-count-grid span{border:1px solid rgba(69,58,36,.32);padding:10px;background:rgba(214,200,160,.28);display:flex;flex-direction:column}.inactivity-count-grid small{font-size:9px;letter-spacing:.08em}.inactivity-count-grid b{font-size:20px}.inactivity-table{display:grid;grid-template-columns:1.25fr 1.35fr .85fr .85fr 1fr;gap:12px;align-items:center}.inactivity-table.head{padding:9px 12px;border-bottom:2px solid #4d4431;font-size:9px;font-weight:800;letter-spacing:.09em}.inactivity-soldier{border-bottom:1px dotted #8a7b5d}.inactivity-soldier summary{padding:12px;cursor:pointer}.inactivity-soldier summary span{display:flex;flex-direction:column;min-width:0}.inactivity-soldier summary small{font-size:9px;opacity:.75}.inactivity-soldier.watch summary,.activity-accountability-strip.watch{background:rgba(180,151,60,.12)}.inactivity-soldier.deficient summary,.activity-accountability-strip.deficient{background:rgba(167,104,42,.15)}.inactivity-soldier.inactive summary,.activity-accountability-strip.inactive{background:rgba(139,71,42,.16)}.inactivity-soldier.command-review summary,.activity-accountability-strip.command-review{background:rgba(120,46,37,.18)}.inactivity-soldier.excused-absence summary,.activity-accountability-strip.excused-absence{background:rgba(79,100,66,.14)}.inactivity-actions-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px;background:rgba(255,255,255,.16)}.activity-accountability-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid rgba(74,61,38,.38);margin:12px 0 16px}.activity-accountability-strip>div{padding:10px 12px;border-right:1px dotted #83775e;display:flex;flex-direction:column}.activity-accountability-strip>div:last-child{border-right:0}.activity-accountability-strip small{font-size:8px;letter-spacing:.12em}.activity-accountability-strip b{font-size:12px;margin:3px 0}.activity-accountability-strip span{font-size:9px}.paper-action.danger{background:#7c4432;color:#f4ead0}
@media(max-width:900px){.inactivity-count-grid{grid-template-columns:repeat(2,1fr)}.inactivity-table,.inactivity-table.head{grid-template-columns:1fr}.inactivity-table.head{display:none}.inactivity-actions-grid{grid-template-columns:1fr}.activity-accountability-strip{grid-template-columns:1fr}.activity-accountability-strip>div{border-right:0;border-bottom:1px dotted #83775e}}


/* Personnel / Training Expansion */
.leadership-days-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:14px}.leadership-days-grid>div{border:1px solid rgba(65,55,36,.35);padding:12px;background:rgba(190,175,130,.12);display:grid;gap:3px}.leadership-days-grid small{font-size:10px;letter-spacing:.08em}.leadership-days-grid b{font:700 20px/1.1 monospace}.leadership-days-grid span{font-size:10px}.mos-proficiency-card{border:2px solid rgba(66,65,43,.5);padding:18px;background:rgba(184,169,122,.12)}.mos-proficiency-card h3{font:700 28px/1.05 'Stardos Stencil',serif;margin:6px 0 15px}.mos-prof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mos-prof-grid span{border-top:1px solid #74684d;padding-top:8px;display:grid}.mos-prof-grid b{font-size:22px}.mos-prof-grid small{font-size:9px;letter-spacing:.08em}.training-def-head,.training-def-row,.suspense-head,.suspense-row{display:grid;grid-template-columns:1.4fr 1.6fr .7fr 1fr;gap:10px;align-items:center;padding:9px 8px;border-bottom:1px dotted rgba(64,55,38,.35)}.training-def-head,.suspense-head{font:700 10px monospace;letter-spacing:.08em;border-bottom:2px solid #514832}.training-def-row span,.suspense-row span{font-size:11px}.training-def-row span small,.suspense-row span small{display:block;font-size:9px;opacity:.72}.training-def-row.severity-critical,.suspense-row.overdue{background:rgba(130,44,35,.12);border-left:4px solid #7a3028}.training-def-row.severity-high,.suspense-row.due-soon{background:rgba(143,104,36,.10);border-left:4px solid #8a6a2e}.training-def-row.severity-watch{border-left:4px solid #77704c}.s1-suspense-board{margin-top:20px}.s1-suspense-board .paper-action{margin-top:12px}.recruit-compact-case small{letter-spacing:.05em}@media(max-width:850px){.training-def-head,.suspense-head{display:none}.training-def-row,.suspense-row{grid-template-columns:1fr;gap:4px}.mos-prof-grid{grid-template-columns:1fr 1fr 1fr}}


/* Combat leadership / unit cohesion / unit experience */
.leadership-score-head{display:grid;grid-template-columns:minmax(180px,.34fr) 1fr;gap:18px;align-items:center;margin:12px 0}.leadership-score-head>div{border:2px solid rgba(54,49,37,.45);padding:12px;text-align:center}.leadership-score-head strong{display:block;font-size:2rem;letter-spacing:.08em}.leadership-score-head span,.leadership-score-head small{display:block}.leadership-score-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.leadership-score-grid>div{border:1px solid rgba(54,49,37,.28);padding:9px;text-align:center}.leadership-score-grid small,.leadership-score-grid b{display:block}.leadership-facts{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:12px;border-top:1px solid rgba(54,49,37,.25);padding-top:10px;font-size:.82rem}.unit-performance-board{margin-top:20px}.unit-performance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.unit-performance-card .cohesion-number{text-align:center;border:2px solid rgba(54,49,37,.42);padding:12px;margin:10px 0}.unit-performance-card .cohesion-number strong{display:block;font-size:2.25rem}.unit-performance-card .cohesion-number span{font-size:.75rem;letter-spacing:.16em}.unit-performance-card dl{display:grid;grid-template-columns:1fr auto;gap:5px 12px}.unit-performance-card dt,.unit-performance-card dd{margin:0;border-bottom:1px dotted rgba(54,49,37,.25);padding:4px 0}.unit-experience-line{margin-top:12px;padding-top:10px;border-top:2px solid rgba(54,49,37,.3)}.unit-experience-line b,.unit-experience-line span,.unit-experience-line small{display:block}.readiness-score-line{display:flex;gap:16px;align-items:center}.readiness-score-line strong{font-size:2rem}@media(max-width:850px){.leadership-score-head,.unit-performance-grid{grid-template-columns:1fr}.leadership-score-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}

.promotion-leadership-advisory{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin:10px 0 14px;padding:9px 11px;border:1px solid rgba(54,49,37,.35);background:rgba(102,91,61,.06)}.promotion-leadership-advisory span,.promotion-leadership-advisory small{font-size:.72rem;letter-spacing:.08em}.promotion-leadership-advisory b{font-size:.95rem}

/* MEMBER CAREER EXPERIENCE ------------------------------------------------ */
.member-career-command{margin:22px 0;padding:18px}.career-command-grid,.career-overview-grid,.service-stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.career-command-grid>div,.career-card,.service-stat-card{border:1px solid rgba(46,39,26,.28);background:rgba(244,235,207,.72);padding:12px;box-shadow:0 2px 8px rgba(0,0,0,.08)}.career-command-grid small,.career-card small,.service-stat-card small{display:block;font-size:.72rem;letter-spacing:.08em}.career-command-grid strong,.career-card strong,.service-stat-card strong{display:block;font-size:1.22rem;margin-top:4px}.career-card span{font-size:.75rem;opacity:.78}.career-tour-meter{height:8px;border:1px solid #393325;margin:14px 0;background:rgba(0,0,0,.08)}.career-tour-meter span{display:block;height:100%;background:#4f5940}.career-milestone-line,.career-row{display:grid;grid-template-columns:1fr auto;gap:4px 14px;padding:9px 0;border-bottom:1px dashed rgba(0,0,0,.28)}.career-milestone-line span,.career-row span{font-size:.72rem;letter-spacing:.07em}.career-milestone-line small,.career-row small{grid-column:1/-1;opacity:.78}.career-command-links,.career-page-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.career-command-links a,.career-page-actions a{border:1px solid #393325;padding:8px 10px;background:rgba(230,218,183,.75);text-decoration:none;color:inherit;font-weight:700}.career-file-shell,.qualification-card-shell{max-width:1180px;margin:0 auto;padding:22px}.career-file-hero{margin-bottom:14px;padding:20px}.career-file-hero h1{margin:.25rem 0}.career-overview-grid{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px}.career-page-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.career-paper{padding:18px}.career-paper header{border-bottom:2px solid #393325;margin-bottom:10px;padding-bottom:8px}.career-row.emphasized{font-size:1.05rem;border:2px solid rgba(46,39,26,.38);padding:12px}.service-stat-grid{grid-template-columns:repeat(5,minmax(0,1fr));margin:14px 0}.service-stat-card strong{font-size:1.65rem}.weekly-soldier-report{max-width:780px;margin:0 auto 16px;padding:24px}.weekly-report-grid,.qualification-card-period dl{display:grid;grid-template-columns:190px 1fr;border-top:1px solid #302a20}.weekly-report-grid dt,.weekly-report-grid dd,.qualification-card-period dt,.qualification-card-period dd{padding:9px;border-bottom:1px solid rgba(48,42,32,.3);margin:0}.weekly-report-grid dt,.qualification-card-period dt{font-weight:700;border-right:1px solid rgba(48,42,32,.3)}.qualification-card-period{max-width:720px;margin:30px auto 18px;background:#e5d6aa;padding:24px;border:2px solid #302a20;box-shadow:0 7px 20px rgba(0,0,0,.2);font-family:"Courier New",monospace}.qualification-card-period header{text-align:center;border-bottom:3px double #302a20;padding-bottom:12px}.qualification-card-period header>*{display:block}.qual-card-title{text-align:center;font-size:1.4rem;font-weight:800;margin:14px 0}.qualification-card-period footer{text-align:center;border-top:1px solid #302a20;margin-top:14px;padding-top:10px;font-size:.72rem}.qualification-card-link{color:inherit;text-decoration:none}.qualification-card-link:hover{background:rgba(90,88,53,.11)}@media(max-width:800px){.career-command-grid,.career-overview-grid,.service-stat-grid,.career-page-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.career-command-grid,.career-overview-grid,.service-stat-grid,.career-page-grid{grid-template-columns:1fr}.weekly-report-grid,.qualification-card-period dl{grid-template-columns:1fr}.weekly-report-grid dt,.qualification-card-period dt{border-right:0}}


/* MEMBER CAREER PROGRESSION II */
.stand-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}.stand-grid>div{border:1px solid rgba(46,39,26,.28);padding:10px;background:rgba(244,235,207,.68)}.stand-grid small{display:block;font-size:.7rem;letter-spacing:.07em}.stand-grid strong{font-size:1.1rem}.promotion-readiness-line{display:grid;grid-template-columns:95px 1fr 45px;align-items:center;gap:8px;margin:8px 0}.promotion-readiness-line>div,.service-goal-progress>div{height:8px;border:1px solid #393325;background:rgba(0,0,0,.08)}.promotion-readiness-line i,.service-goal-progress i{display:block;height:100%;background:#4f5940}.service-goal-form{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;margin:12px 0}.service-goal-form button{grid-column:1/-1}.service-goal-progress{display:grid;grid-template-columns:1fr auto;gap:5px 10px;padding:8px 0;border-top:1px dashed rgba(0,0,0,.28)}.service-goal-progress>div,.service-goal-progress small{grid-column:1/-1}.unit-identity-strip{display:flex;gap:14px;align-items:center;justify-content:center;margin-top:10px;padding:8px;border-top:1px solid rgba(0,0,0,.3);border-bottom:1px solid rgba(0,0,0,.3)}.unit-identity-strip b{font-size:1.2rem}.unit-identity-strip span{font-size:.8rem;letter-spacing:.08em}@media(max-width:800px){.stand-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.stand-grid,.service-goal-form{grid-template-columns:1fr}}

/* VERIFIED AUTOMATION / OPERATION CREDIT LEDGER */
.automated-credit-ledger{margin-top:14px}.operation-credit-row{display:grid;grid-template-columns:1fr auto;gap:5px 12px;padding:10px 0;border-bottom:1px dashed rgba(0,0,0,.28)}.operation-credit-row>small{grid-column:1/-1}.operation-credit-row small{opacity:.76}.credit-stamp{align-self:center;border:2px solid rgba(78,65,39,.75);padding:4px 7px;font-weight:800;font-size:.7rem;letter-spacing:.08em;transform:rotate(-1deg)}

/* FINAL INTEGRITY PASS — layout containment / mobile safety */
*,*::before,*::after{box-sizing:border-box}
.command-panel,.member-dashboard-card,.document-sheet,.career-paper,.career-card,.service-stat-card,.qualification-card-period,.member-section-block,.dashboard-card,.panel,.paper-panel,.staff-panel,.recruit-case,.recruit-card{min-width:0;max-width:100%}
.command-panel h1,.command-panel h2,.command-panel h3,.member-dashboard-card h1,.member-dashboard-card h2,.member-dashboard-card h3,.document-sheet h1,.document-sheet h2,.document-sheet h3,.career-row,.career-milestone-line,.member-qual-line,.recruit-case,.recruit-card,p,dd,dt,label,button,a,span,strong,small{overflow-wrap:anywhere;word-break:normal}
input,select,textarea,button{max-width:100%;min-width:0}
img,svg,video{max-width:100%;height:auto}
.career-command-grid>*,.career-overview-grid>*,.career-page-grid>*,.service-stat-grid>*,.stand-grid>*{min-width:0}
@media(max-width:720px){.command-panel form,.stack-form,.form-grid,.recruit-form-grid{grid-template-columns:1fr!important}.career-page-actions,.career-command-links{align-items:stretch}.career-page-actions a,.career-command-links a{flex:1 1 100%;text-align:center}}


/* RECRUITING APPLICATION ARCHIVE */
.recruit-compact-case{display:flex;align-items:center;justify-content:space-between;gap:16px}
.recruit-compact-case>div{display:grid;gap:3px;min-width:0}
.recruit-file-button{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;padding:8px 12px;border:1px solid rgba(40,34,24,.55);background:rgba(238,226,190,.78);color:inherit;text-decoration:none;font-weight:700;font-size:.78rem;letter-spacing:.04em}
.recruit-archive-shell{max-width:1180px;margin:0 auto;padding:20px}
.recruit-archive-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}
.recruit-archive-status{padding:6px 10px;border:1px solid rgba(40,34,24,.45);font-weight:700;letter-spacing:.06em}
.recruit-archive-file{padding:22px}
.recruit-archive-header{display:flex;justify-content:space-between;gap:20px;padding-bottom:12px;border-bottom:2px solid rgba(40,34,24,.48)}
.recruit-archive-header>div:last-child{text-align:right}
.recruit-archive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:18px 0}
.recruit-archive-grid>div{padding:10px;border:1px solid rgba(40,34,24,.22);min-width:0}
.recruit-archive-grid small,.recruit-archive-written small,.recruit-archive-timeline small{display:block;font-size:.7rem;letter-spacing:.07em;margin-bottom:3px}
.recruit-archive-written{display:grid;gap:12px;margin:18px 0}
.recruit-archive-written>div{padding:12px;border-top:1px dashed rgba(40,34,24,.35)}
.recruit-archive-written p{white-space:pre-wrap;margin:.4rem 0 0}
.recruit-archive-timeline{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;border-top:2px solid rgba(40,34,24,.48);padding-top:16px}
.recruit-archive-timeline>div{padding:8px 0;border-bottom:1px dotted rgba(40,34,24,.3)}
.recruit-return-review{margin-top:18px;padding:18px}
.recruit-return-review form{display:grid;gap:10px}
.recruit-return-review textarea{width:100%}
.recruit-return-review.locked{opacity:.82}
@media(max-width:820px){.recruit-archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.recruit-compact-case{align-items:flex-start;flex-direction:column}.recruit-file-button{width:100%}}
@media(max-width:540px){.recruit-archive-grid,.recruit-archive-timeline{grid-template-columns:1fr}.recruit-archive-header,.recruit-archive-nav{flex-direction:column;align-items:flex-start}.recruit-archive-header>div:last-child{text-align:left}}


/* PROSPECTIVE REPLACEMENTS — LIVE DISCORD INTAKE */
.prospective-shell{max-width:1220px;margin:0 auto;padding:20px}
.prospective-nav{display:flex;justify-content:space-between;gap:14px;align-items:center;margin-bottom:14px}
.prospective-nav span{font-size:.75rem;letter-spacing:.08em;font-weight:700}
.prospective-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:18px}
.prospective-stats article{padding:12px;border:1px solid rgba(40,34,24,.35);background:rgba(235,224,190,.74);min-width:0}
.prospective-stats small{display:block;font-size:.68rem;letter-spacing:.07em}
.prospective-stats strong{font-size:1.45rem}
.prospective-board>header{margin-bottom:12px}
.prospective-row{display:grid;grid-template-columns:minmax(180px,1.4fr) repeat(4,minmax(130px,1fr)) minmax(150px,.8fr);gap:12px;align-items:center;padding:14px;margin-bottom:10px}
.prospective-row>div{min-width:0}
.prospective-row small{display:block;font-size:.66rem;letter-spacing:.07em;margin-bottom:3px}
.prospective-identity h3{margin:0;font-size:1.05rem}
.prospective-identity span{font-size:.78rem;opacity:.8}
.prospective-actions a{display:inline-flex;width:100%;justify-content:center;padding:8px 10px;border:1px solid rgba(40,34,24,.5);background:rgba(238,226,190,.78);color:inherit;text-decoration:none;font-weight:700;font-size:.73rem}
.prospective-actions span{display:block;font-size:.7rem;font-weight:700;letter-spacing:.04em}
@media(max-width:1000px){.prospective-row{grid-template-columns:repeat(3,minmax(0,1fr))}.prospective-actions{grid-column:1/-1}.prospective-actions a{width:auto}}
@media(max-width:700px){.prospective-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.prospective-row{grid-template-columns:1fr 1fr}.prospective-identity,.prospective-actions{grid-column:1/-1}.prospective-nav{align-items:flex-start;flex-direction:column}}
@media(max-width:460px){.prospective-stats,.prospective-row{grid-template-columns:1fr}.prospective-identity,.prospective-actions{grid-column:auto}}


/* COMMAND ADOPT DISCORD MEMBER */
.prospective-adopt-form{display:block;width:100%}
.prospective-adopt-form button{width:100%;padding:8px 10px;border:1px solid rgba(40,34,24,.5);background:rgba(228,216,178,.9);font-weight:700;font-size:.73rem;letter-spacing:.04em;cursor:pointer}
.prospective-adopt-note{display:block;margin-top:6px;font-size:.64rem;line-height:1.35;opacity:.82}


/* DIRECT RECRUITING CONTROL — DISCORD-FIRST INTAKE */
.discord-intake-board{margin:18px 0 24px}
.discord-intake-board>header{padding:14px 0}
.discord-intake-summary{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.discord-intake-summary span{padding:7px 9px;border:1px solid rgba(40,34,24,.3);background:rgba(236,224,190,.7);font-size:.72rem;letter-spacing:.04em}
.discord-intake-row{display:grid;grid-template-columns:minmax(180px,1.4fr) minmax(120px,.9fr) minmax(120px,.8fr) minmax(170px,1.15fr) minmax(180px,1fr);gap:12px;align-items:center;padding:13px;margin-bottom:9px}
.discord-intake-row>div{min-width:0}
.discord-intake-row small{display:block;font-size:.65rem;letter-spacing:.07em;margin-bottom:3px}
.discord-intake-name{display:grid;gap:2px}
.discord-intake-name strong{font-size:1rem}
.discord-intake-name span{font-size:.76rem;opacity:.8}
.discord-intake-action a,.discord-intake-action button{display:flex;width:100%;align-items:center;justify-content:center;min-height:38px;padding:8px 10px;border:1px solid rgba(40,34,24,.52);background:rgba(224,210,168,.95);color:inherit;text-decoration:none;font-weight:800;font-size:.72rem;letter-spacing:.035em;text-align:center;cursor:pointer}
.discord-intake-action form{margin:0}
@media(max-width:940px){.discord-intake-row{grid-template-columns:repeat(2,minmax(0,1fr))}.discord-intake-name,.discord-intake-action{grid-column:1/-1}}
@media(max-width:520px){.discord-intake-row{grid-template-columns:1fr}.discord-intake-name,.discord-intake-action{grid-column:auto}}

.member-record-warning{max-width:1180px;margin:14px auto;padding:14px;border:2px solid rgba(95,62,30,.55)}
.member-record-warning p{margin:.4rem 0 0}

/* 201 FILE RECOVERY MODE */
.member-core-shell{max-width:1050px;margin:0 auto;padding:20px}
.member-core-warning,.member-core-card{padding:18px;margin-bottom:16px}
.member-core-warning{border:2px solid rgba(110,70,30,.58)}
.member-core-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.member-core-grid>div{padding:10px;border:1px solid rgba(40,34,24,.22);min-width:0}
.member-core-grid small{display:block;font-size:.68rem;letter-spacing:.07em;margin-bottom:3px}
.member-core-actions{display:flex;gap:10px;flex-wrap:wrap}
.member-core-actions a{padding:10px 12px;border:1px solid rgba(40,34,24,.5);text-decoration:none;color:inherit;font-weight:700}
@media(max-width:760px){.member-core-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:460px){.member-core-grid{grid-template-columns:1fr}.member-core-actions{flex-direction:column}}


/* ==========================================================================
   STAFF UX OVERHAUL — ACTION CENTER / CONSOLIDATED WORKSPACE
   ========================================================================== */
.staff-utility-bar{position:relative;z-index:34;display:grid;grid-template-columns:minmax(220px,1fr) minmax(300px,520px) auto;gap:14px;align-items:center;padding:9px max(20px,calc((100vw - 1500px)/2));background:#1f251d;border-bottom:1px solid rgba(221,202,150,.35);color:#e8dfc5}
.staff-breadcrumbs{display:flex;align-items:center;gap:8px;min-width:0;font-size:.72rem;letter-spacing:.06em}.staff-breadcrumbs a{color:inherit;text-decoration:none}.staff-breadcrumbs b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.staff-global-search{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:7px}.staff-global-search label{font-size:.63rem;letter-spacing:.08em}.staff-global-search input{min-width:0;padding:7px 9px}.staff-global-search button,.staff-return-office{padding:7px 10px;border:1px solid rgba(230,215,174,.42);background:#343c2f;color:#f1e8cf;text-decoration:none;font:inherit;font-weight:700;font-size:.7rem;cursor:pointer}
.staff-nav-disabled{opacity:.35;pointer-events:none}.staff-center-tab{border-color:rgba(222,194,118,.55)!important}
.staff-center-hero{max-width:1500px;margin:18px auto 0;padding:26px 30px;display:flex;justify-content:space-between;gap:24px;align-items:flex-end;background:linear-gradient(90deg,rgba(34,42,31,.98),rgba(50,58,45,.92));border:1px solid rgba(224,204,151,.25);color:#f1e5c3}.staff-center-hero small{letter-spacing:.12em}.staff-center-hero h1{margin:.25rem 0;font-size:clamp(2rem,4vw,4rem)}.staff-center-hero p{margin:0;max-width:800px}.staff-role-stamp{display:grid;gap:3px;padding:11px 14px;border:2px double rgba(234,215,158,.55);text-align:center;font-size:.75rem;letter-spacing:.08em}.staff-role-stamp b{font-size:.9rem}
.staff-center-shell{max-width:1500px;margin:0 auto;padding:18px 24px 36px}.staff-brief-strip{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;margin-bottom:14px}.staff-brief-strip article{background:#e5d8b4;border:1px solid rgba(48,42,30,.28);padding:11px 12px;min-width:0}.staff-brief-strip small,.staff-brief-strip span{display:block}.staff-brief-strip small{font-size:.62rem;letter-spacing:.08em}.staff-brief-strip strong{display:block;font-size:1.7rem;line-height:1.1;margin:.2rem 0}.staff-brief-strip span{font-size:.68rem}.staff-brief-strip .status-good{box-shadow:inset 4px 0 #586b43}.staff-brief-strip .status-warn{box-shadow:inset 4px 0 #9a7335}.staff-brief-strip .status-attn{box-shadow:inset 4px 0 #8b4036}
.staff-center-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}.staff-center-top-grid{grid-template-columns:1.08fr .92fr}.staff-center-grid>.document-sheet,.staff-search-desk,.staff-batch-desk{padding:18px;min-width:0}.staff-center-grid header,.staff-search-desk>header,.staff-batch-desk>header{display:flex;justify-content:space-between;gap:12px;align-items:flex-end;border-bottom:1px solid rgba(45,39,27,.35);padding-bottom:9px;margin-bottom:10px}.staff-center-grid h2,.staff-search-desk h2,.staff-batch-desk h2{margin:.15rem 0}.staff-brief-lines{display:grid;gap:2px}.staff-brief-lines p{display:grid;grid-template-columns:125px 1fr;gap:14px;padding:8px 0;border-bottom:1px dotted rgba(45,39,27,.28);margin:0}.staff-brief-lines b{font-size:.72rem;letter-spacing:.05em}.staff-brief-lines span{font-size:.83rem}
.staff-attention-board{display:grid;align-content:start}.staff-attention-row{display:grid;grid-template-columns:48px 1fr auto;gap:10px;align-items:center;padding:10px;margin:4px 0;border:1px solid rgba(50,43,30,.25);color:inherit;text-decoration:none}.staff-attention-row>strong{font-size:1.35rem;text-align:center}.staff-attention-row div{display:grid;gap:2px}.staff-attention-row span{font-size:.72rem}.staff-attention-row em{font-style:normal;font-size:.68rem;font-weight:700}.staff-attention-row.red{box-shadow:inset 4px 0 #8b4036}.staff-attention-row.amber{box-shadow:inset 4px 0 #9a7335}.staff-clear-state{padding:22px;border:1px dashed rgba(55,47,33,.35);display:grid;gap:5px;text-align:center}
.staff-search-desk{margin:14px 0}.staff-search-form{display:grid;grid-template-columns:1fr auto auto;gap:8px}.staff-search-form input{min-width:0;padding:10px}.staff-search-form button,.staff-search-form a{padding:9px 14px;border:1px solid rgba(48,42,30,.44);background:#36402f;color:#f4e8c6;text-decoration:none;font-weight:700;cursor:pointer}.staff-search-results{display:grid;gap:7px;margin-top:12px}.staff-search-result{display:grid;grid-template-columns:1fr 110px 150px;gap:12px;align-items:center;padding:10px;border:1px solid rgba(47,41,28,.25);background:rgba(255,250,232,.2)}.staff-search-result>div:first-child{display:grid;gap:2px}.staff-search-result small,.staff-search-result span{font-size:.7rem}.staff-search-status{text-align:center}.staff-search-status strong,.staff-search-status span{display:block}.staff-search-result button{padding:8px;border:1px solid rgba(50,43,30,.45);background:#3c4534;color:#f1e4c1;font-weight:700;cursor:pointer}
.staff-office-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:14px 0}.staff-office-grid a{display:grid;gap:5px;padding:15px;background:#252d22;border:1px solid rgba(229,210,155,.25);color:#eee1bf;text-decoration:none}.staff-office-grid a:hover{transform:translateY(-1px);border-color:rgba(229,210,155,.62)}.staff-office-grid span{font-size:.68rem;opacity:.82}
.staff-action-row{display:grid;grid-template-columns:1fr 110px 110px;gap:10px;padding:9px 0;border-bottom:1px dotted rgba(45,39,27,.3);text-decoration:none;color:inherit}.staff-action-row>div{display:grid;gap:2px}.staff-action-row small,.staff-action-row span,.staff-action-row time{font-size:.68rem}.staff-action-row.priority-high,.staff-action-row.priority-urgent,.staff-action-row.priority-critical{box-shadow:inset 3px 0 #8b4036;padding-left:8px}.staff-recent-row{display:grid;grid-template-columns:110px 1fr auto;gap:10px;padding:8px 0;border-bottom:1px dotted rgba(45,39,27,.25);align-items:start}.staff-recent-row>div{display:grid;gap:2px}.staff-recent-row time,.staff-recent-row small,.staff-recent-row span{font-size:.68rem}.staff-empty{padding:14px;text-align:center;opacity:.72}
.staff-batch-form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.staff-batch-form label{display:grid;gap:4px}.staff-batch-form .wide,.staff-batch-people,.staff-batch-form>button{grid-column:1/-1}.staff-batch-people{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;max-height:260px;overflow:auto;border:1px solid rgba(50,43,30,.3);padding:10px}.staff-batch-people label{display:flex;gap:7px;align-items:start;padding:5px}.staff-batch-people small{display:block}.staff-batch-form>button{padding:11px;background:#35402f;color:#f0e3be;border:0;font-weight:700;cursor:pointer}
.staff-quick-drawer{position:fixed;z-index:120;top:0;right:0;width:min(430px,92vw);height:100vh;padding:26px;background:#e3d5ad;border-left:4px solid #333b2e;transform:translateX(105%);transition:transform .2s ease;box-shadow:-12px 0 32px rgba(0,0,0,.28);overflow:auto}.staff-quick-drawer.open{transform:none}.staff-drawer-backdrop{position:fixed;z-index:119;inset:0;background:rgba(15,18,13,.56);opacity:0;pointer-events:none;transition:opacity .2s}.staff-drawer-backdrop.open{opacity:1;pointer-events:auto}.staff-drawer-close{position:absolute;right:12px;top:10px;border:0;background:none;font-size:2rem;cursor:pointer}.staff-quick-drawer dl{display:grid;grid-template-columns:120px 1fr;gap:8px;margin:20px 0}.staff-quick-drawer nav{display:grid;gap:8px}.staff-quick-drawer nav a{padding:11px;background:#333d2e;color:#f2e7c7;text-decoration:none;font-weight:700}.staff-quick-drawer nav a[hidden]{display:none}
.staff-page-return,.staff-snapshot-actions{display:flex;gap:8px;margin-bottom:12px}.staff-page-return a,.staff-snapshot-actions a{padding:9px 12px;background:#35402f;color:#f0e3be;text-decoration:none;font-weight:700}.staff-snapshot-head,.staff-snapshot-grid>.document-sheet{padding:18px}.staff-snapshot-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0}
.personnel-filter-toolbar{display:flex;justify-content:space-between;gap:12px;align-items:end;padding:12px;margin-bottom:12px}.personnel-filter-toolbar button{padding:7px 9px;border:1px solid rgba(45,39,27,.3);background:#ddd0aa;cursor:pointer}.personnel-filter-toolbar label{display:grid;gap:4px}.personnel-filter-toolbar input{padding:8px}.personnel-file-card.staff-filter-hidden{display:none!important}
.action-form-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:8px 0 14px}.action-form-steps span{display:flex;align-items:center;gap:6px;padding:7px;border:1px solid rgba(50,43,30,.25);font-size:.64rem}.action-form-steps b{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#39432f;color:#f0e4c2}.action-route-helper{padding:9px;border:1px dashed rgba(50,43,30,.35);font-size:.72rem}
@media(max-width:1100px){.staff-brief-strip{grid-template-columns:repeat(3,1fr)}.staff-office-grid,.staff-batch-people{grid-template-columns:repeat(2,1fr)}.staff-utility-bar{grid-template-columns:1fr auto}.staff-global-search{grid-column:1/-1;grid-row:2}.staff-center-top-grid{grid-template-columns:1fr}}
@media(max-width:720px){.staff-center-grid,.staff-snapshot-grid{grid-template-columns:1fr}.staff-center-hero{align-items:flex-start;flex-direction:column}.staff-brief-strip{grid-template-columns:repeat(2,1fr)}.staff-office-grid,.staff-batch-people{grid-template-columns:1fr}.staff-search-result{grid-template-columns:1fr}.staff-search-status{text-align:left}.staff-batch-form{grid-template-columns:1fr}.staff-batch-form>*{grid-column:1!important}.staff-utility-bar{grid-template-columns:1fr}.staff-return-office{display:none}.staff-action-row{grid-template-columns:1fr}.staff-recent-row{grid-template-columns:85px 1fr}.staff-recent-row>small{grid-column:2}.action-form-steps{grid-template-columns:1fr}.personnel-filter-toolbar{align-items:stretch;flex-direction:column}}


/* ===== CUMULATIVE UX / S-3 / MOBILE FINAL PASS ===== */
/* 201 jacket name stamp */
.page-personnel .personnel-folder-name-stamp{position:relative;z-index:4;width:min(88%,390px);margin:42px auto 20px;padding:13px 18px 11px;border:2px solid rgba(76,54,30,.62);outline:1px solid rgba(76,54,30,.22);outline-offset:3px;color:#49331f;text-align:center;text-transform:uppercase;transform:rotate(-.35deg);background:rgba(221,199,142,.20)}
.page-personnel .personnel-folder-name-stamp small{display:block;margin-bottom:6px;font-size:7px;font-weight:700;letter-spacing:.18em;opacity:.72}.page-personnel .personnel-folder-name-stamp strong{display:block;font-size:clamp(16px,1.5vw,23px);line-height:1.12;letter-spacing:.07em;overflow-wrap:anywhere}.page-personnel .personnel-folder-name-stamp span{display:block;margin-top:7px;font-size:7px;font-weight:700;letter-spacing:.12em;opacity:.78}
/* PVT dog tag is a wide photographic insignia substitute. */
img[src$="/PVT.webp"]{object-fit:contain}
.personnel-card-rank img[src$="/PVT.webp"],.rank-insignia[src$="/PVT.webp"],.index-rank img[src$="/PVT.webp"]{max-width:70px;max-height:64px}

/* Staff contrast — readable controls everywhere */
.staff-ux-v2 button,.staff-utility-bar button,.staff-global-bar a,.staff-office-grid a,.staff-batch-desk button,.staff-201-actions button,.page-operations button,.paper-action,.field-action{color:#f4e8c7!important;background:#303a2a!important;border-color:#8f8159!important;text-shadow:0 1px rgba(0,0,0,.22)}
.staff-ux-v2 button:hover,.staff-utility-bar button:hover,.staff-global-bar a:hover,.staff-office-grid a:hover,.staff-201-actions button:hover,.page-operations button:hover,.paper-action:hover,.field-action:hover{background:#46513a!important;color:#fff4d4!important}
.staff-brief-strip article{color:#2a261b!important}.staff-brief-strip article small,.staff-brief-strip article span,.staff-brief-strip article strong{color:#2a261b!important;text-shadow:none!important}.staff-brief-strip article.status-attn{border-color:#8b5d32}.staff-brief-strip article.status-good{border-color:#4f6543}
button:disabled,.staff-nav-disabled{background:#8c8777!important;color:#ddd4bd!important;opacity:.7}

/* 201 staff action desk */
.staff-201-actions{margin:16px 0}.staff-201-action-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.staff-quick-form{display:grid;gap:9px;padding:14px;border:1px solid rgba(55,48,34,.32);background:rgba(227,213,172,.4)}.staff-quick-form h3{margin:0 0 4px;font-size:15px}.staff-quick-form label{display:grid;gap:4px;font-size:9px;font-weight:700;letter-spacing:.06em}.staff-quick-form input,.staff-quick-form select,.staff-quick-form textarea{width:100%;padding:8px;background:#f0e5c8;border:1px solid #8c7b54;color:#211d14}

/* Public awards — wider copy, less dead image space */
.public-awards-section{max-width:1500px}.public-awards-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.public-award-card{grid-template-columns:minmax(210px,32%) minmax(0,1fr);gap:26px;padding:18px;min-height:0;align-items:start}.public-award-card__image{padding:10px;align-self:start;min-height:auto}.public-award-card__image img{max-width:220px;max-height:82px;width:100%;object-fit:contain}.public-award-card__copy{min-width:0}.public-award-card p,.public-award-card li{font-size:13px;line-height:1.48}.public-award-card ul{margin:12px 0 0;padding-left:20px}.public-award-card h3{margin:7px 0 10px}

/* S-3 Operations Center */
.s3-command-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px auto;max-width:1500px;padding:0 18px}.s3-command-strip article{padding:13px;background:#ded2b0;border:1px solid #887a56;color:#282319}.s3-command-strip small,.s3-command-strip span{display:block}.s3-command-strip strong{display:block;font-size:21px;margin:4px 0}.status-good-text{color:#365332}.status-attn-text{color:#7a432e}
.s3-operations-layout{display:grid;grid-template-columns:minmax(0,2.35fr) minmax(260px,.75fr);gap:18px;max-width:1500px;margin:0 auto;padding:0 18px 30px}.s3-main-column,.s3-side-column{display:grid;gap:16px;align-content:start}.s3-current-board,.s3-create-wizard{padding:18px}.s3-op-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.s3-op-card{padding:14px;background:#d8c89d;border:1px solid #877751;box-shadow:0 5px 12px rgba(0,0,0,.15)}.s3-op-card-head{display:flex;justify-content:space-between;gap:10px}.s3-op-card h3{margin:8px 0 4px}.s3-op-card dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.s3-op-card dl div{padding:6px;border-top:1px dotted #887957}.s3-op-card dt{font-size:7px}.s3-op-card dd{margin:3px 0 0;font-weight:700}.s3-op-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.s3-op-actions a,.s3-op-actions button{display:inline-flex;padding:9px 11px;text-decoration:none;background:#303a2a;color:#f4e8c7;border:1px solid #8f8159;font-weight:700}
.s3-template-buttons,.s3-publish-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.s3-wizard-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.s3-wizard-form fieldset{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:13px;border:1px solid #9b8960}.s3-wizard-form legend{font-weight:700}.s3-wizard-form label{display:grid;gap:4px;font-size:9px;font-weight:700}.s3-wizard-form input,.s3-wizard-form select,.s3-wizard-form textarea{padding:8px;background:#f1e7cb;border:1px solid #8d7c55}.s3-wizard-form details,.s3-publish-actions{grid-column:1/-1}.s3-form-note{grid-column:1/-1;font-size:10px;margin:2px 0}.s3-attn-line{display:grid;gap:4px;padding:9px 0;border-bottom:1px dotted #8c7d59}.s3-lifecycle{padding-left:22px}.s3-lifecycle li{margin:8px 0}
.s3-live-control{max-width:1450px;margin:18px auto;padding:18px}.s3-live-attendance{margin-top:15px}.s3-attendance-table{display:grid}.s3-attendance-table>.head,.s3-attendance-table>.row{display:grid;grid-template-columns:1.25fr .65fr .75fr 1.4fr;gap:8px;padding:9px;border-bottom:1px solid #a3926d;align-items:center}.s3-attendance-table>.head{font-weight:700;background:#303a2a;color:#f4e8c7}.s3-attendance-table .row span{display:grid;gap:2px}.s3-attendance-table form{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.s3-attendance-table input{width:68px;padding:6px}.credit-ok{background:rgba(94,124,75,.15)}.credit-earning{background:rgba(184,147,64,.12)}.s3-detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}.s3-detail-actions form{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:14px;border:1px solid #8d7b55}.s3-detail-actions h3,.s3-detail-actions p,.s3-detail-actions button{grid-column:1/-1}.s3-detail-actions label{display:grid;gap:4px}.s3-detail-actions input,.s3-detail-actions select,.s3-detail-actions textarea{padding:7px;background:#f0e5c8;border:1px solid #8c7b54}

/* Homepage side-fill features */
.home-orders-pouch article,.newest-arrivals-list article{display:grid;gap:3px;padding:9px 11px;border-bottom:1px solid rgba(255,255,255,.08)}.home-orders-pouch article small,.newest-arrivals-list small{color:#c8b875}.home-orders-pouch article b,.newest-arrivals-list b{color:#f1e5c9}.home-orders-pouch article span,.newest-arrivals-list span{font-size:10px;color:#cfc6ad}.home-orders-pouch{transform:rotate(-.15deg)}.newest-arrivals-panel{transform:rotate(.12deg)}

/* Mobile visual overhaul */
@media(max-width:900px){
  body{overflow-x:hidden}.public-site-shell{width:min(100%,760px);padding:14px 12px 30px}.public-home-grid{grid-template-columns:1fr!important;gap:12px}.public-side-left,.public-side-right{grid-template-columns:1fr!important;grid-column:auto!important;order:initial}.public-main-column{order:-1}.welcome-paper{padding:20px}.welcome-paper h1{font-size:clamp(32px,10vw,52px)}.public-feature-photo{min-height:300px}.field-panel,.field-photo-card,.dispatch-board{border-radius:2px}.public-side-left .field-panel:first-child{grid-column:auto}.public-hq-masthead__inner{padding:12px}.public-hq-masthead__message{display:none}.public-hq-identity strong{font-size:17px}.record-index{max-height:72vh;overflow:auto}.record-index a{min-height:44px;display:flex;align-items:center}.staff-global-bar-inner{overflow-x:auto;scroll-snap-type:x proximity}.staff-global-bar a{min-width:145px;scroll-snap-align:start}.staff-utility-bar{grid-template-columns:1fr;gap:7px}.staff-global-search{width:100%}.staff-global-search input{min-width:0;width:100%}.staff-center-shell{padding:12px}.staff-brief-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.staff-center-grid,.staff-office-grid{grid-template-columns:1fr}.staff-201-action-grid{grid-template-columns:1fr}.s3-command-strip{grid-template-columns:repeat(2,minmax(0,1fr));padding:0 10px}.s3-operations-layout{grid-template-columns:1fr;padding:0 10px}.s3-op-card-grid{grid-template-columns:1fr}.s3-wizard-form{grid-template-columns:1fr}.s3-wizard-form fieldset{grid-template-columns:1fr}.s3-detail-actions{grid-template-columns:1fr}.s3-attendance-table>.head{display:none}.s3-attendance-table>.row{grid-template-columns:1fr}.public-awards-grid{grid-template-columns:1fr}.public-award-card{grid-template-columns:1fr}.public-award-card__image{justify-content:flex-start}.public-award-card__image img{max-width:260px}.page-personnel .personnel-folder-name-stamp{width:92%;margin:36px auto 18px}
}
@media(max-width:520px){.staff-brief-strip,.s3-command-strip{grid-template-columns:1fr}.welcome-actions{display:grid}.welcome-actions a{width:100%;text-align:center}.field-photo-card{grid-template-columns:110px 1fr}.dispatch-board article{grid-template-columns:80px 1fr}.public-hq-footer__inner{grid-template-columns:1fr;text-align:center}.personnel-file-grid{grid-template-columns:1fr!important}.public-awards-section{padding-left:12px;padding-right:12px}.public-award-card{padding:14px}.public-award-card p,.public-award-card li{font-size:14px}}

.s3-operation-timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:16px 0}.s3-operation-timeline h2{grid-column:1/-1}.s3-operation-timeline div{padding:9px;background:rgba(218,204,163,.48);border:1px solid #95845c}.s3-operation-timeline span{display:block;font-size:8px}.s3-expected-roster{margin-top:16px}.s3-roster-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.s3-roster-grid form{display:grid;grid-template-columns:1fr 1fr auto;gap:7px;align-items:center;padding:9px;border:1px solid #9a895f}.s3-roster-grid form b,.s3-roster-grid form small{grid-column:1/-1}.s3-roster-grid input{padding:7px;background:#f0e5c8;border:1px solid #8c7b54}@media(max-width:900px){.s3-operation-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}.s3-roster-grid{grid-template-columns:1fr}.s3-roster-grid form{grid-template-columns:1fr}}

/* STRUCTURED PERSONNEL DROPDOWN CONTROL */
.system-readonly-field{min-height:42px;display:flex;align-items:center;padding:10px 12px;border:1px solid rgba(55,48,34,.32);background:rgba(226,214,177,.55);font-weight:800;letter-spacing:.04em;color:#30281b}
.staff-201-manage-banner{display:grid;grid-template-columns:minmax(260px,.9fr) 1.4fr;gap:14px;align-items:center;margin:0 0 16px;padding:12px;border:2px solid rgba(72,66,43,.58);background:rgba(225,210,161,.42)}
.staff-201-manage-banner a{display:flex;align-items:center;justify-content:center;min-height:46px;padding:10px 12px;background:#343d2d;color:#f4e9c8;text-decoration:none;font-weight:900;letter-spacing:.05em;text-align:center}.staff-201-manage-banner span{font-size:.78rem;line-height:1.5;color:#332b1d}
.structured-personnel-shell{max-width:1180px;margin:0 auto;padding:18px}.structured-personnel-hero{margin-bottom:16px}.structured-system-note,.structured-action-card{padding:18px;margin-bottom:16px}.structured-system-note span{display:block;margin-top:9px;font-size:.78rem}.structured-action-card>header{border-bottom:1px solid rgba(55,48,34,.35);margin-bottom:14px;padding-bottom:9px}.structured-action-card h2{margin:.2rem 0 0}.structured-return{margin:18px 0}.structured-return a{display:inline-flex;padding:10px 14px;background:#343d2d;color:#f4e9c8;text-decoration:none;font-weight:800}@media(max-width:760px){.staff-201-manage-banner{grid-template-columns:1fr}.structured-personnel-shell{padding:10px}}


/* DEEP BATTALION STATE / 201 EXPERIENCE */
.deep-shell{max-width:1220px;margin:0 auto;padding:18px}.deep-hero{padding:20px 22px;margin-bottom:16px;border-left:4px solid #b99335;background:#283126;color:#f4e9c8}.deep-hero h1{margin:.25rem 0}.deep-search,.compare-picker{display:grid;grid-template-columns:1fr auto;gap:8px;margin:14px 0}.compare-picker{grid-template-columns:1fr 1fr auto}.deep-search input,.compare-picker select{min-width:0;padding:12px}.deep-search button,.compare-picker button,.staff-hi-button,.journal-form button,.watch-card button{background:#343d2d;color:#f4e9c8;border:1px solid #1c2319;padding:11px 14px;font-weight:800;text-decoration:none}.deep-result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.deep-result-card{display:flex;flex-direction:column;gap:5px;background:#e5d8b8;border:1px solid #76694c;padding:13px;color:#2e281c;text-decoration:none}.deep-two,.compare-grid,.staff-deep-control,.member-deep-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.unit-stat-strip,.packet-grid,.situation-grid,.weapon-story-stats,.member-mini-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;margin:12px 0}.unit-stat-strip span,.packet-grid span,.situation-grid span,.weapon-story-stats span,.member-mini-grid span{padding:9px;border:1px solid rgba(50,43,30,.25);font-size:.72rem;overflow-wrap:anywhere}.unit-stat-strip b,.packet-grid b,.situation-grid b,.weapon-story-stats b{display:block;margin-top:4px;font-size:.95rem}.current-situation-sheet,.active-service-sheet,.promotion-board-sheet,.award-evidence-sheet,.served-with-sheet{margin-top:14px}.reputation-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.reputation-row span{padding:5px 8px;border:1px solid #665d42;background:rgba(83,94,58,.13);font-size:.7rem;font-weight:800;letter-spacing:.06em}.active-service-timeline{position:relative;margin:16px 0 0 90px;border-left:2px solid #726342;padding-left:20px}.service-event{position:relative;display:grid;grid-template-columns:105px 1fr;gap:12px;margin:0 0 18px}.service-event:before{content:"";position:absolute;left:-27px;top:5px;width:11px;height:11px;border-radius:50%;background:#4b5137;border:2px solid #d7c594}.service-event time{margin-left:-132px;text-align:right;font-weight:700;font-size:.72rem}.service-event small{display:block}.service-event p{margin:.35rem 0 0}.served-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.served-grid span{padding:10px;border:1px solid rgba(50,43,30,.25)}.served-grid small{display:block;margin-top:4px}.weapon-personality{margin-top:16px;padding:14px;border:1px solid rgba(50,43,30,.3);background:rgba(218,203,160,.28)}.weapon-personality h3,.weapon-personality h4{margin:.5rem 0}.evidence-citation,.journal-file-entry{padding:9px 0;border-top:1px dotted rgba(50,43,30,.35)}.command-watch-file{border:2px solid #744b35}.next-action-card{padding:18px;background:#e0d1aa;border:2px solid #5e633e}.next-action-card a,.deep-links a,.member-deep-links a{display:inline-flex;margin:6px 6px 0 0;padding:9px 12px;background:#343d2d;color:#f4e9c8;text-decoration:none;font-weight:800}.action-item-grid,.watch-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:14px 0}.action-item,.watch-card{padding:14px}.journal-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:16px}.journal-form label{display:flex;flex-direction:column;gap:5px}.journal-form .wide{grid-column:1/-1}.journal-list{display:grid;gap:10px;margin-top:12px}.duty-suggestion-board{padding:15px;margin:14px 0}.duty-suggestion-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.duty-suggestion-grid article{padding:12px;border:1px solid rgba(50,43,30,.28)}.duty-suggestion-grid form{display:grid;grid-template-columns:1fr auto;gap:4px;border-top:1px dotted #76694c;padding:8px 0}.duty-suggestion-grid form span{grid-column:1}.duty-suggestion-grid button{grid-column:2;grid-row:1/3;background:#343d2d;color:#f4e9c8;border:0}.suspense-board>div{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.suspense-board span{padding:9px;border:1px solid #8b7a52;text-align:center}.suspense-board b{display:block;font-size:1.2rem}.staff-hi-button{display:inline-flex;margin:4px}.staff-hi-button.secondary{background:#e0d1aa;color:#30281b}.strength-history{padding:16px;margin-bottom:14px}.history-bars{height:150px;display:flex;gap:2px;align-items:flex-end;border-bottom:1px solid #65583d;padding-top:10px;overflow:hidden}.history-day{height:100%;flex:1;min-width:3px;display:flex;align-items:flex-end;gap:1px}.history-day i,.history-day em,.history-day b,.history-day u{display:block;width:25%;min-height:1px;background:#756a43;text-decoration:none}.history-day em{background:#5d7246}.history-day b{background:#39483b}.history-day u{background:#9a7931}.history-legend{display:flex;gap:16px;font-size:.7rem;font-weight:800}.trend-current{font-size:.75rem}.staff-personnel-action-engine .action-preview-sheet{position:sticky;bottom:8px;z-index:5}.action-preview-effects li{margin-bottom:4px}
@media(max-width:900px){.deep-result-grid,.action-item-grid,.watch-grid,.duty-suggestion-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.unit-stat-strip,.packet-grid,.situation-grid,.weapon-story-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.compare-picker{grid-template-columns:1fr}.staff-deep-control{grid-template-columns:1fr}.journal-form{grid-template-columns:1fr}.journal-form .wide{grid-column:auto}}
@media(max-width:620px){.deep-shell{padding:8px}.deep-result-grid,.action-item-grid,.watch-grid,.duty-suggestion-grid,.deep-two,.compare-grid,.member-deep-summary,.served-grid{grid-template-columns:1fr}.deep-search{grid-template-columns:1fr}.situation-grid,.packet-grid,.weapon-story-stats,.member-mini-grid{grid-template-columns:1fr 1fr}.active-service-timeline{margin-left:0;padding-left:18px}.service-event{grid-template-columns:1fr}.service-event time{margin-left:0;text-align:left}.service-event:before{left:-25px}.duty-suggestion-grid form{grid-template-columns:1fr}.duty-suggestion-grid button{grid-column:1;grid-row:auto}}

.formation-links{display:flex;gap:7px;flex-wrap:wrap}.formation-links a,.squad-card-redesign>header>a{font-size:.68rem;padding:5px 7px;border:1px solid currentColor;text-decoration:none}.lineage-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.lineage-card,.command-history-sheet{padding:14px;margin-bottom:14px}@media(max-width:760px){.lineage-list{grid-template-columns:1fr}}

.tour-phase-strip{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:3px;margin-top:12px}.tour-phase-strip span{padding:6px 4px;border:1px solid rgba(55,48,34,.28);font-size:.58rem;text-align:center;opacity:.55}.tour-phase-strip span.current{background:#3b4634;color:#f4e9c8;opacity:1;font-weight:900}@media(max-width:700px){.tour-phase-strip{grid-template-columns:repeat(2,minmax(0,1fr))}}


/* S-3 OPERATIONS CENTER — CONTAINMENT / BALANCE PASS */
.page-operations *, .page-operation-detail *, .page-operation-duty *{box-sizing:border-box;min-width:0}
.page-operations input,.page-operations select,.page-operations textarea,.page-operations button,
.page-operation-detail input,.page-operation-detail select,.page-operation-detail textarea,.page-operation-detail button,
.page-operation-duty input,.page-operation-duty select,.page-operation-duty textarea,.page-operation-duty button{max-width:100%;width:100%;overflow-wrap:anywhere}
.page-operations h1,.page-operations h2,.page-operations h3,.page-operations p,.page-operations b,.page-operations span,
.page-operation-detail h1,.page-operation-detail h2,.page-operation-detail h3,.page-operation-detail p,.page-operation-detail b,.page-operation-detail span,
.page-operation-duty h1,.page-operation-duty h2,.page-operation-duty h3,.page-operation-duty p,.page-operation-duty b,.page-operation-duty span{overflow-wrap:anywhere;word-break:normal}

.s3-current-board{overflow:hidden}
.s3-op-card-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));align-items:stretch}
.s3-op-card{height:100%;display:flex;flex-direction:column}
.s3-op-card .s3-op-actions{margin-top:auto;padding-top:12px}
.s3-op-card dl{grid-template-columns:repeat(3,minmax(90px,1fr))}

.s3-live-control{width:min(1450px,calc(100% - 28px));overflow:hidden}
.s3-live-control>.s3-command-strip{max-width:none;padding:0;margin:14px 0}
.s3-operation-timeline{grid-template-columns:repeat(4,minmax(150px,1fr))}
.s3-operation-timeline div{overflow:hidden}
.s3-operation-timeline b{display:block;margin-top:4px;font-size:clamp(10px,.9vw,13px);line-height:1.35;white-space:normal}
.s3-roster-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,430px),1fr))}
.s3-roster-grid form{grid-template-columns:minmax(0,1fr) minmax(130px,.42fr);gap:8px}
.s3-roster-grid form b,.s3-roster-grid form small{grid-column:1/-1}
.s3-roster-grid form input{grid-column:1}
.s3-roster-grid form button{grid-column:2}

.s3-detail-actions{grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}
.s3-detail-actions form{grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;height:100%;overflow:hidden}
.s3-detail-actions form h3,.s3-detail-actions form p,.s3-detail-actions form button{grid-column:1/-1}
.s3-detail-actions label{min-width:0}
.s3-detail-actions textarea{min-height:92px;resize:vertical}
.s3-detail-actions button{margin-top:auto}

.page-operation-duty .staff-workspace{width:min(1380px,calc(100% - 28px));overflow:hidden}
.page-operation-duty .staff-workspace>.staff-grid,
.page-operation-duty .staff-workspace>.battalion-control-grid{grid-template-columns:minmax(0,1.65fr) minmax(320px,.9fr);align-items:start}
.page-operation-duty .army-form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.page-operation-duty .army-form-grid .wide,.page-operation-duty .army-form-grid button{grid-column:1/-1}
.page-operation-duty .army-form-grid label{min-width:0}

.operation-file-room{grid-template-columns:minmax(0,2fr) minmax(300px,.8fr);gap:18px}
.operation-file-room>*{min-width:0}
.op-meta{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}

@media(max-width:980px){
  .s3-operation-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}
  .s3-detail-actions{grid-template-columns:1fr}
  .page-operation-duty .staff-workspace>.staff-grid,.page-operation-duty .staff-workspace>.battalion-control-grid{grid-template-columns:1fr}
  .operation-file-room{grid-template-columns:1fr}
}
@media(max-width:640px){
  .s3-operation-timeline{grid-template-columns:1fr}
  .s3-op-card dl{grid-template-columns:1fr 1fr}
  .s3-roster-grid form{grid-template-columns:1fr}
  .s3-roster-grid form input,.s3-roster-grid form button{grid-column:1}
  .s3-detail-actions form{grid-template-columns:1fr}
  .s3-detail-actions form>*{grid-column:1!important}
  .page-operation-duty .army-form-grid{grid-template-columns:1fr}
  .page-operation-duty .army-form-grid>*{grid-column:1!important}
}


/* S-3 DUTY BOARD — FINAL PANEL FILL / OVERFLOW PASS */
.page-operation-duty .staff-workspace{display:grid!important;grid-template-columns:minmax(0,1.65fr) minmax(340px,.9fr)!important;gap:18px!important;align-items:start!important;padding-top:55px!important}
.page-operation-duty .staff-workspace>article{width:100%;max-width:100%;overflow:hidden;margin:0}
.page-operation-duty .staff-workspace>article:nth-child(3){grid-column:1/-1}
.page-operation-duty .staff-workspace .brief-strength{grid-template-columns:repeat(4,minmax(0,1fr));width:100%}
.page-operation-duty .staff-workspace .brief-strength>div{min-width:0;overflow:hidden}
.page-operation-duty .staff-workspace form:not(.army-form-grid){display:flex;gap:0;align-items:stretch;max-width:100%}
.page-operation-duty .staff-workspace form:not(.army-form-grid) input{flex:1 1 auto;min-width:0}
.page-operation-duty .staff-workspace form:not(.army-form-grid) button{flex:0 0 auto;width:auto;min-width:180px}
.page-operation-duty .entry-row{display:grid;grid-template-columns:minmax(160px,1.2fr) minmax(130px,.8fr) minmax(220px,1.4fr);gap:10px;align-items:center;padding:10px 0;border-bottom:1px dotted rgba(60,50,30,.35)}
.page-operation-duty .entry-row>*{min-width:0;overflow-wrap:anywhere}
@media(max-width:980px){
 .page-operation-duty .staff-workspace{grid-template-columns:1fr!important}
 .page-operation-duty .staff-workspace>article:nth-child(3){grid-column:1}
 .page-operation-duty .entry-row{grid-template-columns:1fr}
}
@media(max-width:640px){
 .page-operation-duty .staff-workspace form:not(.army-form-grid){display:grid;grid-template-columns:1fr}
 .page-operation-duty .staff-workspace form:not(.army-form-grid) button{width:100%;min-width:0}
 .page-operation-duty .brief-strength{grid-template-columns:1fr 1fr!important}
}

.website-authoritative-op-note{max-width:1180px;margin:12px auto;padding:11px 14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;border:2px solid rgba(58,65,44,.55);background:rgba(224,211,165,.72)}
.website-authoritative-op-note strong{color:#2f3829;letter-spacing:.05em}.website-authoritative-op-note span{flex:1;min-width:260px;color:#332c20;line-height:1.45}

/* ========================================================================== 
   REPLACEMENT DETACHMENT / UNIVERSAL SOLDIER ACTION DRAWER — 2026-08-19
   ========================================================================== */
.personnel-fast-control{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 18px}.personnel-fast-control a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;background:#303222;color:#f0e6c9;border:1px solid #17190f;text-decoration:none;box-shadow:0 3px 8px rgba(0,0,0,.2)}.personnel-fast-control a span{font-size:.72rem;opacity:.78}.personnel-fast-control a:hover{transform:translateY(-1px);filter:brightness(1.08)}

.replacement-hero{max-width:1500px;margin:22px auto 0;padding:24px 28px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;background:linear-gradient(135deg,#333524,#4a4731);color:#f0e7cf;border:1px solid #1b1c12;box-shadow:0 6px 18px rgba(0,0,0,.2)}.replacement-hero small{letter-spacing:.14em}.replacement-hero h1{margin:5px 0 6px;font-family:var(--font-stencil,inherit);font-size:clamp(1.7rem,3vw,3rem)}.replacement-hero p{max-width:850px;margin:0;line-height:1.45}.replacement-hero-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.replacement-hero-actions a{padding:11px 13px;background:#eee1bd;color:#252718;text-decoration:none;border:1px solid #17190f;font-weight:800;font-size:.76rem;letter-spacing:.05em}
.replacement-shell{max-width:1500px;margin:14px auto 48px;padding:0 18px}.replacement-stage-strip{display:grid;grid-template-columns:repeat(7,minmax(110px,1fr));gap:7px;margin:0 0 14px}.replacement-stage-strip button{min-width:0;padding:10px 8px;border:1px solid #605b45;background:#d9cba6;color:#2a2b1d;cursor:pointer;text-align:left}.replacement-stage-strip button small{display:block;white-space:normal;overflow-wrap:anywhere;font-size:.65rem;line-height:1.2}.replacement-stage-strip button b{display:block;font-size:1.35rem;margin-top:4px}.replacement-stage-strip button.active,.replacement-stage-strip button:hover{background:#383a29;color:#f0e6c8}
.replacement-priority-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:14px;margin-bottom:14px}.replacement-priority,.replacement-exceptions{min-width:0}.replacement-priority header,.replacement-exceptions header,.replacement-roster>header,.replacement-batch>header{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;border-bottom:2px solid #706a50;padding-bottom:9px;margin-bottom:10px}.replacement-priority header h2,.replacement-exceptions header h2,.replacement-roster header h2,.replacement-batch header h2{margin:2px 0 0}.replacement-priority header p,.replacement-exceptions header p,.replacement-batch header p{margin:0;max-width:500px;font-size:.78rem}
.priority-soldier-row,.replacement-exception{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;padding:10px 11px;margin:0 0 7px;border:1px solid #8f8567;background:#eee4c8;color:#2e2c20;cursor:pointer}.priority-soldier-row span>*{display:block}.priority-soldier-row small{font-size:.64rem;letter-spacing:.08em}.priority-soldier-row em{font-style:normal;font-size:.72rem;opacity:.75;margin-top:2px}.priority-soldier-row>strong{white-space:nowrap}.priority-soldier-row:hover,.replacement-exception:hover{background:#d9cda9}.replacement-exception{display:block}.replacement-exception b,.replacement-exception span{display:block}.replacement-exception span{font-size:.76rem;margin-top:3px;line-height:1.35}.replacement-exception.red{border-left:5px solid #71392d}.replacement-exception.amber{border-left:5px solid #99752d}
.replacement-roster{min-width:0;overflow:hidden}.replacement-roster>header label{min-width:260px;font-size:.68rem}.replacement-roster>header input{width:100%;margin-top:4px}.replacement-roster-head,.replacement-roster-row{display:grid;grid-template-columns:minmax(210px,1.35fr) minmax(130px,.7fr) minmax(140px,.7fr) minmax(190px,1fr) minmax(200px,.9fr);gap:10px;align-items:center}.replacement-roster-head{padding:8px 10px;background:#373829;color:#f2e7ca;font-size:.66rem;letter-spacing:.08em}.replacement-roster-row{padding:10px;border-bottom:1px solid #a79b79;background:rgba(243,233,205,.7)}.replacement-roster-row:nth-child(odd){background:rgba(231,219,185,.62)}.replacement-roster-row>span,.replacement-roster-row>button{min-width:0}.replacement-roster-row small{display:block;font-size:.67rem;opacity:.72;margin-top:2px;overflow-wrap:anywhere}.replacement-soldier-button{display:block;width:100%;padding:0;border:0;background:none;text-align:left;color:inherit;cursor:pointer}.replacement-soldier-button b{font-size:.9rem}.replacement-mini-progress{height:8px;background:#b8aa85;border:1px solid #83785e;overflow:hidden}.replacement-mini-progress i{display:block;height:100%;background:#4c5734}.replacement-row-actions{display:flex;gap:5px;flex-wrap:wrap}.replacement-row-actions button{padding:7px 8px;border:1px solid #3d3d2b;background:#454832;color:#f1e8cf;font-size:.66rem;font-weight:800;cursor:pointer}.replacement-row-actions form{margin:0}.replacement-row-actions button:hover{filter:brightness(1.1)}
.replacement-batch{margin-top:14px}.replacement-batch-fields{display:grid;grid-template-columns:minmax(160px,.65fr) minmax(260px,1.1fr) minmax(260px,1.1fr);gap:9px}.replacement-batch-fields label{font-size:.68rem}.replacement-batch-fields input,.replacement-batch-fields select{width:100%;margin-top:4px}.replacement-batch-people{display:grid;grid-template-columns:repeat(4,minmax(170px,1fr));gap:6px;margin:12px 0;max-height:300px;overflow:auto;padding:8px;border:1px solid #a89c78}.replacement-batch-people label{display:flex;gap:7px;align-items:flex-start;padding:7px;background:rgba(255,255,255,.25);font-size:.74rem}.replacement-batch-people small{display:block;opacity:.65}.replacement-batch>form>button{padding:10px 16px;background:#3d422d;color:#f2e8ca;border:1px solid #1b1d13;font-weight:900}

.staff-quick-drawer-live{position:fixed;top:0;right:0;width:min(620px,94vw);height:100vh;max-height:100vh;z-index:1202;overflow-y:auto;overflow-x:hidden;transform:translateX(105%);transition:transform .22s ease;background:#d8ca9f;border-left:2px solid #27291c;box-shadow:-16px 0 36px rgba(0,0,0,.35);padding:54px 16px 28px}.staff-quick-drawer-live.open{transform:translateX(0)}.staff-quick-drawer-live .staff-drawer-close{position:fixed;right:12px;top:10px;z-index:4;width:36px;height:36px;border:1px solid #292b1d;background:#3a3d2a;color:#f1e8cf;font-size:1.4rem;cursor:pointer}.staff-drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1201;opacity:0;pointer-events:none;transition:opacity .2s}.staff-drawer-backdrop.open{opacity:1;pointer-events:auto}.staff-drawer-open{overflow:hidden}.drawer-loading,.drawer-load-error{padding:30px 18px;border:1px dashed #756d53;background:#eee3c4}.drawer-loading b,.drawer-loading span,.drawer-load-error b,.drawer-load-error span{display:block}.drawer-loading span,.drawer-load-error span{margin-top:7px;font-size:.76rem}
.soldier-drawer-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:start;padding:15px;background:#343627;color:#f1e7ca;border:1px solid #1c1e14}.soldier-drawer-head h2{margin:3px 0 4px;font-size:1.35rem;overflow-wrap:anywhere}.soldier-drawer-head p{margin:0;font-size:.75rem;opacity:.82;overflow-wrap:anywhere}.soldier-drawer-readiness{text-align:center;min-width:74px}.soldier-drawer-readiness b{display:block;font-size:1.45rem}.soldier-drawer-readiness small{display:block;font-size:.62rem}.soldier-drawer-situation{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:8px 0}.soldier-drawer-situation div{min-width:0;padding:9px;background:#eee3c4;border:1px solid #a99c77}.soldier-drawer-situation small,.soldier-drawer-situation b{display:block;overflow-wrap:anywhere}.soldier-drawer-situation small{font-size:.6rem;letter-spacing:.08em}.soldier-drawer-situation b{font-size:.78rem;margin-top:3px}
.soldier-drawer-replacement{padding:12px;background:#efe5c7;border:1px solid #9e9270;margin-bottom:8px}.soldier-drawer-replacement header{display:flex;justify-content:space-between;align-items:center}.soldier-drawer-replacement h3{margin:2px 0}.replacement-progress{height:9px;background:#c5b791;border:1px solid #8b8061;margin:8px 0;overflow:hidden}.replacement-progress span{display:block;height:100%;background:#4e5836}.soldier-drawer-replacement p{font-size:.78rem;margin:8px 0}.drawer-checklist{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.drawer-checklist span{display:flex;gap:5px;padding:5px 7px;font-size:.69rem;background:rgba(255,255,255,.28);overflow-wrap:anywhere}.drawer-checklist .done{opacity:.7}.drawer-checklist .done b{color:#40552e}.drawer-checklist .open b{color:#7a392c}
.drawer-quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:8px 0}.drawer-quick-grid form{margin:0}.drawer-quick-grid button{width:100%;height:100%;min-height:64px;padding:8px;border:1px solid #292b1d;background:#454832;color:#f2e7ca;font-weight:900;font-size:.69rem;cursor:pointer}.drawer-quick-grid button small{display:block;margin-top:4px;font-size:.55rem;font-weight:500;opacity:.72}.drawer-action-form{margin:7px 0;border:1px solid #82775c;background:#eadfbe}.drawer-action-form summary{padding:10px 12px;background:#4a4a33;color:#f1e7c9;font-weight:900;font-size:.74rem;cursor:pointer}.drawer-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:11px}.drawer-form-grid label{min-width:0;font-size:.65rem;font-weight:800}.drawer-form-grid label.wide,.drawer-form-grid button,.drawer-form-grid .drawer-claim{grid-column:1/-1}.drawer-form-grid input,.drawer-form-grid select{box-sizing:border-box;width:100%;min-width:0;margin-top:3px}.drawer-form-grid button{padding:10px;background:#3c412c;color:#f1e8cc;border:1px solid #202217;font-weight:900;cursor:pointer}.drawer-claim{display:flex!important;align-items:center;gap:8px}.drawer-claim input{width:auto!important;margin:0!important}
.drawer-open-actions{margin-top:9px;padding:10px;background:#eee3c4;border:1px solid #9d906d}.drawer-open-actions header{display:flex;justify-content:space-between;align-items:end}.drawer-open-actions h3{margin:0}.drawer-open-actions article{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;padding:8px 0;border-top:1px solid #c0b38e}.drawer-open-actions article:first-of-type{margin-top:6px}.drawer-open-actions article div>*{display:block}.drawer-open-actions article span,.drawer-open-actions article small{font-size:.64rem;opacity:.75}.drawer-open-actions form{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}.drawer-open-actions button{padding:6px 7px;border:1px solid #4d4b37;background:#d3c49d;color:#25271c;font-size:.62rem;font-weight:800;cursor:pointer}.drawer-open-actions button.complete{background:#3e4b2f;color:#f2e9cf}.drawer-footer-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:10px}.drawer-footer-actions a{padding:9px;text-align:center;text-decoration:none;background:#343728;color:#f2e9cf;border:1px solid #1e2016;font-size:.67rem;font-weight:800}
.staff-action-button{width:100%;border:0;cursor:pointer;text-align:left}.s1-command-work-grid{margin-bottom:14px}

.s3-delete-operation{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(180px,.65fr) auto;gap:12px;align-items:end;margin-top:12px;padding:12px;border:2px solid #713c31;background:#e6d4b4}.s3-delete-operation h3{margin:2px 0 4px;color:#632e25}.s3-delete-operation p{margin:0;font-size:.72rem}.s3-delete-operation label{font-size:.65rem}.s3-delete-operation input{width:100%;box-sizing:border-box;margin-top:4px}.s3-delete-operation button,.op-card-delete button{padding:10px 12px;background:#6a3028;color:#fff3dc;border:1px solid #3b1915;font-weight:900;cursor:pointer}.op-card-delete{display:inline-block;margin-left:6px}

@media (max-width:1100px){.replacement-stage-strip{grid-template-columns:repeat(4,minmax(0,1fr))}.replacement-priority-grid{grid-template-columns:1fr}.replacement-roster-head{display:none}.replacement-roster-row{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.replacement-roster-row .replacement-soldier-button,.replacement-row-actions{grid-column:1/-1}.replacement-batch-people{grid-template-columns:repeat(3,minmax(150px,1fr))}.s3-delete-operation{grid-template-columns:1fr 1fr}.s3-delete-operation>div{grid-column:1/-1}}
@media (max-width:760px){.personnel-fast-control,.replacement-batch-fields{grid-template-columns:1fr}.replacement-hero{align-items:stretch;flex-direction:column;padding:18px}.replacement-hero-actions{justify-content:flex-start}.replacement-stage-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.replacement-roster-row{grid-template-columns:1fr;padding:11px}.replacement-roster-row>*{grid-column:1!important}.replacement-roster>header{align-items:stretch;flex-direction:column}.replacement-roster>header label{min-width:0;width:100%}.replacement-batch-people{grid-template-columns:1fr 1fr}.soldier-drawer-situation{grid-template-columns:repeat(2,minmax(0,1fr))}.drawer-checklist,.drawer-quick-grid,.drawer-form-grid,.drawer-footer-actions{grid-template-columns:1fr}.drawer-form-grid label.wide,.drawer-form-grid button,.drawer-form-grid .drawer-claim{grid-column:1}.s3-delete-operation{grid-template-columns:1fr}.s3-delete-operation>*{grid-column:1!important}}
@media (max-width:480px){.replacement-batch-people{grid-template-columns:1fr}.replacement-stage-strip{grid-template-columns:1fr 1fr}.staff-quick-drawer-live{width:100vw;padding-left:10px;padding-right:10px}.soldier-drawer-situation{grid-template-columns:1fr 1fr}}
.s1-roster-soldier-button{width:100%;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.s1-roster-soldier-button b,.s1-roster-soldier-button small{display:block}.s1-roster-soldier-button:hover b{text-decoration:underline}
.action-row-buttons{display:flex;gap:5px;flex-wrap:wrap}.action-row-buttons button{min-width:72px}.action-claim-button{background:#d7c79f;color:#292b1f;border:1px solid #5b5744;font-weight:800}.action-complete-button{background:#40502f;color:#f3ead0;border:1px solid #202718;font-weight:900}.action-assigned{display:block;margin-top:3px;color:#4b4d34;font-weight:800}

/* 2026-08-19: Personnel Quick File readability + compact drawer */
.staff-quick-drawer-live{width:min(700px,96vw);height:auto;max-height:94vh;top:3vh;padding:54px 18px 20px;background:#d8ca9f;color:#25261b;border:2px solid #27291c;border-right:0}
.staff-quick-drawer-live .staff-drawer-close{position:absolute}
.soldier-drawer-situation div{background:#eadfbd;color:#25261b;border:1px solid #8f8260;min-height:58px;display:flex;flex-direction:column;justify-content:center}
.soldier-drawer-situation small{color:#6b5d3c!important;opacity:1!important;font-weight:900}
.soldier-drawer-situation b{color:#24251a!important;opacity:1!important;font-weight:900}
.soldier-drawer-replacement,.drawer-open-actions{color:#25261b}
.drawer-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.drawer-footer-actions{grid-template-columns:repeat(3,minmax(0,1fr));position:sticky;bottom:-20px;background:#d8ca9f;padding:8px 0 2px;z-index:2}
@media (max-width:760px){.staff-quick-drawer-live{top:0;height:100vh;max-height:100vh;width:100vw;border-right:0;border-top:0;border-bottom:0}.drawer-quick-grid,.drawer-footer-actions{grid-template-columns:1fr}}


/* ======================================================================
   PUBLIC FRONT EXPERIENCE — AUG 2026
   Recruiting-first public presentation. Staff/member workspaces untouched.
   ====================================================================== */
body.public-front-v2{background:#171d17;color:#eee3c6}
.public-front-v2 #main-content{overflow:hidden}
.public-hq-header{position:relative;z-index:30;background:#161b16;border-bottom:1px solid rgba(199,166,84,.45)}
.public-hq-masthead{min-height:112px;background:linear-gradient(90deg,rgba(16,20,16,.98),rgba(27,33,25,.92)),url('/static/art/hq-canvas.webp') center/cover}
.public-hq-masthead__inner{max-width:1440px;margin:auto;padding:17px 30px}
.public-hq-identity img{width:76px;height:76px;object-fit:contain}.public-hq-identity strong{font-size:25px;letter-spacing:.055em}.public-hq-identity span{font-size:10px;letter-spacing:.13em}.public-hq-identity small{opacity:.62}
.public-hq-masthead__message b{font-size:14px;letter-spacing:.1em}.public-field-nav{max-width:1440px;margin:auto;padding:0 26px;background:#171c16}.public-field-nav a{padding:15px 14px;font-size:11px;letter-spacing:.08em}.public-field-nav .public-nav-enlist{background:#b79645;color:#17170f}.public-field-nav .public-nav-login{border-left:1px solid rgba(213,188,116,.25);margin-left:auto}

.front-hero{height:min(760px,72vh);min-height:590px;position:relative;display:flex;align-items:center;overflow:hidden;border-bottom:1px solid rgba(202,173,91,.38)}
.front-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.75) contrast(1.05)}
.front-hero__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,11,.94) 0%,rgba(12,16,13,.79) 40%,rgba(13,17,14,.35) 70%,rgba(11,15,12,.60) 100%),linear-gradient(0deg,rgba(14,18,14,.84),transparent 45%)}
.front-hero__content{position:relative;z-index:2;width:min(760px,calc(100% - 60px));margin-left:max(6vw,60px);padding:40px 0}
.front-hero__eyebrow,.front-section-kicker{font:600 11px/1.3 'Oswald',sans-serif;letter-spacing:.2em;color:#d0ad52;text-transform:uppercase}
.front-hero__mark{width:88px;height:88px;object-fit:contain;margin:20px 0 8px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.45))}
.front-hero h1{font:700 clamp(52px,6.5vw,94px)/.9 'Stardos Stencil',serif;letter-spacing:.01em;margin:7px 0 24px;color:#f1e6c9;text-shadow:0 3px 12px rgba(0,0,0,.55)}.front-hero h1 span{color:#d2b45f}.front-hero p{max-width:700px;margin:0 0 28px;font:400 clamp(16px,1.35vw,20px)/1.55 Arial,sans-serif;color:#e0d6bd}.front-hero__actions{display:flex;gap:12px;flex-wrap:wrap}.front-cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;text-decoration:none;font:700 12px/1 'Oswald',sans-serif;letter-spacing:.11em;border:1px solid #bea056}.front-cta--primary{background:#c5a550;color:#16160f}.front-cta--secondary{background:rgba(22,27,21,.74);color:#efe4c6}.front-cta--dark{background:#303729;color:#f1e7ca}.front-cta:hover{transform:translateY(-1px);filter:brightness(1.08)}.front-hero__motto{margin-top:24px;font:700 12px/1 'Courier Prime',monospace;letter-spacing:.12em;color:#bbaa7d}
.front-status-strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1450px;margin:-1px auto 0;background:#d9cca6;color:#211d14;border-left:1px solid #776b4e;border-right:1px solid #776b4e}.front-status-strip>div{padding:20px 24px;border-right:1px solid #948663;min-width:0}.front-status-strip>div:last-child{border-right:0}.front-status-strip small,.front-status-strip b,.front-status-strip span{display:block}.front-status-strip small{font:700 9px/1 'Oswald';letter-spacing:.15em;color:#715c2c}.front-status-strip b{font:700 27px/1.1 'Stardos Stencil';margin:5px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.front-status-strip span{font:12px/1.3 Arial,sans-serif;color:#62583e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.public-content-band{max-width:1450px;margin:auto;padding:90px 60px}.front-intro h2,.front-live h2,.front-formation h2,.front-field-copy h2{font:700 clamp(34px,4.2vw,60px)/1 'Stardos Stencil';margin:10px 0 16px;color:#f0e4c8}.front-section-lead{max-width:880px;font:17px/1.65 Arial,sans-serif;color:#cfc6ae;margin:0 0 42px}.front-feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.front-feature-grid article{background:#d9cda9;color:#211d15;border:1px solid #776b4e;box-shadow:0 15px 36px rgba(0,0,0,.22);overflow:hidden}.front-feature-grid img{width:100%;height:205px;object-fit:cover;background:#aba082}.front-feature-grid article:nth-child(1) img{object-fit:contain;padding:18px;box-sizing:border-box}.front-feature-grid article:nth-child(2) img{object-fit:contain;padding:24px;box-sizing:border-box;background:#9c967e}.front-feature-grid article div{padding:21px}.front-feature-grid small{font:700 9px/1 'Oswald';letter-spacing:.16em;color:#80662b}.front-feature-grid h3{font:700 23px/1 'Stardos Stencil';margin:9px 0}.front-feature-grid p{font:13px/1.55 Arial,sans-serif;color:#504936;margin:0}
.front-field-band{background:linear-gradient(90deg,rgba(26,31,23,.94),rgba(36,42,31,.86)),url('/static/art/hq-field-desk.webp') center/cover fixed;border-block:1px solid rgba(194,161,76,.3)}.front-field-band__inner{max-width:1450px;margin:auto;padding:78px 60px}.front-field-copy{max-width:830px}.front-field-copy small{font:700 10px/1 'Oswald';letter-spacing:.18em;color:#d0ad52}.front-field-copy p{font:16px/1.65 Arial,sans-serif;color:#d5ccb3}.front-field-copy a{color:#e2c36e;font:700 11px 'Oswald';letter-spacing:.12em;text-decoration:none}.front-process-line{display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr auto 1fr auto;align-items:center;margin-top:46px}.front-process-line div{text-align:center}.front-process-line b{display:flex;margin:auto;width:46px;height:46px;border:1px solid #c6a74f;align-items:center;justify-content:center;font-family:'Stardos Stencil';font-size:19px}.front-process-line span{display:block;margin-top:9px;font:700 9px 'Oswald';letter-spacing:.12em}.front-process-line i{height:1px;background:rgba(203,174,93,.45)}
.front-live{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:30px}.front-orders-list{margin-top:28px;border-top:1px solid rgba(208,186,126,.25)}.front-orders-list article{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:17px 0;border-bottom:1px solid rgba(208,186,126,.18)}.front-orders-list article>span{font:700 10px 'Oswald';letter-spacing:.12em;color:#c4a65d}.front-orders-list b,.front-orders-list small{display:block}.front-orders-list b{font:700 17px 'Stardos Stencil'}.front-orders-list small{margin-top:5px;color:#968d75;font:11px Arial}.front-next-op{background:#d9cda9;color:#211d15;border:1px solid #776b4e;padding:30px;position:relative;box-shadow:0 18px 42px rgba(0,0,0,.25)}.front-next-op>small{font:700 9px 'Oswald';letter-spacing:.16em;color:#7d652f}.front-next-op h3{font:700 30px 'Stardos Stencil';margin:7px 0 25px}.front-op-date{font:700 68px/.8 'Stardos Stencil';color:#4b5238}.front-op-date span{display:inline-block;font-size:24px;margin-left:5px}.front-next-op>b{display:block;margin-top:24px;font:700 21px 'Stardos Stencil'}.front-next-op p{font:12px/1.5 Arial;color:#5f5742}.front-next-op a{display:inline-block;margin-top:15px;color:#514622;font:700 10px 'Oswald';letter-spacing:.12em}.front-op-standby{font:700 42px 'Stardos Stencil';color:#5b6244;margin:30px 0 8px}
.front-formation{display:flex;align-items:end;justify-content:space-between;gap:40px;padding-top:15px}.front-formation>div{max-width:800px}.front-formation p{font:16px/1.6 Arial;color:#c9bea2}.front-final-cta{background:#c7ad66;color:#191810;display:flex;align-items:center;justify-content:space-between;gap:40px;padding:54px max(6vw,60px);border-top:4px solid #80703f}.front-final-cta small{font:700 10px 'Oswald';letter-spacing:.16em}.front-final-cta h2{font:700 clamp(32px,4vw,56px)/1 'Stardos Stencil';margin:7px 0}.front-final-cta p{margin:0;font:16px Arial}.front-final-cta a{flex:0 0 auto;background:#23291f;color:#efe4c5;padding:18px 28px;text-decoration:none;font:700 11px 'Oswald';letter-spacing:.12em;border:1px solid #11150f}

/* Recruiting process confidence strip */
.recruiting-confidence-strip{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);background:#d7cba7;border-inline:1px solid #76694b;color:#211d14}.recruiting-confidence-strip div{display:flex;align-items:center;gap:10px;padding:14px 16px;border-right:1px solid #948663}.recruiting-confidence-strip div:last-child{border-right:0}.recruiting-confidence-strip b{font:700 22px 'Stardos Stencil';color:#6c5727}.recruiting-confidence-strip span{font:700 9px/1.25 'Oswald';letter-spacing:.1em}

/* Public pages: cleaner reading typography while preserving document faces */
.public-recruiting-redesign p,.public-recruiting-redesign li,.public-awards-page p,.public-awards-page li,.page-about p,.page-why-join p{font-family:Arial,sans-serif}
.public-award-card{transition:transform .15s ease,box-shadow .15s ease}.public-award-card:hover{transform:translateY(-2px);box-shadow:0 18px 34px rgba(0,0,0,.28)}

@media(max-width:1100px){.front-feature-grid{grid-template-columns:repeat(2,1fr)}.front-status-strip{grid-template-columns:repeat(2,1fr)}.front-status-strip>div:nth-child(2){border-right:0}.front-live{grid-template-columns:1fr}.front-formation{align-items:flex-start;flex-direction:column}.recruiting-confidence-strip{grid-template-columns:repeat(3,1fr)}.recruiting-confidence-strip div:nth-child(3){border-right:0}}
@media(max-width:760px){.public-hq-masthead__message{display:none}.public-hq-masthead__inner{padding:12px 16px}.public-hq-identity img{width:58px;height:58px}.public-hq-identity strong{font-size:17px}.front-hero{min-height:620px;height:78vh}.front-hero__content{width:calc(100% - 34px);margin-left:17px}.front-hero__mark{width:70px;height:70px}.front-hero h1{font-size:clamp(45px,14vw,67px)}.front-hero p{font-size:15px}.front-hero__actions{display:grid;grid-template-columns:1fr;width:100%}.front-status-strip{grid-template-columns:1fr 1fr;margin:0}.front-status-strip>div{padding:16px}.front-status-strip b{font-size:22px}.public-content-band,.front-field-band__inner{padding:62px 20px}.front-feature-grid{grid-template-columns:1fr}.front-feature-grid img{height:190px}.front-process-line{grid-template-columns:1fr;gap:8px}.front-process-line i{width:1px;height:20px;margin:auto}.front-orders-list article{grid-template-columns:1fr;gap:5px}.front-final-cta{padding:42px 20px;align-items:flex-start;flex-direction:column}.front-final-cta a{width:100%;box-sizing:border-box;text-align:center}.recruiting-confidence-strip{grid-template-columns:1fr 1fr}.recruiting-confidence-strip div:nth-child(3){border-right:1px solid #948663}.recruiting-confidence-strip div:nth-child(even){border-right:0}.public-field-nav .public-nav-login{margin-left:0}}
@media(max-width:460px){.front-status-strip{grid-template-columns:1fr}.front-status-strip>div{border-right:0;border-bottom:1px solid #948663}.front-status-strip>div:last-child{border-bottom:0}.recruiting-confidence-strip{grid-template-columns:1fr}.recruiting-confidence-strip div{border-right:0;border-bottom:1px solid #948663}}


/* ========================================================================
   PUBLIC FRONT 1965 — MASTER PUBLIC EXPERIENCE OVERHAUL (2026-08-20)
   Public-only visual layer. Staff/member workspaces deliberately unchanged.
   ======================================================================== */
:root{
  --pub-ink:#241f16;--pub-paper:#d9cda9;--pub-paper-2:#eadfc1;--pub-paper-dark:#b4a67f;
  --pub-olive:#303628;--pub-olive-2:#20261d;--pub-deep:#10140f;--pub-yellow:#d1ac45;
  --pub-red:#7f3228;--pub-line:#76694d;--pub-cream:#f0e4c5
}
body.public-front-1965,
body.public-section-page,
body.public-recruiting-1965,
body.public-awards-page,
body.battalion-redesign{background:#161b15;color:var(--pub-cream)}
.public-hq-header--1965{position:relative;z-index:60;background:linear-gradient(#11150f,#1c2119);border-bottom:1px solid #66552d;box-shadow:0 7px 25px rgba(0,0,0,.4)}
.public-hq-topline{width:min(1580px,96vw);min-height:94px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:26px;padding:8px 0}
.public-hq-plaque{display:flex;align-items:center;gap:16px;color:#eee2c3;text-decoration:none}.public-hq-plaque img{width:80px;height:80px;object-fit:contain;filter:drop-shadow(0 4px 7px rgba(0,0,0,.45))}.public-hq-plaque span{display:grid}.public-hq-plaque b{font:700 10px 'Oswald',sans-serif;letter-spacing:.16em;color:#d4af52}.public-hq-plaque strong{font:700 23px/1 'Stardos Stencil',serif;letter-spacing:.03em}.public-hq-plaque small{font:700 9px 'Courier Prime',monospace;color:#aaa084;margin-top:4px}
.public-sitrep{display:grid;grid-template-columns:10px auto;column-gap:8px;align-items:center;text-align:left;padding:10px 14px;border:1px solid #605638;background:#0d110d;color:#d7caac;box-shadow:inset 0 0 0 1px rgba(255,255,255,.03)}.public-sitrep i{width:7px;height:7px;border-radius:50%;background:#8d352c}.public-sitrep b{font:700 11px 'Stardos Stencil',serif}.public-sitrep span,.public-sitrep small{grid-column:1/-1;font:10px 'Courier Prime',monospace;color:#baa75f;margin-top:3px}
.public-field-nav{background:linear-gradient(180deg,#171c15,#0f130e)!important;border-top:1px solid #3c402f!important;border-bottom:1px solid #6b5729!important}
.public-field-nav a{font-family:'Courier Prime',monospace!important;font-weight:700!important;font-size:13px!important;padding:15px 22px!important;color:#d8cfb8!important}
.public-field-nav a[aria-current="page"]{color:#f0c451!important}.public-field-nav .public-nav-enlist{color:#f0c451!important}
.public-field-nav a+ a:before{content:"★";position:absolute;left:-3px;color:#806b30;font-size:7px}
.public-hq-footer--1965{background:#11150f;border-top:1px solid #6c592d}.public-hq-footer--1965 .public-hq-footer__inner{width:min(1580px,96vw);margin:auto;display:grid;grid-template-columns:1.15fr 1fr 1fr .9fr auto;gap:24px;align-items:center;padding:26px 0;color:#bdb28f}.public-hq-footer__brand{display:flex;align-items:center;gap:12px}.public-hq-footer__brand img{width:58px;height:58px;object-fit:contain}.public-hq-footer__brand strong,.public-hq-footer__section b,.public-hq-footer__quote b{display:block;color:#d2b257;font:700 11px/1.35 'Stardos Stencil',serif}.public-hq-footer__brand span,.public-hq-footer__section span,.public-hq-footer__section small,.public-hq-footer__quote span{display:block;font:9px/1.5 'Courier Prime',monospace}.public-hq-footer__system .status-live{color:#7f9a63}.public-hq-footer--1965 a{color:#e1bf5d;text-decoration:none;font:700 10px 'Courier Prime',monospace}

/* Homepage command tent */
.hq-arrival{position:relative;min-height:620px;overflow:hidden;display:flex;align-items:center;border-bottom:4px solid #776230;background:#171b14}.hq-arrival__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 48%;filter:saturate(.75) contrast(1.03) brightness(.8)}.hq-arrival__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,11,8,.9),rgba(11,14,10,.52) 52%,rgba(8,11,8,.72)),linear-gradient(0deg,rgba(11,14,10,.78),transparent 50%,rgba(6,8,6,.3))}.hq-arrival__canvas{position:absolute;inset:0;box-shadow:inset 0 50px 80px rgba(0,0,0,.3),inset 0 -90px 100px rgba(0,0,0,.4);pointer-events:none}
.hq-arrival__identity{position:relative;z-index:2;width:min(910px,58vw);margin-left:max(5vw,60px);padding:60px 0}.hq-arrival__identity>span{font:700 10px 'Courier Prime',monospace;letter-spacing:.11em;color:#d2b359}.hq-arrival h1{font:700 clamp(48px,5.7vw,92px)/.88 'Stardos Stencil',serif;letter-spacing:-.02em;margin:11px 0 7px;color:#f1e6c8;text-shadow:0 4px 15px #000}.hq-arrival h2{font:700 clamp(14px,1.4vw,23px)/1.2 'Courier Prime',monospace;letter-spacing:.07em;margin:0;color:#d8ceb3}.hq-arrival__motto{font:700 clamp(24px,2.6vw,42px)/1.05 'Courier Prime',monospace;color:#efe4c6;margin:36px 0 24px;text-shadow:0 3px 8px #000}.hq-arrival__actions{display:flex;gap:12px;flex-wrap:wrap}
.hq-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:0 20px;text-decoration:none;border:1px solid #7b6b45;font:700 11px 'Courier Prime',monospace;letter-spacing:.05em}.hq-button--yellow{background:#c5a342;color:#1b1a12;border-color:#e2c46b}.hq-button--paper{background:#ddd1ae;color:#261f13}
.member-access-clipboard{position:absolute;z-index:4;right:max(4vw,40px);top:55px;width:min(340px,31vw);box-sizing:border-box;padding:48px 26px 30px;background:linear-gradient(rgba(229,217,187,.97),rgba(208,194,155,.98));color:#2b2417;border:1px solid #74684c;box-shadow:0 18px 40px rgba(0,0,0,.48);transform:rotate(.4deg)}.clipboard-clip{position:absolute;top:-20px;left:50%;width:115px;height:44px;transform:translateX(-50%);background:#37382f;border:2px solid #111;border-radius:5px 5px 12px 12px;box-shadow:inset 0 0 0 5px #656050}.member-access-clipboard header{text-align:center;border-bottom:2px solid #5d5139;padding-bottom:10px;margin-bottom:14px}.member-access-clipboard header small{font:700 8px 'Courier Prime',monospace;color:#765d2e}.member-access-clipboard h2{font:700 20px 'Stardos Stencil',serif;margin:4px 0}.member-access-clipboard form{display:grid;gap:7px}.member-access-clipboard label{font:700 9px 'Courier Prime',monospace}.member-access-clipboard input{width:100%;box-sizing:border-box;background:#ede3c9;border:1px solid #8b7d5f;padding:10px 11px;font:13px 'Courier Prime',monospace;color:#231f17}.member-access-clipboard button{margin-top:8px;padding:12px;border:1px solid #111;background:#35402d;color:#f0e3c4;font:700 11px 'Courier Prime',monospace;cursor:pointer}.member-access-clipboard>a{display:block;margin-top:12px;color:#5b4825;font:700 8px 'Courier Prime',monospace;text-align:center}.clipboard-stamp{display:block;width:max-content;margin:18px 0 0 auto;padding:6px 8px;border:3px double rgba(118,47,36,.55);color:rgba(118,47,36,.75);font:700 10px 'Oswald';transform:rotate(-7deg)}
.hq-command-board{background:linear-gradient(rgba(42,47,35,.96),rgba(29,34,25,.98));padding:22px max(2vw,24px) 30px}.hq-board-grid{max-width:1600px;margin:auto;display:grid;grid-template-columns:1.05fr 1.05fr 1.12fr 1.12fr .9fr;gap:11px}.hq-paper{position:relative;background:linear-gradient(180deg,#ded2af,#cfc09a);color:#2b2417;border:1px solid #776c50;box-shadow:0 6px 14px rgba(0,0,0,.25),inset 0 0 0 5px rgba(255,255,255,.09);padding:15px;min-width:0}.hq-paper:before{content:"";position:absolute;inset:6px;border:1px solid rgba(99,82,48,.18);pointer-events:none}.hq-paper>header{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding-bottom:9px;border-bottom:1px solid #8a7b59;position:relative;z-index:1}.hq-paper>header span{font:700 16px 'Stardos Stencil',serif}.hq-paper>header small{font:700 7px 'Courier Prime',monospace;color:#756438}.hq-paper>a{display:block;margin-top:12px;color:#70432d;text-decoration:none;font:700 9px 'Courier Prime',monospace;position:relative;z-index:1}
.hq-stat-list{margin:8px 0 0}.hq-stat-list div{display:flex;justify-content:space-between;gap:10px;padding:7px 1px;border-bottom:1px dotted #8b7e60}.hq-stat-list dt{font:700 9px 'Courier Prime',monospace}.hq-stat-list dd{margin:0;font:700 17px 'Stardos Stencil',serif}.compact-list div{padding:5px 1px}.compact-list dd{font-size:14px}
.hq-big-stat{display:flex;align-items:end;gap:10px;padding:10px 0;border-bottom:1px dotted #918262}.hq-big-stat b{font:700 35px 'Stardos Stencil',serif}.hq-big-stat span{font:700 8px 'Courier Prime',monospace;padding-bottom:5px}.hq-big-stat.compact b{font-size:26px}.company-strength-list div{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dotted #9c8e6e;font:700 9px 'Courier Prime',monospace}
.hq-operation-list{display:grid}.hq-op-row{display:grid;grid-template-columns:47px 1fr;gap:8px;padding:7px 0;border-bottom:1px dotted #897b5d}.hq-op-row time{text-align:center;border-right:1px solid #998b6b}.hq-op-row time b,.hq-op-row time span{display:block}.hq-op-row time b{font:700 22px/.9 'Stardos Stencil'}.hq-op-row time span{font:700 8px 'Courier Prime'}.hq-op-row strong,.hq-op-row small{display:block}.hq-op-row strong{font:700 10px 'Courier Prime';white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hq-op-row small{font:8px/1.4 'Courier Prime';color:#655d49;margin-top:3px}.hq-empty{font:10px/1.5 'Courier Prime',monospace;color:#615846}
.readiness-line{display:grid;grid-template-columns:minmax(100px,1fr) 1.15fr 34px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px dotted #918465}.readiness-line>span{font:700 8px 'Courier Prime'}.readiness-line>div{height:7px;background:#b6aa8a;border:1px solid #827659}.readiness-line i{display:block;height:100%;background:#526044}.readiness-line>b{font:700 9px 'Courier Prime'}
.personnel-record-links{display:grid;margin-top:6px}.personnel-record-links a{padding:5px 0 5px 18px;border-bottom:1px dotted #968967;color:#292419;text-decoration:none;font:700 8px 'Courier Prime';position:relative}.personnel-record-links a:before{content:"◉";position:absolute;left:2px;color:#4c573f}
.tour-dogtags{float:left;margin:13px 12px 8px 0;padding:13px 9px;border-radius:40% 40% 45% 45%;background:#837b63;color:#26231c;border:2px solid #4f4b3d;box-shadow:inset 0 0 0 2px #a59a7a;font:700 8px/1.25 'Courier Prime';text-align:center}.hq-paper--tour p,.hq-paper--awards p{font:10px/1.45 'Courier Prime',monospace}.tour-public-lines{clear:both}.tour-public-lines div{display:flex;justify-content:space-between;gap:7px;border-bottom:1px dotted #968967;padding:5px 0;font:8px 'Courier Prime'}.tour-public-lines dd{margin:0;font-weight:700}
.home-ribbon-rack{display:flex;flex-wrap:wrap;gap:5px;padding:13px 0}.home-ribbon-rack img{width:67px;height:20px;object-fit:cover;border:1px solid #3e382a}.home-ribbon-rack span{font:9px 'Courier Prime'}
.why-join-brief{margin:9px 0 6px;padding:0;list-style:none}.why-join-brief li{padding:5px 0 5px 14px;border-bottom:1px dotted #958766;font:700 8px 'Courier Prime';position:relative}.why-join-brief li:before{content:"★";position:absolute;left:0;color:#66552d}.recorded-here{display:block;margin-top:10px;font:700 12px 'Stardos Stencil'}
.hq-photo-record{position:relative;min-height:250px;grid-column:5;grid-row:2 / span 2;overflow:hidden;border:6px solid #d9cda9;box-shadow:0 7px 16px rgba(0,0,0,.35)}.hq-photo-record img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(1.03)}.hq-photo-record:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,13,9,.92),transparent 65%)}.hq-photo-record>div{position:absolute;z-index:2;bottom:12px;left:14px;right:14px;color:#f0e5c7}.hq-photo-record small,.hq-photo-record strong,.hq-photo-record a{display:block}.hq-photo-record small{font:700 8px 'Courier Prime';color:#d7b554}.hq-photo-record strong{font:700 16px/1.05 'Stardos Stencil';margin:5px 0}.hq-photo-record a{color:#e7c45c;font:700 8px 'Courier Prime'}
.public-cinematic-band{position:relative;min-height:520px;overflow:hidden}.public-cinematic-band>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.public-cinematic-band__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,13,9,.93),rgba(12,15,10,.62) 53%,rgba(10,13,9,.18)),linear-gradient(0deg,rgba(10,13,9,.6),transparent)}.public-cinematic-band__copy{position:relative;z-index:2;max-width:720px;padding:100px max(6vw,60px);color:#f0e3c3}.public-cinematic-band__copy small{font:700 9px 'Courier Prime';color:#d6b24d}.public-cinematic-band__copy h2{font:700 clamp(40px,5vw,72px)/.9 'Stardos Stencil';margin:9px 0 18px}.public-cinematic-band__copy p{font:15px/1.65 Arial,sans-serif;max-width:620px}.public-cinematic-band__copy a{display:inline-block;color:#efc95e;font:700 10px 'Courier Prime';margin-top:12px}
.hq-recruiting-notice{display:grid;grid-template-columns:180px 1.4fr 1fr auto;gap:25px;align-items:center;padding:24px max(3vw,40px);background:#d6c8a1;color:#2a2318;border-block:3px solid #86754e}.recruiting-stamp{border:4px double #873c30;color:#873c30;padding:8px;text-align:center;font:700 22px/1 'Oswald';transform:rotate(-3deg)}.hq-recruiting-notice>div>b{font:700 12px 'Courier Prime'}.hq-recruiting-notice p{font:10px/1.45 'Courier Prime';margin:4px 0}.recruiting-motto span,.recruiting-motto b{display:block;font:700 15px 'Stardos Stencil'}.hq-recruiting-notice>a{padding:14px 16px;background:#2d3528;color:#f0e4c5;text-decoration:none;font:700 9px 'Courier Prime'}

/* Recruiting office */
.public-recruiting-1965{background:#171b15}.recruiting-office-intro{position:relative;min-height:310px;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center}.recruiting-office-intro__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.6) brightness(.65)}.recruiting-office-intro__shade{position:absolute;inset:0;background:linear-gradient(rgba(8,11,8,.6),rgba(8,11,8,.78))}.recruiting-office-intro>div{position:relative;z-index:2;color:#f0e3c3}.recruiting-office-intro small{font:700 9px 'Courier Prime';color:#d5b14e}.recruiting-office-intro h1{font:700 clamp(52px,6vw,84px)/.9 'Stardos Stencil';margin:8px 0}.recruiting-office-intro h2{font:700 16px 'Courier Prime';margin:0}.recruiting-office-intro p{font:700 11px 'Courier Prime';letter-spacing:.16em;color:#c8b66f}
.recruit-route-slip{position:relative;z-index:5;max-width:1320px;margin:-18px auto 0;display:grid;grid-template-columns:auto 30px auto 30px auto 30px auto 30px auto;background:#ddd0ac;color:#2a2317;border:1px solid #7c6e50;box-shadow:0 8px 18px rgba(0,0,0,.35)}.recruit-route-slip>div{position:relative;min-height:82px;padding:12px 15px;display:grid;grid-template-columns:32px 1fr;align-items:center;border-right:1px solid #a09370}.recruit-route-slip b{font:700 28px 'Stardos Stencil'}.recruit-route-slip span{font:700 9px 'Courier Prime'}.recruit-route-slip em{font:700 22px 'Courier Prime';align-self:center;text-align:center}.recruit-route-slip i{position:absolute;right:8px;top:7px;color:#7f372d;border:2px solid #7f372d;padding:3px 5px;font:700 8px 'Oswald';transform:rotate(-8deg)}.recruit-route-slip .current{background:#c9c08f}.recruit-route-slip .complete{background:#c7c4a7}
.recruiting-room{position:relative;padding:36px max(2vw,20px) 58px;background:#24291f}.recruiting-room__background{position:absolute;inset:0;background:linear-gradient(rgba(18,22,16,.72),rgba(18,22,16,.9)),url('/static/art/public-overhaul/tour-in-country.webp') center/cover fixed;opacity:.5}.recruiting-room__grid{position:relative;z-index:2;max-width:1450px;margin:auto;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.48fr);gap:24px;align-items:start}
.enlistment-packet{position:relative;background:linear-gradient(180deg,#e0d3af,#d4c49c);color:#292217;border:1px solid #796b4e;padding:48px 42px 42px;box-shadow:0 18px 45px rgba(0,0,0,.42),inset 0 0 0 8px rgba(255,255,255,.08)}.packet-clip{position:absolute;top:-18px;left:50%;width:125px;height:40px;transform:translateX(-50%);background:#4a4b40;border:2px solid #1a1b17;border-radius:4px 4px 9px 9px}.enlistment-letterhead{text-align:center;border-bottom:2px solid #463e2c;padding-bottom:15px}.enlistment-letterhead small,.enlistment-letterhead b,.enlistment-letterhead span{display:block;font-family:'Courier Prime',monospace}.enlistment-letterhead small{font-size:8px}.enlistment-letterhead b{font-size:12px}.enlistment-letterhead span{font-size:10px}.enlistment-letterhead h2{font:700 33px 'Stardos Stencil';margin:12px 0 3px}.enlistment-letterhead i{font:700 9px 'Courier Prime';color:#7a3329}
.identity-routing-block{position:relative;margin:22px 0;border:1px solid #8a7b5a;padding:18px;background:rgba(255,255,255,.13)}.identity-routing-block h3{font:700 24px 'Stardos Stencil';margin:5px 0}.identity-routing-block p{font:12px/1.55 Arial,sans-serif}.discord-identity-button{display:inline-flex;padding:13px 16px;background:#3d4935;color:#f0e5c7;border:1px solid #172016;text-decoration:none;font:700 10px 'Courier Prime'}.discord-identity-button.disabled{opacity:.5;pointer-events:none}.verified-discord-card{display:grid;grid-template-columns:58px 1fr auto;gap:12px;align-items:center;padding:12px;background:#c5ba97;border:1px solid #897a59}.verified-discord-card img,.verified-discord-card>span{width:58px;height:58px;border-radius:50%;object-fit:cover;background:#4a513e;color:#fff;display:flex;align-items:center;justify-content:center}.verified-discord-card small,.verified-discord-card b,.verified-discord-card span{display:block}.verified-discord-card a{font:700 8px 'Courier Prime';color:#594421}.identity-approved-stamp{position:absolute;right:15px;top:13px;border:3px double #844137;color:#844137;padding:5px;font:700 9px 'Oswald';transform:rotate(-8deg)}.identity-scope-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:14px}.identity-scope-grid>div{padding:10px;border-top:1px solid #958768}.identity-scope-grid b,.identity-scope-grid span{display:block}.identity-scope-grid b{font:700 8px 'Courier Prime';margin-bottom:6px}.identity-scope-grid span{font:9px/1.45 'Courier Prime'}
.application-section-heading{margin:24px 0 5px}.application-section-heading small{font:700 8px 'Courier Prime';color:#7b342b}.application-section-heading h3{font:700 27px 'Stardos Stencil';margin:4px 0}.application-section-heading p{font:11px Arial}
.enlistment-form-1965{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;align-items:start}.enlistment-form-1965 fieldset{min-width:0;border:1px solid #8d7e5d;padding:17px 16px 16px;display:grid;gap:14px;align-content:start;align-self:start}.enlistment-form-1965 .wide-fieldset{grid-column:1/-1;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.enlistment-form-1965 legend{padding:0 8px;font:700 10px 'Courier Prime';color:#5e4a27}.enlistment-form-1965 label{min-width:0;display:grid;grid-template-columns:30px minmax(0,1fr);gap:4px 9px;align-items:center}.enlistment-form-1965 label>span{grid-column:1;grid-row:1/3;font:700 17px 'Stardos Stencil';color:#7c6740;align-self:center}.enlistment-form-1965 label>b{grid-column:2;font:700 8px 'Courier Prime';line-height:1.3}.enlistment-form-1965 input,.enlistment-form-1965 select,.enlistment-form-1965 textarea{grid-column:2;min-width:0;width:100%;box-sizing:border-box;background:#eee4c9;border:1px solid #8b7c5c;color:#251f16;padding:10px 11px;font:11px 'Courier Prime'}.enlistment-form-1965 textarea{resize:vertical;line-height:1.45}.enlistment-form-1965 label.full{grid-column:1/-1}.enlistment-form-1965 .field-help{grid-column:2;display:block;margin-top:2px;max-width:100%;font:10px/1.45 Arial,sans-serif;color:#5d5542;white-space:normal;overflow-wrap:normal;word-break:normal}.enlistment-form-1965 .steamid-field>span,.enlistment-form-1965 .game-identity-field>span{grid-row:1/4}.applicant-certification{grid-column:1/-1;padding:14px;border:1px solid #8c7d5d;background:#cfc29d}.applicant-certification h3{font:700 17px 'Stardos Stencil';margin:0 0 6px}.applicant-certification p{font:10px/1.5 Arial}.applicant-certification>div{display:grid;grid-template-columns:90px 1fr 60px 1fr;border-top:1px solid #90815f;padding-top:8px;gap:8px;font:9px 'Courier Prime'}.submit-headquarters{grid-column:1/-1;padding:14px;background:#35402d;color:#f2e6c8;border:1px solid #182016;font:700 12px 'Courier Prime';cursor:pointer}.submit-headquarters:disabled{opacity:.48;cursor:not-allowed}
.recruiting-admin-column{display:grid;gap:16px}.recruiting-side-paper{background:#ded1ad;color:#2a2317;border:1px solid #786b4e;padding:15px;box-shadow:0 8px 18px rgba(0,0,0,.3)}.recruiting-side-paper header{font:700 15px 'Stardos Stencil';padding-bottom:8px;border-bottom:1px solid #88795a}.recruiting-side-paper ol{padding-left:22px;font:10px/1.55 'Courier Prime'}.recruiting-taped-photo{margin:0;padding:8px;background:#d9cda9;border:1px solid #807151;transform:rotate(.4deg);box-shadow:0 8px 18px rgba(0,0,0,.3)}.recruiting-taped-photo img{display:block;width:100%;height:auto}.recruiting-desk-counts dl{margin:7px 0 0}.recruiting-desk-counts dl div{display:flex;justify-content:space-between;border-bottom:1px dotted #918365;padding:8px 0}.recruiting-desk-counts dt{font:700 8px 'Courier Prime'}.recruiting-desk-counts dd{font:700 18px 'Stardos Stencil';margin:0}.after-submission>div{text-align:center;font:700 9px 'Courier Prime';padding:6px}.after-submission i{display:block;text-align:center}.recruiting-bottom-notice{display:flex;justify-content:center;gap:15px;padding:23px;background:#b59851;color:#1e1b12;font:700 20px 'Stardos Stencil'}

/* Shared public offices */
.public-section-page{background:#171c16}.public-section-hero{position:relative;min-height:430px;display:flex;align-items:end;overflow:hidden}.public-section-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.72) contrast(1.03)}.public-section-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,11,8,.9),rgba(8,11,8,.42)),linear-gradient(0deg,rgba(10,13,9,.88),transparent 65%)}.public-section-hero>div:last-child{position:relative;z-index:2;padding:65px max(6vw,55px);max-width:900px;color:#f0e4c5}.public-section-hero small{font:700 9px 'Courier Prime';letter-spacing:.13em;color:#d8b453}.public-section-hero h1{font:700 clamp(55px,7vw,96px)/.88 'Stardos Stencil';margin:8px 0}.public-section-hero p{font:16px/1.6 Arial;max-width:720px}.public-office-board{max-width:1460px;margin:auto;padding:46px 40px 80px}.public-office-paper{background:#dccfab;color:#2a2317;border:1px solid #776a4d;padding:30px;box-shadow:0 9px 24px rgba(0,0,0,.25)}.public-office-paper small{font:700 8px 'Courier Prime';color:#765f2c}.public-office-paper h2{font:700 30px/1 'Stardos Stencil';margin:8px 0 12px}.public-office-paper p{font:13px/1.65 Arial}.public-office-paper>a{color:#694a28;font:700 9px 'Courier Prime'}
.public-personnel-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}.public-personnel-stats>div{padding:20px;background:#31382b;border:1px solid #5f624b;text-align:center}.public-personnel-stats b,.public-personnel-stats span{display:block}.public-personnel-stats b{font:700 40px 'Stardos Stencil';color:#e0c15e}.public-personnel-stats span{font:700 8px 'Courier Prime'}
.public-record-folder-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.public-record-folder-grid article{background:#d9cba6;color:#292217;border:1px solid #7e7051;padding:20px;min-height:170px}.public-record-folder-grid article>span{font:700 26px 'Stardos Stencil';color:#886c31}.public-record-folder-grid h3{font:700 19px 'Stardos Stencil';margin:7px 0}.public-record-folder-grid p{font:12px/1.55 Arial}.public-company-strength-paper,.public-completed-ops{margin-top:16px;background:#ded2b0;color:#2a2317;border:1px solid #796c4f;padding:20px}.public-company-strength-paper header,.public-completed-ops header{font:700 19px 'Stardos Stencil';border-bottom:1px solid #86785a;padding-bottom:10px}.public-company-strength-paper>div{display:flex;justify-content:space-between;padding:9px;border-bottom:1px dotted #918365;font:700 10px 'Courier Prime'}.public-company-strength-paper>a{display:block;margin-top:13px;color:#70472b;font:700 9px 'Courier Prime'}
.public-personnel-cta{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-top:18px;padding:32px;background:#2c3327;border:1px solid #545845}.public-personnel-cta small{font:700 8px 'Courier Prime';color:#d8b451}.public-personnel-cta h2{font:700 33px/1 'Stardos Stencil';margin:8px 0}.public-personnel-cta p{max-width:700px;font:13px/1.55 Arial}.public-personnel-cta>a{flex:0 0 auto;background:#c4a346;color:#1d1a11;text-decoration:none;padding:14px 18px;font:700 9px 'Courier Prime'}
.public-board-heading{margin-bottom:20px}.public-board-heading small{font:700 8px 'Courier Prime';color:#d7b252}.public-board-heading h2{font:700 36px 'Stardos Stencil';margin:5px 0}.public-board-heading p{font:13px Arial;color:#c7bca2}.public-ops-cards{display:grid;gap:10px}.public-ops-cards article{display:grid;grid-template-columns:75px 1fr auto;gap:16px;align-items:center;background:#d9cba7;color:#292217;border:1px solid #786b4d;padding:15px}.public-ops-cards time{text-align:center;border-right:1px solid #897b59}.public-ops-cards time b,.public-ops-cards time span{display:block}.public-ops-cards time b{font:700 34px 'Stardos Stencil'}.public-ops-cards time span{font:700 8px 'Courier Prime'}.public-ops-cards h3{font:700 20px 'Stardos Stencil';margin:4px 0}.public-ops-cards p,.public-ops-cards small{font:9px 'Courier Prime'}.public-op-status{font:700 8px 'Courier Prime';border:1px solid #5b653e;padding:7px;color:#485235}.public-empty-order{background:#d9cba7;color:#292217;border:1px solid #786b4d;padding:28px}.public-empty-order b,.public-empty-order span{display:block}.public-ops-visual,.public-readiness-explainer,.about-field-photo{position:relative;min-height:430px;margin-top:22px;overflow:hidden}.public-ops-visual>img,.public-readiness-explainer>img,.about-field-photo>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.public-ops-visual:after,.about-field-photo:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,11,8,.91),rgba(8,11,8,.24))}.public-ops-visual>div,.about-field-photo>div{position:relative;z-index:2;max-width:630px;padding:80px 50px}.public-ops-visual small,.about-field-photo small{font:700 8px 'Courier Prime';color:#d9b552}.public-ops-visual h2,.about-field-photo h2{font:700 42px/1 'Stardos Stencil';margin:8px 0}.public-ops-visual p,.about-field-photo p{font:14px/1.6 Arial}.public-completed-ops>div{display:grid;grid-template-columns:130px 1fr auto;gap:15px;padding:10px;border-bottom:1px dotted #918365;font:9px 'Courier Prime'}.public-completed-ops>div b{font-size:11px}
.readiness-report-paper{background:#ddd0ad;color:#2b2418;border:1px solid #776b4e;padding:28px}.readiness-report-paper header{border-bottom:2px solid #62563d;padding-bottom:12px}.readiness-report-paper h2{font:700 35px 'Stardos Stencil';margin:5px 0}.readiness-report-line{display:grid;grid-template-columns:minmax(220px,1fr) 2fr 55px;gap:16px;align-items:center;padding:15px 0;border-bottom:1px dotted #918465}.readiness-report-line b,.readiness-report-line small{display:block}.readiness-report-line b{font:700 10px 'Courier Prime'}.readiness-report-line small{font:9px Arial;color:#665e48}.readiness-report-bar{height:10px;background:#b0a583;border:1px solid #7b7055}.readiness-report-bar i{display:block;height:100%;background:#4e5d43}.readiness-report-line strong{font:700 15px 'Courier Prime'}.public-readiness-explainer{display:grid;grid-template-columns:1fr 1fr;background:#293025;min-height:350px}.public-readiness-explainer>div{padding:60px;z-index:2}.public-readiness-explainer>img{position:relative;grid-column:2;height:100%;filter:saturate(.72)}.public-readiness-explainer small{font:700 8px 'Courier Prime';color:#d8b451}.public-readiness-explainer h2{font:700 38px 'Stardos Stencil';margin:8px 0}.public-readiness-explainer p{font:14px/1.6 Arial}
.contact-desk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.contact-desk-grid .hq-button{margin-top:14px}
.about-ledger-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tour-process-board{margin-top:18px;display:grid;grid-template-columns:minmax(220px,1.4fr) auto 1fr auto 1fr auto 1fr auto 1fr;gap:10px;align-items:center;padding:25px;background:#d9cba7;color:#292217;border:1px solid #786b4e}.tour-process-board header{align-self:stretch}.tour-process-board header small{font:700 8px 'Courier Prime'}.tour-process-board h2{font:700 28px 'Stardos Stencil';margin:6px 0}.tour-process-board>div:not(header){text-align:center}.tour-process-board b{font:700 23px 'Stardos Stencil'}.tour-process-board span{display:block;font:700 7px 'Courier Prime'}.public-system-manifest,.why-manifest-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.public-system-manifest article,.why-manifest-grid article{background:#d8caa5;color:#292217;border:1px solid #786b4e;padding:20px}.public-system-manifest h3,.why-manifest-grid h2{font:700 22px 'Stardos Stencil';margin:5px 0}.public-system-manifest p,.why-manifest-grid p{font:12px/1.55 Arial}.why-manifest-grid article>span{font:700 28px 'Stardos Stencil';color:#886c31}.why-statement{margin:18px 0 0;padding:30px;background:#2b3327;border-left:5px solid #c6a245;font:700 34px 'Stardos Stencil';color:#eee2c4}

/* Existing public route integrations: remove superseded decorative photos. */
.battalion-redesign .battalion-photo{background-image:url('/static/art/public-overhaul/squad-field.webp')!important;background-position:center 45%!important}
.public-awards-hero{background:linear-gradient(110deg,rgba(23,28,21,.98),rgba(35,40,30,.94))!important}
.recruit-status-shell{background:linear-gradient(rgba(25,30,23,.94),rgba(25,30,23,.98)),url('/static/art/public-overhaul/tour-in-country.webp') center/cover fixed!important}
.public-recruiting-redesign main,.page-about main,.page-why-join main{background:#171c16!important}

/* Accessibility / focus */
.public-front-1965 a:focus-visible,.public-section-page a:focus-visible,.public-recruiting-1965 a:focus-visible,
.public-front-1965 button:focus-visible,.public-recruiting-1965 button:focus-visible,
.public-recruiting-1965 input:focus-visible,.public-recruiting-1965 select:focus-visible,.public-recruiting-1965 textarea:focus-visible{outline:3px solid #f2cb62;outline-offset:2px}

/* Public mobile/tablet */
@media(max-width:1280px){
  .hq-board-grid{grid-template-columns:repeat(3,1fr)}.hq-photo-record{grid-column:auto;grid-row:auto}.member-access-clipboard{width:330px;right:24px}.hq-arrival__identity{width:min(720px,58vw);margin-left:35px}.public-record-folder-grid{grid-template-columns:repeat(2,1fr)}.public-system-manifest,.why-manifest-grid{grid-template-columns:repeat(2,1fr)}
  .public-hq-footer--1965 .public-hq-footer__inner{grid-template-columns:1fr 1fr 1fr}.public-hq-footer--1965 a{grid-column:3}
}
@media(max-width:900px){
  .public-hq-topline{padding:9px 14px}.public-sitrep{display:none}.public-index-button{display:block!important;width:100%;background:#252b21;color:#e8dcbf;border:0;border-top:1px solid #5d553b;padding:13px;font:700 10px 'Courier Prime'}.public-field-nav{display:none!important;flex-direction:column!important}.public-field-nav.open{display:flex!important}.public-field-nav a+ a:before{display:none}.public-field-nav a{justify-content:flex-start!important;padding:14px 18px!important;min-height:46px!important}
  .hq-arrival{min-height:820px;align-items:flex-start}.hq-arrival__identity{width:calc(100% - 40px);margin:0;padding:70px 20px 0}.member-access-clipboard{position:absolute;left:20px;right:20px;top:auto;bottom:35px;width:auto;transform:none}.hq-arrival h1{font-size:clamp(45px,10vw,70px)}
  .hq-board-grid{grid-template-columns:1fr 1fr}.hq-recruiting-notice{grid-template-columns:150px 1fr}.recruiting-motto,.hq-recruiting-notice>a{grid-column:2}.public-hq-footer--1965 .public-hq-footer__inner{padding:24px 16px;grid-template-columns:1fr 1fr}
  .recruit-route-slip{margin:0;grid-template-columns:1fr 1fr}.recruit-route-slip em{display:none}.recruit-route-slip>div{border-bottom:1px solid #9c8e6d}.recruiting-room__grid{grid-template-columns:1fr}.recruiting-admin-column{grid-template-columns:1fr 1fr}.recruiting-taped-photo{grid-row:1 / span 2}
  .public-office-board{padding:35px 18px 60px}.public-section-hero>div:last-child{padding:50px 25px}.public-record-folder-grid{grid-template-columns:1fr 1fr}.contact-desk-grid{grid-template-columns:1fr}.about-ledger-grid{grid-template-columns:1fr}.tour-process-board{grid-template-columns:1fr 1fr}.tour-process-board header{grid-column:1/-1}.tour-process-board i{display:none}.public-personnel-cta{align-items:flex-start;flex-direction:column}.public-system-manifest,.why-manifest-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:620px){
  .public-hq-plaque img{width:58px;height:58px}.public-hq-plaque strong{font-size:17px}.public-hq-plaque b,.public-hq-plaque small{font-size:7px}
  .hq-arrival{min-height:840px}.hq-arrival__identity{padding-top:50px}.hq-arrival__motto{font-size:24px}.hq-arrival__actions{display:grid}.hq-button{width:100%;box-sizing:border-box}.member-access-clipboard{padding:44px 18px 22px}
  .hq-board-grid{grid-template-columns:1fr}.hq-command-board{padding:12px}.hq-paper{padding:15px}.hq-photo-record{min-height:340px}.public-cinematic-band{min-height:500px}.public-cinematic-band__copy{padding:75px 22px}.hq-recruiting-notice{grid-template-columns:1fr;padding:24px 18px}.recruiting-stamp{width:140px}.recruiting-motto,.hq-recruiting-notice>a{grid-column:auto}.public-hq-footer--1965 .public-hq-footer__inner{grid-template-columns:1fr;text-align:left}.public-hq-footer--1965 a{grid-column:auto}
  .recruit-route-slip{grid-template-columns:1fr}.recruiting-office-intro{min-height:260px}.recruiting-room{padding:28px 8px 45px}.enlistment-packet{padding:42px 16px 28px}.enlistment-form-1965{grid-template-columns:1fr}.enlistment-form-1965 .wide-fieldset{grid-column:auto;grid-template-columns:1fr}.identity-scope-grid{grid-template-columns:1fr}.verified-discord-card{grid-template-columns:50px 1fr}.verified-discord-card a{grid-column:1/-1}.applicant-certification>div{grid-template-columns:1fr}.recruiting-admin-column{grid-template-columns:1fr}.recruiting-taped-photo{grid-row:auto}.recruiting-bottom-notice{flex-direction:column;gap:3px;text-align:center}
  .public-record-folder-grid,.public-personnel-stats,.public-system-manifest,.why-manifest-grid{grid-template-columns:1fr}.public-ops-cards article{grid-template-columns:60px 1fr}.public-op-status{grid-column:2}.public-ops-visual>div,.about-field-photo>div{padding:60px 22px}.public-completed-ops>div{grid-template-columns:1fr}.readiness-report-line{grid-template-columns:1fr 50px}.readiness-report-bar{grid-column:1/-1;grid-row:2}.public-readiness-explainer{grid-template-columns:1fr}.public-readiness-explainer>div{padding:35px 22px}.public-readiness-explainer>img{grid-column:1;height:260px}.tour-process-board{grid-template-columns:1fr}.public-section-hero{min-height:370px}.public-section-hero h1{font-size:52px}
}

/* Public units board */
.battalion-public-board{padding-top:32px}.public-command-group{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}.public-command-group article{display:grid;grid-template-columns:64px 1fr;column-gap:12px;align-items:center;background:#d9cba7;color:#292217;border:1px solid #786b4e;padding:16px}.public-command-group img{grid-row:1/4;width:60px;height:60px;object-fit:contain}.public-command-group small{font:700 8px 'Courier Prime';color:#745d2a}.public-command-group h3{font:700 17px 'Stardos Stencil';margin:2px 0}.public-command-group span{font:8px 'Courier Prime'}
.public-company-board{display:grid;gap:15px}.public-company-file{background:#d9cba7;color:#292217;border:1px solid #786b4e;padding:18px}.public-company-file>header{display:flex;justify-content:space-between;gap:15px;align-items:center;border-bottom:2px solid #6d6045;padding-bottom:10px}.public-company-file h2{font:700 29px 'Stardos Stencil';margin:2px 0}.public-company-file header small,.public-company-file header span{font:8px 'Courier Prime'}.public-company-file>header nav{display:flex;gap:8px;flex-wrap:wrap}.public-company-file>header a{padding:8px 10px;background:#30382b;color:#efe4c5;text-decoration:none;font:700 8px 'Courier Prime'}.public-company-leadership{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.public-company-leadership>div{padding:10px;background:#cfc19d;border:1px solid #958665}.public-company-leadership small,.public-company-leadership b{display:block}.public-company-leadership small{font:7px 'Courier Prime';color:#69582f}.public-company-leadership b{font:700 10px 'Courier Prime';margin-top:3px}
.public-platoon-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.public-platoon-file{border:1px solid #8b7c5d;background:#e1d5b5;padding:12px}.public-platoon-file>header{display:flex;justify-content:space-between;align-items:center}.public-platoon-file h3{font:700 18px 'Stardos Stencil';margin:0}.public-platoon-file header span{font:7px 'Courier Prime'}.public-platoon-file header a{font:700 8px 'Courier Prime';color:#69462c}.public-platoon-leaders{display:flex;gap:14px;padding:8px 0;border-bottom:1px dotted #8d7f60;font:8px 'Courier Prime'}.public-squad-file{display:flex;justify-content:space-between;gap:10px;padding:8px 2px;border-bottom:1px dotted #998a68}.public-squad-file strong,.public-squad-file small{display:block}.public-squad-file strong{font:700 9px 'Courier Prime'}.public-squad-file small{font:7px 'Courier Prime';color:#665c47}.public-squad-file>b{font:700 8px 'Courier Prime';align-self:center}
.public-roster-paper{margin-top:16px;background:#ddd0ac;color:#292217;border:1px solid #786b4e;padding:20px}.public-roster-paper>header{border-bottom:2px solid #665a40;padding-bottom:10px}.public-roster-paper h2{font:700 28px 'Stardos Stencil';margin:4px 0}.public-roster-row{display:grid;grid-template-columns:70px 1.1fr 1.3fr 1.3fr .8fr;gap:10px;padding:9px 5px;border-bottom:1px dotted #948665;font:9px 'Courier Prime'}.public-roster-row small{display:block;font-size:7px}.public-roster-head{background:#353c2e;color:#efe5c8;font-weight:700;border:0}
.page-company .company-photo{background-image:url('/static/art/public-overhaul/squad-field.webp')!important;background-position:center 45%!important}
@media(max-width:900px){.public-command-group{grid-template-columns:1fr}.public-platoon-grid{grid-template-columns:1fr}.public-company-leadership{grid-template-columns:1fr}.public-roster-row{grid-template-columns:55px 1fr 1fr}.public-roster-row span:nth-child(4),.public-roster-row span:nth-child(5){display:none}}
@media(max-width:560px){.public-company-file>header{align-items:flex-start;flex-direction:column}.public-command-group article{grid-template-columns:50px 1fr}.public-command-group img{width:48px;height:48px}.public-roster-row{grid-template-columns:45px 1fr}.public-roster-row span:nth-child(3){display:none}}

.page-company,.page-platoon{background:#171c16;color:#efe4c6}
.page-company .company-area{min-height:430px}.page-company .company-shade{background:linear-gradient(90deg,rgba(8,11,8,.87),rgba(8,11,8,.35))}
.page-company .company-office,.page-platoon .platoon-room{background:#30362a}
.page-platoon .records-room-heading{background:linear-gradient(110deg,#20261d,#343a2d);border-bottom:1px solid #6d5b31;color:#eee2c4}


/* PUBLIC CLEANUP / ACCESS / SCALE PASS — 2026-08-20 */
.public-back-strip{background:#11160f;border-top:1px solid rgba(207,174,79,.22);border-bottom:1px solid rgba(207,174,79,.34);padding:8px max(3vw,22px);position:relative;z-index:20}
.public-back-strip a{display:inline-flex;align-items:center;min-height:34px;padding:0 14px;border:1px solid #6f6545;background:#2f3828;color:#eadcb8;text-decoration:none;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em}
.public-back-strip a:hover,.public-back-strip a:focus-visible{background:#d0ad48;color:#181a12;outline:2px solid #efe3c3;outline-offset:2px}
.member-access-clipboard{right:max(3vw,34px);top:38px;width:min(410px,34vw);padding:54px 30px 32px;transform:rotate(.2deg)}
.member-access-clipboard h2{font-size:24px}.member-access-clipboard label{font-size:10px}.member-access-clipboard input{padding:12px 13px;font-size:14px}.member-access-clipboard button{padding:14px;font-size:12px}
.clipboard-access-links{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}.clipboard-access-links a{display:flex;align-items:center;justify-content:center;text-align:center;min-height:34px;padding:5px;border:1px solid #77684a;color:#5b4825;text-decoration:none;font:700 8px/1.25 'Courier Prime',monospace}.clipboard-access-links .clipboard-staff-access{background:#3c4433;color:#f0e3c4;border-color:#20251b}.clipboard-access-links a:hover,.clipboard-access-links a:focus-visible{outline:2px solid #9f7d32;outline-offset:2px}
.hq-arrival__identity{width:min(870px,54vw);margin-left:max(4vw,48px)}
.hq-command-board{padding:30px max(3vw,36px) 42px}.hq-board-grid{max-width:1720px;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.hq-paper{padding:20px;min-height:245px}.hq-paper>header span{font-size:18px}.hq-paper>a{font-size:10px}.hq-photo-record{min-height:330px}.hq-paper--operations,.hq-paper--status{min-height:290px}
.public-office-board{max-width:1560px;padding-left:50px;padding-right:50px}.public-completed-ops>div{padding:13px 12px}.public-completed-ops>div b{font-size:15px}
@media(max-width:1450px){.hq-board-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.member-access-clipboard{width:370px;right:22px}.hq-arrival__identity{width:min(720px,55vw);margin-left:32px}}
@media(max-width:980px){.member-access-clipboard{left:20px;right:20px;width:auto}.clipboard-access-links{grid-template-columns:1fr 1fr}.hq-board-grid{grid-template-columns:1fr 1fr}.public-office-board{padding-left:20px;padding-right:20px}}
@media(max-width:620px){.clipboard-access-links{grid-template-columns:1fr}.hq-board-grid{grid-template-columns:1fr}.hq-command-board{padding:14px}.hq-paper{min-height:0}.public-back-strip{padding:7px 12px}}

/* Dedicated staff authentication entry — intentionally separate from Member Access. */
.clipboard-access-links--member-only{grid-template-columns:1fr}
.staff-access-outpost{
  position:absolute;z-index:5;right:max(3vw,34px);top:470px;width:min(410px,34vw);
  box-sizing:border-box;padding:14px 18px 13px;text-decoration:none;
  background:linear-gradient(180deg,#293125,#1c2219);color:#f0e3c4;
  border:1px solid #8b7644;box-shadow:0 12px 28px rgba(0,0,0,.42),inset 0 0 0 1px rgba(220,190,92,.10);
  font-family:'Courier Prime',monospace;letter-spacing:.04em
}
.staff-access-outpost:before{content:"HQ";position:absolute;right:14px;top:11px;color:#c9a444;font:700 9px 'Courier Prime',monospace;border:1px solid #88733d;padding:3px 5px}
.staff-access-outpost small{display:block;color:#b99a55;font-size:8px;font-weight:700;margin-bottom:4px;padding-right:38px}
.staff-access-outpost strong{display:block;font:700 18px 'Stardos Stencil',serif;letter-spacing:.05em}
.staff-access-outpost span{display:block;margin-top:4px;font-size:8px;color:#d8c69d}
.staff-access-outpost:hover,.staff-access-outpost:focus-visible{background:#35402d;outline:2px solid #c5a44b;outline-offset:3px}
.staff-login-station .staff-auth-form{width:min(560px,92vw);padding-top:46px}
.staff-login-station .staff-auth-form:before{content:"STAFF ONLY";display:inline-block;margin-bottom:12px;padding:5px 9px;border:2px solid rgba(118,47,36,.6);color:#7a3127;font:700 11px 'Oswald',sans-serif;transform:rotate(-2deg)}
.staff-login-station .staff-auth-form h1{margin-top:6px}
@media(max-width:1450px){.staff-access-outpost{right:22px;width:370px;top:455px}}
@media(max-width:980px){.staff-access-outpost{left:20px;right:20px;top:auto;bottom:18px;width:auto}.hq-arrival{padding-bottom:115px}.member-access-clipboard{bottom:95px}}
@media(max-width:640px){.staff-access-outpost{left:18px;right:18px;bottom:15px}.member-access-clipboard{bottom:94px}.hq-arrival{padding-bottom:120px}}

/* =============================================================
   PUBLIC ARRIVAL STORY — RECRUITING-FIRST HOMEPAGE
   ============================================================= */
.public-arrival-story{background:#161b14;color:#efe5c9}
.arrival-hero{position:relative;min-height:760px;overflow:hidden;border-bottom:3px solid #77622f;background:#11160f}
.arrival-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 46%;filter:saturate(.72) contrast(1.05) brightness(.72)}
.arrival-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,8,6,.94) 0%,rgba(8,11,8,.76) 38%,rgba(8,10,7,.42) 65%,rgba(5,7,5,.65) 100%),linear-gradient(0deg,rgba(7,10,7,.82),transparent 46%,rgba(5,7,5,.28))}
.arrival-hero__copy{position:relative;z-index:2;width:min(830px,52vw);padding:88px 0 80px;margin-left:max(4vw,54px)}
.arrival-hero__copy>small,.arrival-story-copy>small,.arrival-feature__copy>small,.arrival-operation-story__copy>small,.field-situation-wrap>header>small,.arrival-awards-preview small,.arrival-final-recruiting small{font:700 10px 'Courier Prime',monospace;letter-spacing:.1em;color:#caa647}
.arrival-hero h1{margin:12px 0 8px;font:700 clamp(54px,5.8vw,96px)/.88 'Stardos Stencil',serif;color:#f1e6c8;text-shadow:0 4px 18px #000;letter-spacing:-.025em}
.arrival-hero h2{margin:0;color:#d5c8a8;font:700 clamp(17px,1.55vw,24px) 'Courier Prime',monospace;letter-spacing:.08em}
.arrival-hero__statement{margin:34px 0 0;max-width:650px;font:16px/1.55 'Courier Prime',monospace;color:#e1d6bb}.arrival-hero__statement b{color:#f3e7c7}
.arrival-hero__motto{margin:27px 0 24px;font:700 clamp(27px,2.7vw,44px)/1.08 'Courier Prime',monospace;color:#f2e6c4;text-shadow:0 3px 8px #000}
.arrival-hero__actions{display:flex;gap:12px;flex-wrap:wrap}

.photo-member-clipboard{position:absolute;z-index:5;right:max(3.2vw,42px);top:34px;width:min(425px,33vw);aspect-ratio:955/1448;filter:drop-shadow(0 22px 30px rgba(0,0,0,.56));transform:rotate(.1deg)}
.photo-member-clipboard>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block}
.photo-member-clipboard__form{position:absolute;left:16%;right:16%;top:24.5%;bottom:12%;color:#292218;display:flex;flex-direction:column;justify-content:flex-start}
.photo-member-clipboard__form header{text-align:center;margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid rgba(75,63,43,.72)}
.photo-member-clipboard__form header small{font:700 8px 'Courier Prime',monospace;color:#69552c}.photo-member-clipboard__form h2{font:700 20px 'Stardos Stencil',serif;margin:2px 0;color:#272014}
.photo-member-clipboard__form form{display:grid;gap:7px;margin-top:4px}.photo-member-clipboard__form label{font:700 9px 'Courier Prime',monospace;color:#30281d}
.photo-member-clipboard__form input{width:100%;box-sizing:border-box;border:1px solid rgba(86,72,48,.72);background:rgba(246,237,213,.72);padding:11px 12px;font:13px 'Courier Prime',monospace;color:#251f16;box-shadow:inset 0 1px 3px rgba(0,0,0,.08)}
.photo-member-clipboard__form input:focus{outline:3px solid rgba(164,126,41,.42);outline-offset:1px;background:rgba(255,248,226,.9)}
.photo-member-clipboard__form button{margin-top:8px;border:1px solid #151910;background:#35402d;color:#f0e3c4;padding:13px 10px;font:700 11px 'Courier Prime',monospace;letter-spacing:.04em;cursor:pointer;box-shadow:0 3px 7px rgba(0,0,0,.2)}
.photo-member-clipboard__form button:hover,.photo-member-clipboard__form button:focus-visible{background:#46553a;outline:2px solid #b79136;outline-offset:2px}
.arrival-staff-access{position:absolute;z-index:6;right:max(3.2vw,42px);bottom:28px;width:min(425px,33vw);box-sizing:border-box;padding:13px 18px;background:rgba(25,30,22,.96);border:1px solid #71613a;color:#f0e3c4;text-decoration:none;box-shadow:0 10px 22px rgba(0,0,0,.35)}
.arrival-staff-access small,.arrival-staff-access span{display:block;font:700 8px 'Courier Prime',monospace;color:#bba05d}.arrival-staff-access strong{display:block;margin:3px 0;font:700 18px 'Stardos Stencil',serif}.arrival-staff-access:hover,.arrival-staff-access:focus-visible{background:#36402f;outline:2px solid #c6a247;outline-offset:3px}

.hq-live-ticker{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:22px;background:#d6c69f;color:#292218;border-top:1px solid #8e7a4f;border-bottom:1px solid #7f6c44;padding:11px max(4vw,50px);overflow:hidden}.hq-live-ticker>b{font:700 12px 'Stardos Stencil',serif;color:#6e3b2b;white-space:nowrap}.hq-live-ticker__track{display:flex;gap:26px;overflow:hidden;white-space:nowrap;font:12px 'Courier Prime',monospace}.hq-live-ticker__track span{display:inline-flex;gap:8px}.hq-live-ticker__track i{font-style:normal;font-weight:700;color:#715a28}

.arrival-story-section,.arrival-feature{max-width:1540px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;min-height:500px}.arrival-story-section{padding:72px max(4vw,50px);gap:55px;align-items:center}.arrival-photo-card img{width:100%;display:block;box-shadow:0 20px 35px rgba(0,0,0,.38);border:1px solid #6f603e}.arrival-story-copy h2,.arrival-feature__copy h2,.arrival-orders-paper h2,.arrival-awards-preview h2,.arrival-final-recruiting h2{font:700 clamp(34px,3.4vw,58px)/.98 'Stardos Stencil',serif;color:#efe3c3;margin:10px 0 18px}.arrival-story-copy p,.arrival-feature__copy p{font:15px/1.65 'Courier Prime',monospace;color:#d2c6aa;max-width:720px}.replacement-route{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:26px 0;font:700 10px 'Courier Prime',monospace;color:#2a2418}.replacement-route span{padding:9px 10px;background:#d9cba7;border:1px solid #7f704e}.replacement-route b{color:#c9a447}

.arrival-orders-section{padding:50px max(5vw,60px) 76px;background:linear-gradient(180deg,#242b20,#1a2018)}.arrival-orders-paper{max-width:1180px;margin:auto;position:relative;padding:38px 48px;background:linear-gradient(#e2d7b8,#d1c19b);color:#2a2318;border:1px solid #7f704f;box-shadow:0 14px 30px rgba(0,0,0,.35),inset 0 0 0 7px rgba(255,255,255,.09)}.arrival-orders-paper:before{content:"";position:absolute;inset:10px;border:1px solid rgba(95,78,45,.2);pointer-events:none}.arrival-orders-paper header{text-align:center;border-bottom:2px solid #665735;padding-bottom:14px}.arrival-orders-paper header small,.arrival-orders-paper header span{display:block;font:700 9px 'Courier Prime',monospace;letter-spacing:.06em}.arrival-orders-paper header b{display:block;font:700 17px 'Courier Prime',monospace;margin:4px}.arrival-orders-paper h2{color:#2b2419;text-align:center;font-size:clamp(28px,2.7vw,44px);margin:28px auto 12px;max-width:900px}.arrival-orders-paper>p{text-align:center;font:14px/1.55 'Courier Prime',monospace;max-width:850px;margin:0 auto 25px}.orders-record-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.orders-record-grid span{border:1px solid #968663;padding:14px;font:12px/1.4 'Courier Prime',monospace;background:rgba(255,255,255,.12)}.orders-record-grid b{display:block;margin-bottom:5px;color:#6b432b}.orders-stamp{display:block;width:max-content;max-width:100%;margin:28px auto 0;padding:8px 14px;border:3px double rgba(116,47,35,.55);color:rgba(116,47,35,.8);font:700 16px 'Oswald',sans-serif;transform:rotate(-1.5deg)}

.arrival-feature{max-width:none;min-height:560px;background:#151a13}.arrival-feature__image{min-height:560px;overflow:hidden}.arrival-feature__image img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.78) contrast(1.02)}.arrival-feature__copy{display:flex;flex-direction:column;justify-content:center;padding:65px max(5vw,70px);background:linear-gradient(135deg,#22291f,#171c16)}.arrival-feature__copy h3{font:700 19px/1.3 'Courier Prime',monospace;color:#d7b758;margin:0 0 14px}.arrival-feature__copy ul{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;margin:8px 0 18px;padding:0;list-style:none}.arrival-feature__copy li{font:700 12px 'Courier Prime',monospace;color:#e3d8ba;border-bottom:1px dotted #6f684f;padding:7px 0}.arrival-feature__copy li:before{content:"★";color:#c7a344;margin-right:8px}.arrival-feature--formation .arrival-feature__copy{order:1}.arrival-feature--formation .arrival-feature__image{order:2}.formation-path{display:flex;flex-direction:column;width:min(430px,100%);gap:4px;margin:17px 0}.formation-path b{background:#d6c69f;color:#292218;border:1px solid #81704a;padding:10px 14px;font:700 12px 'Courier Prime',monospace}.formation-path i{font-style:normal;color:#c8a447;padding-left:24px}.formation-example strong{color:#efe1bc}.arrival-feature__copy>a,.arrival-awards-preview a{color:#d2b04c;font:700 10px 'Courier Prime',monospace;text-decoration:none;margin-top:12px}

.arrival-operation-story{position:relative;min-height:650px;display:flex;align-items:center;overflow:hidden}.arrival-operation-story>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.82) contrast(1.05)}.arrival-operation-story__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,12,9,.94),rgba(10,13,10,.7) 48%,rgba(8,10,8,.36)),linear-gradient(0deg,rgba(7,9,7,.7),transparent)}.arrival-operation-story__copy{position:relative;z-index:2;width:min(890px,72vw);padding:90px max(5vw,70px)}.arrival-operation-story h2{font:700 clamp(42px,4.8vw,78px)/.93 'Stardos Stencil',serif;color:#f1e5c5;margin:10px 0 24px;text-shadow:0 4px 14px #000}.operation-chain{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 22px}.operation-chain span{padding:8px 9px;background:rgba(223,211,178,.92);color:#282117;border:1px solid #8d7d57;font:700 9px 'Courier Prime',monospace}.operation-chain b{color:#d4ae43}.arrival-operation-story p{font:14px/1.6 'Courier Prime',monospace;color:#ded1b3;max-width:720px}

.field-situation-wrap{padding:70px max(4vw,50px);background:#20271d}.field-situation-wrap>header{max-width:1440px;margin:0 auto 24px}.field-situation-wrap h2{font:700 clamp(36px,3.4vw,55px) 'Stardos Stencil',serif;margin:5px 0;color:#eee1c2}.field-situation-wrap header p{font:13px 'Courier Prime',monospace;color:#bfb498}.field-situation-board{max-width:1440px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.field-situation-board article{min-height:138px;padding:21px;background:#d6c69f;color:#292218;border:1px solid #80704d;box-shadow:0 7px 15px rgba(0,0,0,.25);display:flex;flex-direction:column}.field-situation-board small{font:700 9px 'Courier Prime',monospace;color:#795132}.field-situation-board b{font:700 31px 'Stardos Stencil',serif;margin:12px 0 5px}.field-situation-board span{font:11px/1.45 'Courier Prime',monospace}.field-situation-board__operation{grid-column:span 1}

.arrival-awards-preview{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:70px max(5vw,70px);background:#151a13}.arrival-awards-preview p{font:14px/1.6 'Courier Prime',monospace;color:#cabfa5;max-width:700px}.arrival-ribbon-rack{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:center;padding:30px;background:#d4c49d;border:1px solid #7e6e4b;min-height:120px}.arrival-ribbon-rack img{width:150px;height:45px;object-fit:contain}.arrival-ribbon-rack span{color:#2c261b;font:700 10px 'Courier Prime',monospace}
.arrival-final-recruiting{display:grid;grid-template-columns:auto 1fr auto auto;gap:30px;align-items:center;padding:34px max(4vw,50px);background:linear-gradient(#d4c59f,#c7b78e);color:#292218;border-top:1px solid #857550}.arrival-final-recruiting h2{color:#2b2419;font-size:clamp(29px,3vw,48px);margin:4px 0 8px}.arrival-final-recruiting p{font:12px/1.5 'Courier Prime',monospace}.arrival-final-recruiting__motto{font:700 15px/1.3 'Courier Prime',monospace;color:#6f3829;white-space:nowrap}.arrival-final-recruiting__motto span,.arrival-final-recruiting__motto b{display:block}

/* Reuse the supplied Army clipboard on the standalone member-login page too. */
.page-member-login .member-record-login-sheet{background-color:transparent;background-image:url('/static/art/public-overhaul/member-access-clipboard.webp');background-repeat:no-repeat;background-position:center;background-size:contain;border:0;box-shadow:none;min-height:720px;width:min(490px,92vw);padding:190px 92px 100px;box-sizing:border-box;color:#292218}.page-member-login .member-record-login-sheet:before,.page-member-login .member-record-login-sheet:after{display:none}.page-member-login .member-record-login-sheet .army-letterhead{background:transparent;border-bottom:1px solid #6f6044}.page-member-login .member-record-login-sheet h1{font-size:28px}.page-member-login .member-record-login-sheet p,.page-member-login .member-login-note{color:#3b3021}.page-member-login .member-record-login-sheet input{background:rgba(246,237,213,.76)}

@media(max-width:1450px){.arrival-hero{min-height:790px}.photo-member-clipboard{width:390px;right:24px}.arrival-staff-access{width:390px;right:24px}.arrival-hero__copy{width:min(700px,52vw);margin-left:32px}.field-situation-board{grid-template-columns:repeat(2,1fr)}}
@media(max-width:1050px){.arrival-hero{min-height:1180px}.arrival-hero__copy{width:calc(100% - 44px);margin:0;padding:65px 22px 0}.photo-member-clipboard{left:50%;right:auto;transform:translateX(-50%);top:520px;width:min(430px,88vw)}.arrival-staff-access{left:50%;right:auto;transform:translateX(-50%);bottom:28px;width:min(430px,88vw)}.arrival-story-section,.arrival-feature,.arrival-awards-preview{grid-template-columns:1fr}.arrival-story-section{padding:55px 24px}.arrival-feature--formation .arrival-feature__copy,.arrival-feature--formation .arrival-feature__image{order:initial}.arrival-feature__image{min-height:420px}.arrival-feature__copy{padding:55px 34px}.orders-record-grid{grid-template-columns:1fr 1fr}.arrival-final-recruiting{grid-template-columns:auto 1fr}.arrival-final-recruiting__motto,.arrival-final-recruiting>a{grid-column:2}.hq-live-ticker{grid-template-columns:1fr}.hq-live-ticker__track{overflow-x:auto}}
@media(max-width:680px){.arrival-hero{min-height:1110px}.arrival-hero h1{font-size:clamp(44px,13vw,64px)}.arrival-hero__statement{font-size:13px}.arrival-hero__actions{display:grid}.hq-button{width:100%;box-sizing:border-box}.photo-member-clipboard{top:485px;width:min(385px,94vw)}.arrival-staff-access{width:min(385px,94vw)}.photo-member-clipboard__form{left:17%;right:17%;top:24%}.photo-member-clipboard__form h2{font-size:18px}.photo-member-clipboard__form input{padding:9px}.photo-member-clipboard__form button{padding:11px}.arrival-story-section,.arrival-orders-section,.arrival-feature__copy,.field-situation-wrap,.arrival-awards-preview,.arrival-final-recruiting{padding-left:18px;padding-right:18px}.orders-record-grid,.field-situation-board{grid-template-columns:1fr}.arrival-orders-paper{padding:28px 18px}.arrival-feature__copy ul{grid-template-columns:1fr}.arrival-operation-story{min-height:720px}.arrival-operation-story__copy{width:auto;padding:70px 20px}.arrival-final-recruiting{grid-template-columns:1fr}.arrival-final-recruiting__motto,.arrival-final-recruiting>a{grid-column:auto}.recruiting-stamp{width:130px}.page-member-login .member-record-login-sheet{min-height:650px;padding:165px 68px 80px;width:min(440px,96vw)}}

/* === PUBLIC RECRUITING OVERHAUL 2026-08-21 === */
.public-report-tab{
  position:fixed;right:18px;bottom:18px;z-index:120;
  padding:12px 16px;border:1px solid #85734e;background:rgba(213,198,159,.96);color:#2d2417;
  text-decoration:none;font:700 11px 'Courier Prime',monospace;letter-spacing:.08em;
  box-shadow:0 12px 24px rgba(0,0,0,.32);backdrop-filter:blur(3px)
}
.public-report-tab:hover,.public-report-tab:focus-visible{background:#eee1bf;outline:2px solid #b28d32;outline-offset:2px}
.public-recruiting-overhaul .hq-live-ticker{position:relative;z-index:2}
.recruiting-journey,.formation-preview-section,.specialties-needed{padding:84px max(4vw,50px)}
.recruiting-journey{background:#282f24}
.recruiting-journey__heading,.specialties-needed>header{max-width:1380px;margin:0 auto 30px}
.recruiting-journey__heading h2,.formation-preview-section__copy h2,.night-in-unit__heading h2,.specialties-needed h2{font:700 clamp(36px,3.6vw,58px)/.98 'Stardos Stencil',serif;color:#efe2c2;margin:8px 0 14px}
.recruiting-journey__heading small,.formation-preview-section__copy small,.night-in-unit__heading small,.specialties-needed small{font:700 10px 'Courier Prime',monospace;letter-spacing:.1em;color:#caa647}
.recruiting-journey__heading p,.formation-preview-section__copy p,.specialties-needed>header p{max-width:880px;font:14px/1.7 'Courier Prime',monospace;color:#cfc4a9}
.journey-grid{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.journey-card{background:linear-gradient(180deg,#ded2b1,#cdbc95);color:#292218;border:1px solid #7c6b47;box-shadow:0 14px 26px rgba(0,0,0,.25);padding:18px;display:grid;grid-template-columns:160px 1fr;gap:16px;align-items:center}
.journey-card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#e8dcc0;border:1px solid rgba(70,58,37,.35)}
.journey-card small,.specialty-card small,.formation-preview-board__header,.night-timeline strong{font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;color:#745b2a}
.journey-card h3,.specialty-card h3,.night-timeline h3{margin:6px 0 8px;font:700 22px/1.05 'Stardos Stencil',serif;color:#292218}
.journey-card p,.specialty-card p,.night-timeline p{font:12px/1.6 'Courier Prime',monospace;color:#30281d}
.recruiting-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:34px;align-items:center;max-width:1440px;margin:0 auto;padding:84px max(4vw,50px)}
.recruiting-split--record{background:#20271d}
.recruiting-split--weapon{background:#171d16}
.recruiting-split__copy h2{font:700 clamp(36px,3.5vw,58px)/.98 'Stardos Stencil',serif;color:#efe2c2;margin:8px 0 14px}
.recruiting-split__copy small,.arrival-awards-preview--recruiting small{font:700 10px 'Courier Prime',monospace;letter-spacing:.1em;color:#caa647}
.recruiting-split__copy p,.arrival-awards-preview--recruiting p{max-width:700px;font:14px/1.7 'Courier Prime',monospace;color:#cfc4a9}
.paper-frame{background:linear-gradient(180deg,#eadfc4,#d6c6a0);padding:22px;border:1px solid #82704a;box-shadow:0 18px 30px rgba(0,0,0,.28)}
.paper-frame img,.recruiting-split__image img,.formation-preview-section__image img,.specialty-card img,.arrival-awards-preview__artifact img{width:100%;display:block;object-fit:cover}
.recruiting-split__image--dark{background:#222a20;padding:18px;border:1px solid rgba(216,201,158,.18);box-shadow:0 18px 30px rgba(0,0,0,.28)}
.recruiting-record-grid{margin:24px 0 18px}
.recruiting-call-line{margin-top:18px;font:700 13px 'Courier Prime',monospace;color:#efe2c2;letter-spacing:.05em}
.recruiting-bullet-list{margin:24px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.recruiting-bullet-list li{padding:11px 12px;background:#d7c89f;color:#2a2418;border:1px solid #7a6c49;font:700 11px/1.35 'Courier Prime',monospace}
.formation-preview-section{max-width:1440px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:34px;align-items:center;background:#283024}
.formation-preview-board{margin:24px 0 20px;background:#d6c69f;color:#292218;border:1px solid #7c6b47;box-shadow:0 14px 26px rgba(0,0,0,.26)}
.formation-preview-board__header{padding:13px 16px;border-bottom:1px solid #7c6b47;background:#c8b789;color:#6f3b2b}
.formation-preview-board__rows div{display:grid;grid-template-columns:180px 1fr;gap:14px;padding:14px 16px;border-bottom:1px dashed rgba(70,58,37,.25);font:12px/1.5 'Courier Prime',monospace}
.formation-preview-board__rows div:last-child{border-bottom:0}
.formation-preview-board__rows b{font:700 13px 'Stardos Stencil',serif}
.formation-example{margin:0 0 18px}
.formation-actions{display:flex;gap:12px;flex-wrap:wrap}
.night-in-unit{position:relative;min-height:760px;overflow:hidden;background:#111}
.night-in-unit__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 24%;filter:brightness(.3) saturate(.8)}
.night-in-unit__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,10,8,.9),rgba(8,10,8,.64) 54%,rgba(8,10,8,.88)),linear-gradient(0deg,rgba(8,10,8,.84),rgba(8,10,8,.15) 40%,rgba(8,10,8,.82))}
.night-in-unit__content{position:relative;z-index:2;max-width:1440px;margin:0 auto;padding:88px max(4vw,50px)}
.night-in-unit__heading{max-width:1040px;margin-bottom:28px}
.night-timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.night-timeline article{background:rgba(223,209,173,.94);padding:22px;border:1px solid rgba(126,108,71,.9);box-shadow:0 12px 24px rgba(0,0,0,.28);color:#292218}
.specialties-needed{background:#20271d}
.specialties-grid{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.specialty-card{background:linear-gradient(180deg,#ded2b1,#cdbc95);border:1px solid #7c6b47;box-shadow:0 14px 26px rgba(0,0,0,.25);display:grid;grid-template-columns:220px 1fr;gap:18px;align-items:center;padding:18px;color:#292218}
.specialty-card img{aspect-ratio:1/1;background:#e8dcc0;border:1px solid rgba(70,58,37,.35)}
.arrival-awards-preview--recruiting{padding:84px max(4vw,50px);background:#171d16;display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,.75fr) minmax(280px,.65fr);gap:28px;align-items:center}
.arrival-awards-preview--recruiting .arrival-awards-preview__copy h2{font:700 clamp(34px,3.4vw,54px)/.98 'Stardos Stencil',serif;color:#efe2c2;margin:8px 0 14px}
.arrival-awards-preview--recruiting .arrival-ribbon-rack{align-self:start}
.arrival-awards-preview--recruiting .arrival-awards-preview__artifact{align-self:stretch;display:flex}
.arrival-awards-preview--recruiting .arrival-awards-preview__artifact img{height:100%;border:1px solid #7d6c46}
.arrival-final-recruiting--poster{grid-template-columns:160px minmax(0,1fr) auto auto;padding:48px max(4vw,50px);align-items:center}
.arrival-final-recruiting__art img{width:140px;max-width:100%;display:block}
.final-call-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end}
@media(max-width:1320px){
  .journey-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .night-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}
  .arrival-awards-preview--recruiting{grid-template-columns:1fr 1fr}
  .arrival-awards-preview--recruiting .arrival-awards-preview__artifact{grid-column:1/-1;max-width:520px}
}
@media(max-width:1050px){
  .public-report-tab{right:14px;left:14px;bottom:14px;text-align:center}
  .recruiting-split,.formation-preview-section,.arrival-awards-preview--recruiting{grid-template-columns:1fr}
  .journey-card,.specialty-card{grid-template-columns:1fr}
  .journey-card img,.specialty-card img{aspect-ratio:16/10}
  .specialties-grid,.journey-grid{grid-template-columns:1fr}
  .arrival-final-recruiting--poster{grid-template-columns:1fr}
  .arrival-final-recruiting__motto,.final-call-actions{justify-content:flex-start}
}
@media(max-width:700px){
  .recruiting-journey,.formation-preview-section,.specialties-needed,.recruiting-split,.arrival-awards-preview--recruiting{padding:58px 18px}
  .night-in-unit__content{padding:62px 18px}
  .journey-card,.specialty-card,.night-timeline article{padding:16px}
  .night-timeline{grid-template-columns:1fr}
  .recruiting-bullet-list{grid-template-columns:1fr}
  .formation-preview-board__rows div{grid-template-columns:1fr}
}

/* === PUBLIC RECRUITING VISUAL ALIGNMENT + LOGIN FIX 2026-08-21 === */
.public-recruiting-overhaul .photo-member-clipboard>img{pointer-events:none;z-index:1}
.public-recruiting-overhaul .photo-member-clipboard__form{z-index:3;bottom:9%}
.public-recruiting-overhaul .photo-member-clipboard__form form{position:relative;z-index:4}
.public-recruiting-overhaul .photo-member-clipboard__staff{
  display:block;box-sizing:border-box;width:100%;margin-top:2px;border:1px solid #151910;
  background:#35402d;color:#f0e3c4;padding:13px 10px;text-align:center;text-decoration:none;
  font:700 11px 'Courier Prime',monospace;letter-spacing:.04em;cursor:pointer;
  box-shadow:0 3px 7px rgba(0,0,0,.2)
}
.public-recruiting-overhaul .photo-member-clipboard__staff:hover,
.public-recruiting-overhaul .photo-member-clipboard__staff:focus-visible{background:#46553a;outline:2px solid #b79136;outline-offset:2px}
.public-recruiting-overhaul .arrival-staff-access{display:none!important}

/* New recruiting art is now transparent. Keep each object centered, evenly padded, and uncropped. */
.public-recruiting-overhaul .journey-card{grid-template-columns:180px minmax(0,1fr);min-height:235px}
.public-recruiting-overhaul .journey-card>img{
  width:100%;height:180px;aspect-ratio:auto;object-fit:contain;object-position:center;
  background:transparent;border:0;padding:4px;box-sizing:border-box
}
.public-recruiting-overhaul .specialty-card{grid-template-columns:220px minmax(0,1fr);min-height:255px}
.public-recruiting-overhaul .specialty-card>img{
  width:100%;height:220px;aspect-ratio:auto;object-fit:contain;object-position:center;
  background:transparent;border:0;padding:4px;box-sizing:border-box
}
.public-recruiting-overhaul .paper-frame{overflow:hidden}
.public-recruiting-overhaul .paper-frame img,
.public-recruiting-overhaul .recruiting-split__image img,
.public-recruiting-overhaul .formation-preview-section__image img,
.public-recruiting-overhaul .arrival-awards-preview__artifact img{
  object-fit:contain;object-position:center;background:transparent
}
.public-recruiting-overhaul .recruiting-split__image{display:flex;align-items:center;justify-content:center;min-height:420px}
.public-recruiting-overhaul .recruiting-split__image img{max-height:520px}
.public-recruiting-overhaul .formation-preview-section__image{display:flex;align-items:center;justify-content:center}
.public-recruiting-overhaul .formation-preview-section__image img{max-height:540px}
.public-recruiting-overhaul .arrival-final-recruiting__art{display:flex;align-items:center;justify-content:center}
.public-recruiting-overhaul .arrival-final-recruiting__art img{object-fit:contain;object-position:center;background:transparent}

@media(max-width:1050px){
  .public-recruiting-overhaul .journey-card,.public-recruiting-overhaul .specialty-card{grid-template-columns:180px minmax(0,1fr)}
  .public-recruiting-overhaul .journey-card>img{height:170px}
  .public-recruiting-overhaul .specialty-card>img{height:190px}
}
@media(max-width:700px){
  .public-recruiting-overhaul .journey-card,.public-recruiting-overhaul .specialty-card{grid-template-columns:1fr;min-height:0}
  .public-recruiting-overhaul .journey-card>img,.public-recruiting-overhaul .specialty-card>img{height:210px}
  .public-recruiting-overhaul .photo-member-clipboard__form{bottom:7.5%}
  .public-recruiting-overhaul .photo-member-clipboard__staff{padding:11px 8px}
}
/* Remove the old light photo mat now that uploaded artwork has transparent backgrounds. */
.public-recruiting-overhaul .paper-frame{
  background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important
}
.public-recruiting-overhaul .recruiting-split__image--dark{
  background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important
}
.public-recruiting-overhaul .journey-card>img,
.public-recruiting-overhaul .specialty-card>img{filter:drop-shadow(0 8px 10px rgba(0,0,0,.2))}

/* === FINAL TRANSPARENT ASSET + STAFF PORTAL POLISH — 2026-08-21 === */
.public-recruiting-overhaul .photo-member-clipboard{
  background:transparent!important;
  box-shadow:none!important;
}
.public-recruiting-overhaul .photo-member-clipboard>img{
  background:transparent!important;
  pointer-events:none!important;
  filter:drop-shadow(0 20px 24px rgba(0,0,0,.48));
}
.public-recruiting-overhaul .photo-member-clipboard__staff{
  position:relative;z-index:20;pointer-events:auto!important;
  margin-top:8px!important;display:flex!important;align-items:center;justify-content:center;
  min-height:42px;box-sizing:border-box;width:100%;
}
.public-recruiting-overhaul .photo-member-clipboard__form{pointer-events:auto!important}
.public-recruiting-overhaul .photo-member-clipboard__form form{pointer-events:auto!important}

/* Uploaded art: no mats, no square crops, no opaque presentation boxes. */
.public-recruiting-overhaul .journey-card>img,
.public-recruiting-overhaul .specialty-card>img,
.public-recruiting-overhaul .recruiting-split__image img,
.public-recruiting-overhaul .formation-preview-section__image img,
.public-recruiting-overhaul .arrival-awards-preview__artifact img,
.public-recruiting-overhaul .arrival-final-recruiting__art img{
  background:transparent!important;border:0!important;box-shadow:none!important;
  object-fit:contain!important;object-position:center!important;
}
.public-recruiting-overhaul .journey-card>img,
.public-recruiting-overhaul .specialty-card>img{
  filter:drop-shadow(0 9px 9px rgba(29,25,16,.18));
}
.public-recruiting-overhaul .journey-card{
  grid-template-columns:minmax(150px,190px) minmax(0,1fr);
  align-items:center;overflow:hidden;
}
.public-recruiting-overhaul .journey-card>img{
  width:100%;height:175px;padding:0!important;margin:auto;
}
.public-recruiting-overhaul .journey-card:nth-child(1)>img{height:150px}
.public-recruiting-overhaul .journey-card:nth-child(6)>img{height:165px}

.public-recruiting-overhaul .recruiting-split__image,
.public-recruiting-overhaul .formation-preview-section__image,
.public-recruiting-overhaul .arrival-awards-preview__artifact{
  background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;
  overflow:visible!important;
}
.public-recruiting-overhaul .recruiting-split--record .recruiting-split__image img{
  width:min(100%,620px);max-height:430px;
  filter:drop-shadow(0 18px 18px rgba(0,0,0,.30));
}
.public-recruiting-overhaul .recruiting-split--weapon .recruiting-split__image img{
  width:min(100%,690px);max-height:510px;
  filter:drop-shadow(0 18px 20px rgba(0,0,0,.32));
  -webkit-mask-image:radial-gradient(ellipse 86% 84% at 50% 50%,#000 70%,rgba(0,0,0,.95) 78%,transparent 100%);
  mask-image:radial-gradient(ellipse 86% 84% at 50% 50%,#000 70%,rgba(0,0,0,.95) 78%,transparent 100%);
}
.public-recruiting-overhaul .formation-preview-section__image img{
  width:min(100%,610px);max-height:530px;
  filter:drop-shadow(0 18px 18px rgba(0,0,0,.30));
}
.public-recruiting-overhaul .arrival-awards-preview__artifact img{
  width:min(100%,520px);max-height:430px;
  filter:drop-shadow(0 16px 16px rgba(0,0,0,.28));
}
.public-recruiting-overhaul .specialty-card{
  grid-template-columns:minmax(190px,230px) minmax(0,1fr);align-items:center;overflow:hidden;
}
.public-recruiting-overhaul .specialty-card>img{
  width:100%;height:205px;padding:0!important;margin:auto;
}
.public-recruiting-overhaul .specialty-card:nth-child(1)>img{height:190px}
.public-recruiting-overhaul .specialty-card:nth-child(4)>img{height:210px}

/* Keep feature illustrations centered in their own column and away from text edges. */
.public-recruiting-overhaul .recruiting-split__image,
.public-recruiting-overhaul .formation-preview-section__image{justify-self:center;width:100%}
.public-recruiting-overhaul .recruiting-split{overflow:hidden}
.public-recruiting-overhaul .formation-preview-section{overflow:hidden}

@media(max-width:1050px){
  .public-recruiting-overhaul .journey-card{grid-template-columns:170px minmax(0,1fr)}
  .public-recruiting-overhaul .specialty-card{grid-template-columns:190px minmax(0,1fr)}
  .public-recruiting-overhaul .recruiting-split--record .recruiting-split__image img,
  .public-recruiting-overhaul .recruiting-split--weapon .recruiting-split__image img,
  .public-recruiting-overhaul .formation-preview-section__image img{max-width:650px}
}
@media(max-width:700px){
  .public-recruiting-overhaul .journey-card,.public-recruiting-overhaul .specialty-card{grid-template-columns:1fr}
  .public-recruiting-overhaul .journey-card>img{height:190px}
  .public-recruiting-overhaul .specialty-card>img{height:205px}
  .public-recruiting-overhaul .photo-member-clipboard__staff{min-height:38px;margin-top:6px!important}
}

/* === STAFF ACCESS UX REBUILD 2026-08-21 === */
.public-recruiting-overhaul .arrival-access-stack{
  position:absolute;z-index:30;right:max(3.2vw,42px);top:34px;
  width:min(425px,33vw);display:flex;flex-direction:column;gap:12px;
}
.public-recruiting-overhaul .arrival-access-stack .photo-member-clipboard{
  position:relative!important;inset:auto!important;right:auto!important;top:auto!important;left:auto!important;bottom:auto!important;
  width:100%!important;transform:none!important;z-index:1!important;flex:0 0 auto;
}
.public-recruiting-overhaul .photo-member-clipboard>img{pointer-events:none!important;z-index:1!important}
.public-recruiting-overhaul .photo-member-clipboard__form{z-index:4!important;pointer-events:auto!important}
.public-recruiting-overhaul .photo-member-clipboard__staff{display:none!important}
.public-recruiting-overhaul .hero-staff-access{
  position:relative;z-index:50;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;
  box-sizing:border-box;padding:14px 15px;background:rgba(28,34,25,.98);border:1px solid #7d693a;
  box-shadow:0 12px 24px rgba(0,0,0,.42);color:#f0e3c4;
}
.public-recruiting-overhaul .hero-staff-access__copy small,
.public-recruiting-overhaul .hero-staff-access__copy span{display:block;font:700 8px/1.35 'Courier Prime',monospace;letter-spacing:.06em;color:#bba05d}
.public-recruiting-overhaul .hero-staff-access__copy strong{display:block;margin:3px 0;font:700 19px/1 'Stardos Stencil',serif;color:#f1e5c6}
.public-recruiting-overhaul .hero-staff-access form{margin:0;position:relative;z-index:60}
.public-recruiting-overhaul .hero-staff-access button{
  min-width:148px;border:1px solid #b18c36;background:#d8c89f;color:#2a2418;padding:13px 14px;
  font:700 10px 'Courier Prime',monospace;letter-spacing:.045em;cursor:pointer;box-shadow:0 3px 7px rgba(0,0,0,.25)
}
.public-recruiting-overhaul .hero-staff-access button:hover,
.public-recruiting-overhaul .hero-staff-access button:focus-visible{background:#efe1bb;outline:2px solid #c9a447;outline-offset:2px}
.public-recruiting-overhaul .arrival-hero{min-height:900px}
@media(max-width:1450px){
  .public-recruiting-overhaul .arrival-access-stack{width:390px;right:24px}
  .public-recruiting-overhaul .arrival-hero{min-height:900px}
}
@media(max-width:1050px){
  .public-recruiting-overhaul .arrival-hero{min-height:1320px}
  .public-recruiting-overhaul .arrival-access-stack{left:50%;right:auto;top:520px;transform:translateX(-50%);width:min(430px,88vw)}
}
@media(max-width:680px){
  .public-recruiting-overhaul .arrival-hero{min-height:1250px}
  .public-recruiting-overhaul .arrival-access-stack{top:485px;width:min(385px,94vw)}
  .public-recruiting-overhaul .hero-staff-access{grid-template-columns:1fr;gap:9px;padding:13px}
  .public-recruiting-overhaul .hero-staff-access button{width:100%}
}

/* === MEMBER "MY SOLDIER" UX OVERHAUL — 2026-08-21 === */
.member-soldier-hq{background:#1b2119;color:#eee3c5}
.member-soldier-hq .logged-back-wrap{display:none}
.soldier-command-hero{position:relative;min-height:250px;background:url('/static/art/hq-field-desk.webp') center 58%/cover no-repeat;overflow:hidden;border-bottom:1px solid rgba(205,183,122,.24)}
.soldier-command-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,16,12,.91),rgba(13,18,13,.6) 62%,rgba(12,16,12,.78)),linear-gradient(0deg,rgba(11,15,11,.82),transparent 70%)}
.soldier-command-hero__title{position:relative;z-index:2;width:min(1420px,calc(100% - 80px));margin:0 auto;padding:62px 0 46px}
.soldier-command-hero__title small,.soldier-record-links>header small,.soldier-recent-service>header small{font:700 10px 'Courier Prime',monospace;letter-spacing:.12em;color:#c8a54b}
.soldier-command-hero__title h1{font:700 clamp(54px,6vw,90px)/.9 'Stardos Stencil',serif;margin:8px 0 12px;color:#f0e5c9;text-shadow:0 4px 14px rgba(0,0,0,.6)}
.soldier-command-hero__title p{font:14px/1.55 'Courier Prime',monospace;color:#d7cbae;max-width:760px;margin:0}

.soldier-inspection-deck{width:min(1500px,calc(100% - 64px));margin:38px auto 24px;display:grid;grid-template-columns:minmax(300px,.95fr) minmax(330px,1.05fr) minmax(300px,.95fr);gap:20px;align-items:stretch}
.soldier-focus-card,.soldier-identity-card{min-height:660px;box-sizing:border-box;border:1px solid #786946;box-shadow:0 18px 32px rgba(0,0,0,.28)}
.soldier-focus-card{display:flex;flex-direction:column;background:linear-gradient(180deg,#d9cba7,#c6b78e);color:#282116;text-decoration:none;overflow:hidden;transition:transform .16s ease,box-shadow .16s ease}
.soldier-focus-card:hover,.soldier-focus-card:focus-visible{transform:translateY(-3px);box-shadow:0 22px 38px rgba(0,0,0,.38);outline:2px solid #b7953f;outline-offset:2px}
.soldier-focus-card header{padding:17px 18px 14px;border-bottom:1px solid rgba(71,58,36,.38);display:grid;grid-template-columns:1fr auto;gap:3px 12px;align-items:end}
.soldier-focus-card header small{grid-column:1/-1;font:700 9px 'Courier Prime',monospace;letter-spacing:.1em;color:#725228}
.soldier-focus-card header strong{font:700 25px 'Stardos Stencil',serif;color:#292117}
.soldier-focus-card header span{font:700 9px 'Courier Prime',monospace;color:#725228;text-align:right}
.soldier-focus-card footer{margin-top:auto;display:flex;justify-content:space-between;gap:12px;padding:14px 18px;background:rgba(56,49,33,.08);border-top:1px solid rgba(71,58,36,.28);font:700 10px 'Courier Prime',monospace}
.soldier-uniform-stage{position:relative;flex:1;min-height:510px;overflow:hidden;background:linear-gradient(180deg,#5d6552,#434a3c);display:flex;align-items:flex-start;justify-content:center}
.soldier-uniform-stage>img.uniform-base-image{width:100%;height:100%;max-width:none;max-height:none;object-fit:cover;object-position:50% 13%;transform:scale(1.42);transform-origin:50% 17%}
.soldier-home-ribbon-rack{left:66.5%;top:49.2%;transform:translateX(-50%)}
.soldier-home-ribbon-rack img{width:34px;height:11px;object-fit:contain}

.soldier-identity-card{position:relative;background:linear-gradient(180deg,#eee5cb,#d5c6a1);color:#292117;padding:34px 32px;display:flex;flex-direction:column}
.soldier-identity-card>small{font:700 10px 'Courier Prime',monospace;letter-spacing:.12em;color:#77572d;margin-top:5px}
.soldier-identity-card h2{font:700 clamp(34px,3vw,50px)/.98 'Stardos Stencil',serif;margin:12px 0 28px;color:#292117;padding-right:100px}
.soldier-id-stamp{position:absolute;top:26px;right:24px;border:3px double #7b3f2c;color:#7b3f2c;padding:7px 9px;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;transform:rotate(2deg)}
.soldier-identity-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(72,59,37,.4);border-left:1px solid rgba(72,59,37,.4)}
.soldier-identity-grid>div{padding:13px 12px;border-right:1px solid rgba(72,59,37,.4);border-bottom:1px solid rgba(72,59,37,.4);min-width:0}
.soldier-identity-grid span,.soldier-weapon-grid span{display:block;font:700 8px 'Courier Prime',monospace;letter-spacing:.09em;color:#76572d;margin-bottom:5px}
.soldier-identity-grid b,.soldier-weapon-grid b{display:block;font:700 13px/1.3 'Courier Prime',monospace;color:#282116;overflow-wrap:anywhere}
.soldier-tour-line{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0 0}
.soldier-tour-line span{padding:10px 8px;background:rgba(67,75,58,.12);border:1px solid rgba(72,59,37,.28);font:8px/1.3 'Courier Prime',monospace;color:#6c5837;text-align:center}
.soldier-tour-line b{display:block;margin-top:4px;font-size:11px;color:#282116}
.soldier-main-record-button{margin-top:auto;padding:15px 16px;background:#35402f;color:#f1e6ca;text-decoration:none;text-align:center;font:700 11px 'Courier Prime',monospace;letter-spacing:.07em;border:1px solid #1e281d}
.soldier-main-record-button:hover,.soldier-main-record-button:focus-visible{background:#46543e;outline:2px solid #a98638;outline-offset:2px}

.soldier-weapon-stage{position:relative;min-height:400px;display:flex;align-items:center;justify-content:center;padding:22px 14px 8px;background:linear-gradient(180deg,#4d5546,#394136);overflow:hidden}
.soldier-weapon-stage>img{position:relative;z-index:1;width:112%;max-width:none;height:390px;object-fit:contain;transform:rotate(-2deg);filter:drop-shadow(0 18px 15px rgba(0,0,0,.4))}
.soldier-weapon-stage .weapon-dirt-layer{z-index:2}
.soldier-weapon-condition{padding:10px 18px;text-align:center;font:700 11px 'Courier Prime',monospace;letter-spacing:.08em;border-top:1px solid rgba(51,42,27,.28);border-bottom:1px solid rgba(51,42,27,.28)}
.soldier-weapon-grid{display:grid;grid-template-columns:1fr 1fr;padding:14px 18px 18px;gap:8px}
.soldier-weapon-grid>div{padding:9px 8px;background:rgba(255,250,232,.22);border:1px solid rgba(72,59,37,.2)}
.soldier-no-issue{display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:40px;text-align:center;font-family:'Courier Prime',monospace}

.soldier-now-grid{width:min(1500px,calc(100% - 64px));margin:0 auto 34px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.soldier-now-card{min-height:215px;padding:24px 24px 20px;background:linear-gradient(180deg,#d8cba8,#c5b58c);color:#292117;border:1px solid #766641;box-shadow:0 12px 22px rgba(0,0,0,.22);display:flex;flex-direction:column}
.soldier-now-card>small{font:700 9px 'Courier Prime',monospace;letter-spacing:.1em;color:#7c5729}
.soldier-now-card h2{font:700 27px/1 'Stardos Stencil',serif;margin:9px 0;color:#292117}
.soldier-now-card>b{font:700 13px/1.4 'Courier Prime',monospace}
.soldier-now-card p{font:12px/1.55 'Courier Prime',monospace;margin:8px 0 14px}
.soldier-now-card>a,.soldier-now-card button{margin-top:auto;align-self:flex-start;border:0;background:transparent;color:#633f27;font:700 10px 'Courier Prime',monospace;text-decoration:none;cursor:pointer;padding:0;letter-spacing:.05em}
.soldier-now-card--action.needs-action{box-shadow:inset 5px 0 0 #7c3f2c,0 12px 22px rgba(0,0,0,.22)}
.soldier-now-card--action.clear{box-shadow:inset 5px 0 0 #4b613c,0 12px 22px rgba(0,0,0,.22)}

.soldier-record-links{padding:70px max(4vw,50px);background:#232b20;border-top:1px solid rgba(205,183,122,.15)}
.soldier-record-links>header{max-width:1450px;margin:0 auto 28px}
.soldier-record-links>header h2,.soldier-recent-service>header h2{font:700 clamp(34px,3.4vw,54px)/.98 'Stardos Stencil',serif;color:#eee2c4;margin:7px 0 10px}
.soldier-record-links>header p{font:13px/1.6 'Courier Prime',monospace;color:#bfb397;margin:0;max-width:800px}
.soldier-record-links__grid{max-width:1450px;margin:0 auto;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.soldier-record-links__grid a{min-height:128px;padding:18px 16px;background:linear-gradient(180deg,#d7c9a4,#c4b48a);border:1px solid #71603d;color:#292117;text-decoration:none;display:flex;flex-direction:column;gap:8px;box-shadow:0 8px 16px rgba(0,0,0,.18)}
.soldier-record-links__grid a:hover,.soldier-record-links__grid a:focus-visible{transform:translateY(-2px);outline:2px solid #ad8b3a;outline-offset:2px}
.soldier-record-links__grid b{font:700 19px 'Stardos Stencil',serif}
.soldier-record-links__grid span{font:10px/1.5 'Courier Prime',monospace;color:#4d412d}

.soldier-recent-service{padding:68px max(4vw,50px) 84px;background:#1b2119}
.soldier-recent-service>header,.soldier-recent-service__grid,.soldier-history-link{max-width:1450px;margin-left:auto;margin-right:auto}
.soldier-recent-service__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:24px}
.soldier-recent-service__grid article{padding:18px;background:#d5c7a3;color:#292117;border-left:4px solid #69542d;min-height:100px;display:flex;flex-direction:column;gap:6px}
.soldier-recent-service__grid time{font:700 9px 'Courier Prime',monospace;color:#76572d}
.soldier-recent-service__grid b{font:700 14px/1.25 'Courier Prime',monospace}
.soldier-recent-service__grid span{font:9px/1.4 'Courier Prime',monospace;color:#5c4a2f}
.soldier-history-link{display:block;margin-top:18px;color:#d1b15d;font:700 10px 'Courier Prime',monospace;text-decoration:none;letter-spacing:.06em}

@media(max-width:1220px){
  .soldier-inspection-deck{grid-template-columns:1fr 1fr}
  .soldier-identity-card{grid-column:1/-1;min-height:auto;order:-1}
  .soldier-focus-card{min-height:620px}
  .soldier-record-links__grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:820px){
  .soldier-command-hero__title,.soldier-inspection-deck,.soldier-now-grid{width:calc(100% - 32px)}
  .soldier-command-hero__title{padding-top:48px}
  .soldier-inspection-deck,.soldier-now-grid{grid-template-columns:1fr}
  .soldier-identity-card{grid-column:auto;order:0}
  .soldier-focus-card,.soldier-identity-card{min-height:auto}
  .soldier-uniform-stage{min-height:520px}
  .soldier-record-links,.soldier-recent-service{padding-left:16px;padding-right:16px}
  .soldier-record-links__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .soldier-recent-service__grid{grid-template-columns:1fr 1fr}
}
@media(max-width:560px){
  .soldier-command-hero{min-height:220px}
  .soldier-command-hero__title h1{font-size:52px}
  .soldier-identity-card{padding:26px 20px}
  .soldier-identity-card h2{font-size:34px;padding-right:0;margin-top:50px}
  .soldier-id-stamp{left:20px;right:auto;top:52px}
  .soldier-identity-grid,.soldier-tour-line,.soldier-record-links__grid,.soldier-recent-service__grid{grid-template-columns:1fr}
  .soldier-uniform-stage{min-height:450px}
  .soldier-weapon-stage{min-height:320px}
  .soldier-weapon-stage>img{height:300px}
  .soldier-record-links__grid a{min-height:95px}
}

/* ========================================================================
   MEMBER UNIT + NCO ROSTER LAYOUT FIX — 2026-08-21
   Purpose-built layouts; do not inherit generic staff workspace geometry.
   ======================================================================== */
.member-unit-shell{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:58px 0 82px;box-sizing:border-box}
.member-unit-heading{margin:0 0 22px;color:#eee3c7}
.member-unit-heading span{font:700 10px 'Courier Prime',monospace;letter-spacing:.12em;color:#d0aa3c}
.member-unit-heading h1{margin:5px 0 8px;font:700 clamp(38px,4.4vw,62px)/.95 'Stardos Stencil',serif;color:#f0e4c5}
.member-unit-heading p{margin:0;max-width:680px;font:13px/1.6 'Courier Prime',monospace;color:#c8bea5}
.member-unit-roster{width:100%;padding:28px 30px 32px;box-sizing:border-box;overflow:hidden}
.member-unit-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:22px 0;background:#9a8b6b;border:1px solid #8d7e60}
.member-unit-summary>div{min-width:0;padding:13px 14px;background:#d8ccb0}
.member-unit-summary small{display:block!important;margin-bottom:5px;font-size:9px!important;letter-spacing:.08em;color:#75664d!important}
.member-unit-summary b{display:block;font-size:13px;overflow-wrap:anywhere}
.member-unit-note{margin:0 0 16px!important;padding:10px 12px;background:rgba(105,89,58,.08);border-left:3px solid #8d7440;font-size:12px!important;line-height:1.55!important}
.member-unit-table{border:1px solid rgba(78,66,43,.32);background:rgba(255,255,255,.06)}
.member-unit-table__head,.member-unit-table__row{display:grid;grid-template-columns:minmax(220px,1.35fr) minmax(180px,1fr) minmax(130px,.72fr) minmax(130px,.72fr);gap:18px;align-items:center;padding:12px 16px}
.member-unit-table__head{background:#c9b98f;border-bottom:2px solid #62563e;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;color:#2b2419}
.member-unit-table__row{min-height:64px;border-bottom:1px dotted rgba(78,66,43,.38);font:12px/1.4 'Courier Prime',monospace;color:#292218}
.member-unit-table__row:last-child{border-bottom:0}
.member-unit-table__row>span{min-width:0;overflow-wrap:anywhere}
.member-unit-soldier b{font-size:13px;letter-spacing:.02em}

.page-my-soldiers .records-room-heading.my-soldiers-heading{margin-bottom:0}
.page-my-soldiers .my-soldiers-room{width:min(1500px,calc(100% - 30px));max-width:none;margin:0 auto 72px;padding:0;box-sizing:border-box}
.page-my-soldiers .leader-roster{width:100%;padding:18px 20px 22px;box-sizing:border-box;overflow:hidden}
.page-my-soldiers .leader-roster-head,.page-my-soldiers .leader-roster-row{display:grid;grid-template-columns:minmax(220px,1.35fr) minmax(190px,1.08fr) minmax(170px,1fr) minmax(205px,1.08fr) minmax(155px,.75fr);gap:18px;align-items:center}
.page-my-soldiers .leader-roster-head{padding:12px 14px;margin-top:14px;background:#c7b78f;border:1px solid rgba(66,55,35,.35);border-bottom:2px solid #554a35;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;color:#292218}
.page-my-soldiers .leader-soldier-file{padding:0 0 18px;margin:0 0 18px;border-bottom:2px solid rgba(72,61,40,.38)}
.page-my-soldiers .leader-soldier-file:last-child{margin-bottom:0}
.page-my-soldiers .leader-roster-row{min-height:92px;padding:15px 14px;border-bottom:1px solid rgba(66,55,35,.22)}
.page-my-soldiers .leader-cell{display:block;min-width:0;color:#292218}
.page-my-soldiers .leader-cell>b{display:block;font-size:13px;line-height:1.25;overflow-wrap:anywhere}
.page-my-soldiers .leader-cell>em{display:block;margin-top:6px;font:10px/1.4 'Courier Prime',monospace;color:#6b604d;font-style:normal;overflow-wrap:anywhere}
.page-my-soldiers .leader-mobile-label{display:none!important}
.page-my-soldiers .leader-cell--readiness>b{font-size:14px}
.page-my-soldiers .status-alert{color:#7a3127!important;font-weight:700!important}
.page-my-soldiers .leader-attention-strip{display:grid;grid-template-columns:minmax(180px,1fr) minmax(135px,.72fr) minmax(190px,1fr) minmax(170px,.78fr);gap:10px;padding:11px 14px;background:rgba(113,94,56,.08);border-bottom:1px solid rgba(66,55,35,.18)}
.page-my-soldiers .leader-attention-item{min-width:0;padding:8px 10px;border-left:3px solid #8c7440;background:rgba(225,214,187,.48)}
.page-my-soldiers .leader-attention-item small,.page-my-soldiers .leader-attention-item span,.page-my-soldiers .leader-attention-item b{display:block!important;min-width:0;overflow-wrap:anywhere}
.page-my-soldiers .leader-attention-item small{margin-bottom:4px;font:700 8px 'Courier Prime',monospace!important;letter-spacing:.08em;color:#76654a!important}
.page-my-soldiers .leader-attention-item span{font:10px/1.3 'Courier Prime',monospace;color:#393124}
.page-my-soldiers .leader-attention-item b{margin-top:3px;font-size:11px;line-height:1.25}
.page-my-soldiers .leader-open-file{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:10px 13px;background:#35402f;color:#f0e3be!important;text-decoration:none;border:1px solid #22291f;box-shadow:0 3px 0 rgba(0,0,0,.22)}
.page-my-soldiers .leader-open-file span,.page-my-soldiers .leader-open-file small{display:block!important;color:inherit!important}
.page-my-soldiers .leader-open-file span{font:700 11px 'Courier Prime',monospace;letter-spacing:.04em}
.page-my-soldiers .leader-open-file small{margin-top:3px;font:8px 'Courier Prime',monospace;opacity:.78}
.page-my-soldiers .leader-open-file:hover,.page-my-soldiers .leader-open-file:focus-visible{background:#46533e;outline:2px solid #b7943c;outline-offset:2px}
.page-my-soldiers .leader-promo-form{margin:12px 14px 0}

@media(max-width:1180px){
  .member-unit-summary{grid-template-columns:repeat(2,minmax(0,1fr))}
  .member-unit-table__head,.member-unit-table__row{grid-template-columns:minmax(200px,1.3fr) minmax(170px,1fr) minmax(115px,.7fr) minmax(115px,.7fr);gap:12px}
  .page-my-soldiers .leader-roster-head{display:none}
  .page-my-soldiers .leader-roster-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .page-my-soldiers .leader-mobile-label{display:block!important;margin-bottom:5px;font:700 8px 'Courier Prime',monospace!important;letter-spacing:.08em;color:#76654a!important}
  .page-my-soldiers .leader-attention-strip{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:760px){
  .member-unit-shell{width:calc(100% - 24px);padding:38px 0 58px}
  .member-unit-roster{padding:20px 14px 24px}
  .member-unit-summary{grid-template-columns:1fr 1fr}
  .member-unit-table__head{display:none}
  .member-unit-table__row{grid-template-columns:1fr 1fr;gap:9px 14px;padding:15px 12px}
  .member-unit-table__row>span:before{display:block;margin-bottom:3px;font:700 8px 'Courier Prime',monospace;letter-spacing:.08em;color:#78684f}
  .member-unit-table__row>span:nth-child(1):before{content:'SOLDIER'}
  .member-unit-table__row>span:nth-child(2):before{content:'DUTY POSITION'}
  .member-unit-table__row>span:nth-child(3):before{content:'PLATOON'}
  .member-unit-table__row>span:nth-child(4):before{content:'SQUAD'}
  .page-my-soldiers .my-soldiers-room{width:calc(100% - 20px)}
  .page-my-soldiers .leader-roster{padding:14px 10px 18px}
  .page-my-soldiers .leader-roster-row,.page-my-soldiers .leader-attention-strip{grid-template-columns:1fr}
  .page-my-soldiers .leader-roster-row{padding:13px 10px}
  .page-my-soldiers .leader-attention-strip{padding:10px}
  .page-my-soldiers .leader-promo-form{margin:10px 10px 0}
}
@media(max-width:470px){
  .member-unit-summary,.member-unit-table__row{grid-template-columns:1fr}
}

/* === MEMBER HOME UNIFORM PREVIEW RIBBON PLACEMENT FIX 2026-08-21 ===
   Preview only. Do NOT alter .uniform-ribbon-rack--file; the issued service
   uniform panel placement is intentionally preserved. */
.member-record-redesign .soldier-focus-card--uniform .soldier-home-ribbon-rack{
  left:64% !important;
  top:33% !important;
  transform:translateX(-50%) !important;
  align-items:flex-start !important;
}
@media(max-width:900px){
  .member-record-redesign .soldier-focus-card--uniform .soldier-home-ribbon-rack{
    left:64% !important;
    top:33% !important;
  }
}
@media(max-width:700px){
  .member-record-redesign .soldier-focus-card--uniform .soldier-home-ribbon-rack{
    left:64% !important;
    top:33% !important;
  }
}

/* ========================================================================
   CAV65 PUBLIC HOME — FULL VISUAL RECRUITING OVERHAUL • 2026-08-21
   1965 U.S. Army / 1st Cavalry Division (Airmobile) field-headquarters theme.
   ======================================================================== */
.cav65-home{background:#11170f;color:#eee3c8;overflow-x:hidden}
.cav65-home main{background:#11170f}
.cav65-home .battalion-footer{border-top:1px solid rgba(208,183,103,.24)}
.cav65-home *{box-sizing:border-box}
.cav65-home a{-webkit-tap-highlight-color:transparent}

.cav65-float-cta{position:fixed;right:18px;bottom:18px;z-index:150;display:flex;align-items:center;gap:13px;padding:12px 15px;background:#d7bd64;color:#171810;border:1px solid #f0da8d;text-decoration:none;box-shadow:0 12px 35px rgba(0,0,0,.45),inset 0 0 0 1px rgba(74,53,12,.28);transition:transform .18s ease,box-shadow .18s ease,background .18s ease}
.cav65-float-cta span{font:700 8px 'Courier Prime',monospace;letter-spacing:.11em;opacity:.72}.cav65-float-cta b{font:700 11px 'Stardos Stencil',serif;letter-spacing:.04em}.cav65-float-cta:hover,.cav65-float-cta:focus-visible{transform:translateY(-3px);background:#ebd17a;box-shadow:0 17px 40px rgba(0,0,0,.52);outline:2px solid #efe0a6;outline-offset:2px}

.cav65-hero{position:relative;min-height:920px;overflow:hidden;border-bottom:1px solid rgba(218,191,103,.44);background:#0b100a}
.cav65-hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%;filter:saturate(.66) contrast(1.08) brightness(.61)}
.cav65-hero__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,7,4,.97) 0%,rgba(6,9,5,.89) 31%,rgba(8,11,7,.50) 61%,rgba(4,7,4,.77) 100%),linear-gradient(0deg,rgba(5,8,5,.90) 0%,transparent 48%,rgba(4,6,4,.40) 100%)}
.cav65-hero__grain,.cav65-hq:after,.cav65-operation:after,.cav65-final:after{content:"";position:absolute;inset:0;pointer-events:none;opacity:.15;background-image:repeating-radial-gradient(circle at 20% 30%,rgba(255,255,255,.13) 0 1px,transparent 1px 3px);mix-blend-mode:soft-light}
.cav65-hero__inner{position:relative;z-index:3;width:min(1600px,calc(100% - 72px));min-height:900px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(390px,.65fr);gap:54px;align-items:center;padding:66px 0 78px}
.cav65-hero__copy{max-width:900px}.cav65-kicker{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:22px;font:700 9px 'Courier Prime',monospace;letter-spacing:.12em;color:#d6c187}.cav65-kicker b{padding:5px 8px;border:1px solid rgba(222,194,103,.55);color:#f0d66f}.cav65-mark{width:116px;height:116px;object-fit:contain;filter:drop-shadow(0 9px 12px rgba(0,0,0,.5));margin-bottom:14px}.cav65-field-order{margin:0 0 10px;font:700 10px 'Courier Prime',monospace;letter-spacing:.12em;color:#d2aa38}.cav65-hero h1{margin:0;font:700 clamp(66px,7.3vw,126px)/.82 'Stardos Stencil',serif;letter-spacing:-.035em;color:#f2e7cb;text-shadow:0 8px 28px rgba(0,0,0,.7)}.cav65-hero h1 em{font-style:normal;color:#d8b842}.cav65-lead{max-width:780px;margin:28px 0 30px;font:15px/1.72 'Courier Prime',monospace;color:#d8cfb8;text-shadow:0 2px 6px rgba(0,0,0,.68)}
.cav65-hero__actions,.cav65-final__actions{display:flex;gap:12px;flex-wrap:wrap}.cav65-action{position:relative;min-width:270px;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;column-gap:16px;padding:15px 17px 14px;text-decoration:none;border:1px solid;box-shadow:0 8px 0 rgba(0,0,0,.25),0 14px 30px rgba(0,0,0,.24);transition:transform .16s ease,box-shadow .16s ease,filter .16s ease}.cav65-action small{grid-column:1;font:700 8px 'Courier Prime',monospace;letter-spacing:.1em;opacity:.72}.cav65-action strong{grid-column:1;font:700 14px 'Stardos Stencil',serif;letter-spacing:.03em;margin-top:3px}.cav65-action i{grid-column:2;grid-row:1/3;align-self:center;font:normal 22px 'Courier Prime',monospace;transition:transform .16s ease}.cav65-action:hover,.cav65-action:focus-visible{transform:translateY(-3px);box-shadow:0 11px 0 rgba(0,0,0,.24),0 19px 34px rgba(0,0,0,.32);outline:2px solid rgba(246,226,160,.7);outline-offset:3px}.cav65-action:hover i,.cav65-action:focus-visible i{transform:translateX(5px)}.cav65-action:active{transform:translateY(3px);box-shadow:0 3px 0 rgba(0,0,0,.30)}.cav65-action--primary{background:#d7bd64;color:#171810;border-color:#eed789}.cav65-action--secondary{background:rgba(24,31,22,.91);color:#efe3c4;border-color:#86764b}.cav65-action--light{background:#e1d1a8;color:#211c13;border-color:#f0dfb6}.cav65-action--inline{display:inline-grid;margin-top:24px}
.cav65-hero__proof{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin-top:36px;border:1px solid rgba(211,186,102,.28);background:rgba(211,186,102,.22);max-width:760px}.cav65-hero__proof span{padding:11px 12px;background:rgba(10,14,9,.78);font:700 8px/1.35 'Courier Prime',monospace;letter-spacing:.07em;color:#bfb59c}.cav65-hero__proof b{display:block;margin-bottom:2px;font:700 17px 'Stardos Stencil',serif;color:#e5ca70}

.cav65-access{align-self:center;justify-self:end;width:min(430px,100%);position:relative}.cav65-access__tag{display:flex;justify-content:space-between;align-items:end;padding:0 7px 8px;border-bottom:1px solid rgba(214,190,110,.4);margin-bottom:12px;color:#d7c18a}.cav65-access__tag span{font:700 8px 'Courier Prime',monospace;letter-spacing:.1em}.cav65-access__tag b{font:700 11px 'Stardos Stencil',serif}.cav65-clipboard{position:relative;width:100%;aspect-ratio:955/1448;filter:drop-shadow(0 24px 32px rgba(0,0,0,.60))}.cav65-clipboard>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none}.cav65-clipboard__form{position:absolute;left:16%;right:16%;top:24.4%;bottom:11.5%;color:#292218;z-index:3}.cav65-clipboard__form header{text-align:center;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid rgba(75,63,43,.68)}.cav65-clipboard__form header small{font:700 8px 'Courier Prime',monospace;color:#725a2e}.cav65-clipboard__form h2{margin:2px 0;font:700 20px 'Stardos Stencil',serif;color:#292116}.cav65-clipboard__form form{display:grid;gap:7px}.cav65-clipboard__form label{font:700 9px 'Courier Prime',monospace;color:#342b1e}.cav65-clipboard__form input{width:100%;border:1px solid rgba(86,72,48,.72);background:rgba(247,239,215,.82);padding:11px 12px;font:13px 'Courier Prime',monospace;color:#251f16}.cav65-clipboard__form input:focus{outline:3px solid rgba(169,132,43,.42);outline-offset:1px;background:#fff7df}.cav65-clipboard__form button{margin-top:8px;border:1px solid #151910;background:#34402d;color:#f0e3c4;padding:13px 10px;font:700 11px 'Courier Prime',monospace;letter-spacing:.04em;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.28);transition:transform .15s ease,background .15s ease}.cav65-clipboard__form button:hover,.cav65-clipboard__form button:focus-visible{background:#48583d;transform:translateY(-2px);outline:2px solid #b9953c;outline-offset:2px}.cav65-clipboard__form button:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.3)}.cav65-staff-button{display:grid;grid-template-columns:1fr auto;gap:4px 14px;align-items:center;margin:12px 15px 0;padding:13px 15px;background:rgba(16,22,14,.94);border:1px solid #806c35;color:#eee0b8;text-decoration:none;box-shadow:0 8px 18px rgba(0,0,0,.32);transition:background .16s ease,transform .16s ease}.cav65-staff-button span{font:700 7px 'Courier Prime',monospace;letter-spacing:.08em;color:#c6a443}.cav65-staff-button b{font:700 13px 'Stardos Stencil',serif}.cav65-staff-button i{grid-column:2;grid-row:1/3;font:normal 20px 'Courier Prime',monospace}.cav65-staff-button:hover,.cav65-staff-button:focus-visible{background:#263121;transform:translateY(-2px);outline:2px solid #b99238;outline-offset:2px}
.cav65-scroll-cue{position:absolute;z-index:4;bottom:18px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12px;font:700 8px 'Courier Prime',monospace;letter-spacing:.13em;color:rgba(235,222,187,.62)}.cav65-scroll-cue i{font-style:normal;font-size:18px;animation:cav65Bounce 1.8s ease-in-out infinite}@keyframes cav65Bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}

.cav65-wire{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;padding:12px max(4vw,52px);background:#d0bd87;color:#292217;border-bottom:2px solid #685833;box-shadow:0 8px 18px rgba(0,0,0,.22);position:relative;z-index:4}.cav65-wire>b{white-space:nowrap;font:700 11px 'Stardos Stencil',serif;color:#703f2e}.cav65-wire>div{display:flex;gap:28px;white-space:nowrap;overflow:hidden;font:11px 'Courier Prime',monospace}.cav65-wire span{display:flex;gap:8px}.cav65-wire i{font-style:normal;font-weight:700;color:#725923}

.cav65-hq{position:relative;min-height:760px;overflow:hidden;background:#12180f}.cav65-hq__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.68) brightness(.52) contrast(1.06)}.cav65-hq__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,11,7,.94),rgba(9,13,8,.68) 52%,rgba(8,11,7,.42)),linear-gradient(0deg,rgba(8,12,7,.87),transparent 58%)}.cav65-hq__panel{position:relative;z-index:2;width:min(760px,calc(100% - 72px));margin-left:max(5vw,58px);padding:110px 0 100px}.cav65-hq__panel>small,.cav65-operation__intro>small,.cav65-honors__copy>small,.cav65-final__inner>small{font:700 9px 'Courier Prime',monospace;letter-spacing:.12em;color:#d3af48}.cav65-hq__panel h2,.cav65-operation h2,.cav65-honors h2,.cav65-final h2{font:700 clamp(46px,5vw,82px)/.94 'Stardos Stencil',serif;color:#f0e4c6;margin:11px 0 20px;text-shadow:0 5px 20px rgba(0,0,0,.55)}.cav65-hq__panel p,.cav65-operation__intro p,.cav65-honors__copy p,.cav65-final__inner p{font:14px/1.72 'Courier Prime',monospace;color:#d0c6aa;max-width:720px}.cav65-route{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:28px}.cav65-route span{display:flex;align-items:center;gap:8px;padding:10px 11px;background:rgba(214,196,149,.91);border:1px solid #85734b;color:#282117;font:700 9px 'Courier Prime',monospace;box-shadow:0 4px 10px rgba(0,0,0,.22)}.cav65-route span b{color:#794329}.cav65-route i{font-style:normal;color:#d6b44b;font-size:15px}

.cav65-system{padding:92px max(4vw,52px) 110px;background:linear-gradient(180deg,#1b2318,#131a12)}.cav65-section-head{max-width:1220px;margin:0 auto 38px}.cav65-section-head>span{font:700 9px 'Courier Prime',monospace;letter-spacing:.13em;color:#d3ae43}.cav65-section-head h2{margin:9px 0 12px;font:700 clamp(42px,4.7vw,74px)/.94 'Stardos Stencil',serif;color:#f0e4c6}.cav65-section-head p{font:14px/1.65 'Courier Prime',monospace;color:#c8bea4;max-width:760px}.cav65-system-grid{max-width:1500px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.cav65-system-card{position:relative;min-height:610px;overflow:hidden;border:1px solid rgba(201,177,102,.33);background:#1a2117;box-shadow:0 22px 42px rgba(0,0,0,.29);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.cav65-system-card:hover{transform:translateY(-7px);border-color:rgba(229,199,99,.78);box-shadow:0 30px 52px rgba(0,0,0,.40)}.cav65-system-card__art{height:335px;display:flex;align-items:center;justify-content:center;padding:18px;background:radial-gradient(circle at 50% 45%,rgba(85,96,72,.38),transparent 66%)}.cav65-system-card__art img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 16px 18px rgba(0,0,0,.36));transition:transform .25s ease}.cav65-system-card:hover .cav65-system-card__art img{transform:scale(1.035)}.cav65-system-card__copy{padding:28px 29px 32px;border-top:1px solid rgba(201,177,102,.25);background:linear-gradient(180deg,rgba(30,38,27,.98),rgba(19,25,18,.98))}.cav65-system-card__copy small{font:700 8px 'Courier Prime',monospace;letter-spacing:.11em;color:#d0a841}.cav65-system-card__copy h3{font:700 clamp(28px,2.3vw,39px)/1 'Stardos Stencil',serif;color:#f0e4c5;margin:8px 0 12px}.cav65-system-card__copy p{font:12px/1.62 'Courier Prime',monospace;color:#c7bda2;min-height:78px}.cav65-system-card__copy a{display:inline-flex;gap:9px;align-items:center;margin-top:11px;padding:10px 0;color:#d7b649;text-decoration:none;border-bottom:1px solid rgba(215,182,73,.4);font:700 9px 'Courier Prime',monospace;letter-spacing:.06em}.cav65-system-card__copy a b{transition:transform .16s ease}.cav65-system-card__copy a:hover b{transform:translateX(5px)}

.cav65-operation{position:relative;min-height:820px;overflow:hidden;background:#10150e}.cav65-operation__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%;filter:saturate(.58) brightness(.44) contrast(1.11)}.cav65-operation__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,7,4,.91),rgba(6,8,5,.60) 52%,rgba(4,6,4,.82)),linear-gradient(0deg,rgba(4,7,4,.92),transparent 48%,rgba(4,6,4,.42))}.cav65-operation__inner{position:relative;z-index:2;width:min(1500px,calc(100% - 80px));margin:0 auto;padding:100px 0}.cav65-operation__intro{max-width:820px}.cav65-op-timeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:44px 0 12px}.cav65-op-timeline article{min-height:210px;padding:23px 21px;background:rgba(222,208,169,.94);border:1px solid #8b7750;color:#292217;box-shadow:0 13px 25px rgba(0,0,0,.30);position:relative;transition:transform .18s ease}.cav65-op-timeline article:hover{transform:translateY(-5px)}.cav65-op-timeline time{display:inline-block;padding:5px 7px;background:#5b3a2e;color:#f1dec0;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em}.cav65-op-timeline h3{font:700 25px 'Stardos Stencil',serif;margin:12px 0 9px}.cav65-op-timeline p{font:11px/1.6 'Courier Prime',monospace;color:#332b1f}

.cav65-live{padding:92px max(4vw,52px) 110px;background:#d6caaa;color:#292217;border-top:6px solid #746034;border-bottom:6px solid #746034;box-shadow:inset 0 0 70px rgba(66,52,24,.13)}.cav65-section-head--dark>span{color:#784634}.cav65-section-head--dark h2{color:#2a2318;text-shadow:none}.cav65-section-head--dark p{color:#5c5343}.cav65-live-grid{max-width:1450px;margin:0 auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.cav65-live-grid article{min-height:155px;padding:23px;background:#ece2c8;border:1px solid #8d7b55;box-shadow:0 7px 0 rgba(80,64,34,.14);display:flex;flex-direction:column;justify-content:center;position:relative}.cav65-live-grid article:before{content:"FILED";position:absolute;right:13px;top:12px;border:1px solid rgba(124,63,45,.45);color:#7a4534;padding:3px 5px;font:700 7px 'Courier Prime',monospace;transform:rotate(-3deg)}.cav65-live-grid small{font:700 8px 'Courier Prime',monospace;letter-spacing:.1em;color:#77572c}.cav65-live-grid strong{font:700 clamp(26px,2.6vw,43px) 'Stardos Stencil',serif;margin:9px 0 5px;color:#2b2419}.cav65-live-grid span{font:10px/1.5 'Courier Prime',monospace;color:#5b5140}.cav65-live-grid__wide{grid-column:span 1}

.cav65-honors{max-width:1500px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.78fr);gap:52px;align-items:center;padding:96px max(4vw,52px);background:#141b12}.cav65-honors__copy{min-width:0}.cav65-ribbons{display:grid;grid-template-columns:repeat(3,150px);gap:8px;margin:27px 0 20px}.cav65-ribbons img{width:150px;height:45px;object-fit:contain;filter:drop-shadow(0 5px 6px rgba(0,0,0,.32))}.cav65-ribbons span{font:11px 'Courier Prime',monospace;color:#c8bea4}.cav65-text-link{display:inline-block;padding-bottom:5px;border-bottom:1px solid #b99438;color:#d6b649;text-decoration:none;font:700 9px 'Courier Prime',monospace;letter-spacing:.07em}.cav65-honors__art{width:100%;max-height:520px;object-fit:contain;filter:drop-shadow(0 22px 24px rgba(0,0,0,.42))}

.cav65-final{position:relative;min-height:720px;overflow:hidden;background:#0b1009}.cav65-final__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 46%;filter:saturate(.55) brightness(.39) contrast(1.09)}.cav65-final__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,7,4,.95),rgba(5,8,4,.68) 57%,rgba(4,7,4,.54)),linear-gradient(0deg,rgba(4,7,4,.88),transparent 50%)}.cav65-final__inner{position:relative;z-index:2;width:min(1040px,calc(100% - 72px));margin:0 auto;padding:108px 0 120px;text-align:center}.cav65-final h2{font-size:clamp(60px,7vw,112px);line-height:.83;margin:14px 0 24px}.cav65-final__inner p{margin:0 auto 34px;max-width:760px;font-size:15px}.cav65-final__actions{justify-content:center}.cav65-final__actions .cav65-action{text-align:left}

@media(max-width:1280px){
  .cav65-hero{min-height:1160px}.cav65-hero__inner{min-height:1120px;grid-template-columns:1fr;padding-top:55px;align-items:start}.cav65-hero__copy{max-width:950px}.cav65-access{justify-self:center;width:410px}.cav65-mark{width:96px;height:96px}.cav65-system-grid{grid-template-columns:1fr}.cav65-system-card{min-height:0;display:grid;grid-template-columns:minmax(300px,.82fr) minmax(0,1fr)}.cav65-system-card__art{height:360px}.cav65-system-card__copy{border-top:0;border-left:1px solid rgba(201,177,102,.25);display:flex;flex-direction:column;justify-content:center}.cav65-op-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}.cav65-live-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cav65-honors{grid-template-columns:1fr}.cav65-honors__art{max-width:760px;margin:0 auto}
}
@media(max-width:760px){
  .cav65-float-cta{left:12px;right:12px;bottom:12px;justify-content:center}.cav65-hero{min-height:1220px}.cav65-hero__inner{width:calc(100% - 32px);min-height:1180px;gap:30px;padding:38px 0 76px}.cav65-kicker{gap:7px}.cav65-mark{width:76px;height:76px}.cav65-hero h1{font-size:clamp(51px,16vw,74px)}.cav65-lead{font-size:12px;line-height:1.65}.cav65-hero__actions,.cav65-final__actions{display:grid}.cav65-action{min-width:0;width:100%}.cav65-hero__proof{grid-template-columns:1fr 1fr}.cav65-access{width:min(390px,100%)}.cav65-access__tag{display:none}.cav65-staff-button{margin-left:8px;margin-right:8px}.cav65-scroll-cue{display:none}.cav65-wire{grid-template-columns:1fr;padding:11px 16px}.cav65-wire>div{overflow-x:auto}.cav65-hq__panel{width:calc(100% - 34px);margin-left:17px;padding:75px 0}.cav65-hq__panel h2,.cav65-operation h2,.cav65-honors h2{font-size:clamp(38px,12vw,58px)}.cav65-route i{display:none}.cav65-route span{flex:1 1 42%;justify-content:center}.cav65-system,.cav65-live{padding:68px 17px 78px}.cav65-section-head h2{font-size:clamp(38px,11vw,56px)}.cav65-system-card{display:block}.cav65-system-card__art{height:290px}.cav65-system-card__copy{border-left:0;border-top:1px solid rgba(201,177,102,.25);padding:24px 20px}.cav65-system-card__copy p{min-height:0}.cav65-operation{min-height:980px}.cav65-operation__inner{width:calc(100% - 34px);padding:74px 0}.cav65-op-timeline{grid-template-columns:1fr}.cav65-op-timeline article{min-height:0}.cav65-live-grid{grid-template-columns:1fr}.cav65-honors{padding:72px 17px;gap:28px}.cav65-ribbons{grid-template-columns:repeat(2,minmax(0,150px))}.cav65-final{min-height:720px}.cav65-final__inner{width:calc(100% - 34px);padding:95px 0 120px}.cav65-final h2{font-size:clamp(52px,15vw,76px)}
}
@media(prefers-reduced-motion:reduce){.cav65-scroll-cue i{animation:none}.cav65-action,.cav65-system-card,.cav65-system-card__art img,.cav65-op-timeline article,.cav65-float-cta{transition:none}}
.cav65-action.is-pressed,.cav65-staff-button.is-pressed,.cav65-float-cta.is-pressed{transform:translateY(3px)!important;filter:brightness(.94)}

/* === MOCKUP-TARGET HOMEPAGE OVERHAUL 2026-08-21 === */
.cav65-showcase .public-hq-header,.cav65-showcase .public-hq-footer{display:none!important}
.cav65-showcase main{background:#0e130d;padding:0!important}
.cav65-showcase-shell{width:100%;max-width:1760px;margin:0 auto;background:#0e130d;color:#eadfbe;border-left:1px solid rgba(195,163,77,.18);border-right:1px solid rgba(195,163,77,.18);box-shadow:0 0 70px rgba(0,0,0,.45)}
.cav65-showcase-nav{min-height:112px;display:grid;grid-template-columns:360px 1fr 165px;gap:24px;align-items:center;padding:14px 28px;background:linear-gradient(180deg,#0a0f09,#10160f);border-bottom:1px solid rgba(197,161,65,.32);position:relative;z-index:20}
.cav65-showcase-brand{display:flex;align-items:center;gap:15px;text-decoration:none;color:#e7dcc0}.cav65-showcase-brand img{width:78px;height:78px;object-fit:contain;filter:drop-shadow(0 5px 8px rgba(0,0,0,.45))}.cav65-showcase-brand span{display:grid;line-height:1}.cav65-showcase-brand small{font:700 10px 'Courier Prime',monospace;letter-spacing:.14em;color:#c9a447}.cav65-showcase-brand strong{font:700 26px/.9 'Stardos Stencil',serif;letter-spacing:.02em}.cav65-showcase-brand b{margin-top:6px;font:700 9px 'Courier Prime',monospace;letter-spacing:.13em;color:#bca771}
.cav65-showcase-nav>nav{display:flex;justify-content:center;align-items:center;gap:28px;flex-wrap:wrap}.cav65-showcase-nav>nav a{position:relative;color:#d5c9a8;text-decoration:none;font:700 10px 'Courier Prime',monospace;letter-spacing:.07em;padding:11px 0}.cav65-showcase-nav>nav a:after{content:"";position:absolute;left:0;right:100%;bottom:2px;height:2px;background:#cfaa3e;transition:right .18s ease}.cav65-showcase-nav>nav a:hover:after,.cav65-showcase-nav>nav a:focus-visible:after,.cav65-showcase-nav>nav a.is-current:after{right:0}.cav65-showcase-nav>nav a:focus-visible{outline:1px solid #d8bd67;outline-offset:5px}
.cav65-showcase-radio{justify-self:end;display:flex;align-items:center;gap:11px;color:#d6c48c}.cav65-showcase-radio>span{font-size:31px}.cav65-showcase-radio div{display:grid}.cav65-showcase-radio small,.cav65-showcase-radio em{font:700 8px 'Courier Prime',monospace;letter-spacing:.08em}.cav65-showcase-radio b{font:700 14px 'Courier Prime',monospace}.cav65-showcase-radio em{font-style:normal;color:#9e947c}
.cav65-showcase-hero{position:relative;min-height:640px;overflow:hidden;background:#11160f}.cav65-showcase-hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 50%;filter:saturate(.72) contrast(1.08) brightness(.68)}.cav65-showcase-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,9,6,.96) 0%,rgba(8,11,7,.83) 31%,rgba(8,10,7,.26) 59%,rgba(5,8,5,.42) 74%,rgba(5,7,5,.85) 100%),linear-gradient(0deg,rgba(7,9,6,.88),transparent 42%,rgba(5,7,5,.35))}
.cav65-showcase-hero__copy{position:relative;z-index:3;width:min(820px,55%);padding:74px 0 76px 42px}.cav65-showcase-hero__copy>small{font:700 11px 'Courier Prime',monospace;letter-spacing:.12em;color:#caa339}.cav65-showcase-hero h1{margin:10px 0 8px;font:700 clamp(58px,6.4vw,100px)/.88 'Stardos Stencil',serif;color:#eee2c4;text-shadow:0 5px 18px #000;letter-spacing:-.02em}.cav65-showcase-hero h2{margin:0 0 12px;font:700 16px 'Courier Prime',monospace;letter-spacing:.05em;color:#d4aa36}.cav65-showcase-hero__copy p{max-width:600px;margin:0 0 22px;font:14px/1.55 'Courier Prime',monospace;color:#d1c8b0;text-shadow:0 2px 4px #000}
.cav65-showcase-actions{display:flex;gap:11px;flex-wrap:wrap}.cav65-showcase-button{min-width:255px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 17px;text-decoration:none;color:#e5d9b7;border:1px solid #786942;background:rgba(18,25,17,.9);font:700 12px 'Stardos Stencil',serif;box-shadow:0 5px 0 rgba(0,0,0,.30),0 12px 22px rgba(0,0,0,.25);transition:transform .16s ease,background .16s ease,box-shadow .16s ease}.cav65-showcase-button span{font:18px 'Courier Prime',monospace}.cav65-showcase-button--gold{background:#d8b33f;color:#20180c;border-color:#efd573}.cav65-showcase-button:hover,.cav65-showcase-button:focus-visible{transform:translateY(-3px);box-shadow:0 8px 0 rgba(0,0,0,.28),0 18px 28px rgba(0,0,0,.32);outline:2px solid #e2c76e;outline-offset:2px}.cav65-showcase-button:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(0,0,0,.28)}
.cav65-showcase-access{position:absolute;z-index:5;right:32px;top:28px;width:min(400px,29vw)}.cav65-showcase-clipboard{position:relative;width:100%;aspect-ratio:955/1448;filter:drop-shadow(0 22px 28px rgba(0,0,0,.56))}.cav65-showcase-clipboard>img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none}.cav65-showcase-clipboard__form{position:absolute;left:16%;right:16%;top:23.5%;z-index:4;color:#2c2418}.cav65-showcase-clipboard__form header{text-align:center;border-bottom:1px solid rgba(74,60,40,.68);padding-bottom:9px;margin-bottom:12px}.cav65-showcase-clipboard__form header small{display:block;font:700 17px 'Stardos Stencil',serif;color:#2b2418}.cav65-showcase-clipboard__form header span{display:block;font:700 8px 'Courier Prime',monospace;letter-spacing:.09em;margin-top:3px}.cav65-showcase-clipboard__form form{display:grid;gap:8px}.cav65-showcase-clipboard__form label{font:700 8px 'Courier Prime',monospace}.cav65-showcase-clipboard__form input{width:100%;padding:11px;border:1px solid #786b4d;background:rgba(246,237,213,.77);font:12px 'Courier Prime',monospace;color:#2d2519}.cav65-showcase-clipboard__form input:focus{outline:3px solid rgba(173,132,31,.36);background:#fff6dc}.cav65-showcase-clipboard__form button{display:flex;justify-content:center;gap:18px;margin-top:6px;padding:12px;border:1px solid #1d2418;background:#35412d;color:#f0e3c3;font:700 10px 'Courier Prime',monospace;letter-spacing:.05em;cursor:pointer;box-shadow:0 4px 0 rgba(0,0,0,.25)}.cav65-showcase-clipboard__form button:hover,.cav65-showcase-clipboard__form button:focus-visible{background:#495b3c;outline:2px solid #af8a31;outline-offset:2px}
.cav65-showcase-staff{margin:-12px 8px 0;display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:13px 14px;background:rgba(17,22,15,.96);border:1px solid #715e2c;box-shadow:0 8px 18px rgba(0,0,0,.35)}.cav65-showcase-staff div{display:grid}.cav65-showcase-staff small{font:700 7px 'Courier Prime',monospace;letter-spacing:.08em;color:#c6a33a}.cav65-showcase-staff strong{font:700 18px 'Stardos Stencil',serif;color:#eadcb4}.cav65-showcase-staff span{font:8px 'Courier Prime',monospace;color:#b4a983}.cav65-showcase-staff a{padding:12px 16px;background:#d6c69f;color:#2a2217;text-decoration:none;border:1px solid #8a7646;font:700 9px 'Courier Prime',monospace;white-space:nowrap;box-shadow:0 3px 0 rgba(0,0,0,.25)}.cav65-showcase-staff a:hover,.cav65-showcase-staff a:focus-visible{background:#ead9ae;outline:2px solid #b28a2f;outline-offset:2px}
.cav65-showcase-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;padding:10px 35px;background:#0c110b}.cav65-showcase-card{min-height:220px;display:grid;grid-template-columns:minmax(0,.9fr) minmax(190px,1.1fr);background:#171d15;border:1px solid #6f6039;box-shadow:inset 0 0 0 1px rgba(214,191,124,.04),0 8px 18px rgba(0,0,0,.24);overflow:hidden}.cav65-showcase-card__copy{padding:15px 0 14px 15px;display:flex;flex-direction:column;align-items:flex-start;position:relative;z-index:2}.cav65-showcase-card__copy small{font:700 15px 'Stardos Stencil',serif;color:#e5d8b5}.cav65-showcase-card__copy>b{margin:2px 0 10px;font:700 8px 'Courier Prime',monospace;letter-spacing:.05em;color:#c7aa55}.cav65-showcase-card__copy p{margin:0 0 13px;font:10px/1.5 'Courier Prime',monospace;color:#cfc3a7}.cav65-showcase-card__copy a,.cav65-showcase-wide-button{margin-top:auto;display:flex;justify-content:space-between;gap:15px;padding:8px 11px;border:1px solid #7e6c3b;color:#e4d4a8;text-decoration:none;font:700 8px 'Courier Prime',monospace;letter-spacing:.04em;background:#151c13}.cav65-showcase-card__copy a:hover,.cav65-showcase-card__copy a:focus-visible,.cav65-showcase-wide-button:hover,.cav65-showcase-wide-button:focus-visible{background:#2a3524;outline:1px solid #b99741;outline-offset:1px}.cav65-showcase-card>img{align-self:stretch;width:100%;height:100%;object-fit:contain;object-position:center;background:transparent;filter:drop-shadow(0 10px 14px rgba(0,0,0,.4))}
.cav65-showcase-lower{display:grid;grid-template-columns:1.6fr 1fr .72fr;gap:9px;padding:0 35px 10px;background:#0c110b}.cav65-showcase-night,.cav65-showcase-sitboard,.cav65-showcase-honors{border:1px solid #6d5d37;background:#131912;padding:11px;box-shadow:0 8px 18px rgba(0,0,0,.24)}.cav65-showcase-night>header,.cav65-showcase-sitboard>header,.cav65-showcase-honors>header{display:grid;border-bottom:1px solid rgba(191,159,77,.3);padding-bottom:7px;margin-bottom:9px}.cav65-showcase-night>header small,.cav65-showcase-sitboard>header small,.cav65-showcase-honors>header small{font:700 15px 'Stardos Stencil',serif;color:#e2d4b0}.cav65-showcase-night>header span,.cav65-showcase-sitboard>header span,.cav65-showcase-honors>header span{font:700 8px 'Courier Prime',monospace;color:#b89a43}
.cav65-showcase-timeline{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr;gap:7px;align-items:stretch}.cav65-showcase-timeline>div{min-width:0;border:1px solid rgba(125,106,61,.55);background:#10160f;display:flex;flex-direction:column}.cav65-showcase-timeline img{width:100%;aspect-ratio:1.45/1;object-fit:cover;filter:saturate(.75) brightness(.76)}.cav65-showcase-timeline b{padding:7px 7px 0;font:700 10px 'Stardos Stencil',serif;color:#cfaa3e}.cav65-showcase-timeline p{padding:4px 7px 8px;margin:0;font:8px/1.35 'Courier Prime',monospace;color:#bdb39c}.cav65-showcase-timeline>i{align-self:center;font-style:normal;color:#c6a33a;font:18px 'Courier Prime',monospace}
.cav65-showcase-night>.cav65-showcase-wide-button,.cav65-showcase-sitboard>.cav65-showcase-wide-button,.cav65-showcase-honors>.cav65-showcase-wide-button{margin-top:9px;justify-content:center;gap:20px}
.cav65-showcase-sitrow{display:flex;justify-content:space-between;gap:12px;padding:7px 1px;border-bottom:1px solid rgba(126,108,64,.28);font:8px 'Courier Prime',monospace;color:#c9bea3}.cav65-showcase-sitrow b{font-size:9px;color:#e2d2a8}.cav65-showcase-map{position:relative;margin-top:9px;min-height:116px;overflow:hidden;border:1px solid rgba(121,104,62,.52)}.cav65-showcase-map img{width:100%;height:116px;object-fit:cover;filter:saturate(.45) sepia(.25) brightness(.55)}.cav65-showcase-map span{position:absolute;left:9px;bottom:8px;padding:5px 6px;background:rgba(227,213,177,.9);color:#34271b;font:700 8px/1.35 'Courier Prime',monospace;transform:rotate(-2deg)}
.cav65-showcase-honors-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.cav65-showcase-honors-grid>div{min-height:74px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:1px solid rgba(122,104,60,.42);padding:5px}.cav65-showcase-honors-grid img{max-width:56px;max-height:32px;object-fit:contain}.cav65-showcase-honors-grid b{margin-top:5px;font:700 7px/1.25 'Courier Prime',monospace;color:#d4c5a0}.cav65-medal-placeholder{font-size:25px;color:#b78f2d}
.cav65-showcase-enlist{position:relative;min-height:90px;margin:0 35px 10px;display:grid;grid-template-columns:180px 1.25fr 330px 280px;gap:18px;align-items:center;overflow:hidden;border:1px solid #75643a;background:linear-gradient(90deg,#caba92 0%,#d9ccaa 58%,#8e846d 100%);color:#282117}.cav65-showcase-enlist__photo,.cav65-showcase-enlist__air{height:90px;overflow:hidden}.cav65-showcase-enlist__photo img,.cav65-showcase-enlist__air img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(.98);mix-blend-mode:multiply;opacity:.78}.cav65-showcase-enlist>div:nth-child(2){padding:10px 0}.cav65-showcase-enlist small{font:700 20px 'Stardos Stencil',serif}.cav65-showcase-enlist p{margin:4px 0 0;font:9px/1.4 'Courier Prime',monospace}.cav65-showcase-enlist>a{display:flex;justify-content:space-between;align-items:center;padding:13px 17px;background:#4a512f;color:#efe2bd;border:1px solid #6b7148;text-decoration:none;font:700 12px 'Stardos Stencil',serif;box-shadow:0 4px 0 rgba(0,0,0,.25)}.cav65-showcase-enlist>a:hover,.cav65-showcase-enlist>a:focus-visible{background:#5d673a;outline:2px solid #866f31;outline-offset:2px}
.cav65-showcase-footer{display:grid;grid-template-columns:1fr 1.2fr 1fr;align-items:center;gap:20px;padding:14px 38px 17px;background:#090d08;border-top:1px solid rgba(191,158,76,.28);color:#ad9f79}.cav65-showcase-footer>div{display:flex;align-items:center;gap:10px}.cav65-showcase-footer img{width:33px;height:33px;object-fit:contain}.cav65-showcase-footer span{display:grid}.cav65-showcase-footer b{font:700 9px 'Courier Prime',monospace}.cav65-showcase-footer small{font:7px 'Courier Prime',monospace;letter-spacing:.08em}.cav65-showcase-footer blockquote{margin:0;text-align:center;font:700 13px 'Courier Prime',monospace;letter-spacing:.18em;color:#7d7358}.cav65-showcase-footer nav{display:flex;justify-content:flex-end;gap:20px}.cav65-showcase-footer nav a{font:700 8px 'Courier Prime',monospace;color:#aa9b74;text-decoration:none}.cav65-showcase-footer nav a:hover{color:#e2cb84}
@media(max-width:1320px){.cav65-showcase-nav{grid-template-columns:300px 1fr}.cav65-showcase-radio{display:none}.cav65-showcase-nav>nav{gap:18px}.cav65-showcase-access{width:370px}.cav65-showcase-hero__copy{width:58%;padding-left:30px}.cav65-showcase-pillars{grid-template-columns:1fr}.cav65-showcase-card{min-height:180px;grid-template-columns:1fr 300px}.cav65-showcase-lower{grid-template-columns:1fr 1fr}.cav65-showcase-honors{grid-column:1/-1}.cav65-showcase-enlist{grid-template-columns:150px 1fr 280px}.cav65-showcase-enlist__air{display:none}}
@media(max-width:980px){.cav65-showcase-nav{grid-template-columns:1fr;padding:12px 20px}.cav65-showcase-brand{justify-content:center}.cav65-showcase-nav>nav{justify-content:center}.cav65-showcase-hero{min-height:1080px}.cav65-showcase-hero__copy{width:100%;padding:50px 24px 0;text-align:center}.cav65-showcase-hero__copy p{margin-left:auto;margin-right:auto}.cav65-showcase-actions{justify-content:center}.cav65-showcase-access{top:490px;left:50%;right:auto;transform:translateX(-50%);width:min(410px,90vw)}.cav65-showcase-pillars,.cav65-showcase-lower{padding-left:18px;padding-right:18px}.cav65-showcase-lower{grid-template-columns:1fr}.cav65-showcase-timeline{grid-template-columns:1fr}.cav65-showcase-timeline>i{transform:rotate(90deg);justify-self:center}.cav65-showcase-enlist{margin-left:18px;margin-right:18px;grid-template-columns:100px 1fr}.cav65-showcase-enlist>a{grid-column:1/-1;margin:0 12px 12px}.cav65-showcase-footer{grid-template-columns:1fr;text-align:center}.cav65-showcase-footer>div,.cav65-showcase-footer nav{justify-content:center}}
@media(max-width:620px){.cav65-showcase-nav>nav{display:none}.cav65-showcase-brand strong{font-size:22px}.cav65-showcase-hero{min-height:1030px}.cav65-showcase-hero h1{font-size:clamp(48px,15vw,70px)}.cav65-showcase-hero__copy{padding-top:38px}.cav65-showcase-button{min-width:100%}.cav65-showcase-access{top:430px;width:min(375px,96vw)}.cav65-showcase-staff{grid-template-columns:1fr}.cav65-showcase-staff a{text-align:center}.cav65-showcase-card{grid-template-columns:1fr}.cav65-showcase-card>img{height:180px}.cav65-showcase-enlist{grid-template-columns:1fr;text-align:center}.cav65-showcase-enlist__photo{display:none}.cav65-showcase-enlist small{font-size:17px}.cav65-showcase-footer blockquote{font-size:10px}}

/* === MOBILE-ONLY HOMEPAGE UX PASS 2026-08-21 ===
   Intentionally scoped to phones. Desktop/tablet layout above 620px is unchanged. */
@media (max-width:620px){
  .cav65-home,
  .cav65-showcase,
  .cav65-showcase main,
  .cav65-showcase-shell{overflow-x:hidden!important}

  /* Remove legacy/floating recruiting controls that can cover the clipboard on phones. */
  .cav65-showcase .public-report-tab,
  .cav65-showcase .cav65-float-cta{display:none!important}

  /* Compact mobile masthead. */
  .cav65-showcase-nav{
    min-height:0!important;
    display:block!important;
    padding:10px 14px!important;
    border-bottom:1px solid rgba(197,161,65,.34)!important;
  }
  .cav65-showcase-brand{
    justify-content:flex-start!important;
    gap:10px!important;
    width:100%!important;
  }
  .cav65-showcase-brand img{
    width:46px!important;
    height:46px!important;
    flex:0 0 46px!important;
  }
  .cav65-showcase-brand span{min-width:0!important}
  .cav65-showcase-brand small{font-size:7px!important;letter-spacing:.11em!important}
  .cav65-showcase-brand strong{font-size:17px!important;line-height:.92!important}
  .cav65-showcase-brand b{margin-top:4px!important;font-size:6.5px!important;letter-spacing:.09em!important}
  .cav65-showcase-nav>nav,.cav65-showcase-radio{display:none!important}

  /* Hero becomes normal vertical flow instead of layered desktop positioning. */
  .cav65-showcase-hero{
    min-height:0!important;
    overflow:visible!important;
    padding:0 0 26px!important;
    background:#11160f!important;
  }
  .cav65-showcase-hero__bg{
    height:520px!important;
    object-position:62% 50%!important;
    opacity:.72!important;
  }
  .cav65-showcase-hero__shade{
    height:520px!important;
    background:linear-gradient(180deg,rgba(6,9,6,.52),rgba(6,9,6,.84) 64%,#11160f 100%),linear-gradient(90deg,rgba(6,9,6,.87),rgba(6,9,6,.18) 78%)!important;
  }
  .cav65-showcase-hero__copy{
    width:auto!important;
    padding:34px 18px 0!important;
    text-align:left!important;
  }
  .cav65-showcase-hero__copy>small{
    display:block!important;
    max-width:280px!important;
    font-size:8px!important;
    line-height:1.45!important;
    letter-spacing:.09em!important;
  }
  .cav65-showcase-hero h1{
    max-width:340px!important;
    margin:9px 0 10px!important;
    font-size:clamp(43px,13.4vw,58px)!important;
    line-height:.9!important;
    letter-spacing:-.018em!important;
  }
  .cav65-showcase-hero h2{
    max-width:330px!important;
    margin-bottom:10px!important;
    font-size:12px!important;
    line-height:1.35!important;
  }
  .cav65-showcase-hero__copy p{
    max-width:340px!important;
    margin:0 0 17px!important;
    font-size:11.5px!important;
    line-height:1.55!important;
  }
  .cav65-showcase-actions{
    display:grid!important;
    grid-template-columns:1fr!important;
    gap:9px!important;
    width:100%!important;
    max-width:340px!important;
    margin:0!important;
  }
  .cav65-showcase-button{
    min-width:0!important;
    width:100%!important;
    box-sizing:border-box!important;
    padding:13px 14px!important;
    font-size:10px!important;
  }

  /* Clipboard gets its own block below the hero copy. No overlap with headline or CTA. */
  .cav65-showcase-access{
    position:relative!important;
    top:auto!important;
    left:auto!important;
    right:auto!important;
    transform:none!important;
    width:min(332px,calc(100vw - 28px))!important;
    margin:24px auto 0!important;
    z-index:6!important;
  }
  .cav65-showcase-clipboard{
    width:100%!important;
    aspect-ratio:955/1448!important;
    filter:drop-shadow(0 15px 20px rgba(0,0,0,.42))!important;
  }
  .cav65-showcase-clipboard__form{
    left:16.5%!important;
    right:16.5%!important;
    top:24%!important;
  }
  .cav65-showcase-clipboard__form header{
    margin-bottom:9px!important;
    padding-bottom:7px!important;
  }
  .cav65-showcase-clipboard__form header small{font-size:14px!important}
  .cav65-showcase-clipboard__form header span{font-size:6.5px!important}
  .cav65-showcase-clipboard__form form{gap:6px!important}
  .cav65-showcase-clipboard__form label{font-size:7px!important}
  .cav65-showcase-clipboard__form input{
    box-sizing:border-box!important;
    padding:9px 10px!important;
    font-size:10.5px!important;
  }
  .cav65-showcase-clipboard__form button{
    width:100%!important;
    box-sizing:border-box!important;
    margin-top:5px!important;
    padding:10px 8px!important;
    font-size:8.5px!important;
  }
  .cav65-showcase-staff{
    margin:-8px 5px 0!important;
    grid-template-columns:1fr!important;
    gap:8px!important;
    padding:11px 12px!important;
  }
  .cav65-showcase-staff small{font-size:6.5px!important}
  .cav65-showcase-staff strong{font-size:15px!important}
  .cav65-showcase-staff span{font-size:7px!important}
  .cav65-showcase-staff a{
    width:100%!important;
    box-sizing:border-box!important;
    padding:10px 12px!important;
    text-align:center!important;
    font-size:8px!important;
  }

  /* Main cards become clean image/text modules instead of cramped desktop cards. */
  .cav65-showcase-pillars{
    grid-template-columns:1fr!important;
    gap:12px!important;
    padding:18px 14px!important;
  }
  .cav65-showcase-card{
    min-height:0!important;
    grid-template-columns:1fr!important;
  }
  .cav65-showcase-card__copy{
    order:2!important;
    padding:17px 16px 16px!important;
  }
  .cav65-showcase-card__copy small{font-size:16px!important}
  .cav65-showcase-card__copy>b{font-size:8px!important}
  .cav65-showcase-card__copy p{font-size:10.5px!important;line-height:1.55!important}
  .cav65-showcase-card>img{
    order:1!important;
    width:100%!important;
    height:190px!important;
    object-fit:contain!important;
    padding:10px!important;
    box-sizing:border-box!important;
  }
  .cav65-showcase-card__copy a,.cav65-showcase-wide-button{
    width:100%!important;
    box-sizing:border-box!important;
    padding:10px 11px!important;
    font-size:8.5px!important;
  }

  /* Lower content is single-column and comfortably spaced. */
  .cav65-showcase-lower{
    grid-template-columns:1fr!important;
    gap:12px!important;
    padding:0 14px 16px!important;
  }
  .cav65-showcase-night,.cav65-showcase-sitboard,.cav65-showcase-honors{padding:14px!important}
  .cav65-showcase-night>header small,.cav65-showcase-sitboard>header small,.cav65-showcase-honors>header small{font-size:16px!important}
  .cav65-showcase-timeline{grid-template-columns:1fr!important;gap:8px!important}
  .cav65-showcase-timeline>i{display:none!important}
  .cav65-showcase-timeline>div{display:grid!important;grid-template-columns:118px 1fr!important;grid-template-rows:auto 1fr!important}
  .cav65-showcase-timeline img{grid-row:1/3!important;width:118px!important;height:88px!important;aspect-ratio:auto!important;object-fit:cover!important}
  .cav65-showcase-timeline b{font-size:10px!important;padding:9px 9px 0!important}
  .cav65-showcase-timeline p{font-size:8.5px!important;padding:4px 9px 9px!important}
  .cav65-showcase-sitrow{font-size:8.5px!important;padding:8px 1px!important}
  .cav65-showcase-sitrow b{font-size:9px!important}
  .cav65-showcase-honors-grid{grid-template-columns:repeat(2,1fr)!important;gap:8px!important}

  /* Enlistment/footer: no squeezed multi-column content. */
  .cav65-showcase-enlist{
    min-height:0!important;
    margin:0 14px 14px!important;
    grid-template-columns:1fr!important;
    gap:0!important;
    text-align:left!important;
    padding:0!important;
  }
  .cav65-showcase-enlist__photo,.cav65-showcase-enlist__air{display:none!important}
  .cav65-showcase-enlist>div:nth-child(2){padding:18px 16px 13px!important}
  .cav65-showcase-enlist small{font-size:18px!important;line-height:1.08!important}
  .cav65-showcase-enlist p{font-size:9.5px!important;line-height:1.5!important}
  .cav65-showcase-enlist>a{
    grid-column:auto!important;
    margin:0 16px 16px!important;
    padding:13px 15px!important;
    font-size:11px!important;
  }
  .cav65-showcase-footer{
    grid-template-columns:1fr!important;
    gap:12px!important;
    padding:20px 16px 26px!important;
    text-align:center!important;
  }
  .cav65-showcase-footer>div,.cav65-showcase-footer nav{justify-content:center!important}
  .cav65-showcase-footer blockquote{font-size:9px!important;letter-spacing:.11em!important}
  .cav65-showcase-footer nav{gap:16px!important;flex-wrap:wrap!important}
}

/* Recruiting automation pipeline status */
.recruit-pipeline-case small{display:block;margin-top:5px;line-height:1.55}
.recruit-pipeline-case .pipeline-error{margin:6px 0 0;padding:7px 9px;border-left:3px solid #7c3026;background:rgba(124,48,38,.08);font:11px/1.45 'Courier Prime',monospace;color:#6a2d25}

/* ========================================================================
   MEMBER WALL LOCKER — immersive member landing page
   ======================================================================== */
.member-wall-locker-page{background:#181f18;color:#efe3c4}
.member-wall-locker-page .logged-back-wrap{display:none}
.wall-locker-hero{position:relative;background:linear-gradient(180deg,rgba(10,12,10,.88),rgba(11,15,11,.7)),url('/static/art/hq-field-desk.webp') center 45%/cover no-repeat;border-bottom:1px solid rgba(205,183,122,.2)}
.wall-locker-hero__inner{width:min(1420px,calc(100% - 60px));margin:0 auto;padding:60px 0 44px}
.wall-locker-hero__inner small,.wall-locker-brief__header small,.wall-locker-object__label small,.wall-locker-action-card>small{font:700 10px 'Courier Prime',monospace;letter-spacing:.12em;color:#cca84b}
.wall-locker-hero__inner h1{margin:8px 0 14px;font:700 clamp(54px,6vw,92px)/.9 'Stardos Stencil',serif;color:#f0e5c9;text-shadow:0 6px 16px rgba(0,0,0,.55)}
.wall-locker-hero__inner p{margin:0;max-width:880px;font:14px/1.65 'Courier Prime',monospace;color:#ddd0b0}

.wall-locker-shell{width:min(1500px,calc(100% - 50px));margin:28px auto 34px;display:grid;grid-template-columns:minmax(300px,.78fr) minmax(0,1.22fr);gap:20px;align-items:start}
.wall-locker-brief{background:linear-gradient(180deg,#e8ddbf,#d0c19a);border:1px solid #786947;box-shadow:0 18px 32px rgba(0,0,0,.28);color:#2b2419;padding:22px 22px 20px;position:sticky;top:88px}
.wall-locker-brief__header{position:relative;padding-right:110px}
.wall-locker-brief__header h2{margin:10px 0 18px;font:700 clamp(30px,2.7vw,44px)/1 'Stardos Stencil',serif;color:#2c251a}
.wall-locker-status-stamp{position:absolute;top:6px;right:0;border:3px double #7b3f2c;color:#7b3f2c;padding:7px 9px;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;transform:rotate(2deg)}
.wall-locker-brief__grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(72,59,37,.38);border-left:1px solid rgba(72,59,37,.38)}
.wall-locker-brief__grid>div{padding:11px 10px;border-right:1px solid rgba(72,59,37,.38);border-bottom:1px solid rgba(72,59,37,.38);min-width:0}
.wall-locker-brief__grid span,.wall-locker-brief__notes small,.wall-locker-object__meta em{display:block;font:700 8px 'Courier Prime',monospace;letter-spacing:.08em;color:#7a5b31;margin-bottom:5px}
.wall-locker-brief__grid b,.wall-locker-brief__notes b,.wall-locker-object__meta strong{display:block;font:700 12px/1.35 'Courier Prime',monospace;color:#2b2419;overflow-wrap:anywhere}
.wall-locker-brief__notes{display:grid;gap:12px;margin-top:18px}
.wall-locker-brief__notes article{padding:12px;background:rgba(64,56,37,.08);border-left:3px solid #8f733f}
.wall-locker-brief__notes span{display:block;font:11px/1.45 'Courier Prime',monospace;color:#423627}
.wall-locker-brief__notes em{display:block;margin-top:6px;font:9px/1.4 'Courier Prime',monospace;color:#6f5a39}

.wall-locker-stage{position:relative;min-height:980px;background:linear-gradient(180deg,#5a4a31,#463821 22%,#3a2e1c 22.2%,#3b2f1d 100%);border:10px solid #2b2216;border-radius:16px;box-shadow:0 28px 50px rgba(0,0,0,.35), inset 0 0 0 2px rgba(209,184,125,.08);padding:26px;overflow:hidden}
.wall-locker-stage__frame,.wall-locker-stage__rail,.wall-locker-stage__shelf,.wall-locker-stage__lower{position:absolute;pointer-events:none}
.wall-locker-stage__frame{inset:18px;border:2px solid rgba(216,189,126,.16);border-radius:8px}
.wall-locker-stage__rail{left:34px;right:34px;top:102px;height:8px;background:linear-gradient(180deg,#8b7347,#5d4a2c);box-shadow:0 2px 0 rgba(0,0,0,.25)}
.wall-locker-stage__shelf{left:52%;right:34px;top:270px;height:11px;background:linear-gradient(180deg,#775f37,#533f24);box-shadow:0 3px 0 rgba(0,0,0,.32)}
.wall-locker-stage__lower{left:34px;right:34px;bottom:182px;height:11px;background:linear-gradient(180deg,#775f37,#533f24);box-shadow:0 3px 0 rgba(0,0,0,.32)}

.wall-locker-object{position:absolute;display:block;text-decoration:none;color:inherit;transition:transform .16s ease,filter .16s ease;z-index:1}
.wall-locker-object:hover,.wall-locker-object:focus-visible{transform:translateY(-4px) scale(1.01);filter:drop-shadow(0 14px 18px rgba(0,0,0,.35));outline:none}
.wall-locker-object__label{position:absolute;left:0;top:-54px;padding:10px 12px 9px;background:rgba(233,223,193,.96);border:1px solid #7e6e49;box-shadow:0 8px 14px rgba(0,0,0,.18);min-width:210px}
.wall-locker-object__label b{display:block;font:700 18px 'Stardos Stencil',serif;color:#2d2418;margin:3px 0 2px}
.wall-locker-object__label span{display:block;font:700 9px 'Courier Prime',monospace;color:#72562d;letter-spacing:.05em}
.wall-locker-object__meta{margin-top:10px;padding:10px 12px;background:rgba(233,223,193,.94);border:1px solid #7e6e49;box-shadow:0 8px 14px rgba(0,0,0,.15)}
.wall-locker-object__meta strong{font-size:11px}

.wall-locker-object--uniform{left:34px;top:86px;width:33%;min-width:280px;max-width:380px}
.wall-locker-uniform-view{position:relative;height:520px;padding-top:18px;overflow:hidden}
.wall-locker-uniform-view .uniform-base-image{width:100%;height:100%;object-fit:contain;object-position:center top;filter:drop-shadow(0 18px 18px rgba(0,0,0,.35))}
.wall-locker-ribbon-rack{left:64% !important;top:33% !important;transform:translateX(-50%) !important;align-items:flex-start !important}
.wall-locker-ribbon-rack img{width:34px;height:11px;object-fit:contain}

.wall-locker-object--weapon{left:37%;top:154px;width:60%;max-width:720px}
.wall-locker-weapon-view{position:relative;height:210px;display:flex;align-items:center;justify-content:center}
.wall-locker-weapon-view img{width:100%;height:100%;object-fit:contain;transform:rotate(-2deg);filter:drop-shadow(0 18px 16px rgba(0,0,0,.42))}
.wall-locker-empty{padding:24px 18px;background:rgba(233,223,193,.94);border:1px solid #7e6e49;color:#2b2419;font:700 12px 'Courier Prime',monospace}

.wall-locker-object--helmet{right:34px;top:82px;width:240px}
.wall-locker-helmet-view{height:190px;display:flex;align-items:flex-end;justify-content:center}
.wall-locker-helmet-view img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 14px 14px rgba(0,0,0,.34))}

.wall-locker-object--journal{left:38px;bottom:236px;width:240px}
.wall-locker-journal-view{height:170px;display:flex;align-items:center;justify-content:center}
.wall-locker-journal-view img{width:100%;height:100%;object-fit:contain;transform:rotate(-8deg);filter:drop-shadow(0 10px 14px rgba(0,0,0,.3))}

.wall-locker-object--orders{right:64px;bottom:222px;width:235px}
.wall-locker-orders-view{height:160px;display:flex;align-items:center;justify-content:center}
.wall-locker-orders-view img{width:100%;height:100%;object-fit:contain;transform:rotate(7deg);filter:drop-shadow(0 10px 14px rgba(0,0,0,.3))}

.wall-locker-object--dogtags{left:40%;top:380px;width:235px}
.wall-locker-dogtags-view{position:relative;height:170px}
.wall-locker-dogtags-view:before,.wall-locker-dogtags-view:after{content:"";position:absolute;top:-16px;width:2px;height:26px;background:#bda977}
.wall-locker-dogtags-view:before{left:78px}.wall-locker-dogtags-view:after{left:137px}
.dogtag{position:absolute;left:30px;top:8px;width:102px;height:132px;border-radius:18px;background:linear-gradient(180deg,#c7c6bd,#9f9d95);border:1px solid #7c7a72;box-shadow:0 10px 16px rgba(0,0,0,.24);display:flex;flex-direction:column;justify-content:center;gap:6px;padding:14px 12px;transform:rotate(-6deg)}
.dogtag--offset{left:95px;top:24px;transform:rotate(8deg)}
.dogtag i{font:700 8px/1.2 'Courier Prime',monospace;color:#2f2d29;font-style:normal;letter-spacing:.04em}

.wall-locker-object--map{left:300px;bottom:218px;width:300px}
.wall-locker-map-view{height:180px;display:flex;align-items:center;justify-content:center}
.wall-locker-map-view img{width:100%;height:100%;object-fit:contain;transform:rotate(-2deg);filter:drop-shadow(0 10px 14px rgba(0,0,0,.3))}

.wall-locker-object--footlocker{right:325px;bottom:214px;width:290px}
.wall-locker-footlocker-view{position:relative;height:158px;margin-top:4px}
.footlocker-box{position:absolute;left:20px;right:20px;bottom:10px;height:98px;background:linear-gradient(180deg,#6a733f,#4a502c);border:3px solid #28301f;box-shadow:0 12px 18px rgba(0,0,0,.28)}
.footlocker-box:before,.footlocker-box:after{content:"";position:absolute;top:14px;bottom:14px;width:8px;background:#2d3522}
.footlocker-box:before{left:22px}.footlocker-box:after{right:22px}
.footlocker-lid{position:absolute;left:12px;right:12px;bottom:94px;height:36px;background:linear-gradient(180deg,#7f8b4e,#596236);border:3px solid #28301f;transform:perspective(240px) rotateX(24deg);transform-origin:bottom}

.wall-locker-action-grid{width:min(1500px,calc(100% - 50px));margin:0 auto 34px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.wall-locker-action-card{min-height:215px;padding:24px 24px 20px;background:linear-gradient(180deg,#d8cba8,#c5b58c);color:#292117;border:1px solid #766641;box-shadow:0 12px 22px rgba(0,0,0,.22);display:flex;flex-direction:column}
.wall-locker-action-card h2{font:700 27px/1 'Stardos Stencil',serif;margin:9px 0;color:#292117}
.wall-locker-action-card>b{font:700 13px/1.4 'Courier Prime',monospace}
.wall-locker-action-card p{font:12px/1.55 'Courier Prime',monospace;margin:8px 0 14px}
.wall-locker-action-card>a,.wall-locker-action-card button{margin-top:auto;align-self:flex-start;border:0;background:transparent;color:#633f27;font:700 10px 'Courier Prime',monospace;text-decoration:none;cursor:pointer;padding:0;letter-spacing:.05em}
.wall-locker-action-card.needs-action{box-shadow:inset 5px 0 0 #7c3f2c,0 12px 22px rgba(0,0,0,.22)}
.wall-locker-action-card.clear{box-shadow:inset 5px 0 0 #4b613c,0 12px 22px rgba(0,0,0,.22)}

@media(max-width:1320px){
  .wall-locker-shell{grid-template-columns:1fr}
  .wall-locker-brief{position:relative;top:auto}
  .wall-locker-stage{min-height:1120px}
  .wall-locker-object--uniform{width:32%}
  .wall-locker-object--weapon{left:36%;width:56%}
  .wall-locker-object--footlocker{right:40px}
  .wall-locker-action-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:1040px){
  .wall-locker-hero__inner,.wall-locker-shell,.wall-locker-action-grid{width:calc(100% - 28px)}
  .wall-locker-stage{min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:18px}
  .wall-locker-stage__frame,.wall-locker-stage__rail,.wall-locker-stage__shelf,.wall-locker-stage__lower{display:none}
  .wall-locker-object{position:relative;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;width:auto!important;max-width:none!important;min-width:0!important;transform:none!important}
  .wall-locker-object__label{position:relative;top:auto;left:auto;margin-bottom:10px;min-width:0}
  .wall-locker-uniform-view{height:420px}
  .wall-locker-weapon-view{height:170px}
  .wall-locker-helmet-view,.wall-locker-journal-view,.wall-locker-orders-view,.wall-locker-map-view{height:150px}
  .wall-locker-footlocker-view{height:140px}
}
@media(max-width:760px){
  .wall-locker-hero__inner h1{font-size:58px}
  .wall-locker-brief{padding:18px}
  .wall-locker-brief__header{padding-right:0}
  .wall-locker-status-stamp{position:relative;display:inline-block;top:auto;right:auto;margin-bottom:12px}
  .wall-locker-brief__grid,.wall-locker-action-grid,.wall-locker-stage,.soldier-record-links__grid,.soldier-recent-service__grid{grid-template-columns:1fr}
  .wall-locker-uniform-view{height:360px}
  .wall-locker-weapon-view{height:150px}
}

/* ===== MEMBER WALL LOCKER PHASE 2 ===== */
.wall-locker-object.wall-locker-modal-trigger{border:0;background:none;padding:0;text-align:left;cursor:pointer;font:inherit}
.wall-locker-indicator{position:absolute;right:10px;top:-18px;display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:#7b3f2c;color:#f2e7cd;font:700 9px 'Courier Prime',monospace;letter-spacing:.08em;box-shadow:0 8px 14px rgba(0,0,0,.22);animation:lockerPulse 2s ease-in-out infinite}
.wall-locker-indicator--journal{background:#57663b}
.wall-locker-indicator--alert{background:#8a2f23}
@keyframes lockerPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.wall-locker-object--dogtags .dogtag,.wall-locker-object--dogtags .dogtag--offset{animation:dogtagSwing 5.5s ease-in-out infinite;transform-origin:50% 0%}
.wall-locker-object--dogtags .dogtag--offset{animation-delay:.45s}
@keyframes dogtagSwing{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(-2deg)}}
.wall-locker-object--footlocker .footlocker-lid{transition:transform .18s ease}
.wall-locker-object--footlocker:hover .footlocker-lid,.wall-locker-object--footlocker:focus-visible .footlocker-lid{transform:perspective(240px) rotateX(36deg)}

body.locker-modal-open{overflow:hidden}
.wall-locker-modals{position:relative;z-index:50}
.locker-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:20px;z-index:250}
.locker-modal.is-open{display:flex}
.locker-modal__backdrop{position:absolute;inset:0;background:rgba(5,7,6,.68);backdrop-filter:blur(3px)}
.locker-modal__panel{position:relative;z-index:2;width:min(760px,100%);max-height:min(88vh,960px);overflow:auto;background:linear-gradient(180deg,#eadfc4,#d6c69e);color:#2d2519;border:1px solid #7d6d49;box-shadow:0 28px 50px rgba(0,0,0,.35);padding:24px 24px 22px}
.locker-modal__panel--wide{width:min(980px,100%)}
.locker-modal__close{position:absolute;top:10px;right:12px;border:0;background:none;color:#60432a;font:700 28px/1 'Courier Prime',monospace;cursor:pointer}
.locker-modal__panel small,.locker-modal__grid article small{font:700 10px 'Courier Prime',monospace;letter-spacing:.1em;color:#806338}
.locker-modal__panel h2{margin:6px 0 12px;font:700 clamp(30px,4vw,44px)/1 'Stardos Stencil',serif;color:#2b2419}
.locker-modal__intro{margin:0 0 18px;font:13px/1.6 'Courier Prime',monospace;color:#453829;max-width:880px}
.locker-modal__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.locker-modal__grid article,.locker-keepsakes-grid article,.locker-cards-stack article,.locker-journal-entries article{padding:14px;background:rgba(60,52,37,.08);border-left:4px solid #8f733f}
.locker-modal__grid b,.locker-keepsakes-grid b,.locker-cards-stack b,.locker-journal-entries b{display:block;margin:4px 0 6px;font:700 14px/1.3 'Courier Prime',monospace;color:#2d2519}
.locker-modal__grid span,.locker-keepsakes-grid span,.locker-cards-stack span,.locker-journal-entries span{display:block;font:12px/1.55 'Courier Prime',monospace;color:#3d3124}
.locker-modal__grid em{display:block;margin-top:6px;font:10px/1.4 'Courier Prime',monospace;color:#6e593a}
.locker-modal__actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
.locker-modal__actions a{display:inline-flex;align-items:center;justify-content:center;padding:11px 14px;border:1px solid #765f31;background:#2e3725;color:#f0e5c9;text-decoration:none;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;box-shadow:0 10px 18px rgba(0,0,0,.18)}
.locker-keepsakes-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.locker-cards-stack{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.locker-journal-entries{display:grid;gap:12px}
.locker-journal-entries article{border-left-width:3px}
.locker-journal-entries time{display:block;font:700 10px 'Courier Prime',monospace;color:#74592e;letter-spacing:.07em;margin-bottom:6px}

@media(max-width:1040px){
  .locker-modal__grid{grid-template-columns:1fr 1fr}
  .locker-keepsakes-grid{grid-template-columns:1fr 1fr}
  .locker-cards-stack{grid-template-columns:1fr}
}
@media(max-width:760px){
  .wall-locker-indicator{top:8px;right:8px}
  .locker-modal{padding:12px}
  .locker-modal__panel{padding:18px 16px 16px}
  .locker-modal__grid,.locker-keepsakes-grid{grid-template-columns:1fr}
  .locker-modal__actions{flex-direction:column}
  .locker-modal__actions a{width:100%}
}

/* ========================================================================
   WALL LOCKER DESKTOP COMPOSITION FIX — 2026-08-22
   Fixes overlap/crowding seen on wide desktop while leaving responsive/mobile
   behavior below 1320px intact.
   ======================================================================== */
@media (min-width:1321px){
  .wall-locker-hero__inner{
    width:min(1740px,calc(100% - 96px));
    padding:44px 0 34px;
  }
  .wall-locker-hero__inner h1{font-size:clamp(62px,5vw,88px)}
  .wall-locker-shell{
    width:min(1740px,calc(100% - 72px));
    grid-template-columns:minmax(470px,520px) minmax(900px,1fr);
    gap:28px;
    align-items:stretch;
    margin-top:28px;
  }
  .wall-locker-brief{
    position:relative;
    top:auto;
    min-height:840px;
    height:100%;
    box-sizing:border-box;
    display:flex;
    flex-direction:column;
    padding:28px 28px 26px;
  }
  .wall-locker-brief__header h2{font-size:42px;margin-top:12px}
  .wall-locker-brief__grid>div{padding:14px 12px}
  .wall-locker-brief__notes{
    flex:1;
    display:grid;
    grid-template-rows:repeat(3,1fr);
    gap:14px;
    margin-top:22px;
  }
  .wall-locker-brief__notes article{
    min-height:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:18px 16px;
  }
  .wall-locker-brief__notes b{font-size:13px}
  .wall-locker-brief__notes span{font-size:11px}

  .wall-locker-stage{
    min-height:840px;
    height:840px;
    box-sizing:border-box;
    padding:26px;
    border-width:9px;
    overflow:hidden;
  }
  .wall-locker-stage__rail{top:92px}
  .wall-locker-stage__shelf{left:35%;right:30px;top:315px}
  .wall-locker-stage__lower{left:30px;right:30px;bottom:220px}

  .wall-locker-object{
    z-index:2;
  }
  .wall-locker-object:hover,.wall-locker-object:focus-visible{
    z-index:9;
  }
  .wall-locker-object__label{
    top:-48px;
    min-width:0;
    width:max-content;
    max-width:220px;
    padding:8px 10px 7px;
  }
  .wall-locker-object__label b{font-size:15px}
  .wall-locker-object__label small{font-size:8px}
  .wall-locker-object__label span{font-size:8px}
  .wall-locker-object__meta{
    margin-top:6px;
    padding:8px 10px;
  }
  .wall-locker-object__meta strong{font-size:9px;line-height:1.28}
  .wall-locker-object__meta em{font-size:7px}

  /* Upper display: uniform / rifle / helmet, no collisions. */
  .wall-locker-object--uniform{
    left:32px;
    top:82px;
    width:29%;
    min-width:250px;
    max-width:315px;
  }
  .wall-locker-uniform-view{
    height:430px;
    padding-top:6px;
  }
  .wall-locker-object--uniform .wall-locker-object__label{left:4px}

  .wall-locker-object--weapon{
    left:34%;
    top:126px;
    width:40%;
    max-width:none;
  }
  .wall-locker-weapon-view{height:170px}
  .wall-locker-object--weapon .wall-locker-object__label{left:0}
  .wall-locker-object--weapon .wall-locker-object__meta{max-width:360px}

  .wall-locker-object--helmet{
    right:32px;
    top:78px;
    width:21%;
    max-width:225px;
  }
  .wall-locker-helmet-view{height:165px}
  .wall-locker-object--helmet .wall-locker-object__label{right:0;left:auto;text-align:left}

  /* Personal record hangs below the rifle instead of over it. */
  .wall-locker-object--dogtags{
    left:43%;
    top:355px;
    width:190px;
  }
  .wall-locker-dogtags-view{height:138px}
  .wall-locker-dogtags-view:before{left:62px}
  .wall-locker-dogtags-view:after{left:112px}
  .dogtag{left:18px;top:5px;width:88px;height:108px;padding:11px 9px}
  .dogtag--offset{left:74px;top:18px}
  .dogtag i{font-size:7px}
  .wall-locker-object--dogtags .wall-locker-object__label{left:-8px}

  /* Lower shelf: four distinct stations. */
  .wall-locker-object--journal{
    left:34px;
    bottom:72px;
    width:20%;
    max-width:210px;
  }
  .wall-locker-journal-view{height:128px}

  .wall-locker-object--map{
    left:25%;
    bottom:72px;
    width:24%;
    max-width:250px;
  }
  .wall-locker-map-view{height:126px}

  .wall-locker-object--footlocker{
    right:26%;
    bottom:68px;
    width:24%;
    max-width:245px;
  }
  .wall-locker-footlocker-view{height:126px}
  .footlocker-box{height:72px;bottom:8px}
  .footlocker-lid{bottom:72px;height:30px}

  .wall-locker-object--orders{
    right:34px;
    bottom:72px;
    width:20%;
    max-width:210px;
  }
  .wall-locker-orders-view{height:126px}

  .wall-locker-object--journal .wall-locker-object__label,
  .wall-locker-object--map .wall-locker-object__label,
  .wall-locker-object--footlocker .wall-locker-object__label,
  .wall-locker-object--orders .wall-locker-object__label{
    top:-45px;
  }

  .wall-locker-indicator{top:-12px;right:4px;font-size:7px;padding:5px 8px}

  .wall-locker-action-grid{
    width:min(1740px,calc(100% - 72px));
  }
}

/* ========================================================================
   WALL LOCKER DESKTOP GRID REBUILD — 2026-08-22
   Replaces floating/absolute desktop composition with fixed locker bays.
   ======================================================================== */
@media (min-width:1321px){
  .wall-locker-shell{
    width:min(1840px,calc(100% - 54px));
    grid-template-columns:410px minmax(0,1fr);
    gap:24px;
    align-items:stretch;
  }
  .wall-locker-brief{
    min-height:860px;
    padding:25px 24px 24px;
  }
  .wall-locker-brief__header h2{font-size:38px}
  .wall-locker-brief__notes article{padding:14px 14px}

  .wall-locker-stage{
    position:relative;
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    grid-template-rows:245px 245px 250px;
    gap:18px;
    height:auto;
    min-height:860px;
    padding:26px;
    box-sizing:border-box;
    overflow:hidden;
    align-content:start;
  }
  .wall-locker-stage__frame{inset:16px}
  .wall-locker-stage__rail,.wall-locker-stage__shelf,.wall-locker-stage__lower{display:none}

  .wall-locker-object,
  .wall-locker-object.wall-locker-modal-trigger{
    position:relative!important;
    left:auto!important;
    right:auto!important;
    top:auto!important;
    bottom:auto!important;
    width:auto!important;
    min-width:0!important;
    max-width:none!important;
    height:auto!important;
    transform:none!important;
    box-sizing:border-box;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    background:linear-gradient(180deg,rgba(31,26,17,.16),rgba(20,17,12,.28));
    border:1px solid rgba(214,190,133,.16);
    border-radius:3px;
    padding:10px;
  }
  .wall-locker-object:hover,.wall-locker-object:focus-visible{
    transform:translateY(-2px)!important;
    border-color:rgba(221,193,120,.5);
    background:linear-gradient(180deg,rgba(48,40,25,.2),rgba(25,21,14,.32));
    z-index:5;
  }
  .wall-locker-object__label{
    position:relative!important;
    inset:auto!important;
    top:auto!important;
    left:auto!important;
    right:auto!important;
    width:auto!important;
    max-width:none!important;
    min-width:0!important;
    order:0;
    padding:8px 10px 7px;
    margin:0 0 8px;
    background:rgba(234,223,191,.94);
    box-shadow:none;
  }
  .wall-locker-object__label small{font-size:7px}
  .wall-locker-object__label b{font-size:14px;line-height:1.05}
  .wall-locker-object__label span{font-size:7px}
  .wall-locker-object__meta{
    position:relative;
    order:3;
    margin:8px 0 0;
    padding:7px 9px;
    min-height:42px;
    background:rgba(234,223,191,.92);
    box-shadow:none;
  }
  .wall-locker-object__meta em{font-size:6.5px}
  .wall-locker-object__meta strong{font-size:8px;line-height:1.25}

  /* fixed locker bays */
  .wall-locker-object--uniform{grid-column:1 / span 4;grid-row:1 / span 2}
  .wall-locker-object--weapon{grid-column:5 / span 5;grid-row:1}
  .wall-locker-object--helmet{grid-column:10 / span 3;grid-row:1}
  .wall-locker-object--dogtags{grid-column:5 / span 5;grid-row:2}
  .wall-locker-object--journal{grid-column:1 / span 3;grid-row:3}
  .wall-locker-object--map{grid-column:4 / span 3;grid-row:3}
  .wall-locker-object--footlocker{grid-column:7 / span 3;grid-row:3}
  .wall-locker-object--orders{grid-column:10 / span 3;grid-row:3}

  .wall-locker-uniform-view{
    order:1;
    flex:1;
    height:auto;
    min-height:0;
    padding:0;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    overflow:hidden;
  }
  .wall-locker-uniform-view .uniform-base-image{
    width:100%;height:100%;object-fit:contain;object-position:center top;
    filter:drop-shadow(0 14px 14px rgba(0,0,0,.35));
  }
  .wall-locker-ribbon-rack{left:64%!important;top:33%!important}

  .wall-locker-weapon-view{
    order:1;
    flex:1;
    height:auto;
    min-height:0;
    padding:0 6px;
  }
  .wall-locker-weapon-view img{width:100%;height:100%;object-fit:contain}

  .wall-locker-helmet-view{
    order:1;
    flex:1;
    height:auto;
    min-height:0;
    align-items:center;
  }
  .wall-locker-helmet-view img{width:100%;height:100%;object-fit:contain}

  .wall-locker-dogtags-view{
    order:1;
    flex:1;
    height:auto;
    min-height:0;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:16px;
    padding:8px;
  }
  .wall-locker-dogtags-view:before,.wall-locker-dogtags-view:after{display:none}
  .wall-locker-dogtags-view .dogtag,
  .wall-locker-dogtags-view .dogtag--offset{
    position:relative!important;
    left:auto!important;top:auto!important;
    width:118px;height:150px;
    padding:14px 12px;
  }

  .wall-locker-journal-view,.wall-locker-map-view,.wall-locker-orders-view{
    order:1;
    flex:1;
    height:auto;
    min-height:0;
  }
  .wall-locker-journal-view img,.wall-locker-map-view img,.wall-locker-orders-view img{
    width:100%;height:100%;object-fit:contain;
  }
  .wall-locker-footlocker-view{
    order:1;
    flex:1;
    height:auto;
    min-height:115px;
    margin:0;
  }
  .footlocker-box{height:72px;bottom:5px}
  .footlocker-lid{height:28px;bottom:70px}

  .wall-locker-indicator{
    z-index:8;
    top:56px!important;
    right:14px!important;
    font-size:6.5px;
    padding:4px 7px;
  }

  .wall-locker-action-grid{
    width:min(1840px,calc(100% - 54px));
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}

/* ========================================================================
   WALL LOCKER DESKTOP STRUCTURE REPLACEMENT — 2026-08-22
   Dedicated desktop DOM: no floating object layout.
   ======================================================================== */
.wall-locker-desktop-stage{display:none}
@media (min-width:1321px){
  .wall-locker-shell{
    width:min(1900px,calc(100% - 48px));
    grid-template-columns:360px minmax(0,1fr);
    gap:22px;
    align-items:stretch;
  }
  .wall-locker-brief{min-height:940px;position:relative;top:auto}
  .wall-locker-stage{display:none!important}
  .wall-locker-desktop-stage{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    grid-template-rows:270px 255px 315px;
    gap:16px;
    min-height:940px;
    padding:18px;
    box-sizing:border-box;
    background:linear-gradient(180deg,#5b4930 0%,#46361f 17%,#382b1a 100%);
    border:10px solid #2a2115;
    border-radius:14px;
    box-shadow:0 28px 50px rgba(0,0,0,.34),inset 0 0 0 2px rgba(218,191,126,.1);
  }
  .locker-bay{
    min-width:0;
    min-height:0;
    display:grid;
    grid-template-rows:auto minmax(0,1fr) auto;
    border:1px solid rgba(221,194,128,.2);
    background:linear-gradient(180deg,rgba(30,25,17,.12),rgba(17,14,10,.28));
    overflow:hidden;
  }
  .locker-bay>header{
    display:grid;
    grid-template-columns:1fr auto;
    gap:2px 10px;
    align-items:end;
    padding:9px 11px 8px;
    background:#e7ddbe;
    color:#2e261a;
    border-bottom:1px solid #796a48;
  }
  .locker-bay>header small{grid-column:1/-1;font:700 7px 'Courier Prime',monospace;letter-spacing:.11em;color:#9a7628}
  .locker-bay>header b{font:700 15px/1.05 'Stardos Stencil',serif;color:#2b2419}
  .locker-bay>header a,.locker-bay>header button{border:0;background:none;padding:0;color:#6c5127;font:700 7px 'Courier Prime',monospace;letter-spacing:.06em;text-decoration:none;cursor:pointer;text-align:right}
  .locker-bay>footer{
    display:grid;
    grid-template-columns:auto minmax(0,1fr);
    gap:8px;
    align-items:center;
    padding:8px 10px;
    min-height:34px;
    background:#e7ddbe;
    color:#2d2519;
    border-top:1px solid #796a48;
    font-family:'Courier Prime',monospace;
  }
  .locker-bay>footer span{font-size:6.5px;letter-spacing:.07em;color:#85662f}
  .locker-bay>footer b{font-size:7.5px;line-height:1.25;text-align:right;overflow-wrap:anywhere}
  .locker-bay__visual{
    position:relative;
    min-height:0;
    min-width:0;
    display:flex;
    align-items:center;
    justify-content:center;
    border:0;
    background:transparent;
    padding:8px;
    cursor:pointer;
    text-decoration:none;
    color:#f1e5c5;
    overflow:hidden;
  }
  .locker-bay__visual img{display:block;max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 14px 14px rgba(0,0,0,.35))}
  .locker-bay__visual:hover,.locker-bay__visual:focus-visible{background:rgba(218,190,123,.05);outline:2px solid rgba(207,171,78,.45);outline-offset:-2px}

  .locker-bay--uniform{grid-column:1 / span 4;grid-row:1 / span 2}
  .locker-bay--weapon{grid-column:5 / span 5;grid-row:1}
  .locker-bay--helmet{grid-column:10 / span 3;grid-row:1}
  .locker-bay--identity{grid-column:5 / span 8;grid-row:2}
  .locker-bay--journal{grid-column:1 / span 3;grid-row:3}
  .locker-bay--training{grid-column:4 / span 3;grid-row:3}
  .locker-bay--footlocker{grid-column:7 / span 3;grid-row:3}
  .locker-bay--orders{grid-column:10 / span 3;grid-row:3}

  .locker-bay__visual--uniform{align-items:flex-start;padding:8px 12px 0}
  .locker-bay__visual--uniform>.uniform-base-image{width:100%;height:100%;object-fit:contain;object-position:center top}
  .locker-desktop-ribbon-rack{left:64%!important;top:33%!important;transform:translateX(-50%)!important}
  .locker-desktop-ribbon-rack img{width:32px;height:10px;object-fit:contain;filter:none}

  .locker-bay__visual--weapon{padding:16px 24px 8px}
  .locker-bay__visual--weapon img{width:100%;height:100%;object-fit:contain;transform:rotate(-1deg)}
  .locker-bay__visual--helmet{padding:4px 18px}
  .locker-bay__visual--helmet img{width:88%;height:88%;object-fit:contain}

  .locker-bay__visual--dogtags{gap:34px;background:radial-gradient(circle at 50% 30%,rgba(205,184,130,.08),transparent 55%)}
  .desktop-dogtag{width:118px;height:148px;box-sizing:border-box;border-radius:18px;background:linear-gradient(180deg,#c8c7be,#9e9c93);border:1px solid #77756d;box-shadow:0 12px 18px rgba(0,0,0,.28);display:flex;flex-direction:column;justify-content:center;gap:6px;padding:14px 12px;transform:rotate(-6deg);color:#2d2b27}
  .desktop-dogtag--second{transform:rotate(7deg)}
  .desktop-dogtag i{font:700 8px/1.2 'Courier Prime',monospace;font-style:normal;letter-spacing:.04em}

  .locker-bay__visual--small{padding:10px 14px}
  .locker-bay__visual--small img{width:92%;height:92%;object-fit:contain}
  .locker-bay__visual--footlocker{position:relative;padding:20px}
  .desktop-footlocker-box{position:absolute;left:14%;right:14%;bottom:18%;height:42%;background:linear-gradient(180deg,#6d773f,#4c532d);border:3px solid #28301f;box-shadow:0 12px 18px rgba(0,0,0,.26)}
  .desktop-footlocker-box:before,.desktop-footlocker-box:after{content:"";position:absolute;top:10px;bottom:10px;width:7px;background:#2d3522}
  .desktop-footlocker-box:before{left:18px}.desktop-footlocker-box:after{right:18px}
  .desktop-footlocker-lid{position:absolute;left:11%;right:11%;bottom:57%;height:18%;background:linear-gradient(180deg,#7d894b,#596235);border:3px solid #28301f;transform:perspective(260px) rotateX(22deg);transform-origin:bottom;transition:transform .18s ease}
  .locker-bay__visual--footlocker:hover .desktop-footlocker-lid{transform:perspective(260px) rotateX(42deg)}

  .wall-locker-action-grid{width:min(1900px,calc(100% - 48px))}
}

/* ========================================================================
   WALL LOCKER — CONSISTENT IN-PLACE DETAIL WINDOWS
   Uniform, M16, 201 File and every locker item opens here first.
   ======================================================================== */
.locker-modal__actions .locker-back-button{
  display:inline-flex;align-items:center;justify-content:center;padding:11px 14px;
  border:1px solid #765f31;background:#e4d7b6;color:#382d1e;
  font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;cursor:pointer;
  box-shadow:0 8px 14px rgba(0,0,0,.14)
}
.locker-modal__actions .locker-back-button:hover,.locker-modal__actions .locker-back-button:focus-visible{background:#f0e4c5;outline:2px solid #9a7a37;outline-offset:2px}
.locker-uniform-detail{display:grid;grid-template-columns:minmax(300px,.82fr) minmax(360px,1.18fr);gap:22px;align-items:start}
.locker-uniform-detail__display{min-width:0}
.locker-uniform-detail__stage{position:relative;height:570px;overflow:hidden;background:linear-gradient(180deg,#4d5546,#394136);border:1px solid #766641;display:flex;align-items:flex-start;justify-content:center}
.locker-uniform-detail__stage>.uniform-base-image{width:100%;height:100%;object-fit:contain;object-position:center top;filter:drop-shadow(0 18px 20px rgba(0,0,0,.34))}
.locker-modal-ribbon-rack{left:64%!important;top:33%!important;transform:translateX(-50%)!important;align-items:flex-start!important}
.locker-modal-ribbon-rack img{width:38px;height:12px;object-fit:contain;filter:none!important}
.locker-uniform-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid rgba(83,68,43,.32);border-top:0}
.locker-uniform-summary span{padding:10px 8px;border-right:1px solid rgba(83,68,43,.24);font:700 8px/1.35 'Courier Prime',monospace;color:#755b36;text-align:center}
.locker-uniform-summary span:last-child{border-right:0}
.locker-uniform-summary b{display:block;margin-top:4px;color:#2d2519;font-size:10px}
.locker-award-citations{display:grid;gap:10px;max-height:650px;overflow:auto;padding-right:4px}
.locker-award-citations>header{padding:10px 12px;background:rgba(60,52,37,.08);border-left:4px solid #8f733f}
.locker-award-citations>header small,.locker-award-citations>header b{display:block}
.locker-award-citations>header small{font:700 8px 'Courier Prime',monospace;color:#85652f;letter-spacing:.08em}
.locker-award-citations>header b{margin-top:3px;font:700 16px 'Stardos Stencil',serif;color:#2d2519}
.locker-award-citation{display:grid;grid-template-columns:92px minmax(0,1fr);gap:12px;padding:12px;background:rgba(60,52,37,.07);border:1px solid rgba(83,68,43,.2)}
.locker-award-citation>img{width:92px;height:28px;object-fit:contain;margin-top:3px}
.locker-award-citation>div>b{display:inline-block;font:700 13px/1.25 'Courier Prime',monospace;color:#2d2519;margin-right:8px}
.locker-award-wear{display:inline-block;padding:3px 6px;font:700 7px 'Courier Prime',monospace;letter-spacing:.06em;border:1px solid #75623d}
.locker-award-wear.is-worn{background:#46553c;color:#f0e5c9}.locker-award-wear.not-worn{background:#d0c19d;color:#5a4930}
.locker-award-citation p{margin:7px 0 0;font:11px/1.5 'Courier Prime',monospace;color:#473b2a}
.locker-award-citation blockquote{margin:10px 0 0;padding:9px 10px;border-left:3px solid #8b6b34;background:rgba(255,250,231,.34);font:11px/1.55 'Courier Prime',monospace;color:#30271c}
.locker-award-citation blockquote small{display:block;margin-bottom:5px;font:700 7px 'Courier Prime',monospace;color:#85652f;letter-spacing:.08em}
.locker-award-citation em{display:block;margin-top:8px;font:italic 9px/1.4 'Courier Prime',monospace;color:#78654b}
.locker-modal-empty{padding:30px 24px;background:rgba(60,52,37,.08);border-left:4px solid #8f733f;text-align:center}
.locker-modal-empty b,.locker-modal-empty span{display:block}.locker-modal-empty b{font:700 18px 'Stardos Stencil',serif}.locker-modal-empty span{margin-top:6px;font:11px 'Courier Prime',monospace}

.locker-weapon-detail{display:grid;gap:16px}
.locker-weapon-detail__visual{position:relative;height:300px;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#4d5546,#343c31);border:1px solid #70603e;overflow:hidden}
.locker-weapon-detail__visual>img{position:relative;z-index:1;width:94%;height:92%;object-fit:contain;filter:drop-shadow(0 18px 16px rgba(0,0,0,.4))}
.locker-weapon-detail__visual .weapon-dirt-layer{z-index:2}
.locker-weapon-detail__grid,.locker-identity-detail__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid rgba(72,59,37,.35);border-left:1px solid rgba(72,59,37,.35)}
.locker-weapon-detail__grid>div,.locker-identity-detail__grid>div{padding:12px 10px;border-right:1px solid rgba(72,59,37,.35);border-bottom:1px solid rgba(72,59,37,.35);min-width:0}
.locker-weapon-detail__grid span,.locker-identity-detail__grid span{display:block;font:700 8px 'Courier Prime',monospace;letter-spacing:.08em;color:#7d6034;margin-bottom:5px}
.locker-weapon-detail__grid b,.locker-identity-detail__grid b{display:block;font:700 11px/1.35 'Courier Prime',monospace;color:#2d2519;overflow-wrap:anywhere}

.locker-identity-detail{display:grid;grid-template-columns:300px minmax(0,1fr);gap:20px;align-items:center}
.locker-identity-tags{position:relative;min-height:190px;display:flex;align-items:center;justify-content:center;gap:36px;background:radial-gradient(circle at 50% 35%,rgba(65,55,35,.11),transparent 60%);border:1px solid rgba(83,68,43,.22)}
.locker-identity-tags .desktop-dogtag{position:relative}
.locker-identity-history{margin-top:18px;display:grid;gap:8px}
.locker-identity-history>header{padding:9px 11px;background:rgba(60,52,37,.08);border-left:4px solid #8f733f}.locker-identity-history>header small,.locker-identity-history>header b{display:block}.locker-identity-history>header b{font:700 15px 'Stardos Stencil',serif;margin-top:3px}
.locker-identity-history article{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 11px;background:rgba(60,52,37,.06);border-bottom:1px dotted rgba(83,68,43,.3)}
.locker-identity-history time{font:700 9px 'Courier Prime',monospace;color:#74582d}.locker-identity-history article>b{font:700 11px 'Courier Prime',monospace}.locker-identity-history article>span{font:9px 'Courier Prime',monospace;color:#69583c}

@media(max-width:900px){
  .locker-uniform-detail,.locker-identity-detail{grid-template-columns:1fr}
  .locker-uniform-detail__stage{height:470px}
  .locker-weapon-detail__grid,.locker-identity-detail__grid{grid-template-columns:1fr 1fr}
  .locker-uniform-summary{grid-template-columns:1fr}
  .locker-uniform-summary span{border-right:0;border-bottom:1px solid rgba(83,68,43,.24)}
  .locker-award-citation{grid-template-columns:1fr}.locker-award-citation>img{width:130px;height:40px}
}
@media(max-width:560px){
  .locker-uniform-detail__stage{height:390px}
  .locker-weapon-detail__visual{height:190px}
  .locker-weapon-detail__grid,.locker-identity-detail__grid{grid-template-columns:1fr}
  .locker-identity-history article{grid-template-columns:1fr;gap:4px}
  .locker-modal__actions .locker-back-button{width:100%}
}

/* === ISSUED DOG TAG IMAGE REPLACEMENT — 2026-08-22 === */
.locker-bay__visual--dogtags,
.wall-locker-dogtags-view,
.locker-identity-tags{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:18px;
}
.issued-dogtag-image{
  display:block;
  width:min(42%,145px);
  height:auto;
  object-fit:contain;
  filter:drop-shadow(0 12px 14px rgba(0,0,0,.32));
  transform-origin:50% 8%;
}
.issued-dogtag-image--first{transform:rotate(-5deg)}
.issued-dogtag-image--second{transform:rotate(5deg)}
.wall-locker-dogtags-view:before,
.wall-locker-dogtags-view:after{display:none!important}
@media(max-width:1040px){
  .wall-locker-dogtags-view{min-height:180px}
  .issued-dogtag-image{width:min(40%,130px)}
}
@media(max-width:600px){
  .wall-locker-dogtags-view,.locker-identity-tags{gap:10px}
  .issued-dogtag-image{width:min(44%,112px)}
}

/* === HOMEPAGE STAFF LOGIN VISIBILITY FIX 2026-08-22 ===
   Put Staff Login directly on the clipboard paper so it cannot fall below the hero viewport. */
.cav65-showcase-clipboard__staff-separator{display:flex;align-items:center;gap:8px;margin:14px 0 8px;color:#715a32}
.cav65-showcase-clipboard__staff-separator:before,.cav65-showcase-clipboard__staff-separator:after{content:"";height:1px;flex:1;background:rgba(93,75,45,.46)}
.cav65-showcase-clipboard__staff-separator span{font:700 7px 'Courier Prime',monospace;letter-spacing:.09em;white-space:nowrap}
.cav65-showcase-clipboard__staff-link{display:flex;align-items:center;justify-content:center;gap:14px;width:100%;box-sizing:border-box;padding:11px 10px;background:#252d21;border:1px solid #1a2017;color:#efe2c2!important;text-decoration:none;font:700 9px 'Courier Prime',monospace;letter-spacing:.05em;box-shadow:0 4px 0 rgba(0,0,0,.22);position:relative;z-index:8}
.cav65-showcase-clipboard__staff-link:hover,.cav65-showcase-clipboard__staff-link:focus-visible{background:#435139;outline:2px solid #b58e35;outline-offset:2px}
.cav65-showcase-staff{display:none!important}
@media(max-width:620px){
  .cav65-showcase-clipboard__staff-separator{margin:10px 0 6px!important}
  .cav65-showcase-clipboard__staff-separator span{font-size:6px!important}
  .cav65-showcase-clipboard__staff-link{padding:9px 8px!important;font-size:7.5px!important}
}

/* ========================================================================
   FULL-WIDTH DESKTOP PUBLIC HOMEPAGE — 2026-08-22
   Uses the available desktop viewport instead of capping the page at 1760px.
   Tablet/mobile breakpoints below 1320px are intentionally unchanged.
   ======================================================================== */
@media (min-width:1321px){
  .cav65-showcase-shell{
    width:100%!important;
    max-width:none!important;
    margin:0!important;
    border-left:0!important;
    border-right:0!important;
    box-shadow:none!important;
  }

  .cav65-showcase-nav{
    min-height:126px;
    grid-template-columns:minmax(390px,25vw) 1fr minmax(175px,11vw);
    padding:16px clamp(34px,3.2vw,82px);
    gap:clamp(24px,2vw,50px);
  }
  .cav65-showcase-brand img{width:78px;height:78px}
  .cav65-showcase-brand strong{font-size:clamp(25px,1.45vw,37px)}
  .cav65-showcase-brand small{font-size:clamp(8px,.45vw,11px)}
  .cav65-showcase-brand b{font-size:clamp(8px,.44vw,11px)}
  .cav65-showcase-nav>nav{gap:clamp(24px,2.1vw,54px)}
  .cav65-showcase-nav>nav a{font-size:clamp(10px,.55vw,14px)}
  .cav65-showcase-radio small{font-size:clamp(7px,.4vw,10px)}
  .cav65-showcase-radio b{font-size:clamp(17px,1vw,25px)}
  .cav65-showcase-radio em{font-size:clamp(7px,.38vw,10px)}

  .cav65-showcase-hero{min-height:clamp(690px,38vw,980px)}
  .cav65-showcase-hero__copy{
    width:min(940px,56%);
    padding:clamp(76px,5vw,126px) 0 clamp(74px,5vw,124px) clamp(52px,4.2vw,108px);
  }
  .cav65-showcase-hero__copy>small{font-size:clamp(11px,.62vw,16px)}
  .cav65-showcase-hero h1{font-size:clamp(76px,6vw,154px)}
  .cav65-showcase-hero h2{font-size:clamp(17px,.95vw,24px)}
  .cav65-showcase-hero__copy p{max-width:760px;font-size:clamp(14px,.78vw,20px);line-height:1.62}
  .cav65-showcase-actions{gap:clamp(12px,1vw,24px)}
  .cav65-showcase-button{min-width:clamp(235px,15vw,385px);padding:clamp(14px,.85vw,22px) clamp(16px,1vw,26px)}
  .cav65-showcase-button b{font-size:clamp(11px,.62vw,16px)}

  .cav65-showcase-access{width:clamp(410px,25vw,610px);right:clamp(32px,3vw,76px)}
  .cav65-showcase-clipboard__form h2{font-size:clamp(20px,1.15vw,29px)}
  .cav65-showcase-clipboard__form header small{font-size:clamp(8px,.45vw,11px)}
  .cav65-showcase-clipboard__form label{font-size:clamp(9px,.48vw,12px)}
  .cav65-showcase-clipboard__form input{font-size:clamp(13px,.68vw,17px);padding:clamp(11px,.65vw,16px)}
  .cav65-showcase-clipboard__form button{font-size:clamp(11px,.58vw,15px);padding:clamp(13px,.72vw,18px) 10px}
  .cav65-showcase-clipboard__staff-link{font-size:clamp(9px,.52vw,13px);padding:clamp(11px,.62vw,16px) 12px}

  .cav65-showcase-pillars{
    gap:clamp(10px,.8vw,20px);
    padding:clamp(14px,1vw,26px) clamp(42px,3.2vw,82px);
  }
  .cav65-showcase-card{min-height:clamp(240px,14vw,360px);grid-template-columns:minmax(0,.9fr) minmax(230px,1.1fr)}
  .cav65-showcase-card__copy{padding:clamp(18px,1.2vw,30px) 0 clamp(18px,1.2vw,30px) clamp(18px,1.2vw,30px)}
  .cav65-showcase-card__copy small{font-size:clamp(17px,1vw,25px)}
  .cav65-showcase-card__copy>b{font-size:clamp(8px,.48vw,12px)}
  .cav65-showcase-card__copy p{font-size:clamp(10.5px,.62vw,16px);line-height:1.58}
  .cav65-showcase-card__copy a,.cav65-showcase-wide-button{font-size:clamp(8px,.48vw,12px);padding:clamp(9px,.55vw,14px) clamp(11px,.7vw,18px)}

  .cav65-showcase-lower{
    gap:clamp(10px,.8vw,20px);
    padding:0 clamp(42px,3.2vw,82px) clamp(14px,1vw,26px);
  }
  .cav65-showcase-night,.cav65-showcase-sitboard,.cav65-showcase-honors{padding:clamp(14px,1vw,25px)}
  .cav65-showcase-night>header small,.cav65-showcase-sitboard>header small,.cav65-showcase-honors>header small{font-size:clamp(16px,.95vw,24px)}
  .cav65-showcase-night>header span,.cav65-showcase-sitboard>header span,.cav65-showcase-honors>header span{font-size:clamp(8px,.45vw,11px)}
  .cav65-showcase-timeline b{font-size:clamp(10px,.58vw,15px)}
  .cav65-showcase-timeline p{font-size:clamp(8.5px,.5vw,13px);line-height:1.5}
  .cav65-showcase-sitrow{font-size:clamp(8.5px,.5vw,13px);padding:clamp(8px,.5vw,13px) 2px}
  .cav65-showcase-sitrow b{font-size:clamp(9px,.52vw,13px)}
  .cav65-showcase-honors-grid span{font-size:clamp(7px,.42vw,10px)}

  .cav65-showcase-enlist{margin-left:clamp(42px,3.2vw,82px);margin-right:clamp(42px,3.2vw,82px)}
  .cav65-showcase-enlist small{font-size:clamp(20px,1.25vw,32px)}
  .cav65-showcase-enlist p{font-size:clamp(9px,.55vw,14px)}
  .cav65-showcase-enlist>a{font-size:clamp(10px,.58vw,15px)}

  .cav65-showcase-footer{padding-left:clamp(42px,3.2vw,82px);padding-right:clamp(42px,3.2vw,82px)}
}

/* ========================================================================
   MEMBER INFORMATION DE-DUPLICATION PASS — 2026-08-22
   Each data category has one authoritative Wall Locker panel.
   ======================================================================== */
.wall-locker-index__intro{margin:8px 0 18px;font:11px/1.55 'Courier Prime',monospace;color:#4b3e2b}
.wall-locker-index__list{display:grid;gap:8px}
.wall-locker-index__list>span{display:block;padding:10px 11px;background:rgba(67,58,39,.07);border-left:3px solid #8e733e}
.wall-locker-index__list b{display:block;font:700 11px/1.25 'Courier Prime',monospace;color:#2d2519}
.wall-locker-index__list em{display:block;margin-top:3px;font:9px/1.4 'Courier Prime',monospace;color:#705a39;font-style:normal}
.locker-modal__grid--single{grid-template-columns:1fr!important}

/* ========================================================================
   PERMANENT STAFF AUTHENTICATION LANE — 2026-08-22
   Staff access must remain visually separate from member Battle Roster login.
   The dedicated panel is intentionally NOT hidden at any breakpoint.
   ======================================================================== */
.cav65-showcase-staff{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:14px!important;
  margin:10px 4px 0!important;
  padding:13px 14px!important;
  background:linear-gradient(180deg,rgba(37,45,33,.98),rgba(26,32,24,.98))!important;
  border:1px solid rgba(202,170,91,.58)!important;
  border-left:4px solid #b79239!important;
  box-shadow:0 10px 22px rgba(0,0,0,.38)!important;
  position:relative!important;
  z-index:12!important;
  color:#eee2c2!important;
}
.cav65-showcase-staff div{display:grid!important;gap:2px!important;min-width:0!important}
.cav65-showcase-staff small{font:700 7px 'Courier Prime',monospace!important;letter-spacing:.1em!important;color:#c3ac72!important}
.cav65-showcase-staff strong{font:700 17px 'Stardos Stencil',serif!important;letter-spacing:.04em!important;color:#fff2ce!important}
.cav65-showcase-staff span{font:400 8px 'Courier Prime',monospace!important;color:#cfc5aa!important}
.cav65-showcase-staff>a{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  min-height:38px!important;
  padding:9px 13px!important;
  border:1px solid #cfad58!important;
  background:#b68d31!important;
  color:#151a12!important;
  text-decoration:none!important;
  white-space:nowrap!important;
  font:700 9px 'Courier Prime',monospace!important;
  letter-spacing:.055em!important;
  box-shadow:0 3px 0 rgba(0,0,0,.35)!important;
}
.cav65-showcase-staff>a:hover,.cav65-showcase-staff>a:focus-visible{background:#d0aa4b!important;outline:2px solid #f1dfaa!important;outline-offset:2px!important}

/* Make the two authentication lanes unmistakable on every standard public page. */
.record-index .member-login-tab{background:#d7c39a!important;color:#211d15!important;border-color:#9b8150!important}
.record-index .staff-login-tab{background:#273020!important;color:#f2e5c4!important;border:1px solid #9f843f!important;margin-left:4px!important;padding-left:12px!important}
.record-index .staff-login-tab:before{content:"HQ"!important}

.public-office-paper--staff{border-top:5px solid #7d6b34!important}
.hq-button--staff{background:#293322!important;color:#f1e4c1!important;border:2px solid #9d8240!important}
.hq-button--staff:hover,.hq-button--staff:focus-visible{background:#3d4a33!important;color:#fff3ce!important}

@media(max-width:620px){
  .cav65-showcase-staff{grid-template-columns:1fr!important;margin:8px 2px 0!important;padding:11px 12px!important}
  .cav65-showcase-staff>a{width:100%!important;box-sizing:border-box!important}
}
/* MY SQUAD — unified member/NCO formation workspace */
.my-squad-room{display:grid;gap:1.25rem}.squad-member-row{color:inherit;text-decoration:none}.squad-member-row:hover,.squad-member-row.is-selected{outline:2px solid rgba(71,63,38,.34);outline-offset:-2px;background:rgba(239,229,190,.42)}.squad-inspector-grid{display:grid;grid-template-columns:minmax(430px,.95fr) minmax(520px,1.05fr);gap:2rem;align-items:start}.squad-uniform-panel h3,.squad-quick-actions h3{font-family:var(--typewriter,monospace);letter-spacing:.08em}.squad-uniform-stage{position:relative;max-width:560px;margin:0 auto;min-height:500px}.squad-uniform-stage .uniform-base-image{width:100%;height:auto;display:block}.squad-ribbon-rack{position:absolute;left:63.8%!important;top:32.8%!important;transform:none!important;width:auto!important;align-items:flex-start!important}.squad-ribbon-rack .uniform-ribbon-row{justify-content:flex-start!important}.squad-soldier-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:1rem}.squad-soldier-facts span{border:1px solid rgba(58,51,31,.28);padding:.85rem;display:flex;flex-direction:column;gap:.3rem;min-height:70px}.squad-quick-actions{display:grid;gap:1.25rem;min-width:0}.squad-quick-actions h3{font-size:1.15rem;margin:0 0 .25rem}.squad-quick-actions form{border-top:1px dashed rgba(58,51,31,.35);padding:1.2rem 0 0;display:grid!important;grid-template-columns:1fr!important;gap:.8rem!important}.squad-quick-actions label{display:grid!important;grid-template-columns:1fr!important;gap:.45rem!important;font-size:.78rem!important;font-weight:800;letter-spacing:.055em}.squad-quick-actions select,.squad-quick-actions textarea{width:100%!important;min-width:0!important;box-sizing:border-box!important;font-size:1rem!important;line-height:1.35!important;padding:.8rem .9rem!important;min-height:46px!important}.squad-quick-actions textarea{min-height:96px!important;resize:vertical}.squad-quick-actions .paper-action{width:100%!important;min-height:52px!important;padding:.9rem 1rem!important;font-size:1rem!important;letter-spacing:.07em!important}.squad-quick-actions .typed-empty{font-size:.95rem;line-height:1.5}@media(max-width:1050px){.squad-inspector-grid{grid-template-columns:1fr}.squad-uniform-stage{min-height:0;max-width:520px}.squad-quick-actions{max-width:760px;width:100%;margin:0 auto}}@media(max-width:600px){.squad-soldier-facts{grid-template-columns:1fr}.squad-quick-actions select,.squad-quick-actions textarea{font-size:16px!important}}

/* ========================================================================
   SITE-WIDE ROSTER READABILITY OVERHAUL — 2026-08-22
   One readable visual system for battalion/company/platoon/squad/member/staff
   personnel lists. Rank-precedence sorting remains backend-authoritative.
   ======================================================================== */
:root{
  --roster-text:14px;
  --roster-detail:12px;
  --roster-heading:12px;
  --roster-name:16px;
  --roster-row-pad:15px;
}

/* Give personnel-heavy pages enough horizontal room on desktop. */
.personnel-records-room,
.page-company .company-office,
.page-platoon .platoon-room,
.member-unit-shell,
.page-my-squad .my-squad-room,
.page-s1 .s1-workroom,
.public-units-page .battalion-public-board,
.career-file-shell{
  width:min(1680px,calc(100% - 48px));
  max-width:1680px;
  margin-left:auto;
  margin-right:auto;
  box-sizing:border-box;
}
.page-company .company-office{grid-template-columns:minmax(300px,.45fr) minmax(0,1.55fr)}
.page-company .company-roster{min-width:0}
.page-platoon .platoon-room{grid-template-columns:minmax(280px,.42fr) minmax(0,1.58fr)}

/* Generic company / records-office roster rows. */
.roster-table{
  grid-template-columns:minmax(260px,1.35fr) minmax(90px,.42fr) minmax(150px,.72fr) minmax(150px,.72fr) minmax(220px,1fr);
  gap:18px;
  min-height:62px;
  padding:var(--roster-row-pad) 10px;
  font-size:var(--roster-text);
  line-height:1.35;
}
.roster-table.header{
  min-height:46px;
  padding:12px 10px;
  font-size:var(--roster-heading);
  letter-spacing:.07em;
}
.roster-table:not(.header)>span:first-child{font-size:var(--roster-name);font-weight:700}
.roster-table small{font-size:var(--roster-detail)!important;line-height:1.35}
.battalion-roster,.formation-roll,.company-roster,.personnel-roster{padding:34px 36px 40px}

/* Staff battalion personnel index. Previous implementation dropped to 6–8px. */
.personnel-index{padding:30px 34px}
.personnel-index-row{
  grid-template-columns:minmax(125px,.55fr) minmax(260px,1.25fr) minmax(150px,.7fr) minmax(220px,1fr) minmax(145px,.65fr);
  gap:16px;
  min-height:70px;
  padding:12px 14px;
  font-size:14px;
  line-height:1.35;
}
.personnel-index-row.head{
  min-height:46px;
  font-size:12px;
  letter-spacing:.08em;
}
.personnel-index-row strong{font-size:16px}
.personnel-index-row .index-rank b{font-size:14px}
.personnel-index-row .index-rank img{max-width:58px;max-height:54px}

/* S-1 personnel roster. */
.page-s1 .s1-roster-sheet{padding:34px 36px 40px;overflow-x:auto}
.page-s1 .s1-roster-sheet>header{padding-bottom:14px;margin-bottom:10px}
.page-s1 .s1-roster-sheet>header b{font-size:24px}
.page-s1 .s1-roster-sheet>header span,.page-s1 .s1-roster-sheet>header small{font-size:12px}
.page-s1 .s1-roster-head,.page-s1 .s1-roster-row{
  grid-template-columns:minmax(260px,1.25fr) minmax(210px,1fr) minmax(180px,.82fr) minmax(220px,1fr) minmax(180px,.7fr);
  gap:18px;
  min-width:1120px;
  padding:14px 10px;
  font-size:14px;
  line-height:1.35;
}
.page-s1 .s1-roster-head{font-size:12px;letter-spacing:.07em;min-height:46px}
.page-s1 .s1-roster-row{min-height:74px}
.page-s1 .s1-roster-row b,.page-s1 .s1-roster-soldier-button b{font-size:16px;line-height:1.25}
.page-s1 .s1-roster-row small,.page-s1 .s1-roster-soldier-button small{font-size:11px;line-height:1.35;margin-top:4px}
.page-s1 .s1-roster-row button{font-size:11px;min-height:36px;padding:8px 10px}
.page-s1 .s1-actions{gap:6px}

/* S-1 quick roster control list. */
.roster-control-toolbar{font-size:13px}
.roster-control-toolbar input{font-size:14px;min-height:46px}
.roster-control-toolbar span{font-size:12px;font-weight:700}
.roster-control-person summary{
  min-height:72px;
  padding:15px 16px;
  font-size:14px;
}
.roster-control-person summary b{font-size:16px;line-height:1.3}
.roster-control-person summary small{font-size:11px;line-height:1.4;margin-top:4px}
.roster-control-person summary>span:nth-child(2){font-size:13px;font-weight:700}
.roster-control-person summary strong{font-size:13px}

/* Public battalion roster. */
.public-roster-paper{padding:28px 30px 34px;overflow-x:auto}
.public-roster-paper h2{font-size:34px}
.public-roster-row{
  grid-template-columns:minmax(90px,.45fr) minmax(240px,1.15fr) minmax(260px,1.3fr) minmax(220px,1.05fr) minmax(130px,.65fr);
  gap:18px;
  min-width:1040px;
  min-height:64px;
  padding:14px 12px;
  font:14px/1.4 'Courier Prime',monospace;
  align-items:center;
}
.public-roster-row b{font-size:16px}
.public-roster-row small{font-size:11px;line-height:1.35;margin-top:4px}
.public-roster-head{min-height:46px;font-size:12px;letter-spacing:.08em}

/* Member MY UNIT roster. */
.member-unit-shell{padding-top:58px}
.member-unit-roster{padding:32px 34px 38px}
.member-unit-summary small{font-size:11px!important}
.member-unit-summary b{font-size:15px}
.member-unit-note{font-size:14px!important}
.member-unit-table__head,.member-unit-table__row{
  grid-template-columns:minmax(280px,1.35fr) minmax(220px,1fr) minmax(165px,.72fr) minmax(165px,.72fr);
  gap:20px;
  padding:15px 18px;
}
.member-unit-table__head{font-size:12px;min-height:48px}
.member-unit-table__row{min-height:76px;font-size:14px;line-height:1.4}
.member-unit-soldier b{font-size:17px}

/* MY SQUAD: every member sees the same readable roster; permissions remain route-controlled. */
.page-my-squad .my-squad-room{
  display:block;
  padding:0;
  margin-top:0;
  margin-bottom:72px;
}
.page-my-squad .leader-roster{width:100%;padding:26px 28px 32px;box-sizing:border-box;overflow:hidden}
.page-my-squad .leader-roster-head,.page-my-squad .leader-roster-row{
  display:grid;
  grid-template-columns:minmax(280px,1.35fr) minmax(170px,.72fr) minmax(220px,1fr) minmax(220px,1fr) minmax(180px,.72fr);
  gap:20px;
  align-items:center;
}
.page-my-squad .leader-roster-head{
  min-height:48px;
  padding:12px 16px;
  margin-top:16px;
  background:#c7b78f;
  border:1px solid rgba(66,55,35,.35);
  border-bottom:2px solid #554a35;
  font:700 12px 'Courier Prime',monospace;
  letter-spacing:.08em;
  color:#292218;
}
.page-my-squad .leader-roster-row{
  min-height:84px;
  padding:16px;
  border-bottom:1px solid rgba(66,55,35,.26);
  color:#292218;
  text-decoration:none;
  font:14px/1.4 'Courier Prime',monospace;
}
.page-my-squad .leader-roster-row:hover,.page-my-squad .leader-roster-row:focus-visible{background:rgba(120,101,61,.1);outline:2px solid rgba(116,88,33,.4);outline-offset:-2px}
.page-my-squad .leader-cell{display:block;min-width:0;color:#292218}
.page-my-squad .leader-cell>b{display:block;font-size:15px;line-height:1.3;overflow-wrap:anywhere}
.page-my-squad .leader-cell--soldier>b{font-size:17px}
.page-my-squad .leader-cell>em{display:block;margin-top:5px;font:11px/1.4 'Courier Prime',monospace;color:#6b604d;font-style:normal}
.page-my-squad .leader-mobile-label{display:none!important}
.page-my-squad .typed-note{font-size:13px;line-height:1.55}

/* Platoon squad boards. */
.page-platoon .assignment-board{padding:24px}
.page-platoon .squad-board{margin:12px 0;padding:14px}
.page-platoon .squad-board h3{font-size:17px;margin-bottom:10px}
.page-platoon .name-strip,.page-platoon .vacant-strip{margin:7px 0;padding:12px 14px}
.page-platoon .name-strip strong{font-size:15px;line-height:1.3}
.page-platoon .name-strip small{font-size:12px;line-height:1.35;margin-top:4px}

/* Formation identity roster and other roster-like career rows. */
.career-paper .career-row{min-height:58px;padding:12px 4px;font-size:14px;line-height:1.4}
.career-paper .career-row>b{font-size:15px}
.career-paper .career-row span{font-size:13px}
.career-paper .career-row small{font-size:11px;line-height:1.4}

/* Training / morning report / operation participant rosters. */
.qualification-table{
  gap:14px;
  min-height:58px;
  padding:12px 8px;
  font-size:14px;
  line-height:1.35;
}
.qualification-table.header{font-size:12px;min-height:44px}
.morning-roster{
  gap:14px;
  min-height:56px;
  padding:12px 8px;
  font-size:13px;
  line-height:1.35;
}
.morning-roster.header{font-size:11px;min-height:42px}
.participant-roster>div{padding:11px 0;font-size:14px;line-height:1.4}
.participant-roster small{font-size:11px}

/* S-1 inactivity personnel roster. */
.inactivity-table{gap:16px;font-size:14px;line-height:1.35}
.inactivity-table.head{min-height:46px;padding:12px 14px;font-size:12px}
.inactivity-soldier summary{min-height:70px;padding:14px}
.inactivity-soldier summary b{font-size:15px}
.inactivity-soldier summary small{font-size:11px;line-height:1.35;margin-top:3px}

/* Generic unit lines used by battalion/company strength listings. */
.unit-line{
  grid-template-columns:minmax(130px,.55fr) minmax(260px,1.4fr) minmax(130px,.55fr) minmax(180px,.75fr);
  gap:16px;
  min-height:62px;
  padding:13px 8px;
  font-size:14px;
  line-height:1.35;
}
.unit-line.battalion b{font-size:17px}
.unit-line a{font-size:11px}
.unit-line small{font-size:11px}

/* Mobile: do not solve roster density by shrinking text. Stack rows as readable cards. */
@media(max-width:900px){
  :root{--roster-text:14px;--roster-detail:12px;--roster-heading:11px;--roster-name:16px;--roster-row-pad:14px}
  .personnel-records-room,.page-company .company-office,.page-platoon .platoon-room,.member-unit-shell,.page-my-squad .my-squad-room,.page-s1 .s1-workroom,.public-units-page .battalion-public-board,.career-file-shell{width:calc(100% - 24px)}
  .page-company .company-office,.page-platoon .platoon-room{grid-template-columns:1fr}

  .roster-table.header,.personnel-index-row.head,.member-unit-table__head,.page-my-squad .leader-roster-head,.public-roster-head{display:none}
  .roster-table,.personnel-index-row,.member-unit-table__row,.page-my-squad .leader-roster-row{
    grid-template-columns:1fr 1fr;
    min-width:0;
    gap:12px 16px;
    min-height:0;
    padding:16px 14px;
    margin:0 0 10px;
    border:1px solid rgba(78,66,43,.26);
    background:rgba(235,224,194,.45);
  }
  .roster-table>span:first-child,.personnel-index-row>span:nth-child(2),.member-unit-table__row>span:first-child,.page-my-squad .leader-cell--soldier{grid-column:1/-1}
  .personnel-index-row{font-size:14px;text-decoration:none}
  .personnel-index-row strong,.member-unit-soldier b,.page-my-squad .leader-cell--soldier>b{font-size:17px}

  .page-my-squad .leader-mobile-label{display:block!important;margin-bottom:4px;font:700 10px 'Courier Prime',monospace!important;letter-spacing:.08em;color:#76654a!important}
  .page-my-squad .leader-roster{padding:20px 14px 24px}
  .page-my-squad .leader-cell>b{font-size:15px}
  .page-my-squad .leader-cell>em{font-size:12px}

  .public-roster-paper{overflow:visible;padding:22px 16px}
  .public-roster-row:not(.public-roster-head){
    grid-template-columns:100px 1fr;
    min-width:0;
    min-height:0;
    gap:8px 12px;
    margin-bottom:10px;
    padding:14px;
    border:1px solid rgba(78,66,43,.3);
    background:rgba(255,255,255,.09);
  }
  .public-roster-row:not(.public-roster-head)>span:nth-child(2){font-size:16px}

  .page-s1 .s1-roster-sheet{overflow:visible;padding:24px 16px}
  .page-s1 .s1-roster-head{display:none}
  .page-s1 .s1-roster-row{
    min-width:0;
    grid-template-columns:1fr 1fr;
    gap:12px 14px;
    margin-bottom:10px;
    padding:15px 12px;
    border:1px solid rgba(78,66,43,.28);
  }
  .page-s1 .s1-roster-row>span:first-child{grid-column:1/-1}
  .page-s1 .s1-roster-row span:nth-child(3),.page-s1 .s1-roster-row span:nth-child(4),.page-s1 .s1-roster-row span:nth-child(5){grid-column:auto}

  .unit-line{grid-template-columns:1fr 1fr;min-height:0;padding:14px 8px}
  .unit-line>*:nth-child(2){grid-column:1/-1}
  .inactivity-table,.inactivity-table.head{grid-template-columns:1fr}
  .inactivity-table.head{display:none}
}

@media(max-width:560px){
  .battalion-roster,.formation-roll,.company-roster,.personnel-roster,.personnel-index,.member-unit-roster{padding:20px 14px 24px}
  .roster-table,.personnel-index-row,.member-unit-table__row,.page-my-squad .leader-roster-row,.page-s1 .s1-roster-row,.public-roster-row:not(.public-roster-head){grid-template-columns:1fr}
  .roster-table>span,.personnel-index-row>span,.member-unit-table__row>span,.page-my-squad .leader-cell,.page-s1 .s1-roster-row>span,.public-roster-row:not(.public-roster-head)>span{grid-column:1!important}
  .member-unit-summary{grid-template-columns:1fr 1fr}
  .public-roster-paper h2{font-size:28px}
  .page-s1 .s1-roster-sheet>header{display:grid;gap:5px;align-items:start}
}
.operation-duty-roster .entry-row{min-height:58px;padding:12px 8px;font-size:14px;line-height:1.4}
.operation-duty-roster .entry-row>span{font-size:15px}
.operation-duty-roster .entry-row>b{font-size:14px}
.operation-duty-roster .entry-row>small{font-size:11px;line-height:1.35}
.formation-member-roster .career-row{min-height:62px}
@media(max-width:900px){
  .roster-table>span,.qualification-table>span,.morning-roster>span,.unit-line>span,.unit-line>a{display:block!important}
  .qualification-table,.morning-roster{grid-template-columns:1fr 1fr!important;gap:10px 14px;padding:14px 10px}
  .qualification-table.header,.morning-roster.header{display:none}
  .qualification-table:not(.header),.morning-roster:not(.header){margin-bottom:9px;border:1px solid rgba(78,66,43,.25)}
}
@media(max-width:560px){
  .qualification-table,.morning-roster{grid-template-columns:1fr!important}
}

/* === CUMULATIVE WALL LOCKER POLISH — 2026-08-22 === */
/* Mail / Action Center: use the supplied transparent U.S. Army mail pouch asset. */
.wall-locker-mail-pouch-view{
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  min-height:0!important;
  padding:2px 8px 4px!important;
  overflow:hidden!important;
  background:transparent!important;
}
.wall-locker-mail-pouch-image{
  display:block;
  width:100%;
  height:100%;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
  object-position:center;
  background:transparent!important;
  filter:drop-shadow(0 12px 14px rgba(0,0,0,.28));
}
.wall-locker-object--footlocker .footlocker-box,
.wall-locker-object--footlocker .footlocker-lid{display:none!important}

/* Dog tags: read visually as one issued paired set rather than two unrelated objects. */
.wall-locker-dogtags-view,.locker-identity-tags{
  position:relative;
  gap:0!important;
  isolation:isolate;
}
.wall-locker-dogtags-view .issued-dogtag-image--first,
.locker-identity-tags .issued-dogtag-image--first{
  transform:rotate(-5deg) translateX(12px)!important;
  z-index:1;
}
.wall-locker-dogtags-view .issued-dogtag-image--second,
.locker-identity-tags .issued-dogtag-image--second{
  transform:rotate(7deg) translateX(-12px) translateY(7px)!important;
  z-index:2;
}

/* Recruiting process assets should be crisp, not faded or desaturated. */
.cav65-showcase-timeline img{
  filter:none!important;
  opacity:1!important;
  mix-blend-mode:normal!important;
  object-fit:contain;
  background:#11170f;
}

/* Uniform display geometry and military rack sizing: max three ribbons per row. */
.locker-uniform-detail__stage{
  height:auto!important;
  aspect-ratio:4 / 5;
  min-height:0;
}
.locker-uniform-detail__stage>.uniform-base-image{
  width:100%!important;
  height:100%!important;
  object-fit:contain!important;
  object-position:center top!important;
}
.uniform-ribbon-row{max-width:calc(3 * 38px + 2px);flex-wrap:nowrap!important}
.locker-modal-ribbon-rack{
  left:63.8%!important;
  top:32.8%!important;
  transform:translateX(-50%)!important;
  gap:2px!important;
}
.locker-modal-ribbon-rack .uniform-ribbon-row{justify-content:center!important}
.locker-modal-ribbon-rack img{width:36px!important;height:11px!important}
.locker-modal-ribbon-rack .row-size-1 img{width:36px!important;height:11px!important}
.wall-locker-ribbon-rack,.locker-desktop-ribbon-rack,.uniform-ribbon-rack--file,.squad-ribbon-rack{
  gap:2px!important;
}
@media(max-width:600px){
  .wall-locker-dogtags-view .issued-dogtag-image--first,
  .locker-identity-tags .issued-dogtag-image--first{transform:rotate(-5deg) translateX(7px)!important}
  .wall-locker-dogtags-view .issued-dogtag-image--second,
  .locker-identity-tags .issued-dogtag-image--second{transform:rotate(7deg) translateX(-7px) translateY(5px)!important}
}

/* === WALL LOCKER CATASTROPHIC DESKTOP RESTORE — 2026-08-22 === */
@media (min-width:1321px){
  .wall-locker-desktop-stage .locker-bay__visual{border:0;cursor:pointer;font:inherit;color:inherit}
  .locker-bay__visual--mail-pouch{display:flex!important;align-items:center!important;justify-content:center!important;padding:4px 12px!important;background:transparent!important}
  .locker-bay__visual--mail-pouch .wall-locker-mail-pouch-image{width:100%!important;height:100%!important;max-height:100%!important;object-fit:contain!important;filter:drop-shadow(0 10px 12px rgba(0,0,0,.3))}
  .locker-bay__visual--dogtags{display:flex!important;align-items:center!important;justify-content:center!important;gap:0!important}
  .locker-bay__visual--dogtags .issued-dogtag-image{width:auto!important;height:74%!important;max-width:40%!important;object-fit:contain!important}
}
.locker-clean-weapon-form{display:inline-flex;margin:0}
.locker-clean-weapon-button{display:inline-flex;align-items:center;justify-content:center;padding:11px 14px;border:1px solid #765f31;background:#39452f;color:#f0e5c9;font:700 10px 'Courier Prime',monospace;letter-spacing:.08em;cursor:pointer;box-shadow:0 8px 14px rgba(0,0,0,.14)}
.locker-clean-weapon-button:hover,.locker-clean-weapon-button:focus-visible{background:#46543a;outline:2px solid #9a7a37;outline-offset:2px}
.locker-clean-weapon-button:disabled{opacity:.45;cursor:not-allowed}
@media(max-width:760px){.locker-clean-weapon-form,.locker-clean-weapon-button{width:100%}}

/* Formation Assignment Control — billet-driven leadership */
.formation-control-page{max-width:1500px;margin:24px auto;padding:28px}.formation-command-strip{display:flex;gap:12px;align-items:center;padding:14px 16px;margin:18px 0;border:1px solid rgba(91,70,28,.45);font-size:15px}.formation-billet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.formation-slot-card{border:1px solid rgba(91,70,28,.45);padding:16px;background:rgba(222,205,157,.24)}.formation-slot-card h3{margin:4px 0 12px;font-size:18px}.formation-slot-card select,.formation-slot-card button{width:100%;min-height:42px;margin-top:8px}.formation-current-roster,.formation-migration{margin-top:24px;padding-top:18px;border-top:2px solid rgba(91,70,28,.45)}.formation-exception{display:grid;grid-template-columns:260px 1fr;gap:12px;padding:10px;border-bottom:1px solid rgba(91,70,28,.25)}
@media(max-width:800px){.formation-billet-grid{grid-template-columns:1fr}.formation-command-strip{flex-wrap:wrap}.formation-exception{grid-template-columns:1fr}}


/* 2026-08-22 final readability / asset cleanup */
.cav65-showcase-timeline img{filter:none!important;object-fit:contain!important;background:transparent!important}
.cav65-showcase-card>img{background:transparent!important}
.public-units-page .public-office-board{max-width:min(1900px,96vw)!important;width:min(1900px,96vw)!important}
.public-units-page .public-board-heading small{font-size:13px!important}.public-units-page .public-board-heading h2{font-size:42px!important}.public-units-page .public-board-heading p{font-size:16px!important;line-height:1.6!important}
.public-units-page .public-command-group article small{font-size:12px!important}.public-units-page .public-command-group article h3{font-size:25px!important}.public-units-page .public-command-group article span{font-size:12px!important}
.public-units-page .public-company-file>header h2{font-size:34px!important}.public-units-page .public-company-file>header small,.public-units-page .public-company-file>header span{font-size:12px!important}.public-units-page .public-company-file>header nav a{font-size:11px!important;padding:10px 13px!important}
.public-units-page .public-company-leadership small{font-size:11px!important}.public-units-page .public-company-leadership b{font-size:15px!important}
.public-units-page .public-platoon-file h3{font-size:25px!important}.public-units-page .public-platoon-file header span,.public-units-page .public-platoon-file header a{font-size:11px!important}.public-units-page .public-platoon-leaders{font-size:13px!important}
.public-units-page .public-squad-file strong{font-size:15px!important}.public-units-page .public-squad-file small,.public-units-page .public-squad-file>b{font-size:11px!important}
.public-units-page .public-roster-paper header small{font-size:12px!important}.public-units-page .public-roster-paper header h2{font-size:30px!important}.public-units-page .public-roster-row{font-size:14px!important;min-height:48px!important;padding:10px 12px!important}.public-units-page .public-roster-row small{font-size:11px!important}

/* 2026-08-22 — SINGLE-SCREEN S-3 OPERATIONS CONTROL */
.ops-simple-control .main-content{max-width:none;width:100%;}
.ops-simple-hero{max-width:1600px;margin:0 auto;padding:34px 34px 18px;}
.ops-simple-hero small,.ops-simple-hero h1,.ops-simple-hero p{margin:0 0 8px;}
.ops-simple-hero h1{font-size:clamp(30px,3vw,52px);}
.ops-simple-health,.ops-simple-schedule,.ops-simple-board,.ops-simple-completed{max-width:1600px;margin:14px auto;padding:22px 26px;}
.ops-simple-health{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;}
.ops-simple-health>div{border:1px solid rgba(70,54,24,.28);padding:14px;display:flex;flex-direction:column;gap:6px;}
.ops-simple-health b{font-size:18px;}
.ops-simple-schedule header h2,.ops-simple-board header h2,.ops-simple-completed header h2{font-size:28px;margin:4px 0 6px;}
.ops-simple-form{display:grid;grid-template-columns:2fr 1.25fr 1fr 2fr 1fr 1.6fr;gap:12px;align-items:end;}
.ops-simple-form label,.ops-inline-form label{display:flex;flex-direction:column;gap:5px;font-weight:700;}
.ops-simple-form input,.ops-simple-form select,.ops-simple-form textarea,.ops-inline-form input,.ops-inline-form select,.ops-duty-add select,.ops-duty-add input{min-height:44px;padding:9px 10px;font-size:14px;}
.ops-simple-advanced{grid-column:1/-1;border-top:1px solid rgba(70,54,24,.25);padding-top:10px;}
.ops-simple-advanced>div{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px;}.ops-simple-advanced .wide{grid-column:span 2;}
.ops-primary{grid-column:1/-1;min-height:50px;font-size:16px;font-weight:900;}
.ops-system-warning{margin-top:14px;font-weight:800;}
.ops-simple-card{border:1px solid rgba(70,54,24,.35);padding:18px;margin-top:14px;background:rgba(255,255,255,.08);}
.ops-simple-card-main{position:relative;}.ops-simple-card h3{font-size:25px;margin:4px 0 12px;}.ops-simple-status{position:absolute;right:0;top:0;display:flex;gap:12px;align-items:center;}
.ops-simple-meta{display:grid;grid-template-columns:1.4fr 1.4fr .8fr 1.2fr;gap:9px;}.ops-simple-meta span{border-top:1px solid rgba(70,54,24,.25);padding-top:8px;display:flex;flex-direction:column;gap:4px;}.ops-simple-meta b{font-size:14px;}
.ops-simple-actions{margin-top:15px;border-top:1px solid rgba(70,54,24,.32);padding-top:10px;}.ops-simple-actions details{border-bottom:1px solid rgba(70,54,24,.2);padding:8px 0;}.ops-simple-actions summary{font-weight:900;cursor:pointer;font-size:14px;}
.ops-inline-form{display:grid;grid-template-columns:2fr 1.4fr .8fr .8fr 2fr 1.6fr;gap:8px;margin:12px 0;align-items:end;}.ops-inline-form button{min-height:44px;}
.ops-duty-add{display:grid;grid-template-columns:2fr 1.3fr 1.4fr auto;gap:8px;margin:12px 0;}.ops-duty-list>div{display:flex;justify-content:space-between;align-items:center;border-top:1px dotted rgba(70,54,24,.25);padding:8px 0;}.ops-duty-list span{display:flex;gap:10px;align-items:center;}.ops-duty-list button{padding:6px 10px;}
.ops-destructive-row{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0;align-items:center;}.ops-destructive-row form{display:flex;gap:6px;}.ops-destructive-row button{min-height:38px;padding:8px 14px;}.ops-destructive-row .danger{font-weight:900;}.ops-history-link{display:inline-block;margin-top:10px;font-weight:800;}
.ops-simple-completed>a{display:flex;justify-content:space-between;gap:20px;padding:11px 0;border-top:1px dotted rgba(70,54,24,.28);text-decoration:none;color:inherit;}.ops-empty{padding:24px 4px;display:flex;flex-direction:column;gap:5px;}
@media(max-width:1100px){.ops-simple-health{grid-template-columns:repeat(2,1fr)}.ops-simple-form,.ops-inline-form{grid-template-columns:repeat(2,1fr)}.ops-duty-add{grid-template-columns:1fr 1fr}.ops-simple-meta{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.ops-simple-hero,.ops-simple-health,.ops-simple-schedule,.ops-simple-board,.ops-simple-completed{padding-left:14px;padding-right:14px}.ops-simple-health,.ops-simple-form,.ops-inline-form,.ops-duty-add,.ops-simple-meta{grid-template-columns:1fr}.ops-simple-status{position:static;margin-bottom:8px}.ops-simple-completed>a{flex-direction:column;gap:4px}.ops-simple-advanced>div{grid-template-columns:1fr}.ops-simple-advanced .wide{grid-column:auto}}

/* 2026-08-22 — Staff 201 File / Personnel Action Hub simplification */
.staff-201-command-hub{margin:16px 0 22px;padding:22px 24px;background:linear-gradient(180deg,#e6d8b2,#d5c292);border:2px solid #655735;box-shadow:0 8px 18px rgba(20,22,16,.18)}
.staff-201-command-copy{display:grid;grid-template-columns:1fr auto;gap:2px 18px;align-items:end;border-bottom:1px solid rgba(58,48,29,.38);padding-bottom:13px}.staff-201-command-copy small{grid-column:1/-1;font-size:.67rem;font-weight:800;letter-spacing:.13em;color:#7d6424}.staff-201-command-copy h2{margin:0;font-size:2rem;letter-spacing:.045em}.staff-201-command-copy p{grid-column:1/-1;margin:7px 0 0;max-width:960px;font-size:.82rem;line-height:1.5}
.staff-201-command-status{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:14px 0}.staff-201-command-status span{padding:11px 12px;border:1px solid rgba(63,53,34,.3);background:rgba(245,235,204,.54);min-width:0}.staff-201-command-status small{display:block;font-size:.59rem;letter-spacing:.1em;font-weight:800}.staff-201-command-status b{display:block;margin-top:4px;font-size:.83rem;overflow-wrap:anywhere}.staff-201-command-status .is-current{border-left:4px solid #4e613d}.staff-201-command-status .is-pending{border-left:4px solid #a07e28}.staff-201-command-status .is-error{border-left:4px solid #7d3f32}
.staff-201-primary-actions{display:grid;grid-template-columns:1.45fr 1fr 1fr;gap:9px}.staff-201-primary-actions a{display:flex;min-height:72px;flex-direction:column;justify-content:center;padding:13px 15px;background:#343c2c;color:#f3e7c4;text-decoration:none;border:1px solid #1c2118}.staff-201-primary-actions a:hover{transform:translateY(-1px);background:#283023}.staff-201-primary-actions .staff-201-action-main{background:#b68c2d;color:#19170f;border-color:#806018}.staff-201-primary-actions b{font-size:.9rem;letter-spacing:.06em}.staff-201-primary-actions span{margin-top:4px;font-size:.58rem;letter-spacing:.07em;opacity:.88}
.staff-201-quick-strip{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.staff-201-quick-strip a{padding:8px 10px;border:1px solid #77633a;color:#322a1c;background:#eadbb3;text-decoration:none;font-size:.65rem;font-weight:800;letter-spacing:.055em}.staff-201-quick-strip a:hover{background:#d8c28d}
.action-engine-status-strip{display:grid;grid-template-columns:auto auto 1fr;gap:8px;align-items:stretch;margin:0 0 12px;padding:9px}.action-engine-status-strip>a{display:flex;align-items:center;padding:9px 12px;background:#343c2c;color:#f3e7c4;text-decoration:none;font-size:.7rem;font-weight:800;letter-spacing:.06em}.action-engine-status-strip>span{justify-self:end;min-width:280px;padding:7px 10px;border:1px solid rgba(60,51,34,.28);background:rgba(238,224,185,.7)}.action-engine-status-strip small{display:block;font-size:.56rem;letter-spacing:.1em;font-weight:800}.action-engine-status-strip b{display:block;margin-top:2px;font-size:.74rem}.action-engine-status-strip em{display:block;margin-top:3px;font-size:.62rem;font-style:normal}.sync-current{color:#354a2e}.sync-pending{color:#80631c}.sync-failed{color:#793a2f}
.action-engine-pick{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.8fr);gap:22px;align-items:end}.action-engine-pick h2{margin:2px 0 4px}.action-engine-pick p{margin:0;max-width:720px;font-size:.78rem;line-height:1.45}.action-engine-selector{display:grid;gap:5px;font-size:.65rem;font-weight:800;letter-spacing:.07em}.action-engine-selector select{width:100%;padding:12px;background:#f0e4c4;border:1px solid #81714d;color:#211d14;font-weight:800}
@media(max-width:900px){.staff-201-command-status{grid-template-columns:1fr 1fr}.staff-201-primary-actions{grid-template-columns:1fr}.action-engine-pick{grid-template-columns:1fr}.action-engine-status-strip{grid-template-columns:1fr 1fr}.action-engine-status-strip>span{grid-column:1/-1;justify-self:stretch;min-width:0}}
@media(max-width:560px){.staff-201-command-hub{padding:16px 13px}.staff-201-command-status{grid-template-columns:1fr}.staff-201-quick-strip{display:grid;grid-template-columns:1fr 1fr}.staff-201-quick-strip a{text-align:center}.action-engine-status-strip{grid-template-columns:1fr}.action-engine-status-strip>span{grid-column:auto}}


/* 2026-08-22 — Staff 201 personnel-jacket cover: one clear individual action hub. */
.page-201 .staff-201-jacket-cover{
  position:relative;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.72fr);
  gap:22px;margin:12px 0 14px;padding:28px 30px 24px;border:2px solid #5d4d2e;
  background:linear-gradient(112deg,#d9c48e 0%,#eadcb7 48%,#d2bc83 100%);
  box-shadow:0 10px 24px rgba(20,22,16,.22),inset 0 0 0 1px rgba(255,248,223,.35);color:#2d2618;
}
.page-201 .staff-201-jacket-cover:before{content:"INDIVIDUAL 201 FILE";position:absolute;top:-14px;right:28px;padding:5px 14px 6px;background:#b89345;border:1px solid #5d4d2e;font-size:.58rem;font-weight:900;letter-spacing:.14em;color:#201a0f}
.page-201 .staff-201-jacket-identity{min-width:0;padding-right:22px;border-right:1px solid rgba(74,60,34,.36)}
.page-201 .staff-201-jacket-identity>small{display:block;font-size:.61rem;font-weight:900;letter-spacing:.13em;color:#775d22}
.page-201 .staff-201-jacket-identity h2{margin:8px 0 2px;font-size:clamp(2rem,3vw,3.35rem);line-height:.95;letter-spacing:.035em;color:#282216}
.page-201 .staff-201-jacket-subline{margin:8px 0 18px;font-size:.82rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#554527}
.page-201 .staff-201-jacket-facts{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}
.page-201 .staff-201-jacket-facts span{min-width:0;padding:10px 11px;border:1px solid rgba(72,57,31,.3);background:rgba(244,233,197,.52)}
.page-201 .staff-201-jacket-facts small{display:block;font-size:.54rem;font-weight:900;letter-spacing:.1em;color:#69552c}
.page-201 .staff-201-jacket-facts b{display:block;margin-top:4px;font-size:.75rem;line-height:1.25;overflow-wrap:anywhere}
.page-201 .staff-201-jacket-facts .is-current{border-left:4px solid #52643e}.page-201 .staff-201-jacket-facts .is-pending{border-left:4px solid #a27d22}.page-201 .staff-201-jacket-facts .is-error{border-left:4px solid #7e3c30}
.page-201 .staff-201-jacket-actions{display:grid;align-content:start;gap:9px}
.page-201 .staff-201-jacket-actions a{display:flex;flex-direction:column;justify-content:center;min-height:76px;padding:13px 15px;border:1px solid #1e2419;background:#333c2c;color:#f3e8c8;text-decoration:none;box-shadow:0 3px 0 rgba(32,26,15,.18)}
.page-201 .staff-201-jacket-actions a:hover{background:#283023;transform:translateY(-1px)}
.page-201 .staff-201-jacket-actions .staff-201-action-main{background:#b78d2f;color:#1f1a10;border-color:#72551b}
.page-201 .staff-201-jacket-actions b{font-size:.92rem;letter-spacing:.07em}.page-201 .staff-201-jacket-actions span{margin-top:5px;font-size:.55rem;line-height:1.35;letter-spacing:.07em;opacity:.88}
.page-201 .staff-201-jacket-shortcuts{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;padding-top:11px;border-top:1px solid rgba(72,57,31,.34)}
.page-201 .staff-201-jacket-shortcuts:before{content:"QUICK ACTIONS";display:flex;align-items:center;margin-right:4px;font-size:.55rem;font-weight:900;letter-spacing:.12em;color:#725b28}
.page-201 .staff-201-jacket-shortcuts a{padding:8px 11px;border:1px solid #6d5a34;background:#efe0b9;color:#332919;text-decoration:none;font-size:.63rem;font-weight:900;letter-spacing:.06em}
.page-201 .staff-201-jacket-shortcuts a:hover{background:#d9c38e}
.page-201 .staff-201-record-index{margin:0 0 14px;padding:7px 9px;background:rgba(43,48,35,.12);border:1px solid rgba(78,66,40,.25)}
.page-201 .file-document.document-sheet{box-shadow:0 2px 8px rgba(20,22,16,.10);border-color:rgba(86,73,44,.38)}
.page-201 .file-document.document-sheet:not(.current-situation-sheet){background:linear-gradient(180deg,rgba(239,228,196,.93),rgba(228,213,172,.91))}
.page-201 .file-document.document-sheet>header{opacity:.92}
@media(max-width:1100px){.page-201 .staff-201-jacket-cover{grid-template-columns:1fr}.page-201 .staff-201-jacket-identity{padding-right:0;border-right:0;border-bottom:1px solid rgba(74,60,34,.36);padding-bottom:17px}.page-201 .staff-201-jacket-facts{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:650px){.page-201 .staff-201-jacket-cover{padding:22px 14px 16px}.page-201 .staff-201-jacket-facts{grid-template-columns:1fr 1fr}.page-201 .staff-201-jacket-actions a{min-height:64px}.page-201 .staff-201-jacket-shortcuts{display:grid;grid-template-columns:1fr 1fr}.page-201 .staff-201-jacket-shortcuts:before{grid-column:1/-1}.page-201 .staff-201-jacket-shortcuts a{text-align:center}}

/* ========================================================================== */
/* WELCOME PACKET / ONBOARDING — 2026-08-22                                   */
/* ========================================================================== */
.welcome-nav-tab{position:relative}.welcome-nav-tab:after{content:'NEW SOLDIER';display:block;font-size:.55rem;letter-spacing:.12em;opacity:.65}
.member-welcome-alert{max-width:1500px;margin:18px auto;padding:16px 20px;border:2px solid #b69a53;background:linear-gradient(100deg,#d8c99f,#eee3c3);color:#201d15;display:flex;align-items:center;justify-content:space-between;gap:18px;box-shadow:0 8px 22px #0005}.member-welcome-alert div{display:grid;gap:3px}.member-welcome-alert small{letter-spacing:.13em}.member-welcome-alert b{font-size:1.25rem}.member-welcome-alert a{background:#2f3b22;color:#f3e8c5;padding:12px 18px;border:1px solid #151b11;text-decoration:none;font-weight:800;white-space:nowrap}
.welcome-packet-shell,.staff-onboarding-shell,.staff-welcome-file{width:min(1500px,calc(100% - 32px));margin:24px auto 70px}.welcome-packet-cover{background:linear-gradient(120deg,#c8b57f,#e8dbb5);color:#201d15;border:2px solid #655c3e;box-shadow:0 14px 30px #0007;padding:28px 32px;display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center;position:relative}.welcome-packet-cover:before{content:'S-1';position:absolute;right:24px;bottom:12px;font-size:5rem;font-weight:900;opacity:.05;transform:rotate(-7deg)}.welcome-packet-cover h1{margin:5px 0 8px;font-size:clamp(2rem,4vw,4rem);line-height:.95}.welcome-packet-cover p{max-width:850px;margin:0}.welcome-status-stamp{border:4px double #574f35;padding:14px 18px;min-width:220px;text-align:center;transform:rotate(-1deg);display:grid}.welcome-status-stamp span,.welcome-status-stamp em{font-size:.72rem;letter-spacing:.12em}.welcome-status-stamp b{font-size:1.2rem;margin:4px 0}
.welcome-assignment-strip{display:grid;grid-template-columns:1.4fr repeat(4,1fr);background:#24291d;color:#eee1b7;border:1px solid #77704f}.welcome-assignment-strip div{padding:13px 16px;border-right:1px solid #5d5d43;display:grid;gap:2px}.welcome-assignment-strip div:last-child{border-right:0}.welcome-assignment-strip small{opacity:.7;letter-spacing:.1em}.welcome-master-progress{height:12px;background:#11150f;border:1px solid #62684a;margin-top:16px}.welcome-master-progress span{display:block;height:100%;background:#8d9b55}.welcome-current-order{background:#171b13;color:#ddd0a9;border-left:5px solid #9a844b;padding:14px 18px;margin:0 0 18px}.welcome-phase-roadmap{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.welcome-roadmap-stop{border:1px solid #5f6246;background:#282d20;color:#d8cca6;padding:12px 15px;display:grid;gap:2px}.welcome-roadmap-stop.is-current{outline:2px solid #b79a52}.welcome-roadmap-stop.is-complete{background:#344028}.welcome-roadmap-stop.is-locked{opacity:.55}.welcome-roadmap-stop span{font-size:.75rem;opacity:.75}
.welcome-phase{margin:20px 0;background:#cdbd91;color:#201d15;border:2px solid #625a40;box-shadow:0 10px 24px #0005}.welcome-phase>header{padding:16px 20px;background:#b8a675;border-bottom:1px solid #665f45;display:flex;justify-content:space-between;align-items:center}.welcome-phase h2{margin:2px 0 0}.welcome-phase>header strong{font-size:1.6rem}.welcome-phase-lock{padding:12px 18px;background:#575845;color:#eee0b9;font-weight:800;letter-spacing:.05em}.welcome-task-list{padding:8px}.welcome-task{display:grid;grid-template-columns:42px 1fr minmax(170px,230px);align-items:center;gap:12px;padding:13px 14px;border-bottom:1px solid #948661;background:#e4d6ad}.welcome-task:last-child{border-bottom:0}.welcome-task--complete,.welcome-task--waived{background:#cbd2ac}.welcome-task--locked{background:#b8af93;opacity:.7}.welcome-task-mark{width:32px;height:32px;border:2px solid #554e38;display:grid;place-items:center;font-weight:900}.welcome-task h3{margin:2px 0 3px}.welcome-task p{margin:0;max-width:900px}.welcome-task em{font-size:.72rem}.welcome-task-action{text-align:right}.welcome-task-action a,.welcome-task-action button,.welcome-task-action b{display:inline-block;background:#303c24;color:#f0e6c8;border:1px solid #151a11;padding:10px 13px;text-decoration:none;font-weight:800;font:inherit;cursor:pointer}.welcome-task-action span{font-size:.75rem;font-weight:800}
.staff-onboarding-head{display:flex;justify-content:space-between;align-items:end;gap:20px;background:#c7b783;color:#201d15;border:2px solid #5d563e;padding:22px}.staff-onboarding-head h1{margin:3px 0}.staff-onboarding-head a{background:#303a25;color:#eee2be;padding:11px 14px;text-decoration:none;font-weight:800}.staff-onboarding-table{margin-top:14px;border:1px solid #5c6044;background:#20251a}.staff-onboarding-row{display:grid;grid-template-columns:1.35fr 1.1fr 1.25fr .8fr .9fr 1fr;gap:0;color:#ddd1ac;border-bottom:1px solid #4f533c}.staff-onboarding-row>span{padding:12px 13px;border-right:1px solid #474b37;display:grid;gap:2px;align-content:center}.staff-onboarding-row--head{background:#414733;color:#f3e7c4;font-size:.72rem;font-weight:900;letter-spacing:.09em}.staff-onboarding-row small{opacity:.68}.staff-onboarding-row a{color:#f0dfa7;font-weight:800;text-decoration:none;margin:2px 0}.staff-onboarding-progress{height:6px;background:#11150f;margin-top:6px}.staff-onboarding-progress i{display:block;height:100%;background:#9ca667}
.staff-welcome-file>header{display:flex;justify-content:space-between;gap:20px;align-items:center;background:#c8b986;color:#211e16;border:2px solid #625b41;padding:22px}.staff-welcome-file>header>div:last-child{display:grid;text-align:right;gap:4px}.staff-welcome-file>header a{background:#303b25;color:#eee2be;text-decoration:none;padding:8px 11px}.staff-welcome-phase{margin-top:14px;border:1px solid #5b6044;background:#22271c;color:#ded2ae}.staff-welcome-phase>header{display:flex;justify-content:space-between;padding:13px 16px;background:#3a402f}.staff-welcome-task{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;padding:11px 14px;border-top:1px solid #4e523c}.staff-welcome-task form{display:flex;gap:6px}.staff-welcome-task button{background:#c7b783;border:1px solid #635b40;padding:7px 9px;font-weight:800;cursor:pointer}.staff-201-onboarding-card{margin:10px 0 16px;padding:13px 15px;background:#344027;color:#eee1bb;border:1px solid #697052;display:flex;justify-content:space-between;align-items:center;gap:16px}.staff-201-onboarding-card div{display:grid;gap:2px}.staff-201-onboarding-card a{color:#f0dfa7;text-decoration:none;font-weight:900}
@media(max-width:900px){.welcome-packet-cover{grid-template-columns:1fr}.welcome-status-stamp{justify-self:start}.welcome-assignment-strip{grid-template-columns:1fr 1fr}.welcome-phase-roadmap{grid-template-columns:1fr}.welcome-task{grid-template-columns:38px 1fr}.welcome-task-action{grid-column:2;text-align:left}.staff-onboarding-row{grid-template-columns:1fr 1fr}.staff-onboarding-row--head{display:none}.member-welcome-alert,.staff-onboarding-head,.staff-welcome-file>header,.staff-201-onboarding-card{align-items:stretch;flex-direction:column}.staff-welcome-task{grid-template-columns:30px 1fr}.staff-welcome-task form{grid-column:2;flex-wrap:wrap}}
.orientation-record-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.orientation-record-grid span{border:1px solid #8b7d56;background:#e2d3a8;padding:10px;display:grid;gap:3px}.orientation-record-actions{margin-top:12px}.orientation-record-actions a{display:inline-block;background:#303b25;color:#eee2be;text-decoration:none;padding:9px 12px;font-weight:800}@media(max-width:800px){.orientation-record-grid{grid-template-columns:1fr 1fr}}

/* 2026-08-22 member cleanup: training board readability and simple operations */
.page-training .instructor-board{color:#272419!important;background:linear-gradient(180deg,rgba(243,236,221,.98),rgba(220,209,180,.96))!important;border-color:#4d493c!important}
.page-training .instructor-board header{color:#5b461b!important;font-size:11px!important}
.page-training .instructor-board p{color:#272419!important;border-bottom-color:rgba(55,48,35,.45)!important;font-weight:700!important;font-size:10px!important}
.page-training .instructor-board small{color:#4d493c!important;font-weight:700!important}
.member-operations-simple{padding-top:28px}.member-op-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;padding:14px 0;border-bottom:1px dashed rgba(48,42,32,.3)}.member-op-row>div{display:grid;gap:3px}.member-op-row small{font-size:.7rem;letter-spacing:.08em}.member-op-row b{font-size:1.05rem}.member-op-row span{font-size:.78rem;opacity:.82}.member-op-row>div:last-child{text-align:right}.member-op-row strong{font-size:.82rem;letter-spacing:.07em}@media(max-width:650px){.member-op-row{grid-template-columns:1fr}.member-op-row>div:last-child{text-align:left}}

/* === Unified Duty & Command Experience — 2026-08-22 === */
.member-duty-desk{margin:18px auto 22px;max-width:1500px;padding:18px;border:1px solid rgba(210,198,155,.35);background:rgba(29,32,24,.94);box-shadow:0 12px 30px rgba(0,0,0,.2)}
.member-duty-desk__header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;border-bottom:1px solid rgba(210,198,155,.25);padding-bottom:12px;margin-bottom:12px}
.member-duty-desk__header small,.member-duty-desk__header h2,.member-duty-desk__header p{margin:0}.member-duty-desk__header small{font-family:'Oswald',sans-serif;letter-spacing:.14em;color:#cbbf91}.member-duty-desk__header h2{font-family:'Stardos Stencil',serif;font-size:clamp(1.25rem,2vw,2rem);color:#f0e8cb;margin-top:4px}.member-duty-desk__header p{max-width:820px;color:#cbc4aa;margin-top:5px;line-height:1.45}
.member-duty-state{flex:0 0 auto;padding:9px 12px;border:1px solid rgba(255,255,255,.2);font-family:'Oswald',sans-serif;font-weight:700;letter-spacing:.08em;background:#6e5a2d;color:#fff}.member-duty-state.is-clear{background:#46533c}.member-duty-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.member-duty-item{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:13px 14px;border:1px solid rgba(210,198,155,.24);background:rgba(240,232,203,.06);text-decoration:none;color:#eee6c9;transition:.15s ease}.member-duty-item:hover{transform:translateY(-1px);border-color:rgba(226,211,150,.62);background:rgba(240,232,203,.1)}.member-duty-item span{display:grid;gap:3px;min-width:0}.member-duty-item small{font-family:'Oswald',sans-serif;color:#bdb28d;letter-spacing:.08em}.member-duty-item b{font-size:.98rem}.member-duty-item em{font-style:normal;color:#c8c0a4;font-size:.86rem;white-space:normal}.member-duty-item>strong{font-family:'Oswald',sans-serif;font-size:.82rem;white-space:nowrap;color:#e1cf87}.member-duty-item.priority-high,.member-duty-item.priority-urgent{border-left:4px solid #b17a42}.member-duty-item.priority-watch{border-left:4px solid #8c844d}.member-duty-clear{padding:18px;text-align:center;border:1px dashed rgba(210,198,155,.24);color:#cec6a9}.member-duty-clear b,.member-duty-clear span{display:block}.member-duty-clear span{margin-top:4px;font-size:.9rem}

.staff-automation-strip{display:grid;grid-template-columns:minmax(220px,1.2fr) repeat(4,minmax(145px,1fr));gap:9px;margin:0 0 14px}.staff-automation-title,.staff-automation-state{padding:12px 13px;border:1px solid rgba(89,77,48,.3);background:#e5dcc1}.staff-automation-title{display:grid;gap:2px}.staff-automation-title small,.staff-automation-state small{font-family:'Oswald',sans-serif;letter-spacing:.09em;color:#675f4c}.staff-automation-title b{font-family:'Stardos Stencil',serif}.staff-automation-title span{font-size:.78rem;color:#6b6556}.staff-automation-state{display:grid;gap:2px;text-decoration:none;color:#27271f}.staff-automation-state b{font-family:'Oswald',sans-serif;letter-spacing:.06em}.staff-automation-state span{font-size:.75rem;color:#655f50}.staff-automation-state.state-current{border-left:5px solid #596a49}.staff-automation-state.state-pending,.staff-automation-state.state-watch{border-left:5px solid #a18135}.staff-automation-state.state-error{border-left:5px solid #8d3f35;background:#ead8c4}
.staff-search-result-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.staff-search-result-actions a,.staff-search-result-actions button{appearance:none;border:1px solid #544d3b;background:#34392d;color:#f0e7c8;padding:9px 11px;font-family:'Oswald',sans-serif;font-weight:700;letter-spacing:.04em;text-decoration:none;cursor:pointer}.staff-search-result-actions button{background:#6a6044}.staff-advanced-tools{margin:14px 0;border:1px solid rgba(76,67,44,.35);background:rgba(229,220,193,.45)}.staff-advanced-tools>summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;list-style:none;background:#d6cbaa;border-bottom:1px solid transparent}.staff-advanced-tools[open]>summary{border-bottom-color:rgba(76,67,44,.35)}.staff-advanced-tools>summary::-webkit-details-marker{display:none}.staff-advanced-tools>summary span{display:grid;gap:2px}.staff-advanced-tools>summary small{font-family:'Oswald',sans-serif;letter-spacing:.09em;color:#6b624c}.staff-advanced-tools>summary b{font-family:'Stardos Stencil',serif;color:#2d3028}.staff-advanced-tools>summary em{font-style:normal;font-family:'Oswald',sans-serif;font-size:.8rem;color:#5d5848}.staff-advanced-tools>.document-sheet,.staff-advanced-tools>.staff-deep-control{margin:0;border:0;box-shadow:none}

@media(max-width:1050px){.staff-automation-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.staff-automation-title{grid-column:1/-1}.member-duty-list{grid-template-columns:1fr}}
@media(max-width:700px){.member-duty-desk__header{flex-direction:column}.member-duty-state{align-self:flex-start}.staff-automation-strip{grid-template-columns:1fr}.staff-automation-title{grid-column:auto}.staff-search-result-actions{justify-content:flex-start}}

/* M16 authoritative maintenance confirmation */
.weapon-clean-confirmation{margin:10px 0 16px;padding:10px 14px;border:1px solid rgba(92,107,65,.55);background:rgba(230,223,191,.72);display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}.weapon-clean-confirmation b{letter-spacing:.08em}.weapon-clean-confirmation span{font-size:.86rem;opacity:.85}

/* Awards guidance expansion — 2026-08-22 */
.public-award-guidance{margin-top:14px;padding-top:12px;border-top:1px solid rgba(55,49,38,.24)}
.public-award-guidance h4{margin:0 0 6px;font-size:.76rem;letter-spacing:.08em;font-weight:800;color:#3d392f}
.public-award-guidance p{margin:0;line-height:1.55;color:#2f2c25}
.public-award-guidance--earn{background:rgba(88,79,56,.055);padding:12px 14px;border:1px solid rgba(55,49,38,.16);border-radius:2px}
.public-award-rule{margin-top:12px;padding:9px 11px;border-left:3px solid rgba(55,49,38,.42);display:grid;gap:3px;background:rgba(255,255,255,.18)}
.public-award-rule b{font-size:.69rem;letter-spacing:.08em;color:#4b463a}
.public-award-rule span{font-size:.86rem;line-height:1.45;color:#373229}


/* 2026-08-22 — 1965 Interactive Awards & Decorations */
.public-award-card.is-clickable{cursor:pointer;transition:transform .14s ease,box-shadow .14s ease}.public-award-card.is-clickable:hover,.public-award-card.is-clickable:focus{transform:translateY(-2px);box-shadow:0 10px 22px rgba(21,19,13,.2);outline:2px solid rgba(125,98,42,.45);outline-offset:2px}
.award-modal-open{overflow:hidden}.award-detail-modal{position:fixed;inset:0;z-index:220;display:none;place-items:center;padding:24px}.award-detail-modal[aria-hidden="false"]{display:grid}.award-detail-backdrop{position:absolute;inset:0;border:0;background:rgba(12,14,10,.82);cursor:pointer}.award-detail-sheet{position:relative;z-index:2;width:min(780px,94vw);max-height:88vh;overflow:auto;padding:30px 32px;background:linear-gradient(180deg,#eadcb5,#d8c58f);border:2px solid #655331;box-shadow:0 24px 65px rgba(0,0,0,.55);color:#2b2518;font-family:'Courier Prime',monospace}.award-detail-sheet>small{display:block;letter-spacing:.11em;font-weight:700;color:#705a2d}.award-detail-sheet>img{display:block;width:min(300px,70%);height:auto;margin:24px auto 14px;filter:drop-shadow(0 5px 4px rgba(0,0,0,.22))}.award-detail-sheet h2{text-align:center;margin:7px 0 18px;font-family:'Stardos Stencil',serif;font-size:clamp(27px,4vw,42px)}.award-detail-type{display:table;margin:0 auto 5px;padding:5px 9px;border:1px solid #6a5733;font-weight:900;font-size:10px;letter-spacing:.11em}.award-detail-close{position:absolute;right:12px;top:10px;width:38px;height:38px;border:1px solid #5e4e31;background:#efe2bd;color:#30271a;font-size:24px;cursor:pointer}.award-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}.award-detail-grid>div,.award-detail-rule,.award-history-register,.award-detail-progress{padding:14px;border:1px solid rgba(80,65,37,.38);background:rgba(249,238,203,.42)}.award-detail-grid b,.award-detail-rule b,.award-history-register>b,.award-detail-progress>b{display:block;margin-bottom:6px;font-size:10px;letter-spacing:.1em;color:#654e22}.award-detail-grid p,.award-detail-rule span{margin:0;font-size:12px;line-height:1.55}.member-award-status-line{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:0 0 12px}.member-award-status-line span{padding:6px 8px;border:1px solid rgba(80,65,37,.42);font-size:10px;font-weight:900}.award-detail-progress>div{height:11px;margin:7px 0;background:rgba(65,56,35,.16);border:1px solid rgba(64,53,31,.35);overflow:hidden}.award-detail-progress i{display:block;height:100%;width:0;background:#55623f;transition:width .2s ease}.award-detail-progress span{font-size:11px}.award-history-register p{display:grid;gap:3px;padding:9px 0;margin:0;border-bottom:1px dotted rgba(77,64,39,.38)}.award-history-register p:last-child{border-bottom:0}.award-history-register p b{font-size:11px}.award-history-register p span,.award-history-register p small{font-size:10px}.ribbon-rack-button{display:inline-flex!important;padding:0!important;margin:0!important;border:0!important;background:transparent!important;line-height:0!important;cursor:pointer}.ribbon-rack-button:hover img,.ribbon-rack-button:focus img{outline:1px solid #d3b45c;outline-offset:1px;filter:brightness(1.12)}.member-ribbon-status-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.member-ribbon-status{display:grid;grid-template-columns:96px 1fr auto;gap:10px;align-items:center;text-align:left;padding:10px;border:1px solid rgba(78,65,39,.36);background:rgba(235,221,180,.45);color:#2c2517;cursor:pointer}.member-ribbon-status img{width:90px;height:27px;object-fit:fill}.member-ribbon-status span{display:grid;gap:3px}.member-ribbon-status b{font-size:12px}.member-ribbon-status small{font-size:9px;line-height:1.35}.member-ribbon-status em{font-style:normal;font-size:10px;font-weight:900}.member-ribbon-status.is-earned{border-left:5px solid #53623d}.member-ribbon-status.is-progress{border-left:5px solid #9a7a35}.award-eligibility-board{margin:15px 0;padding:15px;border:2px solid rgba(76,62,35,.5);background:rgba(230,216,176,.44)}.award-eligibility-board>header{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;border-bottom:1px solid rgba(76,62,35,.38);padding-bottom:8px}.award-eligibility-board>header span,.award-eligibility-board>header small{font-size:9px;letter-spacing:.09em}.award-eligibility-board>header strong{font-family:'Stardos Stencil',serif;font-size:22px}.award-eligibility-board>p{font-size:10px;line-height:1.5}.award-eligibility-columns{display:grid;grid-template-columns:1fr 1fr;gap:12px}.award-eligibility-columns>div{padding:10px;border:1px solid rgba(78,66,41,.3);background:rgba(246,236,204,.34)}.award-eligibility-columns h3{margin:0 0 7px;font-size:12px;letter-spacing:.08em}.award-eligibility-columns a{display:grid;gap:2px;padding:8px 4px;border-bottom:1px dotted rgba(70,59,38,.35);text-decoration:none;color:#2d2618}.award-eligibility-columns a b{font-size:11px}.award-eligibility-columns a span{font-size:10px;font-weight:800}.award-eligibility-columns a small{font-size:9px;line-height:1.35}
@media(max-width:700px){.award-detail-sheet{padding:24px 15px}.award-detail-grid,.award-eligibility-columns,.member-ribbon-status-grid{grid-template-columns:1fr}.member-ribbon-status{grid-template-columns:80px 1fr auto}.member-ribbon-status img{width:76px;height:23px}}

.recent-decoration-register{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.recent-decoration-register article{display:grid;gap:4px;padding:13px 14px;border:1px solid rgba(79,66,39,.34);background:rgba(231,217,178,.34)}.recent-decoration-register article b{font-size:12px}.recent-decoration-register article span{font-family:'Stardos Stencil',serif;font-size:16px}.recent-decoration-register article small{font-size:9px;letter-spacing:.06em}@media(max-width:800px){.recent-decoration-register{grid-template-columns:1fr}}

/* 1965 Battalion Integrity Engine / workflow tightening */
.integrity-command-strip{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;margin:0 0 18px;padding:16px 18px;border:1px solid rgba(42,48,34,.35);background:rgba(238,228,194,.9);box-shadow:0 7px 18px rgba(0,0,0,.13)}
.integrity-command-title small,.integrity-command-title b,.integrity-command-title span{display:block}.integrity-command-title b{font-size:1.08rem;letter-spacing:.08em}.integrity-command-title span{margin-top:4px;max-width:900px}.integrity-command-counts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.integrity-command-counts span,.integrity-command-counts a{padding:8px 10px;border:1px solid rgba(0,0,0,.25);text-decoration:none;background:#efe5c8}.integrity-command-counts b{font-size:1.15rem}.integrity-red{border-left:4px solid #6f241c!important}.integrity-amber{border-left:4px solid #8a671b!important}
.staff-integrity-change-grid{margin-top:18px}.staff-integrity-preview .staff-action-row{width:100%;text-align:left}.staff-change-feed{min-width:0}
.member-milestone-board{margin:18px auto 24px;max-width:1440px;padding:16px 18px;background:rgba(229,217,180,.94);border:1px solid rgba(45,43,30,.4);box-shadow:0 8px 22px rgba(0,0,0,.16)}.member-milestone-board>header{display:flex;justify-content:space-between;gap:18px;align-items:end;border-bottom:1px solid rgba(0,0,0,.28);padding-bottom:10px;margin-bottom:12px}.member-milestone-board>header small,.member-milestone-board>header h2{display:block;margin:0}.member-milestone-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.member-milestone-grid>a{position:relative;display:flex;flex-direction:column;gap:4px;min-width:0;padding:12px;border:1px solid rgba(0,0,0,.24);background:rgba(250,245,226,.7);text-decoration:none;color:inherit}.member-milestone-grid small,.member-milestone-grid b,.member-milestone-grid span{display:block}.member-milestone-grid span{font-size:.85rem}.member-milestone-grid em{display:block;height:6px;background:rgba(0,0,0,.12);margin-top:6px;overflow:hidden}.member-milestone-grid em i{display:block;height:100%;background:currentColor;opacity:.5}.member-milestone-grid strong{font-size:.76rem;letter-spacing:.08em}
.system-health-board{max-width:1480px;margin:22px auto;padding:18px;background:rgba(232,221,188,.95);border:1px solid rgba(35,35,26,.45);box-shadow:0 10px 28px rgba(0,0,0,.17)}.system-health-board>header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;border-bottom:2px solid rgba(0,0,0,.34);padding-bottom:13px}.system-health-board h1{margin:.15rem 0}.system-health-stamp{padding:10px 12px;border:2px solid currentColor;font-weight:800;letter-spacing:.1em;transform:rotate(-1deg)}.system-health-stamp.attention{color:#702a20}.system-health-stamp.clear{color:#33472a}.system-health-checks{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:14px 0}.system-health-checks article{padding:10px;border:1px solid rgba(0,0,0,.22);background:rgba(250,246,229,.7)}.system-health-checks small,.system-health-checks b,.system-health-checks span{display:block}.system-health-checks .health-action-required,.system-health-checks .health-check-failed{border-left:5px solid #702a20}.system-health-exceptions>header{display:flex;gap:14px;align-items:baseline;margin:12px 0}.system-health-row{display:flex;justify-content:space-between;gap:16px;padding:10px 12px;border-top:1px solid rgba(0,0,0,.2);text-decoration:none;color:inherit}.system-health-row span>*{display:block}.system-health-row em{font-style:normal;font-size:.86rem}.system-health-row.severity-red{border-left:5px solid #702a20}.system-health-row.severity-amber{border-left:5px solid #8a671b}
@media(max-width:900px){.integrity-command-strip,.member-milestone-board>header,.system-health-board>header{grid-template-columns:1fr;display:grid}.integrity-command-counts{justify-content:flex-start}.member-milestone-grid,.system-health-checks{grid-template-columns:1fr 1fr}.system-health-row{flex-direction:column}}@media(max-width:560px){.member-milestone-grid,.system-health-checks{grid-template-columns:1fr}}

/* 2026-08-22 critical member/command regression pass */
@media (min-width: 1100px){
  .command-global-bar-inner{
    width:100%!important;max-width:none!important;padding:7px 12px!important;
    overflow-x:visible!important;display:flex!important;flex-wrap:nowrap!important;gap:5px!important;
  }
  .command-global-label{flex:0 0 108px!important;min-width:0!important}
  .command-global-bar-inner>a{
    flex:1 1 0!important;min-width:0!important;max-width:none!important;
    padding:9px 6px!important;text-align:center!important;overflow:hidden!important;
  }
  .command-global-bar-inner>a b{display:block;font-size:clamp(8px,.68vw,11px)!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
  .command-global-bar-inner>a small{display:block;font-size:clamp(6px,.52vw,8px)!important;line-height:1.2!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
  .command-global-bar{overflow:visible!important}
  .command-global-bar-inner::-webkit-scrollbar{display:none!important}
}

/* Text must stay inside documents and command cards. */
.document-sheet,.recruit-command-case,.recruit-compact-case,.recruit-archive-file,
.staff-center-shell,.staff-office-grid,.staff-brief-strip,.member-action-card,
.form-grid dd,.recruit-answer-grid b,.recruit-written-answer p,.recruit-archive-grid b,
.recruit-archive-written p,.entry-row,.jacket-card,.tour-control-card,.duty-status-card{
  min-width:0;overflow-wrap:anywhere;word-break:normal;
}
.recruit-answer-grid,.recruit-archive-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))!important}
.recruit-written-answer p,.recruit-archive-written p{white-space:normal!important;line-height:1.55!important;margin-bottom:0!important}
.recruit-case-heading{gap:12px;align-items:flex-start}.recruit-case-heading>div{min-width:0}.recruit-case-heading h3{overflow-wrap:anywhere}
.recruit-command-actions label{min-width:0}.recruit-command-actions textarea{width:100%;max-width:100%;resize:vertical}
.recruit-decision-buttons{display:flex;flex-wrap:wrap;gap:8px}.recruit-decision-buttons button{min-height:42px;white-space:normal}

.recruit-delete-control{margin-top:14px;border-top:1px dashed rgba(77,48,34,.45);padding-top:10px}
.recruit-delete-control summary{cursor:pointer;font-weight:800;color:#672b22;letter-spacing:.06em}
.recruit-delete-control form,.recruit-delete-file form{display:grid;gap:10px;margin-top:10px}
.recruit-delete-control input,.recruit-delete-file input{width:100%;max-width:420px;padding:9px;background:#f0e7cf;border:1px solid #6e6048;color:#211d16}
.danger-delete{background:#6f281f!important;color:#f6ead0!important;border:1px solid #3e1712!important;font-weight:800!important}
.recruit-compact-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.recruit-compact-actions form{margin:0}.recruit-compact-actions button{cursor:pointer}
.recruit-delete-file{margin-top:16px;border:2px solid #71342b!important}

/* Member navigation and member records: stable spacing/readability. */
.page-member-record main,.page-personnel-file main,.page-member-action-center main{min-width:0}
.file-jacket-summary,.form-grid,.replacement-file-grid,.promotion-requirement-list{min-width:0}
.record-form,.document-sheet{max-width:100%}
.form-grid dt,.form-grid dd{line-height:1.4}
.member-action-card p,.member-action-card small,.member-action-card b{white-space:normal;overflow-wrap:anywhere}

/* 2026-08-22 MEMBER UI ALIGNMENT + CONTRAST HOTFIX */
/* My Squad: keep page heading aligned to the same centered records frame as the roster. */
.page-my-squad .records-room-heading.my-soldiers-heading{
  width:min(1500px,calc(100% - 30px));
  max-width:none;
  margin:34px auto 0;
  padding:0 0 18px;
  box-sizing:border-box;
}
.page-my-squad .records-room-heading.my-soldiers-heading>div{
  padding:0 14px;
  box-sizing:border-box;
}
.page-my-squad .my-soldiers-room{
  width:min(1500px,calc(100% - 30px));
  max-width:none;
  margin:0 auto 72px;
  padding:0;
  box-sizing:border-box;
}

/* My Actions: force readable dark ink on the recommendation document. */
.next-action-card{
  background:#e4d5ae;
  border:2px solid #77704c;
  color:#272117 !important;
}
.next-action-card small,
.next-action-card h1,
.next-action-card h2,
.next-action-card h3,
.next-action-card p,
.next-action-card strong,
.next-action-card b,
.next-action-card span{
  color:#272117 !important;
  text-shadow:none !important;
}
.next-action-card small{
  opacity:.82;
  letter-spacing:.07em;
}
.next-action-card p{
  line-height:1.55;
}
.next-action-card a{
  background:#343d2d;
  color:#f4e9c8 !important;
  border:1px solid #1c2319;
}
.next-action-card a:hover,
.next-action-card a:focus-visible{
  background:#46513b;
  color:#fff4d2 !important;
  outline:2px solid #b99335;
  outline-offset:2px;
}

@media(max-width:620px){
  .page-my-squad .records-room-heading.my-soldiers-heading,
  .page-my-squad .my-soldiers-room{
    width:calc(100% - 20px);
  }
  .page-my-squad .records-room-heading.my-soldiers-heading{
    margin-top:18px;
  }
}

/* 2026-08-22 Wall Locker readability polish — preserve full-resolution assets. */
/* Clickable award ribbons must retain normal ribbon-rack display dimensions. */
.locker-award-citation>.ribbon-rack-button{
  width:110px!important;
  min-width:110px!important;
  height:38px!important;
  align-self:start!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  overflow:hidden!important;
}
.locker-award-citation>.ribbon-rack-button img{
  display:block!important;
  width:104px!important;
  height:35px!important;
  max-width:104px!important;
  max-height:35px!important;
  object-fit:contain!important;
}
.locker-award-citation{
  grid-template-columns:120px minmax(0,1fr)!important;
  align-items:start!important;
}

/* Next Milestones uses dark field-document ink, never inherited white member text. */
.member-milestone-board,
.member-milestone-board>header,
.member-milestone-board>header small,
.member-milestone-board>header h2,
.member-milestone-board>header span{
  color:#2b2518!important;
}
.member-milestone-board>header small{
  color:#6e592f!important;
  font-weight:800!important;
  letter-spacing:.08em!important;
}
.member-milestone-board>header h2{
  color:#262015!important;
  text-shadow:none!important;
}
.member-milestone-board>header>span{
  color:#5e5033!important;
  font-weight:800!important;
}
.member-milestone-grid>a,
.member-milestone-grid>a:link,
.member-milestone-grid>a:visited{
  color:#2b2518!important;
}
.member-milestone-grid>a small{
  color:#795e2c!important;
  font-weight:800!important;
  letter-spacing:.06em!important;
}
.member-milestone-grid>a b{
  color:#302719!important;
  text-shadow:none!important;
}
.member-milestone-grid>a span{
  color:#574832!important;
}
.member-milestone-grid>a strong{
  color:#493b27!important;
}
.member-milestone-grid>a em{
  background:rgba(54,45,29,.16)!important;
}
.member-milestone-grid>a em i{
  background:#5a6542!important;
  opacity:1!important;
}

@media(max-width:900px){
  .locker-award-citation{grid-template-columns:1fr!important}
  .locker-award-citation>.ribbon-rack-button{width:120px!important;height:42px!important}
  .locker-award-citation>.ribbon-rack-button img{width:116px!important;height:39px!important;max-width:116px!important;max-height:39px!important}
}

/* 2026-08-22 R2: final Wall Locker readability guard; loaded through cache-busted stylesheet URL. */
body.page-member-record .locker-award-citations article.locker-award-citation > button.ribbon-rack-button {
  width: 104px !important;
  min-width: 104px !important;
  max-width: 104px !important;
  height: 36px !important;
  min-height: 36px !important;
  max-height: 36px !important;
  padding: 0 !important;
  margin: 2px 0 0 !important;
  overflow: hidden !important;
}
body.page-member-record .locker-award-citations article.locker-award-citation > button.ribbon-rack-button > img {
  width: 100px !important;
  min-width: 100px !important;
  max-width: 100px !important;
  height: 33px !important;
  min-height: 33px !important;
  max-height: 33px !important;
  object-fit: contain !important;
  margin: 0 !important;
}
body.page-member-record section.member-milestone-board,
body.page-member-record section.member-milestone-board * {
  text-shadow: none !important;
}
body.page-member-record section.member-milestone-board > header,
body.page-member-record section.member-milestone-board > header *,
body.page-member-record section.member-milestone-board .member-milestone-grid > a,
body.page-member-record section.member-milestone-board .member-milestone-grid > a * {
  color: #2b2518 !important;
}
body.page-member-record section.member-milestone-board > header small,
body.page-member-record section.member-milestone-board .member-milestone-grid > a small {
  color: #72582c !important;
}
body.page-member-record section.member-milestone-board .member-milestone-grid > a span {
  color: #51432e !important;
}


/* HLL: Vietnam RCON telemetry display — 2026-08-22 */
.hll-field-service-card,.hll-server-board,.hll-operation-telemetry{max-width:1500px;margin:18px auto;padding:18px 22px;background:#d8c79f;border:1px solid rgba(47,45,29,.45);box-shadow:0 8px 24px rgba(0,0,0,.18);color:#222116}
.hll-field-service-card header,.hll-server-board header,.hll-operation-telemetry header{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;border-bottom:2px solid rgba(47,45,29,.42);padding-bottom:10px;margin-bottom:14px}
.hll-field-service-card header small,.hll-server-board header small,.hll-operation-telemetry header small{color:#4b4a31;font-weight:800;letter-spacing:.11em}
.hll-field-service-card h2,.hll-server-board h2,.hll-operation-telemetry h2{margin:2px 0 0;color:#1d1d14}
.hll-link-state{padding:7px 10px;border:1px solid #665f3b;font-weight:900;letter-spacing:.08em}.hll-link-state.is-linked{background:#48512d;color:#fff}.hll-link-state.not-linked{background:#7e372e;color:#fff}
.hll-service-grid,.hll-record-summary,.hll-server-strip,.hll-op-summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}
.hll-service-grid>span,.hll-record-summary>span,.hll-server-strip>span,.hll-op-summary>span{display:flex;min-width:0;flex-direction:column;padding:11px;background:rgba(255,251,230,.5);border:1px solid rgba(61,57,35,.25)}
.hll-service-grid small,.hll-record-summary span,.hll-server-strip span,.hll-op-summary span{color:#45442e}.hll-service-grid b,.hll-record-summary b,.hll-server-strip b,.hll-op-summary b{font-size:1.12rem;color:#17170f;overflow-wrap:anywhere}
.hll-service-footer{display:grid;grid-template-columns:1fr auto;gap:4px 18px;align-items:center;margin-top:12px}.hll-service-footer span{color:#45442e}.hll-service-footer a{grid-column:2;grid-row:1/3;background:#32371f;color:#fff;padding:10px 14px;text-decoration:none;font-weight:900}
.hll-unlinked-note,.hll-server-offline{display:flex;flex-direction:column;gap:5px;padding:14px;background:rgba(255,251,230,.48);border-left:5px solid #7e372e;color:#2b2a1b}.hll-unlinked-note code{background:rgba(0,0,0,.08);padding:1px 4px}
.hll-combat-record{scroll-margin-top:90px}.hll-record-summary{grid-template-columns:repeat(4,minmax(0,1fr))}.hll-score-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}.hll-score-strip span{padding:8px 10px;background:rgba(59,61,37,.12);color:#252518}.hll-round-ledger,.hll-op-ledger{display:grid;gap:4px;margin-top:10px}.hll-round-ledger .head,.hll-round-ledger .row{display:grid;grid-template-columns:2fr 1.1fr .7fr .9fr .65fr .8fr;gap:8px;align-items:center;padding:8px 10px}.hll-round-ledger .head,.hll-op-ledger .head{background:#3d4227;color:#fff;font-weight:900}.hll-round-ledger .row,.hll-op-ledger .row{border-bottom:1px solid rgba(40,39,24,.24);color:#222116}.hll-round-ledger .row span:first-child,.hll-op-ledger .row span:first-child{display:flex;flex-direction:column}.hll-round-ledger small,.hll-op-ledger small{color:#5a583a}
.hll-server-strip{grid-template-columns:.7fr 2fr 1.2fr 1fr .65fr}.hll-operation-telemetry{margin-top:16px}.hll-op-summary{grid-template-columns:repeat(6,minmax(0,1fr));margin-bottom:12px}.hll-op-ledger .head,.hll-op-ledger .row{display:grid;grid-template-columns:2fr .75fr .9fr .7fr .55fr;gap:8px;align-items:center;padding:8px 10px}
@media(max-width:900px){.hll-service-grid,.hll-record-summary,.hll-op-summary{grid-template-columns:repeat(2,1fr)}.hll-server-strip{grid-template-columns:1fr 1fr}.hll-service-footer{grid-template-columns:1fr}.hll-service-footer a{grid-column:auto;grid-row:auto}.hll-round-ledger,.hll-op-ledger{overflow-x:auto}.hll-round-ledger .head,.hll-round-ledger .row{min-width:760px}.hll-op-ledger .head,.hll-op-ledger .row{min-width:650px}}

/* 2026-08-22 HLLV RCON member command board — server-backed data replaces generic activity tiles. */
.hll-field-command-board{background:linear-gradient(180deg,#d9c89f,#cdbb8f);border:2px solid rgba(43,42,27,.58)}
.hll-link-state.is-live{background:#36452d;color:#f4edcf;border-color:#1e2d1c;box-shadow:0 0 0 2px rgba(255,255,255,.12) inset}
.hll-command-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(340px,.8fr);gap:12px;margin-bottom:12px}
.hll-live-situation,.hll-assignment-situation{padding:16px;border:1px solid rgba(50,48,29,.35);background:rgba(255,248,220,.48)}
.hll-live-situation.is-live{box-shadow:inset 5px 0 0 #46583a}
.hll-live-situation.is-offline{box-shadow:inset 5px 0 0 #8c7e58}
.hll-live-situation>small,.hll-assignment-situation>small{font-size:.7rem;font-weight:900;letter-spacing:.13em;color:#4b4931}
.hll-live-situation h3,.hll-assignment-situation h3{margin:3px 0 5px;font-family:'Stardos Stencil',serif;font-size:1.35rem;color:#1d1d14}
.hll-live-situation p{margin:0 0 12px;font-size:.88rem;color:#393824}
.hll-live-metrics,.hll-assignment-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.hll-live-metrics>span,.hll-assignment-grid>span{display:flex;flex-direction:column;gap:3px;min-width:0;padding:9px 10px;border:1px solid rgba(54,51,30,.22);background:rgba(255,253,237,.46)}
.hll-live-metrics small,.hll-assignment-grid small,.hll-career-strip small{font-size:.64rem;font-weight:900;letter-spacing:.08em;color:#5a5639}
.hll-live-metrics b,.hll-assignment-grid b{font-size:.92rem;color:#1d1c13;overflow-wrap:anywhere}
.hll-career-strip{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:7px}
.hll-career-strip>span{display:flex;flex-direction:column;gap:4px;min-width:0;padding:10px 9px;border:1px solid rgba(52,49,29,.25);background:rgba(245,237,205,.62)}
.hll-career-strip b{font-size:1rem;color:#17170f;overflow-wrap:anywhere}
@media(max-width:1100px){.hll-career-strip{grid-template-columns:repeat(4,1fr)}}
@media(max-width:820px){.hll-command-layout{grid-template-columns:1fr}.hll-career-strip{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.hll-live-metrics,.hll-assignment-grid,.hll-career-strip{grid-template-columns:1fr 1fr}.hll-field-command-board{padding:14px}.hll-field-command-board header{align-items:flex-start;flex-direction:column}}
.hll-record-verification{display:flex;align-items:center;gap:10px;margin:10px 0;padding:9px 11px;border:1px solid rgba(55,59,35,.35);background:rgba(61,76,46,.12);color:#252518}.hll-record-verification b{font-size:.72rem;letter-spacing:.12em}.hll-record-verification span{font-size:.78rem}.hll-role-ledger{margin:11px 0;padding:10px;border:1px solid rgba(55,52,31,.27);background:rgba(255,250,225,.35)}.hll-role-ledger>b{display:block;margin-bottom:7px;font-size:.72rem;letter-spacing:.11em}.hll-role-ledger>div{display:flex;gap:7px;flex-wrap:wrap}.hll-role-ledger span{display:flex;flex-direction:column;min-width:100px;padding:7px 9px;background:rgba(61,61,38,.1);border:1px solid rgba(55,52,31,.18)}.hll-role-ledger small{font-size:.62rem;letter-spacing:.08em}.hll-role-ledger strong{font-size:.86rem}

/* HLLV verified field-service expansion — 2026-08-22 */
.hll-operation-proof{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;padding:10px 12px;margin:0 10px 12px;border:1px dashed rgba(39,48,31,.55);background:rgba(239,226,184,.55)}
.hll-operation-proof span{display:flex;flex-direction:column;gap:2px;padding:7px 8px;border-left:2px solid rgba(65,75,45,.45)}
.hll-operation-proof small{font-size:.66rem;letter-spacing:.08em}.hll-operation-proof b{font-family:var(--font-typewriter,monospace);font-size:.9rem}.hll-operation-proof .verified b{font-size:.76rem;letter-spacing:.06em}
.hll-operation-no-contact{margin:0 10px 12px;padding:8px 10px;border:1px dashed rgba(70,70,55,.35);font-family:var(--font-typewriter,monospace);font-size:.72rem;letter-spacing:.04em;opacity:.8}
.member-op-service-record{margin-bottom:12px;border-bottom:1px solid rgba(50,50,40,.18)}.rcon-proof{font-weight:700;letter-spacing:.04em}
.hll-experience-board{display:grid;grid-template-columns:minmax(190px,.8fr) minmax(0,2fr);gap:12px;margin-top:12px}.hll-experience-stamp{padding:14px;border:2px solid rgba(60,66,43,.65);background:rgba(225,211,166,.5)}.hll-experience-stamp small{display:block;letter-spacing:.08em}.hll-experience-stamp b{display:block;font-size:1.25rem;margin:4px 0}.hll-role-experience{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.hll-role-experience span{padding:9px;border:1px solid rgba(55,60,40,.3);background:rgba(255,255,255,.15)}.hll-role-experience small,.hll-role-experience b,.hll-role-experience em{display:block}.hll-role-experience em{font-style:normal;font-size:.72rem;opacity:.8}
@media(max-width:800px){.hll-operation-proof{grid-template-columns:repeat(2,minmax(0,1fr))}.hll-experience-board{grid-template-columns:1fr}.hll-role-experience{grid-template-columns:1fr 1fr}}

/* HLLV Service Record Phase 2 */
.hll-service-intelligence,.hll-observation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:14px 0}.hll-service-intelligence article,.hll-observation-grid article,.weapon-rcon-observation{border:1px solid rgba(44,55,36,.35);padding:12px;background:rgba(236,226,190,.55)}.hll-service-intelligence small,.hll-observation-grid small,.weapon-rcon-observation small{display:block;letter-spacing:.08em;font-weight:800}.hll-service-intelligence b,.hll-observation-grid b,.weapon-rcon-observation b{display:block;margin:4px 0}.hll-service-intelligence span,.hll-observation-grid span,.weapon-rcon-observation span{font-size:.88rem}.hll-map-ledger{margin:14px 0}.hll-map-ledger>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.hll-map-ledger span{border:1px dashed rgba(44,55,36,.38);padding:9px}.hll-map-ledger small,.hll-map-ledger strong,.hll-map-ledger em{display:block}.hll-observation-grid article>span{display:block;padding:5px 0;border-bottom:1px dotted rgba(44,55,36,.25)}.hll-observation-grid em{display:block;margin-top:7px;font-size:.78rem;font-style:normal;font-weight:800}.observation-only{border-style:dashed!important}.weapon-rcon-observation{margin:12px 0;border-style:dashed}.service-event small:has(+ p){opacity:.8}@media(max-width:800px){.hll-service-intelligence,.hll-observation-grid{grid-template-columns:1fr}.hll-map-ledger>div{grid-template-columns:1fr 1fr}}

.hll-leadership-evidence,.hll-morning-field-return{margin:14px 0;border:2px solid rgba(44,55,36,.45);padding:12px;background:rgba(232,220,178,.62)}.hll-leadership-evidence small,.hll-leadership-evidence b,.hll-leadership-evidence span{display:block}.hll-leadership-evidence b{margin:5px 0}.hll-field-return-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-top:12px}.hll-field-return-grid span{border:1px solid rgba(44,55,36,.3);padding:9px;text-align:center}.hll-field-return-grid b{display:block;font-size:1.05rem}.hll-field-return-maps{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.hll-field-return-maps span{border:1px dashed rgba(44,55,36,.35);padding:6px 9px}.hll-field-return-maps b{margin-right:5px}@media(max-width:900px){.hll-field-return-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* HLLV TELEMETRY LAB — research-only service evidence */
.hll-lab-status-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:18px 0}.hll-role-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;border-top:1px solid rgba(40,35,25,.25);padding:14px 0}.hll-role-row.verified{box-shadow:inset 5px 0 0 rgba(45,80,45,.6);padding-left:12px}.hll-role-row>div{display:flex;flex-direction:column;gap:4px}.hll-role-map-form{grid-column:1/-1;display:grid;grid-template-columns:1.4fr 1fr .8fr 2fr auto;gap:8px}.hll-sample-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.hll-sample-grid>div{border-bottom:1px dashed rgba(40,35,25,.3);padding:8px;display:flex;flex-direction:column}.fine-print{font-size:.82rem;opacity:.78}@media(max-width:900px){.hll-lab-status-grid,.hll-role-row,.hll-sample-grid{grid-template-columns:1fr}.hll-role-map-form{grid-template-columns:1fr}}

.airmobile-member-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:.55rem 0}.airmobile-member-grid span{display:flex;flex-direction:column;gap:.2rem;padding:.55rem;border:1px solid rgba(70,63,34,.24);background:rgba(255,255,255,.14)}.airmobile-member-grid b{font-size:.72rem;letter-spacing:.05em}.airmobile-member-grid em{font-style:normal;font-size:.72rem}@media(max-width:760px){.airmobile-member-grid{grid-template-columns:1fr}}

/* === ISSUED UNIFORM RIBBON RACK SIZE LOCK — 2026-08-23 ===
   Uniform racks are deliberately scoped per view so future panel-specific
   edits cannot resize ribbons site-wide. Every ribbon keeps the same size;
   build_ribbon_rows() supplies a maximum of three ribbons per row. */
:root{
  --issued-uniform-ribbon-width:32px;
  --issued-uniform-ribbon-height:10px;
  --issued-uniform-ribbon-col-gap:1px;
  --issued-uniform-ribbon-row-gap:2px;
}

/* Do not allow the historical row-size-1 rule to enlarge a lone ribbon. */
.wall-locker-ribbon-rack,
.locker-desktop-ribbon-rack,
.locker-modal-ribbon-rack,
.uniform-ribbon-rack--file,
.squad-ribbon-rack,
.soldier-home-ribbon-rack{
  gap:var(--issued-uniform-ribbon-row-gap)!important;
}

.wall-locker-ribbon-rack .uniform-ribbon-row,
.locker-desktop-ribbon-rack .uniform-ribbon-row,
.locker-modal-ribbon-rack .uniform-ribbon-row,
.uniform-ribbon-rack--file .uniform-ribbon-row,
.squad-ribbon-rack .uniform-ribbon-row,
.soldier-home-ribbon-rack .uniform-ribbon-row{
  display:flex!important;
  flex-wrap:nowrap!important;
  gap:var(--issued-uniform-ribbon-col-gap)!important;
  max-width:calc(3 * var(--issued-uniform-ribbon-width) + 2 * var(--issued-uniform-ribbon-col-gap))!important;
  line-height:0!important;
}

.wall-locker-ribbon-rack img,
.wall-locker-ribbon-rack .row-size-1 img,
.locker-desktop-ribbon-rack img,
.locker-desktop-ribbon-rack .row-size-1 img,
.locker-modal-ribbon-rack img,
.locker-modal-ribbon-rack .row-size-1 img,
.uniform-ribbon-rack--file img,
.uniform-ribbon-rack--file .row-size-1 img,
.squad-ribbon-rack img,
.squad-ribbon-rack .row-size-1 img,
.soldier-home-ribbon-rack img,
.soldier-home-ribbon-rack .row-size-1 img{
  width:var(--issued-uniform-ribbon-width)!important;
  height:var(--issued-uniform-ribbon-height)!important;
  min-width:var(--issued-uniform-ribbon-width)!important;
  max-width:var(--issued-uniform-ribbon-width)!important;
  min-height:var(--issued-uniform-ribbon-height)!important;
  max-height:var(--issued-uniform-ribbon-height)!important;
  object-fit:contain!important;
}

/* Keep rack alignment local to each uniform view; sizing above is shared,
   position remains owned by the view-specific selector. */
.wall-locker-ribbon-rack .uniform-ribbon-row,
.locker-desktop-ribbon-rack .uniform-ribbon-row,
.uniform-ribbon-rack--file .uniform-ribbon-row,
.squad-ribbon-rack .uniform-ribbon-row{
  justify-content:flex-start!important;
}
.locker-modal-ribbon-rack .uniform-ribbon-row,
.soldier-home-ribbon-rack .uniform-ribbon-row{
  justify-content:center!important;
}

/* 2026-08-23 member field record cleanup: removed technical collection/experience stamp. */
.hll-experience-board.hll-role-only{grid-template-columns:1fr;}


/* 2026-08-23 — Public HLL: Vietnam live Field Situation strip.
   Fully scoped so it cannot resize or reposition existing homepage panels. */
.cav65-live-server-strip{
  margin:0;
  padding:11px 35px;
  display:grid;
  grid-template-columns:minmax(190px,.95fr) minmax(150px,.72fr) minmax(180px,.92fr) minmax(125px,.62fr) minmax(140px,.7fr) minmax(280px,1.5fr);
  gap:0;
  align-items:stretch;
  background:#10150e;
  border-top:1px solid #655932;
  border-bottom:1px solid #655932;
  box-shadow:inset 0 1px rgba(225,207,148,.05),inset 0 -1px rgba(0,0,0,.55);
  color:#ddd1b1;
}
.cav65-live-server-strip>div{min-width:0;padding:8px 14px;border-right:1px solid rgba(139,119,67,.35);display:flex;flex-direction:column;justify-content:center}
.cav65-live-server-strip>div:first-child{padding-left:0}.cav65-live-server-strip>div:last-child{border-right:0;padding-right:0}
.cav65-live-server-strip small{font:700 8px/1.2 'Courier Prime',monospace;letter-spacing:.09em;color:#95885f;text-transform:uppercase}
.cav65-live-server-strip b,.cav65-live-server-strip strong{display:block;margin-top:3px;font:700 12px/1.25 'Courier Prime',monospace;letter-spacing:.025em;color:#e5d8b8;text-transform:uppercase;overflow-wrap:anywhere}
.cav65-live-server-strip__title small{color:#c39a35}.cav65-live-server-strip__title strong{font:700 15px/1.08 'Stardos Stencil',serif;color:#ede0bc;letter-spacing:.035em}
.cav65-live-server-strip__state{display:grid!important;grid-template-columns:13px 1fr;gap:9px;align-items:center}
.cav65-live-server-strip__lamp{width:9px;height:9px;border-radius:50%;background:#716438;border:1px solid #a4935c;box-shadow:0 0 0 2px rgba(0,0,0,.35)}
.cav65-live-server-strip[data-status="live"] .cav65-live-server-strip__lamp{background:#8fa563;box-shadow:0 0 8px rgba(143,165,99,.65)}
.cav65-live-server-strip[data-status="seeding"] .cav65-live-server-strip__lamp{background:#c2a048;box-shadow:0 0 7px rgba(194,160,72,.5)}
.cav65-live-server-strip[data-status="standby"] .cav65-live-server-strip__lamp{background:#8e8359}
.cav65-live-server-strip[data-status="offline"] .cav65-live-server-strip__lamp{background:#765c50;box-shadow:none}
.cav65-live-server-strip__strength b{font-size:17px;color:#d6ad42}.cav65-live-server-strip__strength i{font-style:normal;color:#81734c;padding:0 2px}
.cav65-live-server-strip__server b{font-size:9px;color:#c8ba91;white-space:normal}.cav65-live-server-strip__server span{margin-top:3px;font:7px/1.25 'Courier Prime',monospace;color:#7f765b}
@media(max-width:1320px){.cav65-live-server-strip{grid-template-columns:1.05fr .85fr 1fr .7fr .75fr}.cav65-live-server-strip__server{grid-column:1/-1;border-top:1px solid rgba(139,119,67,.28);border-right:0!important;padding:9px 0 2px!important}}
@media(max-width:980px){.cav65-live-server-strip{margin:0;padding:10px 18px;grid-template-columns:1fr 1fr 1fr}.cav65-live-server-strip__title{grid-column:1/-1;border-right:0!important;border-bottom:1px solid rgba(139,119,67,.3);padding:7px 0 9px!important}.cav65-live-server-strip__ao{border-right:0!important}.cav65-live-server-strip__server{grid-column:1/-1}}
@media(max-width:620px){.cav65-live-server-strip{grid-template-columns:1fr 1fr;padding:8px 14px}.cav65-live-server-strip>div{padding:8px 10px}.cav65-live-server-strip__title,.cav65-live-server-strip__server{grid-column:1/-1}.cav65-live-server-strip__ao{border-right:1px solid rgba(139,119,67,.35)!important}.cav65-live-server-strip__strength{border-right:0!important}.cav65-live-server-strip__server{padding:9px 0 2px!important}.cav65-live-server-strip__server b{font-size:8px}}

/* 2026-08-23 — Hero live-server field panel. Scoped so it cannot alter other homepage panels. */
.cav65-hero-server-panel{
  position:absolute;
  z-index:4;
  left:clamp(52px,4.2vw,108px);
  bottom:clamp(28px,2.2vw,54px);
  width:min(820px,52%);
  box-sizing:border-box;
  border:1px solid rgba(177,145,61,.62);
  background:linear-gradient(180deg,rgba(10,16,10,.93),rgba(7,12,8,.96));
  box-shadow:0 16px 36px rgba(0,0,0,.42),inset 0 0 0 1px rgba(227,204,138,.045);
  color:#e7dab9;
}
.cav65-hero-server-panel__header{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 18px 13px;border-bottom:1px solid rgba(147,125,67,.42)}
.cav65-hero-server-panel__header>div small,.cav65-hero-server-panel__grid small,.cav65-hero-server-panel footer small{display:block;font:700 7px/1.25 'Courier Prime',monospace;letter-spacing:.12em;color:#9a8a5d;text-transform:uppercase}
.cav65-hero-server-panel__header>div small{color:#c7a33f}
.cav65-hero-server-panel__header>div strong{display:block;margin-top:3px;font:700 17px/1.05 'Stardos Stencil',serif;letter-spacing:.035em;color:#efe2bd}
.cav65-hero-server-panel__signal{display:flex;align-items:center;gap:8px;flex:0 0 auto}
.cav65-hero-server-panel__signal b{font:700 9px/1.2 'Courier Prime',monospace;letter-spacing:.06em;color:#cabd93;text-transform:uppercase}
.cav65-hero-server-panel__lamp{display:block;width:9px;height:9px;border-radius:50%;background:#765c50;border:1px solid #a4935c;box-shadow:0 0 0 2px rgba(0,0,0,.35)}
.cav65-hero-server-panel[data-status="live"] .cav65-hero-server-panel__lamp{background:#8fa563;box-shadow:0 0 8px rgba(143,165,99,.65)}
.cav65-hero-server-panel[data-status="seeding"] .cav65-hero-server-panel__lamp{background:#c2a048;box-shadow:0 0 7px rgba(194,160,72,.5)}
.cav65-hero-server-panel[data-status="standby"] .cav65-hero-server-panel__lamp{background:#8e8359}
.cav65-hero-server-panel__grid{display:grid;grid-template-columns:1.25fr .9fr .8fr .9fr}
.cav65-hero-server-panel__grid>div{min-width:0;padding:14px 17px;border-right:1px solid rgba(147,125,67,.32)}
.cav65-hero-server-panel__grid>div:last-child{border-right:0}
.cav65-hero-server-panel__grid b{display:block;margin-top:4px;font:700 11px/1.25 'Courier Prime',monospace;color:#e5d8b8;text-transform:uppercase;overflow-wrap:anywhere}
.cav65-hero-server-panel__strength b,.cav65-hero-server-panel__members b{font-size:20px;line-height:1;color:#d8ae3d}
.cav65-hero-server-panel__strength i{font-style:normal;color:#796c48;padding:0 2px}
.cav65-hero-server-panel footer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;padding:11px 18px;border-top:1px solid rgba(147,125,67,.32);background:rgba(0,0,0,.18)}
.cav65-hero-server-panel footer b{display:block;margin-top:3px;font:700 9px/1.25 'Courier Prime',monospace;color:#c9bc94;text-transform:uppercase;overflow-wrap:anywhere}
.cav65-hero-server-panel footer>span{font:700 6.5px/1.3 'Courier Prime',monospace;letter-spacing:.08em;color:#756c51;text-align:right}

@media(max-width:1320px){
  .cav65-hero-server-panel{width:min(720px,57%)}
  .cav65-hero-server-panel__grid{grid-template-columns:1fr 1fr}
  .cav65-hero-server-panel__grid>div:nth-child(2){border-right:0}
  .cav65-hero-server-panel__grid>div:nth-child(-n+2){border-bottom:1px solid rgba(147,125,67,.32)}
}
@media(max-width:980px){
  .cav65-hero-server-panel{position:relative;left:auto;bottom:auto;width:min(680px,calc(100% - 36px));margin:24px auto 0;z-index:6}
  .cav65-hero-server-panel__header{padding:14px 15px 12px}
  .cav65-hero-server-panel footer{grid-template-columns:1fr}
  .cav65-hero-server-panel footer>span{text-align:left}
}
@media(max-width:620px){
  .cav65-hero-server-panel{width:calc(100% - 28px);margin-top:20px}
  .cav65-hero-server-panel__header{align-items:flex-start;flex-direction:column;gap:9px}
  .cav65-hero-server-panel__grid{grid-template-columns:1fr 1fr}
  .cav65-hero-server-panel__grid>div{padding:12px}
  .cav65-hero-server-panel__grid b{font-size:9px}
  .cav65-hero-server-panel__strength b,.cav65-hero-server-panel__members b{font-size:18px}
}

/* ========================================================================
   HOMEPAGE LIVE SERVER PANEL — PROFESSIONAL LAYOUT LOCK 2026-08-23
   Reserves real hero space for the field board. No CTA/authentication overlap.
   ======================================================================== */
@media (min-width:1321px){
  .cav65-showcase-hero{
    min-height:clamp(920px,48vw,1120px)!important;
  }
  .cav65-showcase-hero__copy{
    width:min(940px,56%)!important;
    padding-bottom:clamp(330px,18vw,430px)!important;
  }
  .cav65-hero-server-panel{
    left:clamp(52px,4.2vw,108px)!important;
    right:auto!important;
    bottom:clamp(46px,3vw,72px)!important;
    width:min(960px,48vw)!important;
    min-height:220px!important;
  }
  .cav65-hero-server-panel__header{padding:21px 24px 18px!important}
  .cav65-hero-server-panel__header>div strong{font-size:clamp(19px,1.05vw,27px)!important}
  .cav65-hero-server-panel__grid>div{padding:19px 22px!important}
  .cav65-hero-server-panel__grid small,.cav65-hero-server-panel__header>div small,.cav65-hero-server-panel footer small{font-size:clamp(7px,.4vw,10px)!important}
  .cav65-hero-server-panel__grid b{font-size:clamp(11px,.62vw,16px)!important}
  .cav65-hero-server-panel__strength b,.cav65-hero-server-panel__members b{font-size:clamp(21px,1.25vw,31px)!important}
  .cav65-hero-server-panel footer{padding:15px 22px!important}
  .cav65-hero-server-panel footer b{font-size:clamp(9px,.5vw,13px)!important}
  .cav65-showcase-access{z-index:8!important}
  .cav65-showcase-staff{z-index:13!important}
}

@media (min-width:981px) and (max-width:1320px){
  .cav65-showcase-hero{min-height:940px!important}
  .cav65-showcase-hero__copy{padding-bottom:310px!important}
  .cav65-hero-server-panel{
    left:30px!important;
    right:auto!important;
    bottom:34px!important;
    width:min(740px,56vw)!important;
    min-height:235px!important;
  }
  .cav65-showcase-access{right:24px!important;top:28px!important;z-index:8!important}
  .cav65-showcase-staff{z-index:13!important}
}

@media (min-width:621px) and (max-width:980px){
  .cav65-showcase-hero{min-height:0!important;padding-bottom:36px!important;overflow:hidden!important}
  .cav65-showcase-hero__copy{position:relative!important;width:100%!important;padding-bottom:0!important}
  .cav65-hero-server-panel{
    position:relative!important;
    left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;
    width:min(760px,calc(100% - 42px))!important;
    min-height:225px!important;
    margin:34px auto 0!important;
    z-index:6!important;
  }
  .cav65-showcase-access{
    position:relative!important;
    left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;
    transform:none!important;
    width:min(410px,90vw)!important;
    margin:34px auto 0!important;
    z-index:8!important;
  }
}

@media (max-width:620px){
  .cav65-hero-server-panel{
    position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;
    width:calc(100% - 28px)!important;min-height:0!important;margin:24px auto 0!important;z-index:6!important;
  }
  .cav65-showcase-access{margin-top:26px!important;z-index:8!important}
}


/* Battalion organization board command-card alignment repair */
.public-units-page .public-command-group article{
  grid-template-columns:72px minmax(0,1fr);
  grid-template-rows:auto auto auto;
  align-content:center;
  min-height:138px;
}
.public-units-page .public-command-group article img{
  grid-column:1;
  grid-row:1 / 4;
  align-self:center;
}
.public-units-page .public-command-group article > small,
.public-units-page .public-command-group article > h3,
.public-units-page .public-command-group article > span{
  grid-column:2;
  min-width:0;
  word-break:normal;
  overflow-wrap:normal;
}
.public-units-page .public-command-group article > small{
  line-height:1.25;
}
.public-units-page .public-command-group article > span{
  line-height:1.35;
}
.public-units-page .public-command-group article.is-vacant{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  gap:6px;
  min-height:138px;
}
.public-units-page .public-command-group article.is-vacant > small,
.public-units-page .public-command-group article.is-vacant > h3,
.public-units-page .public-command-group article.is-vacant > span{
  width:100%;
  max-width:100%;
}
.public-units-page .public-command-group article.is-vacant > h3{
  margin:2px 0 1px;
}
@media(max-width:560px){
  .public-units-page .public-command-group article{grid-template-columns:56px minmax(0,1fr)}
  .public-units-page .public-command-group article.is-vacant{min-height:118px}
}


/* HOMEPAGE SERVER PANEL — CTA CLEARANCE FINAL LOCK 2026-08-23
   The field board receives its own reserved lower hero band. */
@media (min-width:981px){
  .cav65-showcase-hero{min-height:980px!important;}
  .cav65-showcase-hero__copy{padding-bottom:360px!important;}
  .cav65-showcase-hero__actions{position:relative!important;z-index:9!important;margin-bottom:0!important;}
  .cav65-hero-server-panel{bottom:42px!important;max-height:none!important;}
}
@media (min-width:1321px){
  .cav65-showcase-hero{min-height:1040px!important;}
  .cav65-showcase-hero__copy{padding-bottom:410px!important;}
  .cav65-hero-server-panel{bottom:54px!important;}
}
@media (max-width:980px){
  .cav65-hero-server-panel{clear:both!important;}
}

/* Armored service additions */
.armored-service-shell .career-file-hero p{max-width:760px}
.armor-service-totals{margin-top:22px}
.armor-area-ledger{margin-top:22px;padding:24px}
.armor-area-ledger h2{margin:4px 0 18px}
.armor-stat-summary{margin-top:24px;padding:22px}


/* 2026-08-23 — Recruiting application readability pass
   Preserve the 1965 paper aesthetic while making labels/instructions comfortable to read. */
.public-recruiting-1965 .identity-routing-block>div>small{font-size:10px;line-height:1.45;letter-spacing:.05em}
.public-recruiting-1965 .identity-routing-block h3{font-size:27px;line-height:1.08}
.public-recruiting-1965 .identity-routing-block p{font-size:14px;line-height:1.6}
.public-recruiting-1965 .discord-identity-button{font-size:11px;line-height:1.35}
.public-recruiting-1965 .identity-scope-grid b{font-size:10px;line-height:1.4}
.public-recruiting-1965 .identity-scope-grid span{font-size:11px;line-height:1.5}
.public-recruiting-1965 .application-section-heading small{font-size:10px}
.public-recruiting-1965 .application-section-heading h3{font-size:30px;line-height:1.08}
.public-recruiting-1965 .application-section-heading p{font-size:13px;line-height:1.55}
.public-recruiting-1965 .enlistment-form-1965 fieldset{gap:16px;padding:19px 18px 18px}
.public-recruiting-1965 .enlistment-form-1965 legend{font-size:11px;line-height:1.4}
.public-recruiting-1965 .enlistment-form-1965 label{grid-template-columns:34px minmax(0,1fr);gap:6px 10px}
.public-recruiting-1965 .enlistment-form-1965 label>span{font-size:19px}
.public-recruiting-1965 .enlistment-form-1965 label>b{font-size:10px;line-height:1.45}
.public-recruiting-1965 .enlistment-form-1965 input,
.public-recruiting-1965 .enlistment-form-1965 select,
.public-recruiting-1965 .enlistment-form-1965 textarea{font-size:13px;line-height:1.4;padding:12px 13px}
.public-recruiting-1965 .enlistment-form-1965 .field-help{font-size:12px;line-height:1.5}
.public-recruiting-1965 .applicant-certification h3{font-size:19px}
.public-recruiting-1965 .applicant-certification p{font-size:12px;line-height:1.55}
.public-recruiting-1965 .applicant-certification>div{font-size:10px;line-height:1.45}
.public-recruiting-1965 .recruiting-side-paper{padding:18px}
.public-recruiting-1965 .recruiting-side-paper header{font-size:18px;line-height:1.15}
.public-recruiting-1965 .recruiting-side-paper ol{font-size:12px;line-height:1.6}
.public-recruiting-1965 .recruiting-desk-counts dt{font-size:10px;line-height:1.4}
.public-recruiting-1965 .recruiting-desk-counts dd{font-size:21px}
.public-recruiting-1965 .after-submission>div{font-size:10.5px;line-height:1.45;padding:7px}
@media(max-width:760px){
  .public-recruiting-1965 .identity-routing-block p{font-size:13px}
  .public-recruiting-1965 .enlistment-form-1965 label{grid-template-columns:30px minmax(0,1fr)}
  .public-recruiting-1965 .enlistment-form-1965 input,
  .public-recruiting-1965 .enlistment-form-1965 select,
  .public-recruiting-1965 .enlistment-form-1965 textarea{font-size:13px}
}


/* ===== 2026-08-23 STAFF COMMAND POST NAVIGATION OVERHAUL ===== */
.staff-shell-active .staff-command-rail{position:fixed;z-index:33;left:0;top:0;width:238px;height:100vh;padding:18px 14px 16px;background:linear-gradient(180deg,#161b15 0%,#20261d 52%,#171c16 100%);border-right:1px solid rgba(205,177,106,.45);box-shadow:8px 0 24px rgba(0,0,0,.28);display:flex;flex-direction:column;gap:15px;overflow-y:auto}
.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar,.staff-shell-active main,.staff-shell-active .logged-back-wrap{margin-left:238px}
.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar{width:calc(100% - 238px);box-sizing:border-box}
.staff-shell-active main{width:auto;min-width:0}
.staff-rail-heading{padding:8px 9px 14px;border-bottom:1px solid rgba(205,177,106,.35);display:grid;gap:2px;color:#ede4cb}
.staff-rail-heading small{font:700 10px 'Courier Prime',monospace;letter-spacing:.18em;color:#cbb474}.staff-rail-heading b{font:700 24px 'Oswald',sans-serif;letter-spacing:.06em}.staff-rail-heading span{font:700 10px 'Courier Prime',monospace;opacity:.68;letter-spacing:.08em}
.staff-rail-nav{display:grid;gap:7px}.staff-rail-nav a{display:grid;gap:3px;padding:12px 11px;border:1px solid rgba(205,177,106,.18);border-left:3px solid transparent;background:rgba(255,255,255,.025);color:#e9dfc4;text-decoration:none;transition:.14s ease}.staff-rail-nav a b{font:700 12px 'Courier Prime',monospace;letter-spacing:.055em}.staff-rail-nav a small{font:400 9px 'Courier Prime',monospace;line-height:1.35;opacity:.62}.staff-rail-nav a:hover{background:#30392b;border-color:rgba(205,177,106,.46);transform:translateX(2px)}.staff-rail-nav a.is-active{background:#3b4433;border-color:#ccb36d;border-left-color:#e0c26f;color:#fff1c8;box-shadow:inset 0 0 0 1px rgba(255,255,255,.025)}
.staff-rail-quick{margin-top:auto;padding:12px 9px;border-top:1px solid rgba(205,177,106,.28);display:grid;gap:6px}.staff-rail-quick>small{font:700 9px 'Courier Prime',monospace;letter-spacing:.15em;color:#bca969}.staff-rail-quick a{padding:7px 8px;background:#293125;border:1px solid rgba(205,177,106,.19);color:#ddd3b8;text-decoration:none;font:700 9px 'Courier Prime',monospace;letter-spacing:.04em}.staff-rail-quick a:hover{background:#3a4432;color:#fff0c9}
.staff-rail-footer{display:grid;grid-template-columns:1fr 1fr;gap:6px}.staff-rail-footer a{text-align:center;padding:8px 4px;border:1px solid rgba(205,177,106,.2);color:#c8bea3;text-decoration:none;font:700 8px 'Courier Prime',monospace;letter-spacing:.06em}.staff-rail-footer a:hover{color:#fff1ca;border-color:#ccb36d}
.staff-global-bar a[aria-current="page"]{background:#4a543e!important;border-color:#d6ba70!important;color:#fff2cd!important}
.staff-work-center-block{margin:18px 0 22px}.staff-work-center-block>header{margin-bottom:10px}.staff-work-center-block>header small{font:700 10px 'Courier Prime',monospace;letter-spacing:.14em}.staff-work-center-block>header h2{margin:2px 0 4px;font-family:'Oswald',sans-serif;letter-spacing:.04em}.staff-work-center-block>header p{margin:0;max-width:780px}
.staff-office-grid--primary{grid-template-columns:repeat(3,minmax(180px,1fr))!important}.staff-office-grid--primary a{min-height:112px!important;align-content:center!important;padding:17px!important;border-width:2px!important}.staff-office-grid--primary a b{font-size:1.02rem!important}.staff-office-grid--primary a span{font-size:.76rem!important;line-height:1.45!important}
.staff-shell-active .staff-center-shell{max-width:1460px}.staff-shell-active .staff-center-hero{max-width:1460px}
.staff-shell-active .logged-back-wrap{width:auto}
@media(max-width:1180px){.staff-shell-active .staff-command-rail{width:205px}.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar,.staff-shell-active main,.staff-shell-active .logged-back-wrap{margin-left:205px}.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar{width:calc(100% - 205px)}.staff-office-grid--primary{grid-template-columns:repeat(2,minmax(180px,1fr))!important}}
@media(max-width:820px){.staff-shell-active .staff-command-rail{position:relative;width:100%;height:auto;box-sizing:border-box;padding:9px 10px;display:block;border-right:0;border-bottom:1px solid rgba(205,177,106,.4)}.staff-rail-heading{display:flex;align-items:center;gap:8px;padding:5px 4px 8px}.staff-rail-heading b{font-size:18px}.staff-rail-nav{display:flex;overflow-x:auto;gap:7px;padding:3px 0 6px}.staff-rail-nav a{min-width:145px;flex:0 0 auto;padding:9px}.staff-rail-quick,.staff-rail-footer{display:none}.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar,.staff-shell-active main,.staff-shell-active .logged-back-wrap{margin-left:0}.staff-shell-active .battalion-header,.staff-shell-active .staff-global-bar,.staff-shell-active .staff-utility-bar{width:100%}.staff-office-grid--primary{grid-template-columns:1fr!important}}

/* === MEMBER SQUAD COMBAT RECORD — 2026-08-23 ===
   Read-only service view. Uniform/ribbon geometry deliberately reuses the
   existing .squad-uniform-stage + .squad-ribbon-rack locked rules above. */
.page-squad-combat-record .main-content{max-width:none;width:100%}
.squad-combat-heading{max-width:1500px;margin-left:auto;margin-right:auto}
.squad-combat-nav{display:flex;gap:.65rem;flex-wrap:wrap;align-items:center;margin-top:.8rem}
.squad-combat-nav a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:.65rem .9rem;border:1px solid rgba(68,57,34,.42);background:rgba(235,222,184,.72);color:inherit;text-decoration:none;font:800 .78rem var(--typewriter,monospace);letter-spacing:.055em}
.squad-combat-record-shell{max-width:1500px;margin:0 auto 2rem;padding:0 1.25rem}
.squad-combat-identity{padding:1.35rem}
.squad-combat-top-grid{display:grid;grid-template-columns:minmax(420px,.82fr) minmax(560px,1.18fr);gap:2rem;align-items:start}
.squad-combat-uniform-panel{min-width:0}
.squad-combat-uniform-stage{max-width:560px;margin:0 auto}
.squad-combat-summary{min-width:0;display:grid;gap:1rem}
.squad-combat-summary>header{border-bottom:2px solid rgba(55,46,28,.48);padding-bottom:.7rem}
.squad-combat-summary>header small,.squad-combat-summary>header h2{display:block;margin:0}
.squad-combat-summary>header h2{font-family:'Stardos Stencil',serif;font-size:clamp(25px,2.4vw,36px);margin-top:.25rem}
.squad-combat-stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}
.squad-combat-stat-grid article{display:grid;gap:.3rem;min-height:96px;padding:.85rem;border:1px solid rgba(64,53,31,.32);background:rgba(244,234,204,.48)}
.squad-combat-stat-grid small,.squad-combat-section>small{font-size:.7rem;font-weight:900;letter-spacing:.09em}
.squad-combat-stat-grid b{font-family:'Stardos Stencil',serif;font-size:1.35rem}
.squad-combat-stat-grid span{font-size:.78rem;line-height:1.4}
.squad-combat-section{padding:1rem;border:1px solid rgba(64,53,31,.32);background:rgba(245,236,208,.42)}
.squad-combat-section h3{margin:.3rem 0 .5rem;font-size:1.2rem}.squad-combat-section p{margin:0;line-height:1.55}
.squad-combat-ledger,.squad-combat-awards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin-top:.65rem}
.squad-combat-ledger span,.squad-combat-awards span{display:flex;justify-content:space-between;gap:.8rem;padding:.65rem .7rem;border-top:1px dotted rgba(64,53,31,.34)}
.squad-combat-ledger em,.squad-combat-awards em{font-style:normal;font-size:.78rem;font-weight:800;white-space:nowrap}
.squad-combat-leader-action{display:flex!important;justify-content:center;text-decoration:none;margin-top:.25rem}
@media(max-width:1050px){.squad-combat-top-grid{grid-template-columns:1fr}.squad-combat-uniform-stage{max-width:520px}.squad-combat-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.squad-combat-record-shell{padding:0 .65rem}.squad-combat-identity{padding:.8rem}.squad-combat-nav{display:grid;grid-template-columns:1fr}.squad-combat-nav a{width:100%}.squad-combat-stat-grid,.squad-combat-ledger,.squad-combat-awards{grid-template-columns:1fr}.squad-combat-facts{grid-template-columns:1fr}}

/* 2026-08-23 — quiet, event-based member notifications */
.member-notification-center{margin:18px 0 22px;padding:18px 20px}.member-notification-center>header{display:flex;flex-wrap:wrap;align-items:end;gap:6px 14px;border-bottom:1px solid rgba(35,35,28,.28);padding-bottom:10px;margin-bottom:10px}.member-notification-center>header small{width:100%;letter-spacing:.08em}.member-notification-center>header h2{margin:0;font-size:clamp(1.15rem,2vw,1.55rem)}.member-notification-center>header p{margin:0 0 2px;max-width:680px}.member-notification-list{display:grid;gap:8px}.member-notification-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:12px 0;border-bottom:1px dashed rgba(35,35,28,.24)}.member-notification-row:last-child{border-bottom:0}.member-notification-row>div:first-child{display:grid;gap:3px}.member-notification-row small{font-size:.72rem;letter-spacing:.06em}.member-notification-row b{font-size:1rem}.member-notification-row span{font-size:.88rem;line-height:1.35}.member-notification-actions{display:flex;gap:7px;align-items:center;white-space:nowrap}.member-notification-actions a,.member-notification-actions button{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:7px 10px;border:1px solid currentColor;background:transparent;color:inherit;font:inherit;font-size:.72rem;font-weight:800;letter-spacing:.05em;text-decoration:none;cursor:pointer}.member-notification-actions form{margin:0}.member-notification-row.priority-high{border-left:4px solid currentColor;padding-left:10px}.member-notification-row.priority-urgent{border-left:6px double currentColor;padding-left:10px}@media(max-width:720px){.member-notification-row{grid-template-columns:1fr}.member-notification-actions{white-space:normal;flex-wrap:wrap}}

/* 2026-08-23 — Squad Combat Record back-button spacing fix */
.page-squad-combat-record .logged-back-wrap{
  margin-top:12px;
  margin-bottom:18px;
}
@media(max-width:600px){
  .page-squad-combat-record .logged-back-wrap{margin-bottom:14px}
}
.weapon-server-service-note{margin-top:12px;padding:11px 13px;border:1px dashed rgba(72,59,37,.42);background:rgba(230,223,191,.5);font-family:'Courier Prime',monospace;color:#2d2519}.weapon-server-service-note b{display:block;font-size:11px;letter-spacing:.08em;margin-bottom:4px}.weapon-server-service-note span{display:block;font-size:10px;line-height:1.45;opacity:.82}

/* M16 four-state supplied artwork: do not stack legacy generated dirt/filter effects over state images. */
.weapon-state-photo img{filter:none!important}
.weapon-state-photo .weapon-dirt-layer{display:none!important}


/* 2026-08-24 batch fixes: Duty Desk actions + qualification-card preview */
.member-duty-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}
.member-duty-actions>a,.member-duty-actions button{font-family:'Oswald',sans-serif;font-size:.82rem;font-weight:700;letter-spacing:.05em;white-space:nowrap;color:#e1cf87;text-decoration:none;background:transparent;border:0;padding:7px 4px;cursor:pointer}
.member-duty-actions form{margin:0}
.member-duty-actions button{color:#c9bea0;border-left:1px solid rgba(210,198,155,.25);padding-left:10px}
.member-duty-actions>a:hover,.member-duty-actions button:hover{color:#fff3be}
.locker-bay__visual--qualification{padding:10px 12px!important;overflow:hidden}
.locker-bay__visual--qualification img{width:100%!important;height:100%!important;max-width:100%!important;max-height:100%!important;object-fit:contain!important;object-position:center center!important;transform:none!important;filter:drop-shadow(0 10px 12px rgba(0,0,0,.28))}
@media(max-width:760px){.member-duty-actions{gap:6px}.member-duty-actions>a,.member-duty-actions button{font-size:.72rem}.locker-bay__visual--qualification{padding:7px!important}}

/* Recruiting application fail-safe */
.recruiting-failsafe-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:9998}
.recruiting-failsafe-modal{position:fixed;z-index:9999;left:50%;top:50%;transform:translate(-50%,-50%);width:min(92vw,620px);background:#e4d8b7;border:3px solid #2f321e;box-shadow:0 18px 60px rgba(0,0,0,.65);padding:28px;color:#242418;font-family:inherit;text-align:center}
.recruiting-failsafe-modal small{display:block;font-weight:800;letter-spacing:.12em;margin-bottom:8px}
.recruiting-failsafe-modal h2{margin:0 0 12px;font-size:clamp(1.45rem,4vw,2rem)}
.recruiting-failsafe-modal p{line-height:1.55;margin:0 auto 20px;max-width:520px}
.recruiting-failsafe-discord,.recruiting-failsafe-close{display:block;width:100%;box-sizing:border-box;margin-top:10px;padding:14px 16px;border:2px solid #252817;font-weight:900;letter-spacing:.06em;text-decoration:none;cursor:pointer}
.recruiting-failsafe-discord{background:#30351e;color:#fff}
.recruiting-failsafe-close{background:transparent;color:#252817}

/* -------------------------------------------------------------------------
   2026-08-24 MEMBER ORGANIZATION / FORMATION CLARITY OVERHAUL
   ------------------------------------------------------------------------- */
.org-member-shell{display:grid;gap:18px;max-width:1500px;margin:0 auto;padding:18px clamp(12px,2vw,28px) 40px}.org-member-hero{padding:24px 28px}.org-member-hero small,.org-member-hero h1,.org-member-hero p{margin:0}.org-member-hero h1{margin-top:5px;font-size:clamp(1.55rem,3vw,2.5rem)}.org-member-hero p{margin-top:8px;max-width:900px}.org-breadcrumb{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 14px;border:1px solid rgba(51,42,26,.35);background:rgba(230,219,186,.84);font-family:var(--font-stencil,inherit);font-size:.86rem}.org-breadcrumb a,.org-breadcrumb b{color:#251f15;text-decoration:none}.org-breadcrumb .is-current{padding:4px 8px;background:#242820;color:#f3ecd8}.org-assignment-path{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr) auto minmax(0,1fr);gap:10px;align-items:stretch}.org-assignment-path article{min-width:0;padding:16px;border:1px solid rgba(51,42,26,.38);background:linear-gradient(180deg,rgba(239,229,198,.98),rgba(216,201,160,.96));box-shadow:0 2px 0 rgba(35,30,20,.15)}.org-assignment-path article small,.org-assignment-path article span{display:block}.org-assignment-path article strong{display:block;margin:3px 0;font-size:clamp(1rem,1.8vw,1.35rem);color:#201d16}.org-assignment-path article span{font-size:.78rem;color:#5f5847}.org-assignment-path article.is-you{outline:3px solid #4d553b;outline-offset:-3px}.org-assignment-path article.is-you span{font-weight:800;color:#353b29}.org-assignment-path>i{align-self:center;font-size:1.6rem;font-style:normal;color:#665d45}.org-member-grid{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.55fr);gap:18px}.org-duty-card,.org-squad-summary,.org-company-roster,.org-squad-identity{padding:20px}.org-duty-card header,.org-squad-summary header,.org-company-roster header,.org-squad-identity>header{margin-bottom:14px;border-bottom:1px solid rgba(44,39,27,.32);padding-bottom:10px}.org-duty-card header h2,.org-squad-summary header h2,.org-company-roster header h2,.org-squad-identity>header h2{margin:2px 0}.org-duty-identity{display:flex;justify-content:space-between;gap:10px;padding:12px;background:rgba(78,83,58,.12);margin-bottom:12px}.org-duty-identity b{font-size:1.08rem}.org-duty-card dl{display:grid;grid-template-columns:minmax(125px,.7fr) 1fr;margin:0}.org-duty-card dt,.org-duty-card dd{margin:0;padding:9px 6px;border-bottom:1px dashed rgba(43,38,26,.3)}.org-duty-card dt{font-size:.72rem;font-weight:800}.org-stat-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}.org-stat-strip span{padding:10px;background:rgba(66,71,48,.12);border:1px solid rgba(48,43,30,.22)}.org-stat-strip small,.org-stat-strip b{display:block}.org-stat-strip b{font-size:1.18rem}.org-team-mini-grid,.org-team-board{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.org-team-mini-grid section,.org-team-board section{border:1px solid rgba(47,42,29,.35);background:rgba(235,225,194,.68);padding:12px;min-width:0}.org-team-mini-grid section.is-member-team,.org-team-board section.is-member-team{outline:3px solid #4e563d;outline-offset:-3px}.org-team-mini-grid h3,.org-team-board h3{margin:0 0 8px;font-size:1rem}.org-team-mini-grid h3 em{display:inline-block;margin-left:7px;padding:2px 5px;background:#4e563d;color:#fff;font-size:.62rem;font-style:normal}.org-team-mini-grid section>div,.org-team-board section>a{display:flex;justify-content:space-between;gap:8px;padding:7px 0;border-top:1px dashed rgba(47,42,29,.25);text-decoration:none;color:inherit}.org-team-mini-grid section>div span,.org-team-board section>a span{font-size:.74rem;text-align:right}.org-level-actions{display:flex;gap:10px;flex-wrap:wrap}.org-level-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 14px;border:1px solid #3e412f;background:#e4d9b7;color:#211f17;font-weight:800;text-decoration:none}.org-level-actions a.primary{background:#414832;color:#fff}.org-company-roster .member-unit-table__row.is-current-soldier{background:rgba(73,82,52,.17);box-shadow:inset 4px 0 #485139}.org-company-roster .member-unit-table__row small{display:block;font-size:.64rem;font-weight:900;color:#485139}.org-squad-command{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin-bottom:14px}.org-squad-command span{padding:10px 12px;background:rgba(72,79,52,.12);border:1px solid rgba(44,40,28,.25)}.org-squad-command small,.org-squad-command b{display:block}.org-team-board section header{display:grid;grid-template-columns:1fr auto;gap:3px 10px;margin-bottom:8px}.org-team-board section header span{grid-column:1/-1;font-size:.72rem}.org-team-board section header>b{padding:2px 5px;background:#4a5137;color:#fff;font-size:.62rem}.member-assignment-command{margin:18px auto;max-width:1500px;padding:18px clamp(14px,2vw,24px);border:1px solid rgba(64,58,39,.5);background:linear-gradient(180deg,rgba(224,214,179,.97),rgba(201,188,145,.96));box-shadow:0 4px 14px rgba(20,18,12,.18)}.member-assignment-command>header{display:flex;justify-content:space-between;gap:12px;align-items:flex-end;border-bottom:1px solid rgba(50,45,30,.34);padding-bottom:10px}.member-assignment-command>header h2{margin:2px 0}.member-assignment-command>header a{font-weight:900;color:#25291d}.member-assignment-path{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:8px;align-items:center;margin:14px 0}.member-assignment-path>span{min-width:0;padding:11px;background:rgba(247,238,208,.72);border:1px solid rgba(55,50,35,.27)}.member-assignment-path small,.member-assignment-path b,.member-assignment-path em{display:block}.member-assignment-path b{margin-top:2px;font-size:1rem}.member-assignment-path i{font-style:normal;font-size:1.4rem}.member-assignment-path .is-team{outline:3px solid #4d553b;outline-offset:-3px}.member-assignment-path em{margin-top:3px;font-style:normal;font-size:.61rem;font-weight:900;color:#4a5137}.member-assignment-leaders{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.member-assignment-leaders span{padding:9px 10px;background:rgba(61,67,45,.1);border-top:2px solid rgba(66,73,49,.5)}.member-assignment-leaders small,.member-assignment-leaders b{display:block}.member-assignment-leaders small{font-size:.66rem}.member-assignment-command>nav{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.member-assignment-command>nav a{padding:8px 12px;border:1px solid #454b34;background:#ece2c5;color:#22251b;text-decoration:none;font-weight:800}.formation-member-roster .career-row small{white-space:normal}
@media(max-width:900px){.org-assignment-path,.member-assignment-path{grid-template-columns:1fr}.org-assignment-path>i,.member-assignment-path>i{display:none}.org-member-grid{grid-template-columns:1fr}.member-assignment-leaders{grid-template-columns:repeat(2,minmax(0,1fr))}.org-team-mini-grid,.org-team-board{grid-template-columns:1fr}.org-squad-command{grid-template-columns:1fr 1fr}.org-squad-command span:first-child{grid-column:1/-1}}
@media(max-width:560px){.org-member-shell{padding-inline:10px}.org-stat-strip,.member-assignment-leaders{grid-template-columns:1fr}.member-assignment-command>header{align-items:flex-start;flex-direction:column}.org-duty-card dl{grid-template-columns:1fr}.org-duty-card dt{padding-bottom:2px;border-bottom:0}.org-duty-card dd{padding-top:2px}.org-level-actions a{flex:1 1 45%}}

/* Command read-only Welcome Packet preview */
.welcome-preview-banner{display:flex;justify-content:space-between;gap:18px;align-items:center;background:#2b3122;color:#efe1b7;border:2px solid #9e8a55;padding:14px 16px;margin:0 0 14px;box-shadow:0 8px 18px #0004}.welcome-preview-banner div{display:grid;gap:3px}.welcome-preview-banner small{letter-spacing:.12em;color:#cdbb84}.welcome-preview-banner b{font-size:1rem}.welcome-preview-banner span{font-size:.8rem;opacity:.8}.welcome-preview-banner a{background:#d7c690;color:#221f17;border:1px solid #61583f;padding:10px 12px;text-decoration:none;font-weight:900;white-space:nowrap}.welcome-task-action button[disabled]{opacity:.7;cursor:not-allowed;filter:saturate(.65)}.welcome-preview-action{display:inline-block;padding:8px 10px;border:1px dashed #7f795d;color:#b7ab83;font-weight:800}.staff-onboarding-row>span:last-child a{display:block}
@media(max-width:900px){.welcome-preview-banner{align-items:stretch;flex-direction:column}.welcome-preview-banner a{white-space:normal;text-align:center}}

/* Server-authoritative MOS proficiency */
.mos-server-progress{height:10px;border:1px solid rgba(54,47,32,.55);background:rgba(68,60,42,.12);margin:12px 0 14px;overflow:hidden}
.mos-server-progress>i{display:block;height:100%;background:currentColor;opacity:.55}

/* Company Welcome Packet / onboarding submission workflow */
.welcome-submit-board{margin-top:22px;padding:24px 28px;border:2px solid #716746;background:linear-gradient(120deg,#d7c797,#efe4c2);color:#241f15;box-shadow:0 10px 22px #0004}.welcome-submit-board small{display:block;letter-spacing:.14em;font-weight:800}.welcome-submit-board h2{margin:6px 0 8px}.welcome-submit-board p{max-width:980px}.welcome-submit-board form{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start}.welcome-submit-board button{min-height:44px;padding:10px 16px;font:inherit;font-weight:800;letter-spacing:.05em;border:1px solid #51482f;background:#35402d;color:#f4e7bd;cursor:pointer}.welcome-submit-board textarea{flex:1 1 340px;min-height:76px;padding:10px;background:#f4ead0;border:1px solid #786d4a;color:#272218;font:inherit}.welcome-task-action form{display:inline-flex;margin:3px 0}.welcome-task-action form button{min-height:40px}.staff-welcome-task p{margin:.35rem 0 0;opacity:.82}.staff-onboarding-head>div:last-child{display:flex;gap:10px;flex-wrap:wrap}.staff-onboarding-head>div:last-child a{display:inline-flex;align-items:center;min-height:42px}
@media (max-width:720px){.welcome-submit-board{padding:18px}.welcome-submit-board form{display:grid}.welcome-submit-board textarea{width:100%;min-width:0}.staff-onboarding-head>div:last-child{width:100%}}
.welcome-verification-control{margin:18px 0 0;padding:16px 18px;border:1px solid #7c714c;background:#ded0a7;color:#282318;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.welcome-verification-control>div{display:grid;gap:3px;max-width:920px}.welcome-verification-control small{font-size:.7rem;letter-spacing:.13em;font-weight:800}.welcome-verification-control b{font-size:1rem}.welcome-verification-control span{font-size:.82rem;opacity:.82}.welcome-verification-control form{margin:0}.welcome-verification-control button{min-height:42px;padding:10px 16px;border:1px solid #51482f;background:#35402d;color:#f4e7bd;font:inherit;font-weight:800;letter-spacing:.05em;cursor:pointer}
@media (max-width:720px){.welcome-verification-control{display:grid}.welcome-verification-control button{width:100%}}

.personnel-sync-quick{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:0 0 18px;padding:18px 20px}.personnel-sync-quick>div:first-child{min-width:0;flex:1}.personnel-sync-quick h2{margin:4px 0 6px}.personnel-sync-quick p{margin:0;max-width:760px}.personnel-sync-quick-actions{display:flex;align-items:stretch;gap:10px;flex-wrap:wrap}.personnel-sync-quick-actions form{margin:0;display:flex}.personnel-sync-quick-actions .paper-action{height:100%;min-width:210px}
@media (max-width:980px){.personnel-fast-control{grid-template-columns:1fr}.personnel-sync-quick{align-items:stretch;flex-direction:column}.personnel-sync-quick-actions{display:grid;grid-template-columns:1fr}.personnel-sync-quick-actions form,.personnel-sync-quick-actions .paper-action{width:100%;min-width:0}}

/* Welcome Packet readability + direct task guidance (2026-08-25) */
.welcome-task{align-items:flex-start;gap:16px;padding:18px 18px 20px}
.welcome-task-main{min-width:0;display:grid;gap:9px}
.welcome-task-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap}
.welcome-task-heading h3{margin:0;line-height:1.25}
.welcome-task-status{display:inline-flex;align-items:center;min-height:24px;padding:3px 8px;border:1px solid #776d4e;background:#c9b982;font-size:.7rem;font-weight:900;letter-spacing:.08em;white-space:nowrap}
.welcome-task-description{margin:0!important;line-height:1.55}
.welcome-task-guidance{margin-top:3px;padding:12px 14px;border-left:3px solid #716744;background:#d8c99d;display:grid;gap:7px;line-height:1.45}
.welcome-task-guidance>strong,.welcome-guidance-where strong{font-size:.72rem;letter-spacing:.1em}
.welcome-guidance-where{display:grid;gap:2px;padding-bottom:7px;border-bottom:1px dotted #8c805b}
.welcome-guidance-where span{font-weight:700}
.welcome-task-guidance ol{margin:0;padding-left:1.35rem;display:grid;gap:5px}
.welcome-task-filed{display:block;margin-top:2px}
.welcome-task-action{padding-top:2px;display:flex;flex-direction:column;align-items:stretch;gap:6px;min-width:170px}
.welcome-task-action a,.welcome-task-action button,.welcome-task-action b,.welcome-task-action span{width:100%;box-sizing:border-box;text-align:center}
.welcome-verification-control{margin-bottom:18px}
.staff-welcome-task{align-items:flex-start;padding:16px 14px;gap:14px}
.staff-welcome-task-main{min-width:0;display:grid;gap:7px}
.staff-welcome-task-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.staff-welcome-task-heading>b{line-height:1.3}
.staff-welcome-task-heading>span{display:inline-flex;padding:3px 7px;border:1px solid #6b6b4e;background:#343a2b;color:#e9d9a8;font-size:.68rem;font-weight:900;letter-spacing:.08em;white-space:nowrap}
.staff-welcome-guidance{margin-top:3px;padding:10px 12px;background:#2c3225;border-left:3px solid #94834d;line-height:1.45}
.staff-welcome-guidance ol{margin:7px 0 0;padding-left:1.3rem;display:grid;gap:4px}
.staff-welcome-task form{align-self:flex-start;flex-wrap:wrap}
@media(max-width:900px){.welcome-task{grid-template-columns:38px 1fr}.welcome-task-action{grid-column:2;min-width:0;width:100%;align-items:flex-start}.welcome-task-action a,.welcome-task-action button,.welcome-task-action b,.welcome-task-action span{width:auto;max-width:100%}.welcome-task-heading{display:grid;justify-content:start}.staff-welcome-task-heading{display:grid;justify-content:start}}

/* === Canonical 201 File / Soldier Service View === */
.page-201 .file-cabinet-room{max-width:1500px;margin:0 auto;padding:18px 22px 48px}
.page-201 .room-label{display:none}
.page-201 .manila-file{max-width:1420px;margin:0 auto;background:transparent;border:0;box-shadow:none;padding:0}
.page-201 .manila-tab{display:none}
.canonical-201-context-nav{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 12px}
.canonical-201-context-nav a{display:inline-flex;align-items:center;min-height:42px;padding:10px 16px;border:1px solid #9f9167;background:#d8caa0;color:#2f2b20;text-decoration:none;font-weight:800;letter-spacing:.04em}
.canonical-201-header{margin:0;border-bottom:0!important;padding:14px 18px!important}
.canonical-201-header .army-letterhead{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;border-bottom:1px solid #8d8365;padding:0 0 12px}
.canonical-201-header .army-letterhead strong{font-size:1.35rem;letter-spacing:.06em}
.canonical-201-tabs{position:sticky;top:0;z-index:24;display:flex;gap:0;overflow-x:auto;background:#273021;border:1px solid #6e704e;border-top:0;scrollbar-width:thin}
.canonical-201-tabs button{appearance:none;border:0;border-right:1px solid #6e704e;background:#273021;color:#e7ddbd;min-height:48px;padding:11px 16px;font:700 .78rem/1.2 var(--mono,monospace);letter-spacing:.05em;white-space:nowrap;cursor:pointer}
.canonical-201-tabs button:hover,.canonical-201-tabs button:focus-visible,.canonical-201-tabs button.is-active{background:#d8caa0;color:#2f2b20;outline:none}
.canonical-201-overview{margin-top:0}
.canonical-201-overview-sheet{margin:0!important;padding:18px!important}
.canonical-201-top-grid{display:grid;grid-template-columns:minmax(330px,.95fr) minmax(0,1.45fr);gap:22px}
.canonical-201-uniform h3{margin:0 0 10px;border-bottom:1px solid #958a69;padding:0 0 8px;letter-spacing:.08em}
.canonical-201-uniform .squad-combat-uniform-stage{min-height:470px;background:#0c0d0b;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.canonical-201-uniform .squad-combat-uniform-stage .uniform-base-image{width:100%;height:100%;max-height:540px;object-fit:contain;display:block}
.canonical-201-facts{display:grid;grid-template-columns:1fr 1fr;border:1px solid #b4aa89;border-bottom:0;margin-top:12px}
.canonical-201-facts span{display:flex;flex-direction:column;gap:5px;min-height:70px;padding:12px;border-right:1px solid #b4aa89;border-bottom:1px solid #b4aa89}
.canonical-201-facts span:nth-child(2n){border-right:0}
.canonical-201-facts small{font-size:.66rem;letter-spacing:.09em;color:#6d6246}
.canonical-201-facts b{font-size:.93rem}
.canonical-201-service>header{border-bottom:2px solid #9c9274;padding-bottom:12px;margin-bottom:14px}
.canonical-201-service>header small{letter-spacing:.12em}
.canonical-201-service>header h2{font-size:2.4rem;line-height:1;margin:8px 0 0;font-family:var(--display,Georgia,serif)}
.canonical-201-service .squad-combat-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.canonical-201-service .squad-combat-stat-grid article{border:1px solid #b7ad8c;min-height:95px;padding:12px;display:flex;flex-direction:column;gap:5px}
.canonical-201-service .squad-combat-stat-grid small{font-size:.65rem;letter-spacing:.09em}
.canonical-201-service .squad-combat-stat-grid b{font-size:1.35rem}
.canonical-201-service .squad-combat-stat-grid span{font-size:.73rem;color:#6b614c}
.canonical-201-service .squad-combat-section{border:1px solid #b7ad8c;padding:14px;margin:0 0 10px;background:rgba(255,255,255,.08)}
.canonical-201-service .squad-combat-section h3{margin:5px 0 8px;font-size:1rem;letter-spacing:.04em}
.canonical-201-service .squad-combat-section p{margin:5px 0;line-height:1.5}
.canonical-201-service .squad-combat-ledger{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}
.canonical-201-service .squad-combat-ledger span{display:flex;justify-content:space-between;gap:12px;border-top:1px dotted #b3a986;padding:9px 4px}
.canonical-201-service .squad-combat-ledger em{font-style:normal;white-space:nowrap}
.canonical-inline-tab-jump{border:1px solid #6f704c;background:#273021;color:#efe5c4;padding:10px 13px;font:700 .72rem/1.2 var(--mono,monospace);letter-spacing:.05em;cursor:pointer}
.page-201 .file-document[hidden],.page-201 [data-canonical-tab][hidden],.canonical-201-overview[hidden]{display:none!important}
.page-201 .file-document{margin:14px 0}
.page-201 .staff-201-jacket-cover{margin:12px 0}
.page-201 .staff-201-onboarding-card{margin:12px 0}
@media (max-width:1000px){
 .canonical-201-top-grid{grid-template-columns:1fr}
 .canonical-201-uniform .squad-combat-uniform-stage{min-height:360px}
 .canonical-201-service .squad-combat-stat-grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:620px){
 .page-201 .file-cabinet-room{padding:8px}
 .canonical-201-tabs button{padding:10px 12px;font-size:.7rem}
 .canonical-201-service>header h2{font-size:1.75rem}
 .canonical-201-service .squad-combat-stat-grid{grid-template-columns:1fr 1fr}
 .canonical-201-facts{grid-template-columns:1fr}
 .canonical-201-facts span{border-right:0}
 .canonical-201-service .squad-combat-ledger{grid-template-columns:1fr}
}
.canonical-soldier-link{text-decoration:none;color:inherit;cursor:pointer}
a.career-row.canonical-soldier-link:hover,a.career-row.canonical-soldier-link:focus-visible,.member-unit-table__row.canonical-soldier-link:hover,.member-unit-table__row.canonical-soldier-link:focus-visible{background:rgba(92,91,58,.12);outline:1px solid #8e825e;outline-offset:-1px}

/* === CANONICAL 201 / UNIFORM RIBBON RACK GEOMETRY — 2026-08-25 ===
   The 201 File is the visual master. All issued-uniform views use the same
   chest anchor and a tight military rack: 3 across, touching, stacked. */
:root{
  --issued-uniform-ribbon-width:32px;
  --issued-uniform-ribbon-height:10px;
  --issued-uniform-ribbon-col-gap:0px;
  --issued-uniform-ribbon-row-gap:0px;
  --issued-uniform-rack-left:63.8%;
  --issued-uniform-rack-top:32.8%;
}
.wall-locker-ribbon-rack,
.locker-desktop-ribbon-rack,
.locker-modal-ribbon-rack,
.uniform-ribbon-rack--file,
.squad-ribbon-rack,
.soldier-home-ribbon-rack{
  position:absolute!important;
  left:var(--issued-uniform-rack-left)!important;
  top:var(--issued-uniform-rack-top)!important;
  transform:none!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:flex-start!important;
  gap:0!important;
  width:auto!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row,
.locker-desktop-ribbon-rack .uniform-ribbon-row,
.locker-modal-ribbon-rack .uniform-ribbon-row,
.uniform-ribbon-rack--file .uniform-ribbon-row,
.squad-ribbon-rack .uniform-ribbon-row,
.soldier-home-ribbon-rack .uniform-ribbon-row{
  display:flex!important;
  flex-wrap:nowrap!important;
  justify-content:flex-start!important;
  align-items:flex-start!important;
  gap:0!important;
  margin:0!important;
  padding:0!important;
  width:max-content!important;
  max-width:calc(3 * var(--issued-uniform-ribbon-width))!important;
  line-height:0!important;
}
.wall-locker-ribbon-rack img,
.locker-desktop-ribbon-rack img,
.locker-modal-ribbon-rack img,
.uniform-ribbon-rack--file img,
.squad-ribbon-rack img,
.soldier-home-ribbon-rack img,
.wall-locker-ribbon-rack .row-size-1 img,
.locker-desktop-ribbon-rack .row-size-1 img,
.locker-modal-ribbon-rack .row-size-1 img,
.uniform-ribbon-rack--file .row-size-1 img,
.squad-ribbon-rack .row-size-1 img,
.soldier-home-ribbon-rack .row-size-1 img{
  display:block!important;
  width:var(--issued-uniform-ribbon-width)!important;
  height:var(--issued-uniform-ribbon-height)!important;
  min-width:var(--issued-uniform-ribbon-width)!important;
  max-width:var(--issued-uniform-ribbon-width)!important;
  min-height:var(--issued-uniform-ribbon-height)!important;
  max-height:var(--issued-uniform-ribbon-height)!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  object-fit:fill!important;
}
/* Clickable ribbon buttons inside the 201 rack must not introduce spacing. */
.uniform-ribbon-rack--file .ribbon-rack-button{
  display:block!important;
  width:var(--issued-uniform-ribbon-width)!important;
  height:var(--issued-uniform-ribbon-height)!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  line-height:0!important;
}
/* Keep the three principal uniform canvases using the same master proportions. */
.squad-uniform-stage,
.locker-uniform-detail__stage,
.locker-bay__visual--uniform,
.wall-locker-uniform-view{
  aspect-ratio:560 / 650;
}
.squad-uniform-stage>.uniform-base-image,
.locker-uniform-detail__stage>.uniform-base-image,
.locker-bay__visual--uniform>.uniform-base-image,
.wall-locker-uniform-view>.uniform-base-image{
  width:100%!important;
  height:100%!important;
  object-fit:contain!important;
  object-position:center top!important;
}
/* Header action is a link now on the primary 201 bay; match existing button styling. */
.locker-bay--201-primary>header>a{
  color:inherit;
  text-decoration:none;
  font:inherit;
  font-size:inherit;
}

/* === FINAL UNIFORM RACK STANDARDIZATION — 2026-08-25 ===
   One 3-column military ribbon rack geometry is used on the 201 File,
   Wall Locker, and uniform detail modal. Short top rows are centered. */
.wall-locker-ribbon-rack,
.locker-desktop-ribbon-rack,
.locker-modal-ribbon-rack,
.uniform-ribbon-rack--file,
.squad-ribbon-rack,
.soldier-home-ribbon-rack{
  width:calc(3 * var(--issued-uniform-ribbon-width))!important;
  align-items:center!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row,
.locker-desktop-ribbon-rack .uniform-ribbon-row,
.locker-modal-ribbon-rack .uniform-ribbon-row,
.uniform-ribbon-rack--file .uniform-ribbon-row,
.squad-ribbon-rack .uniform-ribbon-row,
.soldier-home-ribbon-rack .uniform-ribbon-row{
  justify-content:center!important;
  align-self:center!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-3,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-3,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-3,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-3,
.squad-ribbon-rack .uniform-ribbon-row.row-size-3,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-3{
  width:calc(3 * var(--issued-uniform-ribbon-width))!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-2,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-2,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-2,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-2,
.squad-ribbon-rack .uniform-ribbon-row.row-size-2,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-2{
  width:calc(2 * var(--issued-uniform-ribbon-width))!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-1,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-1,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-1,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-1,
.squad-ribbon-rack .uniform-ribbon-row.row-size-1,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-1{
  width:var(--issued-uniform-ribbon-width)!important;
}

/* Wall Locker canonical 201 File entry — folder artwork replaces uniform preview. */
.locker-bay__visual--201-file{
  align-items:center;
  justify-content:center;
  padding:10px 14px;
  overflow:hidden;
}
.locker-bay__visual--201-file>.wall-locker-201-file-image{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center;
  display:block;
  filter:drop-shadow(0 14px 14px rgba(0,0,0,.32));
}
.wall-locker-201-file-view{
  order:1;
  flex:1;
  height:auto;
  min-height:0;
  padding:6px 8px;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.wall-locker-201-file-view>.wall-locker-201-file-image{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center;
  display:block;
  filter:drop-shadow(0 14px 14px rgba(0,0,0,.32));
}

/* Canonical 201 overview field-uniform display — 2026-08-25 */
.canonical-201-field-uniform-stage{
  display:flex;
  align-items:flex-start;
  justify-content:center;
  overflow:hidden;
}
.canonical-201-field-uniform-stage .canonical-201-field-uniform-image{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center top;
}


/* === 201 OVERVIEW FIELD UNIFORM CLEAN FIT — 2026-08-25 ===
   This override affects ONLY the canonical 201 Overview field-uniform panel.
   The Overview deliberately carries no ribbon rack; ribbons remain available
   in Awards / service-uniform displays. */
.canonical-201-uniform .canonical-201-field-uniform-stage{
  aspect-ratio:1198 / 1313!important;
  min-height:0!important;
  height:auto!important;
  background:#000!important;
  align-items:stretch!important;
  justify-content:stretch!important;
}
.canonical-201-uniform .canonical-201-field-uniform-stage .canonical-201-field-uniform-image{
  width:100%!important;
  height:100%!important;
  max-height:none!important;
  object-fit:cover!important;
  object-position:center center!important;
  display:block!important;
  transform:scale(1.015);
  transform-origin:center center;
}
.canonical-201-uniform .canonical-201-field-uniform-stage .squad-ribbon-rack,
.canonical-201-uniform .canonical-201-field-uniform-stage .uniform-ribbon-rack{
  display:none!important;
}

/* 2026-08-25 Staff UX cleanup + member action reliability */
.staff-task-launcher{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin:0 0 18px}.staff-task-launcher a{display:grid;gap:4px;min-width:0;padding:14px 15px;background:#e9dfbf;border:1px solid #857751;border-top:4px solid #3c4634;color:#252319;text-decoration:none;box-shadow:0 4px 10px #0002}.staff-task-launcher a small{font:700 9px 'Courier Prime',monospace;letter-spacing:.13em;color:#786836}.staff-task-launcher a b{font:700 15px 'Stardos Stencil',serif;letter-spacing:.02em}.staff-task-launcher a span{font:400 10px/1.35 'Courier Prime',monospace;color:#5f5948}.staff-task-launcher a:hover,.staff-task-launcher a:focus-visible{background:#f3e8c9;border-color:#b18f3d;outline:2px solid #b18f3d;outline-offset:2px;transform:translateY(-1px)}
.member-action-help{margin:16px 0 10px;padding:10px 12px;border-left:4px solid #9c8442;background:#e7ddbd;color:#302b20;font:12px/1.45 'Courier Prime',monospace}.member-notification-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.member-notification-actions a,.member-notification-actions button{min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:8px 11px;border:1px solid #756944;background:#35402d;color:#f0e4c2;text-decoration:none;font:700 10px 'Courier Prime',monospace;letter-spacing:.04em;cursor:pointer}.member-notification-actions form{margin:0}.member-notification-actions button{background:#ddd1ad;color:#2d291f}.member-notification-actions a:hover,.member-notification-actions button:hover{outline:2px solid #b49342;outline-offset:1px}
.action-ledger-card:target{outline:4px solid #b7943c;outline-offset:4px;background:#f4e7bd;scroll-margin-top:180px}
@media(max-width:1200px){.staff-task-launcher{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.staff-task-launcher{grid-template-columns:1fr 1fr}}@media(max-width:500px){.staff-task-launcher{grid-template-columns:1fr}}

/* ========================================================================== */
/* MOBILE / TABLET USABILITY PASS — 2026-08-25                               */
/* Everything below is breakpoint-scoped. Desktop (>820px) remains unchanged. */
/* ========================================================================== */
@media (max-width:820px){
  html{-webkit-text-size-adjust:100%;scroll-padding-top:12px}
  body{overflow-x:hidden;min-width:0}
  img,svg,video,canvas{max-width:100%;height:auto}
  input,select,textarea,button{max-width:100%;box-sizing:border-box}

  /* Global logged/public navigation: thumb-sized, contained, no page overflow. */
  .header-desk{padding-left:12px!important;padding-right:12px!important;gap:8px}
  .index-button{min-height:44px;padding:10px 12px;white-space:nowrap}
  .record-index{z-index:1000!important;max-height:min(72vh,560px)!important;overflow-y:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;box-shadow:0 18px 28px rgba(0,0,0,.45)}
  .record-index a{min-height:46px!important;padding:12px 14px!important;box-sizing:border-box}
  .public-back-strip,.logged-back-wrap{padding-left:12px!important;padding-right:12px!important}

  /* Staff shell: keep all work centers reachable without a giant vertical rail. */
  .staff-shell-active .staff-command-rail{position:relative!important;inset:auto!important;width:100%!important;height:auto!important;max-height:none!important;padding:8px 10px!important;overflow:visible!important;box-shadow:none!important}
  .staff-rail-heading{padding:5px 4px 7px!important;min-height:40px}
  .staff-rail-heading small,.staff-rail-heading span{font-size:8px!important}
  .staff-rail-nav{display:flex!important;gap:7px!important;overflow-x:auto!important;overflow-y:hidden!important;scroll-snap-type:x proximity;padding:3px 0 7px!important;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
  .staff-rail-nav a{flex:0 0 auto!important;min-width:138px!important;min-height:44px!important;padding:9px 10px!important;scroll-snap-align:start;display:flex;align-items:center}
  .staff-global-bar-inner{display:flex!important;gap:7px!important;overflow-x:auto!important;overflow-y:hidden!important;padding:7px 10px!important;scroll-snap-type:x proximity;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
  .command-global-label{flex:0 0 auto;min-width:120px}
  .staff-global-bar a{flex:0 0 auto!important;min-width:142px!important;min-height:48px!important;padding:8px 10px!important;scroll-snap-align:start;box-sizing:border-box}
  .staff-global-bar a b{font-size:10px!important}.staff-global-bar a small{font-size:7px!important}
  .staff-utility-bar{padding:8px 10px!important;gap:8px!important;grid-template-columns:1fr!important}
  .staff-breadcrumbs{overflow-x:auto;white-space:nowrap;padding-bottom:2px}
  .staff-global-search{display:grid!important;grid-template-columns:1fr auto!important;gap:7px!important;align-items:end!important;width:100%!important}
  .staff-global-search label{grid-column:1/-1}
  .staff-global-search input{width:100%!important;min-width:0!important;min-height:44px!important;font-size:16px!important}
  .staff-global-search button{min-height:44px!important;min-width:68px!important}
  .staff-return-office{display:none!important}
  .staff-center-shell,.structured-personnel-shell,.deep-shell{width:100%!important;max-width:100%!important;padding-left:10px!important;padding-right:10px!important;box-sizing:border-box}
  .staff-task-launcher{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
  .staff-task-launcher a{min-height:88px;padding:12px!important}
  .staff-office-grid,.staff-center-grid,.staff-center-top-grid,.staff-201-action-grid,.staff-batch-people{grid-template-columns:1fr!important}
  .staff-action-row,.staff-search-result,.staff-recent-row{min-width:0!important}

  /* Drawers/modals become phone-friendly work surfaces. */
  .staff-soldier-drawer,.soldier-drawer-panel,[data-soldier-drawer-panel]{width:min(94vw,620px)!important;max-width:94vw!important}
  .modal-card,.locker-modal-card,.award-modal__sheet,.member-award-modal__sheet{width:min(94vw,720px)!important;max-width:94vw!important;max-height:90vh!important;overflow:auto!important;margin:5vh auto!important;box-sizing:border-box}
  body.staff-drawer-open,body.award-modal-open{overflow:hidden}

  /* Universal 201: one clean reading column; tabs stay horizontally swipeable. */
  .personnel-records-room,.page-201 .deep-shell{width:100%!important;max-width:100%!important;padding-left:10px!important;padding-right:10px!important;box-sizing:border-box}
  .canonical-201-context-nav{gap:7px!important;overflow-x:auto;flex-wrap:nowrap!important;padding-bottom:3px;-webkit-overflow-scrolling:touch}
  .canonical-201-context-nav a{flex:0 0 auto;min-height:44px!important;padding:9px 12px!important}
  .canonical-201-header{padding:12px!important}
  .canonical-201-header .army-letterhead strong{font-size:1.05rem!important}
  .canonical-201-tabs{position:relative!important;top:auto!important;overflow-x:auto!important;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
  .canonical-201-tabs button{flex:0 0 auto;min-height:46px!important;padding:10px 12px!important;scroll-snap-align:start;font-size:.7rem!important}
  .canonical-201-overview-sheet{padding:12px!important}
  .canonical-201-top-grid{grid-template-columns:1fr!important;gap:14px!important}
  .canonical-201-uniform .canonical-201-field-uniform-stage{width:min(100%,520px)!important;margin:0 auto!important}
  .canonical-201-facts{grid-template-columns:1fr 1fr!important}
  .canonical-201-facts span{min-height:60px!important;padding:10px!important}
  .canonical-201-service>header h2{font-size:clamp(1.5rem,7vw,2rem)!important;overflow-wrap:anywhere}
  .canonical-201-service .squad-combat-stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}
  .canonical-201-service .squad-combat-stat-grid article{min-height:80px!important;padding:10px!important}
  .canonical-201-service .squad-combat-ledger{grid-template-columns:1fr!important}
  .canonical-201-service .squad-combat-ledger span{align-items:flex-start;overflow-wrap:anywhere}
  .personnel-index{overflow-x:auto!important;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;padding:12px 8px!important}
  .personnel-index-row{min-width:680px!important}

  /* Wall Locker/member home: cards stack predictably and controls remain tappable. */
  .personal-worktable,.locker-grid,.wall-locker-grid,.member-duty-grid,.member-record-desk{grid-template-columns:1fr!important;gap:12px!important;padding-left:10px!important;padding-right:10px!important}
  .locker-bay,.locker-bay--wide,.locker-bay--201-primary{grid-column:1!important;min-width:0!important}
  .locker-bay header a,.locker-bay header button,.member-duty-actions>a,.member-duty-actions button{min-height:44px!important;display:inline-flex;align-items:center;justify-content:center}
  .locker-bay__visual--201-file,.wall-locker-201-file-view{min-height:240px!important}
  .locker-bay__visual--201-file>.wall-locker-201-file-image,.wall-locker-201-file-view>.wall-locker-201-file-image{max-height:360px!important}
  .member-record-hero{min-height:320px!important}
  .member-record-identity{left:14px!important;right:14px!important;bottom:24px!important}
  .member-record-identity h1{font-size:clamp(32px,11vw,48px)!important;overflow-wrap:anywhere}

  /* Member actions/onboarding: action controls become full-width, obvious targets. */
  .member-notification-actions{display:grid!important;grid-template-columns:1fr 1fr!important;width:100%!important;gap:8px!important}
  .member-notification-actions a,.member-notification-actions form,.member-notification-actions button{width:100%!important;box-sizing:border-box}
  .member-notification-actions a,.member-notification-actions button{min-height:44px!important}
  .member-action-help{font-size:12px!important;margin:10px 0!important}
  .welcome-task{grid-template-columns:32px minmax(0,1fr)!important;gap:10px!important;padding:14px 12px!important}
  .welcome-task-action{grid-column:1/-1!important;width:100%!important;display:grid!important;grid-template-columns:1fr!important;gap:7px!important}
  .welcome-task-action a,.welcome-task-action button,.welcome-task-action b,.welcome-task-action span,.welcome-task-action form{width:100%!important;max-width:none!important;box-sizing:border-box}
  .welcome-task-action button,.welcome-task-action a{min-height:44px!important}
  .welcome-task-guidance{padding:10px 11px!important}
  .welcome-submit-board{padding:16px 12px!important}
  .welcome-submit-board form{display:grid!important;grid-template-columns:1fr!important}
  .welcome-submit-board textarea,.welcome-submit-board button{width:100%!important;min-width:0!important}
  .welcome-preview-banner{display:grid!important;grid-template-columns:1fr!important;gap:10px!important}
  .welcome-preview-banner a{white-space:normal!important;text-align:center;min-height:44px;display:flex;align-items:center;justify-content:center}

  /* Formation/roster screens: preserve all information with scroll instead of clipping. */
  .roster-table,.morning-roster,.property-table,.stock-table,.promotion-board,.typed-table,.personnel-index-row,.s1-roster-sheet{max-width:100%}
  .roster-table,.morning-roster,.property-table,.stock-table,.promotion-board,.typed-table{overflow-x:auto!important;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
  .member-unit-table,.s1-roster-list,.formation-roll,.participant-roster{min-width:0!important}
  .member-unit-table__row,.career-row,.s1-roster-row{overflow-wrap:anywhere}

  /* Forms: stop iOS zoom and prevent cramped two/three-column controls. */
  form input,form select,form textarea{font-size:16px!important;min-height:44px}
  form textarea{min-height:88px}
  .army-form-grid,.s3-wizard-form,.s3-wizard-form fieldset,.staff-batch-form,.journal-form,.compare-picker,.deep-search{grid-template-columns:1fr!important}
  .army-form-grid button,.s3-wizard-form button,.staff-batch-form button,.journal-form button{min-height:44px}

  /* Reports/operations/logistics: retain data but reduce density on touch devices. */
  .ops-center,.operations-journal-area,.recommendations-area,.operation-file-room,.operation-aar,.supply-room,.company-supply-area,.s4-ledger-area,.training-desk,.training-records-area{padding-left:10px!important;padding-right:10px!important}
  .op-meta{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .s3-operation-timeline,.unit-stat-strip,.packet-grid,.situation-grid,.weapon-story-stats,.member-mini-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}

  /* General phone hygiene. */
  .paper-sheet,.document-sheet,.file-document,.field-panel{max-width:100%;box-sizing:border-box}
  pre,code{white-space:pre-wrap;overflow-wrap:anywhere}
  .flash-dispatch,.dispatch-stack{max-width:calc(100vw - 20px)!important;right:10px!important;left:10px!important;width:auto!important}
}

@media (max-width:560px){
  .unit-wire{font-size:8px!important}.unit-mark img{width:58px!important;height:auto!important}
  .index-button{font-size:10px!important}
  .staff-task-launcher{grid-template-columns:1fr!important}
  .staff-task-launcher a{min-height:72px!important}
  .staff-global-bar a{min-width:130px!important}.staff-rail-nav a{min-width:128px!important}
  .staff-global-search{grid-template-columns:1fr!important}.staff-global-search button{width:100%!important}
  .canonical-201-facts{grid-template-columns:1fr!important}.canonical-201-facts span{border-right:0!important}
  .canonical-201-service .squad-combat-stat-grid{grid-template-columns:1fr!important}
  .canonical-201-uniform .canonical-201-field-uniform-stage{width:100%!important}
  .member-notification-actions{grid-template-columns:1fr!important}
  .s3-operation-timeline,.unit-stat-strip,.packet-grid,.situation-grid,.weapon-story-stats,.member-mini-grid,.op-meta{grid-template-columns:1fr!important}
  .staff-brief-strip{grid-template-columns:1fr!important}
  .deep-result-grid,.action-item-grid,.watch-grid,.duty-suggestion-grid,.served-grid{grid-template-columns:1fr!important}
  .public-award-card__image img{max-width:100%!important}
  .member-record-identity h1{font-size:clamp(30px,12vw,42px)!important}
}

/* ========================================================================== */
/* PUBLIC EXPERIENCE — MEMBER FEATURE SHOWCASE                                */
/* ========================================================================== */
.public-experience-page{background:#141a14;color:#efe5ca}
.public-experience-page .experience-hero{min-height:610px}
.public-experience-page .experience-hero>img{filter:saturate(.65) contrast(1.08) brightness(.8)}
.public-experience-page .experience-hero>div:last-child{max-width:980px}
.public-experience-page .experience-hero h1{max-width:860px}
.public-experience-page .experience-hero p{font-size:17px;max-width:830px;color:#eee4ca}
.experience-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.experience-hero-actions a,.experience-final-cta>a{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 18px;text-decoration:none;font:700 10px 'Courier Prime';letter-spacing:.08em}
.experience-primary-cta,.experience-final-cta>a{background:#d5b154;color:#17170f;border:1px solid #e5c870;box-shadow:0 4px 0 #725b23}
.experience-secondary-cta{border:1px solid #c7b98f;color:#eee3c3;background:rgba(10,13,9,.55)}
.experience-board{display:grid;gap:22px}
.experience-board-heading{max-width:900px;margin-bottom:0}
.experience-board-heading h2{font-size:44px;color:#efe4c9}
.experience-feature{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,1fr);align-items:stretch;min-height:460px;border:1px solid #766a4d;background:#d9cba7;color:#292217;overflow:hidden}
.experience-feature--record{grid-template-columns:minmax(390px,.8fr) minmax(0,1.2fr)}
.experience-feature-copy{padding:48px 46px;display:flex;flex-direction:column;justify-content:center}
.experience-feature-copy>small,.experience-uniform-section header small,.experience-ledger-section header small,.experience-awards-section small,.experience-final-cta small{font:700 8px 'Courier Prime';letter-spacing:.14em;color:#765a21}
.experience-feature-copy h2,.experience-uniform-section h2,.experience-ledger-section h2,.experience-awards-section h2,.experience-final-cta h2{font:700 42px/1 'Stardos Stencil';margin:8px 0 14px}
.experience-feature-copy p,.experience-uniform-section header p,.experience-ledger-section header p,.experience-awards-section p,.experience-final-cta p{font:14px/1.65 Arial;margin:0;max-width:760px}
.experience-asset{min-height:430px;background:#0b0e0b;display:flex;align-items:center;justify-content:center;overflow:hidden}
.experience-asset img{display:block;width:100%;height:100%;object-fit:contain}
.experience-asset--m16{padding:36px;background:radial-gradient(circle at 50% 45%,#283026,#0b0e0b 72%)}
.experience-asset--folder{padding:34px;background:radial-gradient(circle at 50% 45%,#33362a,#11140f 70%)}
.experience-asset--folder img{max-height:440px}
.experience-asset--squad img{object-fit:cover;filter:saturate(.72) contrast(1.04)}
.experience-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}
.experience-detail-grid span{padding:13px 14px;border:1px solid #9b8b64;background:rgba(255,255,255,.16);font:11px/1.45 Arial}
.experience-detail-grid b{display:block;margin-bottom:4px;font:700 9px 'Courier Prime';letter-spacing:.07em}
.experience-uniform-section{background:#20261e;border:1px solid #5c634f;padding:34px}
.experience-uniform-section>header{max-width:760px;margin-bottom:22px}
.experience-uniform-section header small{color:#d4ae4d}
.experience-uniform-section h2{color:#f1e5c6;margin-bottom:8px}
.experience-uniform-section header p{color:#c9bea4}
.experience-uniform-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.experience-uniform-grid article{display:grid;grid-template-columns:minmax(250px,.95fr) 1.05fr;min-height:440px;background:#d8cba8;color:#292217;border:1px solid #776b4e;overflow:hidden}
.experience-uniform-image{background:#0b0d0b;min-height:440px;overflow:hidden;display:flex;align-items:center;justify-content:center}
.experience-uniform-image img{width:100%;height:100%;object-fit:contain;display:block}
.experience-uniform-image--field img{object-fit:cover;object-position:center top}
.experience-uniform-copy{padding:30px 26px;display:flex;flex-direction:column;justify-content:center}
.experience-uniform-copy small{font:700 8px 'Courier Prime';color:#765a21;letter-spacing:.12em}
.experience-uniform-copy h3{font:700 27px/1 'Stardos Stencil';margin:7px 0 12px}
.experience-uniform-copy p{font:13px/1.6 Arial;margin:0}
.experience-record-list{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:22px}
.experience-record-list span{border:1px solid #897a58;padding:10px 6px;text-align:center;font:700 8px 'Courier Prime';background:rgba(255,255,255,.13)}
.experience-ledger-section{background:#ded2b0;color:#292217;border:1px solid #796c4f;padding:34px}
.experience-ledger-section>header{max-width:850px;margin-bottom:20px}
.experience-ledger-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.experience-ledger-grid article{min-height:155px;padding:20px;background:#e8ddbe;border:1px solid #9a8b66}
.experience-ledger-grid small{display:block;font:700 8px 'Courier Prime';color:#7a602a;letter-spacing:.1em}
.experience-ledger-grid b{display:block;font:700 20px/1 'Stardos Stencil';margin:8px 0 10px}
.experience-ledger-grid p{font:12px/1.55 Arial;margin:0}
.experience-chain{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:24px;font:700 11px 'Courier Prime';letter-spacing:.05em}
.experience-chain i{font-style:normal;color:#8a6926}
.experience-awards-section{display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:35px;padding:40px;background:#d9cba7;color:#292217;border:1px solid #786b4d}
.experience-ribbon-rack{justify-self:center;display:grid;grid-template-columns:repeat(3,150px);gap:0;align-content:center;filter:drop-shadow(0 8px 10px rgba(0,0,0,.22))}
.experience-ribbon-rack img{display:block;width:150px;height:45px;object-fit:fill;margin:0}
.experience-final-cta{text-align:center;padding:65px 35px;background:linear-gradient(rgba(10,13,9,.78),rgba(10,13,9,.9)),url('/static/art/public-overhaul/recruiting-formation.webp') center/cover no-repeat;border:1px solid #4e5b40}
.experience-final-cta small{color:#d8b251}
.experience-final-cta h2{max-width:900px;margin:10px auto 14px;color:#f1e5c7;font-size:48px}
.experience-final-cta p{max-width:720px;margin:0 auto 25px;color:#d2c7ae}

@media(max-width:1100px){
  .experience-feature,.experience-feature--record{grid-template-columns:1fr 1fr}
  .experience-uniform-grid{grid-template-columns:1fr}
  .experience-uniform-grid article{grid-template-columns:minmax(280px,.9fr) 1.1fr}
  .experience-ledger-grid{grid-template-columns:1fr 1fr}
  .experience-ribbon-rack{grid-template-columns:repeat(3,120px)}
  .experience-ribbon-rack img{width:120px;height:36px}
}
@media(max-width:820px){
  .public-experience-page .experience-hero{min-height:500px}
  .public-experience-page .experience-hero p{font-size:15px}
  .experience-board{gap:14px}
  .experience-board-heading h2{font-size:36px}
  .experience-feature,.experience-feature--record{grid-template-columns:1fr;min-height:0}
  .experience-feature--record .experience-asset{order:2}
  .experience-feature-copy{padding:32px 24px}
  .experience-feature-copy h2,.experience-uniform-section h2,.experience-ledger-section h2,.experience-awards-section h2{font-size:34px}
  .experience-asset{min-height:300px;max-height:430px}
  .experience-asset--m16,.experience-asset--folder{padding:20px}
  .experience-uniform-section,.experience-ledger-section{padding:24px 18px}
  .experience-uniform-grid article{grid-template-columns:1fr;min-height:0}
  .experience-uniform-image{min-height:360px;max-height:520px}
  .experience-uniform-copy{padding:24px}
  .experience-detail-grid,.experience-ledger-grid{grid-template-columns:1fr}
  .experience-record-list{grid-template-columns:1fr 1fr}
  .experience-awards-section{grid-template-columns:1fr;padding:30px 22px}
  .experience-ribbon-rack{justify-self:start;grid-template-columns:repeat(3,minmax(0,1fr));width:min(100%,450px)}
  .experience-ribbon-rack img{width:100%;height:auto;aspect-ratio:10/3}
  .experience-final-cta{padding:50px 22px}
  .experience-final-cta h2{font-size:38px}
}
@media(max-width:560px){
  .public-experience-page .experience-hero h1{font-size:48px}
  .experience-hero-actions{display:grid;grid-template-columns:1fr}
  .experience-hero-actions a{width:100%}
  .experience-board-heading h2{font-size:31px}
  .experience-feature-copy h2,.experience-uniform-section h2,.experience-ledger-section h2,.experience-awards-section h2{font-size:30px}
  .experience-uniform-image{min-height:300px}
  .experience-record-list{grid-template-columns:1fr 1fr}
  .experience-final-cta h2{font-size:34px}
}

/* 2026-08-25 staff reliability + consolidation pass */
.command-action-now{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(360px,1.25fr);gap:12px;margin:0 0 14px}.command-action-card{display:grid;grid-template-columns:1fr auto;gap:5px 14px;align-items:center;padding:14px 16px;border:1px solid rgba(99,80,43,.45);background:#e7d9b7;color:#17160f;text-decoration:none;box-shadow:0 2px 0 rgba(0,0,0,.18)}.command-action-card small,.command-action-card span{grid-column:1/-1}.command-action-card small{font:700 10px/1.2 var(--mono,monospace);letter-spacing:.13em}.command-action-card b{font:800 17px/1.1 var(--typewriter,monospace)}.command-action-card strong{font-size:24px}.command-action-card span{opacity:.72;font-size:12px}.command-action-card.attention,.command-action-card.ready-to-launch{border-left:7px solid #7a2f21}.command-action-card.clear{border-left:7px solid #40522d}.reliability-summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0}.reliability-card{display:flex;min-height:150px;flex-direction:column;gap:7px;padding:15px;border:1px solid rgba(113,91,50,.5);background:#e6d9b9;color:#17160f;text-decoration:none}.reliability-card small{font:700 10px/1.2 var(--mono,monospace);letter-spacing:.12em}.reliability-card b{font:900 19px/1.15 var(--typewriter,monospace)}.reliability-card span{font-size:12px;line-height:1.45;opacity:.78}.reliability-card em{margin-top:auto;font:700 10px/1.2 var(--mono,monospace);letter-spacing:.08em}.reliability-card.state-current{border-top:5px solid #465b34}.reliability-card.state-action-required,.reliability-card.state-check-failed{border-top:5px solid #85372b}.reliability-lower-grid{margin-top:18px}.reliability-server-line{display:flex;align-items:end;justify-content:space-between;gap:18px;padding:14px 0;border-bottom:1px solid rgba(75,58,30,.25)}.reliability-server-line strong{font-size:38px}.reliability-server-line span{text-align:right}.reliability-integrity-counts{display:flex;gap:10px;margin:12px 0}.reliability-integrity-counts span{padding:8px 10px;border:1px solid rgba(60,50,35,.25)}.reliability-exception{display:block;padding:10px 0;border-top:1px dotted rgba(60,50,35,.3);color:inherit;text-decoration:none}.reliability-exception b,.reliability-exception span{display:block}.reliability-exception span{margin-top:3px;font-size:12px;opacity:.75}
@media(max-width:820px){.command-action-now,.reliability-summary-grid{grid-template-columns:1fr}.command-action-card{grid-template-columns:1fr}.command-action-card strong{grid-column:1}.reliability-server-line{align-items:flex-start;flex-direction:column}.reliability-server-line span{text-align:left}}
.recruit-vacancy-board{margin:16px 0;padding:16px;border:1px solid rgba(190,164,104,.42);background:rgba(230,216,182,.96);color:#1b1911}.recruit-vacancy-board>header small{font:700 10px/1.2 var(--mono,monospace);letter-spacing:.12em}.recruit-vacancy-board>header h2{margin:4px 0 6px}.recruit-vacancy-board>header p{margin:0 0 12px;max-width:900px}.recruit-vacancy-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.recruit-vacancy-summary a{display:grid;gap:3px;padding:10px;border:1px solid rgba(86,70,38,.28);color:inherit;text-decoration:none;background:rgba(255,255,255,.22)}.recruit-vacancy-summary small{font-weight:800}.recruit-vacancy-summary strong{font-size:11px}.recruit-vacancy-detail{margin-top:10px;border-top:1px solid rgba(86,70,38,.28);padding-top:10px}.recruit-vacancy-detail summary{cursor:pointer;font-weight:800}.recruit-vacancy-detail p{display:flex;justify-content:space-between;gap:16px;margin:0;padding:8px 0;border-bottom:1px dotted rgba(86,70,38,.25)}.recruit-vacancy-detail p span{opacity:.7;text-align:right}@media(max-width:820px){.recruit-vacancy-summary{grid-template-columns:1fr}.recruit-vacancy-detail p{display:block}.recruit-vacancy-detail p span{display:block;text-align:left;margin-top:3px}}


/* Public recruiting UX consolidation — 2026-08-25 */
.recruiting-simple-rail .recruiting-side-paper{margin-bottom:18px}
.recruiting-next-paper ol{display:grid;gap:12px;margin:14px 0 0;padding:0;list-style:none}
.recruiting-next-paper li{display:grid;grid-template-columns:92px 1fr;gap:10px;align-items:start;padding:11px 0;border-bottom:1px solid rgba(50,43,30,.18)}
.recruiting-next-paper li:last-child{border-bottom:0}
.recruiting-next-paper li b{font-family:var(--font-stencil,inherit);letter-spacing:.06em}
.recruiting-next-paper li span{line-height:1.45}
.recruiting-one-case p{margin:12px 0 4px;line-height:1.55}
.recruiting-status-page .recruit-case-status strong{line-height:1.1}
@media (max-width:820px){
  .recruiting-next-paper li{grid-template-columns:1fr;gap:3px}
  .recruiting-office-intro h1{line-height:1.02}
}

.staff-member-preview-banner{margin:0 0 18px;padding:14px 18px;border:2px solid #8a6b35;background:#efe1b5;display:flex;justify-content:space-between;gap:16px;align-items:center}.staff-member-preview-banner small,.staff-member-preview-banner b,.staff-member-preview-banner span{display:block}.staff-member-preview-banner button{min-height:42px;padding:8px 14px}@media(max-width:700px){.staff-member-preview-banner{display:block}.staff-member-preview-banner button{margin-top:10px;width:100%}}

/* Phase 3 — member home hierarchy */
.member-home-status{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:1500px;margin:12px auto 16px;padding:0 12px}.member-home-status>div,.member-home-status>a{min-height:92px;padding:13px 14px;border:1px solid rgba(22,25,17,.38);background:rgba(236,228,198,.94);display:flex;flex-direction:column;justify-content:center;text-decoration:none;color:inherit}.member-home-status small{font-weight:800;letter-spacing:.08em}.member-home-status b{font-size:1.05rem;margin:.2rem 0}.member-home-status span{font-size:.8rem}.member-home-action.needs-action{background:#ead9bd;border-width:2px}.member-home-action.is-clear{background:#dfe5cc}@media(max-width:820px){.member-home-status{grid-template-columns:1fr 1fr}}@media(max-width:520px){.member-home-status{grid-template-columns:1fr}.member-home-status>div,.member-home-status>a{min-height:76px}}

/* Reliability exception drill-down: compact, actionable, and consistent with staff paper panels. */
.reliability-exception-detail-grid{margin-top:14px;align-items:start}
.reliability-exception-row{display:flex;gap:14px;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px dotted rgba(45,38,24,.32)}
.reliability-exception-row:last-child{border-bottom:0}
.reliability-exception-row div{display:flex;flex-direction:column;gap:3px;min-width:0}
.reliability-exception-row span{font-size:.78rem;opacity:.78}
.reliability-exception-row .staff-hi-button{margin:0;white-space:nowrap}
@media(max-width:820px){.reliability-exception-row{align-items:stretch;flex-direction:column}.reliability-exception-row .staff-hi-button{width:100%;text-align:center}}

/* === SITE-WIDE READABILITY + ISSUED UNIFORM RACK FIX — 2026-08-25 ===
   Preserve the 1965 Army palette while enforcing readable contrast on
   operational/member/staff interfaces. Hero/photo sections remain dark by design. */
:root{
  --ui-paper:#e7dcc0;
  --ui-paper-deep:#d8c79d;
  --ui-ink:#242019;
  --ui-ink-soft:#51493a;
  --ui-olive:#3d4634;
  --ui-olive-deep:#2f372a;
  --ui-olive-text:#f0e5c7;
  --ui-olive-muted:#c9bea1;
  --ui-border:#8b7b58;
  --ui-gold:#d5ad36;
}

/* Light document surfaces: dark ink on warm paper. */
.document-sheet,
.file-document,
.paper-panel,
.record-form,
.career-paper,
.qualification-card-period,
.recruit-case,
.recruit-card,
.staff-panel{
  color:var(--ui-ink);
}
.document-sheet,
.file-document{
  background-color:var(--ui-paper);
}
.document-sheet h1,.document-sheet h2,.document-sheet h3,.document-sheet h4,
.document-sheet b,.document-sheet strong,
.file-document h1,.file-document h2,.file-document h3,.file-document h4,
.file-document b,.file-document strong{
  color:var(--ui-ink)!important;
}
.document-sheet p,.document-sheet span,.document-sheet small,.document-sheet label,
.file-document p,.file-document span,.file-document small,.file-document label{
  color:var(--ui-ink-soft);
}
.document-sheet input,.document-sheet select,.document-sheet textarea,
.file-document input,.file-document select,.file-document textarea{
  background:#f4ead0;
  color:#221e17;
  border-color:#8a7957;
}

/* Olive interface cards: cream text on olive, never dark-on-dark. */
.member-ribbon-status,
.staff-onboarding-row:not(.staff-onboarding-row--head),
.staff-welcome-phase,
.staff-201-onboarding-card,
.hll-round-ledger .head,
.hll-op-ledger .head{
  background:var(--ui-olive)!important;
  color:var(--ui-olive-text)!important;
  border-color:#667052!important;
}
.member-ribbon-status b,
.member-ribbon-status em,
.staff-onboarding-row b,
.staff-welcome-phase b,
.staff-201-onboarding-card b,
.hll-round-ledger .head b,
.hll-op-ledger .head b{
  color:#fff2ce!important;
}
.member-ribbon-status small,
.member-ribbon-status span,
.staff-onboarding-row small,
.staff-welcome-phase small,
.staff-201-onboarding-card small{
  color:var(--ui-olive-muted)!important;
}
.member-ribbon-status:hover,.member-ribbon-status:focus-visible{
  background:#4a5540!important;
  outline:2px solid #bda15b;
  outline-offset:1px;
}
.member-ribbon-status.is-earned{border-left-color:#93a56f!important}
.member-ribbon-status.is-progress{border-left-color:#d1ae4f!important}

/* S-3 schedule/control pages: force readable paper treatment. */
.page-operations .ops-simple-schedule,
.page-operations .ops-simple-board,
.page-operations .ops-simple-completed,
.page-operations .ops-simple-health{
  background:linear-gradient(180deg,#e9dfc5,#ddcfaa)!important;
  color:var(--ui-ink)!important;
  border-color:var(--ui-border)!important;
}
.page-operations .ops-simple-schedule header,
.page-operations .ops-simple-board header,
.page-operations .ops-simple-completed header{
  color:var(--ui-ink)!important;
}
.page-operations .ops-simple-schedule header small,
.page-operations .ops-simple-board header small,
.page-operations .ops-simple-completed header small{
  color:#765f28!important;
}
.page-operations .ops-simple-schedule header h2,
.page-operations .ops-simple-board header h2,
.page-operations .ops-simple-completed header h2,
.page-operations .ops-simple-schedule header p,
.page-operations .ops-simple-board header p,
.page-operations .ops-simple-completed header p{
  color:var(--ui-ink)!important;
}
.page-operations .ops-simple-form label span,
.page-operations .ops-inline-form label,
.page-operations .ops-simple-meta small{
  color:#4d4536!important;
}
.page-operations .ops-simple-form input,
.page-operations .ops-simple-form select,
.page-operations .ops-simple-form textarea,
.page-operations .ops-inline-form input,
.page-operations .ops-inline-form select,
.page-operations .ops-duty-add input,
.page-operations .ops-duty-add select{
  background:#f5ecd8!important;
  color:#221e17!important;
  border:1px solid #8b7953!important;
}
.page-operations .ops-primary,
.page-operations .ops-inline-form button,
.page-operations .ops-duty-add button{
  background:var(--ui-olive-deep)!important;
  color:#f6e9c4!important;
  border:1px solid #68704f!important;
}

/* General form/button readability on dark workspaces. */
button,.paper-action,.member-primary-link,.action-update-button,
.staff-search-result-actions a,.staff-search-result-actions button{
  text-shadow:none;
}

/* Issued Service Uniform: this page has a different crop than the other
   uniform canvases, so it needs its own chest anchor and a tight transparent rack. */
.uniform-file-sheet .uniform-record-visual{
  position:relative;
  background:#171812!important;
  padding:0!important;
  overflow:hidden!important;
}
.uniform-file-sheet .uniform-ribbon-rack--file{
  left:66.7%!important;
  top:39.2%!important;
  width:auto!important;
  min-width:0!important;
  max-width:none!important;
  height:auto!important;
  padding:0!important;
  margin:0!important;
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  gap:0!important;
}
.uniform-file-sheet .uniform-ribbon-rack--file .uniform-ribbon-row{
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
  gap:0!important;
  line-height:0!important;
}
.uniform-file-sheet .uniform-ribbon-rack--file .ribbon-rack-button{
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
  margin:0!important;
  padding:0!important;
}
.uniform-file-sheet .uniform-ribbon-rack--file img{
  display:block!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  box-shadow:none!important;
}

/* Keep readability overrides comfortable on mobile too. */
@media(max-width:700px){
  .member-ribbon-status{grid-template-columns:80px minmax(0,1fr) auto}
  .page-operations .ops-simple-schedule,
  .page-operations .ops-simple-board,
  .page-operations .ops-simple-completed,
  .page-operations .ops-simple-health{padding:16px!important}
}

/* ========================================================================
   2026-08-25 — READABILITY + SERVICE UNIFORM RACK CORRECTION
   Restores dark-on-light card contrast for Wall Locker / My Actions and
   locks issued-uniform ribbon racks to upper-left 3-column alignment.
   ======================================================================== */
:root{
  --issued-uniform-rack-width:calc(3 * var(--issued-uniform-ribbon-width) + 2 * var(--issued-uniform-ribbon-col-gap));
}

/* Wall Locker status cards: force paper-card contrast regardless of page/theme inheritance. */
.member-home-status>div,
.member-home-status>a{
  background:#ebe2c8!important;
  color:#211b11!important;
  border:1px solid rgba(58,49,31,.34)!important;
  box-shadow:0 1px 0 rgba(255,255,255,.28) inset;
}
.member-home-status>div small,
.member-home-status>a small{
  color:#75623a!important;
  opacity:1!important;
}
.member-home-status>div b,
.member-home-status>a b{
  color:#1d170f!important;
}
.member-home-status>div span,
.member-home-status>a span{
  color:#403528!important;
  opacity:1!important;
}
.member-home-action.needs-action{background:#ead9bb!important}
.member-home-action.is-clear{background:#dfe6cd!important}

/* My Actions summary panel: same readable paper treatment. */
.member-actions-v3 .member-action-summary{
  background:#efe6d1!important;
  color:#221b11!important;
  border:1px solid rgba(58,49,31,.28)!important;
}
.member-actions-v3 .member-action-summary small{
  color:#75623a!important;
  opacity:1!important;
}
.member-actions-v3 .member-action-summary h2{
  color:#1d170f!important;
}
.member-actions-v3 .member-action-summary p{
  color:#403528!important;
}
.member-actions-v3 .member-action-summary>a{
  background:#20241c!important;
  color:#f3e9cc!important;
  border:1px solid #13170f!important;
}
.member-actions-v3 .member-action-summary.is-clear{background:#e5ead8!important}

/* Uniform ribbon racks: upper-left chest anchor, always building from the first slot.
   Short rows stay left-aligned instead of centered. */
.wall-locker-ribbon-rack,
.locker-desktop-ribbon-rack,
.locker-modal-ribbon-rack,
.uniform-ribbon-rack--file,
.squad-ribbon-rack,
.soldier-home-ribbon-rack{
  width:var(--issued-uniform-rack-width)!important;
  align-items:flex-start!important;
}
.wall-locker-ribbon-rack .uniform-ribbon-row,
.locker-desktop-ribbon-rack .uniform-ribbon-row,
.locker-modal-ribbon-rack .uniform-ribbon-row,
.uniform-ribbon-rack--file .uniform-ribbon-row,
.squad-ribbon-rack .uniform-ribbon-row,
.soldier-home-ribbon-rack .uniform-ribbon-row,
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-3,
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-2,
.wall-locker-ribbon-rack .uniform-ribbon-row.row-size-1,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-3,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-2,
.locker-desktop-ribbon-rack .uniform-ribbon-row.row-size-1,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-3,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-2,
.locker-modal-ribbon-rack .uniform-ribbon-row.row-size-1,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-3,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-2,
.uniform-ribbon-rack--file .uniform-ribbon-row.row-size-1,
.squad-ribbon-rack .uniform-ribbon-row.row-size-3,
.squad-ribbon-rack .uniform-ribbon-row.row-size-2,
.squad-ribbon-rack .uniform-ribbon-row.row-size-1,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-3,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-2,
.soldier-home-ribbon-rack .uniform-ribbon-row.row-size-1{
  width:var(--issued-uniform-rack-width)!important;
  justify-content:flex-start!important;
  align-self:flex-start!important;
}

/* Issued Service Uniform page needs the rack slightly farther left so the first ribbon
   begins from the upper-left slot of the chest rack area. */
.uniform-file-sheet .uniform-ribbon-rack--file{
  left:64.8%!important;
  top:39.0%!important;
  align-items:flex-start!important;
}

/* ========================================================================
   ABOUT US — PERSONAL UNIT STORY / RECRUITING PAGE — 2026-08-25
   ======================================================================== */
.about-us-story-page main{background:#151a14!important}
.about-story-hero{position:relative;min-height:560px;display:flex;align-items:end;overflow:hidden;background:url('/static/art/about-15-cav-hero.webp') center 42%/cover no-repeat;border-bottom:1px solid rgba(198,164,69,.38)}
.about-story-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,12,8,.94) 0%,rgba(10,14,9,.80) 45%,rgba(8,11,8,.35) 100%),linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.55))}
.about-story-hero__inner{position:relative;z-index:2;width:min(1420px,calc(100% - 64px));margin:0 auto;padding:80px 0 70px;max-width:1420px}
.about-story-hero__inner>small,.about-story-card>small,.about-rank-board header small,.about-story-cta>small{display:block;font:700 9px/1.3 'Courier Prime',monospace;letter-spacing:.14em;color:#d1aa43}
.about-story-hero h1{margin:10px 0 16px;font:700 clamp(64px,8vw,112px)/.88 'Stardos Stencil',serif;color:#f0e4c6;text-shadow:0 8px 24px rgba(0,0,0,.5)}
.about-story-hero p{max-width:820px;margin:0;font:15px/1.72 'Courier Prime',monospace;color:#d9ccb0}
.about-story-hero__actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.about-story-shell{padding:56px max(24px,5vw) 80px}
.about-story-grid{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(330px,.65fr);gap:28px;align-items:start}
.about-story-letter{position:relative;padding:48px 52px 54px;background:linear-gradient(180deg,#efe5cb 0%,#e2d5b5 100%);color:#2b2318;border:1px solid #84744e;box-shadow:0 20px 44px rgba(0,0,0,.25),inset 0 0 38px rgba(109,87,45,.06)}
.about-story-letter:before{content:"HEADQUARTERS • 1/5 CAV";position:absolute;right:30px;top:24px;transform:rotate(2deg);padding:7px 10px;border:2px solid rgba(125,65,43,.5);color:rgba(125,65,43,.72);font:700 8px 'Courier Prime',monospace;letter-spacing:.12em}
.about-story-letter header{padding-bottom:18px;margin-bottom:25px;border-bottom:1px solid rgba(76,62,39,.38)}
.about-story-letter header small{font:700 9px 'Courier Prime',monospace;letter-spacing:.13em;color:#786238}
.about-story-letter header h2{margin:7px 0 0;font:700 clamp(30px,3vw,44px)/1 'Stardos Stencil',serif;color:#2a2217}
.about-story-letter p{margin:0 0 19px;font:15px/1.78 'Courier Prime',monospace;color:#3b3124}
.about-story-letter p strong{color:#201a12}
.about-story-emphasis{padding:16px 18px;margin:28px 0!important;border-left:5px solid #657348;background:rgba(92,108,66,.10);font-size:16px!important}
.about-story-quote{margin:28px 0!important;font:700 clamp(21px,2.2vw,32px)/1.25 'Stardos Stencil',serif!important;color:#292116!important;letter-spacing:.02em}
.about-story-final-line{margin-top:30px!important;padding-top:24px;border-top:2px solid rgba(70,57,35,.38);font:700 clamp(28px,3vw,42px)/1 'Stardos Stencil',serif!important;color:#282015!important}
.about-story-sidebar{display:grid;gap:18px;position:sticky;top:22px}
.about-story-card,.about-rank-board{padding:25px 24px;background:linear-gradient(180deg,#d8c9a5,#cdbb91);color:#2c2418;border:1px solid #766847;box-shadow:0 14px 30px rgba(0,0,0,.22)}
.about-story-card h3,.about-rank-board h3{margin:8px 0 12px;font:700 27px/1.03 'Stardos Stencil',serif;color:#292116}
.about-story-card p,.about-rank-board p{margin:0;font:12px/1.65 'Courier Prime',monospace;color:#44392a}
.about-story-card a{display:inline-block;margin-top:14px;font:700 9px 'Courier Prime',monospace;letter-spacing:.08em;color:#37452d;text-decoration:none;border-bottom:1px solid #536141}
.about-rank-board{background:linear-gradient(180deg,#1f291e,#172017);color:#efe4c8;border-color:#766847}
.about-rank-board h3{color:#efe4c8}.about-rank-board p{color:#cfc4a6}.about-rank-board header small{color:#d5ae43}
.about-rank-board__patches{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 14px;align-items:end}
.about-rank-board__patches figure{margin:0;text-align:center;min-width:0}.about-rank-board__patches img{display:block;width:100%;aspect-ratio:1/1;object-fit:contain;filter:drop-shadow(0 8px 8px rgba(0,0,0,.32))}.about-rank-board__patches figcaption{margin-top:7px;font:700 7px 'Courier Prime',monospace;letter-spacing:.08em;color:#d8cba9}
.about-field-break{position:relative;min-height:260px;overflow:hidden;border:1px solid rgba(189,157,77,.38);box-shadow:0 14px 28px rgba(0,0,0,.24)}.about-field-break img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.about-field-break:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,13,9,.08),rgba(9,13,9,.83))}.about-field-break div{position:absolute;z-index:2;left:20px;right:20px;bottom:18px}.about-field-break small{font:700 11px/1.35 'Stardos Stencil',serif;color:#f0e4c6;letter-spacing:.06em}
.about-story-card--human{position:relative;min-height:260px;overflow:hidden;padding-right:145px;background:linear-gradient(180deg,#e1d4b5,#cfbd92)}
.about-human-copy{position:relative;z-index:2}.about-human-can{position:absolute;right:-18px;bottom:-42px;width:165px;max-height:285px;object-fit:contain;transform:rotate(5deg);filter:drop-shadow(0 12px 12px rgba(0,0,0,.28))}
.about-story-cta{max-width:1380px;margin:28px auto 0;padding:48px 42px;text-align:center;background:linear-gradient(180deg,#20291f,#151c15);border:1px solid rgba(191,158,68,.42);box-shadow:0 18px 40px rgba(0,0,0,.25)}
.about-story-cta h2{max-width:900px;margin:12px auto 16px;font:700 clamp(38px,5vw,66px)/.93 'Stardos Stencil',serif;color:#efe3c5}.about-story-cta p{max-width:760px;margin:0 auto 24px;font:13px/1.7 'Courier Prime',monospace;color:#cfc3a4}.about-story-cta .paper-action{display:inline-flex}
@media(max-width:1040px){.about-story-grid{grid-template-columns:1fr}.about-story-sidebar{position:static;grid-template-columns:1fr 1fr}.about-rank-board,.about-field-break{grid-column:1/-1}}
@media(max-width:700px){.about-story-hero{min-height:440px}.about-story-hero__inner{width:calc(100% - 32px);padding:60px 0 48px}.about-story-hero h1{font-size:58px}.about-story-hero__actions{display:grid}.about-story-shell{padding:28px 14px 54px}.about-story-letter{padding:34px 22px 38px}.about-story-letter:before{display:none}.about-story-letter p{font-size:13px;line-height:1.72}.about-story-sidebar{grid-template-columns:1fr}.about-rank-board,.about-field-break{grid-column:auto}.about-story-card--human{padding-right:115px}.about-human-can{width:130px;right:-22px}.about-story-cta{padding:34px 20px}.about-story-cta .paper-action{width:100%;justify-content:center}.about-rank-board__patches{gap:3px}}


/* 2026-08-26 — Approved recruit Discord handoff/fallback. */
.recruit-discord-handoff{border-left:5px solid #8b6b2e!important;background:#eee2c4!important;color:#251e13!important}
.recruit-discord-handoff h2,.recruit-discord-handoff p,.recruit-discord-handoff b{color:#251e13!important}
.recruit-discord-handoff__actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.recruit-discord-handoff__actions .paper-action{flex:1 1 260px;justify-content:center;text-align:center}
.recruit-discord-handoff__note{margin-top:12px;font-size:.82rem}
@media(max-width:640px){.recruit-discord-handoff__actions{display:grid}.recruit-discord-handoff__actions .paper-action{width:100%}}
.assignment-artifact-status{margin:12px 0 16px;padding:11px 13px;border:1px solid rgba(58,49,31,.34);display:grid;gap:3px;background:#e8dfc5;color:#241d12}.assignment-artifact-status small{font-weight:900;letter-spacing:.08em;color:#6b5936}.assignment-artifact-status b{font-size:.93rem}.assignment-artifact-status span{font-size:.78rem;line-height:1.45}.assignment-artifact-status.is-complete{border-left:5px solid #53623d}.assignment-artifact-status.needs-repair{border-left:5px solid #9a5038;background:#ead8bd}

/* ========================================================================
   2026-08-26 — AUTOMATION RELIABILITY BOARD VISUAL REPAIR
   Keeps the system-assurance board balanced and makes exception state obvious.
   ======================================================================== */
.page-staff-reliability .reliability-summary-grid{
  grid-auto-rows:1fr;
  align-items:stretch;
}
.page-staff-reliability .reliability-card{
  min-height:168px;
  height:100%;
  box-sizing:border-box;
  padding:17px 18px 16px;
  background:#e9ddbd;
  border:1px solid rgba(87,70,40,.46);
  box-shadow:0 2px 0 rgba(0,0,0,.14),inset 0 1px rgba(255,255,255,.24);
}
.page-staff-reliability .reliability-card small{
  color:#3f3524;
  opacity:1;
}
.page-staff-reliability .reliability-card b{
  color:#17140d;
  margin-top:1px;
}
.page-staff-reliability .reliability-card span{
  color:#403729;
  opacity:1;
  max-width:58ch;
}
.page-staff-reliability .reliability-card em{
  color:#17140d;
  opacity:1;
}
.page-staff-reliability .reliability-card.state-current{
  border-top:5px solid #4b6237;
}
.page-staff-reliability .reliability-card.state-action-required,
.page-staff-reliability .reliability-card.state-check-failed{
  border-top:5px solid #8a3529;
  background:#ead7bd;
  box-shadow:0 2px 0 rgba(0,0,0,.14),inset 0 0 0 1px rgba(126,43,32,.08);
}
.page-staff-reliability .reliability-card.state-action-required b,
.page-staff-reliability .reliability-card.state-check-failed b,
.page-staff-reliability .reliability-card.state-action-required em,
.page-staff-reliability .reliability-card.state-check-failed em{
  color:#74281f;
}

/* Server Telemetry is the board-wide system authority; give it a deliberate
   full-width footer treatment rather than leaving one orphan card in row 5. */
.page-staff-reliability .reliability-card--telemetry{
  grid-column:1 / -1;
  min-height:112px;
  display:grid;
  grid-template-columns:minmax(160px,.7fr) minmax(150px,.55fr) minmax(360px,2fr) auto;
  grid-template-rows:auto;
  gap:12px 24px;
  align-items:center;
}
.page-staff-reliability .reliability-card--telemetry small,
.page-staff-reliability .reliability-card--telemetry b,
.page-staff-reliability .reliability-card--telemetry span,
.page-staff-reliability .reliability-card--telemetry em{
  margin:0;
  align-self:center;
}
.page-staff-reliability .reliability-card--telemetry em{
  justify-self:end;
  white-space:nowrap;
}

@media(max-width:980px){
  .page-staff-reliability .reliability-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .page-staff-reliability .reliability-card--telemetry{
    grid-column:1 / -1;
    grid-template-columns:1fr auto;
  }
  .page-staff-reliability .reliability-card--telemetry span{grid-column:1 / -1}
}
@media(max-width:820px){
  .page-staff-reliability .reliability-summary-grid{grid-template-columns:1fr}
  .page-staff-reliability .reliability-card{min-height:0}
  .page-staff-reliability .reliability-card--telemetry{
    grid-column:auto;
    display:flex;
    min-height:0;
  }
  .page-staff-reliability .reliability-card--telemetry em{align-self:flex-start}
}

/* ========================================================================
   2026-08-26 — GLOBAL ACTION BUTTON CONTRAST STANDARD
   Staff/member action controls use true black with white text. This override
   intentionally lives at the end of the cascade so older olive button rules
   cannot make labels unreadable. Decorative ribbon controls are excluded.
   ======================================================================== */
:root{
  --action-black:#080908;
  --action-black-hover:#171917;
  --action-white:#ffffff;
  --action-border:#5e625b;
}

.paper-action,
button.paper-action,
a.paper-action,
.staff-hi-button,
.action-update-button,
.member-primary-link,
.deep-search button,
.compare-picker button,
.journal-form button,
.watch-card button,
.next-action-card a,
.deep-links a,
.member-deep-links a,
.duty-suggestion-grid button,
.welcome-submit-board button,
.welcome-verification-control button,
.member-notification-actions a,
.member-notification-actions button,
.org-level-actions a.primary,
.recruit-discord-handoff__actions .paper-action,
.personnel-sync-quick-actions .paper-action,
.staff-onboarding-head>div:last-child a,
.staff-search-result-actions a,
.staff-search-result-actions button,
.action-confirm-submit,
.action-preview-trigger{
  background:var(--action-black)!important;
  background-image:none!important;
  color:var(--action-white)!important;
  border-color:var(--action-border)!important;
  text-shadow:none!important;
  box-shadow:0 3px 0 #000!important;
}

.paper-action span,
.paper-action small,
.staff-hi-button span,
.staff-hi-button small,
.action-update-button span,
.action-update-button small,
.member-primary-link span,
.member-primary-link small,
.personnel-sync-quick-actions .paper-action span,
.personnel-sync-quick-actions .paper-action small,
.staff-onboarding-head>div:last-child a span,
.staff-onboarding-head>div:last-child a small{
  color:var(--action-white)!important;
  opacity:1!important;
}

.paper-action:hover,
.paper-action:focus-visible,
.staff-hi-button:hover,
.staff-hi-button:focus-visible,
.action-update-button:hover,
.action-update-button:focus-visible,
.member-primary-link:hover,
.member-primary-link:focus-visible,
.deep-search button:hover,
.deep-search button:focus-visible,
.compare-picker button:hover,
.compare-picker button:focus-visible,
.journal-form button:hover,
.journal-form button:focus-visible,
.watch-card button:hover,
.watch-card button:focus-visible,
.next-action-card a:hover,
.next-action-card a:focus-visible,
.deep-links a:hover,
.deep-links a:focus-visible,
.member-deep-links a:hover,
.member-deep-links a:focus-visible,
.duty-suggestion-grid button:hover,
.duty-suggestion-grid button:focus-visible,
.welcome-submit-board button:hover,
.welcome-submit-board button:focus-visible,
.welcome-verification-control button:hover,
.welcome-verification-control button:focus-visible,
.member-notification-actions a:hover,
.member-notification-actions a:focus-visible,
.member-notification-actions button:hover,
.member-notification-actions button:focus-visible,
.org-level-actions a.primary:hover,
.org-level-actions a.primary:focus-visible,
.staff-onboarding-head>div:last-child a:hover,
.staff-onboarding-head>div:last-child a:focus-visible{
  background:var(--action-black-hover)!important;
  color:var(--action-white)!important;
  border-color:#8b9088!important;
  outline:2px solid #ffffff!important;
  outline-offset:2px!important;
}

/* Disabled controls stay legible while clearly inactive. */
.paper-action:disabled,
button:disabled.paper-action,
.staff-hi-button:disabled,
.action-update-button:disabled,
.welcome-submit-board button:disabled,
.welcome-verification-control button:disabled{
  background:#303230!important;
  color:#d9d9d9!important;
  border-color:#555!important;
  opacity:.72!important;
}

/* 2026-08-26 — Command 201 File manual member-login delivery control */
.staff-login-delivery-card{margin-top:14px;padding:14px;border:1px solid rgba(183,158,89,.44);background:rgba(12,15,11,.58);color:#f2e7c9}
.staff-login-delivery-card>header{display:flex;justify-content:space-between;gap:12px;align-items:baseline;padding-bottom:9px;border-bottom:1px solid rgba(183,158,89,.3)}
.staff-login-delivery-card>header small{color:#caaa55;font-weight:800;letter-spacing:.08em}.staff-login-delivery-card>header b{color:#fff}
.staff-login-delivery-status{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:10px}.staff-login-delivery-status span{padding:9px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.26)}.staff-login-delivery-status small,.staff-login-delivery-status b{display:block}.staff-login-delivery-status small{color:#bfae82;font-size:.68rem}.staff-login-delivery-status b{margin-top:3px;color:#fff;overflow-wrap:anywhere}.staff-login-delivery-status .is-sent{color:#d9f2c8}.staff-login-delivery-status .is-error{color:#ffd0c8}.staff-login-delivery-status .is-queued{color:#ffe2a0}
.staff-login-delivery-error,.staff-login-delivery-pending{margin:10px 0 0;padding:9px 10px;background:#180f0d;border-left:4px solid #a84c3f;color:#fff}.staff-login-delivery-pending{background:#171509;border-left-color:#b69537}
.staff-login-delivery-form{display:grid;gap:10px;margin-top:12px}.staff-login-delivery-form label{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start;color:#fff}.staff-login-delivery-form input[type=checkbox]{width:20px;height:20px}.staff-login-delivery-form label span{display:grid;gap:3px}.staff-login-delivery-form label small{color:#d8caab}.staff-login-delivery-form .paper-action{width:100%;background:#000!important;color:#fff!important;border-color:#fff!important}.staff-login-delivery-form .paper-action span,.staff-login-delivery-form .paper-action small{color:#fff!important}.staff-login-delivery-history-link{display:inline-flex;color:#fff;text-decoration:underline;font-weight:800}
@media(max-width:800px){.staff-login-delivery-status{grid-template-columns:1fr 1fr}}@media(max-width:520px){.staff-login-delivery-status{grid-template-columns:1fr}}


/* 2026-08-26 Command operating system dashboards */
.accession-list,.promotion-board-grid{display:grid;gap:14px;max-width:1500px;margin:16px auto;padding:0 14px}.accession-card>header,.promotion-board-card>header{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.accession-card>header strong{font:700 34px 'Stardos Stencil',serif}.accession-stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:12px 0}.accession-stages span{padding:10px;border:1px solid rgba(50,43,30,.25);display:grid;gap:4px}.accession-stages .is-good{background:#dde3c8;color:#201b12}.accession-stages .is-open{background:#ead5c3;color:#21150f;border-color:#925747}.accession-card footer{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px dashed rgba(50,43,30,.35);padding-top:10px}.accession-card footer>div{display:flex;gap:8px;align-items:center}.promotion-board-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.promotion-board-card.is-eligible{border:2px solid #4f623b}.promotion-evidence{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.promotion-evidence span{padding:9px;border:1px solid rgba(50,43,30,.22);display:grid}.promotion-reqs{display:grid;gap:5px;margin:12px 0}.promotion-reqs span{display:flex;justify-content:space-between;padding:8px 10px}.promotion-reqs .done{background:#dfe5cc}.promotion-reqs .open{background:#ead9bd}.promotion-board-card footer{display:grid;gap:8px;border-top:1px dashed rgba(50,43,30,.35);padding-top:10px}.promotion-board-card footer form{display:grid;grid-template-columns:1fr auto;gap:8px}.reliability-repair-actions{display:flex;flex-wrap:wrap;gap:8px}.reliability-repair-actions button,.accession-card button,.promotion-board-card button{background:#070807!important;color:#fff!important;border:1px solid #000!important;padding:11px 14px;font-weight:900}.reliability-repair-actions button:hover,.accession-card button:hover,.promotion-board-card button:hover{background:#1d1f1b!important;color:#fff!important}@media(max-width:900px){.accession-stages{grid-template-columns:repeat(2,minmax(0,1fr))}.promotion-board-grid{grid-template-columns:1fr}.promotion-evidence{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.accession-stages,.promotion-evidence{grid-template-columns:1fr}.accession-card footer{display:grid}.promotion-board-card footer form{grid-template-columns:1fr}}
