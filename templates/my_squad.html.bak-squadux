{% extends 'base.html' %}
{% block title %}My Squad • {{site_name}}{% endblock %}
{% block body_class %}page-my-squad member-soldiers-redesign{% endblock %}
{% block content %}
<section class="records-room-heading my-soldiers-heading">
  <div><span>ASSIGNED FORMATION</span><h1>MY SQUAD</h1><p>{{(scope.display_name|formation_label) if scope else 'NO SQUAD ASSIGNMENT'}}{% if team_filter %} • {{team_filter}} TEAM{% endif %}</p></div>
</section>
<section class="org-squad-identity document-sheet">
  <header><small>YOUR FIGHTING ELEMENT</small><h2>{{org.company_name or personnel.unit_code}} • {{org.platoon.display_name if org.platoon else (personnel.platoon|formation_label if personnel.platoon else 'PLATOON PENDING')}} • {{org.squad.display_name if org.squad else (personnel.squad|formation_label if personnel.squad else 'SQUAD PENDING')}}</h2></header>
  <div class="org-squad-command"><span><small>SQUAD LEADER</small><b>{% if org.leaders.squad_leader %}{{org.leaders.squad_leader.rank_code}} {{org.leaders.squad_leader.last_name|soldier_name(org.leaders.squad_leader.first_name)}}{% else %}VACANT{% endif %}</b></span><span><small>SQUAD READINESS</small><b>{{org.squad_readiness or 0}}%</b></span><span><small>ASSIGNED</small><b>{{org.squad_strength or 0}}</b></span></div>
  <div class="org-team-board">
  {% for team_name in ['Alpha Team','Bravo Team'] %}<section class="{% if org.team==team_name %}is-member-team{% endif %}"><header><h3>{{team_name}}</h3>{% if org.team==team_name %}<b>YOUR TEAM</b>{% endif %}<span>TL: {% set tl=org.team_leaders.get(team_name) %}{% if tl %}{{tl.rank_code}} {{tl.last_name|soldier_name(tl.first_name)}}{% else %}SEE ASSIGNMENT ROSTER{% endif %}</span></header>{% for m in org.teams.get(team_name,[]) %}<a href="{{url_for('squad_soldier_combat_record',personnel_id=m.id)}}"><b>{{m.rank_code}} {{m.last_name|soldier_name(m.first_name)}}</b><span>{{m.duty_position or m.mos_code or 'SOLDIER'}}{% if m.id==personnel.id %} • YOU{% endif %}</span></a>{% else %}<p>VACANT / NO PERSONNEL FILED</p>{% endfor %}</section>{% endfor %}
  </div>
  <nav class="org-level-actions"><a href="{{url_for('my_unit')}}">MY ASSIGNMENT</a><a href="{{url_for('my_platoon_identity')}}">MY PLATOON</a><a href="{{url_for('my_company_identity')}}">MY COMPANY</a></nav>
</section>
<section class="my-soldiers-room my-squad-room">
  <article class="document-sheet leader-roster">
    <header class="army-letterhead compact"><small>PERSONNEL ROSTER</small><strong>{{'LEADERSHIP WORKSPACE' if can_act else 'SQUAD ROSTER'}}</strong><span>RANK PRECEDENCE • ASSIGNMENT • DUTY</span></header>
    {% if can_act %}<p class="typed-note">{{leadership_appt.appointment_name|upper}} — {% if team_filter %}QUICK ACTION AUTHORITY: {{team_filter}}{% elif leadership_appt.appointment_code=='PSG' %}QUICK ACTION AUTHORITY: ASSIGNED PLATOON{% else %}QUICK ACTION AUTHORITY: ASSIGNED SQUAD{% endif %}. You may inspect the full formation shown below; actions are limited to Soldiers within your billet authority.</p>{% else %}<p class="typed-note">VIEW ONLY — You may inspect the members assigned to your squad. Personnel actions are restricted to CPL, SGT, SSG, and SFC leadership.</p>{% endif %}
    <div class="leader-roster-head" aria-hidden="true"><span>SOLDIER</span><span>FIRE TEAM</span><span>ASSIGNMENT</span><span>DUTY</span><span>OPEN</span></div>
    {% for s in soldiers %}
    <a class="leader-roster-row squad-member-row {% if selected and selected.id==s.id %}is-selected{% endif %} {% if s.id|string in actionable_ids %}is-actionable{% endif %}" href="{{url_for('squad_soldier_combat_record',personnel_id=s.id)}}">
      <span class="leader-cell leader-cell--soldier"><small class="leader-mobile-label">SOLDIER</small><b>{{s.rank_code or '—'}} {{s.last_name|soldier_name(s.first_name, true)}}</b><em>{{s.mos_code or '—'}}</em></span>
      <span class="leader-cell"><small class="leader-mobile-label">FIRE TEAM</small><b>{{s.fire_team|formation_label if s.fire_team else '—'}}</b></span>
      <span class="leader-cell"><small class="leader-mobile-label">ASSIGNMENT</small><b>{{s.platoon|formation_label if s.platoon else '—'}}</b><em>{{s.squad|formation_label if s.squad else '—'}}</em></span>
      <span class="leader-cell"><small class="leader-mobile-label">DUTY</small><b>{{s.duty_position or 'SOLDIER'}}</b></span>
      <span class="leader-cell"><b>COMBAT RECORD →</b></span>
    </a>
    {% else %}<p class="typed-empty">NO PERSONNEL ARE ASSIGNED WITHIN YOUR CURRENT FORMATION.</p>{% endfor %}
  </article>

  {% if selected %}
  <article class="document-sheet squad-soldier-inspector" id="soldier-inspector">
    <header class="army-letterhead compact"><small>SQUAD PERSONNEL VIEW</small><strong>{{selected.rank_code}} {{selected.last_name|soldier_name(selected.first_name)}}</strong><span>{{selected.duty_position or selected.mos_code or 'SOLDIER'}}</span></header>
    <div class="squad-inspector-grid">
      <section class="squad-uniform-panel">
        <h3>SERVICE UNIFORM</h3>
        <div class="squad-uniform-stage">
          <img class="uniform-base-image" src="{{url_for('static',filename='art/army-green-service-uniform.webp')}}" alt="{{selected.rank_code}} {{selected.last_name}} service uniform">
          {% if uniform_ribbon_rows %}<div class="uniform-ribbon-rack squad-ribbon-rack">{% for rrow in uniform_ribbon_rows %}<div class="uniform-ribbon-row row-size-{{rrow|length}}">{% for r in rrow %}{% if r.image_filename %}<img src="{{url_for('static',filename='art/ribbons/' ~ r.image_filename)}}" alt="{{r.ribbon_name}}">{% endif %}{% endfor %}</div>{% endfor %}</div>{% endif %}
        </div>
        <div class="squad-soldier-facts"><span>RANK <b>{{selected.rank_code}}</b></span>{% if selected.fire_team %}<span>FIRE TEAM <b>{{selected.fire_team|formation_label}}</b></span>{% endif %}<span>SQUAD <b>{{selected.squad|formation_label if selected.squad else '—'}}</b></span><span>DUTY <b>{{selected.duty_position or selected.mos_code or '—'}}</b></span></div>
      </section>
      <section class="squad-quick-actions">
        <h3>QUICK ACTION</h3>
        {% if can_act and selected.id != personnel.id %}
        <form method="post" class="army-form-grid">
          <input type="hidden" name="personnel_id" value="{{selected.id}}"><input type="hidden" name="quick_action" value="PROMOTION">
          <label>RECOMMEND PROMOTION<select name="target_rank" required>{% for r in ranks %}{% if r.precedence > 0 %}<option value="{{r.rank_code}}">{{r.rank_code}} — {{r.rank_name}}</option>{% endif %}{% endfor %}</select></label>
          <label class="wide">LEADER JUSTIFICATION<textarea name="justification" rows="2" required></textarea></label><button class="paper-action primary button-reset">FORWARD TO S-1</button>
        </form>
        <form method="post" class="army-form-grid">
          <input type="hidden" name="personnel_id" value="{{selected.id}}"><input type="hidden" name="quick_action" value="AWARD">
          <label>RECOMMEND AWARD<select name="award_name" required>{% for a in awards %}<option value="{{a.ribbon_name}}">{{a.ribbon_name}}</option>{% endfor %}</select></label>
          <label class="wide">CITATION / JUSTIFICATION<textarea name="justification" rows="2" required></textarea></label><button class="paper-action primary button-reset">FORWARD TO S-1</button>
        </form>
        <form method="post" class="army-form-grid">
          <input type="hidden" name="personnel_id" value="{{selected.id}}"><input type="hidden" name="quick_action" value="LEADERSHIP_NOTE">
          <label class="wide">LEADERSHIP NOTE<textarea name="justification" rows="3" required placeholder="Record training, performance, counseling, or leadership observation."></textarea></label><button class="paper-action button-reset">FILE LEADERSHIP NOTE</button>
        </form>
        {% else %}<div class="typed-empty"><b>VIEW ONLY</b><span>Quick Actions are available only to CPL, SGT, SSG, and SFC leaders within their authorized formation.</span></div>{% endif %}
      </section>
    </div>
  </article>
  {% endif %}
</section>
{% endblock %}
